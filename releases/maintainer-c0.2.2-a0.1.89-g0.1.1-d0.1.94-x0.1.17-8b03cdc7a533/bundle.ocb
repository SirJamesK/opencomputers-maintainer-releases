bootstrap.activateOrExit()
local monitor = require("oc.ae2.monitor")
local args = {...}
local offline = args[1] == "--offline"
monitor.print(nil, { offlineGrid = offline })
if offline then
  io.write("No override exists on this deployment; inspect exact targets or use server-side diagnostics after topology repair.\n")
end
#!/bin/lua
local bootstrap = require("oc_bootstrap")
bootstrap.activateOrExit()
local probe = require("oc.ae2.probe")
probe.print()
#!/bin/lua
