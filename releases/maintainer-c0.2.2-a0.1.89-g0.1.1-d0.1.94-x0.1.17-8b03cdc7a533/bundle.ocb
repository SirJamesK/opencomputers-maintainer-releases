DATA
local fs = require("filesystem")
local computerLoaded, computer = pcall(require, "computer")

local bootstrap = {}
local S = tostring

local SEL = "/etc/oc/maintainer-runtime.cfg"
local MARK = "/.oc-platform/maintainer/active"
local INHIBIT = "/var/oc/releases/maintainer/inhibit"
local REL = "/.oc-platform/maintainer/releases/"
local SUFFIX = "/root"
local CORE = "/usr/lib/oc/core/config.lua"
local DASH = "/usr/lib/oc/dashboard/app.lua"
local EXPECTED_CONTRACT = "9d01f7f824e7214d64633c2ab54fd74606ca32148cc0e978b70afc48372f02a1"
local LIMIT = 4096
local MOUNTS = 32
local ORDER = {
  "format", "product", "address", "install_id", "release", "bundle", "contract", "manifest",
}

local completeCache = { done = false }
local partialCache = { done = false }
local active

bootstrap.selectorPath = SEL
bootstrap.activeMarkerPath = MARK
bootstrap.expectedContract = EXPECTED_CONTRACT

local function join(root, suffix)
  if root == "/" then return suffix end
  return root .. suffix
end

local function safeExists(path)
  local ok, present = pcall(fs.exists, path)
  if not ok then return nil, "cannot inspect " .. S(path) .. ": " .. S(present) end
  return present == true
end

local function validUuid(value)
  if type(value) ~= "string" or #value ~= 36 then return false end
  if value:sub(9, 9) ~= "-" or value:sub(14, 14) ~= "-"
      or value:sub(19, 19) ~= "-" or value:sub(24, 24) ~= "-" then return false end
  local compact = value:gsub("-", "")
  return #compact == 32 and compact:match("^[0-9a-f]+$") ~= nil
end

local function validDigest(value)
  return type(value) == "string" and #value == 64 and value:match("^[0-9a-f]+$") ~= nil
end

local function validToken(value, maxLength)
  return type(value) == "string" and #value > 0 and #value <= (maxLength or 96)
    and value:match("^[A-Za-z0-9._-]+$") ~= nil
    and not value:find("..", 1, true)
end

local function expectedInstallId(filesystemAddress)
  if not computerLoaded or type(computer) ~= "table" or type(computer.address) ~= "function" then
    return nil, "computer identity unavailable"
  end
  local ok, address = pcall(computer.address)
  if not ok or not validUuid(address) then return nil, "computer identity is not a full address" end
  return "oc-" .. address .. "-" .. filesystemAddress
end

local function proxyAddress(proxy)
  local address = type(proxy) == "table" and proxy.address or nil
  if not validUuid(address) then return nil end
  return address
end

local function canonicalExact(path, label)
  if type(fs.canonical) ~= "function" then
    return nil, "filesystem canonicalization unavailable"
  end
  local ok, canonical = pcall(fs.canonical, path)
  if not ok or type(canonical) ~= "string" then
    return nil, S(label) .. " cannot canonicalize: " .. S(canonical)
  end
  if canonical ~= path then return nil, S(label) .. " not canonical: " .. S(path) end
  return true
end

local function linkFree(path, label)
  if type(fs.isLink) ~= "function" then
    return nil, "filesystem link inspection unavailable"
  end
  local prefix = ""
  for segment in path:gmatch("[^/]+") do
    prefix = prefix .. "/" .. segment
    local ok, linked, reason = pcall(fs.isLink, prefix)
    if not ok or linked == nil then
      return nil, "cannot inspect link " .. prefix .. ": " .. S(ok and reason or linked)
    end
    if linked == true then return nil, S(label) .. " traverses link: " .. prefix end
  end
  return true
end

local function sameProxy(path, expectedAddress, label)
  if type(fs.get) ~= "function" then
    return nil, "filesystem ownership inspection unavailable"
  end
  local ok, proxy, mountPath = pcall(fs.get, path)
  if not ok or type(proxy) ~= "table" then
    return nil, "cannot identify " .. S(label) .. " filesystem: " .. S(ok and mountPath or proxy)
  end
  local address = proxyAddress(proxy)
  if not address then return nil, S(label) .. " filesystem has no canonical full address" end
  if address ~= expectedAddress then
    return nil, S(label) .. " crosses filesystems: " .. expectedAddress .. " != " .. address
  end
  return true
end

local function securePath(path, expectedAddress, label)
  local ok, reason = canonicalExact(path, label)
  if not ok then return nil, reason end
  ok, reason = linkFree(path, label)
  if not ok then return nil, reason end
  return sameProxy(path, expectedAddress, label)
end

local function readBounded(path, label)
  label = S(label)
  local handle, why = io.open(path, "r")
  if not handle then return nil, label .. " cannot open: " .. S(why) end
  local ok, value, detail = pcall(handle.read, handle, LIMIT + 1)
  local closeOk, closed, closeWhy = pcall(handle.close, handle)
  if not ok or type(value) ~= "string" then return nil, label .. " cannot read: " .. S(ok and detail or value) end
  if #value > LIMIT then return nil, label .. " exceeds " .. LIMIT .. " bytes" end
  if not closeOk or closed == false or (closed == nil and closeWhy) then return nil, label .. " cannot close: " .. S(closeWhy or closed) end
  return value
end

local function parseControl(text, label)
  label = S(label)
  if type(text) ~= "string" or text == "" then return nil, label .. " is empty" end
  if text:sub(-1) ~= "\n" then return nil, label .. " must end with newline" end
  if text:find("[%z\1-\9\11-\31\127]") then
    return nil, label .. " contains control byte"
  end
  local values, count = {}, 0
  for line in text:gmatch("([^\n]*)\n") do
    local expectedKey = ORDER[count + 1]
    if line == "" then return nil, label .. " contains empty row" end
    local key, value = line:match("^([a-z_]+)=([^=]+)$")
    if not key then return nil, label .. " contains malformed field" end
    if key ~= expectedKey then
      return nil, label .. " field order invalid; expected " .. S(expectedKey)
    end
    values[key], count = value, count + 1
  end
  if count ~= #ORDER then return nil, label .. " must contain eight fields" end
  if values.format ~= "1" or values.product ~= "maintainer" then
    return nil, label .. " has wrong format or product"
  end
  if not validUuid(values.address) then return nil, label .. " has invalid full address" end
  if not validToken(values.install_id, 96) then return nil, label .. " has invalid install_id" end
  if not validToken(values.release, 128) then return nil, label .. " has invalid release" end
  if not validDigest(values.bundle) or not validDigest(values.contract) or not validDigest(values.manifest) then
    return nil, label .. " has invalid digest"
  end
  if values.contract ~= EXPECTED_CONTRACT then return nil, label .. " target contract mismatch" end
  local installId, installReason = expectedInstallId(values.address)
  if not installId then return nil, label .. " cannot bind host: " .. S(installReason) end
  if values.install_id ~= installId then return nil, label .. " belongs to another Maintainer host" end
  return values
end

local function readControl(path, label, expectedAddress)
  local present, why = safeExists(path)
  if present == nil then return nil, why end
  if not present then return nil, S(label) .. " is missing", "absent" end
  local ok; ok, why = securePath(path, expectedAddress, label)
  if not ok then return nil, why end
  local text; text, why = readBounded(path, label)
  if not text then return nil, why end
  return parseControl(text, label)
end

local function sentinelState(path, address, label)
  local present, why = safeExists(path)
  if present == nil then return { present = true, readable = false, reason = why } end
  if not present then return { present = false, readable = false, reason = "missing" } end
  local ok; ok, why = securePath(path, address, label)
  if not ok then return { present = true, readable = false, reason = why } end
  local handle; handle, why = io.open(path, "r")
  if not handle then return { present = true, readable = false, reason = S(why) } end
  local readOk, byte, readWhy = pcall(handle.read, handle, 1)
  local closeOk, closed, closeWhy = pcall(handle.close, handle)
  if not readOk or type(byte) ~= "string" or #byte ~= 1 then return { present = true, readable = false, reason = S(readOk and readWhy or byte) } end
  if not closeOk or closed == false or (closed == nil and closeWhy) then return { present = true, readable = false, reason = S(closeWhy or closed) } end
  return { present = true, readable = true }
end

local function rootAddress()
  if type(fs.get) ~= "function" then return nil, "root ownership inspection unavailable" end
  local ok, proxy, reason = pcall(fs.get, "/")
  if not ok or type(proxy) ~= "table" then return nil, "cannot identify root filesystem: " .. S(ok and reason or proxy) end
  local address = proxyAddress(proxy)
  if not address then return nil, "root filesystem has no canonical full address" end
  return address
end

local function inspectLocal(partial)
  local address, addressReason = rootAddress()
  if not address then return nil, addressReason end
  local core = sentinelState(CORE, address, "local Core sentinel")
  local dashboard = sentinelState(DASH, address, "local Dashboard sentinel")
  local marker, markerReason, markerState = readControl(MARK, "local marker", address)
  if marker and marker.address ~= address then
    marker, markerReason = nil, "local active marker address mismatch " .. address
  end
  if core.readable and dashboard.readable and marker then
    marker.mountPath, marker.runtimeRoot, marker.source = "/", "/", "local"
    marker.localRuntime = true
    return marker
  end
  if core.present or dashboard.present or markerState ~= "absent" then
    if partial then
      return { address = address, mountPath = "/", runtimeRoot = "/", source = "local_partial",
        localRuntime = true, partial = true, core = core, dashboard = dashboard,
        marker = marker, markerReason = markerReason }
    end
    return nil, "local runtime partial/unreadable; Core=" .. S(core.reason or "ok")
      .. " Dashboard=" .. S(dashboard.reason or "ok")
      .. " Identity=" .. S(marker and "ok" or markerReason)
  end
  return false
end

local function enumerateMounts()
  if type(fs.mounts) ~= "function" then return nil, "mount enumeration unavailable" end
  local ok, iterator = pcall(fs.mounts)
  if not ok or type(iterator) ~= "function" then return nil, "cannot enumerate mounts: " .. S(iterator) end
  local rows, skipped, count = {}, {}, 0
  while true do
    local stepOk, proxy, mountPath = pcall(iterator)
    if not stepOk then return nil, "mount enumeration failed: " .. S(proxy) end
    if proxy == nil then break end
    count = count + 1
    if count > MOUNTS then return nil, "mount limit " .. MOUNTS .. " exceeded" end
    local address = proxyAddress(proxy)
    local systemMount = type(mountPath) == "string" and (mountPath == "/"
      or mountPath == "/dev" or mountPath:match("^/dev/")
      or mountPath == "/tmp" or mountPath:match("^/tmp/"))
    if systemMount then
      skipped[#skipped + 1] = "skipped system mount " .. mountPath
    elseif not address then
      skipped[#skipped + 1] = "skipped non-addressable mount " .. S(mountPath)
    elseif type(mountPath) ~= "string" or mountPath:sub(1, 1) ~= "/" then
      skipped[#skipped + 1] = "skipped invalid mount for " .. address
    else
      local valid, reason = canonicalExact(mountPath, "mount path")
      if valid then rows[#rows + 1] = { proxy = proxy, address = address, path = mountPath }
      else skipped[#skipped + 1] = "skipped " .. address .. ": " .. S(reason) end
    end
  end
  table.sort(rows, function(left, right)
    if left.address == right.address then return left.path < right.path end
    return left.address < right.address
  end)
  return rows, nil, skipped
end

local function sameControl(left, right)
  for _, key in ipairs(ORDER) do if left[key] ~= right[key] then return false, key end end
  return true
end

local function inspectExternal(row, selector, partial)
  local markerPath = join(row.path, MARK)
  local present, why = safeExists(markerPath)
  if present == nil then return nil, why, "invalid" end
  if not present then return nil, nil, "absent" end
  local secure; secure, why = securePath(markerPath, row.address, "active marker")
  if not secure then return nil, why, "invalid" end
  local marker; marker, why = readControl(markerPath, "active marker", row.address)
  if not marker then return nil, why, "invalid" end
  if marker.address ~= row.address then
    return nil, "active marker address mismatch " .. row.address, "invalid"
  end
  if selector then
    local equal, key = sameControl(marker, selector)
    if not equal then return nil, "active marker differs from selector field " .. S(key), "invalid" end
  end
  local runtimeRoot = join(row.path, REL .. marker.release .. SUFFIX)
  secure, why = securePath(runtimeRoot, row.address, "runtime root")
  if not secure then return nil, why, "invalid" end
  local core = sentinelState(runtimeRoot .. CORE, row.address, "runtime Core sentinel")
  local dashboard = sentinelState(runtimeRoot .. DASH, row.address, "runtime Dashboard sentinel")
  if not core.readable or not dashboard.readable then
    if not partial then
      return nil, "runtime sentinels incomplete; Core=" .. S(core.reason or "ok")
        .. " Dashboard=" .. S(dashboard.reason or "ok"), "invalid"
    end
  end
  return {
    address = row.address, mountPath = row.path, runtimeRoot = runtimeRoot,
    install_id = marker.install_id, release = marker.release, bundle = marker.bundle,
    contract = marker.contract, manifest = marker.manifest, markerPath = markerPath,
    source = selector and "selector" or "scan", partial = not (core.readable and dashboard.readable),
    core = core, dashboard = dashboard,
  }
end

local function chooseForAddress(rows, address, selector, partial, notes)
  local found, chosen
  for _, row in ipairs(rows) do
    if row.address == address then
      found = true
      local candidate, reason, state = inspectExternal(row, selector, partial)
      if candidate then
        if chosen then
          local equal = chosen.release == candidate.release and chosen.install_id == candidate.install_id
            and chosen.bundle == candidate.bundle and chosen.manifest == candidate.manifest
          if not equal then return nil, "conflicting markers at address " .. address end
        else
          chosen = candidate
        end
      elseif state ~= "absent" then
        notes[#notes + 1] = address .. " " .. row.path .. ": " .. S(reason)
      end
    end
  end
  if not found then return nil, "selected address not mounted: " .. address end
  if not chosen then return nil, "selected address lacks runtime: " .. address end
  return chosen
end

local function discover(partial)
  local notes = {}
  local selectorPresent, why = safeExists(SEL)
  if selectorPresent == nil then return nil, "cannot inspect runtime selector: " .. S(why), notes end
  if selectorPresent then
    local root; root, why = rootAddress()
    if not root then return nil, why, notes end
    local selector; selector, why = readControl(SEL, "runtime selector", root)
    if not selector then return nil, "runtime selector invalid: " .. S(why), notes end
    local rows, skipped; rows, why, skipped = enumerateMounts()
    if not rows then return nil, why, notes end
    for _, note in ipairs(skipped or {}) do notes[#notes + 1] = note end
    local candidate; candidate, why = chooseForAddress(rows, selector.address, selector, partial, notes)
    if not candidate then return nil, why, notes end
    return candidate, nil, notes
  end
  local localCandidate, localReason = inspectLocal(partial)
  if localCandidate then return localCandidate, nil, notes end
  if localCandidate == nil then return nil, localReason, notes end
  local rows, skipped; rows, why, skipped = enumerateMounts()
  if not rows then return nil, why, notes end
  for _, note in ipairs(skipped or {}) do notes[#notes + 1] = note end
  local seen, candidates = {}, {}
  for _, row in ipairs(rows) do
    if not seen[row.address] then
      seen[row.address] = true
      local candidate = chooseForAddress(rows, row.address, nil, partial, notes)
      if candidate then candidates[#candidates + 1] = candidate end
    end
  end
  table.sort(candidates, function(left, right) return left.address < right.address end)
  if #candidates == 0 then return nil, "no valid Maintainer runtime was found", notes end
  if #candidates > 1 then
    for _, candidate in ipairs(candidates) do notes[#notes + 1] = "valid " .. candidate.address .. " " .. candidate.mountPath end
    return nil, "ambiguous Maintainer runtime: " .. S(#candidates) .. " volumes valid", notes
  end
  return candidates[1], nil, notes
end

local function selection(partial)
  local cache = partial and partialCache or completeCache
  if not cache.done then
    cache.value, cache.reason, cache.diagnostics = discover(partial)
    cache.done = true
  end
  return cache.value, cache.reason, cache.diagnostics
end

local function inhibitReason()
  local inhibited, reason = safeExists(INHIBIT)
  if inhibited == nil then return "cannot inspect release inhibit: " .. S(reason) end
  if inhibited then
    return "release inhibit present; activation blocked until recovery"
  end
  return nil
end

function bootstrap.select()
  return selection(false)
end

local function validLogicalPath(path)
  return type(path) == "string" and #path <= 240
    and path:match("^/usr/lib/oc/[%w_./%-]+$") ~= nil
    and not path:find("..", 1, true) and not path:find("//", 1, true)
end

function bootstrap.resolve(logicalPath, options)
  if not validLogicalPath(logicalPath) then
    return nil, "logical path outside /usr/lib/oc: " .. S(logicalPath)
  end
  local selected, reason, notes = selection(type(options) == "table" and options.allow_partial == true)
  if not selected then return nil, reason, notes end
  if selected.runtimeRoot == "/" then return logicalPath, nil, selected end
  return selected.runtimeRoot .. logicalPath, nil, selected
end

local function prependPackagePaths(root)
  local modulePath, initPath = root .. "/usr/lib/?.lua", root .. "/usr/lib/?/init.lua"
  local retained = {}
  for value in S(package.path or ""):gmatch("([^;]+)") do
    if value ~= modulePath and value ~= initPath then retained[#retained + 1] = value end
  end
  package.path = modulePath .. ";" .. initPath .. (#retained > 0 and ";" .. table.concat(retained, ";") or "")
end

local function blocker(message)
  return function() error(message, 0) end
end

local function guardsIntact()
  local searchers = package.searchers or package.loaders
  local guards = package.__oc_guards
  if searchers ~= package.__oc_searchers or type(guards) ~= "table" then return false end
  for key, value in pairs(searchers) do if guards[key] ~= value then return false end end
  for key, value in pairs(guards) do if searchers[key] ~= value then return false end end
  return true
end

local function installExternalSearcher(selected)
  if package.__oc_root then
    if package.__oc_root == selected.runtimeRoot and guardsIntact() then return true end
    return nil, "other trusted runtime active: " .. S(package.__oc_root)
  end
  for name in pairs(package.loaded) do
    if type(name) == "string" and name:match("^oc%.") then
      return nil, "OC module already loaded from unproven runtime: " .. name
    end
  end
  local searchers = package.searchers or package.loaders
  if type(searchers) ~= "table" then return nil, "package searchers unavailable" end
  local function trustedSearcher(name)
    if type(name) ~= "string" or not name:match("^oc%.") then return nil end
    if not name:match("^oc%.[%w_%.]+$") or name:find("..", 1, true) then
      return blocker("trusted runtime rejected OC module " .. S(name)), name
    end
    local relative = name:gsub("%.", "/")
    local base = selected.runtimeRoot .. "/usr/lib/" .. relative
    for _, path in ipairs({ base .. ".lua", base .. "/init.lua" }) do
      local present, why = safeExists(path)
      if present == nil then
        return blocker("trusted runtime cannot inspect " .. name .. ": " .. S(why)), path
      end
      if present then
        local loader, why = loadfile(path, "t", _ENV)
        if loader then return loader, path end
        return blocker("trusted runtime cannot load " .. name .. ": " .. S(why)), path
      end
    end
    return blocker("trusted runtime module missing: " .. name), base .. ".lua"
  end
  local guards = {}
  for key, searcher in pairs(searchers) do
    local delegate = searcher
    local function guard(name)
      if type(name) == "string" and name:match("^oc%.") then return trustedSearcher(name) end
      return delegate(name)
    end
    searchers[key], guards[key] = guard, guard
  end
  package.__oc_root = selected.runtimeRoot
  package.__oc_searchers, package.__oc_guards = searchers, guards
  return true
end

function bootstrap.activate()
  local blocked = inhibitReason()
  if blocked then return nil, blocked end
  local selected, reason, notes = selection(false)
  if not selected then return nil, reason, notes end
  if selected.localRuntime then
    active = selected
    return true, nil, selected
  end
  local ok, guardReason = installExternalSearcher(selected)
  if not ok then return nil, guardReason, notes end
  prependPackagePaths(selected.runtimeRoot)
  active = selected
  return true, nil, selected
end

local function selectedControl(selected)
  return {
    format = "1", product = "maintainer", address = selected.address,
    install_id = selected.install_id, release = selected.release,
    bundle = selected.bundle, contract = selected.contract, manifest = selected.manifest,
  }
end

function bootstrap.verifyActive()
  if not active then return nil, "inactive" end
  local blocked = inhibitReason()
  if blocked then return nil, blocked end
  local selectorPresent, why = safeExists(SEL)
  if selectorPresent == nil then return nil, "cannot inspect runtime selector: " .. S(why) end
  if active.localRuntime then
    if selectorPresent then return nil, "runtime selector appeared after LOCAL activation" end
    local current; current, why = inspectLocal(false)
    if not current then return nil, "LOCAL runtime failed: " .. S(why or "missing") end
    local equal, field = sameControl(current, selectedControl(active))
    if not equal then return nil, "LOCAL marker changed field " .. S(field) end
    return true, nil, active
  end
  if not guardsIntact() then return nil, "package searcher guard changed" end
  local expected = selectedControl(active)
  if active.source == "selector" then
    if not selectorPresent then return nil, "runtime selector disappeared" end
    local root; root, why = rootAddress()
    if not root then return nil, why end
    local selector; selector, why = readControl(SEL, "runtime selector", root)
    if not selector then return nil, "runtime selector failed: " .. S(why) end
    local equal, field = sameControl(selector, expected)
    if not equal then return nil, "runtime selector changed field " .. S(field) end
  elseif selectorPresent then
    return nil, "runtime selector appeared after scan activation"
  end
  local rows; rows, why = enumerateMounts()
  if not rows then return nil, why end
  local activeRow
  for _, row in ipairs(rows) do
    if row.address == active.address and row.path == active.mountPath then
      activeRow = row; break
    end
  end
  if not activeRow then
    return nil, "runtime not mounted " .. active.mountPath .. " address " .. active.address
  end
  local candidate; candidate, why = inspectExternal(activeRow, expected, false)
  if not candidate then return nil, "active runtime failed: " .. S(why) end
  if candidate.runtimeRoot ~= active.runtimeRoot then return nil, "active runtime root changed" end
  return true, nil, active
end

function bootstrap.activateOrError()
  local ok, reason, selected = bootstrap.activate()
  if ok then return selected end
  error("Maintainer runtime activation failed: " .. S(reason), 0)
end

function bootstrap.activateOrExit()
  local ok, result = pcall(bootstrap.activateOrError)
  if ok then return result end
  if io and io.stderr and type(io.stderr.write) == "function" then io.stderr:write(result .. "\n") end
  if os and type(os.exit) == "function" then os.exit(1) end
  error(result, 0)
end

return bootstrap
local store = require("oc.core.config_store")

local config = {}

local luaKeywords = {
  ["and"] = true, ["break"] = true, ["do"] = true, ["else"] = true,
  ["elseif"] = true, ["end"] = true, ["false"] = true, ["for"] = true,
  ["function"] = true, ["goto"] = true, ["if"] = true, ["in"] = true,
  ["local"] = true, ["nil"] = true, ["not"] = true, ["or"] = true,
  ["repeat"] = true, ["return"] = true, ["then"] = true, ["true"] = true,
  ["until"] = true, ["while"] = true
}

local keyTypeOrder = { number = 1, string = 2, boolean = 3 }

local function numberText(value)
  if value ~= value or value == math.huge or value == -math.huge then
    return nil, "config cannot serialize a non-finite number"
  end
  local text = string.format("%.17g", value)
  return text == "-0" and "0" or text
end

local function quoteString(value)
  local output = { "\"" }
  for index = 1, #value do
    local byte = string.byte(value, index)
    if byte == 34 then
      output[#output + 1] = "\\\""
    elseif byte == 92 then
      output[#output + 1] = "\\\\"
    elseif byte >= 32 and byte <= 126 then
      output[#output + 1] = string.char(byte)
    else
      output[#output + 1] = string.format("\\%03d", byte)
    end
  end
  output[#output + 1] = "\""
  return table.concat(output)
end

local function keyText(key)
  local kind = type(key)
  if kind == "string" then
    if key:match("^[%a_][%w_]*$") and not luaKeywords[key] then return key end
    return "[" .. quoteString(key) .. "]"
  elseif kind == "number" then
    local text, reason = numberText(key)
    return text and "[" .. text .. "]" or nil, reason
  elseif kind == "boolean" then
    return key and "[true]" or "[false]"
  end
  return nil, "config cannot serialize a " .. kind .. " table key"
end

local function lessKey(left, right)
  local leftKind, rightKind = type(left), type(right)
  if leftKind ~= rightKind then return keyTypeOrder[leftKind] < keyTypeOrder[rightKind] end
  if leftKind == "number" or leftKind == "string" then return left < right end
  return left == false and right == true
end

local renderValue

local function renderTable(value, depth, active)
  if active[value] then return nil, "config cannot serialize a recursive table" end
  active[value] = true

  local arrayLength = 0
  while rawget(value, arrayLength + 1) ~= nil do arrayLength = arrayLength + 1 end
  local mapKeys = {}
  for key in next, value do
    local isArray = type(key) == "number" and key >= 1 and key % 1 == 0 and key <= arrayLength
    if not isArray then
      local renderedKey, keyReason = keyText(key)
      if not renderedKey then
        active[value] = nil
        return nil, keyReason
      end
      mapKeys[#mapKeys + 1] = { key = key, text = renderedKey }
    end
  end
  table.sort(mapKeys, function(left, right) return lessKey(left.key, right.key) end)

  local lines = {}
  for index = 1, arrayLength do
    local rendered, reason = renderValue(value[index], depth + 1, active)
    if not rendered then
      active[value] = nil
      return nil, reason
    end
    lines[#lines + 1] = string.rep("  ", depth + 1) .. rendered .. ","
  end
  for _, entry in ipairs(mapKeys) do
    local rendered, reason = renderValue(value[entry.key], depth + 1, active)
    if not rendered then
      active[value] = nil
      return nil, reason
    end
    lines[#lines + 1] = string.rep("  ", depth + 1) .. entry.text .. " = " .. rendered .. ","
  end
  active[value] = nil
  if #lines == 0 then return "{}" end
  return "{\n" .. table.concat(lines, "\n") .. "\n" .. string.rep("  ", depth) .. "}"
end

renderValue = function(value, depth, active)
  local kind = type(value)
  if kind == "nil" then return "nil" end
  if kind == "boolean" then return value and "true" or "false" end
  if kind == "number" then return numberText(value) end
  if kind == "string" then return quoteString(value) end
  if kind == "table" then return renderTable(value, depth, active) end
  return nil, "config cannot serialize a " .. kind .. " value"
end

function config.render(values)
  return renderValue(values, 0, {})
end

function config.load(path, defaults)
  return store.load(path, defaults)
end

function config.save(path, values)
  return store.save(path, values, config.render)
end

return config
-- Filesystem side of durable config persistence. Kept separate from the
-- renderer so both modules stay within the in-game hand-paste budget.
local filesystem = require("filesystem")
local serialization = require("serialization")

local store = {}

local function shallowCopy(source)
  local copy = {}
  if type(source) == "table" then
    for key, value in pairs(source) do copy[key] = value end
  end
  return copy
end

local function exists(path)
  local ok, present, reason = pcall(filesystem.exists, path)
  if not ok then return nil, tostring(present) end
  if type(present) ~= "boolean" then return nil, tostring(reason or "could not inspect " .. tostring(path)) end
  return present
end

local function rename(from, to)
  local ok, result, reason = pcall(filesystem.rename, from, to)
  if not ok or result ~= true then return false, tostring(reason or result or "rename failed") end
  return true
end

local function remove(path)
  local present, presentReason = exists(path)
  if present == nil then return false, presentReason end
  if not present then return true end
  local ok, result, reason = pcall(filesystem.remove, path)
  if not ok or result ~= true then return false, tostring(reason or result or "remove failed") end
  return true
end

local function ensureParent(path)
  local ok, parent = pcall(filesystem.path, path)
  if not ok then return false, tostring(parent) end
  if not parent or parent == "" then return true end
  local present, presentReason = exists(parent)
  if present == nil then return false, presentReason end
  if present then return true end
  local made, result, reason = pcall(filesystem.makeDirectory, parent)
  if not made or result == false then return false, tostring(reason or result or "could not create " .. parent) end
  local verified, verifyReason = exists(parent)
  if verified ~= true then return false, verifyReason or ("could not create " .. parent) end
  return true
end

local function readFile(path)
  local present, presentReason = exists(path)
  if present == nil then return nil, presentReason, nil end
  if not present then return nil, nil, false end
  local opened, handle, openReason = pcall(io.open, path, "r")
  if not opened then return nil, tostring(handle), true end
  if not handle then return nil, tostring(openReason or "could not open " .. tostring(path)), true end
  local readOk, body, readReason = pcall(function() return handle:read("*a") end)
  local closeOk, closed, closeReason = pcall(function() return handle:close() end)
  if not readOk then return nil, tostring(readReason or body), true end
  if not closeOk or closed == false then return nil, tostring(closeReason or closed or "could not close " .. tostring(path)), true end
  return body or "", nil, true
end

local function writeFile(path, body)
  local opened, handle, openReason = pcall(io.open, path, "w")
  if not opened then return false, tostring(handle) end
  if not handle then return false, tostring(openReason or "could not write " .. tostring(path)) end
  local writeOk, wrote, writeReason = pcall(function() return handle:write(body) end)
  local closeOk, closed, closeReason = pcall(function() return handle:close() end)
  if not writeOk or wrote == nil or wrote == false then return false, tostring(writeReason or wrote or "write failed") end
  if not closeOk or closed == false then return false, tostring(closeReason or closed or "close failed") end
  return true
end

local function decodeTable(body)
  if body == "" then return nil, "config file is empty" end
  local decoded, loaded, reason = pcall(serialization.unserialize, body)
  if not decoded then return nil, tostring(loaded) end
  if type(loaded) ~= "table" then return nil, reason or "config file did not contain a table" end
  return loaded
end

function store.load(path, defaults)
  local result = shallowCopy(defaults)
  if not path then return result end
  local body, readReason, present = readFile(path)
  if present == nil then return nil, readReason end
  if not present then
    -- Use the verified prior policy after an interrupted promotion, but do not
    -- promote/delete it implicitly; the operator recovery path owns that.
    body, readReason, present = readFile(path .. ".previous")
    if present == nil then return nil, readReason end
    if not present then return result end
  end
  local loaded, reason = decodeTable(body)
  if not loaded then return nil, reason end
  for key, value in pairs(loaded) do result[key] = value end
  return result
end

function store.save(path, values, render)
  local rendered, renderReason = render(values or {})
  if not rendered then return false, renderReason end
  local parentOk, parentReason = ensureParent(path)
  if not parentOk then return false, parentReason end
  local staged, previous = path .. ".new", path .. ".previous"
  local stagedPresent, stagedReason = exists(staged)
  if stagedPresent == nil then return false, stagedReason end
  local previousPresent, previousReason = exists(previous)
  if previousPresent == nil then return false, previousReason end
  if stagedPresent or previousPresent then return false, "configuration requires recovery before saving: " .. tostring(path) end

  local current, currentReason, currentPresent = readFile(path)
  if currentPresent == nil then return false, currentReason end
  if currentPresent then
    local decoded, decodeReason = decodeTable(current)
    if not decoded then return false, "refusing to overwrite unreadable existing config: " .. tostring(decodeReason) end
  end
  local wrote, writeReason = writeFile(staged, rendered .. "\n")
  if not wrote then remove(staged); return false, writeReason end
  local stagedBody, stagedReadReason, stagedExists = readFile(staged)
  if stagedExists ~= true then
    remove(staged)
    return false, "staged config verification failed: " .. tostring(stagedReadReason)
  end
  local decoded, decodeReason = decodeTable(stagedBody)
  if not decoded then
    remove(staged)
    return false, "staged config verification failed: " .. tostring(decodeReason)
  end

  local moved = false
  if currentPresent then
    local moveOk, moveReason = rename(path, previous)
    if not moveOk then remove(staged); return false, "could not preserve prior config: " .. tostring(moveReason) end
    moved = true
  end
  local promoted, promoteReason = rename(staged, path)
  if not promoted then
    if moved then rename(previous, path) end
    remove(staged)
    return false, "could not promote staged config: " .. tostring(promoteReason)
  end
  if moved then
    local cleaned, cleanupReason = remove(previous)
    if not cleaned then return false, "config promoted but prior cleanup requires recovery: " .. tostring(cleanupReason) end
  end
  return true
end

return store
local computer = require("computer")
local filesystem = require("filesystem")

local logger = {}
local levels = { debug = 10, info = 20, warn = 30, error = 40 }

local function ensureParent(path)
  local parent = filesystem.path(path)
  if parent and parent ~= "" and not filesystem.exists(parent) then
    filesystem.makeDirectory(parent)
  end
end

function logger.new(path, minimumLevel, maxBytes)
  local instance = {
    path = path or "/var/oc/core.log",
    minimum = levels[minimumLevel or "info"] or levels.info,
    maxBytes = maxBytes or 8192
  }

  function instance:write(level, message)
    local numericLevel = levels[level or "info"] or levels.info
    if numericLevel < self.minimum then
      return true
    end

    ensureParent(self.path)
    if filesystem.exists(self.path) and filesystem.size(self.path) > self.maxBytes then
      filesystem.remove(self.path .. ".1")
      filesystem.rename(self.path, self.path .. ".1")
    end

    local handle, reason = io.open(self.path, "a")
    if not handle then
      return false, reason
    end

    handle:write(string.format("%.2f [%s] %s\n", computer.uptime(), level or "info", tostring(message)))
    handle:close()
    return true
  end

  return instance
end

return loggerlocal event = require("event")
local computer = require("computer")

local scheduler = {}

function scheduler.new()
  return { tasks = {} }
end

function scheduler.every(state, name, interval, callback)
  state.tasks[#state.tasks + 1] = {
    name = name,
    interval = math.max(1, interval or 1),
    callback = callback,
    nextRun = 0
  }
end

function scheduler.runOnce(state)
  local now = computer.uptime()
  for _, task in ipairs(state.tasks) do
    if now >= task.nextRun then
      task.nextRun = now + task.interval
      task.callback(now, task.name)
    end
  end
end

function scheduler.run(state, stopSignal, idleSeconds)
  while true do
    scheduler.runOnce(state)
    local signal = table.pack(event.pull(idleSeconds or 1))
    if signal.n > 0 and signal[1] == stopSignal then
      return true
    end
  end
end

return schedulerlocal component = require("component")

local registry = {}

function registry.list(componentType)
  local found = {}
  for address, kind in component.list(componentType) do
    found[#found + 1] = { address = address, type = kind }
  end
  return found
end

function registry.first(componentType)
  for address, kind in component.list(componentType) do
    return address, kind
  end
  return nil
end

function registry.proxy(address)
  if not address then
    return nil, "missing component address"
  end
  return component.proxy(address)
end

function registry.methods(address)
  local proxy, reason = registry.proxy(address)
  if not proxy then
    return nil, reason
  end

  local names = {}
  for methodName in pairs(proxy) do
    names[#names + 1] = methodName
  end
  table.sort(names)
  return names
end

return registrylocal component = require("component")
local config = require("oc.core.config")
local filesystem = require("filesystem")
local okComputer, computer = pcall(require, "computer"); if not okComputer then computer = nil end

local card = {}

card.configPath = "/etc/oc/data-card.cfg"
card.cacheSeconds = 300
card.failureRetrySeconds = 60
card.maxCards = 8

local ABC_SHA256 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
local cache

local function now()
  if computer and type(computer.uptime) == "function" then
    local ok, value = pcall(computer.uptime)
    if ok then return tonumber(value) or 0 end
  end
  return os.clock and os.clock() or 0
end

local function shallowCopy(value)
  local out = {}
  for key, nested in pairs(type(value) == "table" and value or {}) do
    if type(nested) == "table" then
      local child = {}
      for childKey, childValue in pairs(nested) do child[childKey] = childValue end
      out[key] = child
    else
      out[key] = nested
    end
  end
  return out
end

local function toHex(value)
  if type(value) ~= "string" then return nil end
  local out = {}
  for index = 1, #value do out[index] = string.format("%02x", string.byte(value, index)) end
  return table.concat(out)
end

local function invoke(address, method, ...)
  local ok, value, reason = pcall(component.invoke, address, method, ...)
  if not ok then return nil, tostring(value) end
  if value == nil and reason ~= nil then return nil, tostring(reason) end
  return value
end

local function readPolicy()
  for _, suffix in ipairs({ ".new", ".previous" }) do
    local ok, present, detail = pcall(filesystem.exists, card.configPath .. suffix)
    if not ok or type(present) ~= "boolean" then return nil, "could not inspect Data Card policy recovery state: " .. tostring(detail or present) end
    if present then return nil, "configuration requires recovery before changing Data Card policy" end
  end
  local value, reason = config.load(card.configPath, { format = 1, mode = "auto" })
  if not value then return nil, tostring(reason or "Data Card policy is unreadable") end
  if value.format ~= 1 then return nil, "Data Card policy format is unsupported" end
  if value.mode ~= "auto" and value.mode ~= "off" then
    return nil, "Data Card policy mode must be auto or off"
  end
  return value
end

local function addressSignature(addresses)
  if type(addresses) ~= "table" then return nil end
  local copy = {}
  for _, address in ipairs(addresses) do copy[#copy + 1] = tostring(address) end
  table.sort(copy)
  return table.concat(copy, "|")
end

local function discover(provided)
  local addresses, seen = {}, {}
  local function add(address)
    if type(address) ~= "string" or address == "" or seen[address] then return true end
    seen[address] = true
    addresses[#addresses + 1] = address
    return #addresses <= card.maxCards
  end
  if type(provided) == "table" then
    for _, address in ipairs(provided) do
      if not add(address) then return nil, "more than " .. card.maxCards .. " Data Cards detected" end
    end
  else
    local ok, reason = pcall(function()
      for address in component.list("data", true) do
        if not add(address) then return end
      end
    end)
    if not ok then return nil, "Data Card discovery failed: " .. tostring(reason) end
    if #addresses > card.maxCards then return nil, "more than " .. card.maxCards .. " Data Cards detected" end
  end
  table.sort(addresses)
  return addresses
end

local function methodSet(address)
  local ok, methods = pcall(component.methods, address)
  if not ok or type(methods) ~= "table" then
    return nil, "method discovery failed: " .. tostring(methods)
  end
  return methods
end

local function probe(address)
  local methods, reason = methodSet(address)
  if not methods then return nil, reason end
  if not methods.getLimit or not methods.sha256 then return nil, "getLimit/sha256 callbacks are missing" end
  local limit
  limit, reason = invoke(address, "getLimit")
  limit = tonumber(limit)
  if not limit or limit < 3 then return nil, reason or "reported input limit is below three bytes" end
  limit = math.floor(limit)
  local digest
  digest, reason = invoke(address, "sha256", "abc")
  if not digest then return nil, "SHA-256 self-test failed: " .. tostring(reason) end
  if type(digest) ~= "string" or #digest ~= 32 or toHex(digest) ~= ABC_SHA256 then
    return nil, "SHA-256 self-test returned an invalid binary digest"
  end
  local capabilities = {
    sha256 = true,
    random = methods.random == true,
    aes = methods.encrypt == true and methods.decrypt == true,
    ecc = methods.generateKeyPair == true and methods.deserializeKey == true
      and methods.ecdh == true and methods.ecdsa == true
  }
  local tier = capabilities.ecc and 3 or capabilities.random and 2 or 1
  return { address = address, limit = limit, tier = tier, capabilities = capabilities }
end

local function rank(left, right)
  if left.tier ~= right.tier then return left.tier > right.tier end
  if left.limit ~= right.limit then return left.limit > right.limit end
  return left.address < right.address
end

local function makeStatus(policyMode, state, effective, reason)
  return { policyMode = policyMode, state = state, effective = effective, reason = reason,
    fallback = "software", locked = false }
end

local function scan(options, policy)
  if policy.mode == "off" then
    return makeStatus("off", "OFF_OPERATOR", "off", "disabled by operator")
  end
  local addresses, reason = discover(options.addresses)
  if not addresses then return makeStatus("auto", "DEGRADED_CALL_FAILED", "degraded", reason) end
  if #addresses == 0 then return makeStatus("auto", "OFF_NO_CARD", "off", "no Data Card detected") end
  local candidates, failures = {}, {}
  for _, address in ipairs(addresses) do
    local candidate, probeReason = probe(address)
    if candidate then candidates[#candidates + 1] = candidate
    else failures[#failures + 1] = address:sub(1, 8) .. ": " .. tostring(probeReason) end
  end
  if #candidates == 0 then
    return makeStatus("auto", "DEGRADED_CALL_FAILED", "degraded", table.concat(failures, "; "))
  end
  table.sort(candidates, rank)
  local selected = candidates[1]
  local state = selected.capabilities.random and "ACTIVE" or "PARTIAL"
  local status = makeStatus("auto", state, selected.capabilities.random and "active" or "partial")
  status.address, status.limit, status.tier = selected.address, selected.limit, selected.tier
  status.capabilities, status.cardCount = selected.capabilities, #addresses
  return status
end

local function degrade(status, reason)
  local failed = shallowCopy(status)
  failed.state, failed.effective = "DEGRADED_CALL_FAILED", "degraded"
  failed.reason, failed.expiresAt = tostring(reason or "Data Card call failed"), now() + card.failureRetrySeconds
  cache = failed; return shallowCopy(failed)
end

function card.invalidate() cache = nil end

function card.status(options)
  options = type(options) == "table" and options or {}
  local time, signature = now(), addressSignature(options.addresses)
  local policy, reason = readPolicy()
  if policy and not options.refresh and cache and cache.policyMode == policy.mode
      and time < (tonumber(cache.expiresAt) or 0)
      and (signature == nil or signature == cache.addressSignature) then
    return shallowCopy(cache)
  end
  local status
  if not policy then
    status = makeStatus(nil, "OFF_POLICY_UNREADABLE", "off", reason)
    status.locked = true
  else
    status = scan(options, policy)
  end
  status.addressSignature, status.checkedAt = signature, time
  status.expiresAt = time + card.cacheSeconds
  cache = status
  return shallowCopy(status)
end

local function ready(status) return status.state == "ACTIVE" or status.state == "PARTIAL" end

function card.hash(value, options)
  value = tostring(value or "")
  local status = card.status(options)
  if not ready(status) then return nil, status.reason or "Data Card Assist is off", status end
  if #value > status.limit then
    local limited = shallowCopy(status)
    limited.state, limited.effective = "OFF_LIMIT", "off"
    limited.reason = "input exceeds the Data Card limit"
    return nil, limited.reason, limited
  end
  local digest, reason = invoke(status.address, "sha256", value)
  if type(digest) ~= "string" or #digest ~= 32 then
    status = degrade(status, reason or "SHA-256 returned an invalid binary digest")
    return nil, status.reason, status
  end
  return toHex(digest), nil, status
end

function card.namespaceDigest(seed)
  local status = card.status({ refresh = true })
  if not ready(status) then return nil, status.reason or "Data Card Assist is off", status end
  local body, entropy = tostring(seed or ""), "software-seed"
  if status.capabilities and status.capabilities.random then
    local random, reason = invoke(status.address, "random", 16)
    if type(random) ~= "string" or #random ~= 16 then
      status = degrade(status, reason or "secure random returned an invalid result")
      return nil, status.reason, status
    end
    body, entropy = body .. "\0data-card-random-v1\0" .. random, "hardware-random"
  end
  local digest, reason, result = card.hash(body)
  if not digest then return nil, reason, result end
  result.entropy, result.source = entropy, "data-card"
  return digest:sub(1, 32), nil, result
end

function card.setMode(mode)
  if mode ~= "auto" and mode ~= "off" then return false, "mode must be auto or off" end
  local policy, reason = readPolicy()
  if not policy then card.invalidate(); return false, reason, card.status({ refresh = true }) end
  policy.mode = mode
  local saved
  saved, reason = config.save(card.configPath, policy)
  if not saved then
    card.invalidate()
    return false, tostring(reason or "could not save Data Card policy"), card.status({ refresh = true })
  end
  card.invalidate()
  return true, nil, card.status({ refresh = true })
end

card.toHex = toHex

return card
local component = require("component")
local computer = require("computer")

local health = {}

function health.snapshot(options)
  options = options or {}
  -- A health panel usually needs process facts, not a second component
  -- enumeration. Callers that already own a component cache can opt out and
  -- retain that cache without making an unrelated screen wake the whole bus.
  local componentCounts = options.componentCounts or {}
  if options.includeComponents ~= false then
    componentCounts = {}
    for _, kind in component.list() do
      componentCounts[kind] = (componentCounts[kind] or 0) + 1
    end
  end

  return {
    uptime = computer.uptime(),
    freeMemory = computer.freeMemory(),
    totalMemory = computer.totalMemory(),
    energy = computer.energy(),
    maxEnergy = computer.maxEnergy(),
    components = componentCounts
  }
end

function health.print(snapshot)
  snapshot = snapshot or health.snapshot()
  io.write(string.format("uptime: %.2fs\n", snapshot.uptime))
  io.write(string.format("memory: %d / %d free\n", snapshot.freeMemory, snapshot.totalMemory))
  io.write(string.format("computer energy: %.0f / %.0f\n", snapshot.energy, snapshot.maxEnergy))
  io.write("components:\n")
  for kind, count in pairs(snapshot.components) do
    io.write(string.format("  %s: %d\n", kind, count))
  end
  if type(snapshot.dataCard) == "table" then
    local status = snapshot.dataCard
    io.write(string.format("data card assist: %s / %s", tostring(status.policyMode or "locked"),
      tostring(status.state or "unknown")))
    if status.tier then io.write(string.format(" / tier %d", status.tier)) end
    if status.address then io.write(" / " .. status.address:sub(1, 8)) end
    if status.reason then io.write(" / " .. tostring(status.reason)) end
    io.write("\n")
  end
end

return health
local component = require("component")

local inspect = {}

local function methodNames(address)
  local ok, methods = pcall(component.methods, address)
  if not ok or type(methods) ~= "table" then
    return {}
  end

  local names = {}
  for name in pairs(methods) do
    names[#names + 1] = name
  end
  table.sort(names)
  return names
end

local function hasMethod(row, methodName)
  for _, name in ipairs(row.methods) do
    if name == methodName then
      return true
    end
  end
  return false
end

function inspect.list(filterType)
  local rows = {}
  for address, ctype in component.list(filterType) do
    rows[#rows + 1] = {
      address = address,
      ctype = ctype,
      methods = methodNames(address)
    }
  end
  table.sort(rows, function(a, b)
    if a.ctype == b.ctype then return a.address < b.address end
    return a.ctype < b.ctype
  end)
  return rows
end

function inspect.print(filterType)
  local rows = inspect.list(filterType)
  if #rows == 0 then
    io.write("no components")
    if filterType then io.write(" matching " .. tostring(filterType)) end
    io.write("\n")
    return
  end

  for _, row in ipairs(rows) do
    io.write(string.format("%s %s\n", row.ctype, row.address))
    if #row.methods == 0 then
      io.write("  methods: none visible\n")
    else
      io.write("  methods: " .. table.concat(row.methods, ", ") .. "\n")
    end
  end
end

function inspect.findByMethod(methodName)
  local matches = {}
  for _, row in ipairs(inspect.list()) do
    if hasMethod(row, methodName) then
      matches[#matches + 1] = row
    end
  end
  return matches
end

function inspect.printMethod(methodName)
  if not methodName or methodName == "" then
    io.write("usage: oc-components --method <methodName>\n")
    return
  end

  local rows = inspect.findByMethod(methodName)
  if #rows == 0 then
    io.write("no components expose method " .. tostring(methodName) .. "\n")
    return
  end

  for _, row in ipairs(rows) do
    io.write(string.format("%s %s exposes %s\n", row.ctype, row.address, methodName))
  end
end

return inspectlocal computer = require("computer")
local filesystem = require("filesystem")

local watchdog = {}

local function ensureParent(path)
  local parent = filesystem.path(path)
  if parent and parent ~= "" and not filesystem.exists(parent) then
    filesystem.makeDirectory(parent)
  end
end

function watchdog.heartbeat(path, label)
  path = path or "/var/oc/watchdog.state"
  ensureParent(path)

  local handle, reason = io.open(path, "w")
  if not handle then
    return false, reason
  end

  handle:write(string.format("%s %.2f\n", label or "core", computer.uptime()))
  handle:close()
  return true
end

return watchdog#!/bin/lua
