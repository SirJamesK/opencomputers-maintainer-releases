  memory.outcome, memory.queueAdvance = "submitted", false
  queue.state[id] = memory
  return memory
end
return queue
-- Target-local ownership uncertainty has two independent boundaries:
-- a short virtual CPU reservation lets AE2 telemetry settle, while the longer
-- target cooldown/backoff prevents a duplicate retry of that exact craft.
local ownership = { settleSeconds = 2, recoverySeconds = 600 }

function ownership.quarantined(phase)
  phase = tostring(phase or "")
  return phase == "status_link_lost" or phase == "confirmation_unavailable"
    or phase == "reboot_recovery" or phase == "submit_intent"
end

function ownership.reserve(memory, now, amount)
  memory.ownershipReservationUntil = (tonumber(now) or 0) + ownership.settleSeconds
  if tonumber(amount) then memory.requestedAmount = tonumber(amount) end
end

function ownership.expireManual(memory, row, now, generation, rebooted)
  now, generation = tonumber(now) or 0, tonumber(generation) or 0
  local leaseUntil = tonumber(row and row.leaseUntil) or 0
  if rebooted or type(row) ~= "table" or row.state ~= "running" or leaseUntil > now
      or generation <= (tonumber(memory.manualLeaseExpiredGeneration) or 0) then return false end
  local reason = "manual request lease expired"
    .. (row.phase and (" during " .. tostring(row.phase)) or "") .. "; terminal confirmation unavailable"
  memory.status, memory.attempts = "unknown", math.max(1, tonumber(memory.attempts) or 0)
  memory.phase, memory.statusReason, memory.lastError = "confirmation_unavailable", reason, reason
  memory.lastFailAt, memory.manualLeaseExpiredGeneration = now, generation
  memory.manualGeneration = math.max(tonumber(memory.manualGeneration) or 0, generation)
  memory.nextEligibleAt = math.max(tonumber(memory.nextEligibleAt) or 0, now + 600)
  memory.outcome, memory.queueAdvance = "safety_hold", true
  ownership.reserve(memory, now, row.amount)
  return true
end

function ownership.count(state, now)
  local count = 0
  for _, memory in pairs(state or {}) do
    if (tonumber(memory.ownershipReservationUntil) or 0) > (tonumber(now) or 0) then count = count + 1 end
  end
  return count
end

function ownership.reason(memory, now)
  local seconds = math.max(0, math.ceil((tonumber(memory.nextEligibleAt) or 0) - (tonumber(now) or 0)))
  return tostring(memory.statusReason or memory.lastError or "request ownership unknown")
    .. "; target quarantined; retry in " .. tostring(seconds) .. "s"
end

function ownership.prepareIntent(state, entry, now)
  if type(state) ~= "table" or type(entry) ~= "table" or entry.id == nil then
    return nil, "submit intent requires exact queue state and target id"
  end
  now = tonumber(now) or 0
  local memory = state[entry.id] or {}
  local reason = "durable submit intent exists; AE2 invocation outcome not yet confirmed"
  local sameOutcome = entry.outcomeKey ~= nil and memory.outcomeKey ~= nil
    and tostring(entry.outcomeKey) == tostring(memory.outcomeKey)
  if sameOutcome and memory.phase ~= "submit_intent" then
    return nil, "submit intent outcome already reconciled"
  end
  local replay = sameOutcome
  if not replay then
    memory.status, memory.lastAttemptAt, memory.intentAt = "unknown", now, now
    memory.phase, memory.statusReason, memory.lastError = "submit_intent", reason, reason
    memory.nextEligibleAt, memory.outcomeKey = now + ownership.recoverySeconds, entry.outcomeKey
    ownership.reserve(memory, now, entry.requestedAmount)
    memory.outcome, memory.queueAdvance = "safety_hold", true
  end
  state[entry.id] = memory
  entry.status, entry.phase, entry.statusReason = "blocked", memory.phase, reason
  entry.nextEligibleAt, entry.ownershipReservationUntil = memory.nextEligibleAt, memory.ownershipReservationUntil
  entry.quarantined, entry.retryKind, entry.outcome, entry.queueAdvance = true, "safety_hold", "safety_hold", true
  entry.reason = ownership.reason(memory, now)
  if entry.row then
    entry.row.ready, entry.row.requested = false, false
    entry.row.requestState, entry.row.requestPhase = "blocked", memory.phase
    entry.row.requestStatusReason, entry.row.reason = reason, entry.reason
  end
  return memory
end

function ownership.prepareAutoIntent(api, state, row, entry, generation, now)
  if type(api) ~= "table" or type(api.recordAutoIntent) ~= "function" then
    if row then row.logError = "maintainer lifecycle state unavailable" end
    return false, row and row.logError or "maintainer lifecycle state unavailable"
  end
  local details = { daemonGeneration = generation, requestKey = entry.id,
    outcomeKey = entry.outcomeKey, attemptedAt = entry.attemptedAt, amount = entry.requestedAmount }
  local called, saved, saveErr = pcall(api.recordAutoIntent, row, now, details)
  if not called or saved ~= true then
    local reason = tostring(saveErr or saved or "maintainer lifecycle state save failed")
    if row then row.logError = reason end
    return false, reason
  end
  local prepared, prepareErr = ownership.prepareIntent(state, entry, now)
  if not prepared then return false, prepareErr end
  return true
end

local function seedRows(state, rows, now, seen)
  for _, row in ipairs(rows or {}) do
    local id, phase = row.id and tostring(row.id) or nil, tostring(row.phase or "")
    local uncertain = row.status == "in_flight" or row.quarantined == true or ownership.quarantined(phase)
    local retryable = row.status == "failed" or (row.status == "blocked" and phase == "missing_resources")
    if id and not seen[id] and uncertain then
      local reason = "request ownership unknown after reboot"
      state[id] = { status = "unknown", attempts = math.max(1, tonumber(row.attempts) or 0),
        phase = "reboot_recovery", statusReason = reason, lastError = reason, nextEligibleAt = now + 600,
        requestedAmount = tonumber(row.amount), outcome = "safety_hold", queueAdvance = true }
      ownership.reserve(state[id], now, row.amount); seen[id] = true
    elseif id and not seen[id] and retryable then
      local reason = row.statusReason or row.reason or (phase == "missing_resources" and "missing resources" or "request failed")
      state[id] = { status = phase == "missing_resources" and "resource_blocked" or "failed",
        attempts = math.max(1, tonumber(row.attempts) or 0), phase = phase ~= "" and phase or "failed",
        statusReason = reason, lastError = reason, nextEligibleAt = now + 600,
        outcome = "kickout", queueAdvance = true }; seen[id] = true
    end
  end
end

function ownership.seed(state, durable, now)
  local seen = {}
  seedRows(state, durable and durable.ownershipClaims, now, seen)
  seedRows(state, durable and durable.targetStatus, now, seen)
end

return ownership
local computer = require("computer")
local lineContract = require("oc.ae2.line_contract"); local cpuWitness = require("oc.ae2.maintainer_cpu_witness")
local binding = require("oc.ae2.request_binding"); local requestTracker = require("oc.ae2.request_tracker"); local ownership = require("oc.ae2.maintainer_queue_ownership")
local dispatch = {}; local MAX_AUTO_SUBMITS_PER_CYCLE = 1
local function variantLabel(row)
  row = row or {}; local marker = binding.copyTaggedLabelBinding(row)
  return marker and ("raw=" .. marker.rawLabel)
    or tostring(row.rawLabel or row.label or row.name or "target"):lower()
end
local function kindFor(row)
  local label = tostring(row and (row.rawLabel or row.label) or ""); return row
    and (row.isFluid == true or row.kind == "fluid") and "fluid"
    or (label:find("^[Dd]rops? of%s+") and "fluid" or (row and row.kind or "item"))
end
function dispatch.id(row)
  row = row or {}
  if row.name then
    return table.concat({ tostring(kindFor(row)), tostring(row.name),
      tostring(math.floor(tonumber(row.damage) or 0)), tostring(row.hasTag == true), variantLabel(row) }, ":")
  end
  return tostring(row.label or row.rawLabel or "target"):lower()
end
function dispatch.backoff(attempts)
  attempts = math.max(1, tonumber(attempts) or 1)
  if attempts <= 1 then return 600 end; if attempts == 2 then return 1200 end; return 2400
end
function dispatch.cooldownFor(row)
  row = row or {}; local workflow = type(row.workflow) == "table" and row.workflow or {}
  return tonumber(row.cooldown or workflow.cooldown) or 600
end
local function resourceBlocked(memory) return memory
  and (memory.status == "resource_blocked" or memory.phase == "missing_resources") end
local function quarantinePhase(memory)
  if not memory then return nil end
  local phase = tostring(memory.phase or "")
  local known = ownership.quarantined(phase)
  return known and phase or memory.status == "unknown" and "reboot_recovery" or nil
end
local function activeMaps(manualReservations, trackerSummaries)
  local byId, byLabel, rows = {}, {}, trackerSummaries or requestTracker.summaries()
  local running = {}
  for _, row in ipairs(rows or {}) do
    if row.state == "running" then
      running[#running + 1] = row
      if row.id then byId[row.id] = row end; if row.label then byLabel[tostring(row.label)] = row end
    end
  end
  for id, row in pairs(manualReservations or {}) do
    if not byId[id] then byId[id], running[#running + 1] = row, row end
  end
  return byId, byLabel, running
end
local function cpuSlotKey(active)
  if not active then return nil end
  if active.cpuIndex ~= nil then return "index:" .. tostring(active.cpuIndex) end
  if active.cpuName ~= nil then return "name:" .. tostring(active.cpuName) end
  return tostring(active) end
-- Count tracker/CPU-witness union, not their sum. Unreflected computing jobs
-- remain reserved so one request cannot overbook an unrelated free CPU.
local function trackerReservations(activeRows, activeCrafts)
  local claimed, unreflected = {}, 0
  for _, tracked in ipairs(activeRows or {}) do
    local active = cpuWitness.find(activeCrafts, tracked)
    local key = cpuSlotKey(active)
    if key and not claimed[key] then claimed[key] = true else unreflected = unreflected + 1 end
  end
  return unreflected
end
local function witnessReservations(activeCrafts)
  local seen, count = {}, 0
  for _, active in ipairs(activeCrafts or {}) do
    -- A final output on a lagging busy=false row still needs one explicit slot.
    if active.cpuBusy ~= true then
      local key = cpuSlotKey(active)
      if key and not seen[key] then seen[key], count = true, count + 1 end
    end
  end
  return count
end
local function capacity(status, activeRows, activeCrafts, options)
  options = options or {}
  status = status or {}
  local cpuCount = tonumber(status.totalCpus) or 0
  local ready = tonumber(status.readyCpus) or 0
  if cpuCount < 0 then cpuCount = 0 end; if ready > cpuCount then ready = cpuCount end; if ready < 0 then ready = 0 end
  local busyCpuCount = math.max(0, cpuCount - ready)
  local inFlightCount = #(activeRows or {})
  local unreflected = trackerReservations(activeRows, activeCrafts)
  local witnessOnly = witnessReservations(activeCrafts)
  local ownershipReservations = math.max(0, tonumber(options.ownershipReservationCount) or 0)
  local availableSlots = math.max(0, cpuCount - busyCpuCount - witnessOnly - unreflected - ownershipReservations)
  local cap = tonumber(options.maxSubmitsPerCycle)
  if cap == nil then cap = MAX_AUTO_SUBMITS_PER_CYCLE end
  cap = math.floor(cap); if cap < 0 then cap = 0 end
  cap = math.min(MAX_AUTO_SUBMITS_PER_CYCLE, cap)
  return {
    detectedCpuCount = cpuCount, cpuCount = cpuCount, busyCpuCount = busyCpuCount,
    inFlightCount = inFlightCount, availableSlots = availableSlots, submitCap = cap,
    ownershipReservationCount = ownershipReservations,
    maxSubmits = math.min(availableSlots, cap)
  }
end
local function requestAmount(row)
  local amount = lineContract.requestAmount(row)
  amount = tonumber(amount) or tonumber(row.request) or 0
  if amount < 0 then amount = 0 end
  return amount
end
local function markRowInFlight(row, phase, reason, statusReason)
  if not row then return end
  row.ready, row.reason, row.requestState = false, reason, "running"
  row.requestPhase, row.requestStatusReason = phase, statusReason or reason
end
local function markRowBlocked(row, phase, reason, statusReason)
  if not row then return end
  row.ready, row.reason, row.requestState = false, reason, "blocked"
  row.requestPhase, row.requestStatusReason = phase, statusReason or reason
end
local function updateEntry(queue, row, activeById, activeByLabel, activeCrafts, now)
  local id = dispatch.id(row)
  local memory = queue.state[id] or { attempts = 0 }
  queue.state[id] = memory
  local amount = requestAmount(row)
  local active = activeById[id] or activeByLabel[tostring(row.label or "")]
  local activeCraft = cpuWitness.find(activeCrafts, row)
  local entry = {
    id = id, label = row.label, rawLabel = row.rawLabel, name = row.name, damage = row.damage,
    hasTag = row.hasTag, kind = row.kind, isFluid = row.isFluid, amount = row.amount,
    craftBinding = row.craftBinding,
    current = row.current, min = row.min, stockBelow = row.min, alertBelow = row.alertBelow,
    craftTo = row.craftTo, batch = row.batch, maxRequest = row.maxRequest, lineIntent = row.lineIntent,
    lineAuthority = row.lineAuthority, lineState = row.lineState, lineReason = row.lineReason,
    maxBasis = row.maxBasis, confidence = row.confidence, requestedAmount = amount,
    armed = row.armed == true, requireReadyCpu = row.requireReadyCpu ~= false,
    queuedAt = memory.queuedAt, lastSubmitAt = memory.lastSubmitAt,
    lastDoneAt = memory.lastDoneAt, lastFailAt = memory.lastFailAt,
    attempts = tonumber(memory.attempts) or 0, nextEligibleAt = tonumber(memory.nextEligibleAt) or now,
    phase = memory.phase, statusReason = memory.statusReason or memory.lastError,
    outcome = memory.outcome, queueAdvance = memory.queueAdvance == true,
    ownershipReservationUntil = memory.ownershipReservationUntil,
    quarantineAmount = memory.requestedAmount,
    row = row, trackerBacked = active ~= nil
  }
  if active then
    entry.status, entry.phase, entry.statusReason = "in_flight", active.phase, active.reason
    entry.outcome, entry.queueAdvance = "in_flight", false
    entry.reason = active.phase and ("AE2 job " .. tostring(active.phase)) or "AE2 job in flight"
    if active.reason then entry.reason = entry.reason .. ": " .. tostring(active.reason) end
    markRowInFlight(row, entry.phase, entry.reason, entry.statusReason)
  elseif entry.nextEligibleAt > now and quarantinePhase(memory) then
    entry.status, entry.phase = "blocked", quarantinePhase(memory)
    entry.quarantined, entry.retryKind = true, "safety_hold"
    entry.outcome, entry.queueAdvance = "safety_hold", true
    entry.statusReason = memory.statusReason or memory.lastError
      or (entry.phase == "reboot_recovery" and "request ownership unknown after reboot"
        or entry.phase == "confirmation_unavailable" and "request confirmation unavailable"
        or "AE2 request status link unavailable; submission outcome unknown")
    entry.reason = ownership.reason({ statusReason = entry.statusReason, nextEligibleAt = entry.nextEligibleAt }, now)
    markRowBlocked(row, entry.phase, entry.reason, entry.statusReason)
  elseif not entry.armed then
    entry.status, entry.reason = "blocked", "target disarmed"
    entry.phase, entry.statusReason = nil, nil
    entry.outcome, entry.queueAdvance = "ineligible", true
  elseif activeCraft then
    entry.status, entry.phase, entry.statusReason = "blocked", "cpu_final_output", "AE2 CPU final output matches target"
    entry.outcome, entry.queueAdvance = "already_in_flight", true
    entry.reason = "AE2 CPU final output in flight"
    if activeCraft.cpuName then entry.reason = entry.reason .. ": " .. tostring(activeCraft.cpuName) end
    markRowBlocked(row, entry.phase, entry.reason, entry.statusReason)
  elseif entry.nextEligibleAt > now then
    entry.status = "blocked"
    local remaining = tostring(math.ceil(entry.nextEligibleAt - now)) .. "s"
    if resourceBlocked(memory) then
      entry.phase = "missing_resources"
      entry.statusReason = memory.statusReason or memory.lastError or "missing resources"
      entry.reason = tostring(entry.statusReason) .. "; retry in " .. remaining
    else
      local prefix = (memory.status == "failed" or memory.status == "blocked") and "failure backoff " or "cooldown "
      entry.reason = prefix .. remaining
    end
  elseif (row.ready or (row.reason == "no ready CPU" and entry.requireReadyCpu)) and amount > 0 then
      entry.status = "queued"
      entry.phase, entry.statusReason = nil, nil
      entry.outcome, entry.queueAdvance = "queued", false
      if row.ready then
        entry.reason = row.lineReason or ("stock " .. tostring(row.current or "?") .. " below " .. tostring(row.min or "?"))
      else
        entry.phase, entry.statusReason = "awaiting_cpu", "Flow CPU Gate is ON"
        entry.reason = "waiting for an available crafting CPU"
      end
      memory.queuedAt = memory.queuedAt or now
      entry.queuedAt = memory.queuedAt
  else
    entry.status, entry.reason = "blocked", row.reason or "not eligible"
    entry.phase, entry.statusReason = nil, nil
    entry.outcome, entry.queueAdvance = "ineligible", true
  end
  return entry
end
function dispatch.build(queue, report, options)
  options = options or {}
  local now = computer.uptime()
  local activeById, activeByLabel, activeRows = activeMaps(options.manualReservations, options.trackerSummaries)
  local activeCrafts = report and report.status and report.status.activeCrafts or {}
  local out = capacity(report and report.status, activeRows, activeCrafts, options)
  out.activeInFlightCount = out.inFlightCount
  out.entries, out.ready, out.queueCount, out.readyQueueCount = {}, {}, 0, 0
  out.ownershipQuarantineCount, out.ownershipRetryAt = 0, false
  for index, row in ipairs((report and report.targets) or {}) do
    local entry = updateEntry(queue, row, activeById, activeByLabel, activeCrafts, now)
    entry.queueIndex = index
    out.entries[#out.entries + 1] = entry
    if entry.quarantined == true then
      out.ownershipQuarantineCount = out.ownershipQuarantineCount + 1; local retryAt = tonumber(entry.nextEligibleAt)
      if retryAt then out.ownershipRetryAt = out.ownershipRetryAt and math.min(out.ownershipRetryAt, retryAt) or retryAt end
    end
    if entry.status == "queued" then
      out.queueCount = out.queueCount + 1
      if not out.queueHeadId then
        out.queueHeadId, out.queueHeadIndex = entry.id, index
        out.queueHead = entry
      end
    end
  end
  local head = out.queueHead
  if head and out.maxSubmits > 0 then
    out.ready[1] = head
  elseif head and head.requireReadyCpu == false and out.inFlightCount == 0 and (tonumber(out.detectedCpuCount) or 0) > 0
      and (tonumber(out.ownershipReservationCount) or 0) <= 0
      and (tonumber(out.submitCap) or 0) > 0 then
    -- CPU Gate OFF delegates placement to AE2 like Flow's manual action, but
    -- stays at one unreflected request while every observed CPU is occupied.
    out.maxSubmits, out.cpuGateBypassed = 1, true
    out.ready[1] = head
  elseif head then
    out.submitCapHeld = (tonumber(out.submitCap) or 0) <= 0; out.waitingForCpu = not out.submitCapHeld
    out.waitingForSettlement = out.waitingForCpu and (tonumber(out.ownershipReservationCount) or 0) > 0
    out.queuePausedReason = out.queuePausedReason or (out.submitCapHeld and "automatic submit cap is zero"
      or out.waitingForSettlement and (tostring(out.ownershipReservationCount) .. " uncertain ownership reservation settling")
      or "waiting for an available crafting CPU")
  end
  if out.ownershipQuarantineCount > 0 then
    local noun = out.ownershipQuarantineCount == 1 and "target" or "targets"
    out.queueStatusReason = tostring(out.ownershipQuarantineCount) .. " " .. noun .. " quarantined"
      .. (out.queueCount > 0 and "; unrelated queue continues" or "; waiting for target retry boundary")
    if head and out.maxSubmits <= 0 and out.waitingForCpu then
      out.queuePausedReason = tostring(out.queuePausedReason) .. "; "
        .. tostring(out.ownershipQuarantineCount) .. " " .. noun .. " quarantined separately"
    end
  else
    out.queueStatusReason = false
  end
  out.readyQueueCount = #out.ready
  return out
end
return dispatch
local readable = require("oc.core.config")
local transactionalStore = require("oc.ae2.identity_evidence_store")
local reconcileReceipt = require("oc.ae2.maintainer_reconcile_receipt")
local configSchema = require("oc.ae2.maintainer_daemon_config_schema")
local commissioningAuthority = require("oc.ae2.maintainer_commissioning_authority")

local config = {}
local loadedSnapshots = setmetatable({}, { __mode = "k" })

config.path = "/etc/oc/ae2-maintainer-daemon.cfg"
config.minInterval = 600
config.maxInterval = 604800
config.maxPollInterval = 3600
config.previewTtl = 600
config.defaults = {
  enabled = false,
  interval = 600,
  pollInterval = 600,
  generation = 0,
  forcePlanningSerial = 0,
  maintenanceBrake = false,
  maintenanceBrakeSerial = 0,
  identityReconcileSerial = 0,
  identityReconcileState = "idle",
  identityReconcileAddObserved = true,
  identityCaptureUntil = 0,
  identityCaptureGeneration = 0,
  commissioningState = "idle",
  commissioningSerial = 0
}
local durationSuffixes = { s = 1, m = 60, h = 3600, d = 86400, w = config.maxInterval }
local reconcileStates = {
  idle = true, preparing = true, previewed = true, braking = true, draining = true,
  zero_proven = true, committing = true, complete_safe = true, failed_safe = true
}
local reconcileTransitions = {
  previewed = { braking = true, failed_safe = true },
  braking = { draining = true, failed_safe = true },
  draining = { draining = true, zero_proven = true, failed_safe = true },
  zero_proven = { committing = true, failed_safe = true },
  committing = { committing = true, complete_safe = true, failed_safe = true },
  failed_safe = { failed_safe = true }
}
local commissioningStates = {
  idle = true, requested = true, stopping = true, configuring_craft = true,
  planning_fluid = true, probing_fluid = true, repair_probe = true,
  quarantining_repair = true,
  repair_preview = true, repair_confirm = true, repair_wait = true,
  committing_fluid = true, aborting = true, restoring_policy = true, restoring_daemon = true,
  complete = true, blocked = true
}

local clampNumber, optionalNumber = configSchema.clampNumber, configSchema.optionalNumber
local optionalIndex, optionalText = configSchema.optionalIndex, configSchema.optionalText
local optionalReason = configSchema.optionalReason

local compactCounts = reconcileReceipt.compactCounts
local compactPlanToken = reconcileReceipt.compactPlanToken

function config.parseDuration(value)
  if type(value) == "number" then return value end
  local text = tostring(value or ""):gsub(",", ""):gsub("%s+", "")
  local suffix = text:match("([SsMmHhDdWw])$")
  if suffix then
    local base = tonumber(text:sub(1, -2))
    if not base then return nil end
    return base * durationSuffixes[suffix:lower()]
  end
  return tonumber(text)
end

local function clampDuration(value, fallback, min, max)
  value = config.parseDuration(value) or fallback
  value = math.floor(value)
  if value < min then value = min end
  if max and value > max then value = max end
  return value
end

function config.clampInterval(value, fallback)
  return clampDuration(value, fallback or config.defaults.interval, config.minInterval, config.maxInterval)
end

function config.clampPollInterval(value, fallback)
  return clampDuration(value, fallback or config.defaults.pollInterval, config.minInterval, config.maxPollInterval)
end

local function normalize(value)
  return configSchema.normalize(value, config, reconcileStates, reconcileReceipt,
    commissioningStates)
end

function config.normalize(value)
  return normalize(value)
end

function config.load()
  local called, snapshot, reason = pcall(transactionalStore.snapshot, config.path)
  if called and type(snapshot) == "table" and type(snapshot.value) == "table" then
    local out = normalize(snapshot.present == true and snapshot.value or config.defaults)
    loadedSnapshots[out] = snapshot
    return out
  end
  local detail = tostring(called and reason or snapshot or "unknown daemon config read failure"):sub(1, 160)
  local out = normalize(config.defaults)
  out.maintenanceBrake = true
  out.maintenanceBrakeReason = "daemon control config unreadable: " .. detail
  out.configReadFailed, out.configReadError = true, detail
  return out
end

function config.save(value)
  local snapshot = loadedSnapshots[value]
  if type(snapshot) ~= "table" then
    return false, "daemon config save requires a fresh loaded CAS snapshot"
  end
  local out = normalize(value)
  local saved, saveReason = transactionalStore.compareAndSwap(config.path, snapshot, out, {
    render = readable.render, retries = 0
  })
  if not saved then return false, saveReason end
  local nextSnapshot = transactionalStore.snapshot(config.path)
  if type(nextSnapshot) == "table" then loadedSnapshots[out] = nextSnapshot end
  return true, nil, out
end

function config.setEnabled(enabled)
  local out = config.load()
  out.enabled = enabled == true
  out.generation = out.generation + 1
  return config.save(out)
end

function config.enable(expectedGeneration)
  local out = config.load()
  if expectedGeneration ~= nil and (out.enabled == true
      or tonumber(out.generation) ~= tonumber(expectedGeneration)) then
    return false, "daemon ownership changed before conditional enable", out
  end
  out.enabled = true
  out.generation = out.generation + 1
  return config.save(out)
end

function config.setInterval(interval)
  local out = config.load()
  out.interval = interval
  return config.save(out)
end

function config.adjustInterval(delta)
  local out = config.load()
  out.interval = out.interval + (tonumber(delta) or 0)
  return config.save(out)
end

local function mutateCapture(method, ...)
  local out = config.load()
  if out.configReadFailed == true or out.readFailed == true then
    return false, out.configReadError or out.readError or out.lastError
  end
  local ok, reason = reconcileReceipt[method](out, ...)
  if not ok then return false, reason end
  return config.save(out)
end

function config.armIdentityCapture(untilAt, captureId, captureGeneration, captureNamespace)
  return mutateCapture("armCapturePulse", untilAt, captureId, captureGeneration, captureNamespace)
end

function config.clearIdentityCapture(expectedUntil, expectedCaptureId,
    expectedGeneration, expectedNamespace)
  return mutateCapture("clearCapturePulse", expectedUntil,
    expectedCaptureId, expectedGeneration, expectedNamespace)
end

function config.requestForce(now)
  local out = config.load()
  if out.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(out.maintenanceBrakeReason or "operator maintenance"), out
  end
  if not out.enabled then
    return false, "turn daemon on before requesting next request now", out
  end
  out.forcePlanningAt = optionalNumber(now) or 0
  out.forcePlanningSerial = out.forcePlanningSerial + 1
  return config.save(out)
end

function config.consumeForce(generation)
  local out = config.load()
  if not out.enabled or out.forcePlanningAt == nil
      or tonumber(out.generation) ~= tonumber(generation) then
    return false, nil, out
  end
  out.forcePlanningAt = nil
  local ok, err, saved = config.save(out)
  if not ok then return false, err, out end
  return true, nil, saved
end

function config.submissionAllowed(expectedGeneration, capability)
  local out = config.load()
  if out.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(out.maintenanceBrakeReason or "operator maintenance"), out
  end
  if expectedGeneration ~= nil and (out.enabled ~= true
      or tonumber(out.generation) ~= tonumber(expectedGeneration)) then
    return false, "daemon generation revoked before craft submit", out
  end
  if not commissioningAuthority.probeSubmissionAllowed(out, capability) then
    return false, commissioningAuthority.reason(out, "request submission")
      .. "; only its exact causal probe receipt may submit", out
  end
  return true, nil, out
end

local function samePreparation(left, right)
  left, right = reconcileReceipt.compactPreparation(left),
    reconcileReceipt.compactPreparation(right)
  if not left or not right then return left == nil and right == nil end
  return left.preparationDigest == right.preparationDigest
end

function config.stageIdentityPreparation(preparation, counts, now, reason, expected)
  local out = config.load()
  if commissioningAuthority.active(out) then
    return false, commissioningAuthority.reason(out, "identity reconciliation"), out
  end
  local state = tostring(out.identityReconcileState or "idle")
  if out.maintenanceBrake == true or state == "braking" or state == "draining"
      or state == "zero_proven" or state == "committing" or state == "failed_safe" then
    return false, "another maintenance transaction already owns the daemon", out
  end
  local compact = reconcileReceipt.sealPreparation(preparation)
  if not compact then return false, "valid bounded Fleet preparation receipt is required", out end
  if state == "preparing" then
    if not samePreparation(out.identityReconcilePreparation, expected) then
      return false, "Fleet preparation advanced concurrently; refresh its durable receipt", out
    end
  elseif expected ~= nil then
    return false, "Fleet preparation receipt is stale", out
  else
    out.identityReconcileSerial = (tonumber(out.identityReconcileSerial) or 0) + 1
    out.identityReconcileRequestId = "identity-reconcile:" .. tostring(out.identityReconcileSerial)
    out.identityReconcileRequestedAt = optionalNumber(now) or 0
    out.identityReconcilePriorEnabled = nil
  end
  out.identityReconcileState, out.identityReconcileOperation = "preparing", "reconcile"
  out.identityReconcileReason = optionalReason(reason)
    or "scanning one bounded evidence page for Fleet reconciliation"
  out.identityReconcileCounts, out.identityReconcilePreparation = compactCounts(counts), compact
  out.identityReconcileConfirmedAt, out.identityReconcileZeroProofAt = nil, nil
  out.identityReconcileCompletedAt, out.identityReconcileDaemonGeneration = nil, nil
  out.identityReconcileCursor = optionalText(compact.cursor, 64)
  out.identityReconcileNextCursor = optionalText(compact.cursor, 64)
  out.identityReconcileProcessed = clampNumber(compact.totalEvidence, 0, 0)
  out.identityReconcileDeferred, out.identityReconcileBatchCount = 0, 0
  out.identityReconcileSealDigest = optionalText(compact.sealDigest, 96)
  out.identityReconcileAddObserved = compact.addObserved
  out.identityReconcileConfigIndex, out.identityReconcileWorkflowId = nil, nil
  out.identityReconcileRecordId, out.identityReconcilePlanToken = nil, nil
  return config.save(out)
end

function config.stageIdentityReconcile(counts, now, reason, options)
  local out = config.load()
  options = type(options) == "table" and options or {}
  if not commissioningAuthority.reconcileAllowed(out, options.commissioningSerial,
      "repair_preview", options) then
    return false, commissioningAuthority.reason(out, "identity reconciliation"), out
  end
  local state = tostring(out.identityReconcileState or "idle")
  if out.maintenanceBrake == true or state == "braking" or state == "draining"
      or state == "zero_proven" or state == "committing" or state == "failed_safe" then
    return false, "identity reconciliation already owns the maintenance brake", out
  end
  local planToken = compactPlanToken(options.planToken)
  if not planToken then return false, "identity reconciliation preview plan token is required", out end
  if state ~= "preparing" then
    out.identityReconcileSerial = (tonumber(out.identityReconcileSerial) or 0) + 1
    out.identityReconcilePriorEnabled = nil
  end
  out.identityReconcileState = "previewed"
  out.identityReconcileOperation = "reconcile"
  out.identityReconcileRequestId = "identity-reconcile:" .. tostring(out.identityReconcileSerial)
  out.identityReconcileReason = optionalReason(reason)
  out.identityReconcileCounts = compactCounts(counts)
  out.identityReconcileRequestedAt = optionalNumber(now) or 0
  out.identityReconcileConfirmedAt = nil
  out.identityReconcileZeroProofAt = nil
  out.identityReconcileCompletedAt = nil
  out.identityReconcileDaemonGeneration = nil
  out.identityReconcileConfigIndex = optionalIndex(options.configIndex)
  out.identityReconcileWorkflowId = optionalText(options.workflowId, 32)
  out.identityReconcileRecordId = optionalText(options.recordId, 64)
  out.identityReconcileCursor = optionalText(planToken.cursor, 64)
  out.identityReconcileNextCursor = optionalText(planToken.nextCursor, 64)
  out.identityReconcileProcessed = 0
  out.identityReconcileDeferred = clampNumber(planToken.deferredCount, 0, 0)
  out.identityReconcileBatchCount = clampNumber(planToken.batchCount, 0, 0, 32)
  out.identityReconcileSealDigest = optionalText(planToken.sealDigest, 96)
  out.identityReconcileAddObserved = options.addObserved ~= false
  out.identityReconcilePlanToken = planToken
  out.identityReconcilePreparation = nil
  return config.save(out)
end

function config.continueIdentityReconcile(expectedSerial, continuation, counts, now)
  local out = config.load()
  continuation = type(continuation) == "table" and continuation or {}
  if out.identityReconcileState ~= "committing"
      or tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "identity reconciliation continuation receipt is stale", out
  end
  local token = compactPlanToken(continuation.planToken)
  if not token or token.scope ~= "fleet" then
    return false, "valid next Fleet page token is required", out
  end
  if optionalText(continuation.cursor, 64) ~= token.cursor
      or optionalText(continuation.nextCursor, 64) ~= token.nextCursor then
    return false, "Fleet continuation cursor does not match its plan token", out
  end
  local processed = clampNumber(out.identityReconcileProcessed, 0, 0)
    + clampNumber(out.identityReconcileBatchCount, 0, 0, 32)
  out.identityReconcileProcessed = processed
  out.identityReconcileCursor, out.identityReconcileNextCursor = token.cursor, token.nextCursor
  out.identityReconcileDeferred = clampNumber(token.deferredCount, 0, 0)
  out.identityReconcileBatchCount = clampNumber(token.batchCount, 0, 0, 32)
  out.identityReconcilePlanToken = token
  out.identityReconcileCounts = compactCounts(counts) or out.identityReconcileCounts
  out.identityReconcileReason = "Fleet page committed; continuing at durable cursor"
  out.identityReconcileCompletedAt = optionalNumber(now)
  return config.save(out)
end

function config.confirmIdentityReconcile(expectedSerial, now, commissioningSerial)
  local out = config.load()
  if not commissioningAuthority.ownerStateAllowed(out, commissioningSerial,
      { requested = true, repair_confirm = true, aborting = true }) then
    return false, commissioningAuthority.reason(out, "identity reconciliation"), out
  end
  if out.identityReconcileState ~= "previewed"
      or tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "identity reconciliation preview receipt is stale", out
  end
  local confirmedAt = optionalNumber(now) or 0
  local requestedAt = tonumber(out.identityReconcileRequestedAt)
  if not out.identityReconcilePlanToken or requestedAt == nil or confirmedAt < requestedAt
      or confirmedAt - requestedAt > config.previewTtl then
    return false, "identity reconciliation preview expired; preview again", out
  end
  out.maintenanceBrake = true
  out.maintenanceBrakeReason = "identity reconciliation"
  out.maintenanceBrakeSerial = (tonumber(out.maintenanceBrakeSerial) or 0) + 1
  out.identityReconcileState = "braking"
  out.identityReconcileReason = "waiting for daemon ownership drain"
  out.identityReconcileConfirmedAt = confirmedAt
  out.identityReconcilePriorEnabled = out.enabled == true
  return config.save(out)
end

local function selectedNoop(out)
  local token = type(out.identityReconcilePlanToken) == "table"
    and out.identityReconcilePlanToken or {}
  local counts = type(out.identityReconcileCounts) == "table"
    and out.identityReconcileCounts or {}
  if token.version ~= 2 or token.scope ~= "selected"
      or tonumber(counts.valid) == nil or tonumber(counts.valid) < 1
      or token.afterSnapshot == nil or token.afterSnapshot ~= token.rawSnapshot then
    return false
  end
  for _, key in ipairs({ "repairable", "repaired", "probeReady", "observed", "added",
      "blocked", "ambiguous", "conflicts" }) do
    if (tonumber(counts[key]) or 0) ~= 0 then return false end
  end
  return tonumber(out.identityReconcileConfigIndex) == tonumber(token.selectedConfigIndex)
    and out.identityReconcileWorkflowId == token.selectedWorkflowId
    and out.identityReconcileRecordId == token.selectedRecordId
end

-- Exact already-valid selected work is a durable no-op receipt. It never
-- engages the submit brake, starts a worker, changes policy, or waits for CPUs.
function config.completeIdentityReconcileNoop(expectedSerial, now)
  local out = config.load()
  if out.identityReconcileState ~= "previewed"
      or out.identityReconcileOperation ~= "reconcile"
      or tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "identity reconciliation no-op receipt is stale", out
  end
  if out.maintenanceBrake == true or not selectedNoop(out) then
    return false, "identity reconciliation preview has actionable consequences", out
  end
  out.identityReconcileState = "complete_safe"
  out.identityReconcileReason = "exact selected identity already valid; no maintenance drain required"
  out.identityReconcileCompletedAt = optionalNumber(now) or 0
  out.identityReconcilePriorEnabled = out.enabled == true
  out.identityReconcileDaemonGeneration = tonumber(out.generation)
  return config.save(out)
end

function config.advanceIdentityReconcile(expectedSerial, state, reason, counts, now)
  local out = config.load()
  state = tostring(state or "")
  local current = tostring(out.identityReconcileState or "idle")
  if tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "identity reconciliation receipt is stale", out
  end
  if not reconcileStates[state] or not (reconcileTransitions[current] and reconcileTransitions[current][state]) then
    return false, "invalid identity reconciliation transition " .. current .. " -> " .. state, out
  end
  out.identityReconcileState = state
  out.identityReconcileReason = optionalReason(reason)
  if counts ~= nil then out.identityReconcileCounts = compactCounts(counts) end
  if state == "zero_proven" then out.identityReconcileZeroProofAt = optionalNumber(now) or 0 end
  if state == "committing" then out.identityReconcileDaemonGeneration = tonumber(out.generation) end
  if state == "complete_safe" then
    if out.identityReconcileOperation == "reconcile" then
      out.identityReconcileProcessed = clampNumber(out.identityReconcileProcessed, 0, 0)
        + clampNumber(out.identityReconcileBatchCount, 0, 0, 32)
      out.identityReconcileDeferred = 0
      out.identityReconcileNextCursor = nil
    end
    out.identityReconcileCompletedAt = optionalNumber(now) or 0
    out.maintenanceBrake = false
    out.maintenanceBrakeReason = nil
    if out.identityReconcileOperation == "reconcile"
        and out.identityReconcilePriorEnabled == false then
      out.enabled = false
      out.forcePlanningAt = nil
      out.generation = (tonumber(out.generation) or 0) + 1
    end
  elseif state == "failed_safe" then
    out.maintenanceBrake = true
    out.maintenanceBrakeReason = "identity reconciliation failed safe"
  end
  return config.save(out)
end

function config.retryIdentityReconcile(expectedSerial, now, commissioningSerial)
  local out = config.load()
  if not commissioningAuthority.ownerStateAllowed(out, commissioningSerial,
      { requested = true, repair_wait = true, aborting = true }) then
    return false, commissioningAuthority.reason(out, "identity reconciliation"), out
  end
  if out.identityReconcileState ~= "failed_safe"
      or tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "failed-safe identity reconciliation receipt is stale", out
  end
  if out.identityReconcileOperation ~= "reconcile" then
    return false, "failed safe-stop cannot be retried as identity reconciliation", out
  end
  out.maintenanceBrake = true
  out.maintenanceBrakeReason = "identity reconciliation retry"
  out.maintenanceBrakeSerial = (tonumber(out.maintenanceBrakeSerial) or 0) + 1
  out.identityReconcileState = "braking"
  out.identityReconcileOperation = "reconcile"
  out.identityReconcileReason = "retrying policy quiescence and ownership drain"
  out.identityReconcileConfirmedAt = optionalNumber(now) or 0
  out.identityReconcileZeroProofAt = nil
  out.identityReconcileCompletedAt = nil
  out.identityReconcileDaemonGeneration = nil
  return config.save(out)
end

function config.requestSafeStop(now, fenceProof, commissioningSerial)
  local out = config.load()
  if not commissioningAuthority.ownerStateAllowed(out, commissioningSerial,
      { requested = true, stopping = true, aborting = true }) then
    return false, commissioningAuthority.reason(out, "Safe Stop"), out
  end
  local state = tostring(out.identityReconcileState or "idle")
  if out.identityReconcileOperation == "safe_stop" and out.maintenanceBrake == true
      and (state == "braking" or state == "draining" or state == "zero_proven") then
    return true, nil, out
  end
  if state == "braking" or state == "draining" or state == "zero_proven" or state == "committing" then
    return false, "another maintenance transaction already owns the daemon", out
  end
  if state == "failed_safe" and out.identityReconcileOperation == "reconcile"
      and fenceProof ~= tostring(out.identityReconcileSerial)
        .. ":" .. tostring(out.maintenanceBrakeSerial) then
    return false, "failed reconcile fence must settle before Safe Stop", out
  end
  out.identityReconcileSerial = (tonumber(out.identityReconcileSerial) or 0) + 1
  out.identityReconcileOperation = "safe_stop"
  out.identityReconcileState = "braking"
  out.identityReconcileRequestId = "safe-stop:" .. tostring(out.identityReconcileSerial)
  out.identityReconcileReason = "waiting for daemon ownership drain before stop"
  out.identityReconcileCounts = nil
  out.identityReconcileRequestedAt = optionalNumber(now) or 0
  out.identityReconcileConfirmedAt = optionalNumber(now) or 0
  out.identityReconcileZeroProofAt = nil
  out.identityReconcileCompletedAt = nil
  out.identityReconcileDaemonGeneration = nil
  out.identityReconcileConfigIndex = nil
  out.identityReconcileWorkflowId = nil
  out.identityReconcileRecordId = nil
  out.identityReconcileCursor, out.identityReconcileNextCursor = nil, nil
  out.identityReconcileProcessed, out.identityReconcileDeferred = 0, 0
  out.identityReconcileBatchCount, out.identityReconcileSealDigest = 0, nil
  out.identityReconcileAddObserved = false
  out.identityReconcilePriorEnabled = nil
  out.identityReconcilePlanToken = nil
  out.identityReconcilePreparation = nil
  out.maintenanceBrake = true
  out.maintenanceBrakeReason = "safe daemon stop"
  out.maintenanceBrakeSerial = (tonumber(out.maintenanceBrakeSerial) or 0) + 1
  return config.save(out)
end

function config.completeSafeStop(expectedSerial, now)
  local out = config.load()
  if out.identityReconcileOperation ~= "safe_stop" or out.identityReconcileState ~= "zero_proven"
      or tonumber(out.identityReconcileSerial) ~= tonumber(expectedSerial) then
    return false, "safe-stop zero-proof receipt is stale", out
  end
  out.identityReconcileState = "complete_safe"
  out.identityReconcileReason = "daemon stopped after durable Maintainer ownership zero proof"
  out.identityReconcileCompletedAt = optionalNumber(now) or 0
  out.identityReconcileDaemonGeneration = tonumber(out.generation)
  out.maintenanceBrake = false
  out.maintenanceBrakeReason = nil
  out.enabled = false
  out.forcePlanningAt = nil
  out.generation = (tonumber(out.generation) or 0) + 1
  return config.save(out)
end

return config
-- Bounded scalar normalization for the durable Maintainer daemon contract.
-- Kept separate so the mutating config surface remains below OpenOS's 24 KiB
-- parser ceiling without minifying lifecycle logic.
local schema = {}

function schema.clampNumber(value, fallback, min, max)
  value = math.floor(tonumber(value) or fallback)
  if value < min then value = min end
  if max and value > max then value = max end
  return value
end

function schema.optionalNumber(value)
  if value == nil then return nil end
  value = tonumber(value)
  if not value then return nil end
  if value < 0 then value = 0 end
  return value
end

function schema.optionalIndex(value)
  value = tonumber(value)
  if not value or value < 1 or value ~= value or value == math.huge then return nil end
  return math.floor(value)
end

function schema.optionalText(value, maxLength)
  if value == nil or value == false then return nil end
  local text = tostring(value)
  if text == "" then return nil end
  return text:sub(1, maxLength or 192)
end

function schema.optionalReason(value, maxLength)
  if type(value) == "table" then
    value = value.reason or value.error or value.message or value.code
  end
  local kind = type(value)
  if kind ~= "string" and kind ~= "number" and kind ~= "boolean" then return nil end
  return schema.optionalText(value, maxLength)
end

function schema.normalize(value, config, reconcileStates, receipt, commissioningStates)
  value = type(value) == "table" and value or {}
  local clampNumber, optionalNumber = schema.clampNumber, schema.optionalNumber
  local optionalIndex, optionalText = schema.optionalIndex, schema.optionalText
  local priorEnabled
  if type(value.identityReconcilePriorEnabled) == "boolean" then
    priorEnabled = value.identityReconcilePriorEnabled
  end
  local reconcileState = tostring(value.identityReconcileState or config.defaults.identityReconcileState)
  if not reconcileStates[reconcileState] then reconcileState = config.defaults.identityReconcileState end
  local preparation = receipt.compactPreparation(value.identityReconcilePreparation)
  local preparationDamaged = reconcileState == "preparing" and preparation == nil
  if preparationDamaged then reconcileState = "idle" end
  local commissioningState = tostring(value.commissioningState
    or config.defaults.commissioningState or "idle")
  if not (commissioningStates and commissioningStates[commissioningState]) then
    commissioningState = config.defaults.commissioningState or "idle"
  end
  local priorDaemon, priorGlobalAuto
  if type(value.commissioningPriorDaemonEnabled) == "boolean" then
    priorDaemon = value.commissioningPriorDaemonEnabled
  end
  if type(value.commissioningPriorGlobalAutoEnabled) == "boolean" then
    priorGlobalAuto = value.commissioningPriorGlobalAutoEnabled
  end
  local commissioningWorkflowSignature = optionalText(
    value.commissioningWorkflowSignature, 96)
  local commissioningWorkflowCount = clampNumber(
    value.commissioningWorkflowCount, 0, 0, 512)
  local quarantinedRows = optionalText(value.commissioningQuarantinedRows, 512)
  if quarantinedRows and (not quarantinedRows:match("^[01]+$")
      or #quarantinedRows ~= commissioningWorkflowCount
      or not commissioningWorkflowSignature) then quarantinedRows = nil end
  local quarantineReason = optionalText(value.commissioningQuarantineReason, 64)
  if quarantineReason and not quarantineReason:match("^[a-z0-9_%-]+$") then
    quarantineReason = nil
  end
  local degradedCount = 0
  if quarantinedRows then
    local _, count = quarantinedRows:gsub("1", "")
    degradedCount = count
  end
  local out = {
    enabled = value.enabled == true,
    interval = config.clampInterval(value.interval, config.defaults.interval),
    pollInterval = config.clampPollInterval(value.pollInterval, config.defaults.pollInterval),
    generation = clampNumber(value.generation, config.defaults.generation, 0),
    forcePlanningAt = optionalNumber(value.forcePlanningAt),
    forcePlanningSerial = clampNumber(value.forcePlanningSerial, config.defaults.forcePlanningSerial, 0),
    identityCaptureUntil = optionalNumber(value.identityCaptureUntil) or 0,
    identityCaptureId = optionalText(value.identityCaptureId, 96),
    identityCaptureGeneration = clampNumber(value.identityCaptureGeneration,
      config.defaults.identityCaptureGeneration, 0),
    identityCaptureNamespace = optionalText(value.identityCaptureNamespace, 96),
    maintenanceBrake = value.maintenanceBrake == true,
    maintenanceBrakeReason = optionalText(value.maintenanceBrakeReason),
    maintenanceBrakeSerial = clampNumber(value.maintenanceBrakeSerial,
      config.defaults.maintenanceBrakeSerial, 0),
    identityReconcileSerial = clampNumber(value.identityReconcileSerial,
      config.defaults.identityReconcileSerial, 0),
    identityReconcileState = reconcileState,
    identityReconcileOperation = value.identityReconcileOperation == "safe_stop" and "safe_stop" or "reconcile",
    identityReconcileReason = preparationDamaged and "discarded malformed Fleet preparation receipt"
      or schema.optionalReason(value.identityReconcileReason),
    identityReconcileRequestId = optionalText(value.identityReconcileRequestId, 96),
    identityReconcileCounts = receipt.compactCounts(value.identityReconcileCounts),
    identityReconcileRequestedAt = optionalNumber(value.identityReconcileRequestedAt),
    identityReconcileConfirmedAt = optionalNumber(value.identityReconcileConfirmedAt),
    identityReconcileZeroProofAt = optionalNumber(value.identityReconcileZeroProofAt),
    identityReconcileCompletedAt = optionalNumber(value.identityReconcileCompletedAt),
    identityReconcileDaemonGeneration = optionalNumber(value.identityReconcileDaemonGeneration),
    identityReconcileConfigIndex = optionalIndex(value.identityReconcileConfigIndex),
    identityReconcileWorkflowId = optionalText(value.identityReconcileWorkflowId, 32),
    identityReconcileRecordId = optionalText(value.identityReconcileRecordId, 64),
    identityReconcileCursor = optionalText(value.identityReconcileCursor, 64),
    identityReconcileNextCursor = optionalText(value.identityReconcileNextCursor, 64),
    identityReconcileProcessed = clampNumber(value.identityReconcileProcessed, 0, 0),
    identityReconcileDeferred = clampNumber(value.identityReconcileDeferred, 0, 0),
    identityReconcileBatchCount = clampNumber(value.identityReconcileBatchCount, 0, 0, 32),
    identityReconcileSealDigest = optionalText(value.identityReconcileSealDigest, 96),
    identityReconcileAddObserved = value.identityReconcileAddObserved ~= false,
    identityReconcilePriorEnabled = priorEnabled,
    identityReconcilePlanToken = receipt.compactPlanToken(value.identityReconcilePlanToken),
    identityReconcilePreparation = reconcileState == "preparing" and preparation or nil,
    commissioningState = commissioningState,
    commissioningSerial = clampNumber(value.commissioningSerial,
      config.defaults.commissioningSerial or 0, 0),
    commissioningReason = schema.optionalReason(value.commissioningReason),
    commissioningSource = optionalText(value.commissioningSource, 64),
    commissioningRequestedAt = optionalNumber(value.commissioningRequestedAt),
    commissioningUpdatedAt = optionalNumber(value.commissioningUpdatedAt),
    commissioningAttempt = clampNumber(value.commissioningAttempt, 0, 0, 64),
    commissioningAbortReason = schema.optionalReason(value.commissioningAbortReason),
    commissioningPriorDaemonEnabled = priorDaemon,
    commissioningPriorGlobalAutoEnabled = priorGlobalAuto,
    commissioningArmedBits = optionalText(value.commissioningArmedBits, 128),
    commissioningWorkflowSignature = commissioningWorkflowSignature,
    commissioningWorkflowCount = commissioningWorkflowCount,
    commissioningIntentBasis = optionalText(value.commissioningIntentBasis, 48),
    commissioningExpectedDaemonGeneration = optionalNumber(
      value.commissioningExpectedDaemonGeneration),
    commissioningEvidenceCursor = optionalText(value.commissioningEvidenceCursor, 64),
    commissioningEvidenceGeneration = optionalNumber(value.commissioningEvidenceGeneration),
    commissioningCandidateIndex = clampNumber(value.commissioningCandidateIndex, 1, 1, 1024),
    commissioningProbeCount = clampNumber(value.commissioningProbeCount, 0, 0, 4096),
    commissioningPageCount = clampNumber(value.commissioningPageCount, 0, 0, 4096),
    commissioningCanaryFluid = optionalText(value.commissioningCanaryFluid, 192),
    commissioningTopologyRevision = optionalText(value.commissioningTopologyRevision, 64),
    commissioningCanaryCount = optionalNumber(value.commissioningCanaryCount),
    commissioningCanaryMethod = optionalText(value.commissioningCanaryMethod, 64),
    commissioningCanaryGrid = optionalText(value.commissioningCanaryGrid, 96),
    commissioningCanaryObservedAt = optionalNumber(value.commissioningCanaryObservedAt),
    commissioningRepairIndex = optionalIndex(value.commissioningRepairIndex),
    commissioningRepairWorkflowId = optionalText(value.commissioningRepairWorkflowId, 32),
    commissioningRepairRecordId = optionalText(value.commissioningRepairRecordId, 64),
    commissioningRepairEpoch = clampNumber(value.commissioningRepairEpoch, 0, 0),
    commissioningRepairScopeToken = optionalText(
      value.commissioningRepairScopeToken, 96),
    commissioningQuarantinedRows = quarantinedRows,
    commissioningQuarantineReason = quarantineReason,
    commissioningQuarantineCaptureId = optionalText(
      value.commissioningQuarantineCaptureId, 96),
    commissioningQuarantineWorkflowId = optionalText(
      value.commissioningQuarantineWorkflowId, 32),
    commissioningQuarantineScopeToken = optionalText(
      value.commissioningQuarantineScopeToken, 96),
    commissioningQuarantineAt = optionalNumber(value.commissioningQuarantineAt),
    commissioningDegradedCount = degradedCount,
    commissioningBudgetResetCaptureId = optionalText(
      value.commissioningBudgetResetCaptureId, 96),
    commissioningBudgetResetScopeToken = optionalText(
      value.commissioningBudgetResetScopeToken, 96),
    commissioningReconcileSerial = optionalNumber(value.commissioningReconcileSerial),
    commissioningDeadlineAt = optionalNumber(value.commissioningDeadlineAt),
    commissioningDeadlineState = optionalText(value.commissioningDeadlineState, 32),
    commissioningDeadlineRebased = value.commissioningDeadlineRebased == true,
    commissioningHardDeadlineAt = optionalNumber(value.commissioningHardDeadlineAt),
    commissioningHardDeadlineRebased = value.commissioningHardDeadlineRebased == true,
    commissioningBootId = optionalText(value.commissioningBootId, 96)
  }
  if reconcileState == "braking" or reconcileState == "draining"
      or reconcileState == "zero_proven" or reconcileState == "committing"
      or reconcileState == "failed_safe" then
    out.maintenanceBrake = true
    out.maintenanceBrakeReason = out.maintenanceBrakeReason or "identity reconciliation"
  end
  return out
end

return schema
-- Durable commissioning receipt mutations. This stays separate from the
-- daemon config loader so every OpenOS source file remains below 24 KiB.
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")

local commissioningConfig = {}
local states = {
  idle = true, requested = true, stopping = true, configuring_craft = true,
  planning_fluid = true, probing_fluid = true, repair_probe = true,
  quarantining_repair = true,
  repair_preview = true, repair_confirm = true, repair_wait = true,
  committing_fluid = true, aborting = true,
  restoring_policy = true, restoring_daemon = true,
  complete = true, blocked = true
}
local active = {
  requested = true, stopping = true, configuring_craft = true,
  planning_fluid = true, probing_fluid = true, repair_probe = true,
  quarantining_repair = true,
  repair_preview = true, repair_confirm = true, repair_wait = true,
  committing_fluid = true, aborting = true,
  restoring_policy = true, restoring_daemon = true
}
local deadlineSeconds = {
  requested = 21600, stopping = 21600, configuring_craft = 600,
  planning_fluid = 21600, probing_fluid = 1800, repair_probe = 600,
  repair_preview = 600, repair_confirm = 600, repair_wait = 21600,
  committing_fluid = 1800
}
local HARD_DEADLINE_SECONDS = 600
local function bootId()
  if type(computer.tmpAddress) == "function" then
    local ok, value = pcall(computer.tmpAddress)
    if ok and type(value) == "string" and value ~= "" then return value end
  end
  return "openos-boot-unknown"
end
local currentBootId = bootId()
local transitions = {
  requested = { requested = true, stopping = true, aborting = true, restoring_policy = true,
    complete = true, blocked = true },
  stopping = { stopping = true, configuring_craft = true, aborting = true, blocked = true },
  configuring_craft = { planning_fluid = true, aborting = true, blocked = true },
  planning_fluid = { planning_fluid = true, probing_fluid = true,
    repair_probe = true, restoring_policy = true, aborting = true, blocked = true },
  probing_fluid = { probing_fluid = true, planning_fluid = true,
    committing_fluid = true, aborting = true, blocked = true },
  repair_probe = { repair_probe = true, repair_preview = true,
    quarantining_repair = true, aborting = true, blocked = true },
  quarantining_repair = { quarantining_repair = true,
    planning_fluid = true, aborting = true, blocked = true },
  repair_preview = { repair_preview = true, repair_confirm = true,
    planning_fluid = true, aborting = true, blocked = true },
  repair_confirm = { repair_wait = true, planning_fluid = true, aborting = true, blocked = true },
  repair_wait = { repair_wait = true, planning_fluid = true, aborting = true, blocked = true },
  committing_fluid = { restoring_policy = true, aborting = true, blocked = true },
  aborting = { aborting = true, restoring_policy = true, blocked = true },
  restoring_policy = { restoring_daemon = true, blocked = true },
  restoring_daemon = { restoring_daemon = true, complete = true, blocked = true }
}
local patchFields = {
  commissioningReason = true, commissioningAttempt = true,
  commissioningAbortReason = true,
  commissioningExpectedDaemonGeneration = true,
  commissioningEvidenceCursor = true, commissioningEvidenceGeneration = true,
  commissioningCandidateIndex = true, commissioningProbeCount = true,
  commissioningPageCount = true, commissioningCanaryFluid = true,
  commissioningTopologyRevision = true, commissioningCanaryCount = true,
  commissioningCanaryMethod = true, commissioningCanaryGrid = true,
  commissioningCanaryObservedAt = true, commissioningRepairIndex = true,
  commissioningRepairWorkflowId = true, commissioningRepairRecordId = true,
  commissioningRepairEpoch = true, commissioningRepairScopeToken = true,
  commissioningQuarantinedRows = true, commissioningQuarantineReason = true,
  commissioningQuarantineCaptureId = true,
  commissioningQuarantineWorkflowId = true, commissioningQuarantineScopeToken = true,
  commissioningQuarantineAt = true, commissioningDegradedCount = true,
  commissioningBudgetResetCaptureId = true,
  commissioningBudgetResetScopeToken = true,
  commissioningReconcileSerial = true, commissioningDeadlineAt = true,
  commissioningDeadlineState = true, commissioningDeadlineRebased = true,
  commissioningHardDeadlineAt = true, commissioningHardDeadlineRebased = true,
  commissioningBootId = true
}

local function stamp(value)
  value = tonumber(value)
  return value and value == value and value >= 0 and value < math.huge and value or 0
end

local function text(value, limit)
  if value == nil or value == false then return nil end
  value = tostring(value)
  return value ~= "" and value:sub(1, limit or 192) or nil
end

local function setDeadline(out, state, now)
  local seconds = deadlineSeconds[state]
  out.commissioningDeadlineAt = seconds and (stamp(now) + seconds) or nil
  out.commissioningDeadlineState = seconds and state or nil
  out.commissioningDeadlineRebased = false
end

function commissioningConfig.request(intent, now, source, force)
  intent = type(intent) == "table" and intent or {}
  local out = daemonConfig.load()
  local state = tostring(out.commissioningState or "idle")
  if active[state] then return true, nil, out end
  if state == "complete" and force ~= true then return true, nil, out end
  if type(intent.priorDaemonEnabled) ~= "boolean"
      or type(intent.priorGlobalAutoEnabled) ~= "boolean"
      or type(intent.armedBits) ~= "string"
      or not intent.armedBits:match("^[0-9a-f]*$") or #intent.armedBits > 128
      or type(intent.workflowSignature) ~= "string" or intent.workflowSignature == ""
      or #intent.workflowSignature > 96 or tonumber(intent.workflowCount) == nil
      or tonumber(intent.workflowCount) < 0 or tonumber(intent.workflowCount) > 512
      or tonumber(intent.workflowCount) ~= math.floor(tonumber(intent.workflowCount))
      or #intent.armedBits ~= math.ceil(tonumber(intent.workflowCount) / 4) then
    return false, "valid bounded commissioning intent is required", out
  end
  out.commissioningSerial = (tonumber(out.commissioningSerial) or 0) + 1
  out.commissioningState = "requested"
  out.commissioningReason = "automatic GTNH 2.8.4 commissioning requested"
  out.commissioningSource = text(source, 64) or "automatic"
  out.commissioningRequestedAt = stamp(now)
  out.commissioningUpdatedAt = out.commissioningRequestedAt
  out.commissioningAttempt = 0
  out.commissioningAbortReason = nil
  out.commissioningPriorDaemonEnabled = intent.priorDaemonEnabled
  out.commissioningPriorGlobalAutoEnabled = intent.priorGlobalAutoEnabled
  out.commissioningArmedBits = intent.armedBits
  out.commissioningWorkflowSignature = intent.workflowSignature
  out.commissioningWorkflowCount = math.floor(tonumber(intent.workflowCount))
  out.commissioningIntentBasis = text(intent.intentBasis, 48) or "live_policy"
  out.commissioningExpectedDaemonGeneration = tonumber(intent.daemonGeneration)
  out.commissioningEvidenceCursor, out.commissioningEvidenceGeneration = nil, nil
  out.commissioningCandidateIndex = 1
  out.commissioningProbeCount, out.commissioningPageCount = 0, 0
  out.commissioningCanaryFluid, out.commissioningTopologyRevision = nil, nil
  out.commissioningCanaryCount, out.commissioningCanaryMethod = nil, nil
  out.commissioningCanaryGrid, out.commissioningCanaryObservedAt = nil, nil
  out.commissioningRepairIndex, out.commissioningRepairWorkflowId = nil, nil
  out.commissioningRepairRecordId, out.commissioningReconcileSerial = nil, nil
  out.commissioningRepairEpoch, out.commissioningRepairScopeToken = 0, nil
  out.commissioningQuarantinedRows, out.commissioningQuarantineReason = nil, nil
  out.commissioningQuarantineCaptureId, out.commissioningQuarantineWorkflowId = nil, nil
  out.commissioningQuarantineScopeToken = nil
  out.commissioningQuarantineAt, out.commissioningDegradedCount = nil, 0
  out.commissioningBudgetResetCaptureId = nil
  out.commissioningBudgetResetScopeToken = nil
  setDeadline(out, "requested", out.commissioningRequestedAt)
  out.commissioningHardDeadlineAt = out.commissioningRequestedAt + HARD_DEADLINE_SECONDS
  out.commissioningHardDeadlineRebased = false
  out.commissioningBootId = currentBootId
  return daemonConfig.save(out)
end

function commissioningConfig.advance(expectedSerial, expectedState, nextState, patch, now)
  local out = daemonConfig.load()
  local current = tostring(out.commissioningState or "idle")
  nextState = tostring(nextState or "")
  if tonumber(out.commissioningSerial) ~= tonumber(expectedSerial)
      or current ~= tostring(expectedState or "") then
    return false, "commissioning receipt advanced concurrently", out
  end
  if not states[nextState] or not (transitions[current] and transitions[current][nextState]) then
    return false, "invalid commissioning transition " .. current .. " -> " .. nextState, out
  end
  patch = type(patch) == "table" and patch or {}
  for field, value in pairs(patch) do
    if not patchFields[field] then
      return false, "unsupported commissioning receipt field: " .. tostring(field), out
    end
    out[field] = value
  end
  out.commissioningState, out.commissioningUpdatedAt = nextState, stamp(now)
  if nextState ~= current or out.commissioningDeadlineState ~= nextState
      or tonumber(out.commissioningDeadlineAt) == nil then
    setDeadline(out, nextState, out.commissioningUpdatedAt)
  end
  if nextState == "complete" then
    out.commissioningReason = text(patch.commissioningReason)
      or "automatic GTNH 2.8.4 commissioning complete"
  elseif nextState == "blocked" then
    out.commissioningReason = text(patch.commissioningReason)
      or "automatic commissioning blocked"
  end
  if nextState == "complete" or nextState == "blocked" then
    out.commissioningHardDeadlineAt = nil
    out.commissioningHardDeadlineRebased = false
  end
  return daemonConfig.save(out)
end

-- Commit one exact row-local quarantine and resume forward commissioning in
-- one daemon-config CAS. The workflow snapshot is verified by the caller;
-- this receipt rechecks its stable signature, count, row, workflow, and
-- capture and repair-scope epoch before granting a fresh bounded epoch.
-- Replaying one selection cannot slide the deadline or increment its count.
function commissioningConfig.continueAfterQuarantine(expectedSerial, scope, now)
  scope = type(scope) == "table" and scope or {}
  local out = daemonConfig.load()
  local count, index = tonumber(scope.workflowCount), tonumber(scope.configIndex)
  local captureId, workflowId = text(scope.captureId, 96), text(scope.workflowId, 32)
  local scopeToken = text(scope.scopeToken, 96)
  local reasonCode = text(scope.reasonCode, 64) or "causal_identity_unverified"
  if tonumber(out.commissioningSerial) ~= tonumber(expectedSerial)
      or out.commissioningState ~= "quarantining_repair" then
    return false, "commissioning quarantine receipt advanced concurrently", out
  end
  if type(scope.workflowSignature) ~= "string"
      or scope.workflowSignature ~= out.commissioningWorkflowSignature
      or count ~= tonumber(out.commissioningWorkflowCount)
      or not count or count < 1 or count > 512 or count ~= math.floor(count)
      or not index or index < 1 or index > count or index ~= math.floor(index)
      or index ~= tonumber(out.commissioningRepairIndex)
      or not captureId or captureId ~= out.commissioningQuarantineCaptureId
      or not workflowId or workflowId ~= out.commissioningRepairWorkflowId
      or workflowId ~= out.commissioningQuarantineWorkflowId
      or not scopeToken or scopeToken ~= out.commissioningRepairScopeToken
      or scopeToken ~= out.commissioningQuarantineScopeToken
      or tonumber(scope.repairEpoch) ~= tonumber(out.commissioningRepairEpoch)
      or not reasonCode:match("^[a-z0-9_%-]+$") then
    return false, "commissioning quarantine authority is stale or malformed", out
  end
  local bits = out.commissioningQuarantinedRows
  if bits == nil then bits = string.rep("0", count) end
  if type(bits) ~= "string" or #bits ~= count or not bits:match("^[01]+$") then
    return false, "commissioning quarantine bitmap is malformed", out
  end
  local added = bits:sub(index, index) ~= "1"
  if added then bits = bits:sub(1, index - 1) .. "1" .. bits:sub(index + 1) end
  local current = stamp(now)
  out.commissioningQuarantinedRows = bits
  out.commissioningQuarantineReason = reasonCode
  out.commissioningQuarantineAt = current
  if added then
    out.commissioningDegradedCount = math.min(count,
      (tonumber(out.commissioningDegradedCount) or 0) + 1)
  end
  out.commissioningState, out.commissioningUpdatedAt = "planning_fluid", current
  out.commissioningReason = "uncertain wrapper quarantined; commissioning remaining fluids"
  out.commissioningRepairIndex, out.commissioningRepairWorkflowId = nil, nil
  out.commissioningRepairRecordId, out.commissioningReconcileSerial = nil, nil
  out.commissioningEvidenceCursor, out.commissioningEvidenceGeneration = nil, nil
  out.commissioningCandidateIndex, out.commissioningPageCount = 1, 0
  out.commissioningCanaryFluid, out.commissioningTopologyRevision = nil, nil
  out.commissioningCanaryCount, out.commissioningCanaryMethod = nil, nil
  out.commissioningCanaryGrid, out.commissioningCanaryObservedAt = nil, nil
  setDeadline(out, "planning_fluid", current)
  if added and out.commissioningBudgetResetScopeToken ~= scopeToken then
    out.commissioningBudgetResetCaptureId = captureId
    out.commissioningBudgetResetScopeToken = scopeToken
    out.commissioningHardDeadlineAt = current + HARD_DEADLINE_SECONDS
    out.commissioningHardDeadlineRebased = false
    out.commissioningBootId = currentBootId
  end
  return daemonConfig.save(out)
end

-- Forward commissioning is finite. Cleanup has no deadline: once rollback
-- owns the receipt it keeps restoring authority instead of abandoning a brake.
function commissioningConfig.checkDeadline(value, now)
  local out = type(value) == "table" and value or daemonConfig.load()
  local state = tostring(out.commissioningState or "idle")
  local seconds = deadlineSeconds[state]
  if not seconds then return true, nil, out end
  local current = stamp(now)
  local needsSave = false
  if tonumber(out.commissioningHardDeadlineAt) == nil then
    out.commissioningHardDeadlineAt = current + HARD_DEADLINE_SECONDS
    out.commissioningHardDeadlineRebased = false
    needsSave = true
  end
  if out.commissioningBootId == nil then
    out.commissioningBootId = currentBootId
    needsSave = true
  elseif out.commissioningBootId ~= currentBootId then
    if out.commissioningHardDeadlineRebased == true then
      return false, "automatic " .. state
        .. " deadline exhausted after a second OpenOS boot", out
    end
    out.commissioningBootId = currentBootId
    out.commissioningHardDeadlineAt = current + HARD_DEADLINE_SECONDS
    out.commissioningHardDeadlineRebased = true
    out.commissioningDeadlineAt = current + seconds
    out.commissioningDeadlineRebased = true
    out.commissioningUpdatedAt = current
    return daemonConfig.save(out)
  end
  if out.commissioningDeadlineState ~= state
      or tonumber(out.commissioningDeadlineAt) == nil then
    setDeadline(out, state, current)
    needsSave = true
  end
  local updated = tonumber(out.commissioningUpdatedAt)
  if updated and current < updated then
    if out.commissioningHardDeadlineRebased == true then
      return false, "automatic " .. state
        .. " deadline exhausted after a second uptime reset", out
    end
    out.commissioningHardDeadlineAt = current + HARD_DEADLINE_SECONDS
    out.commissioningHardDeadlineRebased = true
    out.commissioningDeadlineAt = current + seconds
    out.commissioningDeadlineRebased = true
    out.commissioningUpdatedAt = current
    return daemonConfig.save(out)
  end
  if current >= tonumber(out.commissioningHardDeadlineAt) then
    return false, "automatic commissioning hard deadline exhausted after "
      .. tostring(HARD_DEADLINE_SECONDS) .. " seconds", out
  end
  if current >= tonumber(out.commissioningDeadlineAt) then
    return false, "automatic " .. state .. " deadline exhausted after "
      .. tostring(seconds) .. " seconds", out
  end
  if needsSave then return daemonConfig.save(out) end
  return true, nil, out
end

function commissioningConfig.block(expectedSerial, expectedState, reason, now)
  local out = daemonConfig.load()
  if out.commissioningState == "blocked"
      and tonumber(out.commissioningSerial) == tonumber(expectedSerial) then
    return true, nil, out
  end
  local current = tostring(out.commissioningState or "idle")
  if active[current] and current ~= "aborting" and current ~= "restoring_policy"
      and current ~= "restoring_daemon" then
    return commissioningConfig.advance(expectedSerial, expectedState, "aborting", {
      commissioningReason = "terminal commissioning fault; restoring prior operator intent",
      commissioningAbortReason = text(reason) or "automatic commissioning failed"
    }, now)
  end
  return commissioningConfig.advance(expectedSerial, expectedState, "blocked", {
    commissioningReason = text(reason) or "automatic commissioning blocked"
  }, now)
end

-- Persist before invoking reconciliation so a crash consumes an attempt. Once
-- eight attempts are spent, advance to automatic Safe Stop cleanup instead of
-- leaving a failed reconciliation brake as the terminal state.
function commissioningConfig.claimFailedRetry(expectedSerial, expectedState, reason, now)
  local out = daemonConfig.load()
  if tonumber(out.commissioningSerial) ~= tonumber(expectedSerial)
      or out.commissioningState ~= expectedState then
    return false, "commissioning retry receipt advanced concurrently", out
  end
  local attempts = tonumber(out.commissioningAttempt) or 0
  if attempts >= 8 then
    local retained = text(out.commissioningAbortReason) or text(reason)
    local ok, saveReason, saved = commissioningConfig.advance(expectedSerial,
      expectedState, "aborting", {
        commissioningReason = "retry cap reached; stopping ownership before restoring intent",
        commissioningAbortReason = retained or "automatic repair failed eight times"
      }, now)
    return ok, saveReason, saved, true
  end
  return commissioningConfig.advance(expectedSerial, expectedState, expectedState, {
    commissioningReason = "retrying exact repair from its durable failed-safe receipt",
    commissioningAttempt = attempts + 1,
    commissioningAbortReason = text(out.commissioningAbortReason)
      or text(reason) or "automatic repair failed"
  }, now)
end

function commissioningConfig.active(value)
  value = type(value) == "table" and value or daemonConfig.load()
  return active[tostring(value.commissioningState or "idle")] == true
end

function commissioningConfig.bootId() return currentBootId end

function commissioningConfig.suppressBootRetry(value, source)
  value = type(value) == "table" and value or daemonConfig.load()
  return source == "release_boot" and value.commissioningState == "blocked"
    and tostring(value.commissioningAbortReason or ""):find(
      "automatic causal recovery exhausted:", 1, true) == 1
end

return commissioningConfig
-- Bounded degraded completion for wrappers whose physical request can no
-- longer be proven. Only those exact rows are excluded; no recraft occurs.
local binding = require("oc.ae2.request_binding")
local codec = require("oc.ae2.identity_evidence_v2_codec")
local quarantine = require("oc.ae2.fluid_stock_quarantine")

local degraded = {}

function degraded.planOptions(cfg, config)
  cfg = type(cfg) == "table" and cfg or {}
  local view, reason = quarantine.view(config, cfg)
  if reason then return nil, reason end
  return { cursor = cfg.commissioningEvidenceCursor,
    expectedGeneration = cfg.commissioningEvidenceGeneration,
    quarantinedRows = view and view.bits or nil,
    quarantineWorkflowSignature = view and view.workflowSignature or nil,
    quarantineWorkflowCount = view and view.workflowCount or nil,
    quarantineReason = view and view.reason or nil,
    degradedCount = view and view.count or nil }
end

function degraded.repairIssue(reviewed, cfg, auto)
  -- targetSet(config, cfg) has already converted only an authenticated bit into
  -- a non-repairable issue. Never feed the raw receipt bitmap to a selector.
  if type(reviewed) ~= "table" then return nil end
  return reviewed.primaryIssue
end

local function encoded(value)
  value = tostring(value == nil and "" or value)
  return tostring(#value) .. ":" .. value
end

local function identityDigest(row)
  local craft = type(row.craftBinding) == "table" and row.craftBinding or {}
  local parts = { encoded(row.workflowId), encoded(row.label), encoded(row.rawLabel),
    encoded(row.name), encoded(row.damage), encoded(row.kind),
    encoded(row.isFluid == true), encoded(row.hasTag == true), encoded(row.mode),
    encoded(craft.mode), encoded(craft.name), encoded(craft.damage),
    encoded(craft.label), encoded(craft.rawLabel) }
  return codec.digestText(table.concat(parts, "|"))
end

function degraded.selectionScope(cfg, config, issue, epoch)
  cfg, issue = type(cfg) == "table" and cfg or {},
    type(issue) == "table" and issue or {}
  local signature, reason, count = quarantine.workflowSignature(config)
  if not signature then return nil, reason end
  local index = tonumber(issue.configIndex or cfg.commissioningRepairIndex)
  local workflowId = issue.workflowId or cfg.commissioningRepairWorkflowId
  local rows = type(config) == "table" and config.workflows or {}
  local row = index and rows[index] or nil
  epoch = tonumber(epoch or cfg.commissioningRepairEpoch)
  if signature ~= cfg.commissioningWorkflowSignature
      or count ~= tonumber(cfg.commissioningWorkflowCount)
      or not index or index ~= math.floor(index) or index < 1 or index > count
      or not epoch or epoch ~= math.floor(epoch) or epoch < 1
      or type(row) ~= "table" or row.workflowId ~= workflowId
      or row.mode ~= "auto" or not binding.isTaggedLegacyFluidProxy(row) then
    return nil, "repair selection no longer matches its exact wrapper identity"
  end
  local digest = identityDigest(row)
  local token = "repair-scope-" .. codec.digestText(table.concat({
    encoded(cfg.commissioningSerial), encoded(epoch), encoded(signature),
    encoded(count), encoded(index), encoded(workflowId), encoded(digest) }, "|"))
  return { token = token, epoch = epoch, identityDigest = digest,
    workflowSignature = signature, workflowCount = count,
    configIndex = index, workflowId = workflowId }
end

function degraded.nextSelectionScope(cfg, config, issue)
  return degraded.selectionScope(cfg, config, issue,
    (tonumber(cfg and cfg.commissioningRepairEpoch) or 0) + 1)
end

function degraded.currentSelectionScope(cfg, config)
  local scope, reason = degraded.selectionScope(cfg, config)
  if not scope then return nil, reason end
  if scope.token ~= cfg.commissioningRepairScopeToken then
    return nil, "repair selection token no longer matches its exact wrapper identity"
  end
  return scope
end

local function scopeCaptureId(cfg, result, scope)
  local captureId = type(result.captureId) == "string" and result.captureId or nil
  if captureId and captureId ~= "" and #captureId <= 96 then return captureId end
  local prefix
  if result.scopeOnly == true then prefix = "scope-only-"
  elseif result.noRequest == true then prefix = "no-request-" end
  if not prefix then return nil end
  -- Synthetic tokens identify a no-submit/scope-only terminal decision. They
  -- can bind the quarantine CAS but are never passed to request submission.
  captureId = prefix .. codec.digestText(tostring(scope and scope.token or ""))
  return #captureId <= 96 and captureId or nil
end

function degraded.scopeCaptureId(cfg, result)
  cfg, result = type(cfg) == "table" and cfg or {},
    type(result) == "table" and result or {}
  return scopeCaptureId(cfg, result, { token = cfg.commissioningRepairScopeToken })
end

function degraded.quarantineScope(cfg, config, result)
  cfg, result = type(cfg) == "table" and cfg or {},
    type(result) == "table" and result or {}
  local scope, scopeReason = degraded.currentSelectionScope(cfg, config)
  if not scope then return nil, scopeReason end
  local captureId = scopeCaptureId(cfg, result, scope)
  if result.scopeToken ~= scope.token then
    return nil, "terminal causal receipt belongs to another repair selection"
  end
  if not captureId then
    return nil, "terminal causal receipt has no bounded capture authority"
  end
  if type(cfg.commissioningQuarantineCaptureId) == "string"
      and captureId ~= cfg.commissioningQuarantineCaptureId then
    return nil, "terminal causal receipt changed after quarantine selection"
  end
  if type(cfg.commissioningQuarantineScopeToken) == "string"
      and scope.token ~= cfg.commissioningQuarantineScopeToken then
    return nil, "terminal causal receipt no longer matches its exact wrapper row"
  end
  if result.scopeOnly ~= true and result.noRequest ~= true then
    local loaded, evidence = pcall(require, "oc.ae2.identity_evidence")
    local called, status = false, nil
    if loaded and type(evidence.captureStatus) == "function" then
      called, status = pcall(evidence.captureStatus,
        type(config) == "table" and config.workflowNamespace or nil)
    end
    local capture = called and type(status) == "table" and status.capture or nil
    if type(capture) ~= "table" then return nil, "terminal capture is unavailable" end
    if capture.captureId ~= captureId then return nil, "terminal capture ID changed" end
    if capture.causal ~= true then return nil, "terminal capture is not causal" end
    if capture.workflowId ~= scope.workflowId
        or tonumber(capture.configIndex) ~= scope.configIndex then
      return nil, "terminal capture belongs to another wrapper row"
    end
    if capture.scopeToken ~= scope.token then
      return nil, "terminal capture belongs to another repair epoch"
    end
  end
  return { workflowSignature = scope.workflowSignature,
    workflowCount = scope.workflowCount, configIndex = scope.configIndex,
    workflowId = scope.workflowId, captureId = captureId,
    scopeToken = scope.token, identityDigest = scope.identityDigest,
    repairEpoch = scope.epoch, reasonCode = "causal_identity_unverified" }
end

function degraded.reportFields(cfg)
  cfg = type(cfg) == "table" and cfg or {}
  local count = math.max(0, math.floor(tonumber(cfg.commissioningDegradedCount) or 0))
  return { degraded = count > 0, degradedCount = count,
    quarantinedRows = cfg.commissioningQuarantinedRows,
    quarantineReason = cfg.commissioningQuarantineReason }
end

function degraded.completionReason(cfg, fallback)
  local fields = degraded.reportFields(cfg)
  if fields.degraded then
    return "Fluid Stock commissioned; " .. tostring(fields.degradedCount)
      .. " causally unverified wrapper row(s) remain locally quarantined"
  end
  return fallback
end

return degraded
-- Automatic bridge from one causal wrapper probe into either exact repair or
-- signature-bound row-local quarantine. No path in this module submits work.
local commissioningConfig = require("oc.ae2.maintainer_commissioning_config")
local degraded = require("oc.ae2.maintainer_commissioning_degraded")
local policy = require("oc.ae2.maintainer_commissioning_policy")

local recovery = {}

local function wait(cfg, reason, report)
  report = type(report) == "table" and report or {}
  return true, tostring(reason or report.reason or "waiting for causal fluid identity"), cfg, {
    pending = true, retryAfter = tonumber(report.retryAfter) or 2,
    repairState = report.state
  }
end

local function ensureScope(cfg, stamp)
  local snapshot, loadReason = policy.load()
  if not snapshot then return nil, loadReason, { pending = true, retryAfter = 2 } end
  if cfg.commissioningRepairScopeToken then
    local scope, reason = degraded.currentSelectionScope(cfg, snapshot.value)
    if not scope then return nil, reason, { blocked = true } end
    return cfg
  end
  local scope, reason = degraded.selectionScope(cfg, snapshot.value, nil,
    math.max(1, tonumber(cfg.commissioningRepairEpoch) or 0))
  if not scope then return nil, reason, { blocked = true } end
  local ok, saveReason, saved = commissioningConfig.advance(
    cfg.commissioningSerial, cfg.commissioningState, cfg.commissioningState, {
      commissioningReason = "binding exact repair selection scope",
      commissioningRepairEpoch = scope.epoch,
      commissioningRepairScopeToken = scope.token
    }, stamp)
  if not ok then return nil, saveReason, { pending = true, retryAfter = 2 } end
  return nil, "exact repair selection scope persisted", {
    pending = true, retryAfter = 0, saved = saved }
end

local function quarantine(cfg, stamp, result, reason)
  local snapshot, loadReason = policy.load()
  if not snapshot then return wait(cfg, loadReason) end
  result = type(result) == "table" and result or {}
  if not result.captureId then
    result.scopeToken = result.scopeToken or cfg.commissioningRepairScopeToken
  end
  if not result.captureId and result.noRequest ~= true then result.scopeOnly = true end
  local scope, scopeReason = degraded.quarantineScope(cfg, snapshot.value, result)
  if not scope then return false, scopeReason, cfg, { blocked = true } end
  local ok, saveReason, saved = commissioningConfig.advance(
    cfg.commissioningSerial, cfg.commissioningState, "quarantining_repair", {
      commissioningReason = "causal proof is terminal; quarantining only its exact wrapper row",
      commissioningQuarantineCaptureId = scope.captureId,
      commissioningQuarantineWorkflowId = scope.workflowId,
      commissioningQuarantineScopeToken = scope.scopeToken,
      commissioningQuarantineReason = scope.reasonCode
    }, stamp)
  return ok, saveReason or reason, saved or cfg
end

function recovery.run(cfg, stamp, recoveryOnly)
  local scoped, scopeReason, scopeDirective = ensureScope(cfg, stamp)
  if not scoped then
    scopeDirective = type(scopeDirective) == "table" and scopeDirective or {}
    return scopeDirective.blocked ~= true, scopeReason,
      scopeDirective.saved or cfg, scopeDirective
  end
  cfg = scoped
  local loaded, probe = pcall(require, "oc.ae2.workflow_fluid_identity_probe")
  if not loaded or type(probe) ~= "table" or type(probe.run) ~= "function" then
    if recoveryOnly then
      return quarantine(cfg, stamp, { scopeOnly = true },
        "causal fluid probe backend unavailable at its bounded deadline")
    end
    return wait(cfg, "causal fluid probe backend unavailable")
  end
  local called, ok, reason, result = pcall(probe.run, {
    configIndex = cfg.commissioningRepairIndex,
    workflowId = cfg.commissioningRepairWorkflowId,
    commissioningSerial = cfg.commissioningSerial,
    repairScopeToken = cfg.commissioningRepairScopeToken,
    recoveryOnly = recoveryOnly == true
  })
  if not called then
    if recoveryOnly then
      return quarantine(cfg, stamp, { scopeOnly = true },
        "causal fluid probe crashed at its bounded deadline: " .. tostring(ok))
    end
    return wait(cfg, "causal fluid probe crashed; reopening its durable receipt: "
      .. tostring(ok))
  end
  result = type(result) == "table" and result or {}
  if not result.captureId then
    result.scopeToken = result.scopeToken or cfg.commissioningRepairScopeToken
  end
  if ok == true and result.completed == true and result.recordId then
    if type(result.captureId) ~= "string"
        or result.scopeToken ~= cfg.commissioningRepairScopeToken then
      return quarantine(cfg, stamp, { scopeOnly = true,
        scopeToken = cfg.commissioningRepairScopeToken },
        "completed causal receipt belongs to a stale repair selection")
    end
    return commissioningConfig.advance(cfg.commissioningSerial,
      cfg.commissioningState, "repair_preview", {
        commissioningReason = "causal fluid evidence captured; previewing repair",
        commissioningRepairRecordId = result.recordId
      }, stamp)
  end
  if result.retryable == true or result.pending == true then
    return wait(cfg, reason, result)
  end
  return quarantine(cfg, stamp, result,
    reason or result.reason or "causal fluid identity is unverified")
end

function recovery.continue(cfg, stamp)
  local snapshot, loadReason = policy.load()
  if not snapshot then return wait(cfg, loadReason) end
  local captureId = cfg.commissioningQuarantineCaptureId
  local scopeOnly = type(captureId) == "string"
    and captureId:sub(1, 11) == "scope-only-"
  local noRequest = type(captureId) == "string"
    and captureId:sub(1, 11) == "no-request-"
  local scope, scopeReason = degraded.quarantineScope(cfg, snapshot.value, {
    captureId = captureId, scopeOnly = scopeOnly, noRequest = noRequest,
    scopeToken = cfg.commissioningRepairScopeToken
  })
  if not scope then return false, scopeReason, cfg, { blocked = true } end
  return commissioningConfig.continueAfterQuarantine(
    cfg.commissioningSerial, scope, stamp)
end

return recovery
-- Exact backend authority for the automatic commissioning state machine.
-- Callers may describe a capability, but durable daemon/evidence receipts are
-- the authority; generic booleans never bypass an active commissioning owner.
local authority = {}

local activeStates = {
  requested = true, stopping = true, configuring_craft = true,
  planning_fluid = true, probing_fluid = true, repair_probe = true,
  quarantining_repair = true,
  repair_preview = true, repair_confirm = true, repair_wait = true,
  committing_fluid = true, aborting = true,
  restoring_policy = true, restoring_daemon = true
}
local ownerStates = {
  craft = { configuring_craft = true },
  fluid = { committing_fluid = true },
  restore = { restoring_policy = true },
  quiesce = { requested = true, stopping = true, repair_confirm = true,
    repair_wait = true, aborting = true }
}

function authority.active(cfg)
  return type(cfg) == "table"
    and activeStates[tostring(cfg.commissioningState or "idle")] == true
end

function authority.reason(cfg, subject)
  return "automatic commissioning owns " .. tostring(subject or "this control")
    .. " (serial=" .. tostring(cfg and cfg.commissioningSerial or "?")
    .. ", state=" .. tostring(cfg and cfg.commissioningState or "unknown")
    .. "); the control is disabled until prior policy is restored"
end

function authority.policyOwnerAllowed(cfg, owner, purpose)
  if not authority.active(cfg) then return true end
  local states = ownerStates[tostring(purpose or "")]
  return type(owner) == "table" and owner.purpose == purpose
    and tonumber(owner.serial) == tonumber(cfg.commissioningSerial)
    and states and states[tostring(cfg.commissioningState)] == true
end

function authority.ownerStateAllowed(cfg, serial, states)
  if not authority.active(cfg) then return true end
  return tonumber(serial) == tonumber(cfg.commissioningSerial)
    and type(states) == "table" and states[tostring(cfg.commissioningState)] == true
end

-- Reconciliation commits carry their immutable transaction ID. Permit only
-- the transaction selected by this commissioning receipt, never a new/fleet
-- transaction that happens to run while commissioning owns policy.
function authority.identityTransactionAllowed(cfg, options)
  if not authority.active(cfg) then return true end
  options = type(options) == "table" and options or {}
  local token = type(cfg.identityReconcilePlanToken) == "table"
    and cfg.identityReconcilePlanToken or {}
  local state = tostring(cfg.commissioningState or "")
  local exactTransaction = type(options.identityTransactionId) == "string"
    and options.identityTransactionId == token.transactionId
  local repair = (state == "repair_confirm" or state == "repair_wait")
    and cfg.identityReconcileOperation == "reconcile"
    and tonumber(cfg.identityReconcileSerial) == tonumber(cfg.commissioningReconcileSerial)
    and tonumber(cfg.identityReconcileConfigIndex) == tonumber(cfg.commissioningRepairIndex)
    and cfg.identityReconcileWorkflowId == cfg.commissioningRepairWorkflowId
    and cfg.identityReconcileRecordId == cfg.commissioningRepairRecordId
    and exactTransaction
  local basis = tostring(cfg.commissioningIntentBasis or "")
  local inherited = (state == "requested" or state == "aborting")
    and (basis == "reconcile_plan" or basis == "legacy_reconcile_quiescent")
    and cfg.identityReconcileOperation == "reconcile" and exactTransaction
    and cfg.identityReconcileRequestId == "identity-reconcile:"
      .. tostring(cfg.identityReconcileSerial)
    and (token.scope == "fleet" or (token.scope == "selected"
      and tonumber(cfg.identityReconcileConfigIndex) == tonumber(token.selectedConfigIndex)
      and cfg.identityReconcileWorkflowId == token.selectedWorkflowId
      and cfg.identityReconcileRecordId == token.selectedRecordId))
  return repair or inherited
end

function authority.reconcileAllowed(cfg, serial, state, options)
  if not authority.active(cfg) then return true end
  options = type(options) == "table" and options or {}
  if tonumber(serial) ~= tonumber(cfg.commissioningSerial)
      or tostring(cfg.commissioningState) ~= tostring(state) then return false end
  if state == "repair_preview" then
    return tonumber(options.configIndex) == tonumber(cfg.commissioningRepairIndex)
      and options.workflowId == cfg.commissioningRepairWorkflowId
      and options.recordId == cfg.commissioningRepairRecordId
  end
  return tonumber(cfg.identityReconcileSerial) == tonumber(cfg.commissioningReconcileSerial)
    and tonumber(cfg.identityReconcileConfigIndex) == tonumber(cfg.commissioningRepairIndex)
    and cfg.identityReconcileWorkflowId == cfg.commissioningRepairWorkflowId
    and cfg.identityReconcileRecordId == cfg.commissioningRepairRecordId
end

function authority.safeStopComplete(cfg)
  return cfg.enabled == false and cfg.maintenanceBrake ~= true
    and cfg.identityReconcileOperation == "safe_stop"
    and cfg.identityReconcileState == "complete_safe"
end

function authority.reconcileMatches(cfg, daemon)
  return tonumber(daemon.identityReconcileConfigIndex) == tonumber(cfg.commissioningRepairIndex)
    and daemon.identityReconcileWorkflowId == cfg.commissioningRepairWorkflowId
    and daemon.identityReconcileRecordId == cfg.commissioningRepairRecordId
end

function authority.repairOptions(cfg, daemon, confirm)
  return { configIndex = cfg.commissioningRepairIndex,
    workflowId = cfg.commissioningRepairWorkflowId,
    recordId = cfg.commissioningRepairRecordId,
    commissioningSerial = cfg.commissioningSerial,
    addObserved = true, confirm = confirm == true,
    serial = confirm and (cfg.commissioningReconcileSerial
      or daemon.identityReconcileSerial) or nil }
end

function authority.repairFinished(cfg, daemon)
  return daemon.identityReconcileOperation == "reconcile"
    and daemon.identityReconcileState == "complete_safe"
    and authority.reconcileMatches(cfg, daemon)
end

local function text(value, limit)
  return type(value) == "string" and value ~= "" and #value <= limit and value or nil
end

function authority.probeSubmissionAllowed(cfg, capability)
  if not authority.active(cfg) then return true end
  local cap = type(capability) == "table" and capability or {}
  local captureId, requestKey = text(cap.captureId, 96), text(cap.requestKey, 96)
  local namespace, cpuName = text(cap.namespace, 96), text(cap.cpuName, 128)
  local scopeToken = text(cap.scopeToken, 96)
  if tostring(cfg.commissioningState) ~= "repair_probe"
      or cap.contract ~= "commissioning_causal_probe_v1"
      or tonumber(cap.serial) ~= tonumber(cfg.commissioningSerial)
      or tonumber(cap.configIndex) ~= tonumber(cfg.commissioningRepairIndex)
      or cap.workflowId ~= cfg.commissioningRepairWorkflowId
      or not scopeToken or scopeToken ~= cfg.commissioningRepairScopeToken
      or not captureId or not requestKey or requestKey ~= "fluid-probe-" .. captureId
      or not namespace or not cpuName
      or (cap.stage ~= "preflight" and cap.stage ~= "invoke") then return false end
  local loaded, evidence = pcall(require, "oc.ae2.identity_evidence")
  if not loaded or type(evidence) ~= "table" or type(evidence.captureStatus) ~= "function" then
    return false
  end
  local called, status = pcall(evidence.captureStatus, namespace)
  local capture = called and type(status) == "table" and status.capture or nil
  if type(capture) ~= "table" or capture.active ~= true or capture.causal ~= true
      or capture.captureId ~= captureId or capture.cpuName ~= cpuName
      or capture.scopeToken ~= scopeToken
      or capture.workflowId ~= cap.workflowId
      or tonumber(capture.configIndex) ~= tonumber(cap.configIndex)
      or (cap.gridAddress ~= nil and status.gridAddress ~= cap.gridAddress) then return false end
  if cap.stage == "preflight" then
    return capture.status == "ARMED" and capture.requestKey == nil
  end
  return capture.status == "SUBMITTED" and capture.requestKey == requestKey
end

return authority
-- Workflow-policy intent capture and restoration for automatic commissioning.
-- A compact stable-ID signature plus a 512-bit arming bitmap preserves exact
-- operator permission without copying the workflow database into daemon state.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local control = require("oc.ae2.maintainer_daemon_control")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local editor = require("oc.ae2.workflow_editor")
local fluidStockProfile = require("oc.ae2.fluid_stock_profile")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")

local policy = {}
local MAX_WORKFLOWS = 512
local inheritedStates = {
  braking = true, draining = true, zero_proven = true,
  committing = true, failed_safe = true
}

local function signature(config)
  if type(fluidStockProfile.workflowSignature) == "function" then
    return fluidStockProfile.workflowSignature(config)
  end
  local rows = type(config) == "table" and config.workflows or nil
  if type(rows) ~= "table" or #rows > MAX_WORKFLOWS then
    return nil, "commissioning supports at most " .. tostring(MAX_WORKFLOWS) .. " workflow rows"
  end
  local parts = { tostring(#rows) }
  for index, row in ipairs(rows) do
    local id = type(row) == "table" and row.workflowId or nil
    if type(id) ~= "string" or id == "" then
      return nil, "workflow row " .. tostring(index) .. " has no stable identity"
    end
    parts[#parts + 1] = id
  end
  return codec.digestText(table.concat(parts, "\31")), nil, #rows
end

local function encodeArmed(config)
  local rows = type(config) == "table" and config.workflows or {}
  local out = {}
  for first = 1, #rows, 4 do
    local nibble = 0
    for offset = 0, 3 do
      local row = rows[first + offset]
      if type(row) == "table" and row.armed == true then nibble = nibble + 2 ^ offset end
    end
    out[#out + 1] = string.format("%x", nibble)
  end
  return table.concat(out)
end

local function decodedArmed(bits, index)
  local place = math.floor((index - 1) / 4) + 1
  local nibble = tonumber(tostring(bits or ""):sub(place, place), 16)
  if nibble == nil then return nil end
  return math.floor(nibble / (2 ^ ((index - 1) % 4))) % 2 == 1
end

local function validIntent(intent)
  local count = tonumber(intent and intent.workflowCount)
  if type(intent) ~= "table" or type(intent.priorDaemonEnabled) ~= "boolean"
      or type(intent.priorGlobalAutoEnabled) ~= "boolean"
      or type(intent.armedBits) ~= "string"
      or not intent.armedBits:match("^[0-9a-f]*$")
      or not count or count ~= math.floor(count) or count < 0 or count > MAX_WORKFLOWS
      or #intent.armedBits ~= math.ceil(count / 4)
      or type(intent.workflowSignature) ~= "string"
      or intent.workflowSignature == "" or #intent.workflowSignature > 96 then
    return nil, "durable commissioning intent is malformed"
  end
  return intent
end

function policy.load()
  local called, snapshot, reason = pcall(store.rawSnapshot)
  if not called or type(snapshot) ~= "table" or type(snapshot.value) ~= "table" then
    return nil, tostring(called and reason or snapshot or "workflow policy is unavailable")
  end
  return snapshot
end

local function sameQuarantine(left, right)
  if left == nil or right == nil then return left == nil and right == nil end
  return left.bits == right.bits
    and left.workflowSignature == right.workflowSignature
    and tonumber(left.workflowCount) == tonumber(right.workflowCount)
    and left.reason == right.reason and tonumber(left.count) == tonumber(right.count)
end

local function quarantineMatches(config, cfg)
  if type(fluidStockProfile.quarantineView) ~= "function" then return true end
  local expected, expectedReason = fluidStockProfile.quarantineView(config, cfg)
  if expectedReason then return false end
  local marker = type(config) == "table" and config.fluidStockCompatibility or nil
  local stored, storedReason = fluidStockProfile.quarantineView(config, marker)
  return storedReason == nil and sameQuarantine(expected, stored)
end

function policy.desiredCurrent(config, cfg)
  if model.craftCompatibility(config) ~= model.craftCompatibilityModes.legacyFiltered then
    return false
  end
  local reviewed = fluidStockProfile.targetSet(config)
  if type(reviewed) ~= "table" or reviewed.error or reviewed.primaryIssue then return false end
  if cfg ~= nil and not quarantineMatches(config, cfg) then return false end
  local status = fluidStockProfile.status(config.fluidStockCompatibility, nil, config)
  return type(status) == "table" and status.active == true
end

function policy.profileMatches(config, canary, revision)
  local current = fluidStockProfile.status(config.fluidStockCompatibility, nil, config)
  return type(current) == "table" and current.active == true
    and current.canaryFluid == canary and current.topologyRevision == revision
end

local quarantineFields = { "quarantinedRows", "quarantineWorkflowSignature",
  "quarantineWorkflowCount", "quarantineReason", "degradedCount" }

local function sameQuarantineFields(left, right)
  left, right = fluidStockProfile.normalize(left), fluidStockProfile.normalize(right)
  for _, field in ipairs(quarantineFields) do
    if left[field] ~= right[field] then return false end
  end
  return true
end

local function sealQuarantine(snapshot, cfg)
  if type(fluidStockProfile.withQuarantine) ~= "function" then return true end
  local marker, bindReason = fluidStockProfile.withQuarantine(
    snapshot.value.fluidStockCompatibility, snapshot.value, cfg)
  if not marker then return false, bindReason, { retryable = true, replan = true } end
  if sameQuarantineFields(marker, snapshot.value.fluidStockCompatibility) then return true end
  local ok, reason = store.patchRoot("fluidStockCompatibility", marker,
    "automatic_commissioning_fluid_quarantine", function(candidate)
      if not policy.profileMatches(candidate, cfg.commissioningCanaryFluid,
          cfg.commissioningTopologyRevision) then
        return false, "Fluid Stock profile changed before quarantine projection"
      end
      local fresh, freshReason = fluidStockProfile.withQuarantine(
        candidate.fluidStockCompatibility, candidate, cfg)
      return fresh ~= nil, freshReason
    end, { commissioningOwner = {
      serial = cfg.commissioningSerial, purpose = "fluid" } })
  if ok ~= true then return false, reason, { retryable = true, replan = true } end
  return true
end

function policy.commitProfile(cfg)
  local snapshot, loadReason = policy.load()
  if not snapshot then return false, loadReason, { retryable = true } end
  if policy.desiredCurrent(snapshot.value, cfg) then return true end
  if not policy.profileMatches(snapshot.value, cfg.commissioningCanaryFluid,
      cfg.commissioningTopologyRevision) then
    local proof = {
      contract = "ae2fc_exact_positive_canary_v1",
      method = cfg.commissioningCanaryMethod,
      canaryFluid = cfg.commissioningCanaryFluid,
      gridAddress = cfg.commissioningCanaryGrid,
      count = tonumber(cfg.commissioningCanaryCount),
      observedAt = tonumber(cfg.commissioningCanaryObservedAt)
    }
    local ok, reason = editor.setFluidStockCompatibility(cfg.commissioningCanaryFluid,
      cfg.commissioningTopologyRevision, "CONFIRM", proof,
      { serial = cfg.commissioningSerial, purpose = "fluid" })
    if ok ~= true then return false, reason, { retryable = true, replan = true } end
    snapshot, loadReason = policy.load()
    if not snapshot then return false, loadReason, { retryable = true } end
  end
  return sealQuarantine(snapshot, cfg)
end

function policy.captureIntent(snapshot, cfg)
  local digest, reason, count = signature(snapshot.value)
  if not digest then return nil, reason end
  local priorDaemon, priorGlobal = cfg.enabled == true,
    snapshot.value.autoEnabled ~= false
  local armedBits, basis = encodeArmed(snapshot.value), "live_policy"
  local operation, state = tostring(cfg.identityReconcileOperation or ""),
    tostring(cfg.identityReconcileState or "idle")
  if inheritedStates[state] and operation == "safe_stop" then
    priorDaemon, basis = false, "safe_stop_off"
  elseif inheritedStates[state] and operation == "reconcile" then
    if type(cfg.identityReconcilePriorEnabled) == "boolean" then
      priorDaemon = cfg.identityReconcilePriorEnabled
    end
    local token = type(cfg.identityReconcilePlanToken) == "table"
      and cfg.identityReconcilePlanToken or {}
    if type(token.priorGlobalAutoEnabled) == "boolean"
        and type(token.priorArmedBits) == "string"
        and type(token.priorWorkflowSignature) == "string"
        and tonumber(token.priorWorkflowCount) ~= nil then
      priorGlobal, armedBits = token.priorGlobalAutoEnabled, token.priorArmedBits
      digest, count, basis = token.priorWorkflowSignature,
        tonumber(token.priorWorkflowCount), "reconcile_plan"
    else
      basis = "legacy_reconcile_quiescent"
    end
  end
  return validIntent({ priorDaemonEnabled = priorDaemon,
    priorGlobalAutoEnabled = priorGlobal, armedBits = armedBits,
    workflowSignature = digest, workflowCount = count,
    daemonGeneration = tonumber(cfg.generation) or 0, intentBasis = basis })
end

-- Blocked retries retain the first durable intent. Re-basing is an explicit
-- caller decision because quiesced policy is not evidence of prior permission.
function policy.retainedIntent(cfg)
  return validIntent({
    priorDaemonEnabled = cfg.commissioningPriorDaemonEnabled,
    priorGlobalAutoEnabled = cfg.commissioningPriorGlobalAutoEnabled,
    armedBits = cfg.commissioningArmedBits,
    workflowSignature = cfg.commissioningWorkflowSignature,
    workflowCount = cfg.commissioningWorkflowCount,
    daemonGeneration = cfg.commissioningExpectedDaemonGeneration,
    intentBasis = cfg.commissioningIntentBasis or "retained_blocked"
  })
end

local function flags(config, cfg)
  local digest, reason, count = signature(config)
  if not digest then return nil, reason end
  if digest ~= cfg.commissioningWorkflowSignature
      or count ~= tonumber(cfg.commissioningWorkflowCount) then
    return nil, "workflow membership changed during commissioning; prior armed intent was not guessed"
  end
  local desired = (config.autoEnabled ~= false)
    == (cfg.commissioningPriorGlobalAutoEnabled == true)
  local quiescent = config.autoEnabled == false
  for index, row in ipairs(config.workflows or {}) do
    local wanted = decodedArmed(cfg.commissioningArmedBits, index)
    if wanted == nil then return nil, "saved armed-intent bitmap is malformed" end
    desired = desired and (row.armed == true) == wanted
    quiescent = quiescent and row.armed ~= true
  end
  return { desired = desired, quiescent = quiescent }
end

-- Returns success, reason, {generation|retryable|blocked}. All workflow writes
-- preserve fresh decoded policy and verify the exact restored permission set.
function policy.restore(cfg)
  local snapshot, loadReason = policy.load()
  if not snapshot then return false, loadReason, { retryable = true } end
  local current, reason = flags(snapshot.value, cfg)
  if not current then return false, reason, { blocked = true } end
  if current.desired then
    return true, nil, { generation = tonumber(daemonConfig.load().generation) }
  end
  if not current.quiescent then
    return false, "workflow permission changed during commissioning; prior intent was not overwritten",
      { blocked = true }
  end
  local candidate = snapshot.value
  candidate.autoEnabled = cfg.commissioningPriorGlobalAutoEnabled == true
  for index, row in ipairs(candidate.workflows or {}) do
    row.armed = decodedArmed(cfg.commissioningArmedBits, index) == true
  end
  local saved, saveReason = store.saveRawSnapshot(snapshot, candidate, function(decoded)
    local verified = flags(decoded, cfg)
    return verified and verified.desired == true,
      "restored workflow permission does not match the durable commissioning intent"
  end, "automatic_commissioning_restore", { commissioningOwner = {
    serial = cfg.commissioningSerial, purpose = "restore" } })
  if saved ~= true then return false, tostring(saveReason), { retryable = true } end
  return true, nil, { generation = tonumber(daemonConfig.load().generation) }
end

function policy.restoreDaemon(cfg)
  local daemon = daemonConfig.load()
  local expected = tonumber(cfg.commissioningExpectedDaemonGeneration)
  if cfg.commissioningPriorDaemonEnabled ~= true then
    if daemon.enabled == true then
      return false, "daemon ownership changed before prior OFF intent was verified",
        { blocked = true }
    end
    return true, nil, { reason = "automatic GTNH 2.8.4 commissioning complete; prior daemon OFF intent restored" }
  end
  if daemon.enabled == true then
    local generation = tonumber(daemon.generation)
    if expected and generation ~= expected and generation ~= expected + 1 then
      return false, "daemon generation changed outside commissioning during restore",
        { blocked = true }
    end
    return true, nil, { reason = "automatic GTNH 2.8.4 commissioning complete; prior daemon ON intent restored" }
  end
  if expected == nil or tonumber(daemon.generation) ~= expected then
    return false, "daemon generation changed before conditional commissioning restore",
      { blocked = true }
  end
  local called, ok, reason = pcall(control.start, {
    expectedGeneration = expected, deferFirstTick = true
  })
  if not called then
    return false, "daemon restore crashed: " .. tostring(ok), { retryable = true }
  end
  if ok ~= true then return false, reason or "waiting to restore daemon", { retryable = true } end
  return true, nil, { reason = "automatic GTNH 2.8.4 commissioning complete; prior daemon ON intent restored" }
end

return policy
-- Bounded yielded execution loop for the durable commissioning state machine.
local computer = require("computer")

local worker = {}
local BROKER_OWNER = "oc-ae2-rc"
local WAKE_EVENT = "oc_ae2_commissioning_wake"
local AUTHORITY_KEY = "__oc_ae2_commissioning_broker_v1"
local MAX_PROCESS_ROWS, MAX_PROCESS_INSTANCES = 64, 64
local START_GRACE_SECONDS, STOP_WAIT_SECONDS = 10, 5
local WATCHDOG_BASE_SECONDS, WATCHDOG_MAX_SECONDS = 1, 30
local authorityNonce = tostring({}):gsub("^table:%s*", "")
local maintenanceStates = {
  braking = true, draining = true, zero_proven = true,
  committing = true, failed_safe = true
}

local function now()
  local ok, value = pcall(computer.uptime)
  value = ok and tonumber(value) or nil
  return value and value == value and value >= 0 and value < math.huge and value or 0
end

local function processApi()
  local ok, process = pcall(require, "process")
  if not ok or type(process) ~= "table" or type(process.list) ~= "table" then
    return nil, "OpenOS commissioning process authority is unavailable"
  end
  return process
end

local function currentProcessRecord(process)
  local running = coroutine.running()
  if type(process.findProcess) == "function" then
    local ok, current = pcall(process.findProcess, running)
    if ok and type(current) == "table" then return current end
  end
  local count = 0
  for main, candidate in pairs(process.list) do
    count = count + 1
    if count > MAX_PROCESS_ROWS then
      return nil, "OpenOS process list exceeds the commissioning authority bound"
    end
    if main == running then return candidate end
    local instances = type(candidate) == "table" and candidate.instances or nil
    if type(instances) == "table" then
      local instanceCount = 0
      for _, instance in pairs(instances) do
        instanceCount = instanceCount + 1
        if instanceCount > MAX_PROCESS_INSTANCES then
          return nil, "OpenOS process instance list exceeds the commissioning authority bound"
        end
        if instance == running then return candidate end
      end
    end
  end
  return nil, "OpenOS current process is unavailable"
end

local function coroutineDead(value)
  if type(value) ~= "thread" then return nil end
  local ok, state = pcall(coroutine.status, value)
  return not ok or state == "dead"
end

local function handleDead(handle)
  if type(handle) ~= "table" or type(handle.status) ~= "function" then return nil end
  local ok, state = pcall(handle.status, handle)
  if not ok then return nil end
  return state == "dead"
end

local function liveToken(record)
  if type(record) ~= "table" then return nil end
  local token = rawget(record, AUTHORITY_KEY)
  if type(token) ~= "table" or token.schema ~= 1 or token.owner ~= BROKER_OWNER then
    if token ~= nil then rawset(record, AUTHORITY_KEY, nil) end
    return nil
  end
  local dead = coroutineDead(token.thread)
  if dead == nil then dead = handleDead(token.handle) end
  if dead == nil and token.state == "starting" and coroutineDead(token.starter) == true then
    dead = now() - (tonumber(token.startedAt) or 0) > START_GRACE_SECONDS
  end
  if dead == nil and token.state ~= "starting"
      and type(token.thread) ~= "thread" and type(token.handle) ~= "table" then
    dead = true
  end
  if dead == true or token.state == "stopped" then
    if rawget(record, AUTHORITY_KEY) == token then rawset(record, AUTHORITY_KEY, nil) end
    return nil
  end
  return token
end

local function authorityStatus()
  local process, processReason = processApi()
  if not process then return nil, processReason end
  local count = 0
  for _, candidate in pairs(process.list) do
    count = count + 1
    if count > MAX_PROCESS_ROWS then
      return nil, "OpenOS process list exceeds the commissioning authority bound"
    end
    local token = liveToken(candidate)
    if token then return { record = candidate, token = token } end
  end
  return false
end

-- OpenOS scheduling is cooperative. Tagging the current process followed by
-- this bounded scan does not yield, so two RC invocations cannot both win.
local function acquireAuthority()
  local process, processReason = processApi()
  if not process then return nil, nil, processReason end
  local current, currentReason = currentProcessRecord(process)
  if not current then return nil, nil, currentReason end
  local existing = liveToken(current)
  if existing then return { record = current, token = existing }, false end
  local token = {
    schema = 1, owner = BROKER_OWNER, nonce = authorityNonce,
    state = "starting", starter = coroutine.running(), startedAt = now(),
    failures = 0, stopRequested = false, stopAcknowledged = false
  }
  rawset(current, AUTHORITY_KEY, token)
  local count = 0
  for _, candidate in pairs(process.list) do
    count = count + 1
    if count > MAX_PROCESS_ROWS then
      if rawget(current, AUTHORITY_KEY) == token then rawset(current, AUTHORITY_KEY, nil) end
      return nil, nil, "OpenOS process list exceeds the commissioning authority bound"
    end
    if candidate ~= current then
      local other = liveToken(candidate)
      if other then
        if rawget(current, AUTHORITY_KEY) == token then rawset(current, AUTHORITY_KEY, nil) end
        return { record = candidate, token = other }, false
      end
    end
  end
  return { record = current, token = token }, true
end

-- thread.create starts the child synchronously until its first yield. Move the
-- provisional tag from the short-lived RC process to that child process before
-- the warm-up event.pull; detach then changes only the handle's parent.
local function bindChildAuthority(authority)
  local process, processReason = processApi()
  if not process then return false, processReason end
  local current, currentReason = currentProcessRecord(process)
  if not current then return false, currentReason end
  if current == authority.record then return true end
  local token, count = authority.token, 0
  local currentToken = liveToken(current)
  if currentToken and currentToken ~= token then
    return false, "another commissioning broker owns the child process"
  end
  for _, candidate in pairs(process.list) do
    count = count + 1
    if count > MAX_PROCESS_ROWS then
      return false, "OpenOS process list exceeds the commissioning authority bound"
    end
    if candidate ~= current and candidate ~= authority.record then
      local other = liveToken(candidate)
      if other and other ~= token then
        return false, "another commissioning broker became active during launch"
      end
    end
  end
  rawset(current, AUTHORITY_KEY, token)
  if rawget(authority.record, AUTHORITY_KEY) == token then
    rawset(authority.record, AUTHORITY_KEY, nil)
  end
  authority.record = current
  return true
end

local function emit(options, level, message)
  if type(options.log) == "function" then pcall(options.log, level, tostring(message)) end
end

local function heartbeat(options, token, state, detail)
  local previous, stamp = token.state, now()
  token.state, token.heartbeatAt = state, stamp
  local lastCallback = tonumber(token.heartbeatCallbackAt)
  if type(options.heartbeat) == "function"
      and (previous ~= state or not lastCallback or stamp - lastCallback >= 60) then
    token.heartbeatCallbackAt = stamp
    pcall(options.heartbeat, {
      owner = BROKER_OWNER, state = state, detail = detail,
      failures = tonumber(token.failures) or 0,
      heartbeatAt = token.heartbeatAt
    })
  end
end

local function yieldFor(seconds, token)
  seconds = math.max(0, tonumber(seconds) or 0)
  local loaded, event = pcall(require, "event")
  if loaded and type(event) == "table" and type(event.pull) == "function" then
    local pulled, signal, command, owner = pcall(event.pull, seconds, WAKE_EVENT)
    if not pulled then return false, tostring(signal) end
    if signal == WAKE_EVENT and command == "stop" and owner == BROKER_OWNER then
      if type(token) == "table" then token.stopRequested = true end
    end
    return true, nil, command, owner
  end
  if os.sleep then os.sleep(seconds); return true end
  return false
end

function worker.defer(seconds) return yieldFor(seconds) end

local function push(command, owner)
  local loaded, event = pcall(require, "event")
  if not loaded or type(event) ~= "table" or type(event.push) ~= "function" then
    return false, "commissioning wake event is unavailable"
  end
  local called, result, reason = pcall(event.push, WAKE_EVENT, command, owner)
  if not called or result == false then
    return false, tostring(called and reason or result)
  end
  return true
end

function worker.wake()
  return push("wake")
end

function worker.requestBrokerStop(owner)
  if owner ~= BROKER_OWNER then return false, "commissioning broker owner is invalid" end
  local authority, authorityReason = authorityStatus()
  if authority == nil then return false, authorityReason end
  if authority == false then return true, nil, nil end
  local token = authority.token
  token.stopRequested, token.state, token.stopRequestedAt = true, "stopping", now()
  local pushed, pushReason = push("stop", owner)
  if not pushed then return false, pushReason, authority end
  return true, nil, authority
end

function worker.isBrokerRunning()
  local authority = authorityStatus()
  if type(authority) ~= "table" then return false end
  local state = tostring(authority.token.state or "")
  return state == "starting" or state == "running" or state == "backoff"
end

function worker.resumableMaintenance(cfg)
  local operation = tostring(cfg and cfg.identityReconcileOperation or "")
  local state = tostring(cfg and cfg.identityReconcileState or "idle")
  return maintenanceStates[state] == true
    and (operation == "reconcile" or operation == "safe_stop")
end

-- A finalized release may inherit a durable reconcile/Safe Stop receipt.
-- Resume that exact receipt before commissioning instead of turning it into
-- a CPU-clearing or repeated-preview prerequisite.
function worker.resumePriorMaintenance(cfg, control, loadConfig)
  if not worker.resumableMaintenance(cfg) then return false end
  local operation, state = tostring(cfg.identityReconcileOperation),
    tostring(cfg.identityReconcileState)
  local called, ok, reason
  if operation == "safe_stop" then
    called, ok, reason = pcall(control.safeStop,
      { automatic = true, commissioningSerial = cfg.commissioningSerial })
  else
    called, ok, reason = pcall(control.reconcileRecorded, {
      configIndex = cfg.identityReconcileConfigIndex,
      workflowId = cfg.identityReconcileWorkflowId,
      recordId = cfg.identityReconcileRecordId,
      addObserved = cfg.identityReconcileAddObserved ~= false,
      confirm = true, retry = state == "failed_safe",
      serial = cfg.identityReconcileSerial,
      commissioningSerial = cfg.commissioningSerial
    })
  end
  local detail = not called
    and ("prior " .. operation .. " resume crashed: " .. tostring(ok))
    or ok ~= true and tostring(reason or ("waiting to resume prior " .. operation))
    or ("prior " .. operation .. " receipt is finishing automatically")
  return true, detail, state == "failed_safe" and 5 or 1, loadConfig()
end

-- Abort prefers Safe Stop, but a surviving exact reconcile fence must be
-- rolled forward by its owner before Safe Stop may replace that transaction.
function worker.resumeAbortMaintenance(cfg, control, loadConfig)
  if tostring(cfg and cfg.identityReconcileOperation) ~= "reconcile"
      or not worker.resumableMaintenance(cfg) then return false end
  if cfg.identityReconcileState == "failed_safe" then
    local called, ok = pcall(control.safeStop,
      { automatic = true, commissioningSerial = cfg.commissioningSerial })
    local current = loadConfig()
    if called and ok == true then
      return true, "abort Safe Stop acquired exact reconcile fence", 1, current
    end
    cfg = current
  end
  return worker.resumePriorMaintenance(cfg, control, loadConfig)
end

function worker.run(api, options)
  options = type(options) == "table" and options or {}
  local token = options._token
  local maxSteps = math.max(1, math.min(4096,
    math.floor(tonumber(options.maxSteps) or 4096)))
  local maxSeconds = math.max(1, math.min(86400,
    tonumber(options.maxSeconds) or 21600))
  local started = now()
  for _ = 1, maxSteps do
    if type(token) == "table" and token.stopRequested == true then
      local report = api.status()
      report.pending, report.brokerStopping = report.active == true, true
      return true, nil, report
    end
    local ok, reason, report = api.step()
    if not ok or not report.active then return ok, reason, report end
    if now() - started >= maxSeconds then
      report.pending, report.retryable = true, true
      report.reason = "bounded commissioning worker yielded before terminal completion"
      return true, nil, report
    end
    if not yieldFor(report.nextIn or 0, token) then
      report.pending, report.retryable = true, true
      report.reason = "commissioning worker has no yielding event primitive"
      return false, report.reason, report
    end
  end
  local report = api.status()
  report.pending, report.retryable = report.active, report.active
  if report.active then report.reason = "bounded commissioning step budget exhausted" end
  return true, nil, report
end

-- The detached owner persists until a terminal durable receipt. Each inner
-- run remains bounded for testability and fault containment; continuation is
-- explicit and always yields, so a long craft or temporarily empty canary set
-- cannot silently strand commissioning after a release hook returns.
function worker.supervise(api, options)
  options = type(options) == "table" and options or {}
  local token = options._token
  local chunk = {
    maxSteps = math.max(1, math.min(512,
      math.floor(tonumber(options.chunkSteps) or 256))),
    maxSeconds = math.max(10, math.min(900,
      tonumber(options.chunkSeconds) or 300)),
    _token = token
  }
  while true do
    if type(token) == "table" and token.stopRequested == true then
      local report = api.status()
      report.brokerStopping = true
      return true, report
    end
    local called, ok, reason, report = pcall(worker.run, api, chunk)
    if not called then
      local statusCalled, current = pcall(api.status)
      report = statusCalled and type(current) == "table" and current or {}
      report.reason = "commissioning step crashed: " .. tostring(ok)
      return false, report
    end
    report = type(report) == "table" and report or api.status()
    if ok ~= true then
      report.reason = tostring(reason or report.reason or "commissioning step failed")
      return false, report
    end
    if report.active ~= true then return ok, report end
    if type(token) == "table" then
      heartbeat(options, token, "running", tostring(report.state or "active"))
    end
    local delay = tonumber(report.nextIn) or 1
    if not yieldFor(math.max(1, delay), token) then return false, report end
  end
end

-- The RC-owned broker remains alive while commissioning is idle. Every other
-- surface only persists a request and pushes WAKE_EVENT, so no Dashboard,
-- installer, or migration process can race a physical AE2 submission.
function worker.broker(api, options)
  options = type(options) == "table" and options or {}
  local token = type(options._token) == "table" and options._token or {
    owner = BROKER_OWNER, state = "running", stopRequested = false, failures = 0
  }
  if options.owner ~= BROKER_OWNER then
    return false, "commissioning broker owner is invalid", api.status()
  end
  local defer = math.max(0, math.min(60, tonumber(options.deferSeconds) or 0))
  if defer > 0 and not yieldFor(defer, token) then
    return false, "commissioning broker cannot yield", api.status()
  end
  local idleSeconds = math.max(10, math.min(3600,
    tonumber(options.idleSeconds) or 300))
  while token.stopRequested ~= true do
    local statusCalled, report = pcall(api.status)
    if not statusCalled or type(report) ~= "table" then
      return false, "commissioning status crashed: " .. tostring(report), nil
    end
    heartbeat(options, token, "running", tostring(report.state or "idle"))
    if report.active == true then
      local supervised, supervisedReport = worker.supervise(api, options)
      if not supervised then
        return false, tostring(supervisedReport and supervisedReport.reason
          or "commissioning supervisor failed"), supervisedReport
      end
    end
    if token.stopRequested ~= true then
      if not yieldFor(idleSeconds, token) then
        return false, "commissioning broker lost its yielding event primitive",
          type(report) == "table" and report or nil
      end
    end
  end
  local statusCalled, report = pcall(api.status)
  report = statusCalled and type(report) == "table" and report or {}
  report.brokerStopping = false
  return true, nil, report
end

local function copyOptions(options)
  local copied = {}
  for key, value in pairs(options) do copied[key] = value end
  return copied
end

-- This wrapper, rather than the inner service loop, owns the detached thread.
-- A crash returns to the wrapper, which logs it, yields with capped exponential
-- backoff, and resumes the same durable commissioning receipt.
local function watchdog(api, options, authority)
  local token = authority.token
  token.thread, token.starter = coroutine.running(), nil
  local bound, bindReason = bindChildAuthority(authority)
  if not bound then return false, bindReason end
  local initialDelay = math.max(0, math.min(60,
    tonumber(options.deferSeconds) or 0))
  if initialDelay > 0 then
    heartbeat(options, token, "starting", "bounded RC warm-up")
    local yielded, yieldReason = yieldFor(initialDelay, token)
    if not yielded then return false, yieldReason end
  end
  local brokerOptions = copyOptions(options)
  brokerOptions._token, brokerOptions.deferSeconds = token, 0
  while token.stopRequested ~= true do
    heartbeat(options, token, "running", "watchdog cycle")
    local called, ok, reason, report = pcall(worker.broker, api, brokerOptions)
    if token.stopRequested == true then break end
    token.failures = (tonumber(token.failures) or 0) + 1
    local detail = not called and tostring(ok)
      or tostring(reason or (ok == true and "broker exited before stop" or "broker failed"))
    emit(options, "warn", "commissioning broker restart "
      .. tostring(token.failures) .. ": " .. detail)
    local exponent = math.min(token.failures - 1, 8)
    local delay = math.min(WATCHDOG_MAX_SECONDS,
      WATCHDOG_BASE_SECONDS * (2 ^ exponent))
    heartbeat(options, token, "backoff", detail)
    local yielded, yieldReason = yieldFor(delay, token)
    if not yielded then
      emit(options, "error", "commissioning watchdog cannot yield: "
        .. tostring(yieldReason))
      return false, yieldReason, report
    end
  end
  return true
end

function worker.startBroker(api, options)
  options = type(options) == "table" and options or {}
  local statusCalled, report = pcall(api.status)
  report = statusCalled and type(report) == "table" and report or {}
  if options.owner ~= BROKER_OWNER then
    return false, "commissioning broker owner is invalid", report
  end
  local authority, createdAuthority, authorityReason = acquireAuthority()
  if not authority then return false, authorityReason, report end
  if not createdAuthority then
    local state = tostring(authority.token.state or "")
    report.workerRunning = state ~= "stopping" and state ~= "stopped"
    report.brokerStopping, report.brokerOwner = state == "stopping", BROKER_OWNER
    if report.brokerStopping then
      return false, "commissioning broker stop is still in progress", report
    end
    return true, nil, report
  end
  local token = authority.token
  local loaded, thread = pcall(require, "thread")
  if not loaded or type(thread) ~= "table" or type(thread.create) ~= "function" then
    if rawget(authority.record, AUTHORITY_KEY) == token then
      rawset(authority.record, AUTHORITY_KEY, nil)
    end
    return false, "thread library unavailable; AE2 RC broker could not start", report
  end
  local created, handle = pcall(thread.create, function()
    local called, ok, reason = pcall(watchdog, api, options, authority)
    if not called or ok ~= true then
      emit(options, "error", "commissioning watchdog stopped unexpectedly: "
        .. tostring(called and reason or ok))
    end
    token.stopAcknowledged = token.stopRequested == true
    heartbeat(options, token, "stopped",
      token.stopAcknowledged and "stop acknowledged" or "watchdog exited")
    if rawget(authority.record, AUTHORITY_KEY) == token then
      rawset(authority.record, AUTHORITY_KEY, nil)
    end
  end)
  if not created or not handle then
    if rawget(authority.record, AUTHORITY_KEY) == token then
      rawset(authority.record, AUTHORITY_KEY, nil)
    end
    return false, tostring(handle or "commissioning broker thread creation failed"), report
  end
  token.handle = handle
  if type(handle.detach) ~= "function" then
    token.stopRequested, token.state = true, "stopping"
    local killCalled, killResult = false, false
    if type(handle.kill) == "function" then
      killCalled, killResult = pcall(handle.kill, handle)
    end
    local killed = killCalled and killResult ~= false
    if killed and rawget(authority.record, AUTHORITY_KEY) == token then
      token.stopAcknowledged = true
      rawset(authority.record, AUTHORITY_KEY, nil)
    end
    return false, "commissioning broker thread cannot detach", report
  end
  local detached, detachResult, detachReason = pcall(handle.detach, handle)
  if not detached or detachResult == false then
    token.stopRequested, token.state = true, "stopping"
    local killCalled, killResult = false, false
    if type(handle.kill) == "function" then
      killCalled, killResult = pcall(handle.kill, handle)
    end
    local killed = killCalled and killResult ~= false
    if killed and rawget(authority.record, AUTHORITY_KEY) == token then
      token.stopAcknowledged = true
      rawset(authority.record, AUTHORITY_KEY, nil)
    end
    return false, tostring(detachReason or detachResult
      or "commissioning broker thread detach failed"), report
  end
  if rawget(authority.record, AUTHORITY_KEY) ~= token then
    return false, "commissioning watchdog exited during startup", report
  end
  report.workerRunning, report.brokerOwner = true, BROKER_OWNER
  return true, nil, report
end

function worker.stopBroker(api, options)
  options = type(options) == "table" and options or {}
  local statusCalled, report = pcall(api.status)
  report = statusCalled and type(report) == "table" and report or {}
  if options.owner ~= BROKER_OWNER then
    return false, "commissioning broker owner is invalid", report
  end
  local stopped, reason, authority = worker.requestBrokerStop(options.owner)
  if not stopped then return false, reason, report end
  if not authority then
    report.workerRunning, report.brokerStopping = false, false
    return true, nil, report
  end
  local token, handle = authority.token, authority.token.handle
  local waitSeconds = math.max(1, math.min(10,
    tonumber(options.waitSeconds) or STOP_WAIT_SECONDS))
  if type(handle) == "table" and type(handle.join) == "function" then
    pcall(handle.join, handle, waitSeconds)
  end
  local deadline = now() + waitSeconds
  while rawget(authority.record, AUTHORITY_KEY) == token
      and liveToken(authority.record) == token and now() < deadline do
    if type(os.sleep) ~= "function" then break end
    pcall(os.sleep, 0.05)
  end
  local remaining = liveToken(authority.record) == token
  report.workerRunning, report.brokerStopping = remaining, remaining
  if remaining then
    return false, "commissioning broker stop was not acknowledged within "
      .. tostring(waitSeconds) .. " seconds", report
  end
  return true, nil, report
end

function worker.clearBrokerForTests()
  local process = processApi()
  if not process then return false end
  local count = 0
  for _, record in pairs(process.list) do
    count = count + 1
    if count > MAX_PROCESS_ROWS then return false end
    if type(record) == "table" then rawset(record, AUTHORITY_KEY, nil) end
  end
  return true
end

return worker
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local commissioningConfig = require("oc.ae2.maintainer_commissioning_config")
local authority = require("oc.ae2.maintainer_commissioning_authority")
local degraded = require("oc.ae2.maintainer_commissioning_degraded")
local fluidStockAuto = require("oc.ae2.fluid_stock_auto")
local fluidStockProfile = require("oc.ae2.fluid_stock_profile")
local control = require("oc.ae2.maintainer_daemon_control")
local editor = require("oc.ae2.workflow_editor")
local model = require("oc.ae2.workflow_model")
local policy = require("oc.ae2.maintainer_commissioning_policy")
local repairRecovery = require("oc.ae2.maintainer_commissioning_repair_recovery")
local worker = require("oc.ae2.maintainer_commissioning_worker")

local commissioning = {}

local function now(value)
  value = tonumber(value)
  if value and value == value and value >= 0 and value < math.huge then return value end
  local ok, stamp = pcall(computer.uptime)
  stamp = ok and tonumber(stamp) or nil
  return stamp and stamp == stamp and stamp >= 0 and stamp < math.huge and stamp or 0
end

local function reportFor(cfg, overrideReason)
  cfg = type(cfg) == "table" and cfg or daemonConfig.load()
  local state = tostring(cfg.commissioningState or "idle")
  return {
    action = "maintainer_commissioning_status",
    state = state,
    active = commissioningConfig.active(cfg),
    terminal = state == "idle" or state == "complete" or state == "blocked",
    completed = state == "complete",
    blocked = state == "blocked",
    serial = tonumber(cfg.commissioningSerial) or 0,
    reason = overrideReason or cfg.commissioningReason,
    source = cfg.commissioningSource,
    requestedAt = tonumber(cfg.commissioningRequestedAt),
    updatedAt = tonumber(cfg.commissioningUpdatedAt),
    deadlineAt = tonumber(cfg.commissioningDeadlineAt),
    hardDeadlineAt = tonumber(cfg.commissioningHardDeadlineAt),
    attempts = tonumber(cfg.commissioningAttempt) or 0,
    abortReason = cfg.commissioningAbortReason,
    pages = tonumber(cfg.commissioningPageCount) or 0,
    probes = tonumber(cfg.commissioningProbeCount) or 0,
    candidateIndex = tonumber(cfg.commissioningCandidateIndex) or 1,
    canaryFluid = cfg.commissioningCanaryFluid,
    topologyRevision = cfg.commissioningTopologyRevision,
    repairConfigIndex = tonumber(cfg.commissioningRepairIndex),
    repairWorkflowId = cfg.commissioningRepairWorkflowId,
    repairRecordId = cfg.commissioningRepairRecordId,
    degraded = (tonumber(cfg.commissioningDegradedCount) or 0) > 0,
    degradedCount = tonumber(cfg.commissioningDegradedCount) or 0,
    quarantinedRows = cfg.commissioningQuarantinedRows,
    quarantineWorkflowId = cfg.commissioningQuarantineWorkflowId,
    quarantineReason = cfg.commissioningQuarantineReason,
    priorDaemonEnabled = cfg.commissioningPriorDaemonEnabled,
    priorGlobalAutoEnabled = cfg.commissioningPriorGlobalAutoEnabled,
    intentBasis = cfg.commissioningIntentBasis,
    workerRunning = worker.isBrokerRunning()
  }
end

function commissioning.status()
  return reportFor(daemonConfig.load())
end

local function advance(cfg, state, fields, stamp)
  fields = type(fields) == "table" and fields or {}
  local ok, reason, saved = commissioningConfig.advance(
    cfg.commissioningSerial, cfg.commissioningState, state, fields, stamp)
  if not ok then return false, reason, reportFor(saved or daemonConfig.load()) end
  return true, nil, reportFor(saved)
end

local function block(cfg, reason, stamp)
  local ok, saveReason, saved = commissioningConfig.block(
    cfg.commissioningSerial, cfg.commissioningState, reason, stamp)
  local report = reportFor(saved or daemonConfig.load(), reason)
  if ok and report.state == "aborting" then return true, nil, report end
  return false, tostring(reason or saveReason or "commissioning blocked"), report
end

local function pending(cfg, reason, seconds, extra)
  local report = reportFor(cfg, reason)
  report.pending, report.retryable = true, true
  report.nextIn = math.max(0, tonumber(seconds) or 2)
  if type(extra) == "table" then
    for key, value in pairs(extra) do report[key] = value end
  end
  return true, nil, report
end

local function resetScan(cfg, reason, stamp, delay, fields)
  fields = type(fields) == "table" and fields or {}
  fields.commissioningReason = reason
  fields.commissioningEvidenceCursor = false
  fields.commissioningEvidenceGeneration = false
  fields.commissioningCandidateIndex = 1
  fields.commissioningCanaryFluid = false
  local ok, advanceReason, report = advance(cfg, "planning_fluid", fields, stamp)
  if ok and report and delay then
    report.pending, report.retryable, report.nextIn = true, true, delay
  end
  return ok, advanceReason, report
end

function commissioning.request(options)
  options = type(options) == "table" and options or {}
  local cfg = daemonConfig.load()
  if cfg.configReadFailed == true then
    return false, cfg.configReadError or "daemon config is unreadable", reportFor(cfg)
  end
  if commissioningConfig.active(cfg) then
    local report = reportFor(cfg)
    report.brokerWake, report.brokerWakeReason = worker.wake()
    return true, nil, report
  end
  if commissioningConfig.suppressBootRetry(cfg, options.source) then
    return true, nil, reportFor(cfg)
  end
  local snapshot, reason = policy.load()
  if not snapshot then return false, reason, reportFor(cfg, reason) end
  if cfg.commissioningState == "complete" and policy.desiredCurrent(snapshot.value, cfg) then
    return true, nil, reportFor(cfg, "GTNH 2.8.4 APIs already commissioned")
  end
  if cfg.maintenanceBrake == true and not worker.resumableMaintenance(cfg) then
    return false, "another maintenance transaction owns the brake",
      reportFor(cfg)
  end
  local intent, intentReason
  if cfg.commissioningState == "blocked" and options.rebaseIntent ~= true then
    intent, intentReason = policy.retainedIntent(cfg)
  else
    intent, intentReason = policy.captureIntent(snapshot, cfg)
  end
  if not intent then return false, intentReason, reportFor(cfg, intentReason) end
  local requested, requestReason, saved = commissioningConfig.request(intent,
    now(options.now), options.source, true)
  if not requested then return false, requestReason, reportFor(saved or cfg) end
  local report = reportFor(saved)
  report.brokerWake, report.brokerWakeReason = worker.wake()
  return true, nil, report
end

local function stepStopping(cfg, stamp)
  if authority.safeStopComplete(cfg) then
    return advance(cfg, "configuring_craft", {
      commissioningReason = "Maintainer stopped; configuring Craft API",
      commissioningExpectedDaemonGeneration = tonumber(cfg.generation)
    }, stamp)
  end
  local called, ok, reason = pcall(control.safeStop,
    { automatic = true, commissioningSerial = cfg.commissioningSerial })
  if not called then return block(cfg, "automatic Safe Stop crashed: " .. tostring(ok), stamp) end
  if ok ~= true then
    return pending(daemonConfig.load(), tostring(reason or "waiting for automatic Safe Stop"), 2)
  end
  return pending(daemonConfig.load(), "waiting for Maintainer ownership-zero proof", 1)
end

local function stepCraft(cfg, stamp)
  local ok, reason = editor.setCraftCompatibility(model.craftCompatibilityModes.legacyFiltered,
    { serial = cfg.commissioningSerial, purpose = "craft" })
  if ok ~= true then
    return pending(cfg, "Craft API convergence is waiting: " .. tostring(reason), 2)
  end
  return advance(cfg, "planning_fluid", {
    commissioningReason = "Craft API set; selecting exact fluid canary",
    commissioningEvidenceCursor = false, commissioningEvidenceGeneration = false,
    commissioningCandidateIndex = 1, commissioningPageCount = 0
  }, stamp)
end

local function stepPlan(cfg, stamp)
  local snapshot, loadReason = policy.load()
  if not snapshot then return pending(cfg, loadReason, 2) end
  local options, optionReason = degraded.planOptions(cfg, snapshot.value)
  if not options then return block(cfg, optionReason, stamp) end
  local reviewed = fluidStockProfile.targetSet(snapshot.value, cfg)
  local issue = degraded.repairIssue(reviewed, cfg, fluidStockAuto)
  if issue then
    local scope, scopeReason = degraded.nextSelectionScope(cfg, snapshot.value, issue)
    if not scope then return block(cfg, scopeReason, stamp) end
    return advance(cfg, "repair_probe", {
      commissioningReason = "capturing one CPU-bound repair identity",
      commissioningRepairIndex = issue.configIndex,
      commissioningRepairWorkflowId = issue.workflowId,
      commissioningRepairEpoch = scope.epoch,
      commissioningRepairScopeToken = scope.token,
      commissioningRepairRecordId = false, commissioningReconcileSerial = false,
      commissioningQuarantineCaptureId = false,
      commissioningQuarantineWorkflowId = false,
      commissioningQuarantineScopeToken = false
    }, stamp)
  end
  if policy.desiredCurrent(snapshot.value, cfg) then
    return advance(cfg, "restoring_policy", {
      commissioningReason = "Fluid Stock is current; restoring prior intent"
    }, stamp)
  end
  local plan, reason, details = fluidStockAuto.plan(snapshot.value, options)
  if not plan then
    if type(details) == "table" and details.primaryIssue then
      return block(cfg, reason or fluidStockProfile.exclusionReason(details), stamp)
    end
    if cfg.commissioningEvidenceGeneration ~= nil then
      return resetScan(cfg, "identity evidence changed; restarting canary scan",
        stamp, 2)
    end
    return pending(cfg, tostring(reason or "waiting for an exact Fluid Stock candidate"), 2)
  end
  local index = tonumber(cfg.commissioningCandidateIndex) or 1
  local candidate = plan.candidates and plan.candidates[index]
  if not candidate then
    if plan.nextCursor then
      return advance(cfg, "planning_fluid", {
        commissioningReason = "continuing the bounded fluid candidate ledger",
        commissioningEvidenceCursor = plan.nextCursor,
        commissioningEvidenceGeneration = plan.evidenceGeneration,
        commissioningCandidateIndex = 1,
        commissioningPageCount = (tonumber(cfg.commissioningPageCount) or 0) + 1
      }, stamp)
    end
    if plan.complete == true then
      return resetScan(cfg, "no positive canary yet; restarting exact scan", stamp, 30, {
        commissioningPageCount = (tonumber(cfg.commissioningPageCount) or 0) + 1
      })
    end
    return pending(cfg, plan.evidenceWarning or "waiting for identity evidence", 5)
  end
  return advance(cfg, "probing_fluid", {
    commissioningReason = "probing one exact AE2FC canary candidate",
    commissioningCanaryFluid = candidate
  }, stamp)
end

local function stepProbe(cfg, stamp)
  local snapshot, loadReason = policy.load()
  if not snapshot then return pending(cfg, loadReason, 2) end
  local options, optionReason = degraded.planOptions(cfg, snapshot.value)
  if not options then return block(cfg, optionReason, stamp) end
  local plan, reason = fluidStockAuto.plan(snapshot.value, options)
  if not plan then
    return resetScan(cfg, "exact canary plan changed; restarting its scan", stamp)
  end
  local index = tonumber(cfg.commissioningCandidateIndex) or 1
  local candidate = plan.candidates and plan.candidates[index]
  if candidate ~= cfg.commissioningCanaryFluid then
    return advance(cfg, "planning_fluid", {
      commissioningReason = "candidate changed; replanning exact canary",
      commissioningCanaryFluid = false
    }, stamp)
  end
  local positive, probeReason, proof = fluidStockAuto.probe(
    snapshot.value, candidate, plan.planToken)
  proof = type(proof) == "table" and proof or {}
  if positive == true then
    local count = tonumber(proof.count)
    if proof.method ~= "getItemInNetwork" or not count or count <= 0
        or count ~= math.floor(count) or proof.gridAddress == nil then
      return block(cfg, "positive canary proof contract is invalid", stamp)
    end
    return advance(cfg, "committing_fluid", {
      commissioningReason = "positive canary measured; committing profile",
      commissioningCanaryFluid = candidate,
      commissioningTopologyRevision = plan.revision,
      commissioningCanaryCount = count,
      commissioningCanaryMethod = proof.method,
      commissioningCanaryGrid = tostring(proof.gridAddress),
      commissioningCanaryObservedAt = stamp,
      commissioningProbeCount = (tonumber(cfg.commissioningProbeCount) or 0) + 1
    }, stamp)
  end
  if proof.transportFailure == true then
    return pending(cfg, tostring(probeReason or "exact canary transport unavailable"), 2)
  end
  return advance(cfg, "planning_fluid", {
    commissioningReason = "negative candidate; advancing canary scan",
    commissioningCandidateIndex = index + 1,
    commissioningCanaryFluid = false,
    commissioningProbeCount = (tonumber(cfg.commissioningProbeCount) or 0) + 1
  }, stamp)
end

local function recoveryStep(cfg, stamp, continuation, recoveryOnly)
  local ok, reason, saved, directive
  if continuation then
    ok, reason, saved, directive = repairRecovery.continue(cfg, stamp)
  else
    ok, reason, saved, directive = repairRecovery.run(cfg, stamp, recoveryOnly)
  end
  directive = type(directive) == "table" and directive or {}
  if directive.pending then
    return pending(saved or cfg, reason, directive.retryAfter,
      { repairState = directive.repairState })
  end
  if directive.blocked then return block(cfg, reason, stamp) end
  return ok, reason, reportFor(saved or daemonConfig.load())
end

local function restartPlanning(cfg, daemon, stamp)
  return advance(cfg, "planning_fluid", {
    commissioningReason = "wrapper repaired; restarting canary scan",
    commissioningExpectedDaemonGeneration = tonumber(daemon.generation),
    commissioningEvidenceCursor = false, commissioningEvidenceGeneration = false,
    commissioningCandidateIndex = 1, commissioningRepairIndex = false,
    commissioningRepairWorkflowId = false, commissioningRepairRecordId = false,
    commissioningReconcileSerial = false, commissioningAttempt = 0,
    commissioningAbortReason = false
  }, stamp)
end

local function stepRepairPreview(cfg, stamp)
  local daemon = daemonConfig.load()
  if authority.repairFinished(cfg, daemon) then return restartPlanning(cfg, daemon, stamp) end
  if daemon.identityReconcileState == "previewed" and authority.reconcileMatches(cfg, daemon) then
    return advance(cfg, "repair_confirm", {
      commissioningReason = "repair preview sealed; confirming automatically",
      commissioningReconcileSerial = daemon.identityReconcileSerial
    }, stamp)
  end
  local called, ok, reason, status = pcall(control.reconcileRecorded,
    authority.repairOptions(cfg, daemon, false))
  if not called then return block(cfg, "exact repair preview crashed: " .. tostring(ok), stamp) end
  if ok ~= true then return block(cfg, reason or "exact repair preview was rejected", stamp) end
  daemon = daemonConfig.load()
  if authority.repairFinished(cfg, daemon) then return restartPlanning(cfg, daemon, stamp) end
  if daemon.identityReconcileState ~= "previewed" or not authority.reconcileMatches(cfg, daemon) then
    return pending(cfg, "waiting for repair preview receipt", 1)
  end
  return advance(cfg, "repair_confirm", {
    commissioningReason = "repair preview sealed; confirming automatically",
    commissioningReconcileSerial = daemon.identityReconcileSerial
  }, stamp)
end

local function stepRepairConfirm(cfg, stamp)
  local daemon = daemonConfig.load()
  if authority.repairFinished(cfg, daemon) then return restartPlanning(cfg, daemon, stamp) end
  if authority.reconcileMatches(cfg, daemon) and (daemon.identityReconcileState == "braking"
      or daemon.identityReconcileState == "draining"
      or daemon.identityReconcileState == "zero_proven"
      or daemon.identityReconcileState == "committing") then
    return advance(cfg, "repair_wait", {
      commissioningReason = "selected repair is converging",
      commissioningAttempt = 0
    }, stamp)
  end
  local called, ok, reason = pcall(control.reconcileRecorded,
    authority.repairOptions(cfg, daemon, true))
  if not called or ok ~= true then
    local failed = daemonConfig.load()
    if failed.identityReconcileState == "failed_safe"
        and authority.reconcileMatches(cfg, failed) then
      return advance(cfg, "repair_wait", {
        commissioningReason = "repair failed safe; retrying automatically",
        commissioningAttempt = 0
      }, stamp)
    end
    if not called then return block(cfg, "exact repair confirmation crashed: " .. tostring(ok), stamp) end
    return block(cfg, reason or "exact repair confirmation was rejected", stamp)
  end
  return advance(cfg, "repair_wait", {
    commissioningReason = "selected repair is converging",
    commissioningAttempt = 0
  }, stamp)
end

local function stepRepairWait(cfg, stamp)
  local daemon = daemonConfig.load()
  if authority.repairFinished(cfg, daemon) then return restartPlanning(cfg, daemon, stamp) end
  if daemon.identityReconcileState == "failed_safe"
      and authority.reconcileMatches(cfg, daemon) then
    local claimed, claimReason, saved, exhausted = commissioningConfig.claimFailedRetry(
      cfg.commissioningSerial, cfg.commissioningState,
      daemon.identityReconcileReason, stamp)
    if not claimed then return false, claimReason, reportFor(saved) end
    if exhausted then return pending(saved,
      "retry cap reached; automatically stopping ownership before intent restoration", 0) end
    cfg = saved
    local options = authority.repairOptions(cfg, daemon, true)
    options.retry = true
    local called, ok, reason = pcall(control.reconcileRecorded, options)
    if not called or ok ~= true then
      return pending(daemonConfig.load(), tostring(called and reason or ok), 5)
    end
    return pending(daemonConfig.load(),
      "retrying exact selected repair from its durable receipt", 1)
  end
  if not authority.reconcileMatches(cfg, daemon) then
    return block(cfg, "identity reconciliation receipt changed outside commissioning", stamp)
  end
  local called, ok, reason = pcall(control.reconcileRecorded,
    authority.repairOptions(cfg, daemon, true))
  if not called then return block(cfg, "exact repair resume crashed: " .. tostring(ok), stamp) end
  if ok ~= true then return pending(cfg, tostring(reason or "waiting for exact repair"), 2) end
  return pending(daemonConfig.load(), "waiting for exact selected repair completion", 1)
end

local function stepAbort(cfg, stamp)
  if authority.safeStopComplete(cfg) then
    return advance(cfg, "restoring_policy", {
      commissioningReason = "abort Safe Stop complete; restoring prior intent"
    }, stamp)
  end
  local handling, detail, delay, current = worker.resumeAbortMaintenance(
    cfg, control, daemonConfig.load)
  if handling then return pending(current, detail, delay) end
  local called, ok, reason = pcall(control.safeStop,
    { automatic = true, commissioningSerial = cfg.commissioningSerial })
  if not called then
    return pending(cfg, "automatic abort Safe Stop crashed: " .. tostring(ok), 5)
  end
  return pending(daemonConfig.load(), ok == true
    and "automatic abort is waiting for ownership zero proof"
    or tostring(reason or "automatic abort Safe Stop is waiting"), ok == true and 1 or 5)
end

local function stepCommitFluid(cfg, stamp)
  local ok, reason, result = policy.commitProfile(cfg)
  if ok ~= true and type(result) == "table" and result.replan == true then
    return resetScan(cfg, "Fluid Stock authority changed before commit; replanning automatically", stamp, 2)
  end
  if ok ~= true then
    return pending(cfg, "Fluid Stock commit is waiting: " .. tostring(reason), 2)
  end
  return advance(cfg, "restoring_policy", {
    commissioningReason = "Fluid Stock profile commit verified; restoring prior operator intent"
  }, stamp)
end

local function stepRestorePolicy(cfg, stamp)
  local restored, reason, result = policy.restore(cfg)
  result = type(result) == "table" and result or {}
  if restored ~= true then
    if result.blocked == true then return block(cfg, reason, stamp) end
    return pending(cfg, tostring(reason), 2)
  end
  return advance(cfg, "restoring_daemon", {
    commissioningReason = "prior Global Auto and row arming restored; restoring daemon intent",
    commissioningExpectedDaemonGeneration = tonumber(result.generation)
  }, stamp)
end

local function stepRestoreDaemon(cfg, stamp)
  local restored, reason, result = policy.restoreDaemon(cfg)
  result = type(result) == "table" and result or {}
  if restored ~= true then
    if result.blocked then return block(cfg, reason, stamp) end
    return pending(cfg, tostring(reason), 2)
  end
  if cfg.commissioningAbortReason then
    return block(cfg, cfg.commissioningAbortReason, stamp)
  end
  return advance(cfg, "complete", {
    commissioningReason = degraded.completionReason(cfg, result.reason)
  }, stamp)
end

function commissioning.step(options)
  options = type(options) == "table" and options or {}
  local stamp, cfg = now(options.now), daemonConfig.load()
  local state = tostring(cfg.commissioningState or "idle")
  if not commissioningConfig.active(cfg) then return true, nil, reportFor(cfg) end
  local timely, deadlineReason, current = commissioningConfig.checkDeadline(cfg, stamp)
  cfg = current or cfg
  if timely ~= true then
    if state == "repair_probe" then return recoveryStep(cfg, stamp, false, true) end
    return block(cfg, deadlineReason, stamp)
  end
  if state == "requested" then
    if worker.resumableMaintenance(cfg)
        and cfg.identityReconcileState == "failed_safe" then
      local claimed, claimReason, saved, exhausted = commissioningConfig.claimFailedRetry(
        cfg.commissioningSerial, cfg.commissioningState,
        cfg.identityReconcileReason, stamp)
      if not claimed then return false, claimReason, reportFor(saved) end
      if exhausted then return pending(saved,
        "retry cap reached; automatically stopping ownership before intent restoration", 0) end
      cfg = saved
    end
    local handling, detail, delay, current = worker.resumePriorMaintenance(
      cfg, control, daemonConfig.load)
    if handling then return pending(current, detail, delay) end
    local snapshot, reason = policy.load()
    if not snapshot then return pending(cfg, reason, 2) end
    if policy.desiredCurrent(snapshot.value, cfg) then
      return advance(cfg, "restoring_policy", {
      commissioningReason = "compatibility current; restoring inherited intent",
        commissioningAttempt = 0
      }, stamp)
    end
    return advance(cfg, "stopping", {
      commissioningReason = "stopping Maintainer ownership before compatibility setup",
      commissioningAttempt = 0
    }, stamp)
  elseif state == "stopping" then return stepStopping(cfg, stamp)
  elseif state == "configuring_craft" then return stepCraft(cfg, stamp)
  elseif state == "planning_fluid" then return stepPlan(cfg, stamp)
  elseif state == "probing_fluid" then return stepProbe(cfg, stamp)
  elseif state == "repair_probe" then return recoveryStep(cfg, stamp, false, false)
  elseif state == "quarantining_repair" then return recoveryStep(cfg, stamp, true)
  elseif state == "repair_preview" then return stepRepairPreview(cfg, stamp)
  elseif state == "repair_confirm" then return stepRepairConfirm(cfg, stamp)
  elseif state == "repair_wait" then return stepRepairWait(cfg, stamp)
  elseif state == "committing_fluid" then return stepCommitFluid(cfg, stamp)
  elseif state == "aborting" then return stepAbort(cfg, stamp)
  elseif state == "restoring_policy" then return stepRestorePolicy(cfg, stamp)
  elseif state == "restoring_daemon" then return stepRestoreDaemon(cfg, stamp) end
  return block(cfg, "unsupported commissioning state: " .. state, stamp)
end

function commissioning.startBroker(options)
  return worker.startBroker(commissioning, options)
end

function commissioning.stopBroker(options)
  return worker.stopBroker(commissioning, options)
end

function commissioning.clearBrokerForTests() worker.clearBrokerForTests() end

return commissioning
-- Compact validators and status projection for durable reconciliation receipts. Kept separate
-- from daemon configuration so the hot config module stays below OpenOS's
-- 24 KiB source limit while malformed transaction state still fails closed.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local workflowId = require("oc.ae2.workflow_id")

local receipt = { maxOwners = 512 }

local function number(value, fallback, min, max)
  value = tonumber(value) or fallback
  value = math.floor(value)
  if value < min then value = min end
  if max and value > max then value = max end
  return value
end

local function optionalNumber(value)
  if value == nil then return nil end
  value = tonumber(value)
  if not value or value ~= value or value < 0 or value == math.huge then return nil end
  return value
end

local function index(value)
  value = tonumber(value)
  if not value or value < 1 or value ~= math.floor(value) or value == math.huge then return nil end
  return value
end

local function text(value, limit)
  if value == nil or value == false then return nil end
  value = tostring(value)
  if value == "" or #value > (limit or 192) then return nil end
  return value
end

local function fingerprint(value)
  value = text(value, 96)
  return value and value:match("^%d+:%x+:%x+$") and value or nil
end

function receipt.compactCounts(value)
  if type(value) ~= "table" then return nil end
  local out, count = {}, 0
  for key, raw in pairs(value) do
    local name, amount = tostring(key), tonumber(raw)
    if count < 24 and #name <= 40 and name:match("^[%w_]+$")
        and amount and amount == amount and amount >= 0 and amount < math.huge then
      out[name], count = math.floor(amount), count + 1
    end
  end
  return next(out) and out or nil
end

function receipt.compactPlanToken(value)
  if type(value) ~= "table" or (tonumber(value.version) ~= 1
      and tonumber(value.version) ~= 2) then return nil end
  local scope = tostring(value.scope or "")
  if scope ~= "all" and scope ~= "workflow" and scope ~= "selected_missing"
      and scope ~= "fleet" and scope ~= "selected" then return nil end
  local rawSnapshot, quiescedSnapshot = fingerprint(value.rawSnapshot), fingerprint(value.quiescedSnapshot)
  local outcomeDigest, recordDigest = fingerprint(value.outcomeDigest), fingerprint(value.recordDigest)
  local tokenDigest = fingerprint(value.tokenDigest)
  if not rawSnapshot or not quiescedSnapshot or not outcomeDigest or not recordDigest
      or not tokenDigest then return nil end
  local selectedWorkflowId = text(value.selectedWorkflowId, 32)
  local namespace = text(value.workflowNamespace, 96)
  if not workflowId.validNamespace(namespace) then return nil end
  if scope == "workflow" and not workflowId.valid(selectedWorkflowId) then return nil end
  local out = {
    version = tonumber(value.version), rawSnapshot = rawSnapshot, quiescedSnapshot = quiescedSnapshot,
    workflowNamespace = namespace, rawPresent = value.rawPresent == true,
    evidenceGeneration = number(value.evidenceGeneration, 0, 0), scope = scope,
    selectedWorkflowId = selectedWorkflowId, selectedConfigIndex = index(value.selectedConfigIndex),
    addObserved = value.addObserved == true, selectedRecordId = text(value.selectedRecordId, 64),
    outcomeDigest = outcomeDigest, outcomeCount = number(value.outcomeCount, 0, 0),
    recordDigest = recordDigest, recordCount = number(value.recordCount, 0, 0), tokenDigest = tokenDigest
  }
  if out.version == 2 then
    out.gridAddress = text(value.gridAddress, 128)
    out.cursor, out.nextCursor = text(value.cursor, 64), text(value.nextCursor, 64)
    out.batchCount = number(value.batchCount, 0, 0, 32)
    out.deferredCount = number(value.deferredCount, 0, 0)
    out.totalEvidence = optionalNumber(value.totalEvidence)
    out.scopeDigest, out.transactionId = fingerprint(value.scopeDigest), text(value.transactionId, 96)
    out.sealDigest = text(value.sealDigest, 96)
    out.afterSnapshot = value.afterSnapshot and fingerprint(value.afterSnapshot) or nil
    out.quiescedAfterSnapshot = value.quiescedAfterSnapshot
      and fingerprint(value.quiescedAfterSnapshot) or nil
    local hasPrior = value.priorGlobalAutoEnabled ~= nil
      or value.priorArmedBits ~= nil or value.priorWorkflowSignature ~= nil
      or value.priorWorkflowCount ~= nil
    if hasPrior then
      local priorCount = optionalNumber(value.priorWorkflowCount)
      local priorBits = type(value.priorArmedBits) == "string"
        and #value.priorArmedBits <= 128 and value.priorArmedBits or nil
      local priorSignature = text(value.priorWorkflowSignature, 96)
      if type(value.priorGlobalAutoEnabled) ~= "boolean" or priorCount == nil
          or priorCount ~= math.floor(priorCount) or priorCount > 512
          or priorBits == nil or not priorBits:match("^[0-9a-f]*$")
          or #priorBits ~= math.ceil(priorCount / 4)
          or priorSignature == nil or not priorSignature:match("^%x+$") then return nil end
      out.priorGlobalAutoEnabled = value.priorGlobalAutoEnabled
      out.priorArmedBits, out.priorWorkflowSignature = priorBits, priorSignature
      out.priorWorkflowCount = priorCount
    end
    if not out.gridAddress or not out.scopeDigest or not out.transactionId then return nil end
    if scope == "selected" and (not workflowId.valid(out.selectedWorkflowId)
        or not out.selectedConfigIndex or not codec.parseRecordId(out.selectedRecordId)) then return nil end
  end
  return out
end

local function preparationBody(value)
  if type(value) ~= "table" then return nil end
  local phase = value.phase == "sealed" and "sealed"
    or value.phase == "scanning" and "scanning" or nil
  local namespace, grid = text(value.namespace, 96), text(value.gridAddress, 128)
  local generation, policyDigest = optionalNumber(value.generation), fingerprint(value.policyDigest)
  local sealDigest = text(value.sealDigest, 96)
  if not phase or not workflowId.validNamespace(namespace) or not grid or generation == nil
      or not policyDigest or not sealDigest then return nil end
  local owners, ownerCount = {}, 0
  for id, plan in pairs(type(value.ownerPlans) == "table" and value.ownerPlans or {}) do
    ownerCount = ownerCount + 1
    if ownerCount > receipt.maxOwners or not workflowId.valid(id) or type(plan) ~= "table"
        or not codec.parseRecordId(plan.recordId)
        or type(plan.identityDigest) ~= "string"
        or not plan.identityDigest:match("^%x+$") or #plan.identityDigest > 96 then return nil end
    owners[id] = { recordId = plan.recordId, identityDigest = plan.identityDigest }
  end
  return { version = 1, phase = phase, namespace = namespace, gridAddress = grid,
    generation = math.floor(generation), policyDigest = policyDigest,
    cursor = phase == "scanning" and text(value.cursor, 64) or nil,
    sealDigest = sealDigest, totalEvidence = number(value.totalEvidence, 0, 0),
    ownerPlans = owners, counts = receipt.compactCounts(value.counts) or {},
    addObserved = value.addObserved ~= false }
end

local function preparationDigest(value)
  local function atom(item)
    item = tostring(item == nil and "" or item)
    return tostring(#item) .. ":" .. item
  end
  local parts = { atom(value.version), atom(value.phase), atom(value.namespace),
    atom(value.gridAddress), atom(value.generation), atom(value.policyDigest),
    atom(value.cursor), atom(value.sealDigest), atom(value.totalEvidence),
    atom(value.addObserved and 1 or 0) }
  local owners = {}; for id in pairs(value.ownerPlans or {}) do owners[#owners + 1] = id end
  table.sort(owners)
  for _, id in ipairs(owners) do
    local plan = value.ownerPlans[id]
    parts[#parts + 1] = "o" .. atom(id) .. atom(plan.recordId) .. atom(plan.identityDigest)
  end
  local counts = {}; for key in pairs(value.counts or {}) do counts[#counts + 1] = key end
  table.sort(counts)
  for _, key in ipairs(counts) do
    parts[#parts + 1] = "c" .. atom(key) .. atom(value.counts[key])
  end
  return codec.digestText(table.concat(parts, "|"))
end

function receipt.sealPreparation(value)
  local out = preparationBody(value)
  if not out then return nil end
  out.preparationDigest = preparationDigest(out)
  return out
end

function receipt.compactPreparation(value)
  local out = preparationBody(value)
  if not out or type(value.preparationDigest) ~= "string"
      or value.preparationDigest ~= preparationDigest(out) then return nil end
  out.preparationDigest = value.preparationDigest
  return out
end

-- Keep capture cadence ownership in the compact receipt helper so the hot
-- daemon-config module stays within OpenOS's 24 KiB source budget.
function receipt.armCapturePulse(out, untilAt, captureId, generation, namespace)
  local expiry = tonumber(untilAt)
  if not expiry or expiry <= 0 or expiry ~= expiry or expiry == math.huge then
    return false, "identity capture expiry is invalid"
  end
  local id = text(captureId, 96)
  if not id then return false, "identity capture ID is invalid" end
  generation = tonumber(generation)
  if not generation or generation < 0 or generation ~= math.floor(generation) then
    return false, "identity capture generation is invalid"
  end
  namespace = text(namespace, 96)
  if not namespace then return false, "identity capture namespace is invalid" end
  if out.identityCaptureNamespace and out.identityCaptureNamespace ~= namespace then
    return false, "identity capture namespace ownership changed"
  end
  local current = tonumber(out.identityCaptureGeneration) or 0
  if out.identityCaptureId and generation < current then
    return false, "newer identity capture pulse retained"
  end
  if out.identityCaptureId and generation == current then
    if out.identityCaptureId ~= id then
      return false, "identity capture pulse generation conflicts with another capture"
    end
    if (tonumber(out.identityCaptureUntil) or 0) <= 0 then
      return false, "completed identity capture pulse cannot be re-armed"
    end
    if tonumber(out.identityCaptureUntil) ~= expiry then
      return false, "identity capture pulse expiry conflicts with its ownership token"
    end
  end
  out.identityCaptureUntil = expiry
  out.identityCaptureId = id
  out.identityCaptureGeneration = generation
  out.identityCaptureNamespace = namespace
  return true
end

function receipt.clearCapturePulse(out, expectedUntil, expectedId,
    expectedGeneration, expectedNamespace)
  if expectedUntil == nil or expectedId == nil or expectedGeneration == nil
      or expectedNamespace == nil then
    return false, "identity capture clear requires the complete ownership token"
  end
  if expectedUntil ~= nil and tonumber(out.identityCaptureUntil) ~= tonumber(expectedUntil) then
    return false, "identity capture expiry changed; newer request retained"
  end
  if expectedId ~= nil and out.identityCaptureId ~= expectedId then
    return false, "identity capture ID changed; newer request retained"
  end
  if expectedGeneration ~= nil
      and tonumber(out.identityCaptureGeneration) ~= tonumber(expectedGeneration) then
    return false, "identity capture generation changed; newer request retained"
  end
  if expectedNamespace ~= nil and out.identityCaptureNamespace ~= expectedNamespace then
    return false, "identity capture namespace changed; newer request retained"
  end
  out.identityCaptureUntil = 0
  -- Retain the token as a namespace-local high-water mark. New User reset
  -- deliberately removes daemon config before issuing a new namespace.
  return true
end

-- Project every durable reconciliation field on every refresh, including nil,
-- so a completed or superseded receipt cannot leave stale UI authority behind.
function receipt.projectStatus(heartbeat, cfg)
  heartbeat.maintenanceBrake = cfg.maintenanceBrake == true
  heartbeat.maintenanceBrakeReason = cfg.maintenanceBrakeReason
  heartbeat.identityReconcileState = cfg.identityReconcileState or "idle"
  heartbeat.identityReconcileReason = cfg.identityReconcileReason
  heartbeat.identityReconcileCounts = cfg.identityReconcileCounts
  heartbeat.identityReconcileSerial = tonumber(cfg.identityReconcileSerial) or 0
  heartbeat.identityReconcileRequestId = cfg.identityReconcileRequestId
  heartbeat.identityReconcileConfigIndex = cfg.identityReconcileConfigIndex
  heartbeat.identityReconcileWorkflowId = cfg.identityReconcileWorkflowId
  heartbeat.identityReconcileRecordId = cfg.identityReconcileRecordId
  heartbeat.identityReconcileCursor = cfg.identityReconcileCursor
  heartbeat.identityReconcileNextCursor = cfg.identityReconcileNextCursor
  heartbeat.identityReconcileProcessed = tonumber(cfg.identityReconcileProcessed) or 0
  heartbeat.identityReconcileDeferred = tonumber(cfg.identityReconcileDeferred) or 0
  heartbeat.identityReconcileBatchCount = tonumber(cfg.identityReconcileBatchCount) or 0
  heartbeat.identityReconcileSealDigest = cfg.identityReconcileSealDigest
  heartbeat.identityReconcileOperation = cfg.identityReconcileOperation or "reconcile"
  heartbeat.identityReconcilePlanToken = cfg.identityReconcilePlanToken
  heartbeat.identityReconcilePreparation = cfg.identityReconcilePreparation
  heartbeat.identityReconcilePriorEnabled = cfg.identityReconcilePriorEnabled
  heartbeat.identityReconcileDaemonGeneration = tonumber(cfg.identityReconcileDaemonGeneration)
  heartbeat.identityReconcileCompletedAt = tonumber(cfg.identityReconcileCompletedAt)
  heartbeat.safeStopState = cfg.identityReconcileOperation == "safe_stop"
    and (cfg.identityReconcileState or "idle") or "idle"
  heartbeat.safeStopReason = cfg.identityReconcileOperation == "safe_stop"
    and cfg.identityReconcileReason or nil
  heartbeat.commissioningState = cfg.commissioningState or "idle"
  heartbeat.commissioningReason = cfg.commissioningReason
  heartbeat.commissioningSerial = tonumber(cfg.commissioningSerial) or 0
  heartbeat.commissioningSource = cfg.commissioningSource
  heartbeat.commissioningAttempt = tonumber(cfg.commissioningAttempt) or 0
  heartbeat.commissioningCanaryFluid = cfg.commissioningCanaryFluid
  heartbeat.commissioningRepairIndex = tonumber(cfg.commissioningRepairIndex)
  return heartbeat
end

-- A selected reconciliation that began with Maintainer OFF deliberately
-- stops its temporary worker after committing. If power is lost between the
-- complete-safe config write and recordStop(), the stable config and the last
-- durable lifecycle tick contain enough independent evidence to repair only
-- that missing stop acknowledgement. This validator is intentionally strict:
-- ordinary stale heartbeats, fleet work, Safe Stop, and prior-ON ownership can
-- never be converted into a stopped receipt here.
function receipt.recoverableStoppedGeneration(cfg, status, now)
  cfg, status = type(cfg) == "table" and cfg or {}, type(status) == "table" and status or {}
  now = tonumber(now)
  local daemonGeneration = tonumber(cfg.identityReconcileDaemonGeneration)
  local configGeneration = tonumber(cfg.generation)
  local token = type(cfg.identityReconcilePlanToken) == "table"
    and cfg.identityReconcilePlanToken or {}
  if cfg.identityReconcileState ~= "complete_safe"
      or cfg.identityReconcileOperation ~= "reconcile"
      or cfg.identityReconcilePriorEnabled ~= false
      or cfg.enabled == true or cfg.maintenanceBrake == true
      or token.version ~= 2 or token.scope ~= "selected"
      or not daemonGeneration or not configGeneration
      or configGeneration ~= daemonGeneration + 1 then
    return nil, "completed reconciliation is not a recoverable prior-OFF selected stop"
  end
  if tonumber(cfg.identityReconcileConfigIndex) ~= tonumber(token.selectedConfigIndex)
      or cfg.identityReconcileWorkflowId ~= token.selectedWorkflowId
      or cfg.identityReconcileRecordId ~= token.selectedRecordId then
    return nil, "completed reconciliation scope no longer matches its selected plan"
  end
  local requested = tonumber(cfg.identityReconcileRequestedAt)
  local confirmed = tonumber(cfg.identityReconcileConfirmedAt)
  local zero = tonumber(cfg.identityReconcileZeroProofAt)
  local completed = tonumber(cfg.identityReconcileCompletedAt)
  if not requested or not confirmed or not zero or not completed
      or requested < 0 or requested > confirmed or confirmed > zero or zero > completed then
    return nil, "completed reconciliation timestamps are incomplete or out of order"
  end
  local lastTick, startedAt = tonumber(status.lastTick), tonumber(status.startedAt)
  if status.readFailed == true or status.workerState ~= "running"
      or tonumber(status.generation) ~= daemonGeneration
      or not lastTick or not startedAt or lastTick < confirmed or startedAt > lastTick
      or not now or now < 0 or lastTick > now + 5 or lastTick > completed + 5 then
    return nil, "durable lifecycle state is not the exact post-brake worker generation"
  end
  if tonumber(status.queueCount) ~= 0 or tonumber(status.inFlightCount) ~= 0
      or tonumber(status.ownershipQuarantineCount) ~= 0
      or type(status.ownershipClaims) ~= "table" or #status.ownershipClaims ~= 0 then
    return nil, "durable Maintainer ownership is not proven empty"
  end
  return daemonGeneration
end

return receipt
-- Daemon-owned safety transaction for durable identity reconciliation.  The
-- submit brake is engaged before policy quiescence, so manual and automatic
-- request paths cannot race the zero-work proof.
local computer = require("computer")
local adapter = require("oc.ae2.adapter")
local maintainer = require("oc.ae2.maintainer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local requestWitness = require("oc.ae2.maintainer_requests_witness")
local maintainerState = require("oc.ae2.maintainer_state")

local reconcileDaemon = {}
local POLL_SECONDS = 2
local FAILED_SAFE_POLL_SECONDS = 600

local function reasonText(value, fallback)
  local kind = type(value)
  if kind == "string" then return value ~= "" and value or fallback end
  if kind == "number" or kind == "boolean" then return tostring(value) end
  if kind == "table" then
    for _, key in ipairs({ "reason", "error", "message", "code" }) do
      local nested = value[key]
      if type(nested) == "string" and nested ~= "" then return nested end
      if type(nested) == "number" or type(nested) == "boolean" then return tostring(nested) end
    end
  end
  return fallback or "operation failed without a textual reason"
end

local function clearPlan(plan)
  plan.queueReport, plan.queueHeadId, plan.queuePausedReason = nil, nil, nil
  plan.queuePhase, plan.queueCount, plan.queueTotal = "idle", 0, 0
  plan.queueReplanAt = nil
  plan.forcePending, plan.warming, plan.cache = false, false, nil
end

local function markQueueQuiesced(report, cfg)
  report.dispatch = type(report.dispatch) == "table" and report.dispatch or {}
  local dispatch = report.dispatch
  dispatch.queueQuiesced, dispatch.queueCount = true, 0
  dispatch.queuePhase, dispatch.queuePausedReason = "idle", false
  dispatch.refillSuppressed, dispatch.queueHeadId = false, false
  if cfg and cfg.identityReconcileOperation == "safe_stop" then
    dispatch.safeStopSerial = tonumber(cfg.identityReconcileSerial)
  end
end

local function hasActive(report)
  local dispatch = type(report) == "table" and report.dispatch or {}
  if (tonumber(dispatch.inFlightCount) or 0) > 0 then return true end
  for _, entry in ipairs(dispatch.entries or {}) do if entry.status == "in_flight" then return true end end
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if (attempt.state == "running" and (attempt.ok or attempt.started or attempt.pending))
        or attempt.pendingResult then return true end
  end
  return false
end

local function pendingLifecycle(report)
  if type(report) == "table" and type(report.requestAcks) == "table" and #report.requestAcks > 0 then
    return true
  end
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if attempt.pendingResult == true or attempt.persistencePending == true
        or attempt.outcomePersistencePending == true then return true end
  end
  return false
end

function reconcileDaemon.observeActiveOutputs(report, generation, now)
  local outputs = type(report) == "table" and type(report.status) == "table"
    and report.status.activeCrafts or nil
  if type(outputs) ~= "table" then return end
  local loaded, workflows = pcall(require, "oc.ae2.workflows")
  if not loaded or type(workflows) ~= "table"
      or type(workflows.observeStructuredCpuOutputs) ~= "function" then return end
  local primary = report.status.ae2Primary
  local called, ok, reason, observed = pcall(workflows.observeStructuredCpuOutputs, outputs, {
    observedAt = now, generation = generation,
    gridAddress = type(primary) == "table" and primary.address or nil
  })
  observed = called and ok == true and type(observed) == "table" and observed or {}
  report.status.identityEvidenceObserved = tonumber(observed.recorded) or 0
  report.status.identityEvidenceErrors = called and ok == true and 0 or #outputs
  if called and ok == true then
    report.status.identityEvidenceError = nil
  else
    report.status.identityEvidenceError = reasonText(called and reason or ok,
      "CPU identity evidence observation failed")
  end
  report.status.identityEvidenceOwnerError = observed.ownerError
end

-- Cheap witness pulse: adapter primary + CPU summary only. No storage,
-- craftables, stock cache, planning, or maintainer-state write is involved.
function reconcileDaemon.observeCpuWitness(generation, now)
  local primary, primaryReason = adapter.primary()
  if not primary then
    return false, reasonText(primaryReason, "CPU final-output scan unavailable: missing AE2 primary")
  end
  local report = { status = { ae2Primary = primary } }
  local called, ok, reason = pcall(requestWitness.refresh, report)
  if type(report.status.activeCrafts) == "table" then
    reconcileDaemon.observeActiveOutputs(report, generation, now)
  end
  if not called then
    return false, "CPU final-output scan failed: "
      .. reasonText(ok, "witness callback raised a structured error"), report.status
  end
  if ok ~= true then
    return false, reasonText(reason, "CPU final-output witness unavailable"), report.status
  end
  return true, nil, report.status
end

local function attachCpuWitness(report, generation, now)
  if type(report) ~= "table" then return false, "local lifecycle poll returned no report" end
  local called, ok, reason, status = pcall(reconcileDaemon.observeCpuWitness, generation, now)
  if type(status) == "table" then
    local merged = type(report.status) == "table" and report.status or {}
    for key, value in pairs(status) do merged[key] = value end
    report.status = merged
  end
  if not called then
    return false, "fresh AE2 CPU witness failed: "
      .. reasonText(ok, "witness callback raised a structured error")
  end
  if ok ~= true then return false, reasonText(reason, "fresh AE2 CPU witness unavailable") end
  if type(status) ~= "table" then return false, "fresh AE2 CPU witness returned no status" end
  return true
end

local function counts(report)
  if type(report) ~= "table" then return nil end
  local source = type(report.counts) == "table" and report.counts
    or type(report.summary) == "table" and report.summary or report
  local out = {}
  for key, value in pairs(source) do
    if type(key) == "string" and type(value) == "number" and value >= 0 then
      out[key] = math.floor(value)
    end
  end
  return next(out) and out or nil
end

local function settleRecordedAdd()
  local loaded, transaction = pcall(require, "oc.ae2.workflow_identity_add_transaction")
  if not loaded or type(transaction) ~= "table"
      or type(transaction.recoverPending) ~= "function" then
    return false, "recorded Add recovery authority is unavailable"
  end
  local called, ok, reason, report = pcall(transaction.recoverPending,
    { now = computer.uptime() })
  if not called then return false, tostring(ok) end
  if ok == true then return true end
  return false, tostring(reason or "recorded Add recovery failed"),
    type(report) == "table" and report.retryable == true
end

local function policyQuiescent()
  local loaded, workflows = pcall(require, "oc.ae2.workflows")
  if not loaded or type(workflows) ~= "table" or type(workflows.load) ~= "function" then
    return false, "cannot verify quiescent workflow policy: workflow config unavailable"
  end
  local called, workflow = pcall(workflows.load)
  if not called or type(workflow) ~= "table" then
    return false, "cannot verify quiescent workflow policy: workflow config unreadable"
  end
  local enabled = workflow.autoEnabled ~= false
  if type(workflows.autoEnabled) == "function" then
    local checked, value = pcall(workflows.autoEnabled, workflow)
    if not checked then return false, "cannot verify Global Auto OFF: " .. tostring(value) end
    enabled = value == true
  end
  if enabled then return false, "Global Auto turned on during identity reconciliation" end
  for _, row in ipairs(type(workflow.workflows) == "table" and workflow.workflows or {}) do
    if type(row) == "table" and row.armed == true then
      return false, "a workflow row was armed during identity reconciliation"
    end
  end
  return true, nil, workflow
end

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}; if seen[value] then return seen[value] end
  local out = {}; seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end

local function quiescePolicy(retried)
  local settled, settleReason, retryable = settleRecordedAdd()
  if not settled then return false, settleReason, retryable end
  local already = policyQuiescent()
  if already then return true end
  local loaded, store = pcall(require, "oc.ae2.workflow_store")
  if not loaded or type(store) ~= "table" or type(store.rawSnapshot) ~= "function"
      or type(store.saveRawSnapshot) ~= "function" then
    return false, "cannot atomically disable automation: workflow store unavailable"
  end
  local snapCalled, snapshot, snapshotReason = pcall(store.rawSnapshot)
  if not snapCalled or type(snapshot) ~= "table" or type(snapshot.value) ~= "table" then
    return false, "cannot atomically disable automation: "
      .. tostring(snapCalled and snapshotReason or snapshot)
  end
  local candidate = clone(snapshot.value)
  candidate.autoEnabled = false
  for _, row in ipairs(type(candidate.workflows) == "table" and candidate.workflows or {}) do
    if type(row) == "table" then row.armed = false end
  end
  local called, saved, reason = pcall(store.saveRawSnapshot, snapshot, candidate,
    function(decoded)
      if type(decoded) ~= "table" or decoded.autoEnabled ~= false then
        return false, "saved Global Auto authority is not off"
      end
      for _, row in ipairs(type(decoded.workflows) == "table" and decoded.workflows or {}) do
        if type(row) == "table" and row.armed == true then return false, "saved row remained armed" end
      end
      return true
    end, "identity_reconcile_quiesce")
  if not called or saved ~= true then
    if retried ~= true then return quiescePolicy(true) end
    return false, "cannot atomically disable automation: " .. tostring(called and reason or saved)
  end
  return policyQuiescent()
end

-- Safe Stop owns only this Maintainer's request lifecycle.  A foreign craft on
-- the shared grid cannot be a veto over stopping local submission ownership.
local function ownedLocalZero(report, durableQuarantineResolution)
  if type(report) ~= "table" then return false, "local lifecycle poll returned no report" end
  local dispatch = type(report.dispatch) == "table" and report.dispatch or {}
  if (tonumber(dispatch.queueCount) or 0) > 0 then return false, "queued work is still draining" end
  if (tonumber(dispatch.inFlightCount) or 0) > 0 or hasActive(report) then
    return false, "in-flight AE2 requests are still draining"
  end
  if not durableQuarantineResolution and (tonumber(dispatch.ownershipQuarantineCount) or 0) > 0 then
    return false, "uncertain request ownership is still quarantined"
  end
  if pendingLifecycle(report) then return false, "request lifecycle persistence is still settling" end
  return true
end

-- Recorded Reconcile mutates durable identity from CPU output evidence, so it
-- retains the stronger whole-grid quiescence proof.  Safe Stop never calls it.
local function gridZero(report)
  local status = type(report) == "table" and type(report.status) == "table" and report.status or nil
  local activeCrafts = status and status.activeCrafts or nil
  if type(activeCrafts) ~= "table" then
    return false, "active AE2 CPU finalOutput witness is unavailable"
  end
  if (tonumber(status.activeCraftFinalOutputErrors) or 0) > 0 then
    return false, "active AE2 CPU finalOutput witness has read errors"
  end
  if (tonumber(status.activeCraftBusyCpus) or 0) > 0 then
    return false, "active AE2 crafting CPU work is still draining"
  end
  if #activeCrafts > 0 then return false, "active AE2 CPU finalOutput work is still draining" end
  return true
end

local function durableZero(generation, confirmedAt, now, operation, serial)
  local ownershipCheck = type(maintainerState.manualOwnership) == "function"
    and maintainerState.manualOwnership or maintainerState.manualInFlight
  if type(ownershipCheck) ~= "function" then
    return false, "durable manual request ownership check unavailable"
  end
  local ownershipOptions = operation == "safe_stop" and { safeStopSerial = serial } or nil
  local called, manual, reason = pcall(ownershipCheck, now, ownershipOptions)
  if not called then return false, "durable manual request ownership check failed: " .. tostring(manual) end
  if manual == nil then return false, tostring(reason or "durable manual request ownership unreadable") end
  if manual == true then return false, "manual request ownership is still active" end
  local statusCalled, status = pcall(maintainerState.status, now)
  if not statusCalled or type(status) ~= "table" or status.readFailed == true then
    return false, "durable daemon ownership state unreadable: "
      .. tostring(statusCalled and (status.readError or status.lastError) or status)
  end
  if tonumber(status.generation) ~= tonumber(generation) or status.workerState ~= "running" then
    return false, "durable daemon ownership generation is not current"
  end
  local lastTick, confirmed = tonumber(status.lastTick), tonumber(confirmedAt) or 0
  local threshold = confirmed
  if confirmed > now then threshold = tonumber(status.startedAt) end
  if lastTick == nil or threshold == nil or lastTick < threshold then
    return false, "waiting for a post-brake durable lifecycle tick"
  end
  if (tonumber(status.ownershipQuarantineCount) or 0) > 0 then
    return false, "uncertain request ownership is still quarantined"
  end
  if (tonumber(status.queueCount) or 0) > 0 or (tonumber(status.inFlightCount) or 0) > 0
      or #(type(status.ownershipClaims) == "table" and status.ownershipClaims or {}) > 0 then
    return false, "durable request ownership is not zero"
  end
  return true
end

local function advance(cfg, state, reason, summary, now)
  if type(daemonConfig.advanceIdentityReconcile) ~= "function" then
    return false, "identity reconciliation receipt writer unavailable", cfg
  end
  local called, ok, writeReason, saved = pcall(daemonConfig.advanceIdentityReconcile,
    cfg.identityReconcileSerial, state, reason, summary, now)
  if not called then return false, tostring(ok), cfg end
  if ok ~= true then return false, tostring(writeReason or "receipt write rejected"), saved or cfg end
  return true, nil, saved or daemonConfig.load()
end

local function failSafe(cfg, reason, now, summary)
  local ok, writeReason, saved = advance(cfg, "failed_safe", tostring(reason), summary, now)
  return saved or cfg, ok and tostring(reason)
    or tostring(reason) .. "; receipt error: " .. tostring(writeReason)
end

local function commit(cfg, now)
  local settled, settleReason, retryable = settleRecordedAdd()
  if not settled then
    if retryable then return cfg, settleReason end
    return failSafe(cfg, settleReason, now)
  end
  local quiescent, reason = policyQuiescent()
  if not quiescent then return failSafe(cfg, reason, now) end
  if cfg.identityReconcileOperation == "safe_stop" then
    local storeLoaded, store = pcall(require, "oc.ae2.workflow_store")
    if not storeLoaded or type(store) ~= "table" or type(store.rawSnapshot) ~= "function" then
      return failSafe(cfg, "safe stop cannot inspect raw workflow authority", now)
    end
    local snapshotCalled, snapshot, snapshotReason = pcall(store.rawSnapshot)
    if not snapshotCalled or type(snapshot) ~= "table" or type(snapshot.value) ~= "table" then
      return failSafe(cfg, "safe stop cannot inspect raw workflow authority: "
        .. tostring(snapshotCalled and snapshotReason or snapshot), now)
    end
    if snapshot.value.identityMutationFence ~= nil then
      return failSafe(cfg, "safe stop cannot release a workflow mutation fence", now)
    end
    if cfg.identityReconcileState ~= "zero_proven"
        or type(daemonConfig.completeSafeStop) ~= "function" then
      return failSafe(cfg, "safe-stop zero-proof finalizer unavailable", now)
    end
    local called, ok, completeReason, saved = pcall(
      daemonConfig.completeSafeStop, cfg.identityReconcileSerial, now)
    if not called or ok ~= true then
      return failSafe(saved or cfg, tostring(called and completeReason or ok), now)
    end
    return saved, nil
  end
  if cfg.identityReconcileState == "zero_proven" then
    local ok, advanceReason, saved = advance(cfg, "committing", nil, nil, now)
    if not ok then return failSafe(saved or cfg, advanceReason, now) end
    cfg = saved
  end
  local loaded, backend = pcall(require, "oc.ae2.workflow_identity_reconcile")
  if not loaded or type(backend) ~= "table" or type(backend.reconcileAll) ~= "function" then
    return failSafe(cfg, "recorded identity reconciliation backend unavailable: " .. tostring(backend), now)
  end
  local receipt = { requestId = cfg.identityReconcileRequestId,
    serial = cfg.identityReconcileSerial, brakeSerial = cfg.maintenanceBrakeSerial,
    generation = tonumber(cfg.generation), zeroProofAt = cfg.identityReconcileZeroProofAt }
  local called, ok, backendReason, report = pcall(backend.reconcileAll, {
    confirm = true, addObserved = cfg.identityReconcileAddObserved ~= false,
    configIndex = cfg.identityReconcileConfigIndex,
    workflowId = cfg.identityReconcileWorkflowId,
    recordId = cfg.identityReconcileRecordId,
    daemonReceipt = receipt,
    expectedPlanToken = cfg.identityReconcilePlanToken, afterBrake = true
  })
  if not called then return failSafe(cfg, "recorded identity reconciliation failed: " .. tostring(ok), now) end
  if ok ~= true then
    return failSafe(cfg, tostring(backendReason or "recorded identity reconciliation rejected"), now, counts(report))
  end
  quiescent, reason = policyQuiescent()
  if not quiescent then return failSafe(cfg, reason, now) end
  if type(report) == "table" and type(report.continuation) == "table" then
    if type(daemonConfig.continueIdentityReconcile) ~= "function" then
      return failSafe(cfg, "Fleet continuation receipt writer unavailable", now) end
    local continued, continueReason, saved = daemonConfig.continueIdentityReconcile(
      cfg.identityReconcileSerial, report.continuation, nil, computer.uptime())
    if not continued then return failSafe(saved or cfg, continueReason, computer.uptime()) end
    return saved, nil
  end
  local completed, completeReason, saved = advance(
    cfg, "complete_safe", backendReason, counts(report), computer.uptime())
  if not completed then return failSafe(saved or cfg, completeReason, computer.uptime()) end
  return saved, nil
end

function reconcileDaemon.active(cfg)
  local state = tostring(cfg and cfg.identityReconcileState or "idle")
  return cfg and cfg.maintenanceBrake == true or state == "braking" or state == "draining"
    or state == "zero_proven" or state == "committing" or state == "failed_safe"
end

function reconcileDaemon.runTick(interval, plan, cfg)
  local now = computer.uptime()
  clearPlan(plan)
  if cfg.identityReconcileState == "failed_safe" then
    -- Failed-safe is a latched operator state, not an active drain. Retry and
    -- safe-stop wake events interrupt this slow deadline; no unchanged
    -- heartbeat/evidence writes are emitted while the brake is parked.
    return now + math.max(FAILED_SAFE_POLL_SECONDS, tonumber(interval) or 0), plan
  end
  if cfg.identityReconcileState == "zero_proven" or cfg.identityReconcileState == "committing" then
    local completed = commit(cfg, now)
    if type(completed) == "table" and completed.enabled == false then plan.stopCompleted = true end
    return computer.uptime() + POLL_SECONDS, plan
  end
  if cfg.identityReconcileState == "braking" then
    local quiesced, reason, retryable = quiescePolicy()
    if not quiesced then
      if not retryable then failSafe(cfg, reason, now) end
      return now + POLL_SECONDS, plan
    end
    local advanced, advanceReason, saved = advance(
      cfg, "draining", "polling existing request ownership", nil, now)
    if not advanced then
      failSafe(saved or cfg, "could not enter drain: " .. tostring(advanceReason), now)
      return now + POLL_SECONDS, plan
    end
    cfg = saved
  end
  if plan.pendingRecord then
    local held = plan.pendingRecord
    local recorded, reason = maintainerState.recordTick(
      held.report, interval, held.ok, held.err, now + POLL_SECONDS, plan.generation)
    if recorded == true then
      if held.ok and type(maintainer.acknowledge) == "function" then maintainer.acknowledge(held.report) end
      plan.pendingRecord = nil
      advance(cfg, "draining", "pre-brake lifecycle result persisted", nil, now)
    else
      advance(cfg, "draining", "durable pre-brake lifecycle write pending: "
        .. tostring(reason or "write rejected"), nil, now)
    end
    return now + POLL_SECONDS, plan
  end
  local called, report = pcall(maintainer.poll)
  local ok = called and type(report) == "table"
  local err = nil
  if not called then
    err = "local lifecycle poll failed: "
      .. reasonText(report, "poll callback raised a structured error")
  elseif not ok then
    err = "local lifecycle poll returned no report"
  end
  if ok then markQueueQuiesced(report, cfg) end
  local operation = tostring(cfg.identityReconcileOperation or "reconcile")
  local planToken = type(cfg.identityReconcilePlanToken) == "table"
    and cfg.identityReconcilePlanToken or {}
  -- A selected transaction is already bound to one immutable record, stable
  -- workflow ID, row index, and consequence digest. Foreign/player CPU jobs
  -- cannot change that authority and must not gain a denial-of-service veto.
  -- Fleet work may add any unclaimed observation, so it retains the wider
  -- evidence-quiescence gate until its sealed page semantics are narrowed.
  local selectedReconcile = operation == "reconcile" and planToken.scope == "selected"
  local needsGridZero = operation ~= "safe_stop" and not selectedReconcile
  local ownedZero, ownedReason = false, nil
  if ok then ownedZero, ownedReason = ownedLocalZero(report, operation == "safe_stop") end
  local witnessOk, witnessReason = not needsGridZero, nil
  if ok and needsGridZero then
    witnessOk, witnessReason = attachCpuWitness(report, plan.generation, now)
  end
  local recorded, recordReason = maintainerState.recordTick(
    report, interval, ok, err, now + POLL_SECONDS, plan.generation)
  if recorded ~= true then
    advance(cfg, "draining", "durable drain observation pending: "
      .. tostring(recordReason or err or "write rejected"), nil, now)
    return now + POLL_SECONDS, plan
  end
  if ok and type(maintainer.acknowledge) == "function" then maintainer.acknowledge(report) end
  local zero, reason = false, nil
  if not ok then
    reason = err
  elseif not ownedZero then
    reason = ownedReason
  elseif needsGridZero and not witnessOk then
    reason = witnessReason
  elseif needsGridZero then
    zero, reason = gridZero(report)
  else
    zero = true
  end
  if zero then
    zero, reason = durableZero(plan.generation, cfg.identityReconcileConfirmedAt, computer.uptime(),
      cfg.identityReconcileOperation, cfg.identityReconcileSerial)
  end
  if not zero then
    advance(cfg, "draining", reasonText(reason, "request ownership is draining"), nil, now)
    return now + POLL_SECONDS, plan
  end
  local proven, proofReason, provenCfg = advance(cfg, "zero_proven", nil, nil, computer.uptime())
  if not proven then
    failSafe(provenCfg or cfg, "zero-proof receipt failed: " .. tostring(proofReason), computer.uptime())
    return computer.uptime() + POLL_SECONDS, plan
  end
  local completed = commit(provenCfg, computer.uptime())
  if type(completed) == "table" and completed.enabled == false then plan.stopCompleted = true end
  return computer.uptime() + POLL_SECONDS, plan
end

return reconcileDaemon
local computer = require("computer")
local event = require("event")
local budget = require("oc.ae2.budget")
local chunkAdapt = require("oc.ae2.chunk_adapt")
local maintainer = require("oc.ae2.maintainer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local identityReconcile = require("oc.ae2.maintainer_identity_reconcile_daemon")
local maintainerMemory = require("oc.ae2.maintainer_memory")
local maintainerState = require("oc.ae2.maintainer_state")
local stockMemory = require("oc.ae2.stock_memory")

local daemon = {}
local DEFAULT_TARGET_LIMIT = 16
local DEFAULT_CHUNK_DELAY = 2
local DEFAULT_QUEUE_STEP_DELAY = 0.1
local DEFAULT_QUEUE_CPU_POLL = 2
local LEGACY_TRAVERSAL_GAP = 2
local REQUEST_STATUS_POLL = 2
local STOCK_REFRESH_MARGIN = 10
local IDENTITY_WITNESS_IDLE = 10
local IDENTITY_WITNESS_CAPTURE = 2

local function clampFallback(value, fallback, min, max)
  value = tonumber(value) or fallback
  value = math.floor(value)
  if value < min then value = min end
  if max and value > max then value = max end
  return value
end

local function clampInterval(value, fallback)
  if daemonConfig.clampInterval then return daemonConfig.clampInterval(value, fallback) end
  return clampFallback(value, fallback or 600, 600, 604800)
end

local function clampPollInterval(value, fallback)
  if daemonConfig.clampPollInterval then return daemonConfig.clampPollInterval(value, fallback) end
  return clampFallback(value, fallback or 600, 600, 3600)
end

local function configured(options)
  local cfg = daemonConfig.load()
  options = options or {}
  if options.generation ~= nil then
    local expected = tonumber(options.generation)
    if cfg.enabled ~= true or expected == nil or tonumber(cfg.generation) ~= expected then
      return nil, "daemon generation revoked before worker start"
    end
    return cfg
  end
  if options.interval then cfg.interval = clampInterval(options.interval, cfg.interval) end
  if options.pollInterval then cfg.pollInterval = clampPollInterval(options.pollInterval, cfg.pollInterval) end
  if options.enabled ~= false then
    cfg.enabled = true
    cfg.generation = (tonumber(cfg.generation) or 0) + 1
  end
  daemonConfig.save(cfg)
  return daemonConfig.load()
end

local function planningState(options)
  options = options or {}
  local targetLimit = math.max(1, math.floor(tonumber(options.targetLimit) or DEFAULT_TARGET_LIMIT))
  local maxSubmitsPerCycle = tonumber(options.maxSubmitsPerCycle)
  if maxSubmitsPerCycle ~= nil then maxSubmitsPerCycle = math.max(0, math.floor(maxSubmitsPerCycle)) end
  return {
    targetLimit = targetLimit,
    baseTargetLimit = targetLimit,
    chunkDelay = math.max(0.1, tonumber(options.chunkDelay) or DEFAULT_CHUNK_DELAY),
    queueStepDelay = math.max(0.1, tonumber(options.queueStepDelay) or DEFAULT_QUEUE_STEP_DELAY),
    queueCpuPoll = math.max(0.5, tonumber(options.queueCpuPoll) or DEFAULT_QUEUE_CPU_POLL),
    maxSubmitsPerCycle = maxSubmitsPerCycle,
    generation = tonumber(options.generation),
    queueReport = nil,
    queuePhase = "idle",
    queuePausedReason = nil,
    queueHeadId = nil,
    queueCount = 0,
    queueTotal = 0,
    queueReplanAt = nil,
    pendingRecord = nil,
    forcePending = false,
    warming = false
  }
end

local function hasActiveRequests(report)
  local dispatch = type(report) == "table" and report.dispatch or {}
  if (tonumber(dispatch.inFlightCount) or 0) > 0 then return true end
  for _, entry in ipairs(dispatch.entries or {}) do
    if entry.status == "in_flight" then return true end
  end
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if (attempt.state == "running" and (attempt.ok or attempt.started or attempt.pending)) or attempt.pendingResult then return true end
  end
  return false
end

local function hasPendingAcks(report)
  return type(report) == "table" and type(report.requestAcks) == "table" and #report.requestAcks > 0
end

local function hasPendingPersistence(report)
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if attempt.pendingResult == true or attempt.persistencePending == true then return true end
  end
  return false
end

local function hasPendingOutcome(report)
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if attempt.outcomePersistencePending == true then return true end
  end
  return false
end

local function idleReport()
  return {
    message = "idle heartbeat; no in-flight requests",
    dispatch = {
      entries = {},
      queueCount = 0,
      inFlightCount = 0,
      availableSlots = 0,
      maxSubmits = 0,
      pollOnly = true,
      idle = true
    },
    targets = {}
  }
end

local function budgetReport(info)
  return {
    message = "AE2 budget cooling down; planning deferred",
    status = { mode = "armed", complete = false },
    dispatch = {
      entries = {},
      queueCount = 0,
      inFlightCount = 0,
      availableSlots = 0,
      maxSubmits = 0,
      budgetHeld = true,
      nextBudgetIn = info and info.wait
    },
    targets = {}
  }
end

local function usedLegacyCraftTraversal(report)
  for _, attempt in ipairs((type(report) == "table" and report.requestAttempts) or {}) do
    if attempt.legacyCraftTraversal == true or (tonumber(attempt.compatibilityCalls) or 0) > 0 then return true end
  end
  local attempt = type(report) == "table" and report.requestAttempt
  return attempt and (attempt.legacyCraftTraversal == true or (tonumber(attempt.compatibilityCalls) or 0) > 0) or false
end

local function nextEligibleCycle(report, now, interval)
  local dispatch = type(report) == "table" and report.dispatch or {}
  local best = nil
  for _, entry in ipairs(dispatch.entries or {}) do
    local eligibleAt = tonumber(entry.nextEligibleAt)
    if entry.status == "blocked" and eligibleAt and eligibleAt > now and eligibleAt < now + interval then
      best = best and math.min(best, eligibleAt) or eligibleAt
    end
  end
  return best
end

local function nextStockRefreshCycle(report, now, interval)
  local best = nil
  for _, row in ipairs((type(report) == "table" and report.targets) or {}) do
    local source = row.stockMemorySource
    local maxAge = tonumber(source and stockMemory.sourceMaxAges[source])
    local observedAt = tonumber(row.stockMemoryAt)
    if maxAge and observedAt and row.stockMemoryFresh == true then
      -- Re-read strict-lifetime stock before it expires. The configured plan
      -- interval remains the upper bound for ordinary item/native-fluid rows.
      local due = observedAt + math.max(0.1, maxAge - STOCK_REFRESH_MARGIN)
      if due <= now then due = now + 0.1 end
      if due < now + interval then best = best and math.min(best, due) or due end
    end
  end
  return best
end

local function latestAttempt(report)
  local attempts = type(report) == "table" and report.requestAttempts or nil
  return attempts and attempts[#attempts] or type(report) == "table" and report.requestAttempt or nil
end

local function knownNonConsumingAttempt(report)
  local attempt = latestAttempt(report)
  if not attempt then return false end
  if attempt.pendingResult == true or attempt.persistencePending == true then return false end
  if attempt.queueAdvance ~= nil then return attempt.queueAdvance == true end
  local phase = tostring(attempt.phase or "")
  if phase == "status_link_lost" or phase == "daemon_authority"
      or phase == "request_result" or phase == "cpu_final_output_scan" then
    return false
  end
  return attempt.done == true or attempt.state == "done" or attempt.state == "failed"
    or attempt.state == "canceled" or attempt.state == "blocked"
end

local function clearFrozenQueue(plan)
  plan.queueReport, plan.queueHeadId, plan.queuePausedReason = nil, nil, nil
  plan.queuePhase, plan.queueCount, plan.queueTotal = "idle", 0, 0
  plan.queueReplanAt = nil
end

local function scheduleFrozenQueue(plan, report, now, interval, queueStep)
  local dispatch = type(report) == "table" and report.dispatch or {}
  if report and (report.queueInvalidated == true or dispatch.queueInvalidated == true) then
    clearFrozenQueue(plan)
    plan.queuePhase = "planning"
    plan.forcePending = false
    plan.cache, plan.warming = nil, false
    return now + plan.queueStepDelay, false
  end
  local queued = math.max(0, tonumber(dispatch.queueCount) or 0)
  if queued <= 0 and not hasPendingOutcome(report) then
    local quarantined = math.max(0, tonumber(dispatch.ownershipQuarantineCount) or 0)
    clearFrozenQueue(plan)
    if quarantined > 0 and tonumber(dispatch.ownershipRetryAt)
        and tonumber(dispatch.ownershipRetryAt) > now then
      plan.queuePhase = "waiting_retry"
    end
    return nil, false
  end
  local alreadyFrozen = plan.queueReport ~= nil
  local previousHeadId, previousCount = plan.queueHeadId, plan.queueCount
  if not alreadyFrozen then plan.queueReplanAt = now + interval end
  plan.queueReport = report
  plan.queueCount = queued
  plan.queueTotal = math.max(tonumber(plan.queueTotal) or 0, queued)
  plan.queueHeadId = dispatch.queueHeadId ~= false and dispatch.queueHeadId or nil
  if dispatch.witnessHeld == true then
    plan.queuePhase = "paused_witness"
    plan.queuePausedReason = dispatch.queuePausedReason or "CPU final-output witness unavailable"
    return now + plan.queueCpuPoll, true
  end
  if dispatch.submitCapHeld == true then
    plan.queuePhase = "paused_policy"
    plan.queuePausedReason = dispatch.queuePausedReason or "automatic submit cap is zero"
    return now + interval, true
  end
  if dispatch.waitingForSettlement == true then
    plan.queuePhase = "paused_settlement"
    plan.queuePausedReason = dispatch.queuePausedReason or "uncertain ownership reservation settling"
    return now + plan.queueCpuPoll, true
  end
  if hasPendingPersistence(report) then
    plan.queuePhase = "paused_lifecycle"
    plan.queuePausedReason = dispatch.queuePausedReason or "waiting for terminal request result persistence"
    return now + plan.queueCpuPoll, true
  end
  if usedLegacyCraftTraversal(report) then
    plan.queuePhase = "paused_legacy"
    plan.queuePausedReason = "GTNH 2.8.4 Craft API traversal cooldown"
    return now + LEGACY_TRAVERSAL_GAP, true
  end
  local slots = tonumber(dispatch.remainingSlots)
  if slots == nil then slots = tonumber(dispatch.availableSlots) or 0 end
  local nonConsuming = knownNonConsumingAttempt(report)
  if slots > 0 or nonConsuming then
    local attempt = latestAttempt(report)
    -- The 0.1-second lane is for proven transitions, not repeated calls on an
    -- unchanged head. A consumed slot or explicit queueAdvance is progress;
    -- anything else gets the same bounded two-second observation cadence.
    local noProgress = queueStep == true and previousHeadId == plan.queueHeadId
      and previousCount == queued and nonConsuming ~= true
      and not (attempt and attempt.capacityConsumed == true)
    if noProgress then
      plan.queuePhase = "paused_no_progress"
      plan.queuePausedReason = "queue head made no progress; retrying safely"
      return now + plan.queueCpuPoll, true
    end
    plan.queuePhase, plan.queuePausedReason = "draining", nil
    return now + plan.queueStepDelay, true
  end
  plan.queuePhase = "paused_cpu"
  plan.queuePausedReason = dispatch.queuePausedReason or "waiting for an available crafting CPU"
  local cpuPollAt = now + plan.queueCpuPoll
  local replanAt = tonumber(plan.queueReplanAt)
  if replanAt and replanAt <= now then return now + plan.queueStepDelay, true end
  return replanAt and math.min(cpuPollAt, replanAt) or cpuPollAt, true
end

local function nextPlanningCycle(plan, report, now, interval)
  if plan.forcePending then
    plan.forcePending = false
    return now + plan.queueStepDelay
  end
  local eligible = nextEligibleCycle(report, now, interval)
  local stockRefresh = nextStockRefreshCycle(report, now, interval)
  if stockRefresh then eligible = eligible and math.min(eligible, stockRefresh) or stockRefresh end
  return eligible or (now + interval)
end

local function annotateQueue(report, plan)
  if type(report) ~= "table" then return end
  report.dispatch = type(report.dispatch) == "table" and report.dispatch or {}
  local dispatch = report.dispatch
  dispatch.queuePhase = plan.queuePhase
  dispatch.queuePausedReason = plan.queuePausedReason or false
  dispatch.refillSuppressed = plan.queueReport ~= nil
  dispatch.queueHeadId = plan.queueHeadId or false
  dispatch.queueTotal = plan.queueTotal
end

local function runTick(nextCycle, interval, plan)
  local now = computer.uptime()
  if plan.pendingRecord then
    local held = plan.pendingRecord
    annotateQueue(held.report, plan)
    local resumeAt = tonumber(held.nextCycle) or (now + plan.queueStepDelay)
    if resumeAt <= now then resumeAt = now + plan.queueStepDelay end
    if hasActiveRequests(held.report) or hasPendingPersistence(held.report) or hasPendingOutcome(held.report) then
      if plan.queueReport ~= nil then resumeAt = math.min(resumeAt, now + plan.queueCpuPoll)
      else resumeAt = math.max(resumeAt, now + interval) end
    end
    local recorded = maintainerState.recordTick(held.report, interval, held.ok, held.err, resumeAt, plan.generation)
    if recorded == true then
      if held.ok and type(maintainer.acknowledge) == "function" then maintainer.acknowledge(held.report) end
      plan.pendingRecord = nil
      plan.queuePhase, plan.queuePausedReason = held.queuePhase, held.queuePausedReason
      plan.pollActive = held.ok and hasActiveRequests(held.report)
      return resumeAt, plan
    end
    plan.pollActive = true
    return now + plan.queueCpuPoll, plan
  end
  local due = now >= nextCycle
  local refreshPausedCpu = due and plan.queueReport ~= nil and plan.queuePhase == "paused_cpu"
    and tonumber(plan.queueReplanAt) ~= nil and now >= tonumber(plan.queueReplanAt)
  local queueStep = due and plan.queueReport ~= nil and not refreshPausedCpu
  local planning = due and (plan.queueReport == nil or refreshPausedCpu)
  local pollWasActive = plan.pollActive == true
  if planning or queueStep then
    local kind = queueStep and "queue_dispatch"
      or plan.warming and "warm_continuation" or "daemon_dispatch"
    local budgetOk, budgetInfo = budget.trySpend(kind, { now = now })
    if not budgetOk then
      nextCycle = now + math.max(0.1, tonumber(budgetInfo.wait) or 1)
      local held = budgetReport(budgetInfo)
      if plan.queueReport then held.dispatch.pollOnly = true end
      annotateQueue(held, plan)
      maintainerState.recordTick(held, interval, true, nil, nextCycle, plan.generation)
      return nextCycle, plan
    end
  end
  if refreshPausedCpu then
    -- A capacity-starved frozen queue remains authoritative between checks,
    -- but it must not prevent the ordinary bounded planner from discovering
    -- changed stock or newly eligible targets forever. Tracker/CPU witnesses
    -- in maintainer.run still reserve live jobs, and only this planner branch
    -- executes at the interval boundary, so no stale resume races the refill.
    clearFrozenQueue(plan)
    plan.queuePhase = "planning"
  end
  local cursorBefore = plan.cache and plan.cache.targetCursor or 1
  local targetLimit = planning and chunkAdapt.limit(plan, "Daemon", {
    base = plan.baseTargetLimit,
    reset = not plan.warming
  }) or plan.targetLimit
  local runOptions = planning and {
    skipObserveSnapshot = true,
    targetLimit = targetLimit,
    cache = plan.cache,
    restart = not plan.warming,
    maxSubmitsPerCycle = plan.maxSubmitsPerCycle,
    daemonGeneration = plan.generation,
    requireFinalOutputWitness = true,
    deferPostSubmitWitness = true
  } or nil
  local ok, report
  local startedAt = computer.uptime()
  if planning then ok, report = pcall(maintainer.run, runOptions)
  elseif queueStep then
    ok, report = pcall(maintainer.resumeQueue, plan.queueReport, {
      maxSubmitsPerCycle = plan.maxSubmitsPerCycle,
      daemonGeneration = plan.generation,
      requireFinalOutputWitness = true,
      deferPostSubmitWitness = true
    })
  elseif plan.pollActive then ok, report = pcall(maintainer.poll)
  else ok, report = true, idleReport() end
  local err = nil
  if not ok then err = report end
  if ok then identityReconcile.observeActiveOutputs(report, plan.generation, computer.uptime()) end
  if planning then
    if ok and type(report) == "table" then plan.cache = report.cache or plan.cache end
    local warming = ok and type(report) == "table" and report.status
      and report.status.complete == false and report.cache
    plan.warming = warming and true or false
    if ok then maintainerMemory.remember(report) end
    local status = chunkAdapt.record(plan, "Daemon", {
      base = plan.baseTargetLimit,
      targetLimit = targetLimit,
      duration = math.max(0, computer.uptime() - startedAt),
      ok = ok,
      timeout = not ok,
      complete = ok and type(report) == "table" and report.status and report.status.complete == true,
      cursorBefore = cursorBefore,
      cursorAfter = plan.cache and plan.cache.targetCursor
    })
    plan.targetLimit = status.nextLimit
    local after = computer.uptime()
    if warming then
      plan.queuePhase = "planning"
      nextCycle = after + plan.chunkDelay
    elseif ok then
      local queueCycle = scheduleFrozenQueue(plan, report, after, interval, false)
      if queueCycle then
        nextCycle = queueCycle
      else
        nextCycle = nextPlanningCycle(plan, report, after, interval)
      end
    else
      clearFrozenQueue(plan)
      nextCycle = after + interval
    end
  elseif queueStep then
    local after = computer.uptime()
    if ok then
      plan.cache = type(report) == "table" and report.cache or plan.cache
      maintainerMemory.remember(report)
      local queueCycle = scheduleFrozenQueue(plan, report, after, interval, true)
      if queueCycle then
        nextCycle = queueCycle
      else
        nextCycle = nextPlanningCycle(plan, report, after, interval)
      end
    else
      plan.queuePhase = "paused_cpu"
      plan.queuePausedReason = "queue step failed: " .. tostring(err)
      nextCycle = after + plan.queueCpuPoll
    end
  end
  annotateQueue(report, plan)
  local recorded, recordReason = maintainerState.recordTick(report, interval, ok, err, nextCycle, plan.generation)
  if recorded ~= true and ok and (plan.queueReport ~= nil or latestAttempt(report) ~= nil or hasPendingAcks(report)) then
    plan.pendingRecord = { report = report, ok = ok, err = err, nextCycle = nextCycle,
      queuePhase = plan.queuePhase, queuePausedReason = plan.queuePausedReason }
    plan.queuePhase, plan.queuePausedReason = "paused_lifecycle",
      "durable queue state write failed; retrying before queue advance: " .. tostring(recordReason or "write rejected")
    annotateQueue(report, plan)
    plan.pollActive = true
    return computer.uptime() + plan.queueCpuPoll, plan
  end
  -- A rejected durable write retains terminal tracker rows, so keep the short
  -- poll cadence until the same lifecycle result is safely persisted + acked.
  plan.pollActive = ok and (hasActiveRequests(report) or (recorded ~= true and hasPendingAcks(report))
    or (planning and pollWasActive))
  if recorded and ok and type(maintainer.acknowledge) == "function" then maintainer.acknowledge(report) end
  return nextCycle, plan
end

function daemon.run(options)
  options = options or {}
  local cfg, configReason = configured(options)
  if not cfg then return false, configReason end
  local interval = cfg.interval
  local generation = cfg.generation
  local firstDelay = options.deferFirstTick and math.max(0.1, tonumber(options.deferSeconds) or 1) or 0
  local nextCycle = computer.uptime() + firstDelay
  local plan = planningState(options)
  plan.generation = generation
  plan.nextIdentityWitnessAt = computer.uptime()
  local startRecorded = false
  local ran, runError = pcall(function()
    local recorded, recordReason, startState = maintainerState.recordStart(interval, nextCycle, generation)
    local ownsStart = recorded == true and type(startState) == "table"
      and tonumber(startState.generation) == tonumber(generation)
      and startState.workerState == "running"
    if not ownsStart then
      error("daemon start state persistence failed: "
        .. tostring(recordReason or "durable start ownership not confirmed"), 0)
    end
    startRecorded = true
    while cfg.enabled and cfg.generation == generation do
      cfg = daemonConfig.load()
      interval = cfg.interval
      if not cfg.enabled or cfg.generation ~= generation then break end
      local forced, _, forcedCfg = daemonConfig.consumeForce(generation)
      if forced then
        cfg = forcedCfg or cfg
        interval = cfg.interval
        -- A frozen queue already owns its exact next transition. Next Batch
        -- Now may wake idle planning, but cannot collapse CPU/legacy fences or
        -- create a second refill path while queued work is draining.
        if plan.queueReport == nil then nextCycle = 0 else plan.forcePending = true end
      end
      local reconciliationActive = identityReconcile.active(cfg)
      if reconciliationActive then
        nextCycle, plan = identityReconcile.runTick(interval, plan, cfg)
      else
        nextCycle, plan = runTick(nextCycle, interval, plan)
      end
      local witnessNow = computer.uptime()
      local captureActive = tonumber(cfg.identityCaptureUntil) ~= nil
        and tonumber(cfg.identityCaptureUntil) > witnessNow
      local witnessCadence = captureActive and IDENTITY_WITNESS_CAPTURE or IDENTITY_WITNESS_IDLE
      if captureActive and tonumber(plan.nextIdentityWitnessAt) > witnessNow + witnessCadence then
        plan.nextIdentityWitnessAt = witnessNow
      end
      if not reconciliationActive
          and witnessNow >= (tonumber(plan.nextIdentityWitnessAt) or 0) then
        pcall(identityReconcile.observeCpuWitness, generation, witnessNow)
        plan.nextIdentityWitnessAt = computer.uptime() + witnessCadence
      end
      if plan.stopCompleted == true then break end
      local wait = math.min(cfg.pollInterval, math.max(0.1, nextCycle - computer.uptime()))
      if not reconciliationActive then
        wait = math.min(wait, math.max(0.1,
          (tonumber(plan.nextIdentityWitnessAt) or computer.uptime()) - computer.uptime()))
      end
      if plan.pollActive then wait = math.min(wait, REQUEST_STATUS_POLL) end
      local _, timerCommand = event.pull(wait, "oc_ae2_daemon_timer")
      if timerCommand == "force" then
        if plan.queueReport == nil then nextCycle = 0 else plan.forcePending = true end
      elseif timerCommand == "identity_capture" then
        plan.nextIdentityWitnessAt = 0
      end
    end
  end)
  local finalOk, finalConfig = pcall(daemonConfig.load)
  local stopReason = not ran and "worker_error" or not finalOk and "config_error"
    or finalConfig.enabled ~= true and "desired_off"
    or tonumber(finalConfig.generation) ~= tonumber(generation) and "generation_replaced" or "worker_exit"
  if startRecorded then pcall(maintainerState.recordStop, generation, stopReason) end
  if not ran then return false, tostring(runError) end
  if not finalOk then return false, tostring(finalConfig) end
  return true
end

return daemon
local computer = require("computer")
local state = require("oc.ae2.maintainer_state")

local memory = { report = nil }

function memory.remember(report)
  if type(report) == "table" and report.status and report.status.complete == true then
    -- Never retain AE2 component proxies, Craftable handles, or chunk caches
    -- in the dashboard handoff. Durable state and live memory use the same
    -- compact operator report shape.
    memory.report = state.compactWarmReport(report, report.savedAt or computer.uptime())
  elseif type(report) == "table" and report.status and report.status.complete == false then
    memory.report = nil
  end
  return memory.report
end

function memory.latest()
  return memory.report
end

return memory
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local maintainerMemory = require("oc.ae2.maintainer_memory")
local quiesceWorkflowPolicy = require("oc.ae2.maintainer_policy_quiesce").run
local reconcileReceipt = require("oc.ae2.maintainer_reconcile_receipt")
local maintainerState = require("oc.ae2.maintainer_state")
local stopRecovery = require("oc.ae2.maintainer_stop_recovery")

local control = {}
local launchingAt = nil
local launchingUntil = nil
local LAUNCH_GRACE = 5
local MAX_FUTURE_SKEW = 5
local STARTUP_WARM_DELAY = 2
local activeReconcileStates = {
  braking = true, draining = true, zero_proven = true, committing = true
}

local function launchGraceActive(now)
  return launchingAt ~= nil and now < (launchingUntil or (launchingAt + LAUNCH_GRACE))
end

local function deferSeconds(cfg, options)
  options = options or {}
  local value = options.deferSeconds
  if options.deferFirstTick == true and value == nil then value = STARTUP_WARM_DELAY end
  return math.max(0, tonumber(value) or 0)
end

local function heartbeatFresh(cfg, heartbeat)
  if not (heartbeat and heartbeat.fresh == true) then return false end
  if cfg and cfg.enabled == true then
    return tonumber(heartbeat.generation) ~= nil and tonumber(heartbeat.generation) == tonumber(cfg.generation)
  end
  return true
end

local function heartbeatReadPending(heartbeat)
  return heartbeat and heartbeat.readFailed == true and heartbeat.readRetryable == true
end

local function reportSignature(report)
  return report and (report.signature or (report.cache and report.cache.signature))
end

local function reportTargetSignature(report)
  return report and (report.targetSignature or (report.cache and report.cache.targetSignature))
end

local function reportStamp(report)
  return tonumber(report and (report.savedAt or report.manualPatchAt
    or (report.cache and report.cache.savedAt)))
end

local function plausibleReportTime(report, now)
  local stamp = reportStamp(report)
  if stamp == nil then return true end
  return stamp == stamp and stamp >= 0 and stamp < math.huge and stamp <= now + MAX_FUTURE_SKEW
end

local function warmReport(heartbeat)
  local disk = heartbeat and heartbeat.warmReport or nil
  local live = maintainerMemory.latest()
  local now = computer.uptime()
  if disk and not plausibleReportTime(disk, now) then disk = nil end
  if live and not plausibleReportTime(live, now) then live = nil end
  if not live then return disk end
  if not disk then return live end
  local diskSignature, liveSignature = reportSignature(disk), reportSignature(live)
  local diskTargets, liveTargets = reportTargetSignature(disk), reportTargetSignature(live)
  if diskSignature and diskSignature ~= liveSignature then return disk end
  if diskTargets and diskTargets ~= liveTargets then return disk end
  local diskAt, liveAt = reportStamp(disk), reportStamp(live)
  if diskAt and (not liveAt or diskAt >= liveAt) then return disk end
  return live
end

local function wakeDaemon(command)
  local ok, event = pcall(require, "event")
  if not (ok and event and event.push) then return end
  if command ~= nil then pcall(event.push, "oc_ae2_daemon_timer", command)
  else pcall(event.push, "oc_ae2_daemon_timer") end
end

local function mergeStatus(cfg, heartbeat)
  heartbeat = heartbeat or {}
  cfg = cfg or daemonConfig.load()
  if cfg.enabled == true and heartbeat.fresh == true and not heartbeatFresh(cfg, heartbeat) then
    heartbeat.generationMismatch = true
    heartbeat.fresh = false
  end
  heartbeat.desiredEnabled = cfg.enabled == true
  heartbeat.configInterval = cfg.interval
  heartbeat.configPollInterval = cfg.pollInterval
  heartbeat.configGeneration = tonumber(cfg.generation)
  reconcileReceipt.projectStatus(heartbeat, cfg)
  heartbeat.running = heartbeat.desiredEnabled and heartbeat.fresh == true
  heartbeat.stateReadPending = heartbeatReadPending(heartbeat)
  heartbeat.stateReadError = heartbeat.readFailed == true and (heartbeat.readError or heartbeat.lastError) or nil
  heartbeat.starting = heartbeat.desiredEnabled and launchingAt ~= nil and not heartbeat.fresh
  if heartbeat.starting then
    local remaining = math.max(0, (launchingUntil or computer.uptime()) - computer.uptime())
    heartbeat.startupUntil = launchingUntil
    heartbeat.startupRemaining = remaining
  else
    heartbeat.startupUntil = nil
    heartbeat.startupRemaining = nil
  end
  heartbeat.warmReport = warmReport(heartbeat)
  return heartbeat
end

local function reconciliationBackend()
  local ok, backend = pcall(require, "oc.ae2.workflow_identity_reconcile")
  if not ok or type(backend) ~= "table" or type(backend.preview) ~= "function" then
    return nil, "recorded identity reconciliation backend unavailable: " .. tostring(backend)
  end
  return backend
end

local function reconciliationCounts(report)
  if type(report) ~= "table" then return nil end
  local source = type(report.counts) == "table" and report.counts
    or type(report.summary) == "table" and report.summary or report
  local counts = {}
  for key, value in pairs(source) do
    if type(key) == "string" and type(value) == "number" and value >= 0 then
      counts[key] = math.floor(value)
    end
  end
  return next(counts) and counts or nil
end

local function failReconcileConfig(cfg, reason)
  if type(daemonConfig.advanceIdentityReconcile) == "function" then
    local called, ok, _, saved = pcall(daemonConfig.advanceIdentityReconcile,
      cfg.identityReconcileSerial, "failed_safe", tostring(reason), nil, computer.uptime())
    if called and ok == true then return saved or daemonConfig.load() end
  end
  return daemonConfig.load()
end

local function spawn(cfg, options)
  options = options or {}
  local deferred = deferSeconds(cfg, options)
  local ok, thread = pcall(require, "thread")
  if not ok or not thread or not thread.create then
    return false, "thread library unavailable; run ae2-maintainer --daemon " .. tostring(cfg.interval)
  end
  local daemon = require("oc.ae2.maintainer_daemon")
  local createdOk, handle = pcall(thread.create, function()
    daemon.run({
      interval = cfg.interval,
      pollInterval = cfg.pollInterval,
      generation = cfg.generation,
      deferFirstTick = options.deferFirstTick == true,
      deferSeconds = deferred
    })
  end)
  if not createdOk or not handle then return false, tostring(handle or "thread create failed") end
  if handle.detach then handle:detach() end
  return true
end

local function startThread(cfg, heartbeat, disableOnFail, options)
  local now = computer.uptime()
  if launchGraceActive(now) then
    return true, nil, mergeStatus(cfg, heartbeat)
  end
  launchingAt = now
  launchingUntil = now + math.max(LAUNCH_GRACE, deferSeconds(cfg, options) + LAUNCH_GRACE)
  local spawned, spawnErr = spawn(cfg, options)
  if not spawned then
    if disableOnFail then
      launchingAt, launchingUntil = nil, nil
      daemonConfig.setEnabled(false)
    end
    return false, spawnErr, mergeStatus(cfg, heartbeat)
  end
  return true, nil, mergeStatus(cfg, heartbeat)
end

function control.status()
  local cfg, heartbeat = daemonConfig.load(), maintainerState.status()
  cfg, heartbeat = stopRecovery.repair(cfg, heartbeat)
  return mergeStatus(cfg, heartbeat)
end

function control.ensureRunning(options)
  local cfg = daemonConfig.load()
  local heartbeat = maintainerState.status()
  if not cfg.enabled then return true, nil, mergeStatus(cfg, heartbeat) end
  if heartbeat.readFailed == true then
    local status = mergeStatus(cfg, heartbeat)
    if heartbeatReadPending(heartbeat) then return true, nil, status end
    return false, tostring(heartbeat.readError or heartbeat.lastError), status
  end
  if heartbeatFresh(cfg, heartbeat) then
    launchingAt, launchingUntil = nil, nil
    return true, nil, mergeStatus(cfg, heartbeat)
  end
  local now = computer.uptime()
  if launchGraceActive(now) then
    return true, nil, mergeStatus(cfg, heartbeat)
  end
  local ok, err, nextCfg = daemonConfig.enable()
  if not ok then return false, err, mergeStatus(cfg, heartbeat) end
  wakeDaemon()
  return startThread(nextCfg, heartbeat, false, options)
end

function control.start(options)
  options = options or {}
  local before = daemonConfig.load()
  local heartbeat = maintainerState.status()
  if options.expectedGeneration ~= nil and (before.enabled == true
      or tonumber(before.generation) ~= tonumber(options.expectedGeneration)) then
    return false, "daemon ownership changed before conditional restore", mergeStatus(before, heartbeat)
  end
  if before.enabled and heartbeat.readFailed == true then
    local status = mergeStatus(before, heartbeat)
    if heartbeatReadPending(heartbeat) then return true, nil, status end
    return false, tostring(heartbeat.readError or heartbeat.lastError), status
  end
  if before.enabled and heartbeatFresh(before, heartbeat) then
    launchingAt, launchingUntil = nil, nil
    return true, nil, mergeStatus(before, heartbeat)
  end
  local now = computer.uptime()
  if launchGraceActive(now) then
    return true, nil, mergeStatus(before, heartbeat)
  end
  local ok, err, cfg = daemonConfig.enable(options.expectedGeneration)
  if not ok then
    launchingAt, launchingUntil = nil, nil
    return false, err, mergeStatus(daemonConfig.load(), heartbeat)
  end
  if before.enabled then wakeDaemon() end
  return startThread(cfg, heartbeat, true, options)
end

function control.stop()
  local before = daemonConfig.load()
  if before.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(before.maintenanceBrakeReason or "operator maintenance")
      .. "; resume the owning Safe Stop or Recorded Reconcile transaction",
      mergeStatus(before, maintainerState.status())
  end
  launchingAt, launchingUntil = nil, nil
  local ok, err, cfg = daemonConfig.setEnabled(false)
  if not ok then return false, err end
  wakeDaemon()
  return true, nil, mergeStatus(cfg, maintainerState.status())
end

function control.toggle()
  local cfg = daemonConfig.load()
  if cfg.enabled then return control.stop() end
  return control.start()
end

function control.nextBatchNow()
  local cfg = daemonConfig.load()
  local heartbeat = maintainerState.status()
  if cfg.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(cfg.maintenanceBrakeReason or "operator maintenance"), mergeStatus(cfg, heartbeat)
  end
  if not cfg.enabled then
    return false, "turn daemon on before requesting next request now", mergeStatus(cfg, heartbeat)
  end
  local forceOk, forceErr, forcedCfg = daemonConfig.requestForce(computer.uptime())
  if not forceOk then
    return false, forceErr, mergeStatus(forcedCfg or cfg, heartbeat)
  end
  cfg = forcedCfg or cfg
  if heartbeatFresh(cfg, heartbeat) then
    wakeDaemon("force")
    local status = mergeStatus(cfg, heartbeat)
    status.nextIn = 0
    status.forceRequested = true
    return true, nil, status
  end
  local starting = launchGraceActive(computer.uptime())
  local ok, err, status = control.ensureRunning({ deferFirstTick = false })
  if ok and status then
    if starting then wakeDaemon("force") end
    status.nextIn = 0
    status.forceRequested = true
  end
  return ok, err, status
end

local function sameReconcileReceipt(cfg, options)
  return tonumber(options.serial) == tonumber(cfg.identityReconcileSerial)
    and tonumber(options.configIndex) == tonumber(cfg.identityReconcileConfigIndex)
    and (options.workflowId == nil or options.workflowId == cfg.identityReconcileWorkflowId)
    and options.recordId == cfg.identityReconcileRecordId
    and (options.addObserved ~= false) == (cfg.identityReconcileAddObserved ~= false)
end

local function selectedNoopPreview(report, counts)
  local token = type(report) == "table" and type(report.planToken) == "table"
    and report.planToken or {}
  if token.version ~= 2 or token.scope ~= "selected"
      or (tonumber(counts and counts.valid) or 0) < 1
      or token.afterSnapshot == nil or token.afterSnapshot ~= token.rawSnapshot then return false end
  for _, key in ipairs({ "repairable", "repaired", "probeReady", "observed", "added",
      "blocked", "ambiguous", "conflicts" }) do
    if (tonumber(counts and counts[key]) or 0) ~= 0 then return false end
  end
  return true
end

function control.reconcileRecorded(options)
  options = type(options) == "table" and options or {}
  local cfg = daemonConfig.load()
  local heartbeat = maintainerState.status()
  local state = tostring(cfg.identityReconcileState or "idle")
  if state == "failed_safe" then
    if cfg.identityReconcileOperation ~= "reconcile" then
      return false, "failed safe-stop must be restarted with the explicit safe-stop control",
        mergeStatus(cfg, heartbeat)
    end
    if not (options.confirm == true and options.retry == true) then
      return false, tostring(cfg.identityReconcileReason or "identity reconciliation failed safe")
        .. "; retry with confirm=true, retry=true after reviewing the receipt", mergeStatus(cfg, heartbeat)
    end
    if not sameReconcileReceipt(cfg, options) then
      return false, "retry serial or scope does not match the failed-safe receipt",
        mergeStatus(cfg, heartbeat)
    end
    if type(daemonConfig.retryIdentityReconcile) ~= "function" then
      return false, "failed-safe identity reconciliation retry unavailable", mergeStatus(cfg, heartbeat)
    end
    local retried, retryReason, retryCfg = daemonConfig.retryIdentityReconcile(
      options.serial, computer.uptime(), options.commissioningSerial)
    if not retried then return false, retryReason, mergeStatus(retryCfg or cfg, heartbeat) end
    cfg = retryCfg
    local quiesced, quiesceReason = quiesceWorkflowPolicy(nil, nil, options)
    if not quiesced then
      cfg = failReconcileConfig(cfg, quiesceReason)
      return false, quiesceReason, mergeStatus(cfg, heartbeat)
    end
    wakeDaemon("reconcile")
    local running, runReason, status
    if cfg.enabled then running, runReason, status = control.ensureRunning({ deferFirstTick = false })
    else running, runReason, status = control.start({ deferFirstTick = false }) end
    return running, runReason, status
  end
  if activeReconcileStates[state] then
    if not options.confirm then return true, nil, mergeStatus(cfg, heartbeat) end
    if not sameReconcileReceipt(cfg, options) then
      return false, "active identity reconciliation serial or scope does not match",
        mergeStatus(cfg, heartbeat)
    end
    wakeDaemon("reconcile")
    local ok, err, status
    if cfg.enabled then ok, err, status = control.ensureRunning({ deferFirstTick = false })
    else ok, err, status = control.start({ deferFirstTick = false }) end
    return ok, err, status
  end
  if options.confirm == true then
    if state ~= "previewed" then
      return false, "preview recorded identity reconciliation before confirming it", mergeStatus(cfg, heartbeat)
    end
    if not sameReconcileReceipt(cfg, options) then
      return false, "identity reconciliation serial or scope changed; preview again",
        mergeStatus(cfg, heartbeat)
    end
    local confirmed, confirmReason, confirmedCfg = daemonConfig.confirmIdentityReconcile(
      options.serial, computer.uptime(), options.commissioningSerial)
    if not confirmed then
      return false, confirmReason, mergeStatus(confirmedCfg or daemonConfig.load(), heartbeat)
    end
    local quiesced, quiesceReason = quiesceWorkflowPolicy(nil, nil, options)
    if not quiesced then
      confirmedCfg = failReconcileConfig(confirmedCfg, quiesceReason)
      return false, quiesceReason, mergeStatus(confirmedCfg, heartbeat)
    end
    wakeDaemon("reconcile")
    local running, runReason, status
    if confirmedCfg.enabled then running, runReason, status = control.ensureRunning({ deferFirstTick = false })
    else running, runReason, status = control.start({ deferFirstTick = false }) end
    return running, runReason, status or mergeStatus(daemonConfig.load(), maintainerState.status())
  end
  if state == "previewed" and options.refresh ~= true then
    return true, nil, mergeStatus(cfg, heartbeat)
  end
  local backend, backendReason = reconciliationBackend()
  if not backend then return false, backendReason, mergeStatus(cfg, heartbeat) end
  local previewOptions = {
    addObserved = options.addObserved ~= false,
    configIndex = options.configIndex, workflowId = options.workflowId,
    recordId = options.recordId,
    preparation = state == "preparing" and cfg.identityReconcilePreparation or nil
  }
  local called, previewOk, previewReason, report = pcall(backend.preview, previewOptions)
  if not called then
    return false, "recorded identity preview failed: " .. tostring(previewOk), mergeStatus(cfg, heartbeat)
  end
  if previewOk ~= true then
    return false, tostring(previewReason or "recorded identity preview was rejected"), mergeStatus(cfg, heartbeat)
  end
  local previewCounts = reconciliationCounts(report) or {}
  if report.preparing == true then
    local staged, stageReason, stagedCfg = daemonConfig.stageIdentityPreparation(
      report.preparation, previewCounts, computer.uptime(), report.reason,
      previewOptions.preparation)
    if not staged then
      return false, stageReason, mergeStatus(stagedCfg or daemonConfig.load(), heartbeat)
    end
    return true, nil, mergeStatus(stagedCfg, heartbeat)
  end
  if report.state == "BLOCKED" or report.state == "AMBIGUOUS"
      or (tonumber(previewCounts.blocked) or 0) > 0
      or (tonumber(previewCounts.ambiguous) or 0) > 0 then
    return false, tostring(report.reason or "identity preview is blocked or ambiguous"),
      mergeStatus(cfg, heartbeat)
  end
  local staged, stageReason, stagedCfg = daemonConfig.stageIdentityReconcile(
    previewCounts, computer.uptime(), previewReason, {
      addObserved = previewOptions.addObserved, configIndex = previewOptions.configIndex,
      workflowId = report.planToken and report.planToken.selectedWorkflowId,
      recordId = previewOptions.recordId, planToken = report.planToken,
      commissioningSerial = options.commissioningSerial
    })
  if not staged then
    return false, stageReason, mergeStatus(stagedCfg or daemonConfig.load(), heartbeat)
  end
  if selectedNoopPreview(report, previewCounts) then
    if type(daemonConfig.completeIdentityReconcileNoop) ~= "function" then
      return false, "automatic already-valid completion is unavailable",
        mergeStatus(stagedCfg, heartbeat)
    end
    local completed, completeReason, completedCfg = daemonConfig.completeIdentityReconcileNoop(
      stagedCfg.identityReconcileSerial, computer.uptime())
    if not completed then
      return false, completeReason, mergeStatus(completedCfg or stagedCfg, heartbeat)
    end
    return true, nil, mergeStatus(completedCfg, heartbeat)
  end
  return true, nil, mergeStatus(stagedCfg, heartbeat)
end

function control.safeStop(options)
  options = type(options) == "table" and options or {}
  local cfg = daemonConfig.load()
  local heartbeat = maintainerState.status()
  if type(daemonConfig.requestSafeStop) ~= "function" then
    return false, "safe daemon stop transaction unavailable", mergeStatus(cfg, heartbeat)
  end
  local fenceProof
  if cfg.identityReconcileState == "failed_safe"
      and cfg.identityReconcileOperation == "reconcile" then
    local fenceFree, fenceReason = quiesceWorkflowPolicy(nil, true, options)
    if not fenceFree then return false, fenceReason, mergeStatus(cfg, heartbeat) end
    fenceProof = tostring(cfg.identityReconcileSerial)
      .. ":" .. tostring(cfg.maintenanceBrakeSerial)
  end
  local requested, requestReason, stoppedCfg = daemonConfig.requestSafeStop(
    computer.uptime(), fenceProof, options.commissioningSerial)
  if not requested then return false, requestReason, mergeStatus(stoppedCfg or cfg, heartbeat) end
  cfg = stoppedCfg
  local quiesced, quiesceReason = quiesceWorkflowPolicy(nil, nil, options)
  if not quiesced then
    cfg = failReconcileConfig(cfg, quiesceReason)
    return false, quiesceReason, mergeStatus(cfg, heartbeat)
  end
  wakeDaemon("safe_stop")
  local running, runReason, status
  if cfg.enabled then running, runReason, status = control.ensureRunning({ deferFirstTick = false })
  else running, runReason, status = control.start({ deferFirstTick = false }) end
  return running, runReason, status or mergeStatus(daemonConfig.load(), maintainerState.status())
end

function control.observeActiveOutputs(options)
  local loaded, workflows = pcall(require, "oc.ae2.workflows")
  if not loaded or type(workflows) ~= "table"
      or type(workflows.observeActiveCpuOutputs) ~= "function" then
    return false, "bounded CPU observation backend unavailable"
  end
  return workflows.observeActiveCpuOutputs(options)
end

function control.captureNextRecorded(options)
  return control.observeActiveOutputs(options)
end

function control.adjustInterval(delta)
  local cfg = daemonConfig.load()
  return control.setInterval((tonumber(cfg.interval) or 600) + (tonumber(delta) or 0))
end

function control.setInterval(interval)
  local cfg = daemonConfig.load()
  local heartbeat = maintainerState.status()
  if cfg.enabled then
    return false, "turn daemon off before changing interval", mergeStatus(cfg, heartbeat)
  end
  local ok, err, saved = daemonConfig.setInterval(interval)
  if not ok then return false, err, mergeStatus(cfg, heartbeat) end
  return true, nil, mergeStatus(saved, heartbeat)
end

return control
-- Atomic policy disarm used by Safe Stop and Recorded Reconcile.
local computer = require("computer")
local quiesce = {}

local function copy(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}
  if seen[value] then return seen[value] end
  local out = {}; seen[value] = out
  for key, nested in pairs(value) do out[copy(key, seen)] = copy(nested, seen) end
  return out
end

local function quiet(value)
  if type(value) ~= "table" or value.autoEnabled ~= false then return false end
  for _, row in ipairs(type(value.workflows) == "table" and value.workflows or {}) do
    if type(row) == "table" and row.armed == true then return false end
  end
  return true
end

local function settleRecordedAdd()
  local loaded, tx = pcall(require, "oc.ae2.workflow_identity_add_transaction")
  if not loaded or type(tx) ~= "table" or type(tx.recoverPending) ~= "function" then
    return false, "recorded Add recovery authority is unavailable"
  end
  local called, ok, reason, report = pcall(tx.recoverPending, { now = computer.uptime() })
  if not called then return false, tostring(ok) end
  if ok == true then return true end
  return false, tostring(reason or "recorded Add recovery failed"),
    type(report) == "table" and report.retryable == true
end

function quiesce.run(retried, requireFenceFree, owner)
  local settled, settleReason, retryable = settleRecordedAdd()
  if not settled then
    if retryable and not requireFenceFree then return true, settleReason, true end
    return false, settleReason
  end
  local loaded, store = pcall(require, "oc.ae2.workflow_store")
  if not loaded or type(store) ~= "table" or type(store.rawSnapshot) ~= "function"
      or type(store.saveRawSnapshot) ~= "function" then
    return false, "cannot atomically disable automation: workflow store unavailable"
  end
  local called, snapshot, reason = pcall(store.rawSnapshot)
  if not called or type(snapshot) ~= "table" or type(snapshot.value) ~= "table" then
    return false, "cannot atomically disable automation: "
      .. tostring(called and reason or snapshot)
  end
  if requireFenceFree and snapshot.value.identityMutationFence ~= nil then
    return false, "failed reconciliation still owns the workflow fence; retry Reconcile first"
  end
  if quiet(snapshot.value) then return true end
  local candidate = copy(snapshot.value); candidate.autoEnabled = false
  for _, row in ipairs(type(candidate.workflows) == "table" and candidate.workflows or {}) do
    if type(row) == "table" then row.armed = false end
  end
  local saved, saveReason
  called, saved, saveReason = pcall(store.saveRawSnapshot, snapshot, candidate,
    function(decoded) return quiet(decoded), "saved policy is not quiescent" end,
    "identity_reconcile_quiesce", { commissioningOwner = owner
      and { serial = owner.commissioningSerial, purpose = "quiesce" } or nil })
  if not called or saved ~= true then
    if retried ~= true then return quiesce.run(true, requireFenceFree, owner) end
    return false, "cannot atomically disable automation: "
      .. tostring(called and saveReason or saved)
  end
  return true
end

return quiesce
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local maintainerState = require("oc.ae2.maintainer_state")
local reconcileReceipt = require("oc.ae2.maintainer_reconcile_receipt")

local recovery = {}

local function sameReceipt(left, right)
  if type(left) ~= "table" or type(right) ~= "table" then return false end
  for _, key in ipairs({ "generation", "enabled", "maintenanceBrake",
      "identityReconcileSerial", "identityReconcileState", "identityReconcileOperation",
      "identityReconcilePriorEnabled", "identityReconcileDaemonGeneration",
      "identityReconcileConfigIndex", "identityReconcileWorkflowId",
      "identityReconcileRecordId", "identityReconcileCompletedAt" }) do
    if left[key] ~= right[key] then return false end
  end
  return true
end

-- Close only the narrow crash gap where the durable reconciliation receipt is
-- complete but the same daemon generation's final stopped receipt was not yet
-- persisted.  Any policy drift or local/manual ownership keeps recovery inert.
function recovery.repair(cfg, heartbeat)
  if type(reconcileReceipt.recoverableStoppedGeneration) ~= "function" then return cfg, heartbeat end
  local generation = reconcileReceipt.recoverableStoppedGeneration(cfg, heartbeat, computer.uptime())
  if not generation then return cfg, heartbeat end
  local ownershipCheck = type(maintainerState.manualOwnership) == "function"
    and maintainerState.manualOwnership or maintainerState.manualInFlight
  if type(ownershipCheck) ~= "function" then return cfg, heartbeat end
  local checked, owned = pcall(ownershipCheck, computer.uptime())
  if not checked or owned ~= false then return cfg, heartbeat end
  local current = daemonConfig.load()
  if not sameReceipt(cfg, current) then return current, maintainerState.status() end
  local called, recorded = pcall(maintainerState.recordStop, generation, "complete_safe_recovered")
  local after, nextHeartbeat = daemonConfig.load(), maintainerState.status()
  if called and recorded == true and sameReceipt(current, after)
      and nextHeartbeat.workerState == "stopped"
      and tonumber(nextHeartbeat.stoppedGeneration) == tonumber(generation) then
    nextHeartbeat.stopReceiptRecovered = true
  end
  return after, nextHeartbeat
end

return recovery
local computer = require("computer")
local queueOwnership = require("oc.ae2.maintainer_queue_ownership")
local stateIdentity = require("oc.ae2.maintainer_state_identity")
local stateReport = require("oc.ae2.maintainer_state_report")
local stateStore = require("oc.ae2.maintainer_state_store")

local state = {}

state.path = "/var/oc/ae2-maintainer.state"
state.manualPath = "/var/oc/ae2-maintainer-manual.state"
state.staleAfter = 90

local function readState() return stateStore.read(state.path) end
local function updateState(callback) return stateStore.update(state.path, callback) end

local function restartOwnershipClaims(previous, now)
  local restarted = (tonumber(previous.lastTick) or 0) > now
    or (tonumber(previous.startedAt) or 0) > now
  if not restarted then return previous.ownershipClaims end
  local claims = {}
  for index, row in ipairs(type(previous.ownershipClaims) == "table" and previous.ownershipClaims or {}) do
    local copy = {}
    for key, value in pairs(row) do copy[key] = value end
    copy.safeStopSerial, copy.safeStopRecoveryUntil, copy.nextEligibleAt = nil, nil, nil
    claims[index] = copy
  end
  return claims
end

function state.recordStart(interval, nextCycleAt, generation)
  local now = computer.uptime()
  return updateState(function(previous)
    local nextGeneration = tonumber(generation)
    local previousGeneration = tonumber(previous.generation)
    if previousGeneration and nextGeneration and previousGeneration > nextGeneration then return nil end
    if previousGeneration == nextGeneration and previous.workerState == "stopped"
        and tonumber(previous.stoppedGeneration) == nextGeneration then return nil end
    return {
      startedAt = now,
      lastTick = now,
      nextCycleAt = tonumber(nextCycleAt) or now,
      tickCount = 0,
      generation = nextGeneration,
      workerState = "running",
      stoppedGeneration = previous.stoppedGeneration,
      stoppedAt = previous.stoppedAt,
      stopReason = previous.stopReason,
      daemonInterval = tonumber(interval) or 30,
      lastStatus = "daemon started",
      targetStatus = previous.targetStatus,
      ownershipClaims = restartOwnershipClaims(previous, now),
      safeStopOwnership = previous.safeStopOwnership,
      warmReport = stateIdentity.scrubStartupWarmReport(previous.warmReport)
    }
  end)
end

function state.compactWarmReport(report, now)
  return stateReport.compactWarmReport(report, now)
end

function state.patchTargets(targets, now, policy)
  targets = targets or {}
  return updateState(function(out)
    local report = type(out.warmReport) == "table" and out.warmReport or nil
    if not report then return nil end
    local existing, used, nextRows = report.targets or {}, {}, {}
    local patchedRows = {}
    for _, target in ipairs(targets or {}) do
      local row = stateIdentity.findWarmRow(existing, target, used) or stateIdentity.placeholderTarget(target)
      stateIdentity.patchPolicy(row, target)
      stateIdentity.refreshPolicyStock(row, "waiting for daemon refresh")
      nextRows[#nextRows + 1] = row
      patchedRows[stateIdentity.targetKey(target)] = row
      patchedRows[stateIdentity.queueId(target)] = row
    end
    report.targets = nextRows
    report.targetSignature = stateIdentity.targetSignature(targets)
    report.signature = stateIdentity.configSignature(targets)
    report.policySignature = stateIdentity.configSignature(targets)
    if type(report.status) == "table" then
      if type(policy) == "table" and policy.autoEnabled ~= nil then
        report.status.autoEnabled = policy.autoEnabled ~= false
      end
      if type(policy) == "table" and policy.craftCompatibility ~= nil then
        local profile = policy.craftCompatibility == "legacy_filtered" and "legacy_filtered"
          or policy.craftCompatibility == "auto" and "auto" or "scalar_only"
        report.status.craftCompatibility = profile
        report.status.craftApiMode = profile == "legacy_filtered" and "legacy-exact-filter"
          or profile == "auto" and "scalar-then-legacy" or "scalar-only"
      end
      if type(policy) == "table" and policy.fluidStockCompatibility ~= nil then
        report.status.fluidStockCompatibility = policy.fluidStockCompatibility
      end
      report.status.targetCount = #targets
      report.status.armedTargets = stateIdentity.armedCount(targets)
      report.status.mode = report.status.autoEnabled ~= false and report.status.armedTargets > 0 and "armed" or "observe"
    end
    local keptStatus = {}
    for _, row in ipairs(out.targetStatus or {}) do
      local target = stateIdentity.matchingTarget(targets, row)
      if target then
        keptStatus[#keptStatus + 1] = row
      end
    end
    out.targetStatus = keptStatus
    local keptClaims, boundaryNow = {}, tonumber(now) or computer.uptime()
    for _, row in ipairs(out.ownershipClaims or {}) do
      if stateIdentity.matchingTarget(targets, row) or (tonumber(row.nextEligibleAt) or 0) > boundaryNow then
        keptClaims[#keptClaims + 1] = row
      end
    end
    out.ownershipClaims = keptClaims
    for _, target in ipairs(targets or {}) do
      local amount = stateIdentity.requestAmount(target)
      for _, row in ipairs(out.targetStatus or {}) do
        if stateIdentity.sameTarget(row, target) then
          if amount > 0 then row.amount = amount end
          local warmRow = patchedRows[stateIdentity.targetKey(target)] or patchedRows[stateIdentity.queueId(target)]
          if row.status == "queued" and warmRow and warmRow.min ~= nil then
            row.reason = "stock " .. tostring(warmRow.current or "?") .. " below " .. tostring(warmRow.min)
          end
        end
      end
    end
    report.savedAt = tonumber(now) or computer.uptime()
    return out
  end)
end

local function lifecycle(requestReport, source, assumeSubmitted)
  requestReport = type(requestReport) == "table" and requestReport or {}
  local requestState = requestReport.requestState or (assumeSubmitted and "running" or "accepted")
  local requestPhase = requestReport.requestPhase or (assumeSubmitted and "submitted" or nil)
  local reason = requestReport.requestStatusReason
  local prefix = source == "auto" and "auto" or "manual"
  if requestPhase == "status_error" or requestState == "accepted" then
    local detail = reason
    if detail == nil or tostring(detail) == "" then detail = "request status methods unavailable" end
    reason = tostring(detail)
    if reason:find("request confirmation unavailable:", 1, true) ~= 1 then
      reason = "request confirmation unavailable: " .. reason
    end
    requestState, requestPhase = "accepted", "confirmation_unavailable"
  end
  if requestState == "running" and requestPhase == "computing" then
    return requestState, requestPhase, reason, prefix .. " request planning; no CPU assigned yet", false, false
  elseif requestState == "running" and requestPhase == "submitted" then
    return requestState, requestPhase, reason, prefix .. " request accepted by AE2; CPU witness pending", true, false
  elseif requestState == "done" then
    return requestState, requestPhase or "done", reason, prefix .. " request completed", false, false
  elseif requestState == "accepted" then
    return requestState, requestPhase, reason, prefix .. " request returned; confirmation unavailable", false, false
  elseif requestState == "blocked" then
    return requestState, requestPhase or "blocked", reason, prefix .. " request blocked: " .. tostring(reason or "blocked"), false, true
  elseif requestState == "canceled" then
    return requestState, requestPhase or "canceled", reason, prefix .. " request canceled", false, true
  elseif requestState == "failed" then
    return requestState, requestPhase or "failed", reason, prefix .. " request failed: " .. tostring(reason or "unknown"), false, true
  end
  return requestState, requestPhase, reason, prefix .. " request state " .. tostring(requestState), false, false
end

local function recordManualReservation(row, now, requestState, requestPhase, requestReason, requestRawReason, amount)
  local workflow = type(row and row.workflow) == "table" and row.workflow or {}
  return stateStore.recordManual(state.manualPath, {
    id = stateIdentity.queueId(row), workflowId = row and row.workflowId,
    label = row and row.label, rawLabel = row and row.rawLabel,
    name = row and row.name, damage = row and row.damage, hasTag = row and row.hasTag == true,
    kind = row and row.kind, isFluid = row and row.isFluid == true,
    craftBinding = row and row.craftBinding, amount = tonumber(amount) or stateIdentity.requestAmount(row),
    cooldown = tonumber(row and row.cooldown or workflow.cooldown) or 600,
    state = requestState, phase = requestPhase, reason = requestReason, rawReason = requestRawReason
  }, now)
end

function state.recordAutoIntent(row, now, details)
  now, details = tonumber(now) or computer.uptime(), type(details) == "table" and details or {}
  local id = stateIdentity.queueId(row)
  if details.requestKey ~= nil and tostring(details.requestKey) ~= tostring(id) then
    return false, "auto submit intent target id mismatch"
  end
  return updateState(function(out)
    local expected, recorded = tonumber(details.daemonGeneration), tonumber(out.generation)
    if expected ~= nil then
      if recorded ~= expected then return nil, "stale daemon generation" end
      if out.workerState ~= "running" or tonumber(out.stoppedGeneration) == expected then
        return nil, "daemon generation already stopped"
      end
    end
    local prior, claims = nil, {}
    for _, claim in ipairs(type(out.ownershipClaims) == "table" and out.ownershipClaims or {}) do
      if tostring(claim.id or "") == tostring(id) then prior = claim else claims[#claims + 1] = claim end
    end
    if prior and details.outcomeKey ~= nil
        and tostring(prior.outcomeKey or "") == tostring(details.outcomeKey) then
      if prior.phase == "submit_intent" then return out end
      return nil, "auto submit intent outcome already reconciled"
    end
    local reason = "durable submit intent exists; AE2 invocation outcome not yet confirmed"
    claims[#claims + 1] = {
      id = id, workflowId = row and row.workflowId,
      label = row and row.label, rawLabel = row and row.rawLabel,
      name = row and row.name, damage = row and row.damage, hasTag = row and row.hasTag == true,
      kind = row and row.kind, isFluid = row and row.isFluid == true,
      amount = tonumber(details.amount) or stateIdentity.requestAmount(row),
      status = "blocked", phase = "submit_intent", statusReason = reason, reason = reason,
      quarantined = true, retryKind = "safety_hold", outcome = "safety_hold", queueAdvance = true,
      attempts = tonumber(prior and prior.attempts) or 0,
      attemptedAt = tonumber(details.attemptedAt) or now, intentAt = now,
      outcomeKey = details.outcomeKey, requestKey = id,
      ownershipReservationUntil = now + queueOwnership.settleSeconds,
      nextEligibleAt = now + queueOwnership.recoverySeconds
    }
    out.ownershipClaims = claims
    return out
  end)
end

local function recordRequest(row, now, requestReport, source, clearTargetStatus, assumeSubmitted)
  now = tonumber(now) or computer.uptime()
  source = source == "auto" and "auto" or "manual"
  requestReport = type(requestReport) == "table" and requestReport or {}
  local requestState, requestPhase, requestReason, statusText, confirmed, failed =
    lifecycle(requestReport, source, assumeSubmitted)
  local requestRawReason = requestReport.requestStatusRawReason
  if source == "manual" then
    local reserved, reserveReason = recordManualReservation(
      row, now, requestState, requestPhase, requestReason, requestRawReason, requestReport.amount)
    if reserved ~= true then return false, reserveReason or "manual reservation save failed" end
  end
  return updateState(function(out)
    local report = type(out.warmReport) == "table" and out.warmReport or nil
    if report then
      for _, target in ipairs(report.targets or {}) do
        if stateIdentity.sameTarget(target, row) then
          stateIdentity.patchPolicy(target, row)
          target.request = stateIdentity.requestAmount(row)
          target.requestState = requestState
          target.requestPhase = requestPhase
          target.requestStatusReason = requestReason
          target.requestStatusRawReason = requestRawReason
          target.requestError = failed and (requestReason or statusText) or nil
          target.error = nil
          target.requested = requestState == "running" or requestState == "accepted"
          target.ready = false
          target.reason = statusText
        end
      end
      report.savedAt = now
    end
    if clearTargetStatus and confirmed then stateIdentity.removeTargetStatus(out, row) end
    out.lastSubmitAttempt = now
    out.lastSubmitTarget = tostring(row and (row.label or row.rawLabel or row.name) or "target")
    out.lastSubmitAmount = stateIdentity.requestAmount(row)
    out.lastSubmitPhase = requestPhase or source
    out.lastSubmitReason = requestReason
    out.lastSubmitRawReason = requestRawReason
    if confirmed or requestState == "done" then
      out.lastSubmitOk, out.lastSubmitFail, out.lastError = now, nil, nil
    elseif failed then
      out.lastSubmitFail, out.lastError = now, tostring(requestReason or statusText)
    end
    out.lastStatus = statusText
    return out
  end)
end

function state.recordManualBatch(row, now, requestReport)
  return recordRequest(row, now, requestReport, "manual", true, true)
end

function state.recordAutoBatch(row, now, requestReport)
  return recordRequest(row, now, requestReport, "auto", false, true)
end

function state.recordAutoStatus(row, now, requestReport)
  return recordRequest(row, now, requestReport, "auto", false, false)
end

function state.recordManualStatus(row, now, requestReport)
  return recordRequest(row, now, requestReport, "manual", false, false)
end

function state.recordTick(report, interval, ok, err, nextCycleAt, generation)
  local now = computer.uptime()
  return updateState(function(out)
    local ownerGeneration, recordedGeneration = tonumber(generation), tonumber(out.generation)
    if recordedGeneration and ownerGeneration and recordedGeneration ~= ownerGeneration then
      return nil, "stale daemon generation"
    end
    if out.workerState == "stopped" and tonumber(out.stoppedGeneration) == ownerGeneration then
      return nil, "daemon generation already stopped"
    end
    return stateReport.recordTick(out, report, interval, ok, err, nextCycleAt, generation, now)
  end)
end

function state.recordStop(generation, reason)
  local now = computer.uptime()
  return updateState(function(out)
    local ownerGeneration = tonumber(generation)
    if tonumber(out.generation) ~= ownerGeneration then return nil end
    if out.workerState == "stopped" and tonumber(out.stoppedGeneration) == ownerGeneration then return nil end
    out.workerState = "stopped"
    out.stoppedGeneration = ownerGeneration
    out.stoppedAt = now
    out.stopReason = tostring(reason or "worker_exit")
    out.nextCycleAt = nil
    out.queuePhase, out.queuePausedReason = "idle", false
    out.refillSuppressed, out.queueHeadId = false, false
    out.lastStatus = "daemon stopped: " .. out.stopReason
    return out
  end)
end

function state.load()
  return readState()
end

function state.manualInFlight(now)
  local out = stateStore.read(state.manualPath, { maxBytes = 131072 })
  if out.readFailed == true then return nil, tostring(out.readError or out.lastError) end
  now = tonumber(now) or computer.uptime()
  local updatedAt = tonumber(out.updatedAt)
  if updatedAt and updatedAt > now then return false end
  for _, row in pairs(type(out.reservations) == "table" and out.reservations or {}) do
    if type(row) == "table" and row.state == "running"
        and (tonumber(row.leaseUntil) or 0) > now then return true, row end
  end
  return false
end

-- Identity reconciliation needs a stronger ownership proof than compatibility
-- editing: an opaque accepted result is not a known in-flight CPU, but it must
-- still hold the maintenance brake until its bounded retry boundary expires.
function state.manualOwnership(now, options)
  now = tonumber(now) or computer.uptime()
  local serial = type(options) == "table" and tonumber(options.safeStopSerial) or nil
  if not serial or serial < 1 then
    local out = stateStore.read(state.manualPath, { maxBytes = 131072 })
    if out.readFailed == true then return nil, tostring(out.readError or out.lastError) end
    local updatedAt = tonumber(out.updatedAt)
    if updatedAt and updatedAt > now then return nil, "manual ownership state is future-dated" end
    for _, row in pairs(type(out.reservations) == "table" and out.reservations or {}) do
      if type(row) == "table" then
        if row.state == "running" and (tonumber(row.leaseUntil) or 0) > now then return true, row end
        if (row.state == "accepted" or queueOwnership.quarantined(row.phase))
            and (tonumber(row.retryUntil) or 0) > now then return true, row end
      end
    end
    return false
  end

  local active, activeRow, changedRows = false, nil, {}
  local updated, updateReason = stateStore.update(state.manualPath, function(out)
    local rebooted = tonumber(out.updatedAt) and tonumber(out.updatedAt) > now
    local reservations = type(out.reservations) == "table" and out.reservations or {}
    out.reservations = reservations
    for id, row in pairs(reservations) do
      if type(row) == "table" then
        local running = row.state == "running"
        local uncertain = running or row.state == "accepted" or queueOwnership.quarantined(row.phase)
        local leaseUntil = tonumber(row.leaseUntil) or 0
        if uncertain and running and not rebooted and leaseUntil > now then
          active, activeRow = true, activeRow or row
        elseif uncertain then
          local boundary = tonumber(row.safeStopRecoveryUntil)
          if rebooted or tonumber(row.safeStopSerial) ~= serial or not boundary
              or boundary > now + queueOwnership.recoverySeconds then
            boundary = now + queueOwnership.recoverySeconds
            row.safeStopSerial, row.safeStopRecoveryUntil = serial, boundary
            row.state, row.phase = "accepted", "confirmation_unavailable"
            row.reason = rebooted
              and "manual ownership crossed an uptime restart; terminal confirmation unavailable"
              or "manual request lease expired; terminal confirmation unavailable"
            row.leaseUntil, row.retryUntil = now, boundary
            row.safeStopResolution = "recovery"
            changedRows[#changedRows + 1] = row
          end
          if boundary > now then
            active, activeRow = true, activeRow or row
          else
            row.state, row.phase = "ownership_relinquished", "ownership_relinquished"
            row.reason = "Safe Stop recovery boundary elapsed without renewed local ownership evidence"
            row.leaseUntil, row.retryUntil = now, nil
            row.safeStopResolution, row.safeStopResolvedAt = "relinquished", now
            changedRows[#changedRows + 1] = row
          end
        end
      end
    end
    if #changedRows == 0 then return nil end
    local generation = (tonumber(out.generation) or 0) + 1
    out.schemaVersion, out.generation, out.updatedAt = 1, generation, now
    for _, row in ipairs(changedRows) do
      row.generation, row.updatedAt = generation, now
    end
    return out
  end)
  if updated ~= true then return nil, tostring(updateReason or "manual ownership resolution write failed") end
  return active, activeRow
end

function state.status(now)
  local out = readState()
  now = tonumber(now) or computer.uptime()
  if (tonumber(out.tickCount) or 0) == 0 or stateIdentity.startupCarriedWarmReport(out) then
    stateIdentity.scrubStartupWarmReport(out.warmReport)
  end
  if type(out.lastTick) == "number" then
    out.age = now - out.lastTick
    local limit = math.max(state.staleAfter, ((tonumber(out.daemonInterval) or 30) * 2) + 5)
    out.fresh = out.age >= 0 and out.age <= limit
  else
    out.fresh = false
  end
  if out.workerState == "stopped" then out.fresh = false end
  if type(out.nextCycleAt) == "number" then
    out.nextIn = out.nextCycleAt - now
  end
  return out
end

return state
-- Minimal persistence boundary for the maintainer heartbeat state. Keeping
-- filesystem work here makes the public state API a small, paste-safe facade.
-- Evidence and daemon control now share this stable-primary posture; the high-
-- frequency heartbeat/manual paths deliberately touch only their stable primary
-- files so host backup enumeration never sees runtime lock or staging pathnames.
local filesystem = require("filesystem")
local serialization = require("serialization")

local store = {}
local MANUAL_ACTIVE_LEASE = 90
local MANUAL_FAILURE_BACKOFF = 600
local MAX_MANUAL_RESERVATIONS = 64
local activeUpdates = {}

local function finiteNumber(value)
  value = tonumber(value)
  if not value or value ~= value or value == math.huge or value == -math.huge then return nil end
  return value
end

local function ensureParent(path)
  local called, parent = pcall(filesystem.path, path)
  if not called then return false, tostring(parent) end
  if not parent or parent == "" then return true end
  local existsOk, present, existsErr = pcall(filesystem.exists, parent)
  if not existsOk or type(present) ~= "boolean" then
    return false, tostring(existsErr or present or ("could not inspect " .. parent))
  end
  if present then return true end
  local madeOk, made, makeErr = pcall(filesystem.makeDirectory, parent)
  if not madeOk or made ~= true then
    return false, tostring(makeErr or made or ("could not create " .. parent))
  end
  return true
end

local function exists(path)
  local called, present, reason = pcall(filesystem.exists, path)
  if not called then return nil, tostring(present) end
  if type(present) ~= "boolean" then return nil, tostring(reason or "could not inspect " .. path) end
  return present
end

local function close(handle, path)
  local called, closed, reason = pcall(function() return handle:close() end)
  -- OpenOS file handles may report a successful close with no return values.
  if not called or closed == false or (closed == nil and reason ~= nil) then
    return false, tostring(reason or closed or ("could not close " .. path))
  end
  return true
end

local function readText(path, maxBytes)
  local present, presentErr = exists(path)
  if present == nil then return nil, presentErr, nil end
  if not present then return nil, nil, false end
  local opened, handle, openErr = pcall(io.open, path, "r")
  if not opened then return nil, tostring(handle), true end
  if not handle then return nil, tostring(openErr or ("could not read " .. path)), true end
  maxBytes = finiteNumber(maxBytes)
  if maxBytes then maxBytes = math.max(1, math.floor(maxBytes)) end
  local readOk, text, readErr = pcall(function()
    return handle:read(maxBytes and (maxBytes + 1) or "*a")
  end)
  local closed, closeErr = close(handle, path)
  if not readOk then return nil, tostring(readErr or text), true end
  if text == nil and readErr ~= nil then return nil, tostring(readErr), true end
  if not closed then return nil, closeErr, true end
  if maxBytes and #(text or "") > maxBytes then
    return nil, "state exceeds " .. tostring(maxBytes) .. " byte read limit: " .. path, true
  end
  return text or "", nil, true
end

local function decodeFile(path, maxBytes)
  local text, readErr, present = readText(path, maxBytes)
  if present ~= true then return nil, readErr, present end
  local ok, value = pcall(serialization.unserialize, text)
  if not ok or type(value) ~= "table" then return nil, "state decode failed: " .. path, true end
  return value, nil, true
end

local function writeFile(path, text)
  local parentOk, parentErr = ensureParent(path)
  if not parentOk then return false, parentErr end
  local opened, handle, openErr = pcall(io.open, path, "w")
  if not opened then return false, tostring(handle) end
  if not handle then return false, tostring(openErr or ("could not write " .. path)) end
  local writeOk, wrote, writeErr = pcall(function() return handle:write(text) end)
  local closed, closeErr = close(handle, path)
  if not writeOk or wrote == nil or wrote == false then
    return false, tostring(writeErr or wrote or ("could not write " .. path))
  end
  if not closed then return false, closeErr end
  return true
end

local function readPrimary(path, maxBytes)
  local value, decodeErr, present = decodeFile(path, maxBytes)
  if present == nil then return nil, decodeErr end
  if not present then return { path = path, missing = true } end
  if not value then return nil, decodeErr or "state decode failed" end
  value.path, value.missing = path, nil
  return value
end

local function restorePrior(path, priorText, reason)
  local restored, restoreErr = writeFile(path, priorText)
  if not restored then
    return false, tostring(reason) .. "; prior-state restoration failed: " .. tostring(restoreErr)
  end
  local verified, verifyErr, present = readText(path)
  if present ~= true or verified ~= priorText then
    return false, tostring(reason) .. "; prior-state restoration verification failed: "
      .. tostring(verifyErr or "exact content mismatch")
  end
  return false, reason
end

local function writePrimary(path, value)
  value.path, value.missing = path, nil
  local renderedOk, rendered = pcall(serialization.serialize, value)
  if not renderedOk or type(rendered) ~= "string" then
    return false, tostring(rendered or "state serialization failed")
  end
  local priorText, priorErr, priorPresent = readText(path)
  if priorPresent == nil then return false, priorErr end
  local wrote, writeErr = writeFile(path, rendered)
  if not wrote then
    if priorPresent then return restorePrior(path, priorText, writeErr) end
    return false, tostring(writeErr) .. "; new state primary may be incomplete"
  end
  local body, readErr, present = readText(path)
  if present == true and body == rendered then
    local decodedOk, decoded = pcall(serialization.unserialize, body)
    if decodedOk and type(decoded) == "table" then return true, nil, value end
    if priorPresent then return restorePrior(path, priorText, "direct state verification decode failed") end
    return false, "direct state verification decode failed; new primary retained fail-closed"
  end
  -- A different complete body can be a successor write. Never restore the
  -- captured prior over bytes another cooperative writer may have supplied.
  if present == true and body ~= nil and body ~= "" and body ~= priorText then
    return false, tostring(readErr or "state changed during direct write verification")
  end
  local reason = readErr or (present == true and "direct state verification exact content mismatch"
    or "direct state verification primary disappeared")
  if priorPresent then return restorePrior(path, priorText, reason) end
  return false, tostring(reason) .. "; new state primary retained fail-closed"
end

-- OpenOS schedules local Lua processes cooperatively. Callbacks used by this
-- store are table-only and must not yield, so this in-memory guard serializes
-- nested RMW without creating backup-visible filesystem leases or stages.
local function withGuard(path, callback)
  if activeUpdates[path] then return false, "maintainer state update already active: " .. path end
  activeUpdates[path] = true
  local results = table.pack(pcall(callback))
  activeUpdates[path] = nil
  if not results[1] then return false, tostring(results[2]) end
  return table.unpack(results, 2, results.n)
end

function store.read(path, options)
  path = tostring(path or "")
  if path == "" then
    return {
      path = path, readFailed = true,
      readError = "maintainer state path is required",
      lastError = "maintainer state path is required"
    }
  end
  options = type(options) == "table" and options or {}
  local maxBytes = finiteNumber(options.maxBytes)
  if maxBytes then maxBytes = math.max(1, math.floor(maxBytes)) end
  local readOk, readErr, value = withGuard(path, function()
    local current, currentErr = readPrimary(path, maxBytes)
    if not current then return false, currentErr end
    return true, nil, current
  end)
  if readOk then return value end
  local message = tostring(readErr or "maintainer state read failed")
  return {
    path = path,
    readFailed = true,
    readError = message,
    lastError = message,
    readRetryable = false
  }
end

-- The callback sees the latest readable primary and must not yield. Returning
-- nil with no reason is a successful no-op; nil plus a reason rejects the RMW.
function store.update(path, callback)
  path = tostring(path or "")
  if path == "" then return false, "maintainer state path is required" end
  if type(callback) ~= "function" then return false, "maintainer state update callback is required" end
  return withGuard(path, function()
    local current, loadErr = readPrimary(path)
    if not current then return false, loadErr end
    local replacement, callbackErr = callback(current)
    if replacement == nil then
      if callbackErr ~= nil then return false, tostring(callbackErr) end
      return true, nil, current
    end
    if type(replacement) ~= "table" then
      return false, "maintainer state update callback must return a table or nil"
    end
    return writePrimary(path, replacement)
  end)
end

function store.write(path, value)
  value = type(value) == "table" and value or {}
  return store.update(path, function() return value end)
end

local function future(value, now)
  value = tonumber(value)
  return value and value > now and value or nil
end

local function manualCooldown(value)
  value = math.floor(tonumber(value) or 600)
  if value < 600 then value = 600 end
  if value > 604800 then value = 604800 end
  return value
end

function store.recordManual(path, row, now)
  row, now = type(row) == "table" and row or {}, tonumber(now) or 0
  local id = tostring(row.id or "")
  if id == "" then return false, "manual reservation requires an exact target id" end
  return store.update(path, function(out)
    if tonumber(out.updatedAt) and tonumber(out.updatedAt) > now then
      out = { path = path, generation = tonumber(out.generation) or 0 }
    end
    out.reservations = type(out.reservations) == "table" and out.reservations or {}
    local previous = type(out.reservations[id]) == "table" and out.reservations[id] or {}
    local generation = (tonumber(out.generation) or 0) + 1
    local state, phase = tostring(row.state or "none"), row.phase and tostring(row.phase) or nil
    local cooldownUntil = future(previous.cooldownUntil, now)
    local retryUntil = future(previous.retryUntil, now)
    if state == "running" and phase == "submitted" then
      local alreadySubmitted = previous.state == "running" and previous.phase == "submitted"
      if not alreadySubmitted then
        cooldownUntil = math.max(cooldownUntil or 0, now + manualCooldown(row.cooldown))
      end
      retryUntil = nil
    elseif state == "done" and not cooldownUntil then
      cooldownUntil = now + manualCooldown(row.cooldown)
      retryUntil = nil
    elseif state == "done" then
      retryUntil = nil
    elseif state == "accepted" or state == "blocked" or state == "failed" or state == "canceled" then
      retryUntil = math.max(retryUntil or 0, now + MANUAL_FAILURE_BACKOFF)
    end
    local saved = {}
    for key, value in pairs(row) do saved[key] = value end
    saved.id, saved.state, saved.phase = id, state, phase
    saved.generation, saved.updatedAt = generation, now
    saved.leaseUntil = state == "running" and (now + MANUAL_ACTIVE_LEASE) or now
    saved.cooldownUntil, saved.retryUntil = cooldownUntil, retryUntil
    for key, value in pairs(out.reservations) do
      if key ~= id and not (future(value.leaseUntil, now) or future(value.cooldownUntil, now)
          or future(value.retryUntil, now)) then out.reservations[key] = nil end
    end
    out.schemaVersion, out.generation, out.updatedAt = 1, generation, now
    out.reservations[id] = saved
    local newest = {}
    for key, value in pairs(out.reservations) do
      newest[#newest + 1] = { id = key, generation = tonumber(value.generation) or 0 }
    end
    table.sort(newest, function(a, b)
      if a.generation == b.generation then return a.id < b.id end
      return a.generation > b.generation
    end)
    for index = MAX_MANUAL_RESERVATIONS + 1, #newest do out.reservations[newest[index].id] = nil end
    return out
  end)
end

return store
-- Target identity and warm-report policy patching stay pure: no persistence or
-- AE2 component calls are allowed in this module.
local lineContract = require("oc.ae2.line_contract")
local binding = require("oc.ae2.request_binding")

local identity = {}

local function boolText(value) return tostring(value == true) end

local function kindFor(target)
  if not target then return "item" end
  if target.isFluid == true or target.kind == "fluid" then return "fluid" end
  local label = tostring(target.rawLabel or target.label or "")
  if label:find("^[Dd]rops? of%s+") then return "fluid" end
  return target.kind or "item"
end

local function variantLabel(target)
  target = target or {}
  local marker = binding.copyTaggedLabelBinding(target)
  if marker then return "raw=" .. marker.rawLabel end
  return tostring(target.rawLabel or target.label or target.name or "target"):lower()
end

local function labelKey(target)
  return tostring(target and (target.label or target.rawLabel or target.name) or ""):lower()
end

function identity.targetKey(target)
  target = target or {}
  if target.name then
    return tostring(kindFor(target)) .. ":" .. tostring(target.name) .. ":"
      .. tostring(target.damage or "") .. ":" .. boolText(target.hasTag) .. ":" .. variantLabel(target)
  end
  return tostring(target.label or target.rawLabel or "target"):lower()
end

function identity.queueId(target)
  target = target or {}
  if target.name then
    return tostring(kindFor(target)) .. ":" .. tostring(target.name) .. ":"
      .. tostring(math.floor(tonumber(target.damage) or 0)) .. ":" .. boolText(target.hasTag) .. ":" .. variantLabel(target)
  end
  return tostring(target.label or target.rawLabel or "target"):lower()
end

local function keySet(target)
  local keys = {}
  local function add(key) key = tostring(key or ""); if key ~= "" then keys[key] = true end end
  add(target and target.targetKey)
  add(target and target.id)
  add(identity.targetKey(target))
  add(identity.queueId(target))
  return keys
end

function identity.sameTarget(left, right)
  if not (left and right) then return false end
  if left.name and right.name then
    return tostring(kindFor(left)) == tostring(kindFor(right))
      and tostring(left.name) == tostring(right.name)
      and tostring(left.damage or "") == tostring(right.damage or "")
      and boolText(left.hasTag) == boolText(right.hasTag)
      and variantLabel(left) == variantLabel(right)
  end
  local wanted = keySet(left)
  for key in pairs(keySet(right)) do if wanted[key] then return true end end
  return not (left.name and right.name) and labelKey(left) ~= "" and labelKey(left) == labelKey(right)
end

function identity.workflowValue(target, field)
  local workflow = type(target and target.workflow) == "table" and target.workflow or {}
  if target and target[field] ~= nil then return target[field] end
  if field == "min" then return workflow.min or workflow.minStock end
  if field == "alertBelow" then return workflow.alertBelow or workflow.minStock or workflow.min end
  if field == "maxRequest" then return workflow.maxRequest or workflow.batch end
  return workflow[field]
end

function identity.targetSignature(targets)
  local parts = {}
  for index, target in ipairs(targets or {}) do
    parts[index] = identity.targetKey(target) .. "@" .. binding.stockAuthorityKey(target)
  end
  return table.concat(parts, "|")
end

function identity.configSignature(targets)
  local parts = {}
  for index, target in ipairs(targets or {}) do
    parts[index] = table.concat({
      identity.targetKey(target), binding.stockAuthorityKey(target),
      tostring(identity.workflowValue(target, "lineIntent") or ""),
      tostring(identity.workflowValue(target, "lineAuthority") or ""), tostring(identity.workflowValue(target, "alertEnabled")),
      tostring(identity.workflowValue(target, "alertBelow") or identity.workflowValue(target, "min") or ""),
      tostring(identity.workflowValue(target, "maxRequest") or identity.workflowValue(target, "batch") or ""),
      tostring(identity.workflowValue(target, "maxBasis") or ""),
      tostring(identity.workflowValue(target, "confidence") or ""),
      tostring(identity.workflowValue(target, "recipeMax") or ""),
      boolText(identity.workflowValue(target, "dangerUnlocked")),
      boolText(identity.workflowValue(target, "locked")),
      tostring(identity.workflowValue(target, "min") or ""),
      tostring(identity.workflowValue(target, "craftTo") or identity.workflowValue(target, "min") or ""),
      tostring(identity.workflowValue(target, "batch") or ""), tostring(identity.workflowValue(target, "minBatteryRatio") or ""),
      tostring(identity.workflowValue(target, "maxDeficitRatio") or ""), tostring(identity.workflowValue(target, "requireReadyCpu")),
      tostring(identity.workflowValue(target, "cooldown") or ""), boolText(identity.workflowValue(target, "armed"))
    }, ":")
  end
  return table.concat(parts, "|")
end

function identity.armedCount(targets)
  local count = 0
  for _, target in ipairs(targets or {}) do if identity.workflowValue(target, "armed") == true then count = count + 1 end end
  return count
end

local policyFields = {
  "workflowId", "configIndex", "label", "rawLabel", "name", "damage", "hasTag", "kind", "isFluid", "amount", "filter", "craftBinding", "stockBinding", "stockBindingError",
  "lineIntent", "lineAuthority", "alertEnabled", "alertBelow", "maxRequest", "maxBasis", "confidence",
  "recipeMax", "dangerUnlocked", "locked", "min", "craftTo", "batch", "minBatteryRatio",
  "maxDeficitRatio", "requireReadyCpu", "cooldown", "armed"
}
local identityFields = {
  workflowId = true, configIndex = true, label = true, rawLabel = true, name = true, damage = true, hasTag = true, kind = true, isFluid = true,
  amount = true, filter = true, craftBinding = true, stockBinding = true, stockBindingError = true
}
local replacePolicyFields = {
  maxBasis = true, confidence = true, recipeMax = true, dangerUnlocked = true, locked = true
}

function identity.patchPolicy(row, target)
  if not (row and target) then return row end
  for _, field in ipairs(policyFields) do
    local value = identity.workflowValue(target, field)
    if value ~= nil or identityFields[field] or replacePolicyFields[field] then row[field] = value end
  end
  row.label = row.label or target.label or target.rawLabel or target.name or "target"
  row.targetKey = identity.targetKey(target)
  return row
end

function identity.requestAmount(target)
  local amount = lineContract.requestAmount(target)
  return tonumber(amount) or 0
end

local function stockDerivedReason(reason)
  local text = tostring(reason or "")
  return text == "stock ready" or text == "stock refreshed; target already satisfied" or text:find("^stock%s+") ~= nil
end

function identity.refreshPolicyStock(row, waitReason)
  if not row then return row end
  local current, min = tonumber(row.current), tonumber(row.min)
  lineContract.annotate(row)
  local amount = tonumber(row.request) or identity.requestAmount(row)
  if current and min then
    amount = current >= min and 0 or amount
    if current < min and stockDerivedReason(row.reason) then
      row.ready, row.reason = false, waitReason or "waiting for daemon refresh"
      if row.requestState == "blocked" and row.requestPhase == "stock_satisfied" then
        row.requestState, row.requestPhase, row.requestStatusReason, row.requestError = "none", nil, nil, nil
      end
    elseif current >= min and stockDerivedReason(row.reason) then
      row.ready, row.reason = false, "stock ready"
    end
  end
  row.request = math.max(0, amount)
  return row
end

local function cpuFinalOutputTransient(row)
  if type(row) ~= "table" then return false end
  return row.requestPhase == "cpu_final_output" or row.phase == "cpu_final_output"
    or row.requestStatusReason == "AE2 CPU final output matches target"
    or tostring(row.reason or ""):find("^AE2 CPU final output in flight", 1, false) ~= nil
end

local function scrubCpuFinalOutputRow(row)
  if not cpuFinalOutputTransient(row) then return row end
  row.requestState, row.requestPhase, row.requestStatusReason, row.requestError, row.error = "none", nil, nil, nil, nil
  row.ready = false
  local current, min = tonumber(row.current), tonumber(row.min)
  row.reason = (current and min and current >= min) and "stock ready" or "waiting for daemon refresh"
  return identity.refreshPolicyStock(row, "waiting for daemon refresh")
end

function identity.scrubStartupWarmReport(report)
  if type(report) == "table" then for _, row in ipairs(report.targets or {}) do scrubCpuFinalOutputRow(row) end end
  return report
end

function identity.startupCarriedWarmReport(out)
  if type(out) ~= "table" or type(out.warmReport) ~= "table" then return false end
  local startedAt = tonumber(out.startedAt)
  if not startedAt then return false end
  local savedAt = tonumber(out.warmReport.savedAt)
  return savedAt == nil or savedAt < startedAt
end

function identity.scrubStartupCarriedWarmReport(out)
  if identity.startupCarriedWarmReport(out) then identity.scrubStartupWarmReport(out.warmReport) end
end

function identity.removeTargetStatus(out, target)
  local kept = {}
  for _, row in ipairs(out.targetStatus or {}) do if not identity.sameTarget(row, target) then kept[#kept + 1] = row end end
  out.targetStatus = kept
end

function identity.matchingTarget(targets, row)
  for _, target in ipairs(targets or {}) do if identity.sameTarget(row, target) then return target end end
  return nil
end

function identity.findWarmRow(rows, target, used)
  for index, row in ipairs(rows or {}) do
    if not used[index] and identity.sameTarget(row, target)
        and binding.stockAuthorityKey(row) == binding.stockAuthorityKey(target) then
      used[index] = true
      return row
    end
  end
  return nil
end

function identity.placeholderTarget(target)
  local row = { label = target and (target.label or target.rawLabel or target.name) or "target", craftable = false,
    ready = false, requestState = "blocked", reason = "waiting for daemon refresh" }
  identity.patchPolicy(row, target)
  row.current, row.request = nil, math.max(0, identity.requestAmount(target))
  return row
end

return identity
-- Compact durable report projection.  It only transforms already-observed
-- maintainer data, so it cannot create component work while persisting state.
local identity = require("oc.ae2.maintainer_state_identity")

local reports = {}
local SAFE_STOP_RECOVERY_SECONDS = 600

local function copyFluidProfile(value)
  if type(value) ~= "table" then return nil end
  return {
    mode = value.mode, canaryFluid = value.canaryFluid, topology = value.topology,
    topologyRevision = value.topologyRevision, hostId = value.hostId,
    lastTopologyRevision = value.lastTopologyRevision,
    fluidDiscretizerActive = value.fluidDiscretizerActive == true,
    noExternalAENetworkInventories = value.noExternalAENetworkInventories == true,
    configuredTargetsReviewed = value.configuredTargetsReviewed == true,
    reviewedFluidCount = value.reviewedFluidCount,
    reviewedFluidSignature = value.reviewedFluidSignature,
    locked = value.locked == true
  }
end

local function firstUsefulRow(report)
  local rows = type(report) == "table" and report.targets or {}
  for _, row in ipairs(rows or {}) do
    if row.requested or row.requestState == "failed" or row.requestState == "blocked" then return row end
  end
  for _, row in ipairs(rows or {}) do if row.armed then return row end end
  return (rows or {})[1]
end

local function quarantined(entry)
  if not entry then return false end
  local phase = tostring(entry.phase or "")
  return entry.quarantined == true or phase == "status_link_lost"
    or phase == "confirmation_unavailable" or phase == "reboot_recovery" or phase == "submit_intent"
end

local function dispatchVisible(entry)
  local status = tostring(entry and entry.status or "")
  local amount = tonumber(entry and entry.requestedAmount) or tonumber(entry and entry.amount) or 0
  return quarantined(entry) or amount > 0 and (status == "queued" or status == "in_flight" or status == "failed"
    or (status == "blocked" and entry
      and entry.phase == "missing_resources"))
end

local function ownershipClaim(entry)
  return entry and (tostring(entry.status or "") == "in_flight" or quarantined(entry))
end

local function firstVisibleDispatchEntry(report)
  local dispatch = type(report) == "table" and report.dispatch or {}
  for _, entry in ipairs((dispatch and dispatch.entries) or {}) do if dispatchVisible(entry) then return entry end end
  return nil
end

local function dispatchSummary(entry)
  if not entry then return nil end
  local status, reason = tostring(entry.status or ""), tostring(entry.reason or entry.statusReason or entry.phase or "unknown")
  if status == "in_flight" then return "in flight: " .. reason end
  if status == "queued" then return "queued: " .. reason end
  if status == "failed" then return "failed: " .. reason end
  return "blocked: " .. reason
end

local function copyDispatchRow(entry)
  local amount = quarantined(entry) and tonumber(entry.quarantineAmount) or nil
  if not amount or amount <= 0 then amount = tonumber(entry.requestedAmount) or tonumber(entry.amount) or 0 end
  return {
        id = entry.id, label = entry.label, amount = amount,
        current = entry.current or (entry.row and entry.row.current),
        min = entry.min or entry.stockBelow or (entry.row and entry.row.min),
        alertBelow = entry.alertBelow or entry.stockBelow or (entry.row and entry.row.alertBelow),
        maxRequest = entry.maxRequest or (entry.row and entry.row.maxRequest),
        lineIntent = entry.lineIntent or (entry.row and entry.row.lineIntent),
        lineAuthority = entry.lineAuthority or (entry.row and entry.row.lineAuthority),
        lineState = entry.lineState or (entry.row and entry.row.lineState),
        lineReason = entry.lineReason or (entry.row and entry.row.lineReason),
        maxBasis = entry.maxBasis or (entry.row and entry.row.maxBasis), confidence = entry.confidence or (entry.row and entry.row.confidence),
        status = entry.status, reason = entry.reason, phase = entry.phase, statusReason = entry.statusReason,
        nextEligibleAt = entry.nextEligibleAt, attempts = entry.attempts,
        ownershipReservationUntil = entry.ownershipReservationUntil,
        quarantined = quarantined(entry), retryKind = entry.retryKind,
        outcome = entry.outcome, queueAdvance = entry.queueAdvance
      }
end

local function copyTargetStatus(dispatch)
  local rows = {}
  local function append(entry) if dispatchVisible(entry) then rows[#rows + 1] = copyDispatchRow(entry) end end
  local entries = (dispatch and dispatch.entries) or {}
  -- Exceptional ownership rows must survive the 24-row operator projection;
  -- otherwise a long healthy queue hides the exact target that needs review.
  for _, entry in ipairs(entries) do
    if #rows >= 24 then break end
    if quarantined(entry) then append(entry) end
  end
  for _, entry in ipairs(entries) do
    if #rows >= 24 then break end
    if not quarantined(entry) then append(entry) end
  end
  return rows
end

local function copyOwnershipClaims(dispatch)
  local rows = {}
  for _, entry in ipairs((dispatch and dispatch.entries) or {}) do
    if ownershipClaim(entry) then rows[#rows + 1] = copyDispatchRow(entry) end
  end
  return rows
end

local function mergeRow(previous, replacement)
  local merged = {}
  for key, value in pairs(previous or {}) do merged[key] = value end
  for key, value in pairs(replacement or {}) do
    if value ~= nil and (key ~= "amount" or (tonumber(value) or 0) > 0 or merged.amount == nil) then merged[key] = value end
  end
  return merged
end

local function mergePollTargetStatus(previous, dispatch)
  local projected = copyTargetStatus(dispatch)
  local updates, used, candidates, rows = {}, {}, {}, {}
  local retainInFlight = #((dispatch and dispatch.entries) or {}) == 0
    and (tonumber(dispatch and dispatch.inFlightCount) or 0) > 0
  for _, entry in ipairs((dispatch and dispatch.entries) or {}) do
    if entry.id ~= nil then updates[tostring(entry.id)] = entry end
  end
  local projectedById = {}
  for _, row in ipairs(projected) do projectedById[tostring(row.id)] = row end
  for _, row in ipairs(previous or {}) do
    local id = row.id ~= nil and tostring(row.id) or nil
    local touched = id and updates[id] or nil
    local replacement = id and projectedById[id] or nil
    if replacement then
      candidates[#candidates + 1] = mergeRow(row, replacement)
      used[id] = true
    elseif not touched and (row.status ~= "in_flight" or retainInFlight) then
      candidates[#candidates + 1] = row
    end
  end
  for _, row in ipairs(projected) do
    local id = tostring(row.id)
    if not used[id] then candidates[#candidates + 1] = row end
  end
  for _, row in ipairs(candidates) do if #rows < 24 and quarantined(row) then rows[#rows + 1] = row end end
  for _, row in ipairs(candidates) do if #rows < 24 and not quarantined(row) then rows[#rows + 1] = row end end
  return rows
end

local function retainOwnershipRows(rows)
  local retained = {}
  for _, row in ipairs(rows or {}) do
    if ownershipClaim(row) then retained[#retained + 1] = row end
  end
  return retained
end


local function mergeOwnershipClaims(previous, dispatch, now, retainUntouched)
  local projected, updates, projectedById, used, rows = copyOwnershipClaims(dispatch), {}, {}, {}, {}
  for _, entry in ipairs((dispatch and dispatch.entries) or {}) do
    if entry.id ~= nil then updates[tostring(entry.id)] = entry end
  end
  for _, row in ipairs(projected) do projectedById[tostring(row.id)] = row end
  for _, row in ipairs(previous or {}) do
    local id = row.id ~= nil and tostring(row.id) or nil
    local replacement = id and projectedById[id] or nil
    if replacement then rows[#rows + 1], used[id] = mergeRow(row, replacement), true
    elseif not (id and updates[id]) and (retainUntouched or (tonumber(row.nextEligibleAt) or 0) > (tonumber(now) or 0)) then
      rows[#rows + 1] = row
    end
  end
  for _, row in ipairs(projected) do
    local id = tostring(row.id)
    if not used[id] then rows[#rows + 1] = row end
  end
  return rows
end

local function safeStopReceiptState(out, serial)
  local state = type(out.safeStopOwnership) == "table" and out.safeStopOwnership or nil
  if not state or tonumber(state.serial) ~= serial then
    state = { serial = serial, receipts = {} }
    out.safeStopOwnership = state
  end
  state.receipts = type(state.receipts) == "table" and state.receipts or {}
  return state
end

-- Safe Stop has no authority over foreign CPU work, so an owner claim whose
-- tracker vanished needs a bounded, restart-stable local resolution path.  A
-- receipt suppresses the same stale poll projection for the remainder of this
-- exact Safe Stop serial; a later operator transaction starts a fresh window.
local function resolveSafeStopClaims(out, claims, dispatch, now)
  local serial = tonumber(dispatch and dispatch.safeStopSerial)
  if not serial or serial < 1 then return claims end
  now = tonumber(now) or 0
  local state = safeStopReceiptState(out, serial)
  local receipts = state.receipts
  local current = {}
  for _, entry in ipairs((dispatch and dispatch.entries) or {}) do
    if entry.id ~= nil then current[tostring(entry.id)] = entry end
  end
  local retained = {}
  for _, row in ipairs(claims or {}) do
    local id = row.id ~= nil and tostring(row.id) or nil
    if not id then
      retained[#retained + 1] = row
    elseif receipts[id] then
      -- Verified release is authoritative for this serial even if an orphaned
      -- in-memory queue projection is replayed after the durable write.
    else
      local live = current[id]
      local liveInFlight = live and tostring(live.status or "") == "in_flight"
      if liveInFlight then
        retained[#retained + 1] = row
      else
        local boundary = tonumber(row.safeStopRecoveryUntil)
        if tonumber(row.safeStopSerial) ~= serial or not boundary
            or boundary > now + SAFE_STOP_RECOVERY_SECONDS then
          boundary = now + SAFE_STOP_RECOVERY_SECONDS
          row.safeStopSerial = serial
          row.safeStopRecoveryUntil = boundary
          row.nextEligibleAt = boundary
          if tostring(row.status or "") == "in_flight" then
            row.status, row.phase, row.quarantined = "blocked", "confirmation_unavailable", true
            row.statusReason = "request tracker disappeared during Safe Stop; ownership confirmation unavailable"
            row.reason = row.statusReason
          end
        end
        if boundary > now then
          retained[#retained + 1] = row
        else
          receipts[id] = {
            phase = "ownership_relinquished", resolvedAt = now
          }
        end
      end
    end
  end
  return retained
end

local function suppressReleasedTargetRows(rows, out, dispatch)
  local serial = tonumber(dispatch and dispatch.safeStopSerial)
  local state = type(out.safeStopOwnership) == "table" and out.safeStopOwnership or nil
  local receipts = state and tonumber(state.serial) == serial and state.receipts or nil
  if type(receipts) ~= "table" then return rows end
  local retained = {}
  for _, row in ipairs(rows or {}) do
    local id = row.id ~= nil and tostring(row.id) or nil
    if not (id and receipts[id]) then retained[#retained + 1] = row end
  end
  return retained
end

local function ownershipSummary(claims, queueCount)
  local count, retryAt = 0, nil
  for _, row in ipairs(claims or {}) do
    if quarantined(row) then
      count = count + 1
      local boundary = tonumber(row.safeStopRecoveryUntil) or tonumber(row.nextEligibleAt)
      if boundary then retryAt = retryAt and math.min(retryAt, boundary) or boundary end
    end
  end
  local noun = count == 1 and " target" or " targets"
  local reason = count > 0 and (tostring(count) .. noun .. " quarantined"
    .. ((tonumber(queueCount) or 0) > 0 and "; unrelated queue continues" or "; waiting for target retry boundary")) or false
  if count > 24 then reason = reason .. "; showing 24" end
  return count, retryAt or false, reason
end

local function copyStatus(status)
  status = status or {}
  local power = type(status.power) == "table" and status.power or {}
  local primary = type(status.ae2Primary) == "table" and status.ae2Primary or nil
  if not (primary and type(primary.address) == "string" and primary.address ~= "") then primary = nil end
  return {
    mode = status.mode, complete = status.complete == true, autoEnabled = status.autoEnabled ~= false,
    craftCompatibility = status.craftCompatibility, craftApiMode = status.craftApiMode,
    fluidStockCompatibility = copyFluidProfile(status.fluidStockCompatibility),
    ae2Online = status.ae2Online,
    ae2Primary = primary and { address = primary.address, type = primary.type } or nil,
    readyCpus = status.readyCpus, totalCpus = status.totalCpus, cpuPolicy = status.cpuPolicy,
    activeCraftCount = status.activeCraftCount, activeCraftScannedCpus = status.activeCraftScannedCpus,
    activeCraftBusyCpus = status.activeCraftBusyCpus, activeCraftFinalOutputs = status.activeCraftFinalOutputs,
    activeCraftFinalOutputErrors = status.activeCraftFinalOutputErrors, activeCraftFinalOutputError = status.activeCraftFinalOutputError,
    activeCraftFinalOutputErrorCpu = status.activeCraftFinalOutputErrorCpu, craftables = status.craftables,
    requestReady = status.requestReady, armedTargets = status.armedTargets, targetCount = status.targetCount,
    power = { available = power.available, ratio = power.ratio, avgIn = power.avgIn, avgOut = power.avgOut,
      deficit = power.deficit, status = power.status }
  }
end

local function copyTarget(row)
  row = row or {}
  return {
    workflowId = row.workflowId, configIndex = row.configIndex,
    label = row.label, rawLabel = row.rawLabel, name = row.name, damage = row.damage, hasTag = row.hasTag,
    kind = row.kind, isFluid = row.isFluid, amount = row.maxRequest or row.batch or row.request or row.amount,
    filter = row.filter, craftBinding = row.craftBinding, stockBinding = row.stockBinding,
    stockBindingError = row.stockBindingError,
    current = row.current, min = row.min,
    alertBelow = row.alertBelow, craftTo = row.craftTo,
    batch = row.batch, maxRequest = row.maxRequest, lineIntent = row.lineIntent, lineAuthority = row.lineAuthority,
    alertEnabled = row.alertEnabled, lineState = row.lineState, lineReason = row.lineReason, maxBasis = row.maxBasis,
    confidence = row.confidence, recipeMax = row.recipeMax, dangerUnlocked = row.dangerUnlocked, locked = row.locked,
    request = row.request, craftable = row.craftable, minBatteryRatio = row.minBatteryRatio,
    maxDeficitRatio = row.maxDeficitRatio, requireReadyCpu = row.requireReadyCpu, cooldown = row.cooldown,
    armed = row.armed, ready = row.ready, requestState = row.requestState, requestPhase = row.requestPhase,
    requestStatusReason = row.requestStatusReason, requestStatusRawReason = row.requestStatusRawReason,
    stockMemoryAt = row.stockMemoryAt, stockMemorySource = row.stockMemorySource,
    stockMemoryFresh = row.stockMemoryFresh == true, stockMemoryAge = row.stockMemoryAge,
    stockMemoryReason = row.stockMemoryReason,
    requestError = row.requestError, reason = row.reason,
    error = row.error, targetKey = row.targetKey or identity.targetKey(row)
  }
end

function reports.compactWarmReport(report, now)
  if not (report and report.status and report.status.complete == true) then return nil end
  local cache, targets = type(report.cache) == "table" and report.cache or {}, report.targets or {}
  local configuredTargets = type(report.config) == "table" and type(report.config.targets) == "table"
    and report.config.targets or targets
  local out = {
    savedAt = now, signature = cache.signature or identity.configSignature(targets),
    targetSignature = cache.targetSignature or identity.targetSignature(targets),
    -- Rendered rows can contain derived max-basis/confidence values. Sign the
    -- configured authority so Dashboard compares like-for-like policy state.
    policySignature = identity.configSignature(configuredTargets), status = copyStatus(report.status),
    targets = {}, alerts = report.alerts or {}, message = report.message
  }
  for _, row in ipairs(targets) do out.targets[#out.targets + 1] = copyTarget(row) end
  return out
end

function reports.recordTick(out, report, interval, ok, err, nextCycleAt, generation, now)
  identity.scrubStartupCarriedWarmReport(out)
  local reportTable = type(report) == "table" and report or nil
  local dispatch = reportTable and reportTable.dispatch or {}
  local warming = reportTable and reportTable.status and reportTable.status.complete == false
  local pollOnly = dispatch.pollOnly == true
  local failedTick = ok ~= true or reportTable == nil
  out.daemonInterval = tonumber(interval) or out.daemonInterval or 30
  out.generation = tonumber(generation) or out.generation
  out.workerState = "running"
  out.tickCount, out.lastTick = (tonumber(out.tickCount) or 0) + 1, now
  out.nextCycleAt = tonumber(nextCycleAt) or (now + out.daemonInterval)
  out.lastMode = reportTable and reportTable.status and reportTable.status.mode or out.lastMode
  out.detectedCpuCount = dispatch.detectedCpuCount or dispatch.cpuCount or out.detectedCpuCount
  out.busyCpuCount = dispatch.busyCpuCount or out.busyCpuCount
  if failedTick then
    -- An exception or malformed tick has no authority to replace the last
    -- complete ownership projection. Publish the error below, but retain the
    -- queue/in-flight evidence needed to prevent false-empty diagnostics.
    out.inFlightCount = out.inFlightCount or 0
    out.availableSlots = out.availableSlots or 0
    out.queueCount = out.queueCount or 0
    out.targetStatus = out.targetStatus or {}
    out.ownershipClaims = out.ownershipClaims or {}
  elseif pollOnly then
    out.inFlightCount = dispatch.inFlightCount or out.inFlightCount or 0
    out.availableSlots = out.availableSlots or 0
    out.queueCount = dispatch.queueQuiesced == true and 0 or out.queueCount or 0
    out.targetStatus = mergePollTargetStatus(out.targetStatus, dispatch)
    if dispatch.queueQuiesced == true then
      out.targetStatus = retainOwnershipRows(out.targetStatus)
    end
    out.ownershipClaims = mergeOwnershipClaims(out.ownershipClaims, dispatch, now, true)
    out.ownershipClaims = resolveSafeStopClaims(out, out.ownershipClaims, dispatch, now)
    out.targetStatus = suppressReleasedTargetRows(out.targetStatus, out, dispatch)
  elseif not warming then
    out.inFlightCount = dispatch.inFlightCount or 0
    out.availableSlots = dispatch.availableSlots or 0
    out.queueCount = dispatch.queueCount or 0
    out.targetStatus = copyTargetStatus(dispatch)
    local armed = reportTable.status.mode == "armed" and reportTable.status.autoEnabled ~= false
    out.ownershipClaims = mergeOwnershipClaims(out.ownershipClaims, dispatch, now, not armed)
  else
    -- A bounded stock slice is an incomplete planner observation, not proof
    -- that queued work disappeared. Keep the last complete queue projection
    -- until the new pass can replace it atomically.
    out.inFlightCount = out.inFlightCount or 0
    out.availableSlots = out.availableSlots or 0
    out.queueCount = out.queueCount or 0
    out.targetStatus = out.targetStatus or {}
    out.ownershipClaims = out.ownershipClaims or {}
  end
  -- Queue ownership is an independently annotated state machine. Poll-only
  -- lifecycle reports must retain the last planner projection unless the
  -- daemon explicitly publishes a replacement (including a deliberate false).
  if not failedTick then
    local completeEmpty = not pollOnly and reportTable and reportTable.status
      and reportTable.status.complete == true
      and (tonumber(out.queueCount) or 0) <= 0 and (tonumber(out.inFlightCount) or 0) <= 0
    if completeEmpty then
      -- A complete empty planner observation authoritatively releases queue
      -- ownership even when a caller omits the daemon's explicit false values.
      -- Poll-only/incomplete observations remain overlays and retain them.
      if dispatch.queuePhase == nil then out.queuePhase = "idle" end
      if dispatch.queuePausedReason == nil then out.queuePausedReason = false end
      if dispatch.refillSuppressed == nil then out.refillSuppressed = false end
      if dispatch.queueHeadId == nil then out.queueHeadId = false end
    end
    if dispatch.queuePhase ~= nil then out.queuePhase = dispatch.queuePhase end
    if dispatch.queuePausedReason ~= nil then out.queuePausedReason = dispatch.queuePausedReason end
    if dispatch.queueStatusReason ~= nil then out.queueStatusReason = dispatch.queueStatusReason end
    if dispatch.refillSuppressed ~= nil then out.refillSuppressed = dispatch.refillSuppressed end
    if dispatch.queueHeadId ~= nil then out.queueHeadId = dispatch.queueHeadId end
    local count, retryAt, statusReason = ownershipSummary(out.ownershipClaims, out.queueCount)
    out.ownershipQuarantineCount, out.ownershipRetryAt, out.queueStatusReason = count, retryAt, statusReason
    if count > 0 and (tonumber(out.queueCount) or 0) <= 0 and (tonumber(out.inFlightCount) or 0) <= 0 then
      out.queuePhase, out.queuePausedReason, out.refillSuppressed = "waiting_retry", false, false
    end
  end
  if not failedTick and reportTable and reportTable.status and reportTable.status.complete == true then
    out.warmReport = reports.compactWarmReport(reportTable, now)
  end
  if failedTick then
    local tickError = ok == true and "daemon tick returned no report" or tostring(err or "daemon tick failed")
    out.lastSubmitFail, out.lastError, out.lastStatus = now, tickError, "daemon error"
    return out
  end
  local attempts = reportTable and reportTable.requestAttempts
  local attempt = attempts and attempts[#attempts] or reportTable and reportTable.requestAttempt
  if attempt then
    out.lastSubmitAttempt, out.lastSubmitTarget = now, tostring(attempt.label or "target")
    out.lastSubmitAmount, out.lastSubmitPhase = tonumber(attempt.amount) or 0, attempt.phase
    out.lastSubmitReason = attempt.reason or attempt.err
    out.lastSubmitRawReason = attempt.rawReason
    if attempt.skipped == true or (attempt.state == "blocked" and attempt.phase == "cpu_final_output") then
      out.lastSubmitFail, out.lastError, out.lastStatus = nil, nil, tostring(attempt.message or "auto request skipped")
    elseif attempt.done == true or attempt.state == "done" then
      out.lastSubmitOk, out.lastSubmitFail = now, nil
      out.lastError, out.lastStatus = nil, tostring(attempt.message or "auto request completed")
    elseif attempt.pending == true
      or (attempt.started == true and attempt.state == "running" and attempt.phase == "computing") then
      out.lastError, out.lastStatus = nil, tostring(attempt.message or "auto request planning; no CPU assigned yet")
    elseif attempt.uncertain == true or attempt.state == "accepted" then
      out.lastError, out.lastStatus = nil, tostring(attempt.message or "auto request confirmation unavailable")
    elseif attempt.ok then
      out.lastSubmitOk, out.lastSubmitFail = now, nil
      out.lastError, out.lastStatus = nil, tostring(attempt.message or "auto request accepted by AE2")
    elseif attempt.pendingResult == true then
      out.lastError, out.lastStatus = nil,
        tostring(attempt.message or "auto request result awaiting durable publication")
    else
      out.lastSubmitFail = now
      out.lastError, out.lastStatus = tostring(attempt.message or "auto request failed"), tostring(attempt.message or "auto request failed")
    end
    if attempt.persistencePending == true then
      out.lastStatus = tostring(out.lastStatus or "auto request result") .. " | lifecycle persistence pending"
    end
  else
    local entry, row = firstVisibleDispatchEntry(reportTable), nil
    if not entry then row = firstUsefulRow(reportTable) end
    out.lastStatus = dispatchSummary(entry) or (row and ("blocked: " .. tostring(row.reason or row.requestState or "unknown")))
      or tostring(reportTable and reportTable.message or "no maintainer targets")
  end
  return out
end

return reports
local computer = require("computer")

local cacheEpoch = require("oc.ae2.cache_epoch")
local craftRequests = require("oc.ae2.craft_requests")
local lineContract = require("oc.ae2.line_contract")
local cpuWitness = require("oc.ae2.maintainer_cpu_witness")
local maintainerLog = require("oc.ae2.maintainer_log")
local maintainerQueue = require("oc.ae2.maintainer_queue")
local queueOwnership = require("oc.ae2.maintainer_queue_ownership")
local requestWitness = require("oc.ae2.maintainer_requests_witness")
local _, maintainerState = pcall(require, "oc.ae2.maintainer_state")
local requester = require("oc.ae2.requester")
local requestTracker = require("oc.ae2.request_tracker")
local stockExact = require("oc.ae2.stock_exact")
local time = require("oc.ae2.time")

local requests = {}
local OUTCOME_SESSION = tostring({})
local outcomeSequence = 0
local pendingOutcome = nil

local function beginOutcome(entry, now)
  if not entry then return nil end
  now = tonumber(now) or computer.uptime()
  if not entry.outcomeKey then
    outcomeSequence = outcomeSequence + 1
    entry.outcomeKey = table.concat({ "auto", OUTCOME_SESSION, tostring(entry.id or entry.label or "target"),
      tostring(now), tostring(outcomeSequence) }, "|")
  end
  entry.attemptedAt = tonumber(entry.attemptedAt) or now
  return entry.outcomeKey
end

local function outcomeDisposition(attempt)
  local state, phase, outcome = attempt and attempt.state, attempt and attempt.phase, attempt and attempt.outcome
  if outcome == "completed" then return "completed" end
  if outcome == "safety_hold" then return "safety_hold" end
  if outcome == "already_in_flight" then return "covered" end
  if state == "canceled" then return "canceled" end
  if outcome == "kickout" and phase ~= "stock_satisfied" then return "kickout" end
  if state == "done" then return "completed" end
  if phase == "status_link_lost" or phase == "daemon_authority" or state == "accepted" then return "safety_hold" end
  if phase == "cpu_final_output" and attempt and attempt.skipped == true then return "covered" end
  if phase == "stock_satisfied" then return "skipped" end
  return "kickout"
end

local function publishOutcome(row, entry, attempt, now, memory, submittedAt, requestKey)
  if not (row and entry and attempt) then return false, "outcome context unavailable" end
  now = tonumber(now) or computer.uptime()
  beginOutcome(entry, now)
  local disposition = outcomeDisposition(attempt)
  local eligibleAt = tonumber(memory and memory.nextEligibleAt)
  local retryKind = (disposition == "completed" or disposition == "skipped") and "cooldown"
    or disposition == "safety_hold" and "safety_hold"
    or (disposition == "kickout" or disposition == "canceled") and eligibleAt and "backoff" or "none"
  local details = {
    eventKey = entry.outcomeKey,
    disposition = disposition,
    source = "auto",
    targetId = entry.id,
    requestKey = requestKey or entry.id,
    attemptedAt = entry.attemptedAt,
    submittedAt = submittedAt,
    amount = tonumber(attempt.amount) or tonumber(entry.requestedAmount) or 0,
    state = attempt.state,
    phase = attempt.phase,
    reason = attempt.reason,
    rawReason = attempt.rawReason,
    attempts = tonumber(memory and memory.attempts) or 0,
    retryKind = retryKind,
    retrySeconds = eligibleAt and math.max(0, eligibleAt - now) or 0,
    nextEligibleAt = eligibleAt
  }
  local logged, logErr = maintainerLog.appendOutcome(row, now, details)
  attempt.disposition = disposition
  attempt.outcomeKey = entry.outcomeKey
  attempt.outcomeLogged = logged == true
  attempt.outcomeError = logErr
  if logged ~= true then
    pendingOutcome = { source = row, now = now, details = details }
    attempt.pendingResult, attempt.persistencePending, attempt.queueAdvance = true, true, false
    attempt.outcomePersistencePending = true
  elseif pendingOutcome and pendingOutcome.details.eventKey == details.eventKey then
    pendingOutcome = nil
  end
  row.outcomeLogError = logged and nil or logErr
  return logged == true, logErr
end

local function flushPendingOutcome(report, options)
  if not pendingOutcome then return true end
  local item = pendingOutcome
  local logged, logErr = maintainerLog.appendOutcome(item.source, item.now, item.details)
  if logged == true then
    item.source.outcomeLogError, pendingOutcome = nil, nil
    return true
  end
  item.source.outcomeLogError = logErr
  local details = item.details
  local attempt = {
    id = details.targetId, label = item.source.label, amount = details.amount,
    ok = false, state = details.state, phase = details.phase,
    reason = details.reason, rawReason = details.rawReason,
    disposition = details.disposition, outcomeKey = details.eventKey,
    attemptedAt = details.attemptedAt, nextEligibleAt = details.nextEligibleAt,
    outcomeLogged = false, outcomeError = logErr, queueAdvance = false,
    pendingResult = true, persistencePending = true,
    outcomePersistencePending = true,
    message = "Outcome ledger persistence pending: " .. tostring(logErr or "write failed")
  }
  local dispatch = maintainerQueue.build(report, options)
  dispatch.maxSubmits, dispatch.remainingSlots = 0, 0
  dispatch.outcomePersistencePending = true
  dispatch.queuePausedReason = attempt.message
  report.dispatch, report.requestAttempts, report.requestAttempt = dispatch, { attempt }, attempt
  report.message = attempt.message
  report.requestBlocker = { id = attempt.id, state = "blocked", phase = "outcome_persistence",
    reason = attempt.message, outcome = "safety_hold" }
  return false
end

local function targetKey(target)
  if type(target) == "table" then return maintainerQueue.id(target) end
  return tostring(target or "")
end

local function targetLabel(target)
  if type(target) == "table" then return tostring(target.label or target.rawLabel or target.name or "") end
  return tostring(target or "")
end

local function fluidLike(row)
  local name = tostring(row and row.name or ""):lower()
  local raw = tostring(row and row.rawLabel or ""):lower()
  return row and (row.isFluid == true or row.kind == "fluid"
    or name:find("fluid", 1, true) ~= nil or raw:find("^drops? of") ~= nil)
end

local function requestReceipt(prefix, row, amount)
  local label = targetLabel(row)
  return time.receipt(prefix, label, amount, fluidLike(row))
end

local function confirmed(report)
  return report and report.requestState == "running" and report.requestPhase == "submitted"
end

local function applyQueueTransition(attempt, entry, memory)
  if not attempt then return end
  attempt.outcome = entry and entry.outcome or memory and memory.outcome or attempt.outcome
  local queueAdvance = entry and entry.queueAdvance
  if queueAdvance == nil and memory then queueAdvance = memory.queueAdvance end
  if queueAdvance ~= nil then attempt.queueAdvance = queueAdvance == true end
  attempt.nextEligibleAt = memory and memory.nextEligibleAt or entry and entry.nextEligibleAt
  local phase = entry and entry.phase or memory and memory.phase
  local reason = entry and entry.statusReason or memory and memory.statusReason
  if phase then attempt.phase = phase end
  if reason then attempt.reason = reason end
end

local function receiptPrefix(status, report)
  local state, phase = report and report.requestState, report and report.requestPhase
  if state == "running" and phase == "computing" then return "Auto request planning: " end
  if confirmed(report) then return "Auto request accepted by AE2: " end
  if state == "done" then return "Auto request completed: " end
  if state == "accepted" then return "Auto request returned (confirmation unavailable): " end
  if state == "blocked" then return "Auto request blocked: " end
  if state == "canceled" then return "Auto request canceled: " end
  return status and "Auto request accepted: " or "Auto request failed for "
end

local function requestOptions(row, entry, dispatch, now, daemonGeneration, craftCompatibility)
  return {
    prioritizePower = true,
    daemonGeneration = daemonGeneration,
    craftCompatibility = craftCompatibility,
    maxInFlight = dispatch.cpuCount,
    beforeInvoke = function()
      return queueOwnership.prepareAutoIntent(maintainerState,
        maintainerQueue.state, row, entry, daemonGeneration, computer.uptime())
    end,
    track = { id = entry.id, amount = entry.requestedAmount, submittedAt = now,
      attemptedAt = entry.attemptedAt or now, outcomeKey = entry.outcomeKey,
      label = row.label, source = "auto", target = row }
  }
end

local function logBatch(row, entry, report, now, submittedAt)
  local logged, logErr = maintainerLog.append(row, now, {
    amount = entry and entry.requestedAmount,
    source = "auto",
    requestKey = report and report.requestKey or entry and entry.id,
    submittedAt = tonumber(submittedAt) or now
  })
  if logged and requestTracker.markAuditLogged then
    row.logError = nil
    requestTracker.markAuditLogged(report and report.requestKey or entry and entry.id)
  elseif not logged then
    row.logError = logErr
  end
  return logged == true
end

local function recordAutoState(method, row, now, report)
  if type(maintainerState) ~= "table"
      or type(maintainerState[method]) ~= "function" then
    row.logError = "maintainer lifecycle state unavailable"
    return false
  end
  local called, saved, saveErr = pcall(maintainerState[method], row, now, report)
  if not called or saved ~= true then
    row.logError = tostring(saveErr or saved or "maintainer lifecycle state save failed")
    return false
  end
  return true
end

local function refreshStockBeforeSubmit(report, row, entry)
  local context = type(report and report.cache) == "table"
    and type(report.cache.context) == "table" and report.cache.context or {}
  local primary = report and report.status and report.status.ae2Primary or context.primary
  local refreshed, err, stockReport = stockExact.refresh(row, primary, {
    tagged = context.taggedStock,
    fluidFallback = context.fluidFallback
  })
  if not refreshed then
    if entry then entry.requestedAmount, entry.current = 0, nil end
    if row then
      row.request, row.current = 0, nil
      row.requestError = "stock refresh failed: " .. tostring(err or "unavailable")
      row.stockMemoryFresh = false
      row.stockMemoryReason = row.requestError
      row.stockDirectCalls = stockReport and stockReport.calls or 0
    end
    return false, requestWitness.blockEntry(row, entry, "stock_refresh",
      row and row.requestError or "stock refresh failed", requestReceipt)
  end
  row.current = refreshed.current
  entry.current = row.current
  row.stockMemoryAt, row.stockMemorySource = refreshed.at, refreshed.source
  row.stockMemoryFresh, row.stockMemoryAge = true, 0
  row.stockMemoryReason, row.requestError, row.error = nil, nil, nil
  row.stockDirectCalls = stockReport and stockReport.calls or 0
  row.alertBelow = tonumber(row.alertBelow or row.min or (entry and entry.stockBelow)) or 0
  row.maxRequest = tonumber(row.maxRequest or row.batch or (entry and entry.maxRequest) or (entry and entry.batch) or row.request) or 0
  row.min, row.batch = row.alertBelow, row.maxRequest
  lineContract.annotate(row)
  local amount = tonumber(row.request) or 0
  entry.requestedAmount = amount
  entry.lineState, entry.lineReason = row.lineState, row.lineReason
  if amount <= 0 then
    local phase = row.lineState == "danger_locked" and "danger_locked" or "stock_satisfied"
    local reason = row.lineState == "satisfied" and "stock refreshed; target already satisfied"
      or row.lineReason or "line contract blocked after stock refresh"
    return false, requestWitness.blockEntry(row, entry, phase, reason, requestReceipt)
  end
  return true
end

function requests.state(target, activeRequests)
  local key = targetKey(target)
  local label = targetLabel(target)
  local tracked = requestTracker.status(key)
  if tracked.state == "none" and label ~= "" and label ~= key then tracked = requestTracker.status(label) end
  if tracked.state ~= "none" then return tracked end
  local request = activeRequests and (activeRequests[key] or activeRequests[label])
  if not request then return "none" end
  local status = craftRequests.requestStatus(request)
  if status.done or status.canceled then
    activeRequests[key], activeRequests[label] = nil, nil
    return { state = status.canceled and "canceled" or "done", phase = status.canceled and "canceled" or "done" }
  end
  if status.error then
    activeRequests[key], activeRequests[label] = nil, nil
    return {
      state = status.state == "blocked" and "blocked" or "failed",
      phase = status.phase or (status.state == "blocked" and "missing_resources" or "failed"),
      reason = status.error
    }
  end
  return { state = "running", phase = status.computing and "computing" or "submitted" }
end

function requests.submit(report, activeRequests, lastRequestAt, options)
  report = type(report) == "table" and report or {}
  activeRequests = activeRequests or {}
  lastRequestAt = lastRequestAt or {}
  options = options or {}
  if not (report and report.status and report.status.complete == true) then
    report.dispatch = { entries = {}, ready = {}, queueCount = 0, readyQueueCount = 0, inFlightCount = 0, availableSlots = 0, maxSubmits = 0 }
    report.requestBlocker = { reason = "maintainer status still warming", state = "blocked" }
    return report
  end
  if not flushPendingOutcome(report, options) then return report end
  local witnessReady, witnessReason = requestWitness.refresh(report)
  if report.queueInvalidated == true or (options.requireFinalOutputWitness == true and not witnessReady) then
    return requestWitness.blockReport(report, options, witnessReason)
  end
  local dispatch = maintainerQueue.build(report, options)
  report.dispatch = dispatch
  report.requestAttempts = {}
  report.requestAttempt, report.requestBlocker = nil, nil
  if #(dispatch.ready or {}) <= 0 then
    if dispatch.submitCapHeld == true then dispatch.remainingSlots = 0 end
    report.requestBlocker = { reason = dispatch.queuePausedReason or "no CPU slots available", state = "blocked" }
    return report
  end
  local pending = {}
  for _, entry in ipairs(dispatch.ready or {}) do
    local row = entry.row
    if row and entry.requestedAmount > 0 then
      local selectedAmount = entry.requestedAmount
      beginOutcome(entry, computer.uptime())
      local refreshed, skipAttempt = refreshStockBeforeSubmit(report, row, entry)
      if not refreshed then
        local transitionAt = computer.uptime()
        local memory
        if skipAttempt.phase == "stock_refresh" then
          memory = maintainerQueue.markBlocked(entry, skipAttempt.reason, transitionAt, skipAttempt.phase)
        elseif skipAttempt.phase == "stock_satisfied" then
          memory = maintainerQueue.markSkipped(entry, transitionAt, skipAttempt.phase, skipAttempt.reason, "skipped")
        else
          memory = maintainerQueue.markSkipped(entry, transitionAt, skipAttempt.phase, skipAttempt.reason, "safety_hold")
        end
        skipAttempt.amount = selectedAmount
        skipAttempt.outcome, skipAttempt.queueAdvance = entry.outcome, entry.queueAdvance
        skipAttempt.nextEligibleAt = memory and memory.nextEligibleAt
        publishOutcome(row, entry, skipAttempt, transitionAt, memory)
        dispatch.queueAdvanceReady = skipAttempt.queueAdvance == true
        report.requestAttempts[#report.requestAttempts + 1] = skipAttempt
        report.requestAttempt = skipAttempt
        requestWitness.refreshDispatchCounts(dispatch)
      else
        pending[#pending + 1] = entry
      end
    end
  end
  if #pending > 0 then
    witnessReady, witnessReason = requestWitness.refresh(report)
    if report.queueInvalidated == true or (options.requireFinalOutputWitness == true and not witnessReady) then
      return requestWitness.blockReport(report, options, witnessReason)
    end
    local liveEntries, liveReady
    if witnessReady then
      dispatch = maintainerQueue.build(report, options)
      report.dispatch, liveEntries, liveReady = dispatch, {}, {}
      for _, entry in ipairs(dispatch.entries or {}) do liveEntries[entry.id] = entry end
      for _, entry in ipairs(dispatch.ready or {}) do liveReady[entry.id] = entry end
    end
    local submitReady = {}
    for _, entry in ipairs(pending) do
      local row = entry.row
      local currentEntry = liveEntries and liveEntries[entry.id] or entry
      currentEntry.outcomeKey = entry.outcomeKey
      currentEntry.attemptedAt = entry.attemptedAt
      local activeCraft = witnessReady and cpuWitness.find(report.status and report.status.activeCrafts, row) or nil
      if options.requireFinalOutputWitness == true and not witnessReady then
        local scanAttempt = requestWitness.blockEntry(row, currentEntry, "cpu_final_output_scan", witnessReason, requestReceipt)
        scanAttempt.queueAdvance = false
        report.requestAttempts[#report.requestAttempts + 1] = scanAttempt
        report.requestAttempt = scanAttempt
        requestWitness.refreshDispatchCounts(dispatch)
      elseif activeCraft then
        local activeAttempt = requestWitness.blockCpuFinalOutput(row, currentEntry, activeCraft, requestReceipt)
        activeAttempt.queueAdvance = (tonumber(dispatch.availableSlots) or 0) > 0
          or ((tonumber(dispatch.readyQueueCount) or 0) > 0 and (tonumber(dispatch.maxSubmits) or 0) > 0)
        report.requestAttempts[#report.requestAttempts + 1] = activeAttempt
        report.requestAttempt = activeAttempt
        publishOutcome(row, currentEntry, activeAttempt, computer.uptime())
        requestWitness.refreshDispatchCounts(dispatch)
      elseif not liveReady or liveReady[entry.id] then
        submitReady[#submitReady + 1] = liveReady and liveReady[entry.id] or currentEntry
      end
    end
    local submitted, submitCalls = {}, 0
    for _, entry in ipairs(submitReady) do
      if submitCalls >= dispatch.maxSubmits then break end
      local row = entry.row
      local now = computer.uptime()
      beginOutcome(entry, now)
      submitCalls = submitCalls + 1
      local status, err, lastReport = requester.requestTarget(row, entry.requestedAmount,
        requestOptions(row, entry, dispatch, now, options.daemonGeneration,
          report.config and report.config.craftCompatibility))
      lastReport = lastReport or requester.lastReport() or {}
      local transitionAt = computer.uptime()
      row.requested = status ~= nil
      row.requestError = err
      row.requestState = lastReport.requestState or (status and "running" or "failed")
      row.requestPhase = lastReport.requestPhase
      row.requestStatusReason = lastReport.requestStatusReason
      row.requestStatusRawReason = lastReport.requestStatusRawReason
      local attempt = {
        label = row.label,
        amount = entry.requestedAmount,
        ok = confirmed(lastReport),
        started = status ~= nil,
        pending = lastReport.requestPending == true,
        pendingResult = lastReport.pendingResult == true,
        done = row.requestState == "done",
        uncertain = lastReport.requestUnverified == true,
        err = err,
        state = row.requestState,
        phase = row.requestPhase,
        reason = row.requestStatusReason,
        rawReason = row.requestStatusRawReason,
        outcomeKey = entry.outcomeKey,
        attemptedAt = entry.attemptedAt,
        craftResolutionMode = lastReport.mode,
        compatibilityCalls = math.max(0, tonumber(lastReport.compatibilityCalls) or 0),
        legacyCraftTraversal = (tonumber(lastReport.compatibilityCalls) or 0) > 0,
        message = requestReceipt(receiptPrefix(status, lastReport), row, entry.requestedAmount)
      }
      local uncertainCapacity = lastReport.requestUnverified == true
        or row.requestPhase == "status_link_lost" or row.requestPhase == "confirmation_unavailable"
      local consumesCapacity = uncertainCapacity or (status ~= nil
        and (row.requestState == "running" or row.requestState == "accepted"))
      attempt.capacityConsumed = consumesCapacity
      attempt.queueAdvance = not consumesCapacity and lastReport.pendingResult ~= true
        and row.requestPhase ~= "daemon_authority" and row.requestPhase ~= "request_result"
      if consumesCapacity then
        dispatch.capacityConsumed = (tonumber(dispatch.capacityConsumed) or 0) + 1
      elseif attempt.queueAdvance then
        dispatch.queueAdvanceReady = true
      end
      report.requestAttempts[#report.requestAttempts + 1] = attempt
      report.requestAttempt = attempt
      if status then
        if lastReport.requestTrackable then activeRequests[entry.id] = status end
        row.ready = false
        if confirmed(lastReport) then
          lastRequestAt[entry.id] = transitionAt
          maintainerQueue.markSubmitted(entry, transitionAt)
          row.reason = "AE2 accepted request; CPU witness pending"
          entry.reason = row.reason
          cacheEpoch.recordAutoBatch(row, transitionAt)
          local stateSaved = recordAutoState("recordAutoBatch", row, transitionAt, lastReport)
          local auditSaved = stateSaved and logBatch(row, entry, lastReport, transitionAt, now)
          attempt.pendingResult = not (stateSaved and auditSaved)
          attempt.persistencePending = attempt.pendingResult
          submitted[#submitted + 1] = { row = row, entry = entry }
        elseif lastReport.requestPending then
          maintainerQueue.markPlanning(entry, transitionAt)
          row.reason, entry.reason = "AE2 planning request; no CPU assigned yet", "AE2 planning request; no CPU assigned yet"
        elseif row.requestState == "done" then
          row.requested = false
          local memory = maintainerQueue.markDone(entry, transitionAt)
          applyQueueTransition(attempt, entry, memory)
          cacheEpoch.recordAutoBatch(row, transitionAt)
          row.reason, entry.reason = "AE2 request completed", "AE2 request completed"
          local stateSaved = recordAutoState("recordAutoStatus", row, transitionAt, lastReport)
          local auditSaved = stateSaved and logBatch(row, entry, lastReport, transitionAt, now)
          local outcomeSaved = stateSaved and auditSaved
            and publishOutcome(row, entry, attempt, transitionAt, memory, now, lastReport.requestKey or entry.id)
          attempt.pendingResult = not (stateSaved and auditSaved and outcomeSaved)
          attempt.persistencePending = attempt.pendingResult
          if not attempt.pendingResult then
            requestTracker.acknowledge(lastReport.requestKey or entry.id)
            activeRequests[entry.id] = nil
          end
        elseif lastReport.requestUnverified then
          row.requested = false
          local memory = maintainerQueue.markUnverified(entry, transitionAt)
          applyQueueTransition(attempt, entry, memory)
          row.reason = entry.reason
          publishOutcome(row, entry, attempt, transitionAt, memory, now, lastReport.requestKey or entry.id)
        end
      elseif lastReport.pendingResult then
        row.ready, row.reason, entry.reason = false, err, err
      elseif row.requestState == "blocked" or row.requestPhase == "missing_resources" then
        local memory = maintainerQueue.markBlocked(entry, err, transitionAt, row.requestPhase)
        applyQueueTransition(attempt, entry, memory)
        publishOutcome(row, entry, attempt, transitionAt, memory, now, lastReport.requestKey or entry.id)
      else
        local memory = maintainerQueue.markFailed(entry, err, transitionAt)
        applyQueueTransition(attempt, entry, memory)
        publishOutcome(row, entry, attempt, transitionAt, memory, now, lastReport.requestKey or entry.id)
      end
      if attempt.queueAdvance == true then dispatch.queueAdvanceReady = true end
      requestWitness.refreshDispatchCounts(dispatch)
    end
    if options.deferPostSubmitWitness ~= true
        and requestWitness.refreshPostSubmit(report, submitted) then
      requestWitness.refreshDispatchCounts(dispatch)
    end
  end
  dispatch.remainingSlots = math.max(0,
    (tonumber(dispatch.availableSlots) or 0) - (tonumber(dispatch.capacityConsumed) or 0))
  if not report.requestAttempt and dispatch.entries[1] then
    local entry = dispatch.entries[1]
    report.requestBlocker = { label = entry.label, amount = entry.requestedAmount, reason = entry.reason, state = entry.status }
  end
  return report
end

return requests
local computer = require("computer")

local cacheEpoch = require("oc.ae2.cache_epoch")
local maintainerLog = require("oc.ae2.maintainer_log")
local maintainerQueue = require("oc.ae2.maintainer_queue")
local ownership = require("oc.ae2.maintainer_queue_ownership")
local maintainerStateOk, maintainerState = pcall(require, "oc.ae2.maintainer_state")
local requestTracker = require("oc.ae2.request_tracker")
local time = require("oc.ae2.time")

local poll = {}

local function normalizeOwnership(row)
  if row.phase == "status_error" or row.state == "accepted" then
    local reason = row.phase == "status_error" and row.reason or "request status methods unavailable"
    row.state, row.phase = "blocked", "confirmation_unavailable"
    row.reason = "request confirmation unavailable: " .. tostring(reason or "incomplete AE2 status contract")
  end
  return row
end

local function targetFor(row)
  local target = type(row.target) == "table" and row.target or { label = row.label }
  target.request = tonumber(row.amount) or target.request or 0
  target.requestState, target.requestPhase = row.state, row.phase
  target.requestStatusReason = row.reason
  target.requestStatusRawReason = row.rawReason
  target.requestError = (row.state == "failed" or row.state == "blocked" or row.state == "canceled")
    and (row.reason or row.state) or nil
  return target
end

local function entryFor(row, target)
  return {
    id = row.id or row.label, label = row.label, requestedAmount = tonumber(row.amount) or 0,
    row = target, phase = row.phase, statusReason = row.reason
  }
end

local function reportFor(row)
  return {
    amount = tonumber(row.amount) or 0, requestKey = row.id or row.label,
    requestState = row.state, requestPhase = row.phase, requestStatusReason = row.reason,
    requestStatusRawReason = row.rawReason,
    requestTrackable = true, requestConfirmed = row.state == "running" and row.phase == "submitted"
  }
end

local function terminalToken(row)
  return table.concat({ tostring(row.id or row.label or "request"), tostring(row.submittedAt or ""),
    tostring(row.state or ""), tostring(row.phase or "") }, "|")
end

local function outcomeKey(row)
  if row.outcomeKey ~= nil and tostring(row.outcomeKey) ~= "" then return tostring(row.outcomeKey) end
  return table.concat({ "auto", tostring(row.id or row.label or "request"),
    tostring(row.submittedAt or row.attemptedAt or "") }, "|")
end

local function receipt(prefix, row, target)
  local fluid = target.isFluid == true or target.kind == "fluid"
  return time.receipt(prefix, tostring(row.label or target.label or "target"), tonumber(row.amount) or 0, fluid)
end

local function recordStatus(target, now, report)
  local stateSaved = false
  if maintainerStateOk and maintainerState and maintainerState.recordAutoStatus then
    local called, saved = pcall(maintainerState.recordAutoStatus, target, now, report)
    stateSaved = called and saved == true
  end
  return stateSaved
end

local function logBatch(row, target, now)
  if row.auditLogged == true then return true end
  local logged, logErr = maintainerLog.append(target, now, {
    amount = tonumber(row.amount),
    source = "auto",
    requestKey = row.id or row.label,
    submittedAt = tonumber(row.submittedAt) or now
  })
  if logged then
    target.logError = nil
    requestTracker.markAuditLogged(row.id or row.label)
  else
    target.logError = logErr
  end
  return logged == true
end

local function outcomeDisposition(row)
  if row.state == "done" then return "completed" end
  if row.state == "canceled" then return "canceled" end
  if ownership.quarantined(row.phase) then return "safety_hold" end
  return "kickout"
end

local function logOutcome(row, target, memory, now)
  local eligibleAt = tonumber(memory and memory.nextEligibleAt)
  local retryKind = row.state == "done" and "cooldown"
    or ownership.quarantined(row.phase) and "safety_hold" or "backoff"
  local logged, logErr = maintainerLog.appendOutcome(target, now, {
    eventKey = outcomeKey(row),
    disposition = outcomeDisposition(row),
    source = "auto",
    targetId = row.id or row.label,
    requestKey = row.id or row.label,
    attemptedAt = tonumber(row.attemptedAt) or tonumber(row.submittedAt) or now,
    submittedAt = tonumber(row.submittedAt),
    amount = tonumber(row.amount) or 0,
    state = row.state,
    phase = row.phase,
    reason = row.reason,
    rawReason = row.rawReason,
    attempts = tonumber(memory and memory.attempts) or 0,
    retryKind = retryKind,
    retrySeconds = eligibleAt and math.max(0, eligibleAt - now) or 0,
    nextEligibleAt = eligibleAt
  })
  if logged then
    target.outcomeLogError = nil
  else
    target.outcomeLogError = logErr
  end
  return logged == true, logErr
end

local function terminalAttempt(row, entry, target, now)
  local report = reportFor(row)
  local token = terminalToken(row)
  local attempt = {
    label = row.label, amount = row.amount, ok = false, state = row.state,
    phase = row.phase, reason = row.reason, rawReason = row.rawReason
  }
  local memory
  if row.state == "done" then
    memory = maintainerQueue.markDone(entry, now, token)
    cacheEpoch.recordAutoBatch(target, now)
    entry.status, entry.reason = "done", "AE2 request completed"
    attempt.done, attempt.message = true, receipt("Auto request completed: ", row, target)
  elseif row.state == "blocked" then
    memory = maintainerQueue.markBlocked(entry, row.reason, now, row.phase, token)
    entry.status = "blocked"; entry.reason = entry.reason or tostring(row.reason or "request blocked")
    local prefix = ownership.quarantined(row.phase) and "Auto request safety hold: " or "Auto request blocked: "
    attempt.message = receipt(prefix, row, target)
  else
    memory = maintainerQueue.markFailed(entry, row.reason or row.state, now, token)
    entry.status, entry.reason = "failed", tostring(row.reason or row.state)
    attempt.message = receipt(row.state == "canceled" and "Auto request canceled: " or "Auto request failed for ", row, target)
  end
  attempt.outcome = entry.outcome or (memory and memory.outcome)
  local queueAdvance = entry.queueAdvance
  if queueAdvance == nil and memory then queueAdvance = memory.queueAdvance end
  attempt.queueAdvance = queueAdvance == true
  attempt.nextEligibleAt = memory and memory.nextEligibleAt or entry.nextEligibleAt
  local stateSaved = recordStatus(target, now, report)
  local auditSaved = row.state ~= "done"
  if row.state == "done" and stateSaved then auditSaved = logBatch(row, target, now) end
  local outcomeSaved, outcomeErr = false, nil
  if stateSaved and auditSaved then outcomeSaved, outcomeErr = logOutcome(row, target, memory, now) end
  local durable = stateSaved and auditSaved and outcomeSaved
  attempt.disposition = outcomeDisposition(row)
  attempt.outcomeKey = outcomeKey(row)
  attempt.outcomeLogged = outcomeSaved
  attempt.outcomeError = outcomeErr
  attempt.pendingResult = not durable
  attempt.persistencePending = attempt.pendingResult
  return attempt, durable
end

function poll.snapshot(activeRequests, lastRequestAt, summaries)
  local now, entries, attempts, acknowledgements = computer.uptime(), {}, {}, {}
  local inFlight = 0
  summaries = summaries or requestTracker.summaries()
  for _, row in ipairs(summaries or {}) do
    normalizeOwnership(row)
    -- Dashboard owns manual handles. The daemon must never publish or consume
    -- their terminal results, even when both owners share one Lua process.
    if row.source == "auto" then
      local target = targetFor(row)
      local entry = entryFor(row, target)
      if row.state == "running" then
        inFlight = inFlight + 1
        entry.status = "in_flight"
        if row.phase == "submitted" then
          entry.reason = "AE2 accepted request; CPU witness pending"
          local _, changed = maintainerQueue.markSubmitted(entry, now)
          local report = reportFor(row)
          if changed then
            lastRequestAt[entry.id] = now
            cacheEpoch.recordAutoBatch(target, now)
            attempts[#attempts + 1] = {
              label = row.label, amount = row.amount, ok = true, started = true,
              state = row.state, phase = row.phase, reason = row.reason,
              message = receipt("Auto request accepted by AE2: ", row, target)
            }
          end
          local stateSaved = row.auditLogged == true or recordStatus(target, now, report)
          local auditSaved = stateSaved and logBatch(row, target, now)
          if changed and attempts[#attempts] then
            attempts[#attempts].pendingResult = not (stateSaved and auditSaved)
            attempts[#attempts].persistencePending = attempts[#attempts].pendingResult
          end
        else
          entry.reason = "AE2 planning request; no CPU assigned yet"
          maintainerQueue.markPlanning(entry, now)
        end
      else
        local attempt, stateSaved = terminalAttempt(row, entry, target, now)
        attempts[#attempts + 1] = attempt
        if stateSaved then
          acknowledgements[#acknowledgements + 1] = row.id or row.label
          if activeRequests then activeRequests[row.id or ""], activeRequests[row.label or ""] = nil, nil end
        end
      end
      entries[#entries + 1] = entry
    end
  end
  return {
    message = inFlight > 0 and "poll heartbeat; request lifecycle active"
      or #attempts > 0 and "poll heartbeat; terminal request result observed"
      or "poll heartbeat; no in-flight requests",
    dispatch = { entries = entries, queueCount = 0, inFlightCount = inFlight,
      availableSlots = 0, maxSubmits = 0, pollOnly = true },
    requestAttempts = attempts, requestAcks = acknowledgements, targets = {}
  }, summaries
end

function poll.persistencePending(report)
  for _, attempt in ipairs((report and report.requestAttempts) or {}) do
    if attempt.pendingResult == true or attempt.persistencePending == true then return true end
  end
  return false
end

function poll.acknowledge(report)
  for _, key in ipairs((report and report.requestAcks) or {}) do requestTracker.acknowledge(key) end
end

return poll
-- Final-output witness handling is a dispatch guard, not a request resolver.
-- Keeping it isolated makes the normal submission path small and prevents an
-- accidental CPU scan from being added to request-state polling.
local computer = require("computer")
local adapter = require("oc.ae2.adapter")
local cpuWitness = require("oc.ae2.maintainer_cpu_witness")
local maintainerQueue = require("oc.ae2.maintainer_queue")

local witness = {}

function witness.refreshDispatchCounts(dispatch)
  dispatch = dispatch or {}
  local queued, ready, inFlight, head, quarantines, retryAt, reservations = 0, 0, 0, nil, 0, nil, 0
  local now = computer.uptime()
  for _, entry in ipairs(dispatch.entries or {}) do
    if entry.status == "queued" then
      queued = queued + 1
      if not head then head = entry end
    end
    if entry.status == "in_flight" and entry.trackerBacked ~= true then inFlight = inFlight + 1 end
    local phase = tostring(entry.phase or "")
    local quarantined = entry.quarantined == true or phase == "status_link_lost"
      or phase == "confirmation_unavailable" or phase == "reboot_recovery" or phase == "submit_intent"
    if quarantined then
      quarantines = quarantines + 1
      local boundary = tonumber(entry.nextEligibleAt)
      if boundary then retryAt = retryAt and math.min(retryAt, boundary) or boundary end
    end
    if (tonumber(entry.ownershipReservationUntil) or 0) > now then reservations = reservations + 1 end
  end
  for _, entry in ipairs(dispatch.ready or {}) do
    if entry.status == "queued" then ready = ready + 1 end
  end
  dispatch.queueCount, dispatch.readyQueueCount = queued, ready
  dispatch.inFlightCount = (tonumber(dispatch.activeInFlightCount) or 0) + inFlight
  dispatch.ownershipQuarantineCount, dispatch.ownershipRetryAt = quarantines, retryAt or false
  dispatch.ownershipReservationCount = math.max(reservations, tonumber(dispatch.ownershipReservationCount) or 0)
  dispatch.queueStatusReason = quarantines > 0 and (tostring(quarantines) .. (quarantines == 1 and " target" or " targets")
    .. " quarantined" .. (queued > 0 and "; unrelated queue continues" or "; waiting for target retry boundary")) or false
  dispatch.queueHead = head
  dispatch.queueHeadId = head and head.id or nil
  dispatch.queueHeadIndex = head and head.queueIndex or nil
  local remaining = math.max(0, (tonumber(dispatch.availableSlots) or 0) - (tonumber(dispatch.capacityConsumed) or 0))
  if head and remaining <= 0 and dispatch.ownershipReservationCount > 0 then
    dispatch.waitingForCpu, dispatch.waitingForSettlement = true, true
    dispatch.queuePausedReason = tostring(dispatch.ownershipReservationCount) .. " uncertain ownership reservation settling"
  end
end

local function eachCpu(cpus, fn)
  local seen = {}
  local reported = math.max(tonumber(cpus and cpus.n) or 0, #(cpus or {}))
  for index = 1, reported do
    if cpus[index] ~= nil then seen[index] = true; fn(cpus[index], index) end
  end
  for key, row in pairs(cpus or {}) do
    if key ~= "n" and not seen[key] then fn(row, key) end
  end
end

local function cpuCounts(cpuSummary)
  local ready, observed = 0, 0
  eachCpu(cpuSummary and cpuSummary.cpus or {}, function(row)
    observed = observed + 1
    if not cpuWitness.cpuBusy(row) then ready = ready + 1 end
  end)
  return ready, math.max(observed, tonumber(cpuSummary and cpuSummary.count) or 0)
end

local function publishActiveCrafts(status, activeCrafts)
  local diagnostics = activeCrafts.diagnostics or {}
  status.activeCrafts, status.activeCraftCount = activeCrafts, #activeCrafts
  status.activeCraftScannedCpus = diagnostics.scannedCpus
  status.activeCraftBusyCpus = diagnostics.busyCpus
  status.activeCraftFinalOutputs = diagnostics.finalOutputs
  status.activeCraftFinalOutputErrors = diagnostics.errors
  status.activeCraftFinalOutputError = diagnostics.firstError
  status.activeCraftFinalOutputErrorCpu = diagnostics.firstErrorCpu
end

local function transportFailure(report, primary, reason)
  local previous = tostring(primary and primary.address or "")
  local ok, current = pcall(adapter.primary)
  local replacement = ok and type(current) == "table" and tostring(current.address or "") or ""
  if type(report) == "table" and previous ~= "" and replacement ~= "" and replacement ~= previous then
    report.queueInvalidated = true
    report.queueInvalidatedReason = "AE2 primary changed from " .. previous .. " to " .. replacement
    report.message = "Frozen queue invalidated by AE2 primary replacement; fresh planning required"
  end
  return false, reason
end

function witness.refresh(report)
  local status = report and report.status
  local primary = status and status.ae2Primary
  if not (type(primary) == "table" and primary.address) then
    return transportFailure(report, primary, "CPU final-output scan unavailable: missing AE2 primary")
  end
  local ok, cpuSummary = pcall(adapter.cpuSummary, primary)
  if not ok or type(cpuSummary) ~= "table" then
    return transportFailure(report, primary,
      "CPU final-output scan failed: " .. tostring(ok and "no CPU summary" or cpuSummary))
  end
  if cpuSummary.error ~= nil and tostring(cpuSummary.error) ~= "" then
    return transportFailure(report, primary, "CPU final-output scan failed: " .. tostring(cpuSummary.error))
  end
  local ready, total = cpuCounts(cpuSummary)
  status.readyCpus, status.totalCpus = ready, total
  local witnessOk, activeCrafts = pcall(cpuWitness.activeOutputs, cpuSummary)
  if not witnessOk or type(activeCrafts) ~= "table" then
    return false, "CPU final-output scan failed: " .. tostring(activeCrafts)
  end
  publishActiveCrafts(status, activeCrafts)
  local diagnostics = activeCrafts.diagnostics or {}
  if (tonumber(diagnostics.scannedCpus) or 0) > 0 and (tonumber(diagnostics.errors) or 0) > 0 then
    return false, "CPU final-output scan failed: " .. tostring(diagnostics.firstError or "all CPU reads errored")
  end
  return true
end

local function blockedAttempt(row, entry, phase, reason, receipt)
  return {
    id = entry and entry.id,
    label = row and row.label, amount = entry and entry.requestedAmount or 0,
    ok = false, state = "blocked", phase = phase, reason = reason,
    nextEligibleAt = entry and entry.nextEligibleAt,
    message = receipt("Auto request skipped for ", row, entry and entry.requestedAmount or 0)
  }
end

function witness.blockEntry(row, entry, phase, reason, receipt)
  if row then
    row.ready, row.reason = false, reason
    row.requestState, row.requestPhase, row.requestStatusReason = "blocked", phase, reason
  end
  if entry then
    entry.status, entry.phase, entry.statusReason, entry.reason = "blocked", phase, reason, reason
    entry.outcome, entry.queueAdvance = "kickout", true
  end
  local attempt = blockedAttempt(row, entry, phase, reason, receipt)
  attempt.outcome, attempt.queueAdvance = "kickout", true
  return attempt
end

local function cpuFinalOutputReason(active)
  local reason = "AE2 CPU final output in flight"
  if active and active.cpuName then reason = reason .. ": " .. tostring(active.cpuName) end
  return reason
end

function witness.blockCpuFinalOutput(row, entry, active, receipt)
  local reason = cpuFinalOutputReason(active)
  if row then
    row.ready, row.reason = false, reason
    row.requestState, row.requestPhase, row.requestStatusReason = "blocked", "cpu_final_output", "AE2 CPU final output matches target"
  end
  if entry then
    entry.status, entry.phase, entry.statusReason, entry.reason = "blocked", "cpu_final_output",
      "AE2 CPU final output matches target", reason
    entry.outcome, entry.queueAdvance = "already_in_flight", true
  end
  local attempt = blockedAttempt(row, entry, "cpu_final_output", reason, receipt)
  attempt.skipped, attempt.outcome = true, "already_in_flight"
  return attempt
end

local function markCpuFinalOutputInFlight(row, entry, active)
  local reason = cpuFinalOutputReason(active)
  if row then
    row.ready, row.reason = false, reason
    row.requestState, row.requestPhase, row.requestStatusReason = "running", "cpu_final_output", "AE2 CPU final output matches target"
  end
  if entry then
    entry.status, entry.phase, entry.statusReason, entry.reason = "in_flight", "cpu_final_output",
      "AE2 CPU final output matches target", reason
  end
end

function witness.refreshPostSubmit(report, submitted)
  if not submitted or #submitted <= 0 then return false end
  if not witness.refresh(report) then return false end
  local marked = false
  for _, item in ipairs(submitted) do
    local activeCraft = cpuWitness.find(report.status and report.status.activeCrafts, item.row)
    if activeCraft then markCpuFinalOutputInFlight(item.row, item.entry, activeCraft); marked = true end
  end
  return marked
end

function witness.blockReport(report, options, reason)
  local dispatch = maintainerQueue.build(report, options)
  for _, entry in ipairs(dispatch.entries or {}) do
    if entry.status == "queued" then
      entry.phase, entry.statusReason = "cpu_final_output_scan", reason
      entry.reason = reason
      entry.outcome, entry.queueAdvance = "safety_hold", false
    end
  end
  dispatch.ready, dispatch.readyQueueCount = {}, 0
  dispatch.availableSlots, dispatch.maxSubmits, dispatch.remainingSlots = 0, 0, 0
  dispatch.witnessHeld, dispatch.queuePausedReason = true, reason
  report.dispatch, report.requestAttempts = dispatch, {}
  report.requestBlocker = {
    reason = reason, state = "blocked", phase = "cpu_final_output_scan", outcome = "safety_hold"
  }
  return report
end

return witness
local computer = require("computer")
local lineContract = require("oc.ae2.line_contract")
local maintainerQueue = require("oc.ae2.maintainer_queue")
local binding = require("oc.ae2.request_binding")

local rules = {}

local function targetNeedsBatteryTelemetry(row)
  row = row or {}
  if row.armed ~= true then return false end
  local minBatteryRatio = tonumber(row.minBatteryRatio) or 0
  local maxDeficitRatio = tonumber(row.maxDeficitRatio) or 1.25
  return not (minBatteryRatio <= 0 and maxDeficitRatio <= 0)
end

local function anyTargetNeedsBatteryTelemetry(targets)
  if targets == nil then return true end
  for _, row in ipairs(targets or {}) do
    if targetNeedsBatteryTelemetry(row) then return true end
  end
  return false
end

function rules.safeToCraft(row, status, config, lastRequestAt)
  row, status, config = row or {}, status or {}, config or {}
  lastRequestAt = lastRequestAt or {}
  local power = status.power or {}
  if not status.ae2Online then return false, "AE2 offline" end
  if config.autoEnabled == false then return false, "global auto off" end
  local minBatteryRatio = tonumber(row.minBatteryRatio or config.minBatteryRatio) or 0
  local maxDeficitRatio = tonumber(row.maxDeficitRatio or config.maxDeficitRatio) or 1.25
  local batteryDisabled = minBatteryRatio <= 0
  local powerDisabled = maxDeficitRatio <= 0
  local powerRatio = tonumber(power.ratio)
  if not power.available and not (batteryDisabled and powerDisabled) then return false, "battery missing" end
  if powerRatio and not batteryDisabled and powerRatio < minBatteryRatio then
    return false, "battery low"
  end
  if not powerDisabled and type(power.avgIn) == "number" and type(power.avgOut) == "number" then
    if power.avgOut > power.avgIn * maxDeficitRatio and (powerRatio or 0) < 0.80 then
      return false, "power deficit"
    end
  end
  local amount, lineReason, lineState = lineContract.requestAmount(row)
  if lineState == "observe" then return false, "observe only" end
  if lineState == "alert" then return false, "alert only" end
  if lineState == "suggest" then return false, "suggest only" end
  if lineState == "manual_only" then return false, "manual only" end
  if lineState == "danger_locked" then return false, "request cap above safe boundary" end
  if not row.armed then return false, "target disarmed" end
  local bindErr = row.stockBindingError or binding.error(row)
  if bindErr then return false, bindErr end
  if row.requestMemoryReason then return false, row.requestMemoryReason end
  if row.stockMemoryFresh ~= true then
    -- A strict-lifetime observation may age out while a large bounded pass is
    -- still warming. Let a below-boundary numeric row reach dispatch solely
    -- as a refresh candidate; maintainer_requests performs an exact read and
    -- recomputes the amount before any Craftable lookup or submission.
    if row.stockMemoryReason == "stock snapshot stale"
      and type(row.current) == "number" and row.current < row.min
      and (tonumber(amount) or 0) > 0 then
      return true, "stock refresh required"
    end
    return false, row.stockMemoryReason or "stock snapshot unavailable"
  end
  if type(row.current) ~= "number" then return false, "stock unknown" end
  -- Maintain/Recipe lines stop at their stock boundary, but Push Max is
  -- explicitly cooldown-driven. Preserve the familiar stock-ready receipt
  -- only when the shared line contract actually classified the row satisfied.
  if row.current >= row.min and lineState == "satisfied" then return false, "stock ready" end
  if (tonumber(amount) or 0) <= 0 then return false, lineReason or "line contract blocked" end
  local key = maintainerQueue.id(row)
  local last = lastRequestAt[key] or lastRequestAt[row.label]
  if last and computer.uptime() - last < (tonumber(row.cooldown or config.cooldown) or 0) then
    return false, "cooldown"
  end
  if row.requestState == "running" then return false, "already requested" end
  -- CPU readiness is a dispatch-capacity gate, not a reason to hide an
  -- otherwise valid target.  Evaluate it last so the queue may retain one
  -- exact FIFO head and pause there without masking identity, stock, power,
  -- cooldown, or ownership failures.
  if row.requireReadyCpu ~= false and (tonumber(status.readyCpus) or 0) < 1 then
    return false, "no ready CPU"
  end
  return true, "ready"
end

function rules.alerts(status, targets)
  status = status or {}
  local power = status.power or {}
  local needsBattery = anyTargetNeedsBatteryTelemetry(targets)
  local rows = {}
  if not status.ae2Online then rows[#rows + 1] = "AE2 offline" end
  if needsBattery and not power.available then rows[#rows + 1] = "Battery missing" end
  if needsBattery and type(power.ratio) == "number" and power.ratio < 0.25 then rows[#rows + 1] = "Battery low" end
  if needsBattery and power.deficit then rows[#rows + 1] = "Power deficit" end
  if status.gridSnapshotBlocked then
    rows[#rows + 1] = "AE2 storage guard: broad reads off"
  end
  for _, row in ipairs(targets or {}) do
    if row.requestState == "canceled" or row.requestState == "failed" then
      rows[#rows + 1] = "Craft request " .. row.requestState .. ": " .. tostring(row.label)
    end
  end
  if #rows == 0 then rows[1] = "Observe only" end
  return rows
end

return rules
local cacheEpoch = require("oc.ae2.cache_epoch")

local cache = {}

function cache.targetKey(target)
  return cacheEpoch.targetKey(target)
end

function cache.targetSignature(targets)
  return cacheEpoch.targetSignature(targets)
end

function cache.configSignature(config)
  return cacheEpoch.configSignature(config)
end

function cache.prepare(config, options)
  options = options or {}
  local previous = options.cache or {}
  cacheEpoch.recordWorkflow(config, options.restart and "restart" or options.dirty and "workflow_dirty" or "maintainer_prepare")
  local targetSig = cache.targetSignature((config and config.targets) or {})
  local signature = cache.configSignature(config)
  local invalid = cacheEpoch.invalidationFor(previous.epoch)
  local sameTargets = previous.targetSignature == targetSig
  local keepRows = type(previous.rows) == "table" and previous.rows or nil
  if invalid.context and not invalid.targetRows then previous.context = nil end
  if sameTargets and previous.complete == true and not options.restart and not invalid.targetRows then
    previous.signature = signature
    previous.replay = true
    previous.targetCursor = 1
    return previous
  end
  if previous.complete == false and sameTargets and not options.restart and not invalid.targetRows then
    previous.signature, previous.targetSignature, previous.replay = signature, targetSig, nil
    return previous
  end
  if options.restart or not sameTargets or invalid.targetRows or previous.complete ~= false then
    return {
      targetCursor = 1,
      rows = keepRows,
      signature = signature,
      targetSignature = targetSig,
      context = nil,
      stockIndex = nil,
      replay = nil
    }
  end
  previous.signature, previous.targetSignature, previous.replay = signature, targetSig, nil
  return previous
end

return cache
local lineContract = require("oc.ae2.line_contract")
local binding = require("oc.ae2.request_binding")
local statusCache = require("oc.ae2.maintainer_status_cache")
local stockMemory = require("oc.ae2.stock_memory")

local rows = {}
local targetKey = statusCache.targetKey

function rows.indexByKey(source)
  local indexed = {}
  for _, row in ipairs(source or {}) do if row.targetKey then indexed[row.targetKey] = row end end
  return indexed
end

function rows.applyPolicy(row, target, requestState)
  target = target or {}
  row.label = target.label or row.label or target.rawLabel or target.name or "target"
  row.rawLabel, row.name = target.rawLabel or row.rawLabel, target.name or row.name
  row.damage = target.damage or row.damage
  row.hasTag = target.hasTag ~= nil and target.hasTag or row.hasTag
  row.kind, row.amount, row.filter = target.kind or row.kind, target.amount or row.amount, target.filter or row.filter
  row.craftBinding = target.craftBinding
  row.stockBinding = binding.copyStockBinding(target)
  row.stockBindingError = target.stockBindingError
  if target.isFluid ~= nil then row.isFluid = target.isFluid end
  row.lineIntent = target.lineIntent or row.lineIntent
  row.lineAuthority = target.lineAuthority or row.lineAuthority
  row.alertEnabled = target.alertEnabled ~= false
  row.alertBelow = tonumber(target.alertBelow or target.min) or tonumber(row.alertBelow or row.min) or 0
  row.maxRequest = tonumber(target.maxRequest or target.batch) or tonumber(row.maxRequest or row.batch) or 1
  -- These controls belong to the current workflow policy. Replacing (rather
  -- than merging) them is what makes a removed recipe ceiling or revoked
  -- danger permission take effect on a same-target cache replay.
  row.maxBasis = target.maxBasis
  row.confidence = target.confidence
  row.recipeMax = target.recipeMax
  row.dangerUnlocked = target.dangerUnlocked == true
  row.locked = target.locked == true
  row.min, row.craftTo = row.alertBelow, tonumber(target.craftTo or row.alertBelow) or row.alertBelow
  row.batch = row.maxRequest
  lineContract.annotate(row)
  row.minBatteryRatio, row.maxDeficitRatio = target.minBatteryRatio, target.maxDeficitRatio
  row.requireReadyCpu, row.cooldown, row.armed = target.requireReadyCpu, target.cooldown, target.armed == true
  row.targetKey = targetKey(target)
  local requestStatus = requestState(row)
  row.requestState = type(requestStatus) == "table" and requestStatus.state or requestStatus
  row.requestPhase = type(requestStatus) == "table" and requestStatus.phase or nil
  row.requestStatusReason = type(requestStatus) == "table" and requestStatus.reason or nil
  row.requestError = type(requestStatus) == "table" and requestStatus.reason or nil
  return row
end

function rows.placeholder(target, requestState)
  target = target or {}
  return rows.applyPolicy({
    label = target.label or target.rawLabel or target.name or "target",
    rawLabel = target.rawLabel, name = target.name, damage = target.damage,
    hasTag = target.hasTag, kind = target.kind, isFluid = target.isFluid,
    amount = target.amount, filter = target.filter, craftBinding = target.craftBinding,
    stockBinding = binding.copyStockBinding(target), craftable = false,
    ready = false, requestState = "none", status = "partial",
    reason = "warming stock/craft status",
    targetKey = targetKey(target)
  }, target, requestState)
end

function rows.target(node, entries, target, requestState, stockIndex, options)
  options = options or {}
  -- The daemon deliberately does not enumerate or resolve the AE2 Craftable
  -- grid while warming status. Exact identity eligibility is applied by the
  -- status layer; a live handle is resolved only for the selected submission.
  local entry = nil
  local stockNode = (entry and entry.source) or node
  local memory = stockNode and stockNode.address
    and stockMemory.lookup(target, { address = stockNode.address }) or nil
  local current, countError, stockFresh, stockAge
  if memory then
    current = memory.current
    stockFresh, countError, stockAge = stockMemory.isFresh(memory, { maxAge = options.stockMaxAge })
  else
    countError = "stock snapshot unavailable; live AE2 stock scans are disabled"
    stockFresh = false
  end
  local min = tonumber(target.min) or 0
  local alertBelow = tonumber(target.alertBelow or target.min) or min
  local craftTo = tonumber(target.craftTo) or alertBelow
  local maxRequest = tonumber(target.maxRequest or target.batch) or craftTo
  local row = {
    label = target.label or (entry and entry.label) or "target",
    rawLabel = entry and entry.rawLabel or target.rawLabel,
    name = entry and entry.name or target.name,
    damage = entry and entry.damage or target.damage,
    hasTag = entry and entry.hasTag ~= nil and entry.hasTag or target.hasTag,
    kind = entry and entry.kind or target.kind,
    isFluid = entry and entry.isFluid or target.isFluid,
    amount = entry and entry.amount or target.amount,
    filter = entry and entry.filter or target.filter,
    craftBinding = target.craftBinding,
    stockBinding = binding.copyStockBinding(target),
    stockBindingError = target.stockBindingError,
    source = entry and entry.source or target.source,
    craftIndex = entry and entry.craftIndex or target.craftIndex,
    rawCraftIndex = entry and (entry.rawCraftIndex or entry.craftIndex) or target.rawCraftIndex,
    current = current,
    min = alertBelow,
    alertBelow = alertBelow,
    craftTo = craftTo,
    batch = maxRequest,
    maxRequest = maxRequest,
    lineIntent = target.lineIntent,
    lineAuthority = target.lineAuthority,
    alertEnabled = target.alertEnabled,
    maxBasis = target.maxBasis,
    confidence = target.confidence,
    recipeMax = target.recipeMax,
    dangerUnlocked = target.dangerUnlocked,
    locked = target.locked,
    craftable = entry ~= nil,
    entry = entry,
    minBatteryRatio = target.minBatteryRatio,
    maxDeficitRatio = target.maxDeficitRatio,
    requireReadyCpu = target.requireReadyCpu,
    cooldown = target.cooldown,
    armed = target.armed == true,
    error = countError,
    stockMemoryFresh = stockFresh == true,
    stockMemoryAge = stockAge,
    stockMemoryReason = countError,
    targetKey = targetKey(target)
  }
  if memory then
    row.stockMemoryAt = memory.at
    row.stockMemorySource = memory.source
  elseif current ~= nil then
    row.stockMemoryAt = memory and memory.at or nil
    row.stockMemorySource = memory and memory.source or nil
  end
  return rows.applyPolicy(row, target, requestState)
end

function rows.applyStockMemory(row, target, node)
  if not (node and node.address) then return row, false end
  return stockMemory.apply(row, target, { address = node.address })
end

return rows
local adapter = require("oc.ae2.adapter")
local cacheEpoch = require("oc.ae2.cache_epoch")
local cpuWitness = require("oc.ae2.maintainer_cpu_witness")
local gridReadGuard = require("oc.ae2.grid_read_guard")
local lineContract = require("oc.ae2.line_contract")
local monitor = require("oc.ae2.monitor")
local binding = require("oc.ae2.request_binding")
local stockExact = require("oc.ae2.stock_exact")
local stockMemory = require("oc.ae2.stock_memory")
local statusCache = require("oc.ae2.maintainer_status_cache")
local statusRows = require("oc.ae2.maintainer_status_rows")
local statusSafety = require("oc.ae2.maintainer_status_safety")
local powerMonitor = require("oc.gt_power.monitor")
local status = {}
local function eachCpu(cpus, fn)
  local seen = {}
  local reported = math.max(tonumber(cpus and cpus.n) or 0, #(cpus or {}))
  for index = 1, reported do
    if cpus[index] ~= nil then
      seen[index] = true
      fn(cpus[index], index)
    end
  end
  for key, row in pairs(cpus or {}) do
    if key ~= "n" and not seen[key] then fn(row, key) end
  end
end
local function readyCpus(ae2, activeCrafts)
  local activeCpu = {}
  for _, active in ipairs(activeCrafts or {}) do
    if active.cpuIndex ~= nil then activeCpu[tostring(active.cpuIndex)] = true end
  end
  local ready = 0
  eachCpu((ae2.cpus and ae2.cpus.cpus) or {}, function(cpu, index)
    if not cpuWitness.cpuBusy(cpu) and not activeCpu[tostring(index)] then ready = ready + 1 end
  end)
  return ready
end
function status.powerStatus()
  local ok, snapshot = pcall(powerMonitor.snapshot, { usableOnly = true, limit = 1, sensor = true })
  if not ok or type(snapshot) ~= "table" then
    return { available = false, status = "error: " .. tostring(snapshot) }
  end
  local first = snapshot.readings and snapshot.readings[1] or {}
  local deficit = false
  if type(first.effectiveAvgIn) == "number" and type(first.effectiveAvgOut) == "number" then
    deficit = first.effectiveAvgOut > first.effectiveAvgIn * 1.25 and (first.ratio or 0) < 0.80
  end
  return {
    available = snapshot.available,
    node = first.address and { address = first.address, type = first.type } or nil,
    address = first.address,
    type = first.type,
    ratio = first.ratio,
    avgIn = first.effectiveAvgIn or first.avgIn,
    avgOut = first.effectiveAvgOut or first.avgOut,
    deficit = deficit,
    status = first.status
  }
end

function status.armedTargets(config)
  local count = 0
  for _, target in ipairs((config and config.targets) or {}) do
    if target.armed then count = count + 1 end
  end
  return count
end
local targetKey = statusCache.targetKey
local targetSignature = statusCache.targetSignature
local configSignature = statusCache.configSignature
local prepareChunkCache = statusCache.prepare
local function buildContext(config)
  local ae2 = monitor.snapshot({ detail = false })
  local gridGuard = gridReadGuard.status(config.craftCompatibility)
  local primary = ae2.available and ae2.primary and { address = ae2.primary.address, type = ae2.primary.type } or adapter.primary()
  local power = status.powerStatus()
  local activeCrafts = cpuWitness.activeOutputs(ae2.cpus)
  local activeDiagnostics = activeCrafts.diagnostics or {}
  local context = {
    ae2 = ae2,
    primary = primary,
    batteryNode = power.node,
    current = {
      mode = config.mode,
      autoEnabled = config.autoEnabled ~= false,
      craftCompatibility = config.craftCompatibility,
      fluidStockCompatibility = config.fluidStockCompatibility,
      craftApiMode = gridGuard.craftApiMode,
      ae2Online = ae2.available,
      ae2Primary = primary,
      readyCpus = readyCpus(ae2, activeCrafts),
      totalCpus = ae2.cpus and ae2.cpus.count or 0,
      cpuPolicy = "any ready CPU",
      activeCrafts = activeCrafts,
      activeCraftCount = #activeCrafts,
      activeCraftScannedCpus = activeDiagnostics.scannedCpus,
      activeCraftBusyCpus = activeDiagnostics.busyCpus,
      activeCraftFinalOutputs = activeDiagnostics.finalOutputs,
      activeCraftFinalOutputErrors = activeDiagnostics.errors,
      activeCraftFinalOutputError = activeDiagnostics.firstError,
      activeCraftFinalOutputErrorCpu = activeDiagnostics.firstErrorCpu,
      gridReadMode = gridGuard.mode,
      gridSnapshotBlocked = gridGuard.broadReads == false,
      gridSnapshotCode = gridGuard.code,
      gridSnapshotReason = gridGuard.reason,
      power = power
    }
  }
  cacheEpoch.recordNodes({ ae2Primary = primary, batteryNode = power.node })
  return context
end

local function cloneCurrent(context)
  local current = {}
  for key, value in pairs((context and context.current) or {}) do current[key] = value end
  return current
end

-- Status classifies saved identity only; it never wakes a Craftable lookup.
local function applyExactRequestEligibility(row)
  if not row then return row end
  local bindErr = row.stockBindingError or binding.error(row)
  if bindErr then
    row.craftable = false
    row.requestMemory = "binding-required"
    row.requestMemoryMode = nil
    row.requestMemoryReason = tostring(bindErr)
    return row
  end
  row.craftable = true
  row.requestMemory = "dispatch-direct"
  row.requestMemoryMode = "exact-identity"
  row.requestMemoryReason = nil
  return row
end

function status.targetRow(node, entries, target, requestState, config, stockIndex, options)
  -- Keep the legacy config slot while forwarding stock options unchanged.
  return applyExactRequestEligibility(statusRows.target(node, entries, target, requestState, stockIndex, options))
end

local function refreshExactStock(row, primary, context)
  if not row or row.status == "partial" then return row end
  context = context or {}
  context.fluidFallback = context.fluidFallback or {}
  local entry, err, report = stockExact.refresh(row, primary, {
    tagged = context.taggedStock,
    fluidFallback = context.fluidFallback
  })
  if entry then
    row.current = entry.current
    row.stockMemoryAt, row.stockMemorySource = entry.at, entry.source
    row.stockMemoryFresh = true
    row.stockMemoryAge = math.max(0, tonumber(stockMemory.age(entry)) or 0)
    row.stockMemoryReason = nil
    row.error = nil
    row.stockDirectCalls = report and report.calls or 0
    lineContract.annotate(row)
    return row
  end
  row.stockMemoryFresh, row.stockDirectCalls = false, report and report.calls or 0
  row.stockMemoryReason = tostring(err or "exact stock lookup unavailable")
  row.error = row.stockMemoryReason
  return row
end

local function chunkedRows(config, options, primary, requestState, safeToCraft, current)
  local targets = config.targets or {}
  local cache = options.cache or {}
  local limit = math.max(1, math.floor(tonumber(options.targetLimit) or #targets))
  local first = math.max(1, math.floor(tonumber(cache.targetCursor) or 1))
  if first > #targets then first = 1 end
  local last = math.min(#targets, first + limit - 1)
  local existing = statusRows.indexByKey(cache.rows)
  local refreshed = {}
  local rowOptions = { stockMaxAge = options.stockMaxAge }
  for index = first, last do
    local target = targets[index]
    local row = status.targetRow(primary, {}, target, requestState, config, nil, rowOptions)
    refreshed[targetKey(target)] = row
  end
  local rows = {}
  for _, target in ipairs(targets) do
    local key = targetKey(target)
    local warmed = refreshed[key]
    local row = statusRows.applyPolicy(warmed or existing[key] or statusRows.placeholder(target, requestState), target, requestState)
    applyExactRequestEligibility(row)
    if warmed then
      -- Only this slice may touch an AE2 reader; retained rows stay O(n).
      refreshExactStock(row, primary, cache.context)
    elseif not options.requestReady then
      statusRows.applyStockMemory(row, target, primary)
    end
    statusSafety.apply(row, current, config, safeToCraft)
    rows[#rows + 1] = row
  end
  local complete = last >= #targets
  cache.rows, cache.signature = rows, configSignature(config)
  cache.targetSignature = targetSignature(targets)
  cache.targetCursor = complete and 1 or last + 1
  cache.complete, cache.targetRowsComplete = complete, complete
  current.complete, current.targetCursor = complete, cache.targetCursor
  current.status = complete and current.status or "partial"
  return rows, cache
end

local function replayRows(config, cache, requestState, safeToCraft, current, options, primary, context)
  local existing, rows = statusRows.indexByKey(cache.rows), {}
  for _, target in ipairs(config.targets or {}) do
    local row = statusRows.applyPolicy(existing[targetKey(target)] or statusRows.placeholder(target, requestState), target, requestState)
    applyExactRequestEligibility(row)
    if binding.visibleTagged(row) then refreshExactStock(row, primary, context)
    elseif not (options and options.requestReady) then
      statusRows.applyStockMemory(row, target, (cache.context or {}).primary)
    end
    statusSafety.apply(row, current, config, safeToCraft)
    rows[#rows + 1] = row
  end
  cache.rows, cache.complete, cache.targetCursor, cache.replay = rows, true, 1, nil
  current.complete, current.targetCursor = true, 1
  return rows, cache
end

function status.snapshot(config, options, requestState, safeToCraft)
  options = options or {}
  requestState = requestState or function() return "none" end
  local chunked = tonumber(options.targetLimit) ~= nil
  if chunked then options.cache = prepareChunkCache(config, options) end
  local context = chunked and options.cache.context or nil
  if not context then
    context = buildContext(config)
    if chunked then options.cache.context = context end
  end
  local ae2, primary = context.ae2, context.primary
  context.taggedStock = stockExact.step(context.taggedStock, config.targets, primary,
    { scanLimit = tonumber(options.taggedStockScanLimit) or 64, finish = not chunked,
      maxRows = tonumber(options.taggedStockMaxRows) or 16384 })
  local current = cloneCurrent(context)
  current.mode, current.autoEnabled = config.mode, config.autoEnabled ~= false
  current.fluidStockCompatibility = config.fluidStockCompatibility
  local currentGuard = gridReadGuard.status(config.craftCompatibility)
  current.craftCompatibility, current.craftApiMode = currentGuard.craftCompatibility, currentGuard.craftApiMode
  current.craftables = ae2.counts and ae2.counts.craftables or nil
  current.craftablesError = ae2.counts and ae2.counts.craftablesError or nil
  current.requestReady, current.armedTargets = options.requestReady == true, status.armedTargets(config)
  current.targetCount, current.complete = #(config.targets or {}), true
  if chunked then
    local rows, cache
    local replaying = options.cache.replay or options.cache.targetRowsComplete
    if replaying then
      rows, cache = replayRows(config, options.cache, requestState, safeToCraft, current, options, primary, context)
    else
      rows, cache = chunkedRows(config, options, primary, requestState, safeToCraft, current)
    end
    current.taggedStockScanned = tonumber(context.taggedStock.scanned) or 0
    current.taggedStockComplete = context.taggedStock.complete == true
    local needsReplay = not replaying and cache.targetRowsComplete and (tonumber(context.taggedStock.wantedCount) or 0) > 0
    if not current.taggedStockComplete or needsReplay then current.complete, cache.complete = false, false end
    cacheEpoch.stamp(cache, config, context, (current and current.complete) == true, options.now)
    return { config = config, status = current, targets = rows, cache = cache }
  end
  local rowOptions = { stockMaxAge = options.stockMaxAge }
  local rows = {}
  for _, target in ipairs(config.targets or {}) do
    local row = status.targetRow(primary, {}, target, requestState, config, nil, rowOptions)
    refreshExactStock(row, primary, context)
    statusSafety.apply(row, current, config, safeToCraft)
    rows[#rows + 1] = row
  end
  current.taggedStockScanned = tonumber(context.taggedStock.scanned) or 0
  current.taggedStockComplete = context.taggedStock.complete == true
  if not current.taggedStockComplete then current.complete = false end
  return { config = config, status = current, targets = rows }
end

return status
-- Passive row safety is shared by fresh and replayed status rows.  It does not
-- read AE2 itself; the surrounding status pass supplies the observed context.
local cpuWitness = require("oc.ae2.maintainer_cpu_witness")

local safety = {}

local function cpuFinalOutputReason(active)
  local reason = "AE2 CPU final output in flight"
  if active and active.cpuName then reason = reason .. ": " .. tostring(active.cpuName) end
  return reason
end

local function applyPassiveCpuWitness(row, current)
  if not (row and current and row.armed == true) or row.ready ~= true then return row end
  if (tonumber(row.request) or 0) <= 0 then return row end
  local active = cpuWitness.find(current.activeCrafts, row)
  if not active then return row end
  row.ready, row.reason = false, cpuFinalOutputReason(active)
  row.requestState, row.requestPhase = "blocked", "cpu_final_output"
  row.requestStatusReason = "AE2 CPU final output matches target"
  return row
end

function safety.apply(row, current, config, safeToCraft)
  if row.status ~= "partial" then
    local ok, reason = safeToCraft(row, current, config)
    row.ready, row.reason = ok, reason
    applyPassiveCpuWitness(row, current)
  end
  return row
end

return safety
local maintainerQueue = require("oc.ae2.maintainer_queue"); local maintainerRequests = require("oc.ae2.maintainer_requests")
local maintainerRules = require("oc.ae2.maintainer_rules"); local maintainerStatus = require("oc.ae2.maintainer_status")
local cacheEpoch = require("oc.ae2.cache_epoch"); local workflows = require("oc.ae2.workflows")
local maintainer = {}
-- Workflow policy is the sole durable maintainer authority. Older releases
-- wrote a second maintainer config whose target list and mode were immediately
-- overwritten by workflows on load; keeping that shadow writer caused stale,
-- misleading policy files.
maintainer.path = workflows.path
maintainer.defaults = workflows.defaults
local activeRequests, lastRequestAt = {}, {}
local function requestState(target)
  return maintainerRequests.state(target, activeRequests)
end
local function pruneMap(map, validKeys)
  for key in pairs(map or {}) do
    if not validKeys[key] then map[key] = nil end
  end
end
local function syncTargetMemory(source)
  local queueIds, requestKeys = {}, {}
  for _, row in ipairs((source and source.targets) or {}) do
    local id = maintainerQueue.id(row)
    queueIds[id] = true
    requestKeys[id] = true
    if row.label then requestKeys[tostring(row.label)] = true end
  end
  maintainerQueue.prune(queueIds)
  pruneMap(lastRequestAt, requestKeys)
  pruneMap(activeRequests, requestKeys)
end
local function mergeLifecycle(report, lifecycle)
  report, lifecycle = report or {}, lifecycle or {}
  local submitted = report.requestAttempts or {}
  local merged = {}
  for _, attempt in ipairs(lifecycle.requestAttempts or {}) do merged[#merged + 1] = attempt end
  for _, attempt in ipairs(submitted) do merged[#merged + 1] = attempt end
  report.requestAttempts = merged
  report.requestAttempt = merged[#merged]
  local seen, acknowledgements = {}, {}
  for _, key in ipairs(report.requestAcks or {}) do
    key = tostring(key)
    if not seen[key] then seen[key], acknowledgements[#acknowledgements + 1] = true, key end
  end
  for _, key in ipairs(lifecycle.requestAcks or {}) do
    key = tostring(key)
    if not seen[key] then seen[key], acknowledgements[#acknowledgements + 1] = true, key end
  end
  report.requestAcks = acknowledgements
  return report
end
local function refreshCandidateSafety(report)
  local candidates = false
  for _, row in ipairs(report.targets or {}) do
    if row.ready or row.reason == "no ready CPU" or row.requestPhase == "status_link_lost" or row.requestPhase == "confirmation_unavailable" or row.requestPhase == "reboot_recovery" then candidates = true; break end
  end
  if not candidates then return end
  report.status.power = maintainerStatus.powerStatus()
  for _, row in ipairs(report.targets or {}) do
    if row.ready or row.reason == "no ready CPU" or row.requestPhase == "status_link_lost" or row.requestPhase == "confirmation_unavailable" or row.requestPhase == "reboot_recovery" then
      row.ready, row.reason = maintainerRules.safeToCraft(row, report.status, report.config, lastRequestAt)
    end
  end
end
local function configRows(config, reason)
  local rows = {}
  for _, target in ipairs((config and config.targets) or {}) do
    local rowReason = type(reason) == "function" and reason(target) or reason
    rows[#rows + 1] = {
      label = target.label,
      rawLabel = target.rawLabel,
      name = target.name,
      damage = target.damage,
      hasTag = target.hasTag,
      kind = target.kind,
      isFluid = target.isFluid,
      amount = target.amount,
      filter = target.filter,
      craftBinding = target.craftBinding,
      stockBinding = target.stockBinding,
      stockBindingError = target.stockBindingError,
      min = tonumber(target.min) or 0,
      craftTo = tonumber(target.craftTo or target.min) or 0,
      batch = target.batch,
      minBatteryRatio = target.minBatteryRatio,
      maxDeficitRatio = target.maxDeficitRatio,
      requireReadyCpu = target.requireReadyCpu,
      cooldown = target.cooldown,
      armed = target.armed == true,
      ready = false,
      craftable = false,
      requestState = "blocked",
      reason = rowReason
    }
  end
  return rows
end

local function observeReport(config, options)
  local reason = config.autoEnabled == false and "global auto off" or "target disarmed"
  local rows = configRows(config, reason)
  return {
    config = config,
    status = {
      mode = config.mode,
      autoEnabled = config.autoEnabled ~= false,
      craftCompatibility = config.craftCompatibility,
      fluidStockCompatibility = config.fluidStockCompatibility,
      requestReady = options.requestReady == true,
      armedTargets = maintainerStatus.armedTargets(config),
      targetCount = #(config.targets or {})
    },
    targets = rows,
    alerts = { "Observe only" },
    message = "No craft requested; mode is observe"
  }
end
function maintainer.config()
  local flow = workflows.load()
  local defaults = workflows.defaultConditions or {}
  local autoEnabled = workflows.autoEnabled(flow)
  local armedTargets = workflows.armedCount(flow)
  return {
    autoEnabled = autoEnabled,
    craftCompatibility = workflows.craftCompatibility(flow),
    fluidStockCompatibility = flow.fluidStockCompatibility,
    mode = autoEnabled and armedTargets > 0 and "armed" or "observe",
    cooldown = defaults.cooldown,
    minBatteryRatio = defaults.minBatteryRatio,
    maxDeficitRatio = defaults.maxDeficitRatio,
    targets = workflows.asTargets(flow)
  }
end
function maintainer.configSnapshot()
  local config = maintainer.config()
  local report = {
    config = config,
    status = {
      mode = config.mode,
      autoEnabled = config.autoEnabled ~= false,
      craftCompatibility = config.craftCompatibility,
      fluidStockCompatibility = config.fluidStockCompatibility,
      requestReady = false,
      armedTargets = maintainerStatus.armedTargets(config),
      targetCount = #(config.targets or {})
    },
    targets = configRows(config, "daemon heartbeat owns live status"),
    alerts = {},
    message = "Daemon config snapshot; daemon heartbeat owns live status"
  }
  syncTargetMemory(report)
  return report
end
function maintainer.setMode(mode)
  local active = maintainer.config().mode == "armed"
  if (mode == "armed") == active then return true end
  return false, "workflow arming is authoritative; change workflow targets instead"
end
function maintainer.safeToCraft(row, status, config)
  return maintainerRules.safeToCraft(row, status, config, lastRequestAt)
end
function maintainer.alerts(status, targets)
  return maintainerRules.alerts(status, targets)
end
function maintainer.snapshot(options)
  options = options or {}
  local config = maintainer.config()
  if options.mode then config.mode = options.mode end
  local report = maintainerStatus.snapshot(config, options, requestState, maintainer.safeToCraft)
  syncTargetMemory(report)
  report.alerts = maintainer.alerts(report.status, report.targets)
  return report
end
function maintainer.run(options)
  options = options or {}
  options.requestReady = true
  if options.skipObserveSnapshot then
    local config = maintainer.config()
    if options.mode then config.mode = options.mode end
    if config.mode ~= "armed" then
      local report = observeReport(config, options)
      syncTargetMemory(report)
      return report
    end
  end
  local report = maintainer.snapshot(options)
  local armed = report.status.mode == "armed"
  if not armed then
    report.message = "No craft requested; mode is observe"
    return report
  end
  refreshCandidateSafety(report)
  report.queuePolicySignature = cacheEpoch.configSignature(report.config)
  return maintainerRequests.submit(report, activeRequests, lastRequestAt, options)
end
function maintainer.resumeQueue(report, options)
  report, options = type(report) == "table" and report or {}, options or {}
  -- The prior step's acknowledgements were either consumed after its durable
  -- heartbeat or remain in the tracker and will be republished below.
  report.requestAcks = nil
  -- Queue ownership replaces the ordinary lifecycle-poll tick. Reconcile the
  -- same tracker snapshot first, then reuse it for capacity so completed or
  -- failed jobs release their exact queue memory without doubling OC calls.
  local requestPoll = require("oc.ae2.maintainer_request_poll")
  local lifecycle, trackerSummaries = requestPoll.snapshot(activeRequests, lastRequestAt)
  report.requestAttempts, report.requestAttempt = {}, nil
  options.trackerSummaries = trackerSummaries
  local planned = type(report.config) == "table"
    and (report.queuePolicySignature or cacheEpoch.configSignature(report.config)) or nil
  local current = maintainer.config()
  if not planned or planned ~= cacheEpoch.configSignature(current) then
    report.queueInvalidated = true
    report.message = "Frozen queue invalidated by current Flow policy; replanning required"
    report.dispatch = type(report.dispatch) == "table" and report.dispatch or {}
    report.dispatch.queueInvalidated = true
    return mergeLifecycle(report, lifecycle)
  end
  if requestPoll.persistencePending(lifecycle) then
    report.dispatch = type(report.dispatch) == "table" and report.dispatch or {}
    report.dispatch.remainingSlots, report.dispatch.maxSubmits = 0, 0
    report.dispatch.queuePausedReason = "waiting for terminal request result persistence"
    report.message = "Frozen queue held until terminal request state is durable"
    return mergeLifecycle(report, lifecycle)
  end
  report.queueInvalidated = nil
  refreshCandidateSafety(report)
  options.requestReady, options.queueOnly = true, true
  return mergeLifecycle(
    maintainerRequests.submit(report, activeRequests, lastRequestAt, options), lifecycle)
end
function maintainer.poll()
  local requestPoll = require("oc.ae2.maintainer_request_poll")
  return requestPoll.snapshot(activeRequests, lastRequestAt)
end
function maintainer.acknowledge(report)
  local requestPoll = require("oc.ae2.maintainer_request_poll")
  return requestPoll.acknowledge(report)
end
function maintainer.print(report)
  report = report or maintainer.run({ mode = "observe" })
  io.write("AE2 maintainer mode: " .. tostring(report.status.mode) .. "\n")
  io.write(string.format("AE2=%s CPUs=%d Battery=%s\n",
    tostring(report.status.ae2Online),
    tonumber(report.status.readyCpus) or 0,
    tostring(report.status.power.status or "unknown")))
  for _, row in ipairs(report.targets or {}) do
    local state = row.requested and "requested" or row.requestState ~= "none" and row.requestState or row.reason
    io.write(string.format("%s stock=%s min=%s request=%s state=%s\n",
      row.label,
      tostring(row.current or "n/a"),
      tostring(row.min),
      tostring(row.request),
      tostring(state)))
  end
end
return maintainer
local binding = require("oc.ae2.request_binding")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")

local catalog = {}
catalog.schema = 5

local function resetCache(cache)
  for key in pairs(cache) do cache[key] = nil end
  cache.schema = catalog.schema
  return cache
end

local function normalizeQuery(value)
  return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function dropLegacyDiscovery(cache)
  -- Schema 4 kept native allItems iterators in this table. Dropping every
  -- discovery field is intentional: a foreground search must never hold an
  -- AE2 storage listener or a full-grid traversal alive after it is closed.
  cache.scanEntries, cache.cursor, cache.cursors, cache.iterators = nil, nil, nil, nil
  cache.doneNodes, cache.rawCounts, cache.scanned, cache.progress = nil, nil, nil, nil
end

local function clearSearch(cache)
  cache.entries = {}
  dropLegacyDiscovery(cache)
  cache.complete = false
  cache.capped = false
  cache.error = nil
  cache.matched = nil
  cache.rawCount = nil
  cache.starter = nil
  cache.starterCount, cache.configuredCount = nil, nil
  cache.craftIds = nil
  cache.nextCraftId = nil
end

local function stableKey(entry)
  return model.keyFor(entry)
end

local function assignCraftIds(cache, entries, pruneMissing)
  local oldIds = cache.craftIds or {}
  local liveIds = pruneMissing and {} or oldIds
  local maxId = 0
  for _, id in pairs(oldIds) do
    id = tonumber(id) or 0
    if id > maxId then maxId = id end
  end
  cache.craftIds = oldIds
  cache.nextCraftId = math.max(tonumber(cache.nextCraftId) or 1, maxId + 1)
  for _, entry in ipairs(entries or {}) do
    local key = stableKey(entry)
    local id = oldIds[key]
    if not id then
      id = cache.nextCraftId
      cache.nextCraftId = id + 1
    end
    liveIds[key] = id
    if id > maxId then maxId = id end
    entry.rawCraftIndex = entry.craftIndex
    entry.craftId = id
    entry.craftIndex = id
  end
  if pruneMissing then
    cache.craftIds = liveIds
    cache.nextCraftId = maxId + 1
  end
  return entries
end

local function replaceEntries(cache, fresh)
  return assignCraftIds(cache, fresh, true)
end

local function localEntries(cache, config)
  local rows, source, seen, starterLabels = {}, {}, {}, {}
  local fluidAuthority = model.fluidStockAuthority(config)
  local configured = (config and config.workflows) or {}
  local starterMode, starterCount = #configured == 0, 0
  for _, suggestion in ipairs(model.suggestions or {}) do starterLabels[model.labelKey(suggestion)] = true end
  for configIndex, flow in ipairs(configured) do
    local key = model.labelKey(flow)
    source[#source + 1], seen[key] = { flow = flow, configIndex = configIndex }, true
    if starterLabels[key] then starterMode = true end
  end
  if starterMode then for _, suggestion in ipairs(model.suggestions or {}) do
    if not seen[model.labelKey(suggestion)] then
      source[#source + 1], starterCount = { flow = suggestion, suggested = true }, starterCount + 1
    end
  end end
  for _, sourceRow in ipairs(source) do
    local flow, configIndex, suggested = sourceRow.flow, sourceRow.configIndex, sourceRow.suggested == true
    -- Keep the normalized policy alongside a small identity projection. The
    -- old live-grid catalog could look the policy back up by craft identity;
    -- doing that for every local target turns a 5k-target dashboard into an
    -- O(n^2) scan. One normalized flow per configured row is enough.
    local workflow = model.normalize(flow)
    local entry = {
      label = workflow.label,
      rawLabel = workflow.rawLabel,
      name = workflow.name,
      damage = workflow.damage,
      hasTag = workflow.hasTag,
      kind = workflow.kind,
      isFluid = workflow.isFluid,
      amount = workflow.amount,
      filter = workflow.filter,
      craftBinding = workflow.craftBinding,
      stockBinding = workflow.stockBinding,
      mode = workflow.mode,
      configIndex = configIndex,
      suggested = suggested,
      workflow = workflow
    }
    model.applyFluidStockCompatibility(entry, config, fluidAuthority)
    entry.craftable = binding.error(entry) == nil
    rows[#rows + 1] = entry
  end
  table.sort(rows, function(a, b)
    local left, right = tostring(a.label or ""), tostring(b.label or "")
    if left ~= right then return left < right end
    return stableKey(a) < stableKey(b)
  end)
  cache.entries = replaceEntries(cache, rows)
  cache.query = nil
  cache.matched = #cache.entries
  cache.rawCount = nil
  cache.complete = true
  cache.capped = false
  cache.starter = starterCount > 0
  cache.starterCount, cache.configuredCount = starterCount, #configured
  cache.error = #cache.entries == 0
    and "No managed targets. Live AE2 browsing is disabled for server safety." or nil
end

function catalog.catalog(cache, options)
  options = options or {}
  cache = cache or {}
  if cache.schema ~= catalog.schema then resetCache(cache) end
  local config, configReason = store.editableConfig()
  local query = normalizeQuery(options.query)
  -- The dashboard is intentionally a local Managed Targets catalog. GTNH's
  -- allItems/getCraftables paths build a whole-grid snapshot before Lua can
  -- apply a chunk limit, so free-text AE2 browsing belongs in a controlled
  -- diagnostic workflow, never in a foreground HMI.
  dropLegacyDiscovery(cache)
  if type(config) == "table" then localEntries(cache, config)
  else
    clearSearch(cache)
    cache.complete = true
    cache.error = "Managed targets unavailable: " .. tostring(configReason or "workflow config is unreadable")
  end
  local rows = {}
  for _, entry in ipairs(cache.entries or {}) do
    local flow = entry.workflow
    rows[#rows + 1] = {
      label = entry.label,
      rawLabel = entry.rawLabel,
      name = entry.name,
      damage = entry.damage,
      hasTag = entry.hasTag,
      kind = entry.kind or (entry.isFluid and "fluid" or "item"),
      isFluid = entry.isFluid == true or entry.kind == "fluid",
      amount = entry.amount,
      filter = entry.filter,
      craftBinding = entry.craftBinding,
      stockBinding = entry.stockBinding,
      stockBindingError = entry.stockBindingError,
      source = entry.source,
      configIndex = entry.configIndex,
      suggested = entry.suggested == true,
      craftId = entry.craftId,
      craftIndex = entry.craftId or entry.craftIndex,
      rawCraftIndex = entry.rawCraftIndex,
      craftable = entry.craftable == true,
      mode = flow and flow.mode or "manual",
      workflow = flow
    }
  end
  return { entries = rows, config = config, cache = cache, capped = cache.capped, starter = cache.starter == true,
    starterCount = cache.starterCount or 0, configuredCount = cache.configuredCount or 0,
    query = query, maxMatches = #rows,
    matched = cache.matched, rawCount = cache.rawCount, cursor = cache.cursor,
    progress = cache.progress, complete = cache.complete == true, error = cache.error or cache.warmError }
end

function catalog.dispose(cache)
  if type(cache) ~= "table" then return true end
  clearSearch(cache)
  cache.schema = catalog.schema
  return true
end

return catalog
-- Public workflow editor facade. Focused helpers own exact binding and typed
-- condition patches; this file owns the canonical config/store transition.
local binding = require("oc.ae2.request_binding")
local choices = require("oc.ae2.workflow_choices")
local conditions = require("oc.ae2.workflow_editor_conditions")
local exact = require("oc.ae2.workflow_editor_binding")
local fluidStockAuto = require("oc.ae2.fluid_stock_auto")
local fluidStockProfile = require("oc.ae2.fluid_stock_profile")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")

local editor = {}

local function editableConfig()
  local config, err = store.editableConfig()
  if not config then return nil, err end
  return config
end

local function workflowFor(config, entry)
  return model.workflowFor(config, entry) or (entry and entry.workflow)
end

local function upsertRow(config, entry, patch)
  if not config then
    local err
    config, err = editableConfig()
    if not config then return nil, err end
  end
  patch = patch or {}
  local row = model.workflowFor(config, entry)
  if row then
    model.copyIdentity(row, entry)
    for key, value in pairs(patch) do row[key] = value end
    return config
  end
  row = model.normalize(entry)
  for key, value in pairs(patch) do row[key] = value end
  config.workflows[#config.workflows + 1] = row
  return config
end

function editor.upsert(config, entry, patch)
  local err
  config, err = upsertRow(config, entry, patch)
  if not config then return false, err end
  return store.saveConfig(config, store.hasPending())
end

function editor.toggleAuto(entry)
  local config, err = editableConfig()
  if not config then return false, err end
  local flow = model.normalize(workflowFor(config, entry) or entry or {})
  if flow.locked then return false, "line contract locked" end
  local mode = flow.mode == "auto" and "manual" or "auto"
  local patch = { mode = mode, lineAuthority = mode == "auto" and "auto" or "observe" }
  if mode == "auto" then
    patch.alertBelow = tonumber(flow.alertBelow or flow.minStock) or 100
    patch.minStock, patch.craftTo = patch.alertBelow, patch.alertBelow
    patch.maxRequest = tonumber(flow.maxRequest or flow.batch) or 1
    patch.batch = patch.maxRequest
  end
  return editor.upsert(config, entry, patch)
end

function editor.toggleArmed(entry)
  local config, err = editableConfig()
  if not config then return false, err end
  local flow = model.normalize(workflowFor(config, entry) or entry or {})
  local nextArmed = not (flow.armed == true)
  if nextArmed then
    local bindErr = binding.error(flow)
    if bindErr then return false, bindErr end
  end
  local patch = { armed = nextArmed, mode = "auto" }
  if nextArmed and flow.mode ~= "auto" and flow.lineAuthority == "observe" then patch.lineAuthority = "auto" end
  return editor.upsert(config, entry, patch)
end

function editor.disarmAll()
  local config, err = editableConfig()
  if not config then return false, err end
  for _, row in ipairs(config.workflows or {}) do row.armed = false end
  return store.saveConfig(config, store.hasPending())
end

function editor.setAllArmed(enabled, options)
  local config, err = editableConfig()
  if not config then return false, err end
  options = options or {}
  local limit = math.max(1, math.floor(tonumber(options.limit) or 8))
  local startIndex = math.max(1, math.floor(tonumber(options.startIndex) or 1))
  local rows, checked, changed, blocked, index = config.workflows or {}, 0, 0, 0, startIndex
  while index <= #rows and checked < limit do
    local row = model.normalize(rows[index])
    if row.mode == "auto" then
      checked = checked + 1
      local bindErr = enabled == true and binding.error(row) or nil
      if bindErr then blocked = blocked + 1 else
        if rows[index].armed ~= (enabled == true) then changed = changed + 1 end
        rows[index].armed = enabled == true
      end
    end
    index = index + 1
  end
  local progress = { startIndex = startIndex, nextIndex = index, limit = limit, checked = checked,
    changed = changed, blocked = blocked, total = #rows, complete = index > #rows }
  progress.complete = progress.complete == true
  if changed == 0 then return true, nil, config, progress end
  local ok, saveErr, saved = store.saveConfig(config, store.hasPending())
  return ok, saveErr, saved or config, progress
end

function editor.toggleGlobalAuto()
  local config, err = editableConfig()
  if not config then return false, err end
  config.autoEnabled = not (config.autoEnabled ~= false)
  return store.saveConfig(config, store.hasPending())
end

function editor.setGlobalAuto(enabled)
  local config, err = editableConfig()
  if not config then return false, err end
  config.autoEnabled = enabled ~= false
  return store.saveConfig(config, store.hasPending())
end

local function virginRuntime(status, daemon)
  return tonumber(daemon and daemon.generation) == 0
    and status.workerState == nil and status.generation == nil
    and status.stoppedGeneration == nil and status.lastTick == nil
    and status.inFlightCount == nil
end

local function compatibilityRuntimeBlocker(daemon, subject)
  subject = subject or "compatibility"
  local loaded, runtime = pcall(require, "oc.ae2.maintainer_state")
  if not loaded or type(runtime) ~= "table" or type(runtime.status) ~= "function"
      or type(runtime.manualInFlight) ~= "function" then
    return "maintainer runtime state unavailable; " .. subject .. " change refused"
  end
  local statusOk, status = pcall(runtime.status)
  if not statusOk or type(status) ~= "table" or status.readFailed == true then
    local reason = type(status) == "table" and (status.readError or status.lastError) or status
    return "maintainer runtime state unreadable"
      .. (reason and (": " .. tostring(reason)) or "") .. "; " .. subject .. " change refused"
  end
  if status.workerState == "running" then
    return "wait for the daemon worker to stop before changing " .. subject
  end
  local virgin = virginRuntime(status, daemon)
  local stateGeneration, stoppedGeneration = tonumber(status.generation), tonumber(status.stoppedGeneration)
  local configGeneration = tonumber(daemon and daemon.generation)
  if not virgin and (status.workerState ~= "stopped" or stateGeneration == nil
      or stoppedGeneration ~= stateGeneration or configGeneration == nil
      or stateGeneration > configGeneration) then
    return "start daemon once with Global Auto off, drain in-flight to 0, then stop it to record exit"
  end
  local inFlight = tonumber(status.inFlightCount)
  if not virgin and inFlight == nil then
    return "daemon in-flight state unavailable; start daemon once, drain to 0, then stop it"
  end
  if (inFlight or 0) > 0 then
    return "wait for daemon in-flight requests to clear before changing " .. subject
  end
  local manualOk, manualActive = pcall(runtime.manualInFlight)
  if not manualOk or manualActive == nil then
    return "manual request state unreadable; " .. subject .. " change refused"
  end
  if manualActive == true then return "wait for the manual request to finish before changing " .. subject end
  local trackerOk, tracker = pcall(require, "oc.ae2.request_tracker")
  if not trackerOk or type(tracker) ~= "table" or type(tracker.count) ~= "function" then
    return "request tracker unavailable; " .. subject .. " change refused"
  end
  local countOk, active = pcall(tracker.count)
  if not countOk then return "request tracker unreadable; " .. subject .. " change refused" end
  if (tonumber(active) or 0) > 0 then return "wait for the local request to finish before changing " .. subject end
  return nil
end

function editor.setCraftCompatibility(mode, commissioningOwner)
  local config, err = editableConfig()
  if not config then return false, err end
  mode = model.normalizeCraftCompatibility(mode)
  if model.craftCompatibility(config) == mode then return true, nil, config end
  if config.autoEnabled ~= false then return false, "turn Global Auto off before changing Craft API" end
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  local daemon = loaded and daemonConfig and daemonConfig.load and daemonConfig.load() or nil
  if not daemon then return false, "daemon control unavailable; Craft API change refused" end
  if daemon.enabled == true then return false, "turn daemon off before changing Craft API" end
  local runtimeBlocker = compatibilityRuntimeBlocker(daemon, "Craft API")
  if runtimeBlocker then return false, runtimeBlocker end
  local currentDaemon = daemonConfig.load()
  if not currentDaemon or currentDaemon.enabled == true
      or tonumber(currentDaemon.generation) ~= tonumber(daemon.generation) then
    return false, "daemon ownership changed while preparing Craft API change; retry from the stopped state"
  end
  local ok, saveErr, saved = store.patchRoot("craftCompatibility", mode, "craft_compatibility_set",
    function(candidate)
      if candidate.autoEnabled ~= false then
        return false, "Global Auto changed while preparing Craft API change; review and retry"
      end
      local latestDaemon = daemonConfig.load()
      if not latestDaemon or latestDaemon.enabled == true
          or tonumber(latestDaemon.generation) ~= tonumber(daemon.generation) then
        return false, "daemon ownership changed while preparing Craft API change; retry from the stopped state"
      end
      return true
    end, { commissioningOwner = commissioningOwner })
  if ok then
    local cacheOk, requestCache = pcall(require, "oc.ae2.request_cache")
    if cacheOk and requestCache and requestCache.clear then requestCache.clear() end
  end
  return ok, saveErr, saved
end

local function exactCapabilityProof(canaryFluid, supplied)
  if type(supplied) == "table" then return supplied end
  local adapterOk, adapter = pcall(require, "oc.ae2.adapter")
  local directOk, stockDirect = pcall(require, "oc.ae2.stock_direct")
  if not adapterOk or type(adapter) ~= "table" or type(adapter.primary) ~= "function"
      or not directOk or type(stockDirect) ~= "table"
      or type(stockDirect.probeLegacyFluidProxy) ~= "function" then
    return nil, "exact AE2FC canary capability probe is unavailable"
  end
  local node, nodeReason = adapter.primary()
  if type(node) ~= "table" or not binding.validGridAddress(node.address) then
    return nil, "current AE2 grid is unavailable: " .. tostring(nodeReason)
  end
  local positive, reason, report = stockDirect.probeLegacyFluidProxy(canaryFluid, node)
  if positive ~= true then return nil, reason or "exact AE2FC canary is not positive" end
  report = type(report) == "table" and report or {}
  local computerOk, computer = pcall(require, "computer")
  local observedAt = 0
  if computerOk and type(computer) == "table" and type(computer.uptime) == "function" then
    local called, stamp = pcall(computer.uptime)
    if called then observedAt = tonumber(stamp) or 0 end
  end
  return {
    contract = binding.fluidStockCapabilityContract, method = "getItemInNetwork",
    canaryFluid = tostring(canaryFluid), gridAddress = tostring(node.address),
    count = tonumber(report.count), observedAt = observedAt
  }
end

function editor.previewFluidStockCompatibility(canaryFluid, topologyRevision, proof)
  local config, err = editableConfig()
  if not config then return nil, err end
  -- Reject a self-canary from configuration truth before touching AE2.  Besides
  -- giving the operator the causal correction, this keeps an invalid choice
  -- from spending a network probe or depending on that fluid being positive.
  local reviewed = fluidStockProfile.targetSet(config)
  if reviewed.error then return nil, reviewed.error, reviewed end
  if reviewed.set[tostring(canaryFluid)] then
    return nil, "canary is maintained by 1 auto row(s); choose a positive fluid outside Maintainer", reviewed
  end
  local measured, measureErr = exactCapabilityProof(canaryFluid, proof)
  if not measured then return nil, measureErr end
  local marker, markerErr = fluidStockProfile.make(canaryFluid, topologyRevision, nil, measured)
  if not marker then return nil, markerErr end
  local current = fluidStockProfile.normalize(config.fluidStockCompatibility)
  if marker.automaticRevision
      and marker.automaticRevision ~= (tonumber(current.automaticRevision) or 0) + 1 then
    return nil, "automatic Fluid Stock revision is stale; automatic coordinator must re-plan"
  end
  marker.automaticRevision = math.max(tonumber(marker.automaticRevision) or 0,
    tonumber(current.automaticRevision) or 0)
  local preview = fluidStockProfile.preview(config, marker)
  if preview.error then return nil, preview.error, preview end
  if preview.conflicts > 0 then
    return nil, "canary is maintained by " .. tostring(preview.conflicts)
      .. " auto row(s); choose a positive fluid outside Maintainer", preview
  end
  marker, markerErr = fluidStockProfile.authorize(marker, config)
  if not marker then return nil, markerErr, preview end
  if current.mode == fluidStockProfile.mode
      and current.reviewedFluidSignature ~= marker.reviewedFluidSignature
      and current.topologyRevision == marker.topologyRevision then
    return nil, "auto-fluid target set changed; increment the topology revision before replacing the profile", preview
  end
  preview.marker, preview.expectedProfile = marker, current
  return preview
end

function editor.planAutomaticFluidStockCompatibility(options)
  local config, err = editableConfig()
  if not config then return nil, err end
  return fluidStockAuto.plan(config, options)
end

function editor.probeAutomaticFluidStockCanary(canaryFluid, planToken)
  local config, err = editableConfig()
  if not config then return false, err end
  return fluidStockAuto.probe(config, canaryFluid, planToken)
end

local fluidProfileFields = {
  "mode", "canaryFluid", "topology", "topologyRevision", "hostId",
  "gridAddress", "authorityModel", "capabilityContract", "capabilityMethod",
  "capabilityCount", "capabilityObservedAt", "targetSetContract",
  "reviewedFluidCount", "reviewedFluidSignature", "automaticRevision", "locked", "lastTopologyRevision"
}

local function sameFluidProfile(left, right)
  left, right = fluidStockProfile.normalize(left), fluidStockProfile.normalize(right)
  for _, field in ipairs(fluidProfileFields) do
    if left[field] ~= right[field] then return false end
  end
  return true
end

local function fluidStockCommit(marker, action, expectedProfile, commissioningOwner)
  local config, err = editableConfig()
  if not config then return false, err end
  if expectedProfile and not sameFluidProfile(config.fluidStockCompatibility, expectedProfile) then
    return false, "Fluid Stock profile changed while preparing removal; review and retry"
  end
  if config.autoEnabled ~= false then return false, "turn Global Auto off before changing Fluid Stock API" end
  local commitPreview = nil
  if marker.mode == fluidStockProfile.mode then
    commitPreview = fluidStockProfile.preview(config, marker)
    if commitPreview.conflicts > 0 then
      return false, "canary became a maintained auto fluid while preparing Fluid Stock API change; review and retry"
    end
    local markerErr = fluidStockProfile.error(marker, nil, config)
    if markerErr then return false, markerErr end
  end
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  local daemon = loaded and daemonConfig and daemonConfig.load and daemonConfig.load() or nil
  if not daemon then return false, "daemon control unavailable; Fluid Stock API change refused" end
  if daemon.enabled == true then return false, "turn daemon off before changing Fluid Stock API" end
  local runtimeBlocker = compatibilityRuntimeBlocker(daemon, "Fluid Stock API")
  if runtimeBlocker then return false, runtimeBlocker end
  local currentDaemon = daemonConfig.load()
  if not currentDaemon or currentDaemon.enabled == true
      or tonumber(currentDaemon.generation) ~= tonumber(daemon.generation) then
    return false, "daemon ownership changed while preparing Fluid Stock API change; retry from the stopped state"
  end
  local ok, saveErr, saved = store.patchRoot("fluidStockCompatibility", marker, action,
    function(candidate)
      if candidate.autoEnabled ~= false then
        return false, "Global Auto changed while preparing Fluid Stock API change; review and retry"
      end
      if expectedProfile and not sameFluidProfile(candidate.fluidStockCompatibility, expectedProfile) then
        return false, "Fluid Stock profile changed while preparing removal; review and retry"
      end
      local latestDaemon = daemonConfig.load()
      if not latestDaemon or latestDaemon.enabled == true
          or tonumber(latestDaemon.generation) ~= tonumber(daemon.generation) then
        return false, "daemon ownership changed while preparing Fluid Stock API change; retry from the stopped state"
      end
      if marker.mode == fluidStockProfile.mode then
        local fresh = fluidStockProfile.preview(candidate, marker)
        if fresh.conflicts > 0 then
          return false, "canary became a maintained auto fluid while preparing Fluid Stock API change; review and retry"
        end
        local markerErr = fluidStockProfile.error(marker, nil, candidate)
        if markerErr then return false, markerErr end
      end
      return true
    end, { commissioningOwner = commissioningOwner })
  if ok then
    local memoryOk, stockMemory = pcall(require, "oc.ae2.stock_memory")
    if memoryOk and stockMemory and stockMemory.clear then stockMemory.clear() end
    local directOk, stockDirect = pcall(require, "oc.ae2.stock_direct")
    if directOk and stockDirect and stockDirect.clearCompatibilityMemory then
      stockDirect.clearCompatibilityMemory()
    end
  end
  return ok, saveErr, saved, commitPreview
end

function editor.setFluidStockCompatibility(canaryFluid, topologyRevision, confirmation, proof,
    commissioningOwner)
  if confirmation ~= "CONFIRM" then
    return false, "global fluid stock profile requires the final CONFIRM token"
  end
  local preview, previewErr = editor.previewFluidStockCompatibility(canaryFluid, topologyRevision, proof)
  if not preview then return false, previewErr end
  local ok, err, saved, committedPreview = fluidStockCommit(preview.marker,
    "fluid_stock_profile_set", preview.expectedProfile, commissioningOwner)
  if not ok then return false, err end
  committedPreview = committedPreview or preview
  return true, nil, saved, {
    action = "fluid-stock-profile-set", eligible = committedPreview.eligible,
    excluded = committedPreview.excluded, canaryFluid = preview.marker.canaryFluid,
    topologyRevision = preview.marker.topologyRevision, hostId = preview.marker.hostId,
    gridAddress = preview.marker.gridAddress,
    capabilityContract = preview.marker.capabilityContract,
    locked = true
  }
end

function editor.clearFluidStockCompatibility(confirmation)
  if confirmation ~= "CONFIRM" then
    return false, "global fluid stock profile removal requires the final CONFIRM token"
  end
  local config, err = editableConfig()
  if not config then return false, err end
  local current = fluidStockProfile.normalize(config.fluidStockCompatibility)
  return fluidStockCommit(fluidStockProfile.retire(current), "fluid_stock_profile_clear", current)
end

function editor.addExact(kind, name, damage, label, confirmation)
  return exact.add(kind, name, damage, label, confirmation)
end
function editor.bindExact(index, kind, name, damage) return exact.bind(index, kind, name, damage) end
function editor.rebindExact(index, kind, name, damage, confirmation)
  return exact.rebind(index, kind, name, damage, confirmation)
end
function editor.bindFluidStock(index, canaryFluid, topologyRevision, confirmation)
  return exact.bindFluidStock(index, canaryFluid, topologyRevision, confirmation)
end
function editor.unbindFluidStock(index, confirmation)
  return exact.unbindFluidStock(index, confirmation)
end

function editor.adjust(entry, field, delta)
  local loaded, loadErr = editableConfig()
  if not loaded then return false, loadErr end
  local config, err = conditions.adjustedConfig(loaded, entry, field, delta, upsertRow, workflowFor)
  if not config then return false, err end
  return store.saveConfig(config, false)
end

function editor.adjustPending(entry, field, delta)
  local loaded, loadErr = editableConfig()
  if not loaded then return false, loadErr end
  local config, err = conditions.adjustedConfig(loaded, entry, field, delta, upsertRow, workflowFor)
  if not config then return false, err end
  local pending, pendingReason = store.setPending(config)
  if not pending then return false, pendingReason end
  return true, nil, config
end

function editor.setValue(entry, field, value)
  local patch, err = conditions.valuePatch(field, value)
  if not patch then return false, err end
  local loaded, loadErr = editableConfig()
  if not loaded then return false, loadErr end
  local flow = model.normalize(workflowFor(loaded, entry) or entry)
  if flow.locked and field ~= "locked" then return false, "line contract locked" end
  local config
  config, err = upsertRow(loaded, entry, patch)
  if not config then return false, err end
  return store.saveConfig(config, true)
end

function editor.setChoice(entry, field, value)
  local loaded, loadErr = editableConfig()
  if not loaded then return false, loadErr end
  local flow = model.normalize(workflowFor(loaded, entry) or entry)
  if flow.locked and field ~= "locked" then return false, "line contract locked" end
  local patch, err = choices.patch(field, value, flow)
  if not patch then return false, err end
  local config
  config, err = upsertRow(loaded, entry, patch)
  if not config then return false, err end
  return store.saveConfig(config, true)
end

function editor.delete(entry)
  local loaded, loadErr = editableConfig()
  if not loaded then return false, loadErr end
  local config = model.compactConfig(loaded)
  local target = model.workflowFor(config, entry)
  if not target then return false, "workflow target not found" end
  local rows = {}
  for _, row in ipairs(config.workflows or {}) do if row ~= target then rows[#rows + 1] = row end end
  config.workflows = rows
  return store.saveConfig(config, true)
end

return editor
-- Local exact-identity migration/correction. This module deliberately has no
-- AE2 component dependency: binding is a config write, never discovery.
local binding = require("oc.ae2.request_binding")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")

local exact = {}

local function editableConfig()
  local config, err = store.editableConfig()
  if not config then return nil, err end
  return config
end

local function bindingIndex(value)
  local index = tonumber(value)
  if not index or index < 1 or index ~= math.floor(index) then
    return nil, "workflow index must be a positive whole number"
  end
  return index
end

local function bindingKind(value)
  local kind = tostring(value or ""):lower()
  if kind ~= "item" and kind ~= "fluid" then return nil, "binding kind must be item or fluid" end
  return kind
end

local function bindingName(kind, value)
  local name = tostring(value or "")
  if kind == "fluid" then
    if not binding.validFluidName(name) then
      return nil, "fluid registry name must be 1-192 safe identity characters"
    end
    return name
  end
  if not name:match("^[a-z0-9_.%-]+:[a-z0-9_./%-]+$") then
    return nil, "item registry name must look like namespace:path"
  end
  return name
end

local function bindingDamage(kind, value)
  if kind == "fluid" then
    if value ~= "-" then return nil, "fluid damage must be -" end
    return nil
  end
  local damage = tonumber(value)
  if not damage or damage ~= damage or damage < 0 or damage >= math.huge or damage ~= math.floor(damage) then
    return nil, "item damage must be a non-negative whole number"
  end
  return damage
end

local function displayLabel(value)
  if type(value) ~= "string" or value == "" or #value > 96
      or value:find("[%c]") or value:match("^%s") or value:match("%s$") then
    return nil, "display label must be 1-96 visible characters with no leading or trailing space"
  end
  return value
end

local function bindingEntry(kind, name, damage)
  local filter = { name = name }
  if kind == "item" then filter.damage = damage end
  return { name = name, damage = damage, hasTag = false, kind = kind,
    isFluid = kind == "fluid", filter = filter }
end

local function conflictingExactBinding(config, index, kind, name, damage)
  for otherIndex, other in ipairs((config and config.workflows) or {}) do
    if otherIndex ~= index and not binding.tagged(other) and tostring(other.name or "") == name then
      local normalized = model.normalize(other)
      if normalized.kind == kind and (kind == "fluid" or tonumber(normalized.damage) == damage) then
        return otherIndex
      end
    end
  end
  return nil
end

function exact.add(kind, name, damage, label, confirmation)
  if confirmation ~= "CONFIRM" then
    return false, "add-exact requires the final CONFIRM token"
  end
  local parsedKind, kindErr = bindingKind(kind)
  if not parsedKind then return false, kindErr end
  local parsedName, nameErr = bindingName(parsedKind, name)
  if not parsedName then return false, nameErr end
  local damageToken = parsedKind == "fluid" and damage == nil and "-" or damage
  local parsedDamage, damageErr = bindingDamage(parsedKind, damageToken)
  if damageErr then return false, damageErr end
  local parsedLabel, labelErr = displayLabel(label)
  if not parsedLabel then return false, labelErr end
  local config, configErr = editableConfig()
  if not config then return false, configErr end
  local conflict = conflictingExactBinding(config, nil, parsedKind, parsedName, parsedDamage)
  if conflict then return false, "exact identity already belongs to workflow index " .. tostring(conflict) end
  local entry = bindingEntry(parsedKind, parsedName, parsedDamage)
  entry.label, entry.mode, entry.lineAuthority = parsedLabel, "manual", "observe"
  entry.armed, entry.locked = false, false
  local row = model.normalize(entry)
  config.workflows = config.workflows or {}
  config.workflows[#config.workflows + 1] = row
  local appendedIndex = #config.workflows
  local ok, saveErr, saved = store.saveConfig(config, store.hasPending())
  if not ok then return false, saveErr end
  local verifiedIndex = conflictingExactBinding(saved or config, nil, parsedKind, parsedName, parsedDamage)
  return true, nil, saved, {
    action = "added-exact", committed = true, index = verifiedIndex or appendedIndex,
    configIndex = verifiedIndex, inspectionRequired = verifiedIndex == nil,
    label = row.label, kind = parsedKind, name = parsedName, damage = parsedDamage
  }
end

local function write(index, kind, name, damage, rebind)
  local parsedIndex, indexErr = bindingIndex(index)
  if not parsedIndex then return false, indexErr end
  local parsedKind, kindErr = bindingKind(kind)
  if not parsedKind then return false, kindErr end
  local parsedName, nameErr = bindingName(parsedKind, name)
  if not parsedName then return false, nameErr end
  local parsedDamage, damageErr = bindingDamage(parsedKind, damage)
  if damageErr then return false, damageErr end
  local config, err = editableConfig()
  if not config then return false, err end
  local row = (config.workflows or {})[parsedIndex]
  if not row then return false, "workflow index " .. tostring(parsedIndex) .. " does not exist" end
  local taggedProxyRepair = rebind and parsedKind == "fluid"
    and binding.isTaggedLegacyFluidProxy(row)
  if binding.tagged(row) and not taggedProxyRepair then
    return false, "tagged workflows cannot be migrated by this command"
  end
  local normalized = model.normalize(row)
  if normalized.locked then return false, "line contract locked" end
  if normalized.armed then return false, "workflow index " .. tostring(parsedIndex) .. " is armed; disarm it before binding" end
  local hasBinding = row.name and tostring(row.name) ~= ""
  if not rebind and hasBinding then return false, "workflow index " .. tostring(parsedIndex) .. " already has an exact binding" end
  if rebind and not hasBinding then return false, "workflow index " .. tostring(parsedIndex) .. " has no exact binding; use ae2-workflow bind first" end
  if taggedProxyRepair and binding.isLegacyFluidProxyName(parsedName) then
    return false, "replacement must name the exact nested fluid, not an AE2FC fluid proxy item"
  end
  local conflict = conflictingExactBinding(config, parsedIndex, parsedKind, parsedName, parsedDamage)
  if conflict then return false, "exact identity already belongs to workflow index " .. tostring(conflict) end
  local entry = bindingEntry(parsedKind, parsedName, parsedDamage)
  model.copyIdentity(row, entry)
  -- Stock authority is a separate exact contract. Any craft-identity change
  -- revokes the old proxy marker rather than silently retargeting it.
  row.craftBinding, row.stockBinding, row.stockBindingError = nil, nil, nil
  row.damage, row.hasTag = parsedDamage, false
  row.kind, row.isFluid, row.filter = parsedKind, parsedKind == "fluid", entry.filter
  if taggedProxyRepair then row.mode, row.armed = "manual", false end
  local ok, saveErr, saved = store.saveConfig(config, store.hasPending())
  if not ok then return false, saveErr end
  return true, nil, saved, {
    action = rebind and "rebound" or "bound", index = parsedIndex, label = row.label,
    kind = parsedKind, name = parsedName, damage = parsedDamage,
    replacedTagged = taggedProxyRepair == true or nil
  }
end

function exact.bind(index, kind, name, damage) return write(index, kind, name, damage, false) end

function exact.rebind(index, kind, name, damage, confirmation)
  if confirmation ~= "CONFIRM" then return false, "rebind requires the final CONFIRM token" end
  return write(index, kind, name, damage, true)
end

local function editableFluidRow(index)
  local parsedIndex, indexErr = bindingIndex(index)
  if not parsedIndex then return nil, nil, indexErr end
  local config, configErr = editableConfig()
  if not config then return nil, nil, configErr end
  local row = (config.workflows or {})[parsedIndex]
  if not row then return nil, nil, "workflow index " .. tostring(parsedIndex) .. " does not exist" end
  local normalized = model.normalize(row)
  if normalized.kind ~= "fluid" then return nil, nil, "legacy stock binding requires a fluid workflow" end
  local bindErr = binding.error(normalized)
  if bindErr then return nil, nil, bindErr end
  if normalized.locked then return nil, nil, "line contract locked" end
  if normalized.armed then
    return nil, nil, "workflow index " .. tostring(parsedIndex) .. " is armed; disarm it before changing stock authority"
  end
  return config, row, nil, parsedIndex, normalized
end

function exact.bindFluidStock(index, canaryFluid, topologyRevision, confirmation)
  if confirmation ~= "CONFIRM" then
    return false, "legacy fluid stock binding requires the final CONFIRM token"
  end
  local config, row, err, parsedIndex, normalized = editableFluidRow(index)
  if not config then return false, err end
  if row.stockBinding ~= nil then
    return false, "workflow index " .. tostring(parsedIndex) .. " already has a fluid stock binding"
  end
  local marker = binding.makeLegacyFluidStockBinding(normalized, canaryFluid, topologyRevision)
  if not marker then
    return false, "canary must be a different safe fluid registry name; topology revision allows letters, numbers, dot, dash, or underscore"
  end
  row.stockBinding = marker
  local ok, saveErr, saved = store.saveConfig(config, store.hasPending())
  if not ok then return false, saveErr end
  return true, nil, saved, {
    action = "fluid-stock-bound", index = parsedIndex, label = row.label,
    fluid = marker.fluid, canaryFluid = marker.canaryFluid,
    topologyRevision = marker.topologyRevision, locked = true
  }
end

function exact.unbindFluidStock(index, confirmation)
  if confirmation ~= "CONFIRM" then
    return false, "legacy fluid stock unbind requires the final CONFIRM token"
  end
  local config, row, err, parsedIndex = editableFluidRow(index)
  if not config then return false, err end
  if row.stockBinding == nil then
    return false, "workflow index " .. tostring(parsedIndex) .. " has no fluid stock binding"
  end
  row.stockBinding = nil
  local ok, saveErr, saved = store.saveConfig(config, store.hasPending())
  if not ok then return false, saveErr end
  return true, nil, saved, {
    action = "fluid-stock-unbound", index = parsedIndex, label = row.label, locked = false
  }
end

return exact
-- Workflow condition parsing and patch construction. It has no store access:
-- the editor facade owns the single canonical save/pending-write boundary.
local choices = require("oc.ae2.workflow_choices")
local model = require("oc.ae2.workflow_model")

local conditions = {}

local function adjustNumber(value, delta, step, min, max)
  value = (tonumber(value) or 0) + ((tonumber(delta) or 0) * step)
  if min and value < min then value = min end
  if max and value > max then value = max end
  return value
end

function conditions.valuePatch(field, value)
  local number = (field == "minStock" or field == "batch" or field == "alertBelow" or field == "maxRequest") and model.parseQuantity(value)
    or field == "cooldown" and model.parseDuration(value) or tonumber(value)
  if not number then return nil, "number required" end
  if field == "batch" or field == "maxRequest" then
    number = model.clampQuantity(value, 1)
  elseif field == "cooldown" then
    number = model.clampCooldown(value)
  elseif field == "minStock" or field == "alertBelow" then
    number = model.clampQuantity(value, 0)
  elseif field == "minBatteryRatio" then
    if number < 0 then number = 0 end
    if number > 1 then number = 1 end
  elseif field == "maxDeficitRatio" then
    if number < 0 then number = 0 end
    if number > 10 then number = 10 end
  else
    return nil, "typed edit unsupported"
  end
  if field == "minStock" or field == "alertBelow" then return { alertBelow = number, minStock = number, craftTo = number } end
  if field == "batch" or field == "maxRequest" then return { maxRequest = number, batch = number } end
  return { [field] = number }
end

function conditions.adjustedConfig(config, entry, field, delta, upsert, workflowFor)
  if not entry or not field then return false, "no workflow selected" end
  local flow = model.normalize(workflowFor(config, entry) or entry)
  local patch = {}
  if flow.locked and field ~= "locked" then return false, "line contract locked" end
  if field == "lineIntent" then
    patch.lineIntent = choices.nextIntent(flow.lineIntent, delta)
  elseif field == "lineAuthority" then
    patch.lineAuthority = choices.nextAuthority(flow.lineAuthority, delta)
    patch.mode = patch.lineAuthority == "auto" and "auto" or flow.mode
  elseif field == "alertEnabled" or field == "locked" or field == "dangerUnlocked" then
    patch[field] = not flow[field]
  elseif field == "requireReadyCpu" then
    patch[field] = not flow.requireReadyCpu
  elseif field == "minBatteryRatio" then
    patch[field] = adjustNumber(flow[field], delta, 0.05, 0, 1)
  elseif field == "maxDeficitRatio" then
    patch[field] = adjustNumber(flow[field], delta, 0.05, 0, 10)
  elseif field == "cooldown" then
    patch[field] = adjustNumber(flow[field], delta, 30, model.minimumCooldown, model.maxCooldown)
  elseif field == "batch" or field == "maxRequest" then
    patch.maxRequest = adjustNumber(flow.maxRequest, delta, 10, 1, nil)
    patch.batch = patch.maxRequest
  elseif field == "minStock" or field == "alertBelow" then
    patch.alertBelow = adjustNumber(flow.alertBelow, delta, 10, 0, nil)
    patch.minStock, patch.craftTo = patch.alertBelow, patch.alertBelow
  else
    return false, "unknown condition"
  end
  return upsert(config, entry, patch)
end

return conditions
local choices = {}

choices.intents = { "maintain_buffer", "push_max", "recipe_governed", "manual_only" }
choices.authorities = { "observe", "alert", "suggest", "auto" }

local function contains(values, wanted)
  for _, value in ipairs(values) do
    if value == wanted then return true end
  end
  return false
end

local function nextCycle(values, current, delta)
  local selected = 1
  for index, value in ipairs(values) do
    if value == current then selected = index; break end
  end
  selected = selected + ((tonumber(delta) or 0) < 0 and -1 or 1)
  if selected < 1 then selected = #values end
  if selected > #values then selected = 1 end
  return values[selected]
end

function choices.nextIntent(current, delta)
  return nextCycle(choices.intents, current, delta)
end

function choices.nextAuthority(current, delta)
  return nextCycle(choices.authorities, current, delta)
end

function choices.patch(field, value, flow)
  value = tostring(value or "")
  if field == "lineIntent" then
    if not contains(choices.intents, value) then return nil, "unknown line intent" end
    return { lineIntent = value }
  elseif field == "lineAuthority" then
    if not contains(choices.authorities, value) then return nil, "unknown line authority" end
    return { lineAuthority = value, mode = value == "auto" and "auto" or flow.mode }
  end
  return nil, "direct selector unsupported"
end

return choices
local contract = {}

contract.maxQuantity = 1e15
contract.maxSafeRequest = 2147483647

local quantitySuffixes = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, p = contract.maxQuantity }

local intents = {
  maintain_buffer = true,
  push_max = true,
  recipe_governed = true,
  manual_only = true
}

local intentAliases = {
  maintain = "maintain_buffer",
  maintain_buffer = "maintain_buffer",
  buffer = "maintain_buffer",
  stock = "maintain_buffer",
  max = "push_max",
  max_request = "push_max",
  push_max = "push_max",
  line_max = "push_max",
  recipe = "recipe_governed",
  recipe_governed = "recipe_governed",
  governed = "recipe_governed",
  manual = "manual_only",
  manual_only = "manual_only"
}

local authorities = {
  observe = true,
  alert = true,
  suggest = true,
  auto = true
}

local authorityAliases = {
  off = "observe",
  observe = "observe",
  watch = "observe",
  alert = "alert",
  alarm = "alert",
  suggest = "suggest",
  approve = "suggest",
  auto = "auto",
  submit = "auto",
  automatic = "auto"
}

local function key(value)
  return tostring(value or ""):lower():gsub("[%s%-]+", "_")
end

local function parseQuantity(value)
  if type(value) == "number" then return value end
  local text = tostring(value or ""):gsub(",", ""):gsub("%s+", "")
  local suffix = text:match("([KkMmBbTtPp])$")
  if suffix then
    local base = tonumber(text:sub(1, -2))
    if not base then return nil end
    return base * quantitySuffixes[suffix:lower()]
  end
  return tonumber(text)
end

local function quantity(value, minimum, fallback)
  local number = parseQuantity(value)
  if number == nil then number = fallback end
  number = tonumber(number)
  if number == nil then return fallback end
  number = math.floor(number)
  minimum = minimum or 0
  if number < minimum then number = minimum end
  if number > contract.maxQuantity then number = contract.maxQuantity end
  return number
end

local function canonicalIntent(value)
  local resolved = intentAliases[key(value)]
  return intents[resolved] and resolved or "maintain_buffer"
end

local function canonicalAuthority(value, mode)
  local resolved = authorityAliases[key(value)]
  if authorities[resolved] then return resolved end
  return mode == "auto" and "auto" or "observe"
end

function contract.normalize(row)
  row = row or {}
  local mode = row.mode == "manual" and "manual" or "auto"
  local alertBelow = quantity(row.alertBelow or row.minStock or row.min or row.craftTo, 0, 0)
  local maxRequest = quantity(row.maxRequest or row.batch or row.request or row.craftTo, 1, 1)
  local recipeMax = quantity(row.recipeMax or row.learnedRecipeMax, 1, nil)
  local basis = row.maxBasis
  if basis ~= "recipe_ceiling" and basis ~= "learned_ceiling" and basis ~= "cpu_boundary" then
    basis = "operator_cap"
  end
  return {
    lineIntent = canonicalIntent(row.lineIntent or row.intent),
    lineAuthority = canonicalAuthority(row.lineAuthority or row.authority, mode),
    alertEnabled = row.alertEnabled ~= false,
    alertBelow = alertBelow,
    maxRequest = maxRequest,
    recipeMax = recipeMax,
    maxBasis = basis,
    confidence = tostring(row.confidence or "cap_limited"),
    locked = row.locked == true,
    dangerUnlocked = row.dangerUnlocked == true
  }
end

local function stateForAuthority(authority)
  if authority == "observe" then return "observe", "observe authority; no auto submit" end
  if authority == "alert" then return "alert", "alert authority; no auto submit" end
  if authority == "suggest" then return "suggest", "suggest authority; no auto submit" end
  return nil
end

local function amountFor(line)
  local amount = line.maxRequest
  local basis, confidence = "operator_cap", line.confidence or "cap_limited"
  if line.lineIntent == "recipe_governed" then
    if line.recipeMax and line.recipeMax > 0 then
      amount, basis, confidence = math.min(line.maxRequest, line.recipeMax), "recipe_ceiling", "recipe_known"
    else
      basis, confidence = "operator_cap", "recipe_unknown"
    end
  end
  if amount < 0 then amount = 0 end
  return amount, basis, confidence
end

function contract.requestAmount(row)
  row = row or {}
  local line = contract.normalize(row)
  local authorityState, authorityReason = stateForAuthority(line.lineAuthority)
  if authorityState then return 0, authorityReason, authorityState, line.maxBasis, line.confidence end
  if line.lineIntent == "manual_only" then
    return 0, "manual-only line contract", "manual_only", line.maxBasis, line.confidence
  end
  if line.maxRequest > contract.maxSafeRequest and not line.dangerUnlocked then
    return 0, "request cap above signed-int safety boundary", "danger_locked", "operator_cap", "unsafe_cap"
  end

  local current = tonumber(row.current)
  local boundary = tonumber(row.alertBelow or row.min or row.minStock or line.alertBelow) or line.alertBelow
  local amount, basis, confidence = amountFor(line)
  if line.lineIntent == "recipe_governed" and confidence == "recipe_unknown" then
    return 0, "recipe ceiling unknown; auto blocked", "recipe_unknown", basis, confidence
  end
  if line.lineIntent == "push_max" then
    return amount, "push max cooldown request", "ready", basis, confidence
  end
  if current == nil then
    return amount, "stock unknown; showing request cap", "stock_unknown", basis, confidence
  end
  if current >= boundary then
    return 0, "stock satisfies alert boundary", "satisfied", basis, confidence
  end
  if line.lineIntent == "recipe_governed" then
    return amount, "recipe ceiling below alert boundary", "ready", basis, confidence
  end
  return amount, "below alert boundary", "ready", basis, confidence
end

function contract.summary(row)
  row = row or {}
  local amount = tonumber(row.request or row.maxRequest or row.batch) or 0
  local boundary = tonumber(row.alertBelow or row.min or row.minStock) or 0
  local state = tostring(row.lineState or "unknown")
  return state .. " | max " .. tostring(amount) .. " below " .. tostring(boundary)
end

function contract.annotate(row)
  row = row or {}
  local line = contract.normalize(row)
  for keyName, value in pairs(line) do row[keyName] = value end
  local amount, reason, state, basis, confidence = contract.requestAmount(row)
  row.request = amount
  row.lineReason = reason
  row.lineState = state
  row.maxBasis = basis or row.maxBasis
  row.confidence = confidence or row.confidence
  row.lineSummary = contract.summary(row)
  return row
end

function contract.intentLabel(value)
  value = canonicalIntent(value)
  if value == "push_max" then return "Push Max" end
  if value == "recipe_governed" then return "Recipe Governed" end
  if value == "manual_only" then return "Manual Only" end
  return "Maintain Buffer"
end

function contract.authorityLabel(value)
  value = canonicalAuthority(value)
  if value == "alert" then return "Alert" end
  if value == "suggest" then return "Suggest" end
  if value == "auto" then return "Auto Submit" end
  return "Observe"
end

function contract.intentHint(value)
  value = canonicalIntent(value)
  if value == "push_max" then return "Submit Max Request every cooldown while armed and gated." end
  if value == "recipe_governed" then return "Use Recipe Ceiling; block auto until the ceiling is known." end
  if value == "manual_only" then return "Manual button only; daemon never submits." end
  return "Submit Max Request only when stock is below Alert Below."
end

function contract.authorityHint(value)
  value = canonicalAuthority(value)
  if value == "alert" then return "Alarm only; no craft submit." end
  if value == "suggest" then return "Suggest only; no craft submit." end
  if value == "auto" then return "Daemon may submit when intent gates pass." end
  return "Watch only; no alarm or submit."
end

return contract
-- Public workflow-model facade. Identity, numeric grammar, and compaction are
-- split into cohesive helpers so this deploy file stays safe to paste by hand.
local binding = require("oc.ae2.request_binding")
local compact = require("oc.ae2.workflow_model_compact")
local fluidStockProfile = require("oc.ae2.fluid_stock_profile")
local identity = require("oc.ae2.workflow_model_identity")
local lineContract = require("oc.ae2.line_contract")
local numbers = require("oc.ae2.workflow_model_numbers")
local workflowId = require("oc.ae2.workflow_id")

local model = {}

model.path = "/etc/oc-ae2-workflows.cfg"
-- A fresh computer cannot know exact registry/damage identity without asking
-- its own AE2 grid. Seed no authoritative rows; exact config-only binding can create,
-- disarmed policy, while persisted legacy label rows recover on first action.
model.defaults = {}
local function starter(label)
  return { label = label, kind = "item", mode = "manual", lineIntent = "maintain_buffer",
    lineAuthority = "observe", alertBelow = 100, maxRequest = 100 }
end
model.suggestions = {
  starter("Steel Ingot"), starter("Aluminium Ingot"), starter("Stainless Steel Ingot"),
  starter("Titanium Ingot"), starter("Tungstensteel Ingot")
}
model.defaultConditions = {
  lineIntent = "maintain_buffer", lineAuthority = "auto", alertEnabled = true,
  minBatteryRatio = 0.25, maxDeficitRatio = 1.25, requireReadyCpu = true, cooldown = 600
}
model.minimumCooldown = 600
model.maxCooldown = 604800
model.maxQuantity = 1e15
model.manualTemplate = { mode = "manual" }
model.craftCompatibilityModes = {
  auto = "auto", legacyFiltered = "legacy_filtered", scalarOnly = "scalar_only"
}
model.defaultCraftCompatibility = model.craftCompatibilityModes.scalarOnly
model.conditionFields = {
  "lineIntent", "lineAuthority", "alertBelow", "maxRequest", "alertEnabled",
  "requireReadyCpu", "minBatteryRatio", "maxDeficitRatio", "cooldown", "locked"
}

function model.parseQuantity(value) return numbers.parseQuantity(value, model.maxQuantity) end
function model.clampQuantity(value, minimum) return numbers.clampQuantity(value, minimum, model.maxQuantity) end
function model.parseDuration(value) return numbers.parseDuration(value, model.maxCooldown) end
function model.clampCooldown(value) return numbers.clampCooldown(value, model.minimumCooldown, model.maxCooldown) end

function model.normalizeCraftCompatibility(value)
  value = tostring(value or "")
  for _, mode in pairs(model.craftCompatibilityModes) do if value == mode then return mode end end
  return model.defaultCraftCompatibility
end

function model.craftCompatibility(config)
  return model.normalizeCraftCompatibility(type(config) == "table" and config.craftCompatibility or config)
end

function model.fluidStockAuthority(config)
  return fluidStockProfile.prepare(config)
end

function model.applyFluidStockCompatibility(target, config, authority)
  return fluidStockProfile.apply(target, authority or model.fluidStockAuthority(config))
end

function model.labelKey(value) return identity.labelKey(value) end
function model.keyFor(value) return identity.keyFor(value) end
function model.keysFor(value) return identity.keysFor(value) end
function model.sameKey(left, right) return identity.sameKey(left, right) end
function model.workflowFor(config, entry) return identity.workflowFor(config, entry) end
function model.copyIdentity(row, entry) return identity.copyIdentity(row, entry) end

function model.normalize(row)
  row = row or {}
  local cooldown = model.clampCooldown(row.cooldown or model.defaultConditions.cooldown) or model.defaultConditions.cooldown
  local minSource = row.alertBelow
  if minSource == nil then minSource = row.minStock end
  if minSource == nil then minSource = row.min end
  if minSource == nil then minSource = row.craftTo end
  local alertBelow = model.clampQuantity(minSource or 0, 0) or 0
  local maxRequest = model.clampQuantity(row.maxRequest or row.batch or row.request or row.craftTo or 1, 1) or 1
  local kind, mode = identity.kindFor(row), row.mode == "auto" and "auto" or "manual"
  local line = lineContract.normalize({
    mode = mode, lineIntent = row.lineIntent, intent = row.intent,
    lineAuthority = row.lineAuthority, authority = row.authority,
    alertEnabled = row.alertEnabled, alertBelow = alertBelow, maxRequest = maxRequest,
    maxBasis = row.maxBasis, confidence = row.confidence,
    recipeMax = row.recipeMax or row.learnedRecipeMax, locked = row.locked,
    dangerUnlocked = row.dangerUnlocked
  })
  return {
    workflowId = workflowId.valid(row.workflowId) and row.workflowId or nil,
    label = tostring(row.label or row.name or "unknown"), rawLabel = row.rawLabel,
    name = row.name, damage = row.damage, hasTag = binding.tagged(row.hasTag),
    kind = kind, isFluid = kind == "fluid", amount = row.amount, filter = row.filter,
    craftBinding = binding.copyCraftBinding(row), stockBinding = binding.copyPersistedStockBinding(row),
    mode = mode, lineIntent = line.lineIntent, lineAuthority = line.lineAuthority,
    alertEnabled = line.alertEnabled, alertBelow = line.alertBelow, maxRequest = line.maxRequest,
    maxBasis = line.maxBasis, confidence = line.confidence, recipeMax = line.recipeMax,
    dangerUnlocked = line.dangerUnlocked, locked = line.locked,
    minStock = line.alertBelow, craftTo = line.alertBelow, batch = line.maxRequest,
    minBatteryRatio = tonumber(row.minBatteryRatio or model.defaultConditions.minBatteryRatio),
    maxDeficitRatio = tonumber(row.maxDeficitRatio or model.defaultConditions.maxDeficitRatio),
    requireReadyCpu = row.requireReadyCpu ~= false, cooldown = cooldown, armed = row.armed == true
  }
end

function model.defaultConfig()
  local rows = {}
  for index, row in ipairs(model.defaults) do rows[index] = model.normalize(row) end
  return workflowId.ensure({ autoEnabled = true, nextWorkflowId = 1,
    craftCompatibility = model.defaultCraftCompatibility,
    fluidStockCompatibility = { mode = fluidStockProfile.disabledMode }, workflows = rows })
end

function model.compactConfig(config)
  local source = config or model.defaultConfig()
  local out = compact.config(source, model.defaultConfig, model.normalize, identity)
  out.craftCompatibility = model.craftCompatibility(source)
  out.fluidStockCompatibility = fluidStockProfile.normalize(source.fluidStockCompatibility)
  out.nextWorkflowId = source.nextWorkflowId
  out.workflowNamespace = source.workflowNamespace
  out.workflowHostAddress = source.workflowHostAddress
  if type(source.identityMutationFence) == "table" then
    local fence = source.identityMutationFence
    out.identityMutationFence = {
      transactionId = fence.transactionId, namespace = fence.namespace,
      scopeDigest = fence.scopeDigest, beforeDigest = fence.beforeDigest,
      installedAt = fence.installedAt
    }
  end
  return workflowId.ensure(out)
end

function model.byKey(config)
  local map = {}
  for _, row in ipairs((config or model.defaultConfig()).workflows or {}) do
    row = model.normalize(row)
    for _, key in ipairs(model.keysFor(row)) do map[key] = row end
  end
  return map
end

function model.asTargets(config)
  local rows = {}
  local fluidAuthority = model.fluidStockAuthority(config or model.defaultConfig())
  for configIndex, row in ipairs((config or model.defaultConfig()).workflows or {}) do
    row = model.normalize(row)
    if row.mode == "auto" then
      local target = {
        workflowId = row.workflowId,
        label = row.label, rawLabel = row.rawLabel, name = row.name, damage = row.damage,
        configIndex = configIndex,
        mode = row.mode,
        hasTag = row.hasTag, kind = row.kind, isFluid = row.isFluid, amount = row.amount,
        filter = row.filter, craftBinding = binding.copyCraftBinding(row),
        stockBinding = binding.copyStockBinding(row),
        min = row.minStock, alertBelow = row.alertBelow,
        craftTo = row.craftTo, batch = row.batch, maxRequest = row.maxRequest,
        lineIntent = row.lineIntent, lineAuthority = row.lineAuthority, alertEnabled = row.alertEnabled,
        maxBasis = row.maxBasis, confidence = row.confidence, recipeMax = row.recipeMax,
        dangerUnlocked = row.dangerUnlocked, locked = row.locked,
        minBatteryRatio = row.minBatteryRatio, maxDeficitRatio = row.maxDeficitRatio,
        requireReadyCpu = row.requireReadyCpu, cooldown = row.cooldown, armed = row.armed
      }
      rows[#rows + 1] = model.applyFluidStockCompatibility(target, config, fluidAuthority)
    end
  end
  return rows
end

function model.armedCount(config)
  local count = 0
  for _, row in ipairs((config or model.defaultConfig()).workflows or {}) do
    row = model.normalize(row)
    if row.mode == "auto" and row.armed then count = count + 1 end
  end
  return count
end

function model.autoEnabled(config) return config == nil or config.autoEnabled ~= false end

return model
-- Stable row identity is deliberately independent from mutable recipe
-- identity.  This lets durable observations survive a registry repair without
-- falling back to labels or positional indexes.
local workflowId = {}

local PREFIX = "wf-"
local NAMESPACE_PREFIX = "wfns-v1-"
local namespaceSerial = 0

local function hostAddress()
  local loaded, computer = pcall(require, "computer")
  if loaded and type(computer) == "table" and type(computer.address) == "function" then
    local called, value = pcall(computer.address)
    if called and type(value) == "string" and value ~= "" then return value end
  end
  return "unknown-host"
end

local function namespaceDigest(value)
  local first, second = 216613626, 131542391
  for index = 1, #value do
    local byte = string.byte(value, index)
    first = (first * 131 + byte) % 2147483647
    second = (second * 65599 + byte) % 2147483629
  end
  return string.format("%08x%08x", first, second)
end

local function assistedNamespaceDigest(seed)
  local loaded, dataCard = pcall(require, "oc.core.data_card")
  if not loaded or type(dataCard) ~= "table" or type(dataCard.namespaceDigest) ~= "function" then return nil end
  local called, digest = pcall(dataCard.namespaceDigest, seed)
  if not called or type(digest) ~= "string" or #digest ~= 32
      or not digest:match("^[0-9a-f]+$") then return nil end
  return digest
end

function workflowId.validNamespace(value)
  return type(value) == "string" and #value <= 96
    and value:match("^wfns%-v1%-%x+$") ~= nil
end

function workflowId.currentHost() return hostAddress() end

function workflowId.newNamespace()
  namespaceSerial = namespaceSerial + 1
  local uptime = 0
  local loaded, computer = pcall(require, "computer")
  if loaded and type(computer) == "table" and type(computer.uptime) == "function" then
    local called, value = pcall(computer.uptime)
    if called then uptime = tonumber(value) or 0 end
  end
  local seed = table.concat({ hostAddress(), tostring(os.time and os.time() or 0),
    string.format("%.6f", uptime), tostring(namespaceSerial), tostring({}) }, "|")
  -- This is the one safe authority boundary for optional hardware: a new
  -- identifier is persisted immediately, while existing namespaces and every
  -- recovery/transaction digest remain byte-for-byte independent of the card.
  local software, assisted = namespaceDigest(seed), assistedNamespaceDigest(seed)
  -- Retain the independent software portion even when optional hardware helps.
  -- A faulty or hostile card returning one constant digest cannot collapse all
  -- newly minted namespace authority onto that card-controlled value.
  return NAMESPACE_PREFIX .. software .. (assisted or "")
end

function workflowId.ensureNamespace(config)
  config = type(config) == "table" and config or {}
  if not workflowId.validNamespace(config.workflowNamespace) then
    config.workflowNamespace = workflowId.newNamespace()
  end
  if type(config.workflowHostAddress) ~= "string" or config.workflowHostAddress == "" then
    config.workflowHostAddress = hostAddress()
  end
  return config.workflowNamespace
end

function workflowId.authority(config)
  if type(config) ~= "table" or not workflowId.validNamespace(config.workflowNamespace) then
    return nil, "workflow policy namespace is missing"
  end
  local current = hostAddress()
  if type(config.workflowHostAddress) ~= "string" or config.workflowHostAddress ~= current then
    return nil, "workflow policy host fence does not match this computer"
  end
  return config.workflowNamespace
end

function workflowId.number(value)
  if type(value) ~= "string" then return nil end
  local digits = value:match("^wf%-(%d+)$")
  local number = digits and tonumber(digits) or nil
  if not number or number < 1 or number ~= math.floor(number) then return nil end
  return number
end

function workflowId.valid(value) return workflowId.number(value) ~= nil end

function workflowId.format(value)
  value = math.max(1, math.floor(tonumber(value) or 1))
  return PREFIX .. string.format("%06d", value)
end

-- Mutates only workflowId/nextWorkflowId on the supplied config.  A complete
-- pre-scan keeps allocation deterministic when an older row lacking an ID is
-- followed by a newer row that already has one.
function workflowId.ensure(config)
  config = type(config) == "table" and config or {}
  workflowId.ensureNamespace(config)
  config.workflows = type(config.workflows) == "table" and config.workflows or {}
  local used, maximum = {}, math.max(0, math.floor(tonumber(config.nextWorkflowId) or 1) - 1)
  for _, row in ipairs(config.workflows) do
    local number = workflowId.number(type(row) == "table" and row.workflowId or nil)
    if number then maximum = math.max(maximum, number) end
  end
  local nextNumber = maximum + 1
  for _, row in ipairs(config.workflows) do
    if type(row) == "table" then
      local current = workflowId.valid(row.workflowId) and row.workflowId or nil
      if current and not used[current] then
        used[current] = true
      else
        while used[workflowId.format(nextNumber)] do nextNumber = nextNumber + 1 end
        row.workflowId = workflowId.format(nextNumber)
        used[row.workflowId] = true
        nextNumber = nextNumber + 1
      end
    end
  end
  config.nextWorkflowId = nextNumber
  return config
end

return workflowId
-- Stable public name for the paged v2 evidence service.  Keep compatibility
-- at call sites, not here: authority reads must always carry a namespace and
-- use get/page rather than rebuilding the retired monolithic ledger.
return require("oc.ae2.identity_evidence_v2")
-- Backup-compatible compare-and-swap persistence for permanent identity
-- evidence and daemon control. Runtime writes touch only the stable primary
-- pathname; legacy lock/stage/prior files are recovery input only and are never
-- created by this module.
local filesystem = require("filesystem")
local serialization = require("serialization")

local store = {}
local active = {}
local legacyClaimDirectories = {}
local DEFAULT_MAX_BYTES = 65536
local ABSOLUTE_MAX_BYTES = 262144

local function boundedLimit(options)
  local value = type(options) == "table" and tonumber(options.maxBytes) or nil
  if not value then return DEFAULT_MAX_BYTES end
  if value ~= value or value == math.huge or value == -math.huge then return nil end
  return math.max(1, math.min(ABSOLUTE_MAX_BYTES, math.floor(value)))
end

local function exists(path)
  local ok, value, reason = pcall(filesystem.exists, path)
  if not ok then return nil, tostring(value) end
  if type(value) ~= "boolean" then return nil, tostring(reason or "could not inspect " .. path) end
  return value
end

local function remove(path)
  local present, reason = exists(path)
  if present == nil then return false, reason end
  if not present then return true end
  local ok, value, removeReason = pcall(filesystem.remove, path)
  if not ok or value ~= true then return false, tostring(removeReason or value or "remove failed") end
  return true
end

local function rename(from, to)
  local ok, value, reason = pcall(filesystem.rename, from, to)
  if not ok or value ~= true then return false, tostring(reason or value or "rename failed") end
  return true
end

local function ensureParent(path)
  local ok, parent = pcall(filesystem.path, path)
  if not ok then return false, tostring(parent) end
  if not parent or parent == "" then return true end
  local present, reason = exists(parent)
  if present == nil then return false, reason end
  if present then return true end
  local made, value, makeReason = pcall(filesystem.makeDirectory, parent)
  if not made or value == false then return false, tostring(makeReason or value or "mkdir failed") end
  return exists(parent)
end

local function close(handle, path)
  local ok, value, reason = pcall(function() return handle:close() end)
  if not ok or value == false or (value == nil and reason ~= nil) then
    return false, tostring(reason or value or "could not close " .. path)
  end
  return true
end

local function readRaw(path, maxBytes)
  local present, reason = exists(path)
  if present == nil then return nil, reason, nil end
  if not present then return nil, nil, false end
  local opened, handle, openReason = pcall(io.open, path, "r")
  if not opened then return nil, tostring(handle), true end
  if not handle then return nil, tostring(openReason or "could not open " .. path), true end
  maxBytes = tonumber(maxBytes)
  local readOk, body, readReason = pcall(function()
    return handle:read(maxBytes and (math.floor(maxBytes) + 1) or "*a")
  end)
  local closed, closeReason = close(handle, path)
  if not readOk then return nil, tostring(readReason or body), true end
  if not closed then return nil, closeReason, true end
  if maxBytes and #(body or "") > maxBytes then
    return nil, "state exceeds " .. tostring(maxBytes) .. " byte read limit: " .. path, true
  end
  return body or "", nil, true
end

local function decoded(path, maxBytes)
  local raw, reason, present = readRaw(path, maxBytes)
  if present ~= true or raw == nil then
    return { path = path, raw = raw, reason = reason, present = present }
  end
  local ok, value = pcall(serialization.unserialize, raw)
  if not ok or type(value) ~= "table" then
    return { path = path, raw = raw, reason = "state decode failed: " .. path, present = true }
  end
  return { path = path, raw = raw, value = value, present = true }
end

local function writeRaw(path, body)
  local parentOk, parentReason = ensureParent(path)
  if parentOk ~= true then return false, parentReason end
  local opened, handle, openReason = pcall(io.open, path, "w")
  if not opened then return false, tostring(handle) end
  if not handle then return false, tostring(openReason or "could not write " .. path) end
  local wroteOk, wrote, writeReason = pcall(function() return handle:write(body) end)
  local closed, closeReason = close(handle, path)
  if not wroteOk or wrote == false or wrote == nil then return false, tostring(writeReason or wrote) end
  if not closed then return false, closeReason end
  return true
end

local function uptime()
  local ok, computer = pcall(require, "computer")
  if ok and type(computer) == "table" and type(computer.uptime) == "function" then
    local called, value = pcall(computer.uptime)
    value = called and tonumber(value) or nil
    if value and value >= 0 and value < math.huge then return value end
  end
  return tonumber(os.clock and os.clock()) or 0
end

local function legacyLeaseActive(body)
  local text = tostring(body or "")
  local owner, issued, expires = text:match("^([^|]+)|([%d%.]+)|([%d%.]+)$")
  issued, expires = tonumber(issued), tonumber(expires)
  local now = uptime()
  if not owner then
    owner, expires = text:match("^([^|]+)|([%d%.]+)$")
    expires = tonumber(expires)
    return owner ~= nil and expires ~= nil and expires > now and expires <= now + 301
  end
  if not issued or not expires then return false end
  local duration = expires - issued
  return issued <= now + 0.001 and expires > now and duration > 0 and duration <= 301
    and expires <= now + 301
end

-- A power loss before the former claimant-to-lock rename could leave
-- `<primary>.lock.<owner>` without a canonical lock. Scan each relevant
-- directory once, retire only identity-store-shaped stale claimants, and
-- preserve an active claimant for the exact requested primary.
local function cleanupLegacyClaimants(path)
  if type(filesystem.list) ~= "function" then return true end
  local parentOk, parent = pcall(filesystem.path, path)
  if not parentOk or type(parent) ~= "string" or parent == "" then return true end
  if legacyClaimDirectories[parent] then return true end
  local base = path:match("([^/]+)$")
  local listOk, iterator, listReason = pcall(filesystem.list, parent)
  if not listOk or type(iterator) ~= "function" then
    return false, tostring(listReason or iterator or "legacy claimant scan failed")
  end
  local stale, activeForPath, activeElsewhere = {}, false, false
  local scanned, staleOverflow = 0, false
  local iterated, iterateReason = pcall(function()
    for rawName in iterator do
      scanned = scanned + 1
      if scanned > 4096 then break end
      local name = tostring(rawName or ""):gsub("/$", "")
      local stem = name:match("^(.-)%.lock%.[%w%-]+$")
      if stem and (stem:match("%.state$") or stem == "ae2-maintainer-daemon.cfg") then
        local claimantPath = (parent == "/" and "/" or parent:gsub("/$", "") .. "/") .. name
        local body = readRaw(claimantPath, 1024)
        if legacyLeaseActive(body) then
          if stem == base then activeForPath = true else activeElsewhere = true end
        else
          if #stale >= 32 then staleOverflow = true; break end
          stale[#stale + 1] = claimantPath
        end
      end
    end
  end)
  if not iterated then return false, tostring(iterateReason) end
  for _, claimantPath in ipairs(stale) do
    local removed, removeReason = remove(claimantPath)
    if not removed then return false, removeReason end
  end
  if activeForPath then return false, "legacy state transaction claimant is still active" end
  if not activeElsewhere and not staleOverflow then legacyClaimDirectories[parent] = true end
  return true
end

-- OpenOS processes run cooperatively. Persistence callbacks in this module are
-- table-only and must not yield, so the shared in-memory module guard plus an
-- exact raw-primary comparison closes the RMW boundary without disk leases.
local function guarded(path, callback)
  if active[path] then return false, "state update already active: " .. path end
  active[path] = true
  local result = table.pack(pcall(callback))
  active[path] = nil
  if not result[1] then return false, tostring(result[2]) end
  return table.unpack(result, 2, result.n)
end

function store.recoveryStatus(path, options)
  local maxBytes = boundedLimit(options)
  if not maxBytes then return { path = path, state = "io_error", reason = "invalid state byte limit" } end
  local primary, staged, previous = decoded(path, maxBytes), decoded(path .. ".new", maxBytes),
    decoded(path .. ".previous", maxBytes)
  local legacyLock, lockReason = exists(path .. ".lock")
  local legacyLockBody
  if legacyLock == true then
    legacyLockBody, lockReason = readRaw(path .. ".lock", 1024)
  end
  local out = { path = path, primary = primary, staged = staged, previous = previous,
    legacyLock = legacyLock == true, legacyLockActive = legacyLeaseActive(legacyLockBody) }
  if primary.present == nil or staged.present == nil or previous.present == nil or legacyLock == nil
      or (legacyLock == true and legacyLockBody == nil) then
    out.state, out.reason = "io_error", primary.reason or staged.reason or previous.reason or lockReason
  elseif primary.present == true and not primary.value then
    out.state, out.reason = "invalid_primary", primary.reason
  elseif staged.present == true and not staged.value then
    out.state, out.reason = "invalid_staged", staged.reason
  elseif previous.present == true and not previous.value then
    out.state, out.reason = "invalid_previous", previous.reason
  elseif primary.value and staged.present ~= true and previous.present ~= true then
    out.state = "clean"
  elseif primary.present ~= true and staged.present ~= true and previous.present ~= true then
    out.state = "clean"
  elseif primary.value and staged.present ~= true and previous.value then
    out.state, out.action = "cleanup_previous", "cleanup_previous"
  elseif primary.value and staged.value and previous.present ~= true then
    out.state, out.action = "discard_staged", "discard_staged"
  elseif primary.present ~= true and staged.value and previous.value then
    out.state, out.action = "promote_staged", "promote_staged"
  elseif primary.present ~= true and staged.present ~= true and previous.value then
    out.state, out.action = "restore_previous", "restore_previous"
  elseif primary.present ~= true and staged.value and previous.present ~= true then
    out.state, out.action = "promote_staged", "promote_staged"
  else
    out.state, out.reason = "manual_recovery", "evidence transaction files are ambiguous"
  end
  if out.legacyLockActive then
    out.state, out.action = "legacy_busy", nil
    out.reason = "legacy state transaction is still active; wait for expiry or restart before recovery"
  elseif out.state == "clean" and legacyLock then
    out.state, out.action = "cleanup_legacy_lock", "cleanup_legacy_lock"
  end
  return out
end

local function recoverUnlocked(path, options)
  local status = store.recoveryStatus(path, options)
  if status.state == "clean" then return true, nil, status end
  local ok, reason
  if status.action == "cleanup_previous" then ok, reason = remove(path .. ".previous")
  elseif status.action == "discard_staged" then ok, reason = remove(path .. ".new")
  elseif status.action == "restore_previous" then ok, reason = rename(path .. ".previous", path)
  elseif status.action == "promote_staged" then
    ok, reason = rename(path .. ".new", path)
    if ok and status.previous.present == true then ok, reason = remove(path .. ".previous") end
  elseif status.action == "cleanup_legacy_lock" then ok = true
  else return false, status.reason or status.state, status end
  if not ok then return false, reason, status end
  if status.legacyLock then
    ok, reason = remove(path .. ".lock")
    if not ok then return false, reason, status end
  end
  local after = store.recoveryStatus(path, options)
  if after.state ~= "clean" then return false, "state recovery remains " .. after.state, after end
  return true, nil, after
end

function store.recover(path, options)
  path = tostring(path or "")
  if path == "" then return false, "state path is required" end
  return guarded(path, function()
    local claimsOk, claimsReason = cleanupLegacyClaimants(path)
    if not claimsOk then return false, claimsReason, store.recoveryStatus(path, options) end
    return recoverUnlocked(path, options)
  end)
end

local function prepareUnlocked(path, options)
  local status = store.recoveryStatus(path, options)
  if status.state ~= "clean" then
    local ok, reason, recovered = recoverUnlocked(path, options)
    if not ok then return nil, reason end
    status = recovered
  end
  local primary = decoded(path, boundedLimit(options))
  if primary.present == true and not primary.value then return nil, primary.reason end
  if primary.present == nil then return nil, primary.reason end
  return { path = path, present = primary.present == true, raw = primary.raw, value = primary.value or {} }
end

function store.snapshot(path, options)
  path = tostring(path or "")
  if path == "" then return nil, "state path is required" end
  return guarded(path, function() return prepareUnlocked(path, options) end)
end

function store.read(path, options)
  local snapshot, reason = store.snapshot(path, options)
  if not snapshot then
    return { path = path, readFailed = true, readError = reason, lastError = reason }
  end
  local value = snapshot.value
  value.path = path
  if snapshot.present then value.missing = nil else value.missing = true end
  return value
end

local function restoreStablePrimary(path, priorRaw, maxBytes, reason)
  local restored, restoreReason = writeRaw(path, priorRaw)
  if not restored then
    return false, tostring(reason) .. "; prior-state restoration failed: " .. tostring(restoreReason)
  end
  local verified = decoded(path, maxBytes)
  if verified.present ~= true or verified.raw ~= priorRaw or not verified.value then
    return false, tostring(reason) .. "; prior-state restoration verification failed: "
      .. tostring(verified.reason or "exact content mismatch")
  end
  return false, reason
end

local function writeStablePrimary(path, body, maxBytes, priorRaw, priorPresent)
  local wrote, writeReason = writeRaw(path, body)
  local final = decoded(path, maxBytes)
  if wrote and final.present == true and final.raw == body and final.value then
    return true, nil, final.value
  end

  local reason = writeReason or final.reason or "stable-primary exact-content verification failed"
  -- A different readable body can only be a successor write. Never restore an
  -- older snapshot over complete bytes supplied by another cooperative owner.
  if final.present == true and final.value and final.raw ~= body
      and (not priorPresent or final.raw ~= priorRaw) then
    return false, "state changed during direct write verification; successor retained"
  end
  if priorPresent then
    if final.present == true and final.raw == priorRaw and final.value then return false, reason end
    return restoreStablePrimary(path, priorRaw, maxBytes, reason)
  end
  return false, tostring(reason) .. "; new primary retained fail-closed"
end

local function compareAndSwapUnlocked(path, snapshot, value, options)
  options = type(options) == "table" and options or {}
  if type(snapshot) ~= "table" or snapshot.path ~= path or type(value) ~= "table" then
    return false, "valid state snapshot and replacement are required"
  end
  local maxBytes = boundedLimit(options)
  if not maxBytes then return false, "invalid state byte limit" end
  local render = type(options.render) == "function" and options.render or serialization.serialize
  local renderedOk, body, renderReason = pcall(render, value)
  if not renderedOk or type(body) ~= "string" then
    return false, tostring(renderedOk and renderReason or body or "state serialization failed")
  end
  if body:sub(-1) ~= "\n" then body = body .. "\n" end
  if #body > maxBytes then
    return false, "state exceeds " .. tostring(maxBytes) .. " byte write limit; prior evidence retained"
  end
  local current, currentReason = prepareUnlocked(path, options)
  if not current then return false, currentReason end
  local currentRaw, currentPresent = current.raw, current.present == true
  if currentPresent ~= (snapshot.present == true)
      or (currentPresent == true and currentRaw ~= snapshot.raw) then
    return false, "state changed before stable-primary write; review and retry"
  end
  return writeStablePrimary(path, body, maxBytes, currentRaw, currentPresent)
end

function store.compareAndSwap(path, snapshot, value, options)
  path = tostring(path or "")
  if path == "" then return false, "state path is required" end
  return guarded(path, function()
    return compareAndSwapUnlocked(path, snapshot, value, options)
  end)
end

function store.update(path, callback, options)
  path = tostring(path or "")
  if path == "" then return false, "state path is required" end
  if type(callback) ~= "function" then return false, "state update callback is required" end
  options = type(options) == "table" and options or {}
  return guarded(path, function()
    local retries = math.max(0, math.floor(tonumber(options.retries) or 2))
    for attempt = 0, retries do
      local snapshot, reason = prepareUnlocked(path, options)
      if not snapshot then return false, reason end
      snapshot.value.path = path
      if snapshot.present then snapshot.value.missing = nil else snapshot.value.missing = true end
      local replacement, callbackReason = callback(snapshot.value)
      if replacement == nil then
        if callbackReason ~= nil then return false, tostring(callbackReason) end
        return true, nil, snapshot.value
      end
      local ok, writeReason, saved = compareAndSwapUnlocked(path, snapshot, replacement, options)
      if ok then return true, nil, saved end
      if not tostring(writeReason):find("changed before stable-primary write", 1, true)
          or attempt >= retries then
        return false, writeReason
      end
    end
  end)
end

function store.write(path, value, options)
  return store.update(path, function() return value end, options)
end

return store
-- Immutable facts; mutations are namespace-fenced.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.identity_evidence_v2_store")
local controlCodec = require("oc.ae2.identity_evidence_v2_control")

local evidence = {}
evidence.root = store.root
evidence.schemaVersion = codec.schemaVersion
evidence.captureSeconds = 600
evidence.maxPage = 32
evidence.maxObserve = 32
evidence.maxCaptureBaseline = 256
evidence.maxCaptureCandidates = 32
evidence.maxCaptureConsume = 256

local claimsModule
local captureModule
local pageModule
local transactionModule
local observeModule
local function claimStore()
  if not claimsModule then claimsModule = require("oc.ae2.identity_evidence_v2_claims") end
  return claimsModule
end
local function captureStore()
  if not captureModule then captureModule = require("oc.ae2.identity_evidence_v2_capture") end
  return captureModule
end
local function pageStore()
  if not pageModule then pageModule = require("oc.ae2.identity_evidence_v2_page") end
  return pageModule
end
local function transactionStore()
  if not transactionModule then
    transactionModule = require("oc.ae2.identity_evidence_v2_transaction")
  end
  return transactionModule
end
local function observationStore()
  if not observeModule then observeModule = require("oc.ae2.identity_evidence_v2_observe") end
  return observeModule
end

local function now(value)
  value = tonumber(value)
  if value and value >= 0 and value < math.huge then return value end
  local loaded, computer = pcall(require, "computer")
  if loaded and type(computer) == "table" and type(computer.uptime) == "function" then
    local called, uptime = pcall(computer.uptime)
    if called and tonumber(uptime) then return tonumber(uptime) end
  end
  local clock = tonumber(os.clock and os.clock())
  return clock and clock >= 0 and clock or 0
end

local function factPath(recordId)
  local kind = codec.parseRecordId(recordId)
  local shard = codec.shard(recordId)
  if not kind or not shard then return nil end
  return store.path("facts", kind, shard, recordId .. ".state")
end

local function namespacePath(namespace, lane, recordId)
  local shard = recordId and codec.shard(recordId) or nil
  if not codec.validNamespace(namespace) or (recordId and not shard) then return nil end
  if recordId then return store.path("namespaces", namespace, lane, shard, recordId .. ".state") end
  return store.path("namespaces", namespace, lane)
end

local function controlPath(namespace)
  return store.path("namespaces", namespace, "control.state")
end

local function capturePath(namespace, captureId)
  return store.path("namespaces", namespace, "captures", captureId .. ".state")
end

local function factValid(value, recordId)
  if type(value) ~= "table" or value.recordId ~= recordId then return false end
  local canonical = codec.canonical(value)
  return canonical ~= nil and codec.sameFact(value, canonical, recordId)
end

local function seenValid(value, namespace, recordId)
  return type(value) == "table" and value.schemaVersion == evidence.schemaVersion
    and value.namespace == namespace and value.recordId == recordId
end

local function defaultControl(namespace)
  return { schemaVersion = evidence.schemaVersion, namespace = namespace,
    hostAddress = codec.currentHost(), generation = 0, captureNonce = 0, activeShards = {} }
end

local function normalizeControl(value, namespace)
  return controlCodec.normalize(value, namespace, evidence)
end

local function readControl(namespace)
  local value, reason, present = store.read(controlPath(namespace), store.caps.control)
  if reason then return nil, reason end
  if present ~= true then return defaultControl(namespace), nil, false end
  local normalized, normalizeReason = normalizeControl(value, namespace)
  return normalized, normalizeReason, true
end

local function updateControl(namespace, callback)
  local ok, reason, saved = store.update(controlPath(namespace), store.caps.control,
    function(current)
      local normalized, normalizeReason = normalizeControl(current, namespace)
      if not normalized then return nil, normalizeReason end
      local replacement, callbackReason = callback(normalized)
      if replacement == nil then return nil, callbackReason end
      replacement.storageHealth = store.health(namespace)
      return replacement
    end, { namespace = namespace, kind = "namespace control", retries = 3 })
  if not ok then return false, reason end
  local normalized, normalizeReason = normalizeControl(saved, namespace)
  if not normalized then return false, normalizeReason end
  return true, nil, normalized
end

local function bindAuthority(namespace, options, requireGrid)
  options = type(options) == "table" and options or {}
  local explicitHost = codec.safeText(options.hostAddress, 128)
  if options.hostAddress ~= nil and explicitHost ~= codec.currentHost() then
    return nil, "namespace host authority does not match this computer"
  end
  local grid = codec.safeText(options.gridAddress, 128)
  if options.gridAddress ~= nil and not grid then return nil, "namespace grid authority is invalid" end
  if requireGrid and not grid then return nil, "current AE2 grid address is required for this authority operation" end
  local current, reason, present = readControl(namespace)
  if not current then return nil, reason end
  if current.gridAddress and grid and current.gridAddress ~= grid then
    return nil, "namespace evidence grid fence does not match the active grid"
  end
  if present and (not grid or current.gridAddress == grid) then return current end
  local ok, writeReason, saved = updateControl(namespace, function(control)
    if control.gridAddress and grid and control.gridAddress ~= grid then
      return nil, "namespace evidence grid fence does not match the active grid"
    end
    if not control.gridAddress and grid then
      control.gridAddress = grid
      control.generation = control.generation + 1
      control.lastMutation = { kind = "grid_authority", generation = control.generation }
    end
    return control
  end)
  if not ok then return nil, writeReason end
  return saved
end

local function readFact(recordId)
  local path = factPath(recordId)
  if not path then return nil, "invalid identity evidence recordId" end
  local fact, reason, present = store.read(path, store.caps.fact)
  if reason then return nil, reason end
  if present ~= true then return nil, "identity evidence fact not found: " .. recordId end
  if not factValid(fact, recordId) then return nil, "identity evidence fact is malformed: " .. recordId end
  return fact
end

local function observeOps()
  return { schemaVersion = evidence.schemaVersion, now = now, readControl = readControl,
    updateControl = updateControl, readFact = readFact, namespacePath = namespacePath }
end

local function recoverPendingSeen(namespace)
  return observationStore().recoverPendingSeen(namespace, observeOps())
end

local function recoverPendingClaim(namespace)
  local control, reason = readControl(namespace)
  if not control then return false, reason end
  if not control.pendingClaim then return true, nil, control end
  local status, statusReason = claimStore().recoveryStatus(namespace, control.pendingClaim)
  if not status then return false, statusReason end
  if status.state ~= "COMMITTED" then return true, nil, control, status end
  return updateControl(namespace, function(current)
    if current.pendingClaim ~= control.pendingClaim then
      return nil, "pending claim transaction ownership changed"
    end
    current.pendingClaim = nil
    current.lastClaimTransaction = control.pendingClaim
    current.lastMutation = { kind = "claim", transactionId = control.pendingClaim,
      generation = current.generation }
    return current
  end)
end

local function captureOps()
  return { schemaVersion = evidence.schemaVersion, captureSeconds = evidence.captureSeconds,
    maxCaptureBaseline = evidence.maxCaptureBaseline,
    maxCaptureCandidates = evidence.maxCaptureCandidates,
    maxCaptureConsume = evidence.maxCaptureConsume, now = now,
    readControl = readControl, updateControl = updateControl, readFact = readFact,
    capturePath = capturePath, recover = function(namespace)
      local ok, reason = recoverPendingSeen(namespace)
      if not ok then return false, reason end
      local claimOk, claimReason, control, pending = recoverPendingClaim(namespace)
      if not claimOk then return false, claimReason end
      if pending then return false, "claim transaction requires recovery: " .. pending.state end
      return true, nil, control
    end }
end

local function recover(namespace)
  local ok, reason = recoverPendingSeen(namespace)
  if not ok then return false, reason end
  local control, pending
  ok, reason, control, pending = recoverPendingClaim(namespace)
  if not ok then return false, reason end
  if pending then
    control.claimRecovery = pending
    return true, nil, control
  end
  return captureStore().recover(namespace, captureOps())
end

local function readSeen(namespace, recordId)
  local value, reason, present = store.read(namespacePath(namespace, "seen", recordId), store.caps.seen)
  if reason then return nil, reason end
  if present ~= true then return nil, "identity fact was not observed in this workflow namespace" end
  if not seenValid(value, namespace, recordId) then return nil, "seen association is malformed" end
  return value
end

function evidence.identity(value) return codec.identity(value) end
function evidence.key(value) return codec.digest(value) end
function evidence.digestText(value) return codec.digestText(value) end

function evidence.observeMany(values, context, options)
  options = type(options) == "table" and options or {}
  if type(values) ~= "table" or #values < 1 or #values > evidence.maxObserve then
    return false, "observeMany requires 1 through " .. tostring(evidence.maxObserve) .. " structured outputs"
  end
  local receipts, byNamespace, rejected = {}, {}, 0
  for _, entry in ipairs(values) do
    local value = type(entry) == "table" and type(entry.value) == "table" and entry.value or entry
    local itemContext = type(entry) == "table" and type(entry.value) == "table"
      and entry.context or context
    itemContext = type(itemContext) == "table" and itemContext or {}
    local namespace = codec.validNamespace(itemContext.workflowNamespace or itemContext.namespace)
    if not namespace then return false, "observation requires a durable workflow policy namespace" end
    itemContext.workflowNamespace = namespace
    local authority, authorityReason = bindAuthority(namespace, itemContext, true)
    if not authority then return false, authorityReason end
    if authority.pendingClaim then return false, "claim transaction blocks new seen evidence" end
    local fact, factReason, factCreated = observationStore().writeFact(
      value, itemContext, observeOps())
    if not fact then return false, factReason end
    local linked, linkReason, association, seenCreated, generation =
      observationStore().linkSeen(namespace, fact.recordId, itemContext, observeOps())
    if not linked then return false, linkReason end
    receipts[#receipts + 1] = { action = seenCreated and "identity_evidence_recorded"
      or "identity_evidence_existing", recordId = fact.recordId, record = codec.clone(fact),
      association = codec.clone(association), factCreated = factCreated,
      seenCreated = seenCreated, generation = generation }
    byNamespace[namespace] = byNamespace[namespace] or {
      recordIds = {}, observedAt = itemContext.observedAt
    }
    byNamespace[namespace].recordIds[#byNamespace[namespace].recordIds + 1] = fact.recordId
  end
  local captures = {}
  if options.deferCapture ~= true then
    for namespace, group in pairs(byNamespace) do
      local consumed, consumeReason, result = captureStore().consume(
        namespace, group.recordIds, group.observedAt, captureOps())
      if not consumed then return false, consumeReason end
      if result then captures[namespace] = result end
    end
  end
  return true, nil, { action = "identity_evidence_v2_batch", observed = #receipts,
    rejected = rejected, receipts = receipts, captures = captures,
    captureDeferred = options.deferCapture == true }
end

function evidence.consumeCapture(namespace, recordIds, observedAt, options)
  local ops = captureOps()
  ops.bindAuthority, ops.readSeen = bindAuthority, readSeen
  return captureStore().consumeAuthorized(namespace, recordIds, observedAt, options, ops)
end

function evidence.observe(value, context, options)
  local ok, reason, report = evidence.observeMany(
    { { value = value, context = context } }, nil, options)
  if not ok then return false, reason end
  return true, nil, report.receipts[1], report.captures
end

function evidence.requestCapture(observedAt, options)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.workflowNamespace or options.namespace)
  if not namespace then return false, "capture requires a durable workflow policy namespace" end
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return captureStore().request(observedAt, options, captureOps())
end

function evidence.markCausalCaptureSubmitted(namespace, captureId, options)
  options = type(options) == "table" and options or {}
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return captureStore().markSubmitted(namespace, captureId, options, captureOps())
end

function evidence.beginCausalCaptureRecovery(namespace, captureId, options)
  options = type(options) == "table" and options or {}
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return controlCodec.beginRecovery(namespace, captureId, options, captureOps())
end

function evidence.markCausalCaptureRecoveryBusy(namespace, captureId, options)
  options = type(options) == "table" and options or {}
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return controlCodec.markRecoveryBusy(namespace, captureId, options, captureOps())
end

function evidence.failCausalCapture(namespace, captureId, options)
  options = type(options) == "table" and options or {}
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return captureStore().fail(namespace, captureId, options, captureOps())
end

function evidence.completeCausalCapture(namespace, captureId, recordId, options)
  options = type(options) == "table" and options or {}
  local authority, reason = bindAuthority(namespace, options, true)
  if not authority then return false, reason end
  return captureStore().complete(namespace, captureId, recordId, options, captureOps())
end

function evidence.control(namespace, options)
  namespace = codec.validNamespace(namespace)
  if not namespace then return nil, "valid workflow policy namespace is required" end
  local authority, authorityReason = bindAuthority(namespace, options,
    type(options) == "table" and options._requireGrid == true)
  if not authority then return nil, authorityReason end
  local ok, reason, control = recover(namespace)
  if not ok then return nil, reason end
  control.health = store.health(namespace)
  control.persistedHealth = codec.clone(control.storageHealth)
  return control
end

function evidence.captureStatus(namespace)
  local control, reason = evidence.control(namespace)
  if not control then return nil, reason end
  return { generation = control.generation, gridAddress = control.gridAddress,
    capture = codec.clone(control.capture), health = control.health }
end

function evidence.getFact(recordId)
  local fact, reason = readFact(recordId)
  if not fact then return nil, reason end
  local out = codec.clone(fact)
  out.diagnosticOnly = true
  return out
end

local function recordSnapshot(namespace, recordId, targetWorkflowId)
  local fact, factReason = readFact(recordId)
  if not fact then return nil, factReason end
  local association, seenReason = readSeen(namespace, recordId)
  if not association then return nil, seenReason end
  local reservation, reservationReason = claimStore().reservationStatus(namespace, recordId)
  if not reservation then return nil, reservationReason end
  local out = codec.clone(fact)
  out.association, out.claim = codec.clone(association), codec.clone(reservation)
  out.claimed = reservation.claimed == true
  out.workflowId = reservation.workflowId or association.workflowId
  out.configIndex = reservation.configIndex or association.configIndex
  targetWorkflowId = codec.validWorkflowId(targetWorkflowId)
  if not out.workflowId then out.ownership = "unclaimed"
  elseif targetWorkflowId and out.workflowId == targetWorkflowId then
    out.ownership = "owned_by_target"
  else out.ownership = "owned_by_other" end
  return out
end

function evidence.inspect(id, o)
  o = type(o) == "table" and o or {}
  local ns = codec.validNamespace(o.namespace or o.workflowNamespace)
  local grid = codec.safeText(o.gridAddress, 128)
  if not ns or (not grid and o.allowStoredGrid ~= true) then
    return nil, "namespace/grid required"
  end
  local c, reason, present = readControl(ns); if not c then return nil, reason end
  if present ~= true or (grid and c.gridAddress ~= grid) then
    return nil, "grid mismatch", c, present
  end
  if not id then return {}, nil, c, present end
  local out; out, reason = recordSnapshot(
    ns, id, o.targetWorkflowId or o.workflowId)
  return out, reason, c, present
end

function evidence.get(recordId, options)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  if not namespace then return nil, "namespace required" end
  local authority, authorityReason = bindAuthority(namespace, options, true)
  if not authority then return nil, authorityReason end
  if options._recovered ~= true then
    local ok, reason = recover(namespace)
    if not ok then return nil, reason end
  end
  return recordSnapshot(namespace, recordId, options.targetWorkflowId or options.workflowId)
end

function evidence.page(options)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  if namespace then
    local authority, reason = bindAuthority(namespace, options, true)
    if not authority then return false, reason end
  end
  return pageStore().read(evidence, options, { maxPage = evidence.maxPage,
    schemaVersion = evidence.schemaVersion, recover = recover,
    seenRoot = function(namespace) return namespacePath(namespace, "seen") end })
end

function evidence.reserveClaims(options)
  return transactionStore().reserve(options, { control = function(namespace)
      local scoped = codec.clone(type(options) == "table" and options or {})
      scoped._requireGrid = true
      return evidence.control(namespace, scoped)
    end,
    updateControl = updateControl, recoverPendingClaim = recoverPendingClaim })
end

function evidence.preflightClaims(options)
  options = type(options) == "table" and codec.clone(options) or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  local grid = codec.safeText(options.gridAddress, 128)
  if not namespace or not grid then
    return false, "claim preflight requires workflow namespace and current AE2 grid address"
  end
  local control, reason, present = readControl(namespace)
  if not control then return false, reason end
  if present ~= true or control.gridAddress ~= grid then
    return false, "claim preflight grid authority is missing or mismatched"
  end
  if control.pendingClaim and control.pendingClaim ~= options.transactionId then
    return false, "another claim transaction requires recovery"
  end
  options.namespace, options.currentGeneration = namespace, control.generation
  local ok, preflightReason, intent = claimStore().preflight(options)
  if not ok then return false, preflightReason end
  return true, nil, { namespace = namespace, generation = control.generation,
    transactionId = intent.transactionId, intentDigest = intent.intentDigest,
    claimCount = #intent.claims, beforeDigest = intent.beforeDigest,
    afterDigest = intent.afterDigest, scopeDigest = intent.scopeDigest }
end

function evidence.commitClaims(options)
  return transactionStore().commit(options, { control = function(namespace)
      local scoped = codec.clone(type(options) == "table" and options or {})
      scoped._requireGrid = true
      return evidence.control(namespace, scoped)
    end,
    updateControl = updateControl, recoverPendingClaim = recoverPendingClaim })
end
function evidence.reservationStatus(namespace, recordId)
  return claimStore().reservationStatus(namespace, recordId)
end
function evidence.claimRecoveryStatus(namespace, transactionId, workflowDigest)
  return claimStore().recoveryStatus(namespace, transactionId, workflowDigest)
end
function evidence.health(namespace) return store.health(namespace) end

-- Unsupported v1 ledger stays untouched.
function evidence.migrateLegacyStep()
  local present, reason = store.exists("/var/oc/ae2-identity-evidence.state")
  if present == nil then return false, reason end
  if present ~= true then
    return true, nil, { state = "NO_LEGACY_LEDGER", imported = 0,
      sourcePreserved = true, supported = false }
  end
  return false, "legacy monolithic evidence migration is unsupported; source retained",
    { state = "UNSUPPORTED", imported = 0, sourcePreserved = true, supported = false }
end

return evidence
local codec = require("oc.ae2.identity_evidence_v2_codec")

local control = {}
local captureStatuses = {
  ARMED = true, SUBMITTED = true, UNVERIFIED = true, FAILED = true,
  CONSUMED = true, AMBIGUOUS = true, EXPIRED = true
}
local activeCaptureStatuses = { ARMED = true, SUBMITTED = true }
local causalStatuses = {
  ARMED = true, SUBMITTED = true, UNVERIFIED = true, FAILED = true,
  CONSUMED = true, EXPIRED = true
}

local function stamp(value)
  value = tonumber(value)
  return value and value == value and value >= 0 and value < math.huge and value or nil
end

local function baselineToken(value)
  if type(value) ~= "string" then return nil end
  local recordId = value:match("^id:(.+)$")
  if recordId and codec.parseRecordId(recordId) then return "id:" .. recordId end
  local digest = value:match("^dg:(%x+)$")
  if digest and #digest == 32 then return "dg:" .. digest:lower() end
  return nil
end

local function fresh(namespace, schemaVersion)
  return { schemaVersion = schemaVersion, namespace = namespace,
    hostAddress = codec.currentHost(), generation = 0, captureNonce = 0, activeShards = {} }
end

local function seenValid(value, namespace, recordId, schemaVersion)
  return type(value) == "table" and value.schemaVersion == schemaVersion
    and value.namespace == namespace and value.recordId == recordId
end

function control.normalize(value, namespace, limits)
  value, limits = type(value) == "table" and value or {}, limits or {}
  local schemaVersion = limits.schemaVersion
  if (value.missing == true and value.schemaVersion == nil) or next(value) == nil then
    return fresh(namespace, schemaVersion)
  end
  if value.schemaVersion ~= schemaVersion or value.namespace ~= namespace then
    return nil, "namespace evidence control is malformed or belongs to another namespace"
  end
  if value.hostAddress ~= codec.currentHost() then
    return nil, "namespace evidence host fence does not match this computer"
  end
  local generation = tonumber(value.generation)
  if not generation or generation < 0 or generation ~= math.floor(generation) then
    return nil, "namespace evidence generation is malformed"
  end
  local out = fresh(namespace, schemaVersion)
  out.generation = generation
  local captureNonce = tonumber(value.captureNonce) or 0
  if captureNonce < 0 or captureNonce ~= math.floor(captureNonce) then
    return nil, "namespace capture nonce is malformed"
  end
  out.captureNonce = captureNonce
  if type(value.activeShards) ~= "table" or #value.activeShards > 256 then
    return nil, "namespace active-shard index is malformed"
  end
  local priorShard
  for _, shard in ipairs(value.activeShards) do
    if type(shard) ~= "string" or not shard:match("^%x%x$") or (priorShard and shard <= priorShard) then
      return nil, "namespace active-shard index is malformed"
    end
    out.activeShards[#out.activeShards + 1], priorShard = shard:lower(), shard:lower()
  end
  if value.gridAddress ~= nil then
    out.gridAddress = codec.safeText(value.gridAddress, 128)
    if not out.gridAddress then return nil, "namespace grid authority is malformed" end
  end
  if value.pendingSeen ~= nil then
    local pending = value.pendingSeen
    if type(pending) ~= "table" or not codec.parseRecordId(pending.recordId)
        or type(pending.association) ~= "table"
        or not seenValid(pending.association, namespace, pending.recordId, schemaVersion) then
      return nil, "namespace control has a malformed pending seen association"
    end
    out.pendingSeen = codec.clone(pending)
  end
  if value.pendingClaim ~= nil then
    local pendingClaim = codec.safeSegment(value.pendingClaim, 96)
    if not pendingClaim then return nil, "namespace control has a malformed pending claim" end
    out.pendingClaim = pendingClaim
  end
  if value.capture ~= nil then
    local capture = value.capture
    if type(capture) ~= "table" or not codec.safeSegment(capture.captureId, 96)
        or type(capture.baseline) ~= "table" or #capture.baseline > limits.maxCaptureBaseline
        or not stamp(capture.requestedAt) or not stamp(capture.expiresAt)
        or type(capture.active) ~= "boolean" or not captureStatuses[capture.status]
        or (capture.causal ~= nil and type(capture.causal) ~= "boolean")
        or capture.active ~= (activeCaptureStatuses[capture.status] == true) then
      return nil, "namespace capture control is malformed"
    end
    local normalizedBaseline, prior = {}, nil
    for _, raw in ipairs(capture.baseline) do
      local token = baselineToken(raw)
      if not token or (prior and token <= prior) then
        return nil, "namespace capture baseline is malformed"
      end
      normalizedBaseline[#normalizedBaseline + 1], prior = token, token
    end
    local labelQuery, labelReason = codec.normalizeLabelQuery(capture.labelQuery)
    if labelReason then
      return nil, "namespace capture label query is malformed: " .. tostring(labelReason)
    end
    out.capture = codec.clone(capture)
    out.capture.baseline = normalizedBaseline
    out.capture.labelQuery = labelQuery
    if capture.causal == true then
      out.capture.causal = true
      out.capture.cpuName = codec.safeText(capture.cpuName, 128)
      out.capture.scopeToken = codec.safeText(capture.scopeToken, 96)
      out.capture.workflowId = codec.validWorkflowId(capture.workflowId)
      out.capture.configIndex = codec.validIndex(capture.configIndex)
      if not causalStatuses[capture.status] or not out.capture.cpuName
          or (capture.scopeToken ~= nil and not out.capture.scopeToken)
          or not out.capture.workflowId or not out.capture.configIndex then
        return nil, "causal capture authority is malformed"
      end
      if capture.requestKey ~= nil then
        out.capture.requestKey = codec.safeSegment(capture.requestKey, 96)
        if not out.capture.requestKey then return nil, "causal capture request key is malformed" end
      end
      if (capture.status == "SUBMITTED" or capture.status == "UNVERIFIED"
          or capture.status == "CONSUMED")
          and (not out.capture.requestKey
          or not stamp(capture.submittedAt)) then
        return nil, "submitted causal capture receipt is incomplete"
      end
      local hasRecovery = capture.recoveryStartedAt ~= nil
        or capture.recoveryAttempt ~= nil
      if hasRecovery then
        local started, attempt = stamp(capture.recoveryStartedAt),
          tonumber(capture.recoveryAttempt)
        if not started or attempt ~= 1 then
          return nil, "causal capture recovery receipt is malformed"
        end
        out.capture.recoveryStartedAt, out.capture.recoveryAttempt = started, attempt
      end
      if capture.recoverySawBusy ~= nil then
        if not hasRecovery or type(capture.recoverySawBusy) ~= "boolean" then
          return nil, "causal capture busy recovery receipt is malformed"
        end
        out.capture.recoverySawBusy = capture.recoverySawBusy
      end
      if capture.recoveryBootId ~= nil then
        out.capture.recoveryBootId = codec.safeText(capture.recoveryBootId, 96)
        if not hasRecovery or not out.capture.recoveryBootId then
          return nil, "causal capture recovery boot receipt is malformed"
        end
      end
      if capture.status == "CONSUMED" and not codec.parseRecordId(capture.recordId) then
        return nil, "consumed causal capture receipt is incomplete"
      end
      if capture.status == "FAILED" or capture.status == "UNVERIFIED" then
        out.capture.reason = codec.safeText(capture.reason, 192)
        if not out.capture.reason or type(capture.retryable) ~= "boolean" then
          return nil, "terminal causal capture receipt is incomplete"
        end
        out.capture.retryable = capture.retryable
      end
    elseif capture.status == "SUBMITTED" or capture.status == "UNVERIFIED"
        or capture.status == "FAILED" then
      return nil, "non-causal capture has a causal-only status"
    elseif capture.recoveryStartedAt ~= nil or capture.recoveryAttempt ~= nil then
      return nil, "non-causal capture has causal recovery authority"
    end
    if capture.candidates ~= nil then
      if type(capture.candidates) ~= "table" or #capture.candidates > limits.maxCaptureCandidates then
        return nil, "namespace capture candidates are malformed"
      end
      for _, recordId in ipairs(capture.candidates) do
        if not codec.parseRecordId(recordId) then return nil, "namespace capture candidate is malformed" end
      end
      local count = tonumber(capture.candidateCount) or #capture.candidates
      if count ~= math.floor(count) or count < #capture.candidates
          or (capture.candidateOverflow ~= nil and type(capture.candidateOverflow) ~= "boolean") then
        return nil, "namespace capture candidate count is malformed"
      end
      out.capture.candidateCount = count
      out.capture.candidateOverflow = count > #capture.candidates
    end
  end
  if value.migration ~= nil then out.migration = codec.clone(value.migration) end
  if value.lastMutation ~= nil then out.lastMutation = codec.clone(value.lastMutation) end
  if value.lastClaimTransaction ~= nil then
    out.lastClaimTransaction = codec.safeSegment(value.lastClaimTransaction, 96)
    if not out.lastClaimTransaction then return nil, "namespace last claim transaction is malformed" end
  end
  if type(value.storageHealth) == "table" then
    local state = value.storageHealth.state
    if state ~= "HEALTHY" and state ~= "LOW" and state ~= "FULL" and state ~= "UNKNOWN" then
      return nil, "namespace storage health telemetry is malformed"
    end
    out.storageHealth = codec.clone(value.storageHealth)
  end
  return out
end

function control.beginRecovery(namespace, captureId, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  local requestKey, cpuName = codec.safeSegment(options.requestKey, 96),
    codec.safeText(options.cpuName, 128)
  local workflowId, configIndex = codec.validWorkflowId(options.workflowId),
    codec.validIndex(options.configIndex)
  local boot = codec.safeText(options.recoveryBootId, 96)
  if not namespace or not codec.safeSegment(captureId, 96) or not requestKey
      or not cpuName or not workflowId or not configIndex or not boot then
    return false, "causal capture recovery receipt is malformed"
  end
  local recovered, recoverReason = ops.recover(namespace)
  if not recovered then return false, recoverReason end
  local stamp = ops.now(options.recoveredAt)
  local changed, reason, saved = ops.updateControl(namespace, function(value)
    local state = value.capture
    if type(state) ~= "table" or state.captureId ~= captureId or state.causal ~= true then
      return nil, "causal capture recovery ownership changed"
    end
    if state.cpuName ~= cpuName or state.requestKey ~= requestKey then
      return nil, "causal capture recovery CPU or request receipt changed"
    end
    if state.workflowId ~= workflowId or tonumber(state.configIndex) ~= configIndex then
      return nil, "causal capture recovery workflow scope changed"
    end
    local submitted = state.active == true and state.status == "SUBMITTED"
    local unverified = state.active ~= true and state.status == "UNVERIFIED"
    if not submitted and not unverified or not tonumber(state.submittedAt) then
      return nil, "causal capture is not recoverable"
    end
    local started = tonumber(state.recoveryStartedAt)
    if started and state.recoveryBootId and state.recoveryBootId ~= boot then
      return nil, "automatic causal capture recovery boot changed"
    end
    local newWindow = unverified or not started or started > stamp
    if newWindow and (tonumber(state.recoveryAttempt) or 0) >= 1 then
      return nil, "automatic causal capture recovery is exhausted"
    end
    if newWindow then
      state.recoveryStartedAt, state.recoveryAttempt, state.recoveryBootId = stamp, 1, boot
      state.active, state.status = true, "SUBMITTED"
      state.failedAt, state.reason, state.retryable = nil, nil, nil
      value.generation = value.generation + 1
      value.lastMutation = { kind = "causal_capture_recovery", captureId = captureId,
        generation = value.generation }
    elseif not state.recoveryBootId then
      state.recoveryBootId = boot
      value.generation = value.generation + 1
      value.lastMutation = { kind = "causal_recovery_boot", captureId = captureId,
        generation = value.generation }
    end
    return value
  end)
  if not changed then return false, reason end
  return true, nil, { capture = codec.clone(saved.capture), generation = saved.generation,
    gridAddress = saved.gridAddress }
end

function control.markRecoveryBusy(namespace, captureId, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  local cpuName, requestKey = codec.safeText(options.cpuName, 128),
    codec.safeSegment(options.requestKey, 96)
  local workflowId, configIndex = codec.validWorkflowId(options.workflowId),
    codec.validIndex(options.configIndex)
  if not namespace or not codec.safeSegment(captureId, 96) or not cpuName
      or not requestKey or not workflowId or not configIndex then
    return false, "causal capture busy recovery receipt is malformed"
  end
  return ops.updateControl(namespace, function(value)
    local state = value.capture
    if type(state) ~= "table" or state.captureId ~= captureId
        or state.causal ~= true or state.active ~= true or state.status ~= "SUBMITTED"
        or state.cpuName ~= cpuName or state.requestKey ~= requestKey
        or state.workflowId ~= workflowId or tonumber(state.configIndex) ~= configIndex
        or tonumber(state.recoveryAttempt) ~= 1
        or not tonumber(state.recoveryStartedAt) then
      return nil, "causal capture busy recovery authority changed"
    end
    if state.recoverySawBusy == true then return value end
    state.recoverySawBusy = true
    value.generation = value.generation + 1
    value.lastMutation = { kind = "causal_recovery_busy", captureId = captureId,
      generation = value.generation }
    return value
  end)
end

return control
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.identity_evidence_v2_store")

local capture = {}

local function baselineToken(value)
  if type(value) == "string" then
    if codec.parseRecordId(value) then return "id:" .. value end
    local digest = value:match("^dg:(%x+)$")
    if digest and #digest == 32 then return value:lower() end
    return nil
  end
  local digest = codec.digest(value)
  return digest and ("dg:" .. digest) or nil
end

local function baselineSet(state)
  local out = {}
  for _, token in ipairs(state.baseline or {}) do out[token] = true end
  return out
end

local function exactConsumed(s, id, record, cpu, key)
  return type(s) == "table" and s.captureId == id and s.causal == true
    and s.active ~= true and s.status == "CONSUMED" and s.recordId == record
    and s.cpuName == cpu and s.requestKey == key
end

local function validateCausalMarker(marker, state, namespace, ops, allowBusyAudit)
  if marker.schemaVersion ~= ops.schemaVersion or marker.namespace ~= namespace
      or marker.captureId ~= state.captureId or marker.causal ~= true
      or marker.workflowId ~= state.workflowId
      or tonumber(marker.configIndex) ~= tonumber(state.configIndex)
      or tonumber(marker.requestedAt) ~= tonumber(state.requestedAt)
      or not tonumber(state.submittedAt) or not state.requestKey
      or marker.cpuName ~= state.cpuName or marker.requestKey ~= state.requestKey
      or not tonumber(marker.consumedAt) then
    return false, "causal marker does not match submitted receipt"
  end
  local fact, reason = ops.readFact(marker.recordId)
  if not fact then return false, reason end
  local prior = baselineSet(state)
  if prior["id:" .. marker.recordId] or prior["dg:" .. tostring(fact.digest)] then
    return false, "marker reuses pre-request baseline"
  end
  local identity, identityReason = codec.identity(fact)
  if not identity or identity.kind ~= "fluid" or identity.hasTag == true then
    return false, identityReason or "not one ordinary fluid identity"
  end
  if not codec.matchesLabelQuery(fact, state.labelQuery) then
    return false, "marker label does not match wrapper"
  end
  if state.recoverySawBusy == true and allowBusyAudit ~= true then
    return false, "causal recovery observed CPU activity; output identity is ambiguous"
  end
  return true
end

function capture.recover(namespace, ops)
  local control, reason = ops.readControl(namespace)
  if not control then return false, reason end
  if control.pendingClaim then return true, nil, control end
  local state = control.capture
  if not state or (state.causal ~= true and state.active ~= true) then
    return true, nil, control
  end
  local marker, markerReason, markerPresent = store.read(
    ops.capturePath(namespace, state.captureId), store.caps.capture)
  if markerReason then return false, markerReason end
  if markerPresent == true and (type(marker) ~= "table"
      or marker.schemaVersion ~= ops.schemaVersion or marker.namespace ~= namespace
      or marker.captureId ~= state.captureId or not codec.parseRecordId(marker.recordId)) then
    return false, "capture result marker is malformed"
  end
  local busyMarker = markerPresent == true and state.causal == true
    and state.recoverySawBusy == true
  if markerPresent == true and state.causal == true then
    local valid, validReason = validateCausalMarker(
      marker, state, namespace, ops, busyMarker)
    if not valid then return false, validReason end
  end
  if busyMarker and state.status == "CONSUMED" then
    return false, "consumed causal marker conflicts with recorded CPU activity"
  end
  if busyMarker and state.active ~= true and state.status == "UNVERIFIED" then
    return true, nil, control
  end
  if state.causal == true and state.status == "CONSUMED" then
    if markerPresent ~= true then
      return false, "consumed causal capture has no immutable result marker"
    end
    if state.recordId ~= marker.recordId then
      return false, "causal record does not match marker"
    end
    return true, nil, control
  end
  if state.active ~= true and markerPresent ~= true then return true, nil, control end
  local currentTime = ops.now()
  if markerPresent ~= true and state.causal == true and state.status == "SUBMITTED" then
    return true, nil, control
  end
  if markerPresent ~= true and currentTime >= tonumber(state.requestedAt)
      and currentTime <= tonumber(state.expiresAt) then return true, nil, control end
  return ops.updateControl(namespace, function(current)
    local active = current.capture
    if not active or active.captureId ~= state.captureId then
      return nil, "capture ownership changed"
    end
    if active.status == "CONSUMED" and markerPresent == true
        and active.recordId == marker.recordId then return current end
    if active.status ~= state.status or active.requestKey ~= state.requestKey
        or active.cpuName ~= state.cpuName then return nil, "capture authority changed" end
    active.active = false
    if markerPresent == true and active.recoverySawBusy == true then
      active.status, active.recordId, active.completedAt = "UNVERIFIED", nil, nil
      active.reason = "causal recovery observed CPU activity before marker commit"
      active.retryable = false
    elseif markerPresent == true then
      active.status, active.recordId, active.completedAt =
        "CONSUMED", marker.recordId, marker.consumedAt
    elseif active.causal == true and active.status == "SUBMITTED" then
      active.status = "UNVERIFIED"
      active.reason = "physical causal request outcome is unknown after owner recovery"
      active.retryable = false
    else active.status = "EXPIRED" end
    current.generation = current.generation + 1
    current.lastMutation = { kind = "capture", captureId = state.captureId,
      generation = current.generation }
    return current
  end)
end

function capture.consume(namespace, recordIds, observedAt, ops)
  namespace = codec.validNamespace(namespace)
  if not namespace then return false, "capture namespace is required" end
  if type(recordIds) ~= "table" or #recordIds < 1 or #recordIds > ops.maxCaptureConsume then
    return false, "capture consumption requires 1 through "
      .. tostring(ops.maxCaptureConsume) .. " record IDs"
  end
  for _, recordId in ipairs(recordIds) do
    if not codec.parseRecordId(recordId) then return false, "capture consumption record ID is malformed" end
  end
  local ok, reason, control = capture.recover(namespace, ops)
  if not ok then return false, reason end
  if control.pendingClaim then
    return false, "capture finalization deferred while an evidence claim transaction is active"
  end
  local state = control.capture
  observedAt = ops.now(observedAt)
  if not state or state.active ~= true or observedAt < tonumber(state.requestedAt)
      or observedAt > tonumber(state.expiresAt) then return true, nil, nil end
  if state.causal == true then return true, nil, nil end
  local baseline, candidates, used, candidateCount = baselineSet(state), {}, {}, 0
  for _, recordId in ipairs(recordIds) do
    local fact, factReason = ops.readFact(recordId)
    if not fact then return false, factReason end
    local digestToken = "dg:" .. tostring(fact.digest)
    if not baseline["id:" .. recordId] and not baseline[digestToken] and not used[recordId] then
      used[recordId] = true
      if codec.matchesLabelQuery(fact, state.labelQuery) then
        candidateCount = candidateCount + 1
        if #candidates < ops.maxCaptureCandidates then candidates[#candidates + 1] = recordId end
      end
    end
  end
  if #candidates == 0 then return true, nil, nil end
  if #candidates > 1 then
    local changed, changeReason, final = ops.updateControl(namespace, function(current)
      if not current.capture or current.capture.captureId ~= state.captureId then
        return nil, "capture ownership changed"
      end
      current.capture.active, current.capture.status = false, "AMBIGUOUS"
      current.capture.candidates = candidates
      current.capture.candidateCount = candidateCount
      current.capture.candidateOverflow = candidateCount > #candidates
      current.generation = current.generation + 1
      return current
    end)
    if not changed then return false, changeReason end
    return true, nil, { status = "AMBIGUOUS", candidates = candidates,
      candidateCount = candidateCount, candidateOverflow = candidateCount > #candidates,
      generation = final.generation }
  end
  local marker = { schemaVersion = ops.schemaVersion, namespace = namespace,
    captureId = state.captureId, recordId = candidates[1],
    workflowId = state.workflowId, configIndex = state.configIndex,
    requestedAt = state.requestedAt, consumedAt = observedAt }
  local written, writeReason = store.putImmutable(ops.capturePath(namespace, state.captureId), marker, {
    cap = store.caps.capture, namespace = namespace, kind = "capture result",
    same = function(left) return type(left) == "table" and left.namespace == namespace
      and left.captureId == marker.captureId and left.recordId == marker.recordId end
  })
  if not written then return false, writeReason end
  local changed, changeReason, final = ops.updateControl(namespace, function(current)
    if not current.capture or current.capture.captureId ~= state.captureId then
      return nil, "capture ownership changed"
    end
    current.capture.active, current.capture.status = false, "CONSUMED"
    current.capture.recordId = candidates[1]
    current.generation = current.generation + 1
    return current
  end)
  if not changed then return false, changeReason end
  return true, nil, { status = "CONSUMED", recordId = candidates[1],
    generation = final.generation }
end

function capture.consumeAuthorized(namespace, recordIds, observedAt, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  if not namespace then
    return false, "capture namespace is required"
  end
  local authority, authorityReason = ops.bindAuthority(namespace, options, true)
  if not authority then return false, authorityReason end
  if type(recordIds) ~= "table" or #recordIds < 1
      or #recordIds > ops.maxCaptureConsume then
    return false, "capture consumption requires 1 through "
      .. tostring(ops.maxCaptureConsume) .. " record IDs"
  end
  for _, recordId in ipairs(recordIds) do
    if not codec.parseRecordId(recordId) then
      return false, "capture consumption record ID is malformed"
    end
    local association, seenReason = ops.readSeen(namespace, recordId)
    if not association then return false, seenReason end
    if association.hostAddress ~= codec.currentHost() then
      return false, "capture evidence host fence does not match this computer"
    end
    if association.gridAddress ~= authority.gridAddress then
      return false, "capture evidence grid fence does not match the active grid"
    end
  end
  return capture.consume(namespace, recordIds, observedAt, ops)
end

function capture.request(observedAt, options, ops)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.workflowNamespace or options.namespace)
  if not namespace then return false, "capture requires a workflow namespace" end
  local labelQuery, labelReason = codec.normalizeLabelQuery(options.labelQuery)
  if labelReason then
    return false, labelReason
  end
  local expectId = options.expectedCaptureId
  if expectId ~= nil and (type(expectId) ~= "string"
      or not expectId:match("^cap%-%x+$")) then
    return false, "expected capture ID is malformed"
  end
  local expectGen = options.expectedGeneration
  if expectGen ~= nil then
    expectGen = tonumber(expectGen)
    if not expectGen or expectGen < 0
        or expectGen % 1 ~= 0 then
      return false, "expected capture generation is malformed"
    end
  end
  local expectStatus = options.expectedCaptureStatus
  if expectStatus ~= nil then
    expectStatus = codec.safeText(expectStatus, 32)
    if not expectStatus then return false, "expected capture status is malformed" end
  end
  if type(options.baseline) ~= "table" then
    return false, "capture requires the current visible CPU-output baseline"
  end
  local cpuName, scopeToken
  if options.causal == true then
    cpuName = codec.safeText(options.cpuName, 128)
    if not cpuName then return false, "causal capture requires one named CPU" end
    scopeToken = codec.safeText(options.scopeToken, 96)
    if options.scopeToken ~= nil and not scopeToken then return false, "causal scope token is malformed" end
  end
  local recovered, recoverReason = ops.recover(namespace)
  if not recovered then return false, recoverReason end
  recovered, recoverReason = capture.recover(namespace, ops)
  if not recovered then return false, recoverReason end
  local baseline, used = {}, {}
  if type(options.baseline) == "table" then
    for key, value in pairs(options.baseline) do
      local source = type(key) == "number" and value or (value == true and key or value)
      local token = baselineToken(source)
      if not token then return false, "capture baseline fingerprint is invalid" end
      if not used[token] then used[token], baseline[#baseline + 1] = true, token end
      if #baseline > ops.maxCaptureBaseline then
        return false, "capture baseline exceeds " .. tostring(ops.maxCaptureBaseline) .. " outputs"
      end
    end
  end
  table.sort(baseline)
  local requestedAt = ops.now()
  local reqWorkflow = codec.validWorkflowId(options.workflowId)
  local reqIndex = codec.validIndex(options.configIndex)
  local outcome, conflict
  local ok, reason, saved = ops.updateControl(namespace, function(control)
    outcome, conflict = nil, nil
    local current = control.capture
    local terminalReceipt = current and current.active ~= true
      and (current.status == "CONSUMED" or current.status == "AMBIGUOUS"
        or current.status == "UNVERIFIED")
    if current and current.active == true and current.labelQuery == labelQuery
        and current.workflowId == reqWorkflow
        and current.configIndex == reqIndex
        and current.scopeToken == scopeToken
        and (current.causal == true) == (options.causal == true) then
      outcome = "already_armed"
      return control
    end
    if terminalReceipt and (options.replaceTerminal ~= true
        or (current.causal == true and current.status == "UNVERIFIED"
          and options.retireUnverified ~= true)) then
      outcome = "terminal_retained"
      return control
    end
    local replacingCausal = current and current.active ~= true
      and current.causal == true and options.causal == true
      and options.replaceTerminal == true
    if replacingCausal and (expectId == nil
        or expectGen == nil or expectStatus == nil) then
      conflict = "causal terminal replacement requires stable generation and status proof"
      outcome = "conflict"
      return control
    end
    if current and current.active ~= true and options.replaceTerminal == true
        and ((expectId ~= nil and current.captureId ~= expectId)
          or (expectGen ~= nil and control.generation ~= expectGen)
          or (expectStatus ~= nil and current.status ~= expectStatus)) then
      conflict = "capture changed; refresh before replacing its terminal receipt"
      outcome = "conflict"
      return control
    end
    if current and (current.active == true or terminalReceipt)
        and expectId ~= current.captureId then
      conflict = "capture changed; refresh before replacing its finder hint"
      outcome = "conflict"
      return control
    end
    control.captureNonce = (tonumber(control.captureNonce) or 0) + 1
    control.generation = control.generation + 1
    local seed = table.concat({ namespace, tostring(control.hostAddress or ""),
      tostring(control.gridAddress or ""), tostring(control.captureNonce),
      tostring(control.generation), tostring(requestedAt), tostring(options.workflowId or ""),
      tostring(labelQuery or ""), scopeToken or "", table.concat(baseline, ",") }, "|")
    local captureId = "cap-" .. codec.digestText(seed)
    control.capture = { captureId = captureId, active = true, status = "ARMED",
      requestedAt = requestedAt, expiresAt = requestedAt + ops.captureSeconds,
      baseline = baseline, workflowId = reqWorkflow,
      configIndex = reqIndex, labelQuery = labelQuery }
    if options.causal == true then
      control.capture.causal, control.capture.cpuName = true, cpuName
      control.capture.scopeToken = scopeToken
    end
    control.lastMutation = { kind = "capture_armed", captureId = captureId,
      generation = control.generation }
    outcome = "armed"
    return control
  end)
  if not ok then return false, reason end
  if conflict then return false, conflict end
  local action = outcome == "armed" and "identity_capture_armed"
    or outcome == "already_armed" and "identity_capture_already_armed"
    or "identity_capture_terminal_retained"
  return true, nil, { action = action, namespace = namespace,
    capture = codec.clone(saved.capture), generation = saved.generation }
end

function capture.markSubmitted(namespace, captureId, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  local requestKey = codec.safeSegment(options.requestKey, 96)
  local cpuName = codec.safeText(options.cpuName, 128)
  if not namespace or not codec.safeSegment(captureId, 96)
      or not requestKey or not cpuName then
    return false, "causal capture submission receipt is malformed"
  end
  return ops.updateControl(namespace, function(control)
    local state = control.capture
    if type(state) ~= "table" or state.captureId ~= captureId
        or state.active ~= true or state.causal ~= true then
      return nil, "causal capture ownership changed before submission"
    end
    if state.cpuName ~= cpuName then return nil, "causal capture CPU ownership changed" end
    if state.status == "SUBMITTED" then
      if state.requestKey ~= requestKey then return nil, "causal capture request receipt conflicts" end
      return control
    end
    if state.status ~= "ARMED" then return nil, "causal capture is not armed for submission" end
    state.status, state.requestKey = "SUBMITTED", requestKey
    state.submittedAt = ops.now(options.submittedAt)
    control.generation = control.generation + 1
    control.lastMutation = { kind = "causal_capture_submitted", captureId = captureId,
      generation = control.generation }
    return control
  end)
end

function capture.fail(namespace, captureId, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  local requestKey
  if options.requestKey ~= nil then
    requestKey = codec.safeSegment(options.requestKey, 96)
  end
  if not namespace or not codec.safeSegment(captureId, 96) then
    return false, "causal capture failure receipt is malformed"
  end
  if options.requestKey ~= nil and not requestKey then
    return false, "causal capture failure request key is malformed"
  end
  return ops.updateControl(namespace, function(control)
    local state = control.capture
    if type(state) ~= "table" or state.captureId ~= captureId or state.causal ~= true then
      return nil, "causal capture ownership changed"
    end
    if state.active ~= true
        and (state.status == "FAILED" or state.status == "UNVERIFIED") then
      return control
    end
    if state.active ~= true or (state.status ~= "ARMED" and state.status ~= "SUBMITTED") then
      return nil, "causal capture is not active for failure"
    end
    if options.uncertain == true and state.status ~= "SUBMITTED" then
      return nil, "physical uncertainty requires a durable submission receipt"
    end
    if requestKey ~= nil and state.requestKey ~= nil and state.requestKey ~= requestKey then
      return nil, "causal capture request receipt changed"
    end
    if requestKey ~= nil and state.requestKey == nil then state.requestKey = requestKey end
    state.active = false
    state.status = options.uncertain == true and "UNVERIFIED" or "FAILED"
    state.failedAt = ops.now(options.failedAt)
    state.reason = codec.safeText(options.reason, 192) or "causal request could not be verified"
    state.retryable = options.uncertain ~= true and options.retryable == true
    control.generation = control.generation + 1
    control.lastMutation = { kind = "causal_capture_failed", captureId = captureId,
      generation = control.generation }
    return control
  end)
end

function capture.complete(namespace, captureId, recordId, options, ops)
  options = type(options) == "table" and options or {}
  namespace = codec.validNamespace(namespace)
  if not namespace or not codec.safeSegment(captureId, 96)
      or not codec.parseRecordId(recordId) then
    return false, "causal completion receipt is malformed"
  end
  local recovered, reason, control = capture.recover(namespace, ops)
  if not recovered then return false, reason end
  local state = control.capture
  if exactConsumed(state, captureId, recordId, options.cpuName, options.requestKey) then
    return true, nil, { status = "CONSUMED", recordId = recordId, causal = true,
      generation = control.generation }
  end
  if type(state) ~= "table" or state.captureId ~= captureId or state.active ~= true
      or state.causal ~= true or state.status ~= "SUBMITTED" then
    return false, "causal capture is not active SUBMITTED"
  end
  if state.cpuName ~= options.cpuName or state.requestKey ~= options.requestKey then
    return false, "causal capture CPU or request receipt changed"
  end
  local marker = { schemaVersion = ops.schemaVersion, namespace = namespace,
    captureId = captureId, recordId = recordId, workflowId = state.workflowId,
    configIndex = state.configIndex, requestedAt = state.requestedAt,
    consumedAt = ops.now(options.completedAt), causal = true,
    cpuName = state.cpuName, requestKey = state.requestKey }
  local valid, validReason = validateCausalMarker(marker, state, namespace, ops)
  if not valid then return false, validReason end
  local written, writeReason, savedMarker = store.putImmutable(
    ops.capturePath(namespace, captureId), marker, {
    cap = store.caps.capture, namespace = namespace, kind = "causal capture result",
    same = function(left) return type(left) == "table" and left.namespace == namespace
      and left.schemaVersion == marker.schemaVersion and left.captureId == captureId
      and left.recordId == recordId and left.causal == true
      and left.workflowId == marker.workflowId
      and tonumber(left.configIndex) == tonumber(marker.configIndex)
      and tonumber(left.requestedAt) == tonumber(marker.requestedAt)
      and left.cpuName == marker.cpuName and left.requestKey == marker.requestKey end
  })
  if not written then return false, writeReason end
  if type(savedMarker) == "table" then marker = savedMarker end
  local changed, changeReason, final = ops.updateControl(namespace, function(current)
    local active = current.capture
    if exactConsumed(active, captureId, recordId, state.cpuName, state.requestKey) then
      return current
    end
    if type(active) ~= "table" or active.captureId ~= captureId or active.active ~= true
        or active.status ~= "SUBMITTED" or active.requestKey ~= state.requestKey then
      return nil, "causal capture ownership changed during completion"
    end
    if active.recoverySawBusy == true then
      return nil, "causal recovery observed CPU activity during completion"
    end
    active.active, active.status, active.recordId = false, "CONSUMED", recordId
    active.completedAt = marker.consumedAt
    current.generation = current.generation + 1
    current.lastMutation = { kind = "causal_capture_consumed", captureId = captureId,
      generation = current.generation }
    return current
  end)
  if not changed then return false, changeReason end
  if not exactConsumed(final.capture, captureId, recordId, state.cpuName, state.requestKey) then
    return false, final.capture and final.capture.reason
      or "causal completion lost its durable authority"
  end
  return true, nil, { status = "CONSUMED", recordId = recordId, causal = true,
    generation = final.generation }
end

return capture
-- Immutable claim transactions for evidence v2.  Reservations are permanent
-- within one workflow namespace; partial writes never become workflow commit
-- authority, but they remain recoverable by the exact same transaction.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.identity_evidence_v2_store")

local claims = {}
claims.maxClaims = 32

local function safeDigest(value)
  return codec.safeText(value, 192)
end

local function paths(namespace, recordId, transactionId)
  local shard = recordId and codec.shard(recordId) or nil
  return {
    fact = recordId and store.path("facts", codec.parseRecordId(recordId), shard,
      recordId .. ".state") or nil,
    seen = recordId and store.path("namespaces", namespace, "seen", shard,
      recordId .. ".state") or nil,
    reservation = recordId and store.path("namespaces", namespace, "reservations", shard,
      recordId .. ".state") or nil,
    intent = transactionId and store.path("namespaces", namespace, "transactions", "intents",
      transactionId .. ".state") or nil,
    commit = transactionId and store.path("namespaces", namespace, "transactions", "commits",
      transactionId .. ".state") or nil
  }
end
claims.paths = paths

local function validFact(value, recordId)
  if type(value) ~= "table" or value.recordId ~= recordId then return false end
  local canonical = codec.canonical(value)
  return canonical ~= nil and codec.sameFact(value, canonical, recordId)
end

local function validSeen(value, namespace, recordId)
  return type(value) == "table" and value.schemaVersion == codec.schemaVersion
    and value.namespace == namespace and value.recordId == recordId
end

local function claimCanonical(namespace, transactionId, expectedGeneration,
    beforeDigest, afterDigest, scopeDigest, prepared)
  local parts = { namespace, transactionId, tostring(expectedGeneration),
    beforeDigest, afterDigest, scopeDigest }
  for _, item in ipairs(prepared) do
    parts[#parts + 1] = table.concat({ item.recordId, item.workflowId,
      tostring(item.configIndex or "") }, ":")
  end
  return table.concat(parts, "|")
end

local function prepare(options)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace)
  local transactionId = codec.safeSegment(options.transactionId, 96)
  local generation = tonumber(options.expectedGeneration)
  local beforeDigest, afterDigest, scopeDigest = safeDigest(options.beforeDigest),
    safeDigest(options.afterDigest), safeDigest(options.scopeDigest)
  if not namespace then return nil, "valid workflow policy namespace is required" end
  if not transactionId then return nil, "path-safe claim transactionId is required" end
  if not generation or generation < 0 or generation ~= math.floor(generation) then
    return nil, "claim transaction requires a non-negative expected generation"
  end
  if not beforeDigest or not afterDigest or not scopeDigest then
    return nil, "claim intent requires before, after, and scope digests"
  end
  if type(options.claims) ~= "table" or #options.claims < 1
      or #options.claims > claims.maxClaims then
    return nil, "claim intent requires 1 through " .. tostring(claims.maxClaims) .. " exact records"
  end
  local prepared, byRecord = {}, {}
  for _, item in ipairs(options.claims) do
    local recordId = type(item) == "table" and item.recordId or nil
    local workflowId = type(item) == "table" and codec.validWorkflowId(item.workflowId) or nil
    local configIndex = type(item) == "table" and codec.validIndex(item.configIndex) or nil
    if not codec.parseRecordId(recordId) then return nil, "claim recordId is invalid" end
    if not workflowId then return nil, "claim workflowId is invalid" end
    if item.configIndex ~= nil and not configIndex then return nil, "claim configIndex is invalid" end
    local prior = byRecord[recordId]
    if prior and (prior.workflowId ~= workflowId or prior.configIndex ~= configIndex) then
      return nil, "one evidence record cannot be assigned to conflicting workflow owners"
    end
    if not prior then
      local row = { recordId = recordId, workflowId = workflowId, configIndex = configIndex }
      byRecord[recordId], prepared[#prepared + 1] = row, row
    end
  end
  table.sort(prepared, function(left, right) return left.recordId < right.recordId end)
  local canonical = claimCanonical(namespace, transactionId, generation,
    beforeDigest, afterDigest, scopeDigest, prepared)
  return {
    schemaVersion = codec.schemaVersion, namespace = namespace,
    transactionId = transactionId, expectedGeneration = generation,
    beforeDigest = beforeDigest, afterDigest = afterDigest, scopeDigest = scopeDigest,
    intentCanonical = canonical, intentDigest = codec.digestText(canonical),
    claims = prepared, createdAt = tonumber(options.createdAt) or 0
  }
end

local function validIntent(value, namespace, transactionId)
  if type(value) ~= "table" or value.schemaVersion ~= codec.schemaVersion
      or value.namespace ~= namespace or value.transactionId ~= transactionId
      or type(value.claims) ~= "table" or #value.claims < 1 or #value.claims > claims.maxClaims
      or not safeDigest(value.beforeDigest) or not safeDigest(value.afterDigest)
      or not safeDigest(value.scopeDigest) then return false end
  local rebuilt = prepare(value)
  return rebuilt ~= nil and rebuilt.intentCanonical == value.intentCanonical
    and rebuilt.intentDigest == value.intentDigest
end

local function sameIntent(left, right)
  return validIntent(left, right.namespace, right.transactionId)
    and left.intentCanonical == right.intentCanonical
end

local function reservationFor(intent, item)
  local canonical = table.concat({ intent.namespace, intent.transactionId,
    intent.intentDigest, item.recordId, item.workflowId, tostring(item.configIndex or "") }, "|")
  return {
    schemaVersion = codec.schemaVersion, namespace = intent.namespace,
    transactionId = intent.transactionId, intentDigest = intent.intentDigest,
    recordId = item.recordId, workflowId = item.workflowId,
    configIndex = item.configIndex, reservationCanonical = canonical,
    reservationDigest = codec.digestText(canonical), createdAt = intent.createdAt
  }
end

local function validReservation(value, intent, item)
  local wanted = reservationFor(intent, item)
  return type(value) == "table" and value.schemaVersion == codec.schemaVersion
    and value.reservationCanonical == wanted.reservationCanonical
    and value.reservationDigest == wanted.reservationDigest
end

local function readIntent(namespace, transactionId)
  local path = paths(namespace, nil, transactionId).intent
  local value, reason, present = store.read(path, store.caps.intent)
  if present ~= true then return nil, reason or "claim transaction intent not found", present end
  if not validIntent(value, namespace, transactionId) then
    return nil, "claim transaction intent is malformed", true
  end
  return value, nil, true
end

local function findClaim(intent, recordId)
  for _, item in ipairs(intent.claims) do if item.recordId == recordId then return item end end
  return nil
end

function claims.reservationStatus(namespace, recordId)
  namespace = codec.validNamespace(namespace)
  if not namespace or not codec.parseRecordId(recordId) then
    return nil, "valid namespace and recordId are required"
  end
  local path = paths(namespace, recordId).reservation
  local reservation, reason, present = store.read(path, store.caps.reservation)
  if present ~= true then
    if reason then return nil, reason end
    return { state = "UNCLAIMED", claimed = false, namespace = namespace, recordId = recordId }
  end
  local transactionId = type(reservation) == "table"
    and codec.safeSegment(reservation.transactionId, 96) or nil
  if not transactionId then return nil, "claim reservation is malformed" end
  local intent, intentReason = readIntent(namespace, transactionId)
  if not intent then return nil, intentReason end
  local item = findClaim(intent, recordId)
  if not item or not validReservation(reservation, intent, item) then
    return nil, "claim reservation does not match its immutable intent"
  end
  local commitPath = paths(namespace, nil, transactionId).commit
  local commit, commitReason, commitPresent = store.read(commitPath, store.caps.commit)
  if commitReason then return nil, commitReason end
  local state = "RESERVED"
  if commitPresent == true then
    if type(commit) ~= "table" or commit.schemaVersion ~= codec.schemaVersion
        or commit.namespace ~= namespace or commit.transactionId ~= transactionId
        or commit.intentDigest ~= intent.intentDigest
        or commit.commitDigest ~= codec.digestText(table.concat({ namespace, transactionId,
          intent.intentDigest, intent.afterDigest }, "|")) then
      return nil, "claim commit marker is malformed"
    end
    state = "COMMITTED"
  end
  return { state = state, claimed = true, namespace = namespace, recordId = recordId,
    transactionId = transactionId, workflowId = item.workflowId,
    configIndex = item.configIndex, intentDigest = intent.intentDigest }
end

function claims.recoveryStatus(namespace, transactionId, workflowDigest)
  namespace, transactionId = codec.validNamespace(namespace), codec.safeSegment(transactionId, 96)
  if not namespace or not transactionId then return nil, "valid namespace and transactionId are required" end
  local intent, reason, present = readIntent(namespace, transactionId)
  if not intent then
    if present == false then return { state = "MISSING", namespace = namespace,
      transactionId = transactionId, ready = false, committed = false } end
    return nil, reason
  end
  local found, missing = 0, {}
  for _, item in ipairs(intent.claims) do
    local reservation, readReason, reservationPresent = store.read(
      paths(namespace, item.recordId).reservation, store.caps.reservation)
    if readReason then return nil, readReason end
    if reservationPresent ~= true then
      missing[#missing + 1] = item.recordId
    elseif not validReservation(reservation, intent, item) then
      return nil, "claim reservation conflict for " .. item.recordId
    else found = found + 1 end
  end
  local commit, commitReason, commitPresent = store.read(
    paths(namespace, nil, transactionId).commit, store.caps.commit)
  if commitReason then return nil, commitReason end
  local committed = false
  if commitPresent == true then
    local expected = codec.digestText(table.concat({ namespace, transactionId,
      intent.intentDigest, intent.afterDigest }, "|"))
    if type(commit) ~= "table" or commit.schemaVersion ~= codec.schemaVersion
        or commit.namespace ~= namespace or commit.transactionId ~= transactionId
        or commit.intentDigest ~= intent.intentDigest or commit.commitDigest ~= expected then
      return nil, "claim commit marker is malformed"
    end
    if #missing > 0 then return nil, "claim commit exists without every reservation" end
    committed = true
  end
  local state = committed and "COMMITTED" or (#missing == 0 and "READY"
    or (found == 0 and "INTENT_ONLY" or "PARTIAL"))
  local out = { state = state, namespace = namespace, transactionId = transactionId,
    ready = #missing == 0, committed = committed, reserved = found,
    total = #intent.claims, missing = missing, intent = codec.clone(intent) }
  if workflowDigest ~= nil then
    workflowDigest = tostring(workflowDigest)
    if workflowDigest == intent.afterDigest then
      out.workflowState = "AFTER"
      out.recoveryAction = committed and "NONE" or "WRITE_COMMIT_MARKER"
    elseif workflowDigest == intent.beforeDigest then
      out.workflowState = "BEFORE"
      out.recoveryAction = committed and "BLOCKED" or "APPLY_WORKFLOW_AFTER"
    else
      out.workflowState, out.recoveryAction = "CONFLICT", "BLOCKED"
    end
  end
  return out
end

function claims.preflight(options)
  local intent, reason = prepare(options)
  if not intent then return false, reason end
  local intentPath = paths(intent.namespace, nil, intent.transactionId).intent
  local existingIntent, existingReason, existingPresent = store.read(intentPath, store.caps.intent)
  if existingReason then return false, existingReason end
  if existingPresent == true and not sameIntent(existingIntent, intent) then
    return false, "claim transactionId already names a different immutable intent"
  end
  if existingPresent ~= true and tonumber(options.currentGeneration) ~= intent.expectedGeneration then
    return false, "identity evidence generation changed after preview; review and retry"
  end
  -- Validate all fact/association authority and all pre-existing reservations
  -- before creating the intent.  Failures after this point are retryable by
  -- the same immutable transaction and never authorize a workflow write.
  for _, item in ipairs(intent.claims) do
    local itemPaths = paths(intent.namespace, item.recordId)
    local fact, factReason, factPresent = store.read(itemPaths.fact, store.caps.fact)
    if factReason then return false, factReason end
    if factPresent ~= true or not validFact(fact, item.recordId) then
      return false, "claim fact is missing or malformed: " .. item.recordId
    end
    local seen, seenReason, seenPresent = store.read(itemPaths.seen, store.caps.seen)
    if seenReason then return false, seenReason end
    if seenPresent ~= true or not validSeen(seen, intent.namespace, item.recordId) then
      return false, "claim record was not observed in this workflow namespace"
    end
    if codec.validWorkflowId(seen.workflowId) and seen.workflowId ~= item.workflowId then
      return false, "identity evidence first-observation owner conflicts with requested workflow"
    end
    local current, reservationReason, reservationPresent = store.read(
      itemPaths.reservation, store.caps.reservation)
    if reservationReason then return false, reservationReason end
    if reservationPresent == true and not validReservation(current, intent, item) then
      return false, "identity evidence is reserved by another owner or transaction"
    end
  end
  return true, nil, intent
end

function claims.reserve(options)
  local prepared, reason, intent = claims.preflight(options)
  if not prepared then return false, reason end
  local intentPath = paths(intent.namespace, nil, intent.transactionId).intent
  local ok, writeReason = store.putImmutable(intentPath, intent, {
    cap = store.caps.intent, namespace = intent.namespace, kind = "claim intent", same = sameIntent
  })
  if not ok then return false, writeReason end
  for _, item in ipairs(intent.claims) do
    local reservation = reservationFor(intent, item)
    ok, writeReason = store.putImmutable(paths(intent.namespace, item.recordId).reservation,
      reservation, { cap = store.caps.reservation, namespace = intent.namespace,
        kind = "claim reservation", same = function(left)
          return validReservation(left, intent, item)
        end })
    if not ok then return false, writeReason end
  end
  local status, statusReason = claims.recoveryStatus(intent.namespace, intent.transactionId)
  if not status then return false, statusReason end
  if status.state ~= "READY" and status.state ~= "COMMITTED" then
    return false, "claim transaction remains " .. tostring(status.state), status
  end
  return true, nil, status
end

function claims.commit(options)
  options = type(options) == "table" and options or {}
  local namespace, transactionId = codec.validNamespace(options.namespace),
    codec.safeSegment(options.transactionId, 96)
  if not namespace or not transactionId then return false, "valid namespace and transactionId are required" end
  local status, reason = claims.recoveryStatus(namespace, transactionId)
  if not status then return false, reason end
  if status.state == "COMMITTED" then return true, nil, status end
  if status.state ~= "READY" then return false, "claim transaction is not ready: " .. status.state, status end
  local intent = status.intent
  if tostring(options.workflowDigest or "") ~= intent.afterDigest then
    return false, "current workflow digest does not prove the claim intent's after-state"
  end
  local canonical = table.concat({ namespace, transactionId, intent.intentDigest,
    intent.afterDigest }, "|")
  local marker = { schemaVersion = codec.schemaVersion, namespace = namespace,
    transactionId = transactionId, intentDigest = intent.intentDigest,
    afterDigest = intent.afterDigest, commitDigest = codec.digestText(canonical),
    committedAt = tonumber(options.committedAt) or 0 }
  local ok, writeReason = store.putImmutable(paths(namespace, nil, transactionId).commit,
    marker, { cap = store.caps.commit, namespace = namespace, kind = "claim commit",
      same = function(left) return type(left) == "table"
        and left.commitDigest == marker.commitDigest end })
  if not ok then return false, writeReason end
  local final, finalReason = claims.recoveryStatus(namespace, transactionId)
  if not final or final.state ~= "COMMITTED" then
    return false, finalReason or "claim commit verification failed", final
  end
  return true, nil, final
end

return claims
-- Pure identity codec for the paged v2 evidence store.  It deliberately has
-- no filesystem dependency: callers can derive an exact record ID without
-- waking AE2 or reading any evidence file.
local binding = require("oc.ae2.request_binding")
local workflowId = require("oc.ae2.workflow_id")

local codec = {}
codec.schemaVersion = 2
codec.maxLabelQuery = 64

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}
  if seen[value] then return seen[value] end
  local out = {}
  seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end
codec.clone = clone

local function safeText(value, limit)
  if type(value) ~= "string" or value == "" or #value > (limit or 256) then return nil end
  if value:find("[%z\1-\31\127]") then return nil end
  return value
end
codec.safeText = safeText

-- A label query is an operator-facing finder hint, never item identity. Keep
-- it small and printable so it can be persisted safely with a capture.
function codec.normalizeLabelQuery(value)
  if value == nil or value == "" then return nil end
  if type(value) ~= "string" then return nil, "label query must be text" end
  if #value > codec.maxLabelQuery then
    return nil, "label query must be at most " .. tostring(codec.maxLabelQuery) .. " characters"
  end
  if value:find("[%z\1-\31\127]") then
    return nil, "label query must contain printable text only"
  end
  value = value:match("^%s*(.-)%s*$") or ""
  if value == "" then return nil end
  return value:lower()
end

function codec.matchesLabelQuery(value, query)
  if query == nil or query == "" then return true end
  local normalized, reason = codec.normalizeLabelQuery(query)
  if not normalized then return false, reason end
  local label = safeText(type(value) == "table" and value.label, 512) or ""
  local rawLabel = safeText(type(value) == "table" and value.rawLabel, 512) or ""
  local searchable = (label .. "\n" .. rawLabel):lower()
  if searchable:find(normalized, 1, true) then return true end
  for token in normalized:gmatch("%S+") do
    if not searchable:find(token, 1, true) then return false end
  end
  return true
end

local function whole(value)
  value = tonumber(value)
  if not value or value ~= value or value < 0 or value == math.huge
      or value ~= math.floor(value) then return nil end
  return value
end

local function kindFor(value)
  if type(value) ~= "table" then return nil end
  if value.kind == "fluid" or value.isFluid == true then return "fluid" end
  if value.kind == "item" or value.isFluid == false or value.damage ~= nil then return "item" end
  return nil
end

-- Normalize only fields that OpenComputers exposes in a structured
-- finalOutput.  Generic hidden NBT is never guessed: tagged results remain
-- non-authoritative unless the existing binding contract can prove them.
function codec.identity(value)
  if type(value) ~= "table" then return nil, "structured identity table is required" end
  local kind, name = kindFor(value), safeText(value.name, 256)
  if kind ~= "item" and kind ~= "fluid" then
    return nil, "structured identity requires item or fluid kind"
  end
  if not name then return nil, "structured identity requires a registry name" end
  local tagged = binding.tagged(value.hasTag)
  if kind == "fluid" and (tagged or not binding.validFluidName(name)) then
    return nil, "structured fluid identity must be an ordinary safe Forge fluid ID"
  end
  local damage = kind == "item" and whole(value.damage) or nil
  if kind == "item" and damage == nil then
    return nil, "structured item identity requires finite non-negative whole damage"
  end
  local label = safeText(value.label, 512) or safeText(value.rawLabel, 512) or name
  local rawLabel = safeText(value.rawLabel, 512) or label
  local marker = binding.copyCraftBinding(value)
  local out = {
    kind = kind, isFluid = kind == "fluid", name = name, damage = damage,
    hasTag = tagged, label = label, rawLabel = rawLabel,
    amount = tonumber(value.amount) or tonumber(value.size),
    filter = kind == "fluid" and { name = name } or { name = name, damage = damage },
    craftBinding = marker and clone(marker) or nil
  }
  if kind == "fluid" then out.damage = nil end
  out.authoritative = not tagged or out.craftBinding ~= nil
  out.probeReady = tagged and out.craftBinding == nil and rawLabel ~= nil
  if tagged and not out.authoritative and not out.probeReady then
    return nil, "tagged structured identity requires a visible label or verified binding"
  end
  return out
end

local function part(value)
  local text = tostring(value == nil and "" or value)
  return tostring(#text) .. ":" .. text
end

-- This string is the collision check and authority boundary.  Labels are not
-- identity for ordinary untagged stacks; the visible raw label and complete
-- verified binding are included for tagged variants.
function codec.canonical(value)
  local identity, reason = codec.identity(value)
  if not identity then return nil, reason end
  local marker = identity.craftBinding or {}
  return table.concat({
    part("ae2-evidence-v2"), part(identity.kind), part(identity.name),
    part(identity.damage), part(identity.hasTag and "1" or "0"),
    part(identity.hasTag and identity.rawLabel or ""),
    part(marker.mode), part(marker.name), part(marker.damage),
    part(marker.label), part(marker.rawLabel)
  }, "|")
end

-- Four independent arithmetic lanes stay below 2^53 during multiplication,
-- so this is deterministic on Lua 5.2 doubles without a bit library.  The
-- full canonical string is always compared after lookup; the digest alone is
-- never accepted as identity authority.
function codec.digestText(value)
  value = tostring(value or "")
  local a, b, c, d = 216613626, 131542391, 374761393, 668265263
  for index = 1, #value do
    local byte = string.byte(value, index)
    a = (a * 131 + byte + index) % 2147483647
    b = (b * 65599 + byte * 3 + index) % 2147483629
    c = (c * 257 + byte * 17 + index * 3) % 2147483587
    d = (d * 109 + byte * 31 + index * 7) % 2147483563
  end
  return string.format("%08x%08x%08x%08x", a, b, c, d)
end

function codec.digest(value)
  local canonical, reason = codec.canonical(value)
  if not canonical then return nil, reason end
  return codec.digestText(canonical), nil, canonical
end

local function kindCode(kind) return kind == "fluid" and "f" or kind == "item" and "i" or nil end

function codec.recordId(value, collision)
  local identity, reason = codec.identity(value)
  if not identity then return nil, reason end
  local digest, _, canonical = codec.digest(identity)
  local suffix = tonumber(collision)
  if suffix ~= nil and (suffix < 1 or suffix > 99 or suffix ~= math.floor(suffix)) then
    return nil, "collision suffix must be a whole number from 1 through 99"
  end
  return "ev2-" .. kindCode(identity.kind) .. "-" .. digest
    .. (suffix and ("-" .. string.format("%02d", suffix)) or ""), nil, canonical, identity
end

function codec.parseRecordId(value)
  if type(value) ~= "string" then return nil end
  local code, digest = value:match("^ev2%-([if])%-(%x+)$")
  local suffix
  if not code then code, digest, suffix = value:match("^ev2%-([if])%-(%x+)%-(%d%d)$") end
  if not code then return nil end
  suffix = suffix or ""
  if #digest ~= 32 then return nil end
  if suffix ~= "" then
    local number = tonumber(suffix)
    if not number or number < 1 or number > 99 then return nil end
  end
  return code == "f" and "fluid" or "item", digest:lower(), suffix ~= "" and tonumber(suffix) or nil
end

function codec.shard(recordId)
  local _, digest = codec.parseRecordId(recordId)
  return digest and digest:sub(1, 2) or nil
end

function codec.validNamespace(value)
  return workflowId.validNamespace(value) and value or nil
end

function codec.currentHost() return workflowId.currentHost() end

function codec.validWorkflowId(value)
  return workflowId.valid(value) and value or nil
end

function codec.safeSegment(value, limit)
  if type(value) ~= "string" or value == "" or #value > (limit or 96) then return nil end
  if not value:match("^[A-Za-z0-9][A-Za-z0-9_.%-]*$") then return nil end
  return value
end

function codec.validIndex(value)
  value = tonumber(value)
  return value and value >= 1 and value < math.huge and value == math.floor(value) and value or nil
end

function codec.sameFact(fact, canonical, recordId)
  local kind, pathDigest, suffix = codec.parseRecordId(recordId)
  if type(fact) ~= "table" or fact.schemaVersion ~= codec.schemaVersion
      or fact.recordId ~= recordId or fact.canonical ~= canonical or not kind then return false end
  local identity, reason = codec.identity(fact)
  if not identity or identity.kind ~= kind or reason then return false end
  local digest = codec.digestText(canonical)
  if fact.digest ~= digest or pathDigest ~= digest then return false end
  local expected = codec.recordId(identity, suffix)
  return expected == recordId
end

return codec
-- Fact-first observation writer.  A pending association is recorded in the
-- small namespace control before the immutable seen file, making the only
-- crash gap deterministic and recoverable without scanning a directory.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.identity_evidence_v2_store")

local observe = {}

local function factPath(recordId)
  local kind, shard = codec.parseRecordId(recordId), codec.shard(recordId)
  if not kind or not shard then return nil end
  return store.path("facts", kind, shard, recordId .. ".state")
end

local function seenValid(value, namespace, recordId, schemaVersion)
  return type(value) == "table" and value.schemaVersion == schemaVersion
    and value.namespace == namespace and value.recordId == recordId
end

function observe.writeFact(value, context, ops)
  local identity, reason = codec.identity(value)
  if not identity then return nil, reason end
  local canonical = assert(codec.canonical(identity))
  local createdAt = ops.now(type(context) == "table" and context.observedAt or nil)
  for collision = 0, 99 do
    local recordId = assert(codec.recordId(identity, collision > 0 and collision or nil))
    local fact = codec.clone(identity)
    fact.schemaVersion, fact.recordId, fact.canonical = ops.schemaVersion, recordId, canonical
    fact.digest, fact.firstObservedAt = codec.digestText(canonical), createdAt
    local ok, writeReason, saved, created = store.putImmutable(factPath(recordId), fact, {
      cap = store.caps.fact, namespace = type(context) == "table" and context.workflowNamespace,
      kind = "identity fact", highWater = 0.95, same = function(left)
        return codec.sameFact(left, canonical, recordId)
      end
    })
    if ok then return saved, nil, created == true end
    if not tostring(writeReason):find("authority conflicts", 1, true) then return nil, writeReason end
  end
  return nil, "identity digest collision suffix space is exhausted"
end

local function associationFor(namespace, recordId, context, ops)
  context = type(context) == "table" and context or {}
  return {
    schemaVersion = ops.schemaVersion, namespace = namespace, recordId = recordId,
    firstObservedAt = ops.now(context.observedAt),
    source = codec.safeText(context.source, 64) or "structured_output",
    cpuName = codec.safeText(context.cpuName, 128),
    hostAddress = codec.safeText(context.hostAddress, 128),
    gridAddress = codec.safeText(context.gridAddress, 128),
    workflowId = codec.validWorkflowId(context.workflowId),
    configIndex = codec.validIndex(context.configIndex),
    daemonGeneration = tonumber(context.daemonGeneration or context.generation),
    phase = codec.safeText(context.phase, 64), zeroProof = context.zeroProof == true
  }
end

local function putSeen(association, ops)
  return store.putImmutable(ops.namespacePath(association.namespace, "seen", association.recordId),
    association, { cap = store.caps.seen, namespace = association.namespace,
      kind = "seen association", same = function(left)
        return seenValid(left, association.namespace, association.recordId, ops.schemaVersion)
      end })
end

function observe.recoverPendingSeen(namespace, ops)
  local control, reason = ops.readControl(namespace)
  if not control then return false, reason end
  local pending = control.pendingSeen
  if not pending then return true, nil, control end
  local fact, factReason = ops.readFact(pending.recordId)
  if not fact then return false, "pending seen association has no valid fact: " .. tostring(factReason) end
  local ok, writeReason = putSeen(pending.association, ops)
  if not ok then return false, writeReason end
  return ops.updateControl(namespace, function(current)
    if not current.pendingSeen then return current end
    if current.pendingSeen.recordId ~= pending.recordId then
      return nil, "pending seen association ownership changed"
    end
    current.pendingSeen = nil
    current.lastMutation = { kind = "seen", recordId = pending.recordId,
      generation = current.generation }
    return current
  end)
end

function observe.linkSeen(namespace, recordId, context, ops)
  local ok, reason = observe.recoverPendingSeen(namespace, ops)
  if not ok then return false, reason end
  local current, readReason, present = store.read(
    ops.namespacePath(namespace, "seen", recordId), store.caps.seen)
  if readReason then return false, readReason end
  if present == true then
    if not seenValid(current, namespace, recordId, ops.schemaVersion) then
      return false, "seen association is malformed"
    end
    local control = ops.readControl(namespace)
    return true, nil, current, false, control and control.generation
  end
  local association = associationFor(namespace, recordId, context, ops)
  local changed, changeReason, prepared = ops.updateControl(namespace, function(control)
    if control.pendingSeen then return nil, "another seen association requires recovery" end
    if control.pendingClaim then return nil, "claim transaction blocks new seen evidence" end
    local shard, found = assert(codec.shard(recordId)), false
    for _, currentShard in ipairs(control.activeShards or {}) do
      if currentShard == shard then found = true; break end
    end
    if not found then
      control.activeShards = control.activeShards or {}
      control.activeShards[#control.activeShards + 1] = shard
      table.sort(control.activeShards)
    end
    control.generation = control.generation + 1
    control.pendingSeen = { recordId = recordId, association = association }
    return control
  end)
  if not changed then return false, changeReason end
  if not prepared.pendingSeen then return false, "seen association pending receipt was not persisted" end
  local written, writeReason, saved, created = putSeen(association, ops)
  if not written then return false, writeReason end
  local cleared, clearReason, final = ops.updateControl(namespace, function(control)
    if not control.pendingSeen or control.pendingSeen.recordId ~= recordId then
      return nil, "seen association pending receipt changed: expected " .. recordId
        .. " got " .. tostring(control.pendingSeen and control.pendingSeen.recordId)
    end
    control.pendingSeen = nil
    control.lastMutation = { kind = "seen", recordId = recordId,
      generation = control.generation }
    return control
  end)
  if not cleared then return false, clearReason end
  return true, nil, saved, created == true, final.generation
end

return observe
-- Cursor paging over immutable namespace associations.  Directory order is
-- normalized in bounded chunks; ownership filtering advances the cursor over
-- hidden rows so callers never loop on a page of ineligible evidence.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.identity_evidence_v2_store")

local page = {}
page.maxScan = 256

local function parseCursor(value)
  if value == nil or value == "" then return "00", "" end
  if type(value) ~= "string" then return nil end
  local shard, recordId = value:match("^(%x%x)/(ev2%-.+)$")
  if not shard or codec.shard(recordId) ~= shard:lower() then return nil end
  return shard:lower(), recordId .. ".state"
end

local function ownershipFilter(value)
  if value == nil or value == "all" then return value end
  if value == "unclaimed" or value == "unclaimed_or_current_row"
      or value == "owned_by_target" or value == "owned_by_other" then return value end
  return nil, "unsupported ownership page filter"
end

local function eligible(row, wanted)
  if wanted == nil or wanted == "all" then return true end
  if wanted == "unclaimed_or_current_row" then
    return row.ownership == "unclaimed" or row.ownership == "owned_by_target"
  end
  return row.ownership == wanted
end

function page.read(facade, options, ops)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  local kind, limit = options.kind, math.floor(tonumber(options.limit) or ops.maxPage)
  local labelQuery, labelReason = codec.normalizeLabelQuery(options.labelQuery)
  if labelReason then
    return false, labelReason
  end
  if not namespace then return false, "paged evidence requires a workflow policy namespace" end
  if kind ~= nil and kind ~= "item" and kind ~= "fluid" then return false, "page kind must be item or fluid" end
  if limit < 1 or limit > ops.maxPage then
    return false, "page limit must be 1 through " .. tostring(ops.maxPage)
  end
  if options.claimed ~= nil and type(options.claimed) ~= "boolean" then
    return false, "page claimed filter must be boolean"
  end
  local wantedOwnership, ownershipReason = ownershipFilter(options.ownership)
  if ownershipReason then return false, ownershipReason end
  local startShard, after = parseCursor(options.cursor)
  if not startShard then return false, "page cursor is invalid" end
  local ok, reason, control = ops.recover(namespace)
  if not ok then return false, reason end
  local rows, lastCursor, scanned, exhausted = {}, nil, 0, true
  local active, shardIndex = control.activeShards or {}, 1
  while active[shardIndex] and active[shardIndex] < startShard do shardIndex = shardIndex + 1 end
  while shardIndex <= #active and #rows < limit and scanned < page.maxScan do
    local shard = active[shardIndex]
    local wantedAfter = shard == startShard and after or ""
    local remaining = math.min(33, page.maxScan - scanned)
    local names, listReason = store.namesAfter(ops.seenRoot(namespace) .. "/" .. shard,
      wantedAfter, remaining, function(name)
        local recordId = name:match("^(ev2%-.+)%.state$")
        local recordKind = recordId and codec.parseRecordId(recordId) or nil
        return recordId ~= nil and codec.shard(recordId) == shard
          and (kind == nil or recordKind == kind)
      end)
    if not names then return false, listReason end
    for _, name in ipairs(names) do
      local recordId = assert(name:match("^(ev2%-.+)%.state$"))
      scanned, lastCursor, wantedAfter = scanned + 1, shard .. "/" .. recordId, name
      local row, rowReason = facade.get(recordId, { namespace = namespace,
        gridAddress = options.gridAddress,
        targetWorkflowId = options.targetWorkflowId or options.workflowId,
        targetConfigIndex = options.targetConfigIndex or options.configIndex,
        _recovered = true })
      if not row then return false, rowReason end
      if (options.claimed == nil or row.claimed == options.claimed)
          and eligible(row, wantedOwnership)
          and codec.matchesLabelQuery(row, labelQuery) then rows[#rows + 1] = row end
      if #rows >= limit or scanned >= page.maxScan then break end
    end
    if #rows >= limit or scanned >= page.maxScan then exhausted = false; break end
    if #names < remaining then
      shardIndex, startShard, after = shardIndex + 1, active[shardIndex + 1] or "ff", ""
    else
      after = wantedAfter
    end
  end
  if shardIndex <= #active and (scanned >= page.maxScan or #rows >= limit) then exhausted = false end
  return true, nil, { schemaVersion = ops.schemaVersion, namespace = namespace,
    generation = control.generation, records = rows, count = #rows,
    nextCursor = not exhausted and lastCursor or nil, limit = limit,
    scanned = scanned, scanLimited = scanned >= page.maxScan,
    health = store.health(namespace) }
end

return page
-- Bounded per-file persistence primitives for identity evidence v2. Every
-- normal operation touches one stable authority pathname; old same-path
-- transaction artifacts are recovery input only. There is no aggregate ledger
-- to deserialize.
local filesystem = require("filesystem")
local serialization = require("serialization")
local atomic = require("oc.ae2.identity_evidence_store")

local store = {}
store.root = "/var/oc/ae2-evidence-v2"
store.caps = {
  fact = 8192, seen = 4096, reservation = 4096,
  intent = 16384, commit = 4096, capture = 4096,
  control = 16384, migration = 16384
}
store.lowRatio = 0.80

local healthByNamespace = {}

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}
  if seen[value] then return seen[value] end
  local out = {}
  seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end

local function encoded(value)
  local ok, body = pcall(serialization.serialize, value)
  if not ok or type(body) ~= "string" then
    return nil, tostring(ok and "serialization did not return text" or body)
  end
  if body:sub(-1) ~= "\n" then body = body .. "\n" end
  return body
end

local function severity(state) return state == "FULL" and 3 or state == "LOW" and 2 or 1 end

local function note(namespace, state, detail, kind, bytes, cap)
  namespace = tostring(namespace or "global")
  local current = healthByNamespace[namespace]
  if not current or severity(state) >= severity(current.state) then
    healthByNamespace[namespace] = {
      state = state, detail = tostring(detail or ""), kind = kind,
      bytes = tonumber(bytes), cap = tonumber(cap)
    }
  end
end

local function diskFailure(reason)
  reason = tostring(reason or ""):lower()
  return reason:find("byte write limit", 1, true)
    or reason:find("exceeds", 1, true)
    or reason:find("space", 1, true)
    or reason:find("full", 1, true)
    or reason:find("could not create", 1, true)
    or reason:find("could not stage", 1, true)
    or reason:find("could not promote", 1, true)
    or reason:find("write", 1, true)
end

function store.health(namespace)
  local current = healthByNamespace[tostring(namespace or "global")]
  local out = current and clone(current) or { state = "UNKNOWN" }
  out.capacity = "UNKNOWN"
  if type(filesystem.spaceUsed) == "function" and type(filesystem.spaceTotal) == "function" then
    local usedOk, used = pcall(filesystem.spaceUsed, store.root)
    local totalOk, total = pcall(filesystem.spaceTotal, store.root)
    used, total = usedOk and tonumber(used) or nil, totalOk and tonumber(total) or nil
    if used and total and used >= 0 and total > 0 and used <= total then
      out.used, out.total, out.ratio = used, total, used / total
      out.capacity = out.ratio >= 0.98 and "FULL" or (out.ratio >= 0.85 and "LOW" or "HEALTHY")
      if out.capacity == "FULL" and severity(out.state) < severity("FULL") then
        out.state, out.detail = "FULL", "filesystem utilization is at least 98%"
      elseif out.capacity == "LOW" and severity(out.state) < severity("LOW") then
        out.state, out.detail = "LOW", "filesystem utilization is at least 85%"
      elseif out.state == "UNKNOWN" then out.state = "HEALTHY"
      end
    end
  end
  return out
end

function store.clearProcessHealth(namespace)
  healthByNamespace[tostring(namespace or "global")] = nil
end

function store.path(...)
  local out = store.root
  for index = 1, select("#", ...) do
    local part = tostring(select(index, ...))
    if part ~= "" then out = out .. "/" .. part end
  end
  return out
end

function store.read(path, cap)
  cap = tonumber(cap)
  if type(path) ~= "string" or path == "" or not cap or cap < 1 then
    return nil, "bounded evidence path and cap are required", nil
  end
  local snapshot, reason = atomic.snapshot(path, { maxBytes = cap })
  if not snapshot then return nil, reason, nil end
  if snapshot.present ~= true then return nil, nil, false end
  return snapshot.value, nil, true
end

function store.exists(path)
  local ok, present, reason = pcall(filesystem.exists, path)
  if not ok then return nil, tostring(present) end
  if present == nil then return nil, tostring(reason or "filesystem existence check failed") end
  return present == true
end

-- Create-once with full-content verification.  A raced winner is accepted
-- only when the caller's equality predicate proves it is the same authority.
function store.putImmutable(path, value, options)
  options = type(options) == "table" and options or {}
  local cap, namespace, kind = tonumber(options.cap), options.namespace, options.kind
  if not cap or cap < 1 then return false, "immutable file cap is required" end
  local body, encodeReason = encoded(value)
  if not body then return false, encodeReason end
  if #body > cap then
    local reason = tostring(kind or "evidence") .. " file exceeds " .. tostring(cap) .. " byte cap"
    note(namespace, "FULL", reason, kind, #body, cap)
    return false, reason
  end
  if #body >= math.floor(cap * store.lowRatio) then
    note(namespace, "LOW", "file is near its bounded capacity", kind, #body, cap)
  end
  local same = type(options.same) == "function" and options.same or function(left, right)
    local leftBody, rightBody = encoded(left), encoded(right)
    return leftBody ~= nil and leftBody == rightBody
  end
  local snapshot, reason = atomic.snapshot(path, { maxBytes = cap })
  if not snapshot then
    if diskFailure(reason) then note(namespace, "FULL", reason, kind, #body, cap) end
    return false, reason
  end
  if snapshot.present == true then
    local ok, equal = pcall(same, snapshot.value, value)
    if ok and equal == true then return true, nil, snapshot.value, false, #body end
    return false, "immutable " .. tostring(kind or "evidence") .. " authority conflicts at " .. path
  end
  local health = store.health(namespace)
  local highWater = tonumber(options.highWater)
  if highWater and (health.state == "FULL" or (health.ratio and health.ratio >= highWater)) then
    local reason = "evidence storage reserve blocks new " .. tostring(kind or "file")
    note(namespace, "FULL", reason, kind, #body, cap)
    return false, reason
  end
  local ok, writeReason, saved = atomic.compareAndSwap(path, snapshot, value, { maxBytes = cap })
  if ok then return true, nil, saved, true, #body end
  -- A peer may have won between snapshot and promotion.  Never overwrite it;
  -- read it once and accept only exact equality.
  local winner, readReason, present = store.read(path, cap)
  if present == true then
    local compared, equal = pcall(same, winner, value)
    if compared and equal == true then return true, nil, winner, false, #body end
  end
  local finalReason = readReason or writeReason
  if diskFailure(finalReason) then note(namespace, "FULL", finalReason, kind, #body, cap) end
  return false, finalReason
end

function store.update(path, cap, callback, options)
  options = type(options) == "table" and options or {}
  if type(callback) ~= "function" then return false, "bounded update callback is required" end
  local ok, reason, saved = atomic.update(path, callback, {
    maxBytes = cap, retries = tonumber(options.retries) or 3
  })
  if not ok and diskFailure(reason) then
    note(options.namespace, "FULL", reason, options.kind, nil, cap)
  elseif ok then
    local body = encoded(saved)
    if body and #body >= math.floor(cap * store.lowRatio) then
      note(options.namespace, "LOW", "file is near its bounded capacity",
        options.kind, #body, cap)
    end
  end
  return ok, reason, saved
end

-- Return only the lexicographically smallest `limit` matching names after the
-- cursor.  filesystem.list may be unordered, so insertion is capped instead
-- of materializing or sorting the directory.
function store.namesAfter(path, after, limit, predicate)
  limit = math.max(1, math.min(33, math.floor(tonumber(limit) or 1)))
  after = tostring(after or "")
  local present, existsReason = store.exists(path)
  if present == nil then return nil, existsReason end
  if not present then return {}, nil end
  local called, iterator, listReason = pcall(filesystem.list, path)
  if not called then return nil, tostring(iterator) end
  if type(iterator) ~= "function" then return nil, tostring(listReason or "directory listing failed") end
  local selected = {}
  local function insert(name)
    local position = #selected + 1
    while position > 1 and name < selected[position - 1] do
      position = position - 1
    end
    table.insert(selected, position, name)
    if #selected > limit then table.remove(selected) end
  end
  for rawName in iterator do
    local name = tostring(rawName or ""):gsub("/$", "")
    if name > after and (type(predicate) ~= "function" or predicate(name)) then
      if #selected < limit or name < selected[#selected] then insert(name) end
    end
  end
  return selected, nil
end

return store
-- Namespace fencing around immutable evidence reservations.  The fence is
-- visible before the first intent write and survives every pre-commit crash.
local codec = require("oc.ae2.identity_evidence_v2_codec")
local claims = require("oc.ae2.identity_evidence_v2_claims")

local transaction = {}

local function establishPending(namespace, transactionId, expectedGeneration, ops)
  return ops.updateControl(namespace, function(control)
    if control.pendingClaim and control.pendingClaim ~= transactionId then
      return nil, "another claim transaction requires recovery"
    end
    if control.pendingClaim == transactionId then return control end
    if control.generation ~= expectedGeneration then
      return nil, "identity evidence generation changed after preview; review and retry"
    end
    control.pendingClaim = transactionId
    return control
  end)
end

local function markReady(namespace, transactionId, expectedGeneration, ops)
  return ops.updateControl(namespace, function(control)
    if control.pendingClaim ~= transactionId then
      return nil, "claim transaction lost its namespace recovery fence"
    end
    if control.generation < expectedGeneration then return nil, "claim generation moved backward" end
    if control.generation == expectedGeneration then control.generation = control.generation + 1 end
    control.lastMutation = { kind = "claim_reserved", transactionId = transactionId,
      generation = control.generation }
    return control
  end)
end

function transaction.reserve(options, ops)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  local transactionId = codec.safeSegment(options.transactionId, 96)
  local expectedGeneration = tonumber(options.expectedGeneration)
  if not namespace then return false, "claim transaction requires a workflow policy namespace" end
  if not transactionId then return false, "path-safe claim transactionId is required" end
  if not expectedGeneration or expectedGeneration < 0
      or expectedGeneration ~= math.floor(expectedGeneration) then
    return false, "claim transaction requires a non-negative expected generation"
  end
  local control, reason = ops.control(namespace)
  if not control then return false, reason end
  if control.pendingClaim and control.pendingClaim ~= transactionId then
    return false, "another claim transaction requires recovery"
  end
  -- Every ordinary shape/authority/conflict error is discovered before the
  -- namespace fence is installed.  Once fenced, only an actual interrupted
  -- immutable write can leave MISSING/INTENT_ONLY/PARTIAL recovery state.
  options.namespace, options.currentGeneration = namespace, control.generation
  local valid, validationReason = claims.preflight(options)
  if not valid then return false, validationReason end
  local fenced, fenceReason, pendingControl = establishPending(
    namespace, transactionId, expectedGeneration, ops)
  if not fenced then return false, fenceReason end
  options.namespace, options.currentGeneration = namespace, pendingControl.generation
  local ok, reserveReason, status = claims.reserve(options)
  if not ok then return false, reserveReason, status end
  local marked, markReason, finalControl = markReady(
    namespace, transactionId, expectedGeneration, ops)
  if not marked then return false, markReason, status end
  status.generation = finalControl.generation
  return true, nil, status
end

function transaction.commit(options, ops)
  options = type(options) == "table" and options or {}
  local namespace = codec.validNamespace(options.namespace or options.workflowNamespace)
  local transactionId = codec.safeSegment(options.transactionId, 96)
  if not namespace or not transactionId then return false, "valid namespace and transactionId are required" end
  local control, reason = ops.control(namespace)
  if not control then return false, reason end
  if control.pendingClaim and control.pendingClaim ~= transactionId then
    return false, "another claim transaction owns the namespace recovery fence"
  end
  local status, statusReason = claims.recoveryStatus(namespace, transactionId)
  if not status then return false, statusReason end
  if not control.pendingClaim and status.state ~= "COMMITTED" then
    return false, "claim transaction has no namespace recovery fence"
  end
  options.namespace, options.transactionId = namespace, transactionId
  local ok, commitReason, committed = claims.commit(options)
  if not ok then return false, commitReason, committed end
  local recovered, recoverReason, finalControl, pending = ops.recoverPendingClaim(namespace)
  if not recovered or pending then
    return false, recoverReason or "committed claim recovery fence was not cleared", committed
  end
  committed.generation = finalControl.generation
  return true, nil, committed
end

return transaction
-- A capture-only observer for durable CPU finalOutput identity requests.
-- It deliberately has no maintainer, planner, request, queue, or state-store
-- dependency: automation ownership remains with the daemon, while this worker
-- only keeps a newly armed evidence capture alive after its caller returns.
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")

local worker = {}
local active = {}
local finished = {}
local finishedOrder = {}

local MIN_POLL_SECONDS = 1
local DEFAULT_POLL_SECONDS = 1
local MAX_FINISHED_RECEIPTS = 8
local WAIT_SIGNAL = "oc_ae2_identity_capture_worker"
local terminal = { CONSUMED = true, AMBIGUOUS = true, EXPIRED = true }

local function finite(value)
  value = tonumber(value)
  if value == nil or value ~= value or value == math.huge or value == -math.huge then return nil end
  return value
end

local function shallowCopy(value)
  local out = {}
  for key, item in pairs(type(value) == "table" and value or {}) do out[key] = item end
  return out
end

local function copyCapture(value)
  if type(value) ~= "table" then return nil end
  local out = {}
  for key, item in pairs(value) do
    if type(item) ~= "table" then out[key] = item end
  end
  return out
end

local function clock(options)
  local reader = type(options.now) == "function" and options.now or computer.uptime
  local called, value = pcall(reader)
  value = called and finite(value) or nil
  if value == nil or value < 0 then return nil, "monotonic uptime is unavailable" end
  return value
end

local function daemonState(options)
  local reader = type(options.loadDaemonConfig) == "function"
    and options.loadDaemonConfig or daemonConfig.load
  local called, value, reason = pcall(reader)
  if not called then return nil, "daemon desired state read failed: " .. tostring(value) end
  if type(value) ~= "table" or value.readFailed == true then
    return nil, "daemon desired state is unreadable: " .. tostring(reason
      or (type(value) == "table" and (value.readError or value.lastError)) or "invalid state")
  end
  return value
end

local function policyState(options)
  if type(options.readPolicy) == "function" then
    local called, value, reason = pcall(options.readPolicy)
    if not called then return nil, "workflow policy read failed: " .. tostring(value) end
    if type(value) ~= "table" then
      return nil, "workflow policy is unavailable: " .. tostring(reason or "invalid state")
    end
    return value
  end

  local loaded, store = pcall(require, "oc.ae2.workflow_store")
  if not loaded or type(store) ~= "table" or type(store.rawSnapshot) ~= "function" then
    return nil, "durable workflow policy store is unavailable"
  end
  local called, snapshot, reason = pcall(store.rawSnapshot)
  if not called or type(snapshot) ~= "table" or type(snapshot.value) ~= "table" then
    return nil, "durable workflow policy read failed: " .. tostring(called and reason or snapshot)
  end
  local idLoaded, workflowId = pcall(require, "oc.ae2.workflow_id")
  if not idLoaded or type(workflowId) ~= "table" or type(workflowId.authority) ~= "function" then
    return nil, "workflow policy authority service is unavailable"
  end
  local namespace, authorityReason = workflowId.authority(snapshot.value)
  if not namespace then return nil, tostring(authorityReason or "workflow policy authority is unavailable") end
  return { namespace = namespace, autoEnabled = snapshot.value.autoEnabled ~= false }
end

local function captureState(options, namespace)
  local reader = options.readCapture
  if type(reader) ~= "function" then
    local loaded, evidence = pcall(require, "oc.ae2.identity_evidence")
    if not loaded or type(evidence) ~= "table" or type(evidence.captureStatus) ~= "function" then
      return nil, "durable identity capture status service is unavailable"
    end
    reader = evidence.captureStatus
  end
  local called, value, reason = pcall(reader, namespace)
  if not called then return nil, "durable capture status read failed: " .. tostring(value) end
  if type(value) ~= "table" or type(value.capture) ~= "table" then
    return nil, "durable capture status is unavailable: " .. tostring(reason or "capture missing")
  end
  return value.capture, value
end

local function waitFor(options, seconds)
  if seconds <= 0 then return true end
  local pull = options.pull
  if type(pull) ~= "function" then
    local loaded, event = pcall(require, "event")
    if loaded and type(event) == "table" and type(event.pull) == "function" then
      pull = event.pull
    elseif type(computer.pullSignal) == "function" then
      pull = computer.pullSignal
    else return false, "yielding wait service is unavailable" end
  end
  local called, reason = pcall(pull, seconds, WAIT_SIGNAL)
  if not called then return false, "capture worker wait failed: " .. tostring(reason) end
  return true
end

local function observe(options, observedAt)
  local observer = options.observe
  if type(observer) ~= "function" then
    local loaded, workflows = pcall(require, "oc.ae2.workflows")
    if not loaded or type(workflows) ~= "table"
        or type(workflows.observeActiveCpuOutputs) ~= "function" then
      return false, "bounded CPU observation backend is unavailable"
    end
    observer = workflows.observeActiveCpuOutputs
  end
  local called, ok, reason, report = pcall(observer, {
    captureNext = false, observedAt = observedAt
  })
  if not called then return false, "bounded CPU observation failed: " .. tostring(ok) end
  return ok == true, reason, report
end

local function validateCapture(value)
  if type(value) ~= "table" then return nil, "new capture receipt is missing" end
  local id = type(value.captureId) == "string" and value.captureId or nil
  local requestedAt, expiresAt = finite(value.requestedAt), finite(value.expiresAt)
  if not id or id == "" or value.active ~= true or value.status ~= "ARMED"
      or requestedAt == nil or requestedAt < 0 or expiresAt == nil or expiresAt <= requestedAt then
    return nil, "new capture receipt is malformed"
  end
  return copyCapture(value)
end

local function stopReport(capture, namespace, status, polls, startedAt, endedAt, lastError)
  return { action = "identity_capture_worker_stopped", captureId = capture.captureId,
    namespace = namespace, status = status, polls = polls, startedAt = startedAt,
    endedAt = endedAt, lastError = lastError }
end

local function ownershipState(options, expectedNamespace)
  local cfg, daemonReason = daemonState(options)
  if not cfg then return nil, daemonReason end
  if cfg.maintenanceBrake == true then return { status = "MAINTENANCE_BRAKE" } end
  if cfg.enabled == true then return { status = "DAEMON_ENABLED" } end
  if cfg.enabled ~= false then return nil, "daemon desired state is not explicitly OFF" end

  local policy, policyReason = policyState(options)
  if not policy then return nil, policyReason end
  if type(policy.namespace) ~= "string" or policy.namespace == "" then
    return nil, "workflow policy namespace is unavailable"
  end
  if expectedNamespace and policy.namespace ~= expectedNamespace then
    return { status = "POLICY_REPLACED", namespace = policy.namespace }
  end
  -- Global Auto is only a permission bit while daemon ownership is OFF. This
  -- worker imports no planner or submitter, so it may observe CPU output
  -- without changing that permission or acquiring craft authority.
  return { status = "CAPTURE_ONLY", namespace = policy.namespace }
end

function worker.run(options)
  options = type(options) == "table" and options or {}
  local capture, captureReason = validateCapture(options.capture)
  if not capture then return false, captureReason end
  local pollSeconds = math.max(MIN_POLL_SECONDS, finite(options.pollSeconds)
    or DEFAULT_POLL_SECONDS)
  local startedAt, timeReason = clock(options)
  if not startedAt then return false, timeReason end

  local ownership, ownershipReason = ownershipState(options, options.namespace)
  if not ownership then return false, ownershipReason end
  if ownership.status ~= "CAPTURE_ONLY" then
    return true, nil, stopReport(capture, ownership.namespace or options.namespace,
      ownership.status, 0, startedAt, startedAt)
  end
  local namespace = ownership.namespace
  local nextPoll, polls, lastError = startedAt + pollSeconds, 0, nil

  while true do
    local current, currentReason = clock(options)
    if not current then return false, currentReason end

    local durable, durableReason = captureState(options, namespace)
    if not durable then return false, durableReason end
    if durable.captureId ~= capture.captureId then
      return true, nil, stopReport(capture, namespace, "REPLACED", polls,
        startedAt, current, lastError)
    end
    local durableStatus = tostring(durable.status or "UNKNOWN")
    if terminal[durableStatus] or durable.active ~= true then
      return true, nil, stopReport(capture, namespace, durableStatus, polls,
        startedAt, current, lastError)
    end
    if current >= capture.expiresAt then
      return true, nil, stopReport(capture, namespace, "TTL", polls,
        startedAt, current, lastError)
    end

    ownership, ownershipReason = ownershipState(options, namespace)
    if not ownership then return false, ownershipReason end
    if ownership.status ~= "CAPTURE_ONLY" then
      return true, nil, stopReport(capture, namespace, ownership.status, polls,
        startedAt, current, lastError)
    end

    if current < nextPoll then
      local waited, waitReason = waitFor(options,
        math.min(nextPoll - current, capture.expiresAt - current))
      if not waited then return false, waitReason end
    else
      local observed, observeReason = observe(options, current)
      polls = polls + 1
      if not observed then lastError = tostring(observeReason or "bounded CPU observation failed") end
      local after, afterReason = clock(options)
      if not after then return false, afterReason end
      nextPoll = after + pollSeconds

      durable, durableReason = captureState(options, namespace)
      if not durable then return false, durableReason end
      if durable.captureId ~= capture.captureId then
        return true, nil, stopReport(capture, namespace, "REPLACED", polls,
          startedAt, after, lastError)
      end
      durableStatus = tostring(durable.status or "UNKNOWN")
      if terminal[durableStatus] or durable.active ~= true then
        return true, nil, stopReport(capture, namespace, durableStatus, polls,
          startedAt, after, lastError)
      end
    end
  end
end

local function rememberFinished(captureId, receipt)
  if not finished[captureId] then
    finishedOrder[#finishedOrder + 1] = captureId
    if #finishedOrder > MAX_FINISHED_RECEIPTS then
      local removed = table.remove(finishedOrder, 1)
      finished[removed] = nil
    end
  end
  finished[captureId] = receipt
end

local function createThread(options, body)
  if type(options.createThread) == "function" then
    local called, handle, reason = pcall(options.createThread, body)
    if not called then return nil, tostring(handle) end
    return handle, reason
  end
  local loaded, thread = pcall(require, "thread")
  if not loaded or type(thread) ~= "table" or type(thread.create) ~= "function" then
    return nil, "OpenOS thread library is unavailable"
  end
  local called, handle = pcall(thread.create, body)
  if not called or not handle then return nil, tostring(handle or "thread create failed") end
  return handle
end

function worker.start(options)
  options = type(options) == "table" and options or {}
  local capture, captureReason = validateCapture(options.capture)
  if not capture then return false, captureReason, { action = "identity_capture_worker_failed" } end
  if active[capture.captureId] then
    return true, nil, { action = "identity_capture_worker_already_running",
      captureId = capture.captureId }
  end
  if finished[capture.captureId] then
    return true, nil, { action = "identity_capture_worker_already_finished",
      captureId = capture.captureId, result = finished[capture.captureId] }
  end

  local ownership, ownershipReason = ownershipState(options, options.namespace)
  if not ownership then
    return false, ownershipReason, { action = "identity_capture_worker_failed",
      captureId = capture.captureId }
  end
  if ownership.status == "DAEMON_ENABLED" then
    return true, nil, { action = "identity_capture_worker_daemon_owned",
      captureId = capture.captureId }
  end
  if ownership.status ~= "CAPTURE_ONLY" then
    return false, "capture-only ownership is unavailable: " .. tostring(ownership.status),
      { action = "identity_capture_worker_failed", captureId = capture.captureId,
        status = ownership.status }
  end

  local launch = shallowCopy(options)
  launch.capture, launch.namespace = capture, ownership.namespace
  active[capture.captureId] = { captureId = capture.captureId,
    namespace = ownership.namespace, expiresAt = capture.expiresAt }
  local function body()
    local called, ok, reason, report = pcall(worker.run, launch)
    local receipt
    if called then
      receipt = report or { action = "identity_capture_worker_stopped",
        captureId = capture.captureId, status = ok == true and "STOPPED" or "FAILED",
        lastError = reason }
    else
      receipt = { action = "identity_capture_worker_stopped", captureId = capture.captureId,
        status = "FAILED", lastError = tostring(ok) }
    end
    active[capture.captureId] = nil
    rememberFinished(capture.captureId, receipt)
  end

  local handle, createReason = createThread(options, body)
  if not handle then
    active[capture.captureId] = nil
    return false, tostring(createReason or "capture worker thread could not be created"),
      { action = "identity_capture_worker_failed", captureId = capture.captureId }
  end
  if type(handle.detach) ~= "function" then
    active[capture.captureId] = nil
    if type(handle.kill) == "function" then pcall(handle.kill, handle) end
    return false, "capture worker thread cannot detach from its foreground caller",
      { action = "identity_capture_worker_failed", captureId = capture.captureId }
  end
  local detached, detachReason = pcall(handle.detach, handle)
  if not detached or detachReason == false then
    active[capture.captureId] = nil
    if type(handle.kill) == "function" then pcall(handle.kill, handle) end
    return false, "capture worker could not detach: " .. tostring(detachReason),
      { action = "identity_capture_worker_failed", captureId = capture.captureId }
  end
  return true, nil, { action = "identity_capture_worker_started",
    captureId = capture.captureId, namespace = ownership.namespace,
    expiresAt = capture.expiresAt,
    pollSeconds = math.max(MIN_POLL_SECONDS, finite(options.pollSeconds)
      or DEFAULT_POLL_SECONDS) }
end

function worker.startForArmed(report, options)
  report = type(report) == "table" and report or {}
  local request = report.captureRequest
  if type(request) ~= "table" or request.action ~= "identity_capture_armed" then
    return true, nil, { action = "identity_capture_worker_not_started",
      reason = "foreground call did not create a new capture" }
  end
  local capture, captureReason = validateCapture(request.capture)
  if not capture then
    return false, captureReason, { action = "identity_capture_worker_failed" }
  end
  local launch = shallowCopy(options)
  launch.capture = capture
  return worker.start(launch)
end

function worker.afterForeground(reason, report)
  local called, started, startReason, workerReport = pcall(worker.startForArmed, report)
  if type(report) ~= "table" then report = {} end
  if called ~= true then
    report.captureWorker = { action = "identity_capture_worker_failed" }
    return false, "capture armed but detached worker launch failed: "
      .. tostring(started), report
  end
  report.captureWorker = workerReport
  if started ~= true then
    return false, "capture armed but detached worker launch failed: "
      .. tostring(startReason or "unknown launch failure"), report
  end
  return true, reason, report
end

function worker.status(captureId)
  if type(captureId) == "string" and active[captureId] then
    return { action = "identity_capture_worker_running", captureId = captureId }
  end
  if type(captureId) == "string" and finished[captureId] then
    return { action = "identity_capture_worker_finished", captureId = captureId,
      result = finished[captureId] }
  end
  return { action = "identity_capture_worker_idle" }
end

return worker
local evidence = require("oc.ae2.identity_evidence")
local store = require("oc.ae2.workflow_store")
local workflowId = require("oc.ae2.workflow_id")

local add = {}

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}; if seen[value] then return seen[value] end
  local out = {}; seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end

local function canonical(value, active)
  local kind = type(value)
  if kind == "nil" then return "n" end
  if kind == "boolean" then return value and "b1" or "b0" end
  if kind == "number" then return "d" .. string.format("%.17g", value) end
  if kind == "string" then return "s" .. #value .. ":" .. value end
  if kind ~= "table" then return nil end
  active = active or {}; if active[value] then return nil end
  active[value] = true
  local rows = {}
  for key, nested in pairs(value) do
    local left, right = canonical(key, active), canonical(nested, active)
    if not left or not right then active[value] = nil; return nil end
    rows[#rows + 1] = left .. "=" .. right
  end
  active[value] = nil; table.sort(rows)
  return "t{" .. table.concat(rows, ";") .. "}"
end

local function digest(value)
  local body = canonical(value); if not body then return nil end
  local first, second = 216613626, 131542391
  for index = 1, #body do
    local byte = string.byte(body, index)
    first = (first * 131 + byte) % 2147483647
    second = (second * 65599 + byte) % 2147483629
  end
  return #body .. ":" .. string.format("%08x", first)
    .. ":" .. string.format("%08x", second)
end

local function logical(value)
  local out = clone(value); if type(out) == "table" then out.identityMutationFence = nil end
  return out
end

local function maintenanceStatus()
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  if not loaded or type(daemonConfig) ~= "table" or type(daemonConfig.load) ~= "function" then
    return false, "daemon safety authority is unavailable", false
  end
  local called, cfg = pcall(daemonConfig.load)
  if not called or type(cfg) ~= "table" or cfg.configReadFailed == true then
    return false, "daemon safety authority is unreadable", false
  end
  if cfg.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(cfg.maintenanceBrakeReason or "operator maintenance")
      .. "; only exact recorded-add recovery may mutate evidence", true
  end
  return true, nil, false
end

local function readOnlySnapshot()
  if type(store.migrationStatus) ~= "function" then
    return nil, "read-only workflow authority inspection is unavailable"
  end
  local called, status = pcall(store.migrationStatus)
  if called and type(status) == "table" and status.state == "missing" then
    local loaded, value, reason = pcall(store.loadForEdit)
    if loaded and type(value) == "table" then
      return { path = store.path, present = false, raw = nil,
        value = clone(value), readOnly = true }
    end
    return nil, tostring(loaded and reason or value or "default workflow policy is unavailable")
  end
  if not called or type(status) ~= "table" or type(status.rawValue) ~= "table"
      or type(status.raw) ~= "string" then
    local detail = type(status) == "table" and status.reason or status
    return nil, tostring(detail or "read-only workflow authority is unavailable")
  end
  return { path = store.path, present = true, raw = status.raw,
    value = clone(status.rawValue), readOnly = true }
end

local function scopeDigest(namespace, recordId, rowId, index)
  return digest({ scope = "recorded_add", namespace = namespace,
    recordId = recordId, workflowId = rowId, configIndex = index })
end

local function gridAddress(options)
  if type(options.gridAddress) == "string" and options.gridAddress ~= "" then
    return options.gridAddress
  end
  local loaded, adapter = pcall(require, "oc.ae2.adapter")
  local called, primary, reason = false, nil, nil
  if loaded and type(adapter.primary) == "function" then
    called, primary, reason = pcall(adapter.primary)
  end
  if not called or type(primary) ~= "table" or type(primary.address) ~= "string"
      or primary.address == "" then
    return nil, tostring(called and reason or primary or "current AE2 grid authority is unavailable")
  end
  return primary.address
end

local function existingReceipt(snapshot, record, recordId)
  local claim = type(record.claim) == "table" and record.claim or {}
  for index, row in ipairs(snapshot.value.workflows or {}) do
    if row.identityEvidenceRecordId == recordId
        and row.workflowId == claim.workflowId and index == tonumber(claim.configIndex) then
      return { action = "identity_record_already_added", configIndex = index,
        workflowId = row.workflowId, recordId = recordId, claimed = claim.state == "COMMITTED" }
    end
  end
end

local function recordedRow(snapshot, recordId)
  local found
  for index, row in ipairs(snapshot.value.workflows or {}) do
    if row.identityEvidenceRecordId == recordId then
      if found then return nil, "recorded evidence is attached to multiple workflow rows" end
      found = { configIndex = index, workflowId = row.workflowId, row = row }
    end
  end
  return found
end

local function exactIntent(status, namespace, recordId, rowId, index, scope, state, afterDigest)
  local intent = type(status) == "table" and status.intent or nil
  local claim = type(intent) == "table" and type(intent.claims) == "table"
    and #intent.claims == 1 and intent.claims[1] or nil
  if type(claim) ~= "table" or intent.namespace ~= namespace
      or claim.recordId ~= recordId or claim.workflowId ~= rowId
      or tonumber(claim.configIndex) ~= tonumber(index) or intent.scopeDigest ~= scope
      or status.workflowState ~= state or (afterDigest and intent.afterDigest ~= afterDigest) then
    return false, "recorded-add recovery intent does not match the exact workflow consequence"
  end
  return true
end

local function brakedRecovery(snapshot, recordId, grid, brakeReason)
  local namespace, reason = workflowId.authority(snapshot.value)
  if not namespace then return nil, reason end
  if type(evidence.inspect) ~= "function" then
    return nil, "read-only evidence authority inspection is unavailable"
  end
  local inspected, inspectReason, control = evidence.inspect(recordId,
    { namespace = namespace, gridAddress = grid })
  if not inspected or type(control) ~= "table" then return nil, inspectReason end
  local workflowDigest = assert(digest(snapshot.value))
  local fence = snapshot.value.identityMutationFence
  if fence ~= nil then
    if type(fence) ~= "table" or type(fence.transactionId) ~= "string"
        or (fence.operation ~= "recorded_add" and not fence.transactionId:match("^ria%-"))
        or fence.namespace ~= namespace or (fence.recordId and fence.recordId ~= recordId) then
      return nil, "a foreign workflow mutation fence owns maintenance recovery"
    end
    local recovery; recovery, reason = evidence.claimRecoveryStatus(
      namespace, fence.transactionId, workflowDigest)
    if not recovery then return nil, reason end
    if control.pendingClaim and control.pendingClaim ~= fence.transactionId then
      return nil, "another evidence claim owns maintenance recovery"
    end
    if recovery.state == "MISSING" then
      if fence.recordId == recordId then
        return { kind = "fenced", fence = fence, recovery = recovery,
          record = inspected, control = control }
      end
      return nil, "recorded-add recovery has no immutable record authority"
    end
    local claim = recovery.intent and recovery.intent.claims and recovery.intent.claims[1]
    local rowId, index = claim and claim.workflowId, claim and claim.configIndex
    local scope = rowId and scopeDigest(namespace, recordId, rowId, index) or nil
    local exact, exactReason = exactIntent(recovery, namespace, recordId,
      rowId, index, scope, "BEFORE")
    if not exact or fence.scopeDigest ~= scope
        or fence.beforeDigest ~= digest(logical(snapshot.value))
        or (fence.workflowId and fence.workflowId ~= rowId)
        or (fence.configIndex and tonumber(fence.configIndex) ~= tonumber(index)) then
      return nil, exactReason or "recorded-add workflow fence does not match its immutable intent"
    end
    return { kind = "fenced", fence = fence, recovery = recovery,
      record = inspected, control = control }
  end

  local current, rowReason = recordedRow(snapshot, recordId)
  if rowReason then return nil, rowReason end
  if not current then return nil, brakeReason end
  local claim = inspected.claim
  if not claim or type(claim.transactionId) ~= "string" then return nil, reason or brakeReason end
  local recovery; recovery, reason = evidence.claimRecoveryStatus(
    namespace, claim.transactionId, workflowDigest)
  if not recovery then return nil, reason end
  if recovery.state ~= "READY" and recovery.state ~= "COMMITTED" then
    return nil, "recorded-add workflow is ahead of an incomplete evidence claim"
  end
  local scope = scopeDigest(namespace, recordId, current.workflowId, current.configIndex)
  local exact, exactReason = exactIntent(recovery, namespace, recordId,
    current.workflowId, current.configIndex, scope, "AFTER", workflowDigest)
  if not exact then return nil, exactReason end
  if control.pendingClaim and control.pendingClaim ~= claim.transactionId then
    return nil, "another evidence claim owns maintenance recovery"
  end
  if recovery.state == "READY" and control.pendingClaim ~= claim.transactionId then
    return nil, "ready recorded-add claim lost its namespace recovery fence"
  end
  return { kind = "after", current = current, claim = claim,
    recovery = recovery, control = control, record = inspected }
end

function add.run(planner, recordId, options)
  options = type(options) == "table" and options or {}
  local open, reason, braked = maintenanceStatus()
  if not open and not braked then return false, reason end
  local snapshot
  if open then snapshot, reason = store.rawSnapshot()
  else snapshot, reason = readOnlySnapshot() end
  if not snapshot then return false, reason end
  local grid; grid, reason = gridAddress(options); if not grid then return false, reason end
  local currentOpen, currentReason, currentBrake = maintenanceStatus()
  if currentOpen and snapshot.readOnly then
    snapshot, reason = store.rawSnapshot(); if not snapshot then return false, reason end
    currentOpen, currentReason, currentBrake = maintenanceStatus()
  end
  if not currentOpen and not currentBrake then return false, currentReason end
  local maintenanceRecovery, recoveryReport
  if not currentOpen then
    maintenanceRecovery, reason, recoveryReport = brakedRecovery(
      snapshot, recordId, grid, currentReason)
    if not maintenanceRecovery then return false, reason, recoveryReport end
  end
  local namespace; namespace, reason = workflowId.authority(snapshot.value)
  if not namespace then return false, reason end
  if maintenanceRecovery and maintenanceRecovery.kind == "after" then
    local recovery, claim = maintenanceRecovery.recovery, maintenanceRecovery.claim
    if recovery.state ~= "COMMITTED" or maintenanceRecovery.control.pendingClaim then
      local committed; committed, reason = evidence.commitClaims({ namespace = namespace,
        transactionId = claim.transactionId, workflowDigest = digest(snapshot.value),
        gridAddress = grid })
      if not committed then return false, reason end
    end
    local current = maintenanceRecovery.current
    return true, nil, { action = "identity_record_already_added",
      configIndex = current.configIndex, workflowId = current.workflowId,
      recordId = recordId, claimed = true, config = snapshot.value }
  end
  local record = maintenanceRecovery and maintenanceRecovery.record or nil
  if not record then record, reason = evidence.get(recordId,
    { namespace = namespace, gridAddress = grid }) end
  if not record then return false, reason end
  local current = existingReceipt(snapshot, record, recordId)
  local claim = type(record.claim) == "table" and record.claim or {}
  if current and claim.transactionId then
    local status; status, reason = evidence.claimRecoveryStatus(namespace,
      claim.transactionId, digest(snapshot.value))
    if not status then return false, reason end
    local scope = scopeDigest(namespace, recordId, current.workflowId, current.configIndex)
    local exact, exactReason = exactIntent(status, namespace, recordId,
      current.workflowId, current.configIndex, scope, "AFTER", digest(snapshot.value))
    if not exact or (status.state ~= "READY" and status.state ~= "COMMITTED") then
      return false, exactReason or "recorded-row claim conflicts with current workflow state"
    end
    if status.state ~= "COMMITTED" then
      local committed; committed, reason = evidence.commitClaims({ namespace = namespace,
        transactionId = claim.transactionId, workflowDigest = digest(snapshot.value),
        gridAddress = grid })
      if not committed then return false, reason end
    end
    current.claimed, current.config = true, snapshot.value
    return true, nil, current
  elseif current then
    return false, "recorded row exists without its durable v2 claim receipt"
  end

  local pending = claim.state == "RESERVED" and claim.transactionId or nil
  local candidate, addReason, receipt = planner.addRecorded(snapshot.value, record, {
    restore = options.restore == true, expectedWorkflowId = options.expectedWorkflowId,
    recoverPending = pending ~= nil, pendingTransactionId = pending,
    craftCompatibility = snapshot.value.craftCompatibility,
    resolveTagged = options.resolveTagged or function(identity, resolveOptions)
      return require("oc.ae2.request_direct").resolve(identity, resolveOptions)
    end
  })
  if not candidate then return false, addReason end
  candidate.identityMutationFence = nil
  local control = maintenanceRecovery and maintenanceRecovery.control or nil
  if not control then control, reason = evidence.control(namespace,
    { gridAddress = grid, _requireGrid = true }) end
  if not control then return false, reason end
  local scope = assert(scopeDigest(
    namespace, recordId, receipt.workflowId, receipt.configIndex))
  local transactionId = pending or ("ria-" .. evidence.digestText(table.concat({ namespace,
    recordId, receipt.workflowId, tostring(receipt.configIndex), tostring(control.generation) }, "|")))
  local afterDigest = assert(digest(candidate))
  if maintenanceRecovery and (maintenanceRecovery.fence.transactionId ~= transactionId
      or maintenanceRecovery.fence.scopeDigest ~= scope
      or (maintenanceRecovery.fence.recordId
        and maintenanceRecovery.fence.recordId ~= recordId)
      or (maintenanceRecovery.fence.workflowId
        and maintenanceRecovery.fence.workflowId ~= receipt.workflowId)
      or (maintenanceRecovery.fence.configIndex
        and tonumber(maintenanceRecovery.fence.configIndex) ~= tonumber(receipt.configIndex))
      or maintenanceRecovery.fence.beforeDigest ~= digest(logical(snapshot.value))) then
    return false, "recorded-add fence does not match the derived immutable consequence"
  end
  local recovery; recovery, reason = evidence.claimRecoveryStatus(namespace,
    transactionId, digest(snapshot.value))
  if not recovery then return false, reason end
  if recovery.state ~= "MISSING" then
    if type(recovery.intent) ~= "table" or recovery.intent.scopeDigest ~= scope
        or recovery.intent.afterDigest ~= afterDigest then
      return false, "immutable recorded-add recovery intent conflicts with this row"
    end
    if recovery.workflowState == "AFTER" then
      if recovery.state ~= "COMMITTED" then
        local committed; committed, reason = evidence.commitClaims({ namespace = namespace,
          transactionId = transactionId, workflowDigest = digest(snapshot.value), gridAddress = grid })
        if not committed then return false, reason end
      end
      receipt.config, receipt.claimed = snapshot.value, true
      return true, nil, receipt
    elseif recovery.workflowState ~= "BEFORE" then
      return false, "recorded-add recovery conflicts with current workflow state"
    elseif recovery.state == "COMMITTED" then
      return false, "committed recorded-add claim cannot precede its workflow consequence"
    end
  end

  local fence = snapshot.value.identityMutationFence
  if fence and fence.transactionId ~= transactionId then
    return false, "another transaction owns the workflow mutation fence"
  end
  if not fence then
    local allowed, allowReason = maintenanceStatus()
    if not allowed then return false, allowReason end
    fence = { operation = "recorded_add", transactionId = transactionId,
      namespace = namespace, recordId = recordId, workflowId = receipt.workflowId,
      configIndex = receipt.configIndex, scopeDigest = scope,
      beforeDigest = assert(digest(logical(snapshot.value))), installedAt = tonumber(options.now) or 0 }
    local fenced = clone(snapshot.value); fenced.identityMutationFence = clone(fence)
    local claims = { { recordId = recordId, workflowId = receipt.workflowId,
      configIndex = receipt.configIndex } }
    local ready; ready, reason = evidence.preflightClaims({ namespace = namespace,
      transactionId = transactionId, expectedGeneration = control.generation,
      currentGeneration = control.generation, beforeDigest = assert(digest(fenced)),
      afterDigest = afterDigest, scopeDigest = scope, claims = claims,
      gridAddress = grid })
    if not ready then return false, reason end
    allowed, allowReason = maintenanceStatus()
    if not allowed then return false, allowReason end
    local installed; installed, reason = store.installIdentityFence(snapshot, fence)
    if not installed then return false, reason end
    snapshot, reason = store.rawSnapshot(); if not snapshot then return false, reason end
  elseif recovery.state == "MISSING" then
    local claims = { { recordId = recordId, workflowId = receipt.workflowId,
      configIndex = receipt.configIndex } }
    local ready; ready, reason = evidence.preflightClaims({ namespace = namespace,
      transactionId = transactionId, expectedGeneration = control.generation,
      currentGeneration = control.generation, beforeDigest = assert(digest(snapshot.value)),
      afterDigest = afterDigest, scopeDigest = scope, claims = claims,
      gridAddress = grid })
    if not ready then return false, reason end
  end
  local claims = { { recordId = recordId, workflowId = receipt.workflowId,
    configIndex = receipt.configIndex } }
  local reserved; reserved, reason = evidence.reserveClaims({ namespace = namespace,
    transactionId = transactionId,
    expectedGeneration = recovery.intent and recovery.intent.expectedGeneration or control.generation,
    beforeDigest = assert(digest(snapshot.value)), afterDigest = afterDigest,
    scopeDigest = scope, claims = claims, gridAddress = grid })
  if not reserved then
    return false, reason
  end
  local saved, saveReason, compacted = store.saveRawSnapshot(snapshot, candidate, nil,
    "identity_record_add", { identityTransactionId = transactionId })
  if not saved then return false, saveReason end
  local final = store.rawSnapshot(); if not final then return false, "saved workflow is unreadable" end
  if digest(final.value) ~= afterDigest then return false, "saved recorded row digest changed" end
  local committed; committed, reason = evidence.commitClaims({ namespace = namespace,
    transactionId = transactionId, workflowDigest = afterDigest, gridAddress = grid })
  if not committed then return false, reason end
  receipt.config, receipt.claimed = compacted, true
  return true, nil, receipt
end

local function recoveryRetryable(reason)
  local text = tostring(reason or ""):lower()
  for _, marker in ipairs({ "conflict", "foreign", "malformed", "match", "missing",
      "multiple", "incomplete", "cannot precede", "lost its namespace" }) do
    if text:find(marker, 1, true) then return false end
  end
  return true
end

local function noRecovery() return true, nil, { action = "none" } end

local function recoveryError(reason, transactionId, recordId, hard)
  return false, reason, { retryable = not hard and recoveryRetryable(reason) or false,
    transactionId = transactionId, recordId = recordId }
end

function add.recoverPending(options)
  options = type(options) == "table" and options or {}
  local open, reason, braked = maintenanceStatus()
  if open then return noRecovery() end
  if not braked then return false, reason end
  local snapshot; snapshot, reason = readOnlySnapshot()
  if not snapshot then return false, reason end
  if snapshot.present == false then return noRecovery() end
  local fence = snapshot.value.identityMutationFence
  local recordedFence = type(fence) == "table" and type(fence.transactionId) == "string"
    and (fence.operation == "recorded_add" or fence.transactionId:match("^ria%-"))
  local namespace; namespace, reason = workflowId.authority(snapshot.value)
  if not namespace then
    if reason == "workflow policy namespace is missing" and not recordedFence then
      return noRecovery()
    end
    return false, reason
  end
  if fence ~= nil and not recordedFence then return noRecovery() end
  if type(evidence.inspect) ~= "function" then return false, "evidence inspection unavailable" end
  local _, inspectReason, control, controlPresent = evidence.inspect(nil,
    { namespace = namespace, allowStoredGrid = true })
  if type(control) ~= "table" then return false, inspectReason end
  local transactionId, recordId
  if fence ~= nil then
    if fence.namespace ~= namespace then
      return recoveryError("foreign recorded Add fence",
        fence.transactionId, nil, true)
    end
    transactionId, recordId = fence.transactionId, fence.recordId
    if not recordId then
      local recovery; recovery, reason = evidence.claimRecoveryStatus(
        namespace, transactionId, digest(snapshot.value))
      if not recovery then return recoveryError(reason, transactionId) end
      local claim = recovery.intent and recovery.intent.claims and recovery.intent.claims[1]
      recordId = claim and claim.recordId
      if recovery.state == "MISSING" then
        if control.pendingClaim ~= nil then
          return recoveryError("orphan Add fence has pending claim",
            transactionId, nil, true)
        end
        if fence.beforeDigest ~= digest(logical(snapshot.value)) then
          return recoveryError("orphan Add fence digest mismatch",
            transactionId, nil, true)
        end
        local cleared, clearReason = store.saveRawSnapshot(snapshot,
          logical(snapshot.value), nil, "identity_record_add_orphan_clear",
          { identityTransactionId = transactionId })
        if not cleared then
          return recoveryError(clearReason, transactionId)
        end
        return true, nil, { action = "recorded_add_orphan_fence_cleared",
          transactionId = transactionId }
      end
    end
  else
    transactionId = control.pendingClaim
    if type(transactionId) ~= "string" or not transactionId:match("^ria%-") then
      return noRecovery()
    end
    local recovery; recovery, reason = evidence.claimRecoveryStatus(
      namespace, transactionId, digest(snapshot.value))
    if not recovery then return recoveryError(reason, transactionId) end
    local claim = recovery.intent and recovery.intent.claims and recovery.intent.claims[1]
    recordId = claim and claim.recordId
  end
  if type(recordId) ~= "string" then
    return recoveryError("recorded Add lacks exact record ID",
      transactionId, nil, true)
  end
  local grid = options.gridAddress
  if type(grid) ~= "string" or grid == "" then
    grid = controlPresent == true and control.gridAddress or nil
  end
  if type(grid) ~= "string" or grid == "" then
    return recoveryError("recorded Add lacks durable grid authority",
      transactionId, recordId, true)
  end
  local runOptions = clone(options); runOptions.gridAddress = grid
  local ok, runReason, receipt = add.run(
    require("oc.ae2.workflow_identity_reconcile"), recordId, runOptions)
  if ok then
    return true, nil, { action = "recorded_add_recovered",
      transactionId = transactionId, recordId = recordId, receipt = receipt }
  end
  return recoveryError("recorded Add recovery pending: " .. tostring(runReason),
    transactionId, recordId)
end

return add
-- Namespace-fenced, memory-bounded evidence reads for workflow consumers.
-- Selected work resolves one exact row/record triple; every Fleet invocation
-- reads exactly one deterministic page and returns its continuation cursor.
local evidence = require("oc.ae2.identity_evidence")
local workflowId = require("oc.ae2.workflow_id")

local paging = { limit = 32 }

local function gridAddress(options)
  if type(options.gridAddress) == "string" and options.gridAddress ~= "" then
    return options.gridAddress
  end
  local ok, adapter = pcall(require, "oc.ae2.adapter")
  if not ok or type(adapter) ~= "table" or type(adapter.primary) ~= "function" then
    return nil, "current AE2 grid authority is unavailable"
  end
  local node, reason = adapter.primary()
  if type(node) ~= "table" or type(node.address) ~= "string" or node.address == "" then
    return nil, reason or "current AE2 grid address is unavailable"
  end
  return node.address
end

local function namespaceFor(config)
  local namespace, reason = workflowId.authority(config)
  if not namespace then return nil, reason end
  return namespace
end

local function selected(config, options, namespace, grid)
  local index = tonumber(options.configIndex)
  index = index and index >= 1 and index == math.floor(index) and index or nil
  local recordId = options.recordId
  if not index or type(recordId) ~= "string" then
    return false, "selected reconciliation requires configIndex and recordId"
  end
  local row = type(config.workflows) == "table" and config.workflows[index] or nil
  if type(row) ~= "table" or not workflowId.valid(row.workflowId) then
    return false, "selected reconciliation workflow row is missing or has no stable ID"
  end
  if options.workflowId ~= nil and options.workflowId ~= row.workflowId then
    return false, "selected reconciliation workflowId does not match its config row"
  end
  local record, reason = evidence.get(recordId, { namespace = namespace,
    gridAddress = grid, targetWorkflowId = row.workflowId, targetConfigIndex = index })
  if not record then return false, reason end
  local association = type(record.association) == "table" and record.association or {}
  if association.namespace ~= namespace then return false, "selected evidence namespace changed" end
  if workflowId.valid(association.workflowId) and association.workflowId ~= row.workflowId then
    return false, "selected evidence was observed for another workflowId"
  end
  if tonumber(association.configIndex) and tonumber(association.configIndex) ~= index then
    return false, "selected evidence was observed for another config row"
  end
  if record.claimed == true and (record.workflowId ~= row.workflowId
      or tonumber(record.configIndex) ~= index) then
    return false, "selected evidence is claimed by another exact workflow row"
  end
  local control, controlReason = evidence.control(namespace)
  if not control then return false, controlReason end
  local capture = type(control.capture) == "table" and control.capture or {}
  local captureScoped = capture.active ~= true and capture.status == "CONSUMED"
    and capture.causal == true
    and capture.recordId == recordId and capture.workflowId == row.workflowId
    and tonumber(capture.configIndex) == index
  record.captureScoped = captureScoped or nil
  return true, nil, { namespace = namespace, workflowNamespace = namespace,
    gridAddress = grid, generation = control.generation, records = { record }, count = 1,
    batchCount = 1, deferredCount = 0, cursor = nil, nextCursor = nil,
    selected = { workflowId = row.workflowId, configIndex = index, recordId = recordId,
      captureScoped = captureScoped or nil },
    health = control.health }
end

local function readPage(namespace, options, cursor)
  local ok, reason, report = evidence.page({ namespace = namespace,
    gridAddress = options.gridAddress,
    cursor = cursor, limit = math.min(paging.limit, tonumber(options.limit) or paging.limit),
    kind = options.kind, ownership = options.ownership, claimed = options.claimed })
  if not ok then return false, reason end
  report.cursor, report.batchCount = cursor, tonumber(report.count) or #(report.records or {})
  return true, nil, report
end

function paging.load(config, options)
  options = type(options) == "table" and options or {}
  local namespace, reason = namespaceFor(config)
  if not namespace then return false, reason end
  local grid
  grid, reason = gridAddress(options)
  if not grid then return false, reason end
  options.gridAddress = grid
  local selectedRequested = options.configIndex ~= nil or options.recordId ~= nil
    or options.workflowId ~= nil
  if selectedRequested then return selected(config, options, namespace, grid) end
  local ok, pageReason, report = readPage(namespace, options, options.cursor)
  if not ok then return false, pageReason end
  report.namespace, report.workflowNamespace = namespace, namespace
  report.gridAddress = grid
  report.deferredCount = math.max(0, math.floor(tonumber(options.deferredCount) or 0))
  report.selected = nil
  return true, nil, report
end

function paging.namespace(config) return namespaceFor(config) end

return paging
local adapter = require("oc.ae2.adapter")
local binding = require("oc.ae2.request_binding")
local computer = require("computer")
local evidence = require("oc.ae2.identity_evidence")
local commissioningConfig = require("oc.ae2.maintainer_commissioning_config")
local match = require("oc.ae2.request_match")
local requestCpu = require("oc.ae2.request_cpu")
local requester = require("oc.ae2.requester")
local requestTracker = require("oc.ae2.request_tracker")
local probeAuthority = require("oc.ae2.workflow_fluid_identity_probe_authority")
local workflowId = require("oc.ae2.workflow_id")
local workflowModel = require("oc.ae2.workflow_model")
local witness = require("oc.ae2.maintainer_cpu_witness")

local probe = {}
local sessions = {}
local OUTPUT_SETTLE_SECONDS = 10
local RECOVERY_SETTLE_SECONDS = 120
local RECOVERY_HARD_SECONDS = 480
local FINALIZE_HARD_SECONDS = 300

local function selectedOutputs(summary, cpuName)
  local outputs = witness.activeOutputs(summary)
  local selected = {}
  for _, output in ipairs(outputs or {}) do
    if output.cpuName == cpuName then selected[#selected + 1] = output end
  end
  return selected
end

local function namedCpuCount(summary, cpuName)
  local count, selected = 0
  for _, row in ipairs(type(summary) == "table" and summary.cpus or {}) do
    if row.name == cpuName then count, selected = count + 1, row end
  end
  return count, selected
end

local function baseline(summary, cpuName)
  local out, seen = {}, {}
  for _, output in ipairs(selectedOutputs(summary, cpuName)) do
    local digest = evidence.key(output)
    if not digest then return nil, "named repair CPU baseline has no stable identity digest" end
    local token = "dg:" .. digest
    if not seen[token] then seen[token], out[#out + 1] = true, token end
  end
  table.sort(out)
  return out
end

local function captureFor(namespace)
  local status, reason = evidence.captureStatus(namespace)
  return status and status.capture or nil, reason, status
end

local function failSession(target, session, reason, retryable, uncertain, recovering)
  local called, saved, saveReason = pcall(evidence.failCausalCapture,
    target.namespace, session.captureId, {
    gridAddress = session.gridAddress, hostAddress = workflowId.currentHost(),
    requestKey = session.requestKey, reason = tostring(reason),
    retryable = retryable == true, uncertain = uncertain == true,
    failedAt = computer.uptime()
  })
  if not called or saved ~= true then
    return false, "causal failure receipt is awaiting durable persistence: "
        .. tostring(called and saveReason or saved),
      { state = (recovering or uncertain) and "RECOVERING" or "FINALIZING", pending = true,
        retryable = true, retryAfter = 2, captureId = session.captureId,
        cpuName = session.cpuName }
  end
  requestTracker.acknowledge(session.requestKey)
  sessions[target.key] = nil
  return false, tostring(reason), { state = recovering and "RECOVERING"
      or retryable and "WAITING_REQUEST" or "BLOCKED",
    pending = recovering == true or nil,
    retryable = retryable == true, retryAfter = retryable and 30 or nil,
    captureId = session.captureId, cpuName = session.cpuName,
    scopeToken = target.scopeToken }
end

local function exhaustRecovery(target, session, reason)
  return failSession(target, session,
    "automatic causal recovery exhausted: " .. tostring(reason),
    false, true, false)
end

local function closeSession(session, reason)
  session.closeReason = session.closeReason or reason
  return failSession(session.target, session, session.closeReason, false, true, false)
end

local function terminalOutput(target, session, primary, summary)
  local primaryReason
  if not primary then primary, primaryReason = adapter.primary() end
  if not primary then return nil, primaryReason, true end
  if primary.address ~= session.gridAddress then
    return nil, "AE2 grid changed during the causal fluid probe", false
  end
  summary = summary or adapter.cpuSummary(primary)
  if type(summary) ~= "table" or type(summary.cpus) ~= "table" then
    return nil, "named CPU finalOutput snapshot is unavailable", true
  end
  local count, cpu = namedCpuCount(summary, session.cpuName)
  if count ~= 1 then
    return nil, "causal repair CPU name is no longer unique", false
  end
  if witness.cpuBusy(cpu) then
    return nil, "named repair CPU accepted other work before output proof", false
  end
  local candidates, prior = {}, probeAuthority.baselineSet(session)
  for _, output in ipairs(selectedOutputs(summary, session.cpuName)) do
    if output.kind == "fluid" and output.isFluid == true and output.hasTag ~= true
        and binding.validFluidName(output.name) and not binding.isLegacyFluidProxyName(output.name)
        and probeAuthority.sameFluidLabel(target.row, output) then
      local digest = evidence.key(output)
      if not digest then
        return nil, "named repair CPU output has no stable identity digest", false
      end
      if not prior["dg:" .. digest] then candidates[#candidates + 1] = output end
    end
  end
  if #candidates == 1 then return candidates[1] end
  if #candidates > 1 then
    return nil, "named repair CPU exposed multiple ordinary nested-fluid outputs", false
  end
  return nil, "AE2FC did not expose one structured ordinary nested fluid on the named repair CPU", true
end

local function retryableTerminal(status)
  local state, phase = tostring(status and status.state or ""),
    tostring(status and status.phase or "")
  return state == "canceled" or (state == "failed" and phase ~= "status_error")
    or (state == "blocked" and phase == "missing_resources")
end

local function finishSession(target, session, recordId, capture)
  requestTracker.acknowledge(session.requestKey)
  sessions[target.key] = nil
  return true, nil, { state = "COMPLETE", completed = true,
    recordId = recordId, capture = capture,
    captureId = session.captureId, cpuName = session.cpuName,
    scopeToken = target.scopeToken }
end

local function finalizing(session, reason)
  return true, nil, { state = "FINALIZING", pending = true,
    reason = tostring(reason), captureId = session.captureId,
    cpuName = session.cpuName }
end

local function waitFinalizing(target, session, reason)
  session.finalizeStartedAt = session.finalizeStartedAt or computer.uptime()
  if computer.uptime() - session.finalizeStartedAt >= FINALIZE_HARD_SECONDS then
    return failSession(target, session,
      "causal evidence finalization reached its five-minute limit: "
        .. tostring(reason), false, true, false)
  end
  return finalizing(session, reason)
end

local function finalizeSession(target, session)
  if not session.recordId then
    local observed, observeReason, receipt = evidence.observe(session.output, {
      source = "causal_fluid_repair", cpuName = session.cpuName,
      phase = "request_done_final_output", workflowNamespace = target.namespace,
      workflowId = target.row.workflowId, configIndex = target.index,
      hostAddress = workflowId.currentHost(), gridAddress = session.gridAddress,
      observedAt = computer.uptime()
    }, { deferCapture = true })
    if not observed or type(receipt) ~= "table" or not receipt.recordId then
      return waitFinalizing(target, session,
        observeReason or "completed causal fluid evidence is awaiting durable persistence")
    end
    session.recordId = receipt.recordId
  end
  local completed, completeReason, report = evidence.completeCausalCapture(
    target.namespace, session.captureId, session.recordId, {
      gridAddress = session.gridAddress, hostAddress = workflowId.currentHost(),
      cpuName = session.cpuName, requestKey = session.requestKey,
      completedAt = computer.uptime()
    })
  if not completed then
    return waitFinalizing(target, session,
      completeReason or "completed causal fluid evidence is awaiting finalization")
  end
  return finishSession(target, session, session.recordId, report)
end

local function uncertainTerminal(status)
  local state, phase = tostring(status and status.state or ""),
    tostring(status and status.phase or "")
  return state == "accepted" or phase == "confirmation_unavailable"
    or phase == "status_link_lost" or phase == "status_error"
end

local function poll(target, session)
  local status = requestTracker.inspect(session.status)
  if status.state == "running" then
    return true, nil, { state = "RUNNING", pending = true,
      captureId = session.captureId, cpuName = session.cpuName }
  end
  if status.state ~= "done" then
    local uncertain = uncertainTerminal(status)
    return failSession(target, session, status.reason
      or ("causal repair request ended in " .. tostring(status.state)),
      retryableTerminal(status), uncertain, uncertain)
  end
  session.doneAt = session.doneAt or computer.uptime()
  local reason, retryable
  if not session.output then
    session.output, reason, retryable = terminalOutput(target, session)
  end
  if not session.output then
    if retryable and computer.uptime() - session.doneAt < OUTPUT_SETTLE_SECONDS then
      return true, nil, { state = "VERIFYING", pending = true,
        reason = reason, captureId = session.captureId, cpuName = session.cpuName }
    end
    return failSession(target, session, reason, false, true, false)
  end
  return finalizeSession(target, session)
end

local function recover(target, prior, captureStatus, recoveryOnly)
  local gridAddress = captureStatus and captureStatus.gridAddress
  if type(gridAddress) ~= "string" or gridAddress == "" then
    return false, "causal recovery has no durable AE2 grid fence",
      { state = "BLOCKED", retryable = false, captureId = prior.captureId,
        scopeToken = target.scopeToken }
  end
  local recovered, recoveryReason, recovery = evidence.beginCausalCaptureRecovery(
    target.namespace, prior.captureId, {
      gridAddress = gridAddress, hostAddress = workflowId.currentHost(),
      cpuName = prior.cpuName, requestKey = prior.requestKey,
      workflowId = target.row.workflowId, configIndex = target.index,
      recoveredAt = computer.uptime(),
      recoveryBootId = commissioningConfig.bootId()
    })
  if not recovered or type(recovery) ~= "table" or type(recovery.capture) ~= "table" then
    local stamp = computer.uptime()
    local anchor = tonumber(prior.recoveryStartedAt or prior.submittedAt)
    local elapsed = anchor and stamp - anchor or RECOVERY_HARD_SECONDS
    if elapsed < 0 then elapsed = RECOVERY_HARD_SECONDS end
    if tostring(recoveryReason):find("recovery is exhausted", 1, true)
        or tostring(recoveryReason):find("boot changed", 1, true)
        or elapsed >= RECOVERY_HARD_SECONDS then
      return exhaustRecovery(target, { captureId = prior.captureId,
        cpuName = prior.cpuName, requestKey = prior.requestKey,
        gridAddress = gridAddress },
        recoveryReason or "durable recovery could not be opened")
    end
    return false, recoveryReason or "causal fluid recovery receipt is unavailable",
      { state = "RECOVERING", pending = true, retryAfter = 2,
        captureId = prior.captureId }
  end
  local durable = recovery.capture
  local session = probeAuthority.recoverySession(target, durable, recovery)
  sessions[target.key] = session
  local deadline = probeAuthority.sessionDeadline(session, recoveryOnly, computer.uptime())
  if deadline then return exhaustRecovery(target, session, deadline) end
  return session
end

local function pollRecovery(target, session)
  local elapsed = computer.uptime() - tonumber(session.recoveryStartedAt or 0)
  if elapsed >= RECOVERY_HARD_SECONDS then
    return exhaustRecovery(target, session,
      "causal fluid recovery reached its eight-minute hard limit")
  end
  local primary, primaryReason = adapter.primary()
  if not primary then
    return false, primaryReason, { state = "RECOVERING", pending = true,
      retryAfter = 2, captureId = session.captureId }
  end
  if primary.address ~= session.gridAddress then
    return exhaustRecovery(target, session,
      "AE2 grid changed during causal fluid recovery")
  end
  local summary, summaryReason = adapter.cpuSummary(primary)
  if type(summary) ~= "table" or type(summary.cpus) ~= "table" then
    return false, summaryReason or "named CPU recovery snapshot is unavailable",
      { state = "RECOVERING", pending = true, retryAfter = 2,
        captureId = session.captureId }
  end
  local count, cpu = namedCpuCount(summary, session.cpuName)
  if count > 1 then
    return exhaustRecovery(target, session,
      "causal repair CPU name is no longer unique")
  end
  if count == 1 and witness.cpuBusy(cpu) then
    if session.busyPersisted ~= true then
      local saved, saveReason = probeAuthority.persistRecoveryBusy(target, session)
      if not saved then
        return false, saveReason, { state = "RECOVERING", pending = true,
          retryAfter = 2, captureId = session.captureId }
      end
    end
    return true, nil, { state = "RECOVERING", pending = true,
      reason = "named causal repair CPU is still crafting",
      captureId = session.captureId, cpuName = session.cpuName }
  end
  if session.sawBusy == true then
    if session.busyPersisted ~= true then
      local saved, saveReason = probeAuthority.persistRecoveryBusy(target, session)
      if not saved then
        return false, saveReason, { state = "RECOVERING", pending = true,
          retryAfter = 2, captureId = session.captureId }
      end
    end
    return exhaustRecovery(target, session,
      "busy-to-idle CPU transition cannot prove the original request output")
  end
  local output, reason, retryable = terminalOutput(target, session, primary, summary)
  if output then session.output = output; return finalizeSession(target, session) end
  if retryable and elapsed < RECOVERY_SETTLE_SECONDS then
    return true, nil, { state = "RECOVERING", pending = true, reason = reason,
      captureId = session.captureId, cpuName = session.cpuName }
  end
  return exhaustRecovery(target, session, reason)
end

local function start(target, options)
  local primary, primaryReason = adapter.primary()
  if not primary then return false, primaryReason, { retryable = true, state = "WAITING_AE2" } end
  local cpuName, _, summary = requestCpu.pick(primary,
    { minCpuStorage = 1, preferEmptyFinalOutput = true })
  if not cpuName then
    return false, "waiting for one named ready AE2 crafting CPU",
      { retryable = true, state = "WAITING_CPU" }
  end
  if namedCpuCount(summary, cpuName) ~= 1 then
    return false, "waiting for one uniquely named ready AE2 crafting CPU",
      { retryable = true, state = "WAITING_CPU" }
  end
  local current,currentReason,captureStatus = captureFor(target.namespace)
  if currentReason then return probeAuthority.captureFailure(currentReason) end
  local stale = probeAuthority.stale(target, current, options.recoveryOnly)
  if stale then return stale.ok, stale.reason, stale.report end
  if type(current) == "table" and current.active == true
      and (current.workflowId ~= target.row.workflowId
        or tonumber(current.configIndex) ~= target.index) then
    return false, "another exact identity capture currently owns the observer",
      { retryable = true, state = "WAITING_CAPTURE" }
  end
  local outputBaseline, baselineReason = baseline(summary or {}, cpuName)
  if not outputBaseline then
    return false, baselineReason, { retryable = false, state = "BLOCKED" }
  end
  local refreshed, refreshReason, refreshedStatus, terminal = probeAuthority.refresh(target)
  if refreshReason then return probeAuthority.captureFailure(refreshReason) end
  if terminal then return terminal.ok, terminal.reason, terminal.report end
  stale = probeAuthority.stale(target, refreshed, options.recoveryOnly)
  if stale then return stale.ok, stale.reason, stale.report end
  current, captureStatus = refreshed, refreshedStatus
  local retireUnverified = probeAuthority.retireUnverified(target, current)
  local requested, requestReason, captureReport = evidence.requestCapture(computer.uptime(), {
    workflowNamespace = target.namespace, workflowId = target.row.workflowId,
    configIndex = target.index, gridAddress = primary.address,
    hostAddress = workflowId.currentHost(), baseline = outputBaseline,
    labelQuery = match.tidyLabel(target.row.label or target.row.rawLabel),
    causal = true, cpuName = cpuName, scopeToken = target.scopeToken,
    expectedCaptureId = type(current) == "table" and current.captureId or nil,
    expectedCaptureStatus = type(current) == "table" and current.status or nil,
    expectedGeneration = captureStatus and captureStatus.generation or nil,
    replaceTerminal = type(current) == "table" and current.active ~= true
      and (current.status ~= "UNVERIFIED" or retireUnverified) or nil,
    retireUnverified = retireUnverified or nil
  })
  local capture = type(captureReport) == "table" and captureReport.capture or nil
  if not requested or type(capture) ~= "table" or capture.causal ~= true then
    return false, requestReason or "causal fluid capture could not be armed",
      { retryable = true, state = "WAITING_CAPTURE" }
  end
  stale = probeAuthority.stale(target, capture, options.recoveryOnly)
  if stale then return stale.ok, stale.reason, stale.report end
  terminal = probeAuthority.terminal(target, capture)
  if terminal then return terminal.ok, terminal.reason, terminal.report end
  if captureReport.action ~= "identity_capture_armed" then
    return false, "another automatic worker owns the causal fluid probe",
      { retryable = true, state = "RECOVERING", captureId = capture.captureId }
  end
  local requestKey = "fluid-probe-" .. tostring(capture.captureId)
  local submittedAt = computer.uptime()
  local invokeIntentPersisted = false
  local status, submitReason, submitReport = requester.requestTarget(target.row, 1, {
    prioritizePower = true, requireCpu = true, cpuName = cpuName, maxInFlight = 64,
    craftCompatibility = workflowModel.craftCompatibility(target.config),
    commissioningCapability = probeAuthority.capability(options.commissioningSerial,
      target, capture, requestKey, cpuName, primary.address),
    beforeInvoke = function()
      local ok, reason = evidence.markCausalCaptureSubmitted(
        target.namespace, capture.captureId, {
          gridAddress = primary.address, hostAddress = workflowId.currentHost(),
          cpuName = cpuName, requestKey = requestKey, submittedAt = submittedAt
        })
      invokeIntentPersisted = ok == true
      return ok == true, reason
    end,
    track = { id = requestKey, amount = 1, submittedAt = submittedAt,
      label = target.row.label, source = "fluid_identity_probe", target = target.row }
  })
  if not status then
    submitReport = type(submitReport) == "table" and submitReport or {}
    local phase = tostring(submitReport.requestPhase or "")
    local definitive = not invokeIntentPersisted
      or submitReport.requestAttempted == false
      or submitReport.requestOutcomeDefinitive == true
      or phase == "missing_resources" or phase == "failed" or phase == "canceled"
    local closed, closeReason = evidence.failCausalCapture(target.namespace, capture.captureId, {
      gridAddress = primary.address, hostAddress = workflowId.currentHost(),
      requestKey = requestKey, reason = submitReason or "causal request failed",
      retryable = definitive, uncertain = not definitive, failedAt = computer.uptime()
    })
    if not closed then
      return false, closeReason or submitReason, { pending = true, retryAfter = 2,
        state = "RECOVERING", captureId = capture.captureId }
    end
    return false, submitReason or "causal fluid repair request failed",
      { retryable = definitive, pending = not definitive or nil,
        retryAfter = definitive and 30 or 2,
        state = definitive and "WAITING_REQUEST" or "RECOVERING",
        request = submitReport }
  end
  local session = { status = status, captureId = capture.captureId,
    requestKey = requestKey, cpuName = cpuName, gridAddress = primary.address,
    submittedAt = submittedAt, baseline = outputBaseline,
    target = probeAuthority.freezeTarget(target) }
  sessions[target.key] = session
  return poll(target, session)
end

local function noRequest()
  return true, nil, { state = "COMPLETE", completed = true, noRequest = true }
end

local function run(options)
  options = type(options) == "table" and options or {}
  local session = sessions[probeAuthority.optionKey(options)]
  local deadline = session and probeAuthority.sessionDeadline(
    session, options.recoveryOnly, computer.uptime())
  if deadline then return exhaustRecovery(session.target, session, deadline) end
  if session and session.closeReason then return closeSession(session) end
  local target, reason, transient = probeAuthority.loadTarget(options)
  if not target then
    if session then
      if transient then
        return false, reason, { state = "RECOVERING", pending = true,
          retryable = true, retryAfter = 2, captureId = session.captureId }
      end
      return closeSession(session, "causal scope changed: " .. tostring(reason))
    end
    return false, reason, { retryable = transient == true,
      pending = transient == true or nil,
      state = transient and "RECOVERING" or "BLOCKED" }
  end
  session = session or sessions[target.key]
  if session then
    if not probeAuthority.sameTarget(session.target, target) then
      return closeSession(session, "causal scope changed")
    end
    if session.recovering then return pollRecovery(session.target, session) end
    return poll(session.target, session)
  end
  local capture, captureReason, captureStatus = captureFor(target.namespace)
  if captureReason then return probeAuthority.captureFailure(captureReason) end
  local stale = probeAuthority.stale(target, capture, options.recoveryOnly)
  if stale then return stale.ok, stale.reason, stale.report end
  if probeAuthority.captureExact(target, capture) then
    if capture.status == "CONSUMED" and capture.recordId then
      return true, nil, { state = "COMPLETE", completed = true,
        recordId = capture.recordId, captureId = capture.captureId,
        scopeToken = target.scopeToken }
    end
    if capture.status == "FAILED" then
      if capture.retryable == true and options.recoveryOnly ~= true then
        return start(target, options)
      end
      if capture.retryable == true then return noRequest() end
      return false, capture.reason or "prior causal fluid probe failed",
        { retryable = false, state = "BLOCKED", captureId = capture.captureId,
          scopeToken = target.scopeToken }
    end
    if capture.status == "UNVERIFIED"
        or (capture.active == true and capture.status == "SUBMITTED") then
      local recovered, recoverReason, recoverReport = recover(target, capture,
        captureStatus, options.recoveryOnly)
      if type(recovered) == "table" then return pollRecovery(target, recovered) end
      return recovered, recoverReason, recoverReport
    end
    if capture.active == true then
      if capture.status == "ARMED" then
        return failSession(target, { captureId = capture.captureId,
          requestKey = capture.requestKey, cpuName = capture.cpuName,
          gridAddress = captureStatus.gridAddress },
          "causal probe was never submitted",
          options.recoveryOnly ~= true, false, false)
      end
      return false, "recovering the prior CPU-bound fluid probe until its bounded receipt expires",
        { retryable = true, state = "RECOVERING", captureId = capture.captureId }
    end
  end
  if options.recoveryOnly == true then return noRequest() end
  return start(target, options)
end

function probe.run(options)
  local called, ok, reason, report = pcall(run, options)
  if called then return ok, reason, report end
  local session = sessions[probeAuthority.optionKey(options)]
  return false, "causal probe call failed; retrying: " .. tostring(ok),
    { state = "RECOVERING", pending = true, retryable = true, retryAfter = 2,
      captureId = session and session.captureId or nil }
end

function probe.clearSessions() sessions = {} end

return probe
-- Small pure/runtime helpers kept outside the probe worker's OpenOS parser cap.
local evidence = require("oc.ae2.identity_evidence")
local binding = require("oc.ae2.request_binding")
local match = require("oc.ae2.request_match")
local store = require("oc.ae2.workflow_store")
local workflowId = require("oc.ae2.workflow_id")

local authority = {}

local function keyFor(row, index)
  return tostring(row.workflowId) .. ":" .. tostring(index)
end

function authority.optionKey(options)
  local index = tonumber(type(options) == "table" and options.configIndex)
  local id = type(options) == "table" and options.workflowId
  if type(id) ~= "string" or not index or index ~= math.floor(index) then return nil end
  return keyFor({ workflowId = id }, index)
end

function authority.loadTarget(options)
  options = type(options) == "table" and options or {}
  local called, snapshot, reason = pcall(store.rawSnapshot)
  if not called then return nil, "workflow policy read failed: " .. tostring(snapshot), true end
  if not snapshot then return nil, reason, true end
  local config = snapshot.value
  local index = tonumber(options.configIndex)
  index = index and math.floor(index) or nil
  local row = index and type(config.workflows) == "table" and config.workflows[index] or nil
  if type(row) ~= "table" or not workflowId.valid(row.workflowId) then
    return nil, "automatic fluid repair target is missing or has no stable workflow ID", false
  end
  if options.workflowId ~= nil and options.workflowId ~= row.workflowId then
    return nil, "automatic fluid repair target changed", false
  end
  if not binding.isTaggedLegacyFluidProxy(row) or type(row.craftBinding) ~= "table" then
    return nil, "automatic fluid repair requires the exact requestable AE2FC wrapper row", false
  end
  local namespace, namespaceReason = workflowId.authority(config)
  if not namespace then return nil, namespaceReason, true end
  local scopeToken = options.repairScopeToken
  if scopeToken ~= nil and (type(scopeToken) ~= "string"
      or scopeToken == "" or #scopeToken > 96) then
    return nil, "automatic fluid repair scope token is malformed", false
  end
  return { config = config, row = row, index = index, namespace = namespace,
    key = keyFor(row, index), scopeToken = scopeToken,
    commissioningSerial = tonumber(options.commissioningSerial) }, nil, false
end

local function copyRow(row)
  local marker = type(row.craftBinding) == "table" and row.craftBinding or {}
  return { workflowId = row.workflowId, label = row.label, rawLabel = row.rawLabel,
    name = row.name, damage = row.damage, hasTag = row.hasTag,
    craftBinding = { mode = marker.mode, name = marker.name, damage = marker.damage,
      label = marker.label, rawLabel = marker.rawLabel } }
end

function authority.freezeTarget(target)
  return { config = target.config, row = copyRow(target.row), index = target.index,
    namespace = target.namespace, key = target.key, scopeToken = target.scopeToken,
    commissioningSerial = target.commissioningSerial }
end

function authority.recoverySession(target, durable, recovery)
  return { captureId = durable.captureId, requestKey = durable.requestKey,
    cpuName = durable.cpuName, gridAddress = recovery.gridAddress,
    baseline = durable.baseline, submittedAt = durable.submittedAt,
    recoveryStartedAt = durable.recoveryStartedAt,
    sawBusy = durable.recoverySawBusy == true,
    busyPersisted = durable.recoverySawBusy == true, recovering = true,
    target = authority.freezeTarget(target) }
end

function authority.sameTarget(prior, current)
  if type(prior) ~= "table" or type(current) ~= "table"
      or prior.namespace ~= current.namespace or prior.index ~= current.index
      or prior.scopeToken ~= current.scopeToken then return false end
  local a, b = prior.row or {}, current.row or {}
  local am, bm = a.craftBinding or {}, b.craftBinding or {}
  return a.workflowId == b.workflowId and a.label == b.label and a.rawLabel == b.rawLabel
    and a.name == b.name and tonumber(a.damage) == tonumber(b.damage)
    and (a.hasTag == true) == (b.hasTag == true) and am.mode == bm.mode
    and am.name == bm.name and tonumber(am.damage) == tonumber(bm.damage)
    and am.label == bm.label and am.rawLabel == bm.rawLabel
end

function authority.captureFailure(reason)
  local detail = tostring(reason or "identity capture authority is unavailable")
  local terminal = detail:find("malformed", 1, true)
    or detail:find("does not match", 1, true) or detail:find("fence", 1, true)
    or detail:find("ambiguous", 1, true) or detail:find("CPU activity", 1, true)
  return false, detail, { retryable = not terminal,
    state = terminal and "BLOCKED" or "WAITING_CAPTURE" }
end

local function labelKey(value)
  local text = match.plainLabel(match.tidyLabel(value)):lower()
  return text:gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
end

function authority.sameFluidLabel(row, output)
  local wanted = {}
  local function remember(value)
    if value == nil then return end
    local key = labelKey(value)
    if key ~= "" then wanted[key] = true end
  end
  remember(row.label)
  remember(row.rawLabel)
  return output and ((output.label ~= nil and wanted[labelKey(output.label)] == true)
    or (output.rawLabel ~= nil and wanted[labelKey(output.rawLabel)] == true)) or false
end

function authority.baselineSet(session)
  local out = {}
  for _, token in ipairs(type(session.baseline) == "table" and session.baseline or {}) do
    out[token] = true
  end
  return out
end

function authority.captureExact(target, capture)
  return type(capture) == "table" and capture.causal == true
    and capture.workflowId == target.row.workflowId
    and tonumber(capture.configIndex) == target.index
    and capture.scopeToken == target.scopeToken
end

function authority.retireUnverified(target, capture)
  if type(capture) ~= "table" or capture.active == true
      or capture.status ~= "UNVERIFIED" then return false end
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  if not loaded or type(daemonConfig.load) ~= "function" then return false end
  local called, cfg = pcall(daemonConfig.load)
  if type(cfg) ~= "table" or cfg.commissioningState ~= "repair_probe"
      or tonumber(cfg.commissioningSerial) ~= target.commissioningSerial
      or tonumber(cfg.commissioningRepairIndex) ~= target.index
      or cfg.commissioningRepairWorkflowId ~= target.row.workflowId
      or cfg.commissioningRepairScopeToken ~= target.scopeToken then return false end
  local ok, quarantine = pcall(require, "oc.ae2.fluid_stock_quarantine")
  local view = ok and quarantine.view(target.config, cfg) or nil
  local index = tonumber(capture.configIndex)
  local row = index and target.config.workflows[index] or nil
  return type(view) == "table" and view.rows[index] == true
    and type(row) == "table" and row.workflowId == capture.workflowId
end

function authority.terminal(target, capture)
  local exact = authority.captureExact(target, capture)
  if exact and capture.status == "CONSUMED" and capture.recordId then
    return { ok = true, report = { state = "COMPLETE", completed = true,
      recordId = capture.recordId, captureId = capture.captureId,
      scopeToken = target.scopeToken } }
  end
  if exact and capture.status == "FAILED" and capture.retryable ~= true then
    return { ok = false,
      reason = capture.reason or "prior causal fluid probe failed",
      report = { retryable = false, state = "BLOCKED", captureId = capture.captureId,
        scopeToken = target.scopeToken } }
  end
end

function authority.stale(target, capture, recoveryOnly)
  if type(capture) ~= "table" or capture.causal ~= true
      or authority.captureExact(target, capture) then return nil end
  local retired = authority.retireUnverified(target, capture)
  if recoveryOnly == true then
    return { ok = false, reason = "foreign evidence cannot authorize the expired repair scope",
      report = { retryable = false, state = "BLOCKED", scopeOnly = true,
        foreignCaptureId = capture.captureId, scopeToken = target.scopeToken } }
  end
  if capture.active ~= true and capture.status ~= "UNVERIFIED" then return nil end
  if retired then return nil end
  return { ok = false, reason = "a prior causal scope is still recovering",
    report = { retryable = true, pending = true, retryAfter = 2,
      state = "WAITING_CAPTURE", foreignCaptureId = capture.captureId,
      scopeToken = target.scopeToken } }
end

function authority.refresh(target)
  local status, reason = evidence.captureStatus(target.namespace)
  local capture = type(status) == "table" and status.capture or nil
  if reason then return nil, reason, status end
  local terminal = authority.terminal(target, capture)
  if terminal then return capture, nil, status, terminal end
  return capture, nil, status
end

function authority.capability(serial, target, capture, requestKey, cpuName, gridAddress)
  if serial == nil then return nil end
  return { contract = "commissioning_causal_probe_v1", serial = serial,
    namespace = target.namespace, captureId = capture.captureId, requestKey = requestKey,
    cpuName = cpuName, workflowId = target.row.workflowId, configIndex = target.index,
    gridAddress = gridAddress, scopeToken = target.scopeToken }
end

function authority.persistRecoveryBusy(target, session)
  session.sawBusy = true
  if session.busyPersisted == true then return true end
  local saved, reason = evidence.markCausalCaptureRecoveryBusy(
    target.namespace, session.captureId, {
      gridAddress = session.gridAddress, hostAddress = workflowId.currentHost(),
      cpuName = session.cpuName, requestKey = session.requestKey,
      workflowId = target.row.workflowId, configIndex = target.index
    })
  if saved then session.busyPersisted = true end
  return saved, reason
end

function authority.sessionDeadline(session, recoveryOnly, current)
  if recoveryOnly == true then
    return "commissioning epoch reached its recovery-only boundary"
  end
  local anchor = tonumber(session and (session.recoveryStartedAt or session.submittedAt))
  current = tonumber(current)
  if not anchor or not current or current < anchor or current - anchor >= 480 then
    return "causal fluid probe reached its eight-minute hard limit"
  end
end

return authority
-- One bounded Fleet preparation step. Cross-page owner decisions and the
-- rolling corpus seal are returned as a durable continuation; no invocation
-- reads more than one <=32-record evidence page.
local evidence = require("oc.ae2.identity_evidence")
local receipt = require("oc.ae2.maintainer_reconcile_receipt")
local pages = require("oc.ae2.workflow_identity_evidence")
local workflowId = require("oc.ae2.workflow_id")

local fleet = {}
local countKeys = { "repairable", "probeReady", "blocked", "ambiguous", "observed" }

local function clone(value)
  local out = {}; for key, nested in pairs(type(value) == "table" and value or {}) do
    if type(nested) == "table" then
      out[key] = {}; for inner, item in pairs(nested) do out[key][inner] = item end
    else out[key] = nested end
  end
  return out
end

local function owner(record)
  local association = type(record.association) == "table" and record.association or {}
  return workflowId.valid(record.workflowId) and record.workflowId
    or workflowId.valid(association.workflowId) and association.workflowId or nil
end

local function terminalCounts(planner, config, state)
  for index, row in ipairs(config.workflows or {}) do
    local plan = planner.previewConfig(config, { configIndex = index,
      evidence = {}, requireEvidence = true })
    if plan.state == planner.states.VALID then state.counts.valid = state.counts.valid + 1
    elseif not state.ownerPlans[row.workflowId] then
      state.counts.deferred = state.counts.deferred + 1
    end
  end
end

function fleet.step(planner, config, options, prior)
  options, prior = type(options) == "table" and options or {},
    type(prior) == "table" and prior or {}
  if type(options.policyDigest) ~= "string" then
    return false, "Fleet preparation requires the current workflow policy digest"
  end
  if next(prior) ~= nil then
    local compact = receipt.compactPreparation(prior)
    if not compact then return false, "durable Fleet preparation receipt is malformed; restart preview" end
    prior = compact
    if prior.policyDigest ~= options.policyDigest then
      return false, "workflow policy changed during Fleet preparation; restart preview", { restart = true }
    end
    if prior.addObserved ~= (options.addObserved ~= false) then
      return false, "Fleet add-recorded policy changed during preparation; restart preview", { restart = true }
    end
  end
  if prior.phase == "sealed" then
    return true, nil, { preparing = false, sealed = true,
      preparation = clone(prior), counts = clone(prior.counts),
      sealDigest = prior.sealDigest, totalEvidence = prior.totalEvidence }
  end
  local state = {
    phase = "scanning", cursor = prior.cursor, generation = prior.generation,
    gridAddress = prior.gridAddress or options.gridAddress,
    namespace = prior.namespace, policyDigest = options.policyDigest,
    addObserved = options.addObserved ~= false,
    sealDigest = prior.sealDigest or evidence.digestText("fleet-v2"),
    totalEvidence = tonumber(prior.totalEvidence) or 0,
    ownerPlans = clone(prior.ownerPlans), counts = clone(prior.counts)
  }
  state.counts.total = state.counts.total or #(config.workflows or {})
  for _, key in ipairs({ "valid", "repairable", "repaired", "probeReady", "blocked",
      "ambiguous", "deferred", "observed", "added" }) do
    state.counts[key] = tonumber(state.counts[key]) or 0
  end
  local ok, reason, page = pages.load(config, { cursor = state.cursor,
    limit = pages.limit, gridAddress = state.gridAddress })
  if not ok then return false, reason end
  state.gridAddress = page.gridAddress
  state.namespace = state.namespace or page.namespace
  if state.namespace ~= page.namespace then
    return false, "workflow namespace changed during Fleet preparation; restart preview", { restart = true }
  end
  if state.generation == nil then state.generation = page.generation
  elseif tonumber(state.generation) ~= tonumber(page.generation) then
    return false, "identity evidence changed during Fleet preparation; restart preview",
      { restart = true }
  end
  for _, record in ipairs(page.records or {}) do
    local identityDigest, identityReason = evidence.key(record)
    if not identityDigest then return false, identityReason end
    local workflow = owner(record)
    state.sealDigest = evidence.digestText(table.concat({ state.sealDigest,
      record.recordId, identityDigest, tostring(workflow or "") }, "|"))
    state.totalEvidence = state.totalEvidence + 1
    if workflow then
      local existing = state.ownerPlans[workflow]
      if existing and (existing.recordId ~= record.recordId
          or existing.identityDigest ~= identityDigest) then
        state.counts.ambiguous = state.counts.ambiguous + 1
        return false, "Fleet evidence conflicts across pages for " .. workflow, {
          state = "AMBIGUOUS", counts = state.counts, preparation = state }
      end
      if not existing then
        local ownerCount = 0; for _ in pairs(state.ownerPlans) do ownerCount = ownerCount + 1 end
        if ownerCount >= receipt.maxOwners then
          return false, "Fleet owner decision map exceeds the safe "
            .. tostring(receipt.maxOwners) .. "-workflow limit"
        end
        state.ownerPlans[workflow] = { recordId = record.recordId,
          identityDigest = identityDigest }
      end
    end
  end
  local _, pageReport = planner.reconcileAllConfig(config, page.records, {
    preview = true, requireEvidence = true, fleetPage = true,
    addObserved = options.addObserved ~= false
  })
  for _, key in ipairs(countKeys) do
    state.counts[key] = state.counts[key] + (tonumber(pageReport.counts[key]) or 0)
  end
  if page.nextCursor then
    if state.cursor and page.nextCursor <= state.cursor then
      return false, "Fleet evidence cursor did not advance monotonically"
    end
    state.cursor = page.nextCursor
    return true, nil, { preparing = true, sealed = false, preparation = state,
      counts = state.counts, processed = state.totalEvidence,
      nextCursor = state.cursor, reason = "Fleet preparation has more evidence pages" }
  end
  terminalCounts(planner, config, state)
  state.phase, state.cursor = "sealed", nil
  local blocked = state.counts.blocked > 0 or state.counts.ambiguous > 0
  return not blocked, blocked and "Fleet evidence is blocked or ambiguous" or nil, {
    preparing = true, sealed = true, preparation = state, counts = state.counts,
    processed = state.totalEvidence, nextCursor = nil,
    sealDigest = state.sealDigest, totalEvidence = state.totalEvidence,
    state = state.counts.ambiguous > 0 and "AMBIGUOUS"
      or state.counts.blocked > 0 and "BLOCKED"
      or state.counts.probeReady > 0 and "PROBE_READY" or "READY",
    reason = "Fleet evidence seal is complete; refresh once to stage page one" }
end

return fleet
-- Pure identity planning; persistence lives in the transaction module.
local binding = require("oc.ae2.request_binding")
local evidence = require("oc.ae2.identity_evidence")
local modelIdentity = require("oc.ae2.workflow_model_identity")
local workflowId = require("oc.ae2.workflow_id")

local reconcile = {}
reconcile.states = {
  VALID = "VALID", READY = "READY", PROBE_READY = "PROBE_READY",
  AMBIGUOUS = "AMBIGUOUS", BLOCKED = "BLOCKED", MISSING = "MISSING"
}

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}; if seen[value] then return seen[value] end
  local out = {}; seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end

local function labelKey(value)
  local text = tostring(value or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
  return text ~= "" and text or nil
end

local function fluidLabelKey(value)
  local key = labelKey(value)
  if not key then return nil end
  key = key:gsub("^drops?%s+of%s+", "")
  return key ~= "" and key or nil
end

local function sameFluidLabel(row, record)
  local wanted = {}
  local first = fluidLabelKey(row.label); if first then wanted[first] = true end
  local second = fluidLabelKey(row.rawLabel); if second then wanted[second] = true end
  first = fluidLabelKey(record.label); if first and wanted[first] then return true end
  second = fluidLabelKey(record.rawLabel); if second and wanted[second] then return true end
  return false
end

local function identityKey(value)
  local identity = evidence.identity(value)
  if not identity then return nil end
  local variant = identity.hasTag and tostring(identity.rawLabel or identity.label or "") or ""
  return table.concat({ identity.kind, identity.name, tostring(identity.damage or ""),
    identity.hasTag and "1" or "0", variant }, "\31")
end

local function addCandidate(bucket, value, source, recordId)
  local identity = evidence.identity(value)
  if not identity then return end
  if type(value) == "table" and type(value.stockBinding) == "table" then
    local stock = clone(value.stockBinding)
    local candidate = { kind = identity.kind, isFluid = identity.isFluid, name = identity.name,
      label = identity.label, stockBinding = stock }
    if binding.validLegacyFluidStockBinding(candidate) then identity.stockBinding = stock end
  end
  local key = identityKey(identity)
  local found = bucket[key]
  if not found then
    found = { identity = identity, sources = {}, recordIds = {} }
    bucket[key] = found
  elseif identity.authoritative and not found.identity.authoritative then
    found.identity = identity
  end
  if identity.stockBinding and not found.identity.stockBinding then
    found.identity.stockBinding = clone(identity.stockBinding)
  end
  found.sources[source] = true
  if recordId then found.recordIds[recordId] = true end
end

local function listKeys(values)
  local out = {}
  for key in pairs(values or {}) do out[#out + 1] = key end
  table.sort(out)
  return out
end

local function filterMatches(row, identity)
  if row.filter == nil then return true end
  if type(row.filter) ~= "table" then return false end
  for key in pairs(row.filter) do if key ~= "name" and key ~= "damage" then return false end end
  if tostring(row.filter.name or "") ~= tostring(identity.name or "") then return false end
  if identity.kind == "fluid" then return row.filter.damage == nil end
  return tonumber(row.filter.damage) == tonumber(identity.damage)
end

local function declaredIdentity(row)
  local identity = evidence.identity(row)
  if identity and identity.authoritative and binding.error(row) == nil then return identity end
  return nil
end

local function currentIdentity(row)
  local identity = declaredIdentity(row)
  if identity and filterMatches(row, identity) then return identity end
  return nil
end

local function filterIdentity(row)
  local filter = type(row) == "table" and row.filter or nil
  if type(filter) ~= "table" or type(filter.name) ~= "string" or filter.name == "" then return nil end
  for key in pairs(filter) do if key ~= "name" and key ~= "damage" then return nil end end
  local kind
  local tagged = binding.tagged(row.hasTag)
  if filter.damage ~= nil then kind = "item"
  elseif row.kind == "fluid" or row.isFluid == true then kind = "fluid"
  else return nil end
  return evidence.identity({
    kind = kind, isFluid = kind == "fluid", name = filter.name,
    damage = filter.damage, hasTag = tagged, label = row.label, rawLabel = row.rawLabel
  })
end

local function craftBindingIdentity(row)
  local marker = type(row) == "table" and row.craftBinding or nil
  if type(marker) ~= "table" or type(marker.name) ~= "string" then return nil end
  local raw = marker.rawLabel or row.rawLabel or row.label or marker.label
  return evidence.identity({
    kind = "item", isFluid = false, name = marker.name, damage = marker.damage,
    hasTag = true, label = row.label or raw, rawLabel = raw, craftBinding = marker
  })
end

local function stockBindingIdentity(row)
  local marker = type(row) == "table" and row.stockBinding or nil
  if type(marker) ~= "table" or marker.mode ~= binding.legacyFluidStockMode then return nil end
  local candidate = {
    kind = "fluid", isFluid = true, name = marker.fluid, hasTag = false,
    label = row.label or marker.fluid, rawLabel = row.rawLabel or row.label or marker.fluid,
    stockBinding = marker
  }
  if not binding.validLegacyFluidStockBinding(candidate) then return nil end
  local identity = evidence.identity(candidate)
  if identity then identity.stockBinding = clone(marker) end
  return identity
end

local function recordedTaggedIdentity(row)
  if type(row) ~= "table" or not binding.tagged(row.hasTag) then return nil end
  local identity = evidence.identity({
    kind = row.kind, isFluid = row.isFluid, name = row.name, damage = row.damage,
    hasTag = true, label = row.label, rawLabel = row.rawLabel
  })
  return identity and identity.probeReady and identity or nil
end

local function evidenceMatches(record, row, index, config)
  if type(record) ~= "table" then return false end
  local namespace = workflowId.authority(config)
  local association = type(record.association) == "table" and record.association or {}
  if not namespace or association.namespace ~= namespace then return false end
  if record.claimed == true and (record.workflowId ~= row.workflowId
      or tonumber(record.configIndex) ~= tonumber(index)) then
    return false, "claimed evidence belongs to a different workflow row", true
  end
  local linked, linkedCount, linkedValue = {}, 0, nil
  local function addWorkflow(value)
    if not workflowId.valid(value) or linked[value] then return end
    linked[value], linkedCount, linkedValue = true, linkedCount + 1, value
  end
  addWorkflow(record.workflowId)
  for _, current in ipairs(type(record.workflowIds) == "table" and record.workflowIds or {}) do
    addWorkflow(current)
  end
  if linkedCount > 0 then
    if linkedCount > 1 and linked[row.workflowId] then
      return false, "recorded identity has conflicting stable workflow provenance", true
    end
    return linkedCount == 1 and linkedValue == row.workflowId
  end
  local indexed, indexedCount, indexedValue = {}, 0, nil
  local function addIndex(value)
    value = tonumber(value)
    if not value or value < 1 or value ~= math.floor(value) or indexed[value] then return end
    indexed[value], indexedCount, indexedValue = true, indexedCount + 1, value
  end
  addIndex(record.configIndex)
  for _, current in ipairs(type(record.configIndexes) == "table" and record.configIndexes or {}) do
    addIndex(current)
  end
  if indexedCount > 0 then
    if indexedCount > 1 and indexed[index] then
      return false, "recorded identity has conflicting historical row provenance", true
    end
    return indexedCount == 1 and indexedValue == index
  end
  return false
end

local function purePreview(rawConfig, options)
  options = type(options) == "table" and options or {}
  local config = clone(type(rawConfig) == "table" and rawConfig or {})
  config.workflows = type(config.workflows) == "table" and config.workflows or {}
  workflowId.ensure(config)
  local index = math.floor(tonumber(options.configIndex or options.index) or 0)
  local row = config.workflows[index]
  if not row then
    return { state = reconcile.states.MISSING, configIndex = index,
      reason = "workflow row not found: " .. tostring(index), counts = { missing = 1 } }
  end
  local selectedLegacyFluidRepair = binding.isTaggedLegacyFluidProxy(row)
    and type(options.recordId) == "string" and options.recordId ~= ""
  local exact = not selectedLegacyFluidRepair and currentIdentity(row) or nil
  if exact then
    return { state = reconcile.states.VALID, configIndex = index, workflowId = row.workflowId,
      reason = "exact workflow identity is already valid", identity = exact,
      counts = { valid = 1 } }
  end

  local candidates = {}
  -- A legacy AE2FC fluid-drop row's outer item is precisely the identity that
  -- must be replaced. Never let its craft binding compete with the selected
  -- ordinary nested-fluid evidence and manufacture a false ambiguity.
  if not selectedLegacyFluidRepair then
    addCandidate(candidates, declaredIdentity(row), "same_row_declared_identity")
    addCandidate(candidates, filterIdentity(row), "same_row_filter")
    addCandidate(candidates, craftBindingIdentity(row), "same_row_craft_binding")
    addCandidate(candidates, stockBindingIdentity(row), "same_row_stock_binding")
    addCandidate(candidates, recordedTaggedIdentity(row), "same_row_tagged_identity")
  end
  local evidenceConflict, hardEvidenceConflict, legacyLabelMismatch
  for _, record in ipairs(type(options.evidence) == "table" and options.evidence or {}) do
    local selected = options.recordId == nil or record.recordId == options.recordId
    local matches, matchReason, hardConflict = false, nil, false
    if selected then
      matches, matchReason, hardConflict = evidenceMatches(record, row, index, config)
      if options.recordId and record.claimed ~= true then
        local namespaceOnly = type(record.association) == "table"
          and record.association.namespace == workflowId.authority(config)
        if not selectedLegacyFluidRepair or record.captureScoped == true then
          matches = namespaceOnly
        end
      end
      if selectedLegacyFluidRepair and not sameFluidLabel(row, record) then
        matches, legacyLabelMismatch = false, true
        matchReason = "recorded nested-fluid label does not match the selected legacy wrapper"
      end
    end
    if matches then
      addCandidate(candidates, record, "durable_evidence", record.recordId)
    elseif matchReason then
      evidenceConflict = evidenceConflict or matchReason
      hardEvidenceConflict = hardEvidenceConflict or hardConflict == true
    end
  end

  local distinct = {}
  for _, candidate in pairs(candidates) do distinct[#distinct + 1] = candidate end
  table.sort(distinct, function(a, b) return (identityKey(a.identity) or "") < (identityKey(b.identity) or "") end)
  if legacyLabelMismatch then
    return { state = reconcile.states.BLOCKED, configIndex = index, workflowId = row.workflowId,
      reason = evidenceConflict or "recorded nested-fluid label does not match the selected legacy wrapper",
      candidateCount = #distinct, counts = { blocked = 1 } }
  end
  if hardEvidenceConflict or (#distinct == 0 and evidenceConflict) then
    return { state = reconcile.states.AMBIGUOUS, configIndex = index, workflowId = row.workflowId,
      reason = evidenceConflict, candidateCount = #distinct, counts = { ambiguous = 1 } }
  end
  if #distinct == 0 then
    return { state = reconcile.states.BLOCKED, configIndex = index, workflowId = row.workflowId,
      reason = "no exact same-row receipt or uniquely linked durable identity evidence",
      counts = { blocked = 1 } }
  end
  if #distinct > 1 then
    return { state = reconcile.states.AMBIGUOUS, configIndex = index, workflowId = row.workflowId,
      reason = "recorded identity sources disagree; no automatic repair was applied",
      candidateCount = #distinct, counts = { ambiguous = 1 } }
  end
  local selected = distinct[1]
  if selectedLegacyFluidRepair and (selected.identity.kind ~= "fluid"
      or selected.identity.hasTag == true
      or not binding.validFluidName(selected.identity.name)
      or binding.isLegacyFluidProxyName(selected.identity.name)) then
    return { state = reconcile.states.BLOCKED, configIndex = index,
      workflowId = row.workflowId,
      reason = "legacy AE2FC wrapper repair requires one exact ordinary nested-fluid recording",
      counts = { blocked = 1 } }
  end
  local selectedRecordIds = listKeys(selected.recordIds)
  if options.requireEvidence == true and #selectedRecordIds == 0 then
    return { state = reconcile.states.BLOCKED, configIndex = index,
      workflowId = row.workflowId,
      reason = "repair requires one namespace-fenced recorded output",
      counts = { blocked = 1 } }
  end
  local state = selected.identity.authoritative and reconcile.states.READY or reconcile.states.PROBE_READY
  return {
    state = state, configIndex = index, workflowId = row.workflowId,
    reason = state == reconcile.states.PROBE_READY
      and "recorded tagged identity requires one bounded exact recipe proof"
      or "one exact recorded identity is ready to reconcile",
    identity = clone(selected.identity), sources = listKeys(selected.sources),
    recordIds = selectedRecordIds, legacyFluidProxyRepair = selectedLegacyFluidRepair or nil,
    counts = { [state == reconcile.states.READY and "ready" or "probeReady"] = 1 }
  }
end

local function verifiedTagged(identity, resolver, options)
  if type(resolver) ~= "function" then return nil, "bounded exact tagged proof is required" end
  local entry, reason, report = resolver(clone(identity), {
    onboardingTagged = true, remember = false,
    craftCompatibility = options.craftCompatibility,
    compatibilityNodeLimit = 1, compatibilityCallLimit = 1, compatibilityHandleLimit = 16
  })
  if not entry then return nil, reason or "bounded exact tagged proof found no recipe", report end
  if type(report) ~= "table" or report.matched ~= true or report.ambiguous == true
      or report.truncated == true or (report.exactMatches and report.exactMatches ~= 1) then
    return nil, "bounded exact tagged proof was not one unique verified result", report
  end
  local verified, identityReason = evidence.identity(entry)
  if not verified or not verified.authoritative or identityKey(verified) ~= identityKey(identity) then
    return nil, identityReason or "bounded exact tagged result did not match recorded identity", report
  end
  return verified, nil, report
end

local function applyPlan(rawConfig, plan, options)
  options = type(options) == "table" and options or {}
  if type(plan) ~= "table" or (plan.state ~= reconcile.states.READY
      and plan.state ~= reconcile.states.PROBE_READY and plan.state ~= reconcile.states.VALID) then
    return nil, type(plan) == "table" and plan.reason or "repairable identity plan is required"
  end
  local out = clone(rawConfig)
  out.workflows = type(out.workflows) == "table" and out.workflows or {}
  workflowId.ensure(out)
  local row = out.workflows[plan.configIndex]
  if not row or row.workflowId ~= plan.workflowId then
    return nil, "workflow row changed after identity preview; review and retry"
  end
  if plan.state == reconcile.states.VALID then
    return out, nil, { action = "identity_already_valid", configIndex = plan.configIndex,
      workflowId = row.workflowId, state = plan.state, recordIds = clone(plan.recordIds or {}) }
  end
  local identity, proofReport = clone(plan.identity), nil
  if plan.state == reconcile.states.PROBE_READY then
    local verified, reason, report = verifiedTagged(identity, options.resolveTagged, options)
    if not verified then return nil, reason, report end
    identity, proofReport = verified, report
  end
  local preserveAuto = plan.legacyFluidProxyRepair == true
    and binding.isTaggedLegacyFluidProxy(row)
    and row.mode == "auto" and identity.kind == "fluid"
    and identity.hasTag ~= true and binding.validFluidName(identity.name)
  local priorLineAuthority = row.lineAuthority
  row.workflowId = plan.workflowId
  row.name, row.kind, row.isFluid = identity.name, identity.kind, identity.kind == "fluid"
  row.damage = identity.kind == "item" and identity.damage or nil
  row.hasTag = identity.hasTag == true
  row.label = row.label or identity.label or identity.name
  row.rawLabel = identity.rawLabel or row.rawLabel
  row.filter = clone(identity.filter)
  row.craftBinding = clone(identity.craftBinding)
  row.stockBinding = clone(identity.stockBinding)
  row.stockBindingError = nil
  row.mode = preserveAuto and "auto" or "manual"
  row.lineAuthority = preserveAuto and (priorLineAuthority or "auto") or "observe"
  row.armed, row.dangerUnlocked = false, false
  return out, nil, { action = "identity_reconciled", configIndex = plan.configIndex,
    workflowId = row.workflowId, state = plan.state, sources = clone(plan.sources or {}),
    recordIds = clone(plan.recordIds or {}), proof = proofReport,
    autoPolicyPreserved = preserveAuto == true or nil }
end

function reconcile.previewConfig(rawConfig, options) return purePreview(rawConfig, options) end

function reconcile.preview(rawConfig, options)
  if options ~= nil or (type(rawConfig) == "table" and type(rawConfig.workflows) == "table") then
    return purePreview(rawConfig, options)
  end
  return reconcile.previewStored(rawConfig)
end

function reconcile.apply(rawConfig, plan, options) return applyPlan(rawConfig, plan, options) end

local function duplicateIdentity(config, identity)
  local wanted = identityKey(identity)
  for index, row in ipairs(config.workflows or {}) do
    local current = currentIdentity(row)
    if current and identityKey(current) == wanted then return index, row end
  end
  return nil
end

local function claimedWorkflowId(record)
  local found
  local function add(value)
    if not workflowId.valid(value) then return true end
    if found and found ~= value then return false end
    found = value
    return true
  end
  if not add(type(record) == "table" and record.workflowId or nil) then return nil, "conflicting workflow provenance" end
  for _, value in ipairs(type(record and record.workflowIds) == "table" and record.workflowIds or {}) do
    if not add(value) then return nil, "conflicting workflow provenance" end
  end
  return found
end

local function historicalIndexes(record)
  local found = {}
  local function add(value)
    value = tonumber(value)
    if value and value >= 1 and value == math.floor(value) and value < math.huge then found[value] = true end
  end
  add(type(record) == "table" and record.configIndex or nil)
  for _, value in ipairs(type(record and record.configIndexes) == "table" and record.configIndexes or {}) do add(value) end
  return listKeys(found)
end

function reconcile.addRecorded(rawConfig, record, options)
  options = type(options) == "table" and options or {}
  local identity, reason = evidence.identity(record)
  if not identity then return nil, reason end
  local plannedState = identity.probeReady and reconcile.states.PROBE_READY or reconcile.states.READY
  if identity.probeReady and options.previewPlan ~= true then
    identity, reason = verifiedTagged(identity, options.resolveTagged, options)
    if not identity then return nil, reason end
  end
  local out = clone(rawConfig)
  out.workflows = type(out.workflows) == "table" and out.workflows or {}
  workflowId.ensure(out)
  local namespace, namespaceReason = workflowId.authority(out)
  if not namespace then return nil, namespaceReason end
  if type(record.association) ~= "table" or record.association.namespace ~= namespace then
    return nil, "recorded identity belongs to another workflow policy namespace"
  end
  local duplicate = duplicateIdentity(out, identity)
  if duplicate then return nil, "recorded identity already exists at workflow row " .. tostring(duplicate) end
  local matchingLegacy = {}
  for index, existing in ipairs(out.workflows) do
    if not existing.name and modelIdentity.compatibleFlow(existing, identity)
        and modelIdentity.labelKey(existing) == modelIdentity.labelKey(identity) then
      matchingLegacy[#matchingLegacy + 1] = tostring(index)
    end
  end
  if #matchingLegacy > 0 then
    return nil, "matching legacy target exists at workflow row "
      .. table.concat(matchingLegacy, ",")
      .. "; use Reconcile Recorded so its automation policy is preserved"
  end
  local historicalId, historicalReason = claimedWorkflowId(record)
  if historicalReason then return nil, historicalReason end
  local indexes = historicalIndexes(record)
  if historicalId or #indexes > 0 then
    local pendingRecovery = options.recoverPending == true
      and type(options.pendingTransactionId) == "string"
    if options.restore ~= true and not pendingRecovery then
      return nil, "recorded identity is claimed and repair-only; deliberate restore must be explicit"
    end
    if not historicalId then
      return nil, "pre-ID row provenance cannot be resurrected; repair its selected row instead"
    end
    if not pendingRecovery and options.expectedWorkflowId ~= historicalId then
      return nil, "deliberate restore requires its exact historical workflowId"
    end
  end
  if historicalId then
    for index, existing in ipairs(out.workflows) do
      if existing.workflowId == historicalId then
        return nil, "recorded workflow ID is already present at row " .. tostring(index)
      end
    end
  end
  local row = {
    workflowId = historicalId,
    label = identity.label or identity.rawLabel or identity.name, rawLabel = identity.rawLabel,
    name = identity.name, damage = identity.damage, hasTag = identity.hasTag == true,
    kind = identity.kind, isFluid = identity.kind == "fluid", filter = clone(identity.filter),
    craftBinding = clone(identity.craftBinding), mode = "manual", lineIntent = "maintain_buffer",
    lineAuthority = "observe", alertEnabled = true, alertBelow = 0, maxRequest = 1,
    minStock = 0, craftTo = 0, batch = 1, requireReadyCpu = true, cooldown = 600,
    armed = false, dangerUnlocked = false, locked = false,
    identityEvidenceRecordId = record.recordId
  }
  out.workflows[#out.workflows + 1] = row
  workflowId.ensure(out)
  return out, nil, { action = options.previewPlan == true and "identity_record_add_ready"
      or "identity_record_added", configIndex = #out.workflows,
    workflowId = row.workflowId, recordId = record.recordId,
    state = plannedState }
end

function reconcile.reconcileAllConfig(rawConfig, records, options)
  return require("oc.ae2.workflow_identity_reconcile_bulk").run(rawConfig, records, options, {
    clone = clone, ensureIds = workflowId.ensure, states = reconcile.states,
    preview = purePreview, apply = applyPlan, identity = evidence.identity,
    authority = workflowId.authority, duplicate = duplicateIdentity,
    addRecorded = reconcile.addRecorded
  })
end

function reconcile.matchesRecord(row, record)
  local current = currentIdentity(row)
  return current ~= nil and identityKey(current) == identityKey(record)
end

local function transaction()
  return require("oc.ae2.workflow_identity_transaction")
end

function reconcile.samePlanToken(...)
  return transaction().samePlanToken(...)
end

function reconcile.previewStored(options)
  return transaction().previewStored(reconcile, options)
end

function reconcile.reconcileAll(options)
  return transaction().reconcileAll(reconcile, options)
end

return reconcile
-- One bounded reconciliation page.  Evidence paging and persistence belong
-- to workflow_identity_transaction; this module only applies pure plans to
-- the records already present in the caller's <=32-row page.
local bulk = {}

local function namespaceOf(record)
  return type(record) == "table" and type(record.association) == "table"
    and record.association.namespace or nil
end

local function pendingTransaction(record)
  local claim = type(record) == "table" and record.claim or nil
  if type(claim) == "table" and claim.state == "RESERVED"
      and type(claim.transactionId) == "string" then return claim.transactionId end
  return nil
end

function bulk.run(rawConfig, records, options, ops)
  options = type(options) == "table" and options or {}
  local out = ops.clone(rawConfig)
  out.workflows = type(out.workflows) == "table" and out.workflows or {}
  ops.ensureIds(out)
  local report = { action = "identity_reconcile_preview", state = "READY", receipts = {},
    counts = { total = 0, valid = 0, repairable = 0, repaired = 0, probeReady = 0,
      blocked = 0, ambiguous = 0, deferred = 0, observed = 0, added = 0 } }
  local indexes = {}
  if options.configIndex then
    indexes[1] = math.floor(tonumber(options.configIndex) or 0)
  elseif options.fleetPage == true then
    local wanted = {}
    for _, record in ipairs(records or {}) do
      if type(record.workflowId) == "string" then wanted[record.workflowId] = true end
    end
    for index, row in ipairs(out.workflows) do
      if wanted[row.workflowId] then indexes[#indexes + 1] = index end
    end
  else
    for index = 1, #out.workflows do indexes[#indexes + 1] = index end
  end
  for _, index in ipairs(indexes) do
    local plan = ops.preview(out, { configIndex = index, evidence = records,
      recordId = options.recordId, requireEvidence = options.requireEvidence == true })
    report.counts.total = report.counts.total + 1
    if plan.state == ops.states.VALID then
      report.counts.valid = report.counts.valid + 1
      report.receipts[#report.receipts + 1] = plan
    elseif plan.state == ops.states.READY or plan.state == ops.states.PROBE_READY then
      report.counts.repairable = report.counts.repairable + 1
      if plan.state == ops.states.PROBE_READY then
        report.counts.probeReady = report.counts.probeReady + 1
      end
      if options.preview == true then
        report.receipts[#report.receipts + 1] = plan
      else
        local nextConfig, reason, receipt = ops.apply(out, plan, options)
        if nextConfig then
          out = nextConfig
          report.counts.repaired = report.counts.repaired + 1
          report.receipts[#report.receipts + 1] = receipt
        else
          report.counts.blocked = report.counts.blocked + 1
          report.receipts[#report.receipts + 1] = { state = ops.states.BLOCKED,
            configIndex = index, workflowId = plan.workflowId, reason = reason, proof = receipt }
        end
      end
    elseif plan.state == ops.states.AMBIGUOUS then
      report.counts.ambiguous = report.counts.ambiguous + 1
      report.receipts[#report.receipts + 1] = plan
    elseif options.configIndex == nil and plan.state == ops.states.BLOCKED then
      -- Fleet work advances past legacy label-only rows. Selected work remains
      -- visibly blocked because the operator chose one exact row/record pair.
      report.counts.deferred = report.counts.deferred + 1
      plan.deferred, plan.action = true, "identity_reconcile_deferred"
      report.receipts[#report.receipts + 1] = plan
    else
      report.counts.blocked = report.counts.blocked + 1
      report.receipts[#report.receipts + 1] = plan
    end
  end
  if options.addObserved == true then
    for _, record in ipairs(records or {}) do
      local pending = pendingTransaction(record)
      local claimed = record.claimed == true
      local identity = ops.identity(record)
      local namespace = ops.authority(out)
      if namespace and namespaceOf(record) == namespace and identity
          and (not claimed or pending) and not ops.duplicate(out, identity) then
        local addOptions = ops.clone(options)
        addOptions.recoverPending, addOptions.pendingTransactionId = pending ~= nil, pending
        if options.preview == true then addOptions.previewPlan = true end
        local added, reason, receipt = ops.addRecorded(out, record, addOptions)
        if added then
          out = added
          local counter = options.preview == true and "observed" or "added"
          report.counts[counter] = report.counts[counter] + 1
          if options.preview == true and identity.probeReady then
            report.counts.probeReady = report.counts.probeReady + 1
          end
          report.receipts[#report.receipts + 1] = receipt
        else
          report.counts.blocked = report.counts.blocked + 1
          report.receipts[#report.receipts + 1] = { state = ops.states.BLOCKED,
            action = "identity_record_add_blocked", recordId = record.recordId, reason = reason }
        end
      end
    end
  end
  if report.counts.ambiguous > 0 then report.state = ops.states.AMBIGUOUS
  elseif report.counts.blocked > 0 then report.state = ops.states.BLOCKED
  elseif options.preview == true and report.counts.probeReady > 0 then
    report.state = ops.states.PROBE_READY
  else report.state = ops.states.READY end
  report.reason = report.state == ops.states.READY and (report.counts.deferred > 0
      and "actionable recorded identities are coherent; unsupported legacy rows were deferred"
      or "recorded identities are coherent")
    or report.state == ops.states.PROBE_READY and "one or more tagged identities need bounded exact proof"
    or report.state == ops.states.AMBIGUOUS and "recorded identity evidence conflicts"
    or "one or more identities remain blocked"
  return out, report
end

return bulk
-- Stable transaction name; all production behavior is the bounded v2 engine.
return require("oc.ae2.workflow_identity_transaction_v2")
-- Bounded v2 reconciliation transaction. One call commits at most one
-- 32-record page. Immutable claim receipts and a workflow-root mutation fence
-- make every crash boundary restartable without releasing the daemon brake.
local evidence = require("oc.ae2.identity_evidence")
local pages = require("oc.ae2.workflow_identity_evidence")
local workflowId = require("oc.ae2.workflow_id")

local tx = {}

local function clone(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}; if seen[value] then return seen[value] end
  local out = {}; seen[value] = out
  for key, nested in pairs(value) do out[clone(key, seen)] = clone(nested, seen) end
  return out
end

local function canonical(value, active)
  local kind = type(value)
  if kind == "nil" then return "n" end
  if kind == "boolean" then return value and "b1" or "b0" end
  if kind == "number" then return "d" .. string.format("%.17g", value) end
  if kind == "string" then return "s" .. #value .. ":" .. value end
  if kind ~= "table" then return nil, "unsupported digest value: " .. kind end
  active = active or {}; if active[value] then return nil, "recursive digest value" end
  active[value] = true
  local rows = {}
  for key, nested in pairs(value) do
    local left, leftReason = canonical(key, active)
    local right, rightReason = canonical(nested, active)
    if not left or not right then active[value] = nil; return nil, leftReason or rightReason end
    rows[#rows + 1] = left .. "=" .. right
  end
  active[value] = nil; table.sort(rows)
  return "t{" .. table.concat(rows, ";") .. "}"
end

local function digest(value)
  local body, reason = canonical(value)
  if not body then return nil, reason end
  local first, second = 216613626, 131542391
  for index = 1, #body do
    local byte = string.byte(body, index)
    first = (first * 131 + byte) % 2147483647
    second = (second * 65599 + byte) % 2147483629
  end
  return #body .. ":" .. string.format("%08x", first)
    .. ":" .. string.format("%08x", second)
end

local function logical(value)
  local out = clone(value); if type(out) == "table" then out.identityMutationFence = nil end
  return out
end

local function quiesced(value)
  local out = logical(value); out.autoEnabled = false
  for _, row in ipairs(out.workflows or {}) do row.armed = false end
  return out
end

local function policyIntent(config)
  local rows = type(config) == "table" and config.workflows or nil
  if type(rows) ~= "table" or #rows > 512 then return nil end
  local parts, armed = { tostring(#rows) }, {}
  for _, row in ipairs(rows) do
    if type(row) ~= "table" or not workflowId.valid(row.workflowId) then return nil end
    parts[#parts + 1] = row.workflowId
  end
  for first = 1, #rows, 4 do
    local nibble = 0
    for offset = 0, 3 do
      local row = rows[first + offset]
      if row then
        if row.armed == true then nibble = nibble + 2 ^ offset end
      end
    end
    armed[#armed + 1] = string.format("%x", nibble)
  end
  return { priorGlobalAutoEnabled = config.autoEnabled ~= false,
    priorArmedBits = table.concat(armed),
    priorWorkflowSignature = evidence.digestText(table.concat(parts, "\31")),
    priorWorkflowCount = #rows }
end

local function outcomes(report)
  local rows, records = {}, {}
  for _, receipt in ipairs(type(report) == "table" and report.receipts or {}) do
    local ids = clone(receipt.recordIds or {})
    if receipt.recordId then ids[#ids + 1] = receipt.recordId end
    table.sort(ids)
    rows[#rows + 1] = { action = receipt.action, state = receipt.state,
      workflowId = receipt.workflowId, configIndex = receipt.configIndex, recordIds = ids }
    for _, recordId in ipairs(ids) do records[#records + 1] = recordId end
  end
  table.sort(records)
  return digest(rows), #rows, digest(records), #records
end

local function buildToken(snapshot, page, report, options, materialized)
  local raw, rawReason = digest(logical(snapshot.value))
  local quiet, quietReason = digest(quiesced(snapshot.value))
  local outcomeDigest, outcomeCount, recordDigest, recordCount = outcomes(report)
  if not raw or not quiet or not outcomeDigest or not recordDigest then
    return nil, rawReason or quietReason or "could not digest reconciliation plan"
  end
  local selected = page.selected
  local scope = selected and "selected" or "fleet"
  local scopeDigest = assert(digest({ scope = scope, namespace = page.namespace,
    workflowId = selected and selected.workflowId, configIndex = selected and selected.configIndex,
    recordId = selected and selected.recordId, cursor = page.cursor,
    nextCursor = page.nextCursor, addObserved = options.addObserved ~= false,
    sealDigest = options.sealDigest }))
  local token = { version = 2, rawSnapshot = raw, quiescedSnapshot = quiet,
    workflowNamespace = page.namespace, gridAddress = page.gridAddress,
    evidenceGeneration = tonumber(page.generation) or 0,
    scope = scope, selectedWorkflowId = selected and selected.workflowId,
    selectedConfigIndex = selected and selected.configIndex,
    selectedRecordId = selected and selected.recordId,
    cursor = page.cursor, nextCursor = page.nextCursor,
    batchCount = tonumber(page.count) or #(page.records or {}),
    deferredCount = tonumber(page.deferredCount) or 0,
    addObserved = options.addObserved ~= false, sealDigest = options.sealDigest,
    totalEvidence = tonumber(options.totalEvidence), scopeDigest = scopeDigest,
    outcomeDigest = outcomeDigest, outcomeCount = outcomeCount,
    recordDigest = recordDigest, recordCount = recordCount }
  local prior = options.priorIntent
  if prior ~= false then
    prior = type(prior) == "table" and prior or policyIntent(snapshot.value)
    if prior then
      token.priorGlobalAutoEnabled = prior.priorGlobalAutoEnabled == true
      token.priorArmedBits = prior.priorArmedBits
      token.priorWorkflowSignature = prior.priorWorkflowSignature
      token.priorWorkflowCount = tonumber(prior.priorWorkflowCount)
    end
  end
  if materialized then
    token.afterSnapshot = digest(logical(materialized))
    token.quiescedAfterSnapshot = digest(quiesced(materialized))
  end
  token.transactionId = "rit-" .. evidence.digestText(table.concat({ page.namespace,
    tostring(page.generation), scopeDigest, outcomeDigest, recordDigest }, "|"))
  local body = clone(token); token.tokenDigest = assert(digest(body))
  return token
end

local function validToken(value)
  if type(value) ~= "table" or value.version ~= 2 then return false end
  local body, wanted = clone(value), value.tokenDigest; body.tokenDigest = nil
  return digest(body) == wanted
end

function tx.samePlanToken(expected, actual, afterBrake, ignoreGeneration)
  if not validToken(expected) or not validToken(actual) then return false end
  local selected = expected.scope == "selected" and actual.scope == "selected"
  local beforeMatches = afterBrake and expected.quiescedSnapshot == actual.rawSnapshot
    or expected.rawSnapshot == actual.rawSnapshot
  local afterMatches = expected.afterSnapshot == actual.afterSnapshot
  if afterBrake and expected.quiescedAfterSnapshot then
    afterMatches = expected.quiescedAfterSnapshot == actual.afterSnapshot
  end
  return beforeMatches and (afterMatches or expected.afterSnapshot == nil)
    -- Unrelated evidence observations advance the namespace generation. They
    -- cannot change an exact selected record/scope/outcome digest and therefore
    -- do not invalidate that selected transaction. Fleet still binds the full
    -- generation and generation-derived transaction ID.
    and (selected or ignoreGeneration == true
      or tonumber(expected.evidenceGeneration) == tonumber(actual.evidenceGeneration))
    and expected.workflowNamespace == actual.workflowNamespace
    and expected.gridAddress == actual.gridAddress
    and expected.scopeDigest == actual.scopeDigest
    and (selected or expected.transactionId == actual.transactionId)
    and expected.outcomeDigest == actual.outcomeDigest
    and expected.recordDigest == actual.recordDigest
end

local function pagePlan(planner, snapshot, page, options)
  local _, report = planner.reconcileAllConfig(snapshot.value, page.records, {
    configIndex = page.selected and page.selected.configIndex,
    recordId = page.selected and page.selected.recordId,
    workflowId = page.selected and page.selected.workflowId,
    addObserved = options.addObserved ~= false, fleetPage = page.selected == nil,
    requireEvidence = true, preview = true
  })
  local materialized
  if (tonumber(report.counts and report.counts.probeReady) or 0) == 0
      and (tonumber(report.counts and report.counts.blocked) or 0) == 0
      and (tonumber(report.counts and report.counts.ambiguous) or 0) == 0 then
    materialized = planner.reconcileAllConfig(snapshot.value, page.records, {
      configIndex = page.selected and page.selected.configIndex,
      recordId = page.selected and page.selected.recordId,
      addObserved = options.addObserved ~= false, fleetPage = page.selected == nil,
      requireEvidence = true, preview = false
    })
  end
  return report, materialized
end

local function loadSnapshot() return require("oc.ae2.workflow_store").rawSnapshot() end

local function selectedOptions(options)
  return { configIndex = options.configIndex, workflowId = options.workflowId,
    recordId = options.recordId, gridAddress = options.gridAddress }
end

function tx.previewStored(planner, options)
  options = type(options) == "table" and options or {}
  local snapshot, reason = loadSnapshot(); if not snapshot then return false, reason end
  local page, summary
  if options.configIndex ~= nil or options.recordId ~= nil or options.workflowId ~= nil then
    local ok; ok, reason, page = pages.load(snapshot.value, selectedOptions(options))
    if not ok then return false, reason end
  else
    local policyDigest = assert(digest(logical(snapshot.value)))
    local ok
    ok, reason, summary = require("oc.ae2.workflow_identity_fleet").step(
      planner, snapshot.value, { addObserved = options.addObserved,
        gridAddress = options.gridAddress, policyDigest = policyDigest }, options.preparation)
    if not ok then return false, reason, summary end
    if summary.preparing == true then return true, nil, summary end
    local preparation = summary.preparation
    if type(preparation) ~= "table" or preparation.phase ~= "sealed" then
      return false, "Fleet preparation did not produce a durable corpus seal"
    end
    ok, reason, page = pages.load(snapshot.value, { gridAddress = preparation.gridAddress })
    if not ok then return false, reason end
    if tonumber(page.generation) ~= tonumber(preparation.generation)
        or page.namespace ~= preparation.namespace then
      return false, "identity evidence changed after Fleet preparation; restart preview"
    end
    page.deferredCount = math.max(0, (tonumber(preparation.totalEvidence) or 0)
      - (tonumber(page.count) or 0))
    options.sealDigest, options.totalEvidence = preparation.sealDigest,
      preparation.totalEvidence
  end
  local pageReport, materialized = pagePlan(planner, snapshot, page, options)
  if summary and (summary.state == "BLOCKED" or summary.state == "AMBIGUOUS") then
    return false, summary.reason, summary
  end
  local token; token, reason = buildToken(snapshot, page, pageReport, options, materialized)
  if not token then return false, reason end
  local report = summary or pageReport
  report.receipts = pageReport.receipts
  report.planToken, report.preview = token, true
  report.cursor, report.nextCursor = page.cursor, page.nextCursor
  report.batchCount, report.deferredCount = token.batchCount, token.deferredCount
  report.processed = 0
  report.selected = clone(page.selected)
  return true, nil, report
end

local function recordMap(page)
  local out = {}; for _, record in ipairs(page.records or {}) do out[record.recordId] = record end
  return out
end

local function claimsFor(report, page, transactionId)
  local byId, claims, seen = recordMap(page), {}, {}
  for _, receipt in ipairs(report.receipts or {}) do
    local ids = clone(receipt.recordIds or {})
    if receipt.recordId then ids[#ids + 1] = receipt.recordId end
    for _, recordId in ipairs(ids) do
      local record = byId[recordId]
      if not record then return nil, "plan referenced evidence outside its bounded page" end
      local association = type(record.association) == "table" and record.association or {}
      if workflowId.valid(association.workflowId)
          and association.workflowId ~= receipt.workflowId then
        return nil, "recorded first-observation owner conflicts with planned workflow"
      end
      local claim = type(record.claim) == "table" and record.claim or {}
      local already = claim.state == "COMMITTED" and record.workflowId == receipt.workflowId
        and tonumber(record.configIndex) == tonumber(receipt.configIndex)
      if not already and not seen[recordId] then
        if record.claimed == true and claim.transactionId ~= transactionId then
          return nil, "recorded evidence is already claimed by another transaction"
        end
        claims[#claims + 1] = { recordId = recordId, workflowId = receipt.workflowId,
          configIndex = receipt.configIndex }
        seen[recordId] = true
      end
    end
  end
  if #claims > (tonumber(evidence.maxPage) or 32) then
    return nil, "bounded reconciliation page exceeded the 32-claim limit"
  end
  return claims
end

local function clearFence(store, snapshot, transactionId)
  local fence = snapshot.value and snapshot.value.identityMutationFence
  if type(fence) ~= "table" or fence.transactionId ~= transactionId then return true end
  local candidate = logical(snapshot.value)
  return store.saveRawSnapshot(snapshot, candidate, nil, "identity_reconcile_fence_clear",
    { identityTransactionId = transactionId })
end

local function nextPage(planner, expected, options)
  if not expected.nextCursor then return nil end
  local snapshot, reason = loadSnapshot(); if not snapshot then return nil, reason end
  local ok, page
  ok, reason, page = pages.load(snapshot.value, { cursor = expected.nextCursor,
    gridAddress = options.gridAddress })
  if not ok then return nil, reason end
  page.deferredCount = math.max(0, (tonumber(expected.deferredCount) or 0)
    - (tonumber(page.count) or 0))
  if (tonumber(page.count) or 0) == 0 and not page.nextCursor then return nil end
  local inherited = expected.priorWorkflowSignature and {
    priorGlobalAutoEnabled = expected.priorGlobalAutoEnabled,
    priorArmedBits = expected.priorArmedBits,
    priorWorkflowSignature = expected.priorWorkflowSignature,
    priorWorkflowCount = expected.priorWorkflowCount
  } or false
  local nextOptions = { addObserved = expected.addObserved, sealDigest = expected.sealDigest,
    totalEvidence = expected.totalEvidence, priorIntent = inherited }
  local report, materialized = pagePlan(planner, snapshot, page, nextOptions)
  if report.state == "BLOCKED" or report.state == "AMBIGUOUS" then
    return nil, report.reason or "next Fleet page is not coherent"
  end
  local token; token, reason = buildToken(snapshot, page, report, nextOptions, materialized)
  if not token then return nil, reason end
  return { cursor = page.cursor, nextCursor = page.nextCursor,
    batchCount = token.batchCount, deferredCount = token.deferredCount,
    planToken = token, counts = report.counts }
end

local function completed(planner, expected, options, report, recovered)
  local continuation, reason = nextPage(planner, expected, options)
  if reason then return false, reason, report end
  report = type(report) == "table" and report or { counts = {} }
  report.action, report.saved, report.recovered = "identity_reconciled_page", true, recovered == true
  report.processed, report.deferredCount = tonumber(expected.batchCount) or 0,
    tonumber(expected.deferredCount) or 0
  report.cursor, report.nextCursor, report.continuation = expected.cursor,
    expected.nextCursor, continuation
  return true, nil, report
end

function tx.reconcileAll(planner, options)
  options = type(options) == "table" and options or {}
  if options.preview == true then return tx.previewStored(planner, options) end
  if options.confirm ~= true or not validToken(options.expectedPlanToken) then
    return false, "a confirmed v2 reconciliation plan token is required"
  end
  local expected = options.expectedPlanToken
  local snapshot, reason = loadSnapshot(); if not snapshot then return false, reason end
  local namespace = workflowId.authority(snapshot.value)
  if namespace ~= expected.workflowNamespace then return false, "workflow namespace changed" end
  options.gridAddress = options.gridAddress or expected.gridAddress

  local currentDigest = digest(snapshot.value)
  local recovery, recoveryReason = evidence.claimRecoveryStatus(
    namespace, expected.transactionId, currentDigest)
  if not recovery then return false, recoveryReason or "claim recovery status is unreadable" end
  if recovery.state ~= "MISSING" then
    if not recovery.intent or recovery.intent.scopeDigest ~= expected.scopeDigest then
      return false, "immutable claim recovery scope conflicts with the staged plan"
    end
    if recovery.workflowState == "AFTER" then
      if recovery.state ~= "COMMITTED" then
        local committed, commitReason = evidence.commitClaims({ namespace = namespace,
          transactionId = expected.transactionId, workflowDigest = currentDigest,
          gridAddress = options.gridAddress })
        if not committed then return false, commitReason end
      end
      return completed(planner, expected, options, nil, true)
    elseif recovery.workflowState ~= "BEFORE" then
      return false, "claim recovery conflicts with current workflow authority"
    end
  elseif not snapshot.value.identityMutationFence then
    local logicalDigest = digest(logical(snapshot.value))
    local expectedAfter = options.afterBrake and expected.quiescedAfterSnapshot
      or expected.afterSnapshot
    if expectedAfter and logicalDigest == expectedAfter then
      return completed(planner, expected, options, nil, true)
    end
  end

  local pageOk, page
  if expected.scope == "selected" then
    pageOk, reason, page = pages.load(snapshot.value, { configIndex = expected.selectedConfigIndex,
      workflowId = expected.selectedWorkflowId, recordId = expected.selectedRecordId,
      gridAddress = options.gridAddress })
  else
    pageOk, reason, page = pages.load(snapshot.value, { cursor = expected.cursor,
      deferredCount = expected.deferredCount, gridAddress = options.gridAddress })
  end
  if not pageOk then return false, reason end
  local planOptions = { addObserved = expected.addObserved,
    sealDigest = expected.sealDigest, totalEvidence = expected.totalEvidence }
  local preview, materialized = pagePlan(planner, snapshot, page, planOptions)
  local fresh; fresh, reason = buildToken(snapshot, page, preview, planOptions, materialized)
  if not fresh then return false, reason end
  if not tx.samePlanToken(expected, fresh, options.afterBrake == true,
      recovery.state ~= "MISSING") then
    if recovery.state == "MISSING" then clearFence(require("oc.ae2.workflow_store"), snapshot,
      expected.transactionId) end
    return false, "staged identity consequences changed; preview again", preview
  end
  local candidate, report = planner.reconcileAllConfig(snapshot.value, page.records, {
    configIndex = page.selected and page.selected.configIndex,
    recordId = page.selected and page.selected.recordId,
    addObserved = expected.addObserved, fleetPage = page.selected == nil,
    requireEvidence = true, craftCompatibility = snapshot.value.craftCompatibility,
    resolveTagged = options.resolveTagged or function(identity, resolveOptions)
      return require("oc.ae2.request_direct").resolve(identity, resolveOptions)
    end, preview = false
  })
  if (tonumber(report.counts.blocked) or 0) > 0
      or (tonumber(report.counts.ambiguous) or 0) > 0 then
    return false, report.reason, report
  end
  candidate.identityMutationFence = nil
  local beforeLogical, afterDigest = digest(logical(snapshot.value)), digest(candidate)
  local changed = beforeLogical ~= afterDigest
  local claims; claims, reason = claimsFor(report, page, expected.transactionId)
  if not claims then return false, reason, report end
  if changed and #claims == 0 and not expected.afterSnapshot then
    return false, "workflow mutation has no durable evidence authority", report
  end
  if not changed then return completed(planner, expected, options, report, false) end

  local store = require("oc.ae2.workflow_store")
  local fence = snapshot.value.identityMutationFence
  if fence and fence.transactionId ~= expected.transactionId then
    return false, "another transaction owns the workflow mutation fence", report
  end
  if not fence then
    fence = { transactionId = expected.transactionId, namespace = namespace,
      scopeDigest = expected.scopeDigest, beforeDigest = beforeLogical,
      installedAt = tonumber(options.now) or 0 }
    local fencedCandidate = clone(snapshot.value); fencedCandidate.identityMutationFence = clone(fence)
    local fencedDigest = assert(digest(fencedCandidate))
    if #claims > 0 then
      if type(evidence.preflightClaims) ~= "function" then
        return false, "v2 claim preflight API is unavailable", report
      end
      local preflight, preflightReason = evidence.preflightClaims({ namespace = namespace,
        transactionId = expected.transactionId, expectedGeneration = expected.evidenceGeneration,
        currentGeneration = page.generation, beforeDigest = fencedDigest,
        afterDigest = afterDigest, scopeDigest = expected.scopeDigest,
        claims = claims, gridAddress = page.gridAddress })
      if not preflight then return false, preflightReason, report end
    end
    local installed, installReason = store.installIdentityFence(snapshot, fence)
    if not installed then return false, installReason, report end
    snapshot, reason = loadSnapshot(); if not snapshot then return false, reason, report end
  end
  local fencedDigest = assert(digest(snapshot.value))
  if #claims > 0 then
    local reserved, reserveReason = evidence.reserveClaims({ namespace = namespace,
      transactionId = expected.transactionId,
      expectedGeneration = recovery.intent and recovery.intent.expectedGeneration
        or expected.evidenceGeneration,
      beforeDigest = fencedDigest, afterDigest = afterDigest,
      scopeDigest = expected.scopeDigest, claims = claims,
      gridAddress = page.gridAddress })
    if not reserved then return false, reserveReason, report end
  end
  local saved, saveReason = store.saveRawSnapshot(snapshot, candidate, nil,
    "identity_reconcile", { identityTransactionId = expected.transactionId })
  if not saved then return false, saveReason, report end
  local finalSnapshot; finalSnapshot, reason = loadSnapshot()
  if not finalSnapshot then return false, reason, report end
  local finalDigest = assert(digest(finalSnapshot.value))
  if finalDigest ~= afterDigest then return false, "saved workflow digest changed", report end
  if #claims > 0 then
    local committed, commitReason = evidence.commitClaims({ namespace = namespace,
      transactionId = expected.transactionId, workflowDigest = finalDigest,
      gridAddress = page.gridAddress })
    if not committed then return false, commitReason, report end
  end
  return completed(planner, expected, options, report, false)
end

return tx
-- Dashboard/shell facade for bounded evidence v2 pages and recorded-row adds.
-- The public workflows module delegates here to stay comfortably below the
-- OpenOS source-size gate.
local evidence = require("oc.ae2.identity_evidence")
local codec = require("oc.ae2.identity_evidence_v2_codec")
local store = require("oc.ae2.workflow_store")
local workflowId = require("oc.ae2.workflow_id")

local api = {}

local function now(value)
  value = tonumber(value)
  if value and value == value and value >= 0 and value < math.huge then return value end
  local loaded, computer = pcall(require, "computer")
  local called, current = loaded and pcall(computer.uptime)
  current = called and tonumber(current) or nil
  return current and current >= 0 and current < math.huge and current or 0
end

local function gridAddress(options)
  if type(options.gridAddress) == "string" and options.gridAddress ~= "" then
    return options.gridAddress
  end
  local loaded, adapter = pcall(require, "oc.ae2.adapter")
  if not loaded or type(adapter) ~= "table" or type(adapter.primary) ~= "function" then
    return nil, "current AE2 grid authority is unavailable"
  end
  local called, primary, reason = pcall(adapter.primary)
  if not called or type(primary) ~= "table" or type(primary.address) ~= "string"
      or primary.address == "" then
    return nil, tostring(called and reason or primary or "current AE2 grid is unavailable")
  end
  return primary.address
end

local function selected(config, options)
  local found
  for index, row in ipairs(type(config) == "table" and config.workflows or {}) do
    if (options.workflowId and row.workflowId == options.workflowId)
        or (options.configIndex and tonumber(options.configIndex) == index) then
      if found then return {} end
      found = { workflowId = row.workflowId, configIndex = index }
    end
  end
  return found or {}
end

local function baseline(cpuSlots)
  local out, seen = {}, {}
  for _, fingerprint in pairs(type(cpuSlots) == "table" and cpuSlots or {}) do
    local digest = type(fingerprint) == "string" and fingerprint:match("^(%x+)%c") or nil
    if digest and #digest == 32 then
      local token = "dg:" .. digest:lower()
      if not seen[token] then seen[token], out[#out + 1] = true, token end
    end
  end
  table.sort(out)
  return out
end

local function captureAllowed()
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  local called, cfg = false, nil
  if loaded and type(daemonConfig.load) == "function" then called, cfg = pcall(daemonConfig.load) end
  if not called or type(cfg) ~= "table" or cfg.configReadFailed == true then
    return false, "daemon safety authority is unreadable"
  end
  if cfg.maintenanceBrake == true then
    return false, "identity reconciliation owns evidence mutation"
  end
  return true
end

local function captureRetention(captureReport, status)
  local capture = type(status) == "table" and status.capture or nil
  if type(capture) ~= "table" or capture.active ~= true then return false, "terminal" end
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  local called, cfg = false, nil
  if loaded and type(daemonConfig.load) == "function" then called, cfg = pcall(daemonConfig.load) end
  if called and type(cfg) == "table" and cfg.enabled == true then return true, "daemon" end
  local worker = type(captureReport) == "table" and captureReport.captureWorker or nil
  if type(worker) == "table" and (worker.action == "identity_capture_worker_started"
      or worker.action == "identity_capture_worker_running"
      or worker.action == "identity_capture_worker_already_running") then return true, "capture_worker" end
  local workerLoaded, captureWorker = pcall(require, "oc.ae2.identity_capture_worker")
  if workerLoaded and type(captureWorker.status) == "function" then
    local statusCalled, workerStatus = pcall(captureWorker.status, capture.captureId)
    if statusCalled and type(workerStatus) == "table"
        and workerStatus.action == "identity_capture_worker_running" then
      return true, "capture_worker"
    end
  end
  return false, "no_live_observer"
end

local function focusEligible(row, options)
  if type(row) ~= "table" then return false end
  if options.kind ~= nil and row.kind ~= options.kind then return false end
  if options.claimed ~= nil and row.claimed ~= options.claimed then return false end
  local wanted, ownership = options.ownership, row.ownership
  if wanted == "unclaimed" and ownership ~= "unclaimed" then return false end
  if wanted == "owned_by_target" and ownership ~= "owned_by_target" then return false end
  if wanted == "owned_by_other" and ownership ~= "owned_by_other" then return false end
  if wanted == "unclaimed_or_current_row"
      and ownership ~= "unclaimed" and ownership ~= "owned_by_target" then return false end
  return codec.matchesLabelQuery(row, options.labelQuery)
end

local function focusCaptured(report, captureStatus, options, namespace, grid)
  local capture = type(captureStatus) == "table" and captureStatus.capture or nil
  if type(capture) ~= "table" then return 0 end
  if options.workflowId ~= nil and capture.workflowId ~= options.workflowId then return 0 end
  if options.configIndex ~= nil
      and tonumber(capture.configIndex) ~= tonumber(options.configIndex) then return 0 end
  local ids = {}
  if capture.status == "CONSUMED" and codec.parseRecordId(capture.recordId) then
    ids[1] = capture.recordId
  elseif capture.status == "AMBIGUOUS" then
    for _, recordId in ipairs(type(capture.candidates) == "table" and capture.candidates or {}) do
      if codec.parseRecordId(recordId) then ids[#ids + 1] = recordId end
    end
  end
  if #ids == 0 then return 0 end
  local focus, seen = {}, {}
  for _, recordId in ipairs(ids) do
    local row, rowReason = evidence.get(recordId, { namespace = namespace, gridAddress = grid,
      targetWorkflowId = options.workflowId, targetConfigIndex = options.configIndex })
    if not row then
      return nil, "captured evidence lookup failed for " .. tostring(recordId)
        .. ": " .. tostring(rowReason or "unavailable")
    end
    if focusEligible(row, options) and not seen[recordId] then
      focus[#focus + 1], seen[recordId] = row, true
    end
  end
  if #focus == 0 then return 0 end
  local inPage, byId = {}, {}
  for _, row in ipairs(report.records or {}) do byId[row.recordId] = true end
  for _, row in ipairs(focus) do
    if byId[row.recordId] then inPage[#inPage + 1] = row end
  end
  for _, row in ipairs(report.records or {}) do
    if not seen[row.recordId] then inPage[#inPage + 1] = row end
  end
  report.records, report.focusRecords = inPage, focus
  report.focusCaptureScoped = true
  report.focusRecordId = #focus == 1 and focus[1].recordId or nil
  if #focus > 1 then
    report.focusRecordIds = {}
    for _, row in ipairs(focus) do report.focusRecordIds[#report.focusRecordIds + 1] = row.recordId end
  end
  return #focus
end

local function terminalCapture(status)
  local capture = type(status) == "table" and status.capture or nil
  return type(capture) == "table" and capture.active ~= true
    and (capture.status == "CONSUMED" or capture.status == "AMBIGUOUS")
end

function api.list(options, observeActive, sustainCapture, cpuSlots)
  options = type(options) == "table" and options or {}
  local capture, captureError
  if options.observeCpu == true or options.captureNext == true then
    local called, captured, reason, report = pcall(observeActive, options)
    if not called then captured, reason, report = false, captured, nil end
    capture = report
    if captured ~= true then
      captureError = tostring(reason or "CPU output observation failed")
      -- If the bounded snapshot itself failed, retain the last process-local
      -- baseline only when current grid authority can still be proven.
      if options.captureNext == true
          and not (type(capture) == "table" and type(capture.captureRequest) == "table") then
        local snapshot = store.rawSnapshot()
        local config = snapshot and snapshot.value or nil
        local namespace = config and workflowId.authority(config) or nil
        local grid, gridReason = gridAddress(options)
        local scope = selected(config, options)
        local armed, armReason, armedReport = false,
          gridReason or "workflow namespace unavailable", nil
        local allowed, allowReason = captureAllowed()
        if namespace and grid and allowed then
          armed, armReason, armedReport = evidence.requestCapture(now(options.observedAt), {
            workflowNamespace = namespace, workflowId = scope.workflowId,
            configIndex = scope.configIndex, gridAddress = grid,
            hostAddress = workflowId.currentHost(), baseline = baseline(cpuSlots),
            labelQuery = options.labelQuery, expectedCaptureId = options.expectedCaptureId })
        elseif not allowed then armReason = allowReason end
        if armed == true then
          capture = type(capture) == "table" and capture or {}
          capture.captureNext, capture.captureRequest = true, armedReport
          local kept, keepReason, keptCapture = sustainCapture(true, nil, capture)
          capture = keptCapture or capture
          if kept ~= true then captureError = captureError .. "; detached capture worker failed: "
            .. tostring(keepReason or "unknown launch failure") end
        else captureError = captureError .. "; capture-next could not be armed: "
          .. tostring(armReason or "state write failed") end
      end
    end
  end

  local snapshot, snapshotReason = store.rawSnapshot()
  if not snapshot then return false, snapshotReason, { capture = capture, captureError = captureError } end
  local namespace, namespaceReason = workflowId.authority(snapshot.value)
  if not namespace then return false, namespaceReason, { capture = capture, captureError = captureError } end
  local grid, gridReason = gridAddress(options)
  if not grid then return false, gridReason, { capture = capture, captureError = captureError } end
  local limit = math.max(1, math.min(tonumber(evidence.maxPage) or 32,
    math.floor(tonumber(options.limit) or (tonumber(evidence.maxPage) or 32))))
  local ok, reason, report = evidence.page({ namespace = namespace, gridAddress = grid,
    cursor = options.cursor, limit = limit, kind = options.kind,
    ownership = options.ownership, claimed = options.claimed,
    labelQuery = options.labelQuery,
    targetWorkflowId = options.workflowId, targetConfigIndex = options.configIndex })
  if not ok then return false, reason, { capture = capture, captureError = captureError } end
  report.cursor, report.namespace, report.gridAddress = options.cursor, namespace, grid
  report.capture, report.captureError = capture, captureError
  local captureStatus, statusReason = evidence.captureStatus(namespace)
  report.captureStatus, report.captureStatusError = captureStatus, statusReason
  report.captureRetainsFutureOutput, report.captureOwner = captureRetention(capture, captureStatus)
  local focusCount, focusReason = focusCaptured(report, captureStatus, options, namespace, grid)
  if focusReason then
    report.captureFocusError = focusReason
    captureError = captureError and (captureError .. "; " .. focusReason) or focusReason
    report.captureError = captureError
  elseif options.captureNext == true and terminalCapture(captureStatus)
      and (focusCount == 0 or captureStatus.capture.status == "AMBIGUOUS") then
    local scope, allowed, allowReason = selected(snapshot.value, options), captureAllowed()
    local armed, armReason, armedReport = false, allowReason, nil
    if allowed then
      armed, armReason, armedReport = evidence.requestCapture(now(options.observedAt), {
        workflowNamespace = namespace, workflowId = scope.workflowId,
        configIndex = scope.configIndex, gridAddress = grid,
        hostAddress = workflowId.currentHost(), baseline = baseline(cpuSlots),
        labelQuery = options.labelQuery, replaceTerminal = true,
        expectedCaptureId = captureStatus.capture.captureId })
    end
    if armed == true then
      capture = type(capture) == "table" and capture or {}
      capture.captureNext, capture.captureRequest = true, armedReport
      local kept, keepReason, keptCapture = sustainCapture(true, nil, capture)
      report.capture = keptCapture or capture
      if kept ~= true then captureError = tostring(keepReason or "capture observer launch failed") end
      report.captureStatus = evidence.captureStatus(namespace)
      report.captureRetainsFutureOutput, report.captureOwner = captureRetention(report.capture, report.captureStatus)
    else captureError = tostring(armReason or "terminal capture replacement failed") end
    report.captureError = captureError
  end
  return true, nil, report
end

function api.add(recordId, options)
  return require("oc.ae2.workflow_identity_add_transaction").run(
    require("oc.ae2.workflow_identity_reconcile"), recordId, options)
end

return api
-- Numeric parsing is deliberately independent from workflow identity/policy.
-- This lets the public workflow model stay small enough for reliable OpenOS
-- paste/deploy while retaining its compact quantity and duration grammar.
local numbers = {}

function numbers.parseQuantity(value, maxQuantity)
  if type(value) == "number" then return value end
  local text = tostring(value or ""):gsub(",", ""):gsub("%s+", "")
  local suffix = text:match("([KkMmBbTtPp])$")
  if suffix then
    local base = tonumber(text:sub(1, -2))
    if not base then return nil end
    local factors = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, p = maxQuantity }
    return base * factors[suffix:lower()]
  end
  return tonumber(text)
end

function numbers.clampQuantity(value, minimum, maxQuantity)
  local number = numbers.parseQuantity(value, maxQuantity)
  if not number then return nil end
  number = math.floor(number)
  minimum = minimum or 0
  if number < minimum then number = minimum end
  if number > maxQuantity then number = maxQuantity end
  return number
end

function numbers.parseDuration(value, maxCooldown)
  if type(value) == "number" then return value end
  local text = tostring(value or ""):gsub(",", ""):gsub("%s+", "")
  local suffix = text:match("([SsMmHhDdWw])$")
  if suffix then
    local base = tonumber(text:sub(1, -2))
    if not base then return nil end
    local factors = { s = 1, m = 60, h = 3600, d = 86400, w = maxCooldown }
    return base * factors[suffix:lower()]
  end
  return tonumber(text)
end

function numbers.clampCooldown(value, minimumCooldown, maxCooldown)
  local number = numbers.parseDuration(value, maxCooldown)
  if not number then return nil end
  number = math.floor(number)
  if number < minimumCooldown then number = minimumCooldown end
  if number > maxCooldown then number = maxCooldown end
  return number
end

return numbers
-- Exact workflow identity and legacy-label reconciliation live together so
-- policy editing never needs to duplicate item/fluid/tag comparison rules.
local binding = require("oc.ae2.request_binding")

local identity = {}

function identity.labelKey(value)
  return tostring(value and (value.label or value.rawLabel or value.name) or ""):lower()
end

local function variantLabel(value)
  local marker = binding.copyTaggedLabelBinding(value)
  return marker and ("raw=" .. marker.rawLabel) or identity.labelKey(value)
end
local function fluidProxy(value)
  return tostring(value and (value.rawLabel or value.label or value.name) or ""):find("^[Dd]rops? of%s+") ~= nil
end

function identity.kindFor(value)
  return value and (fluidProxy(value) and "fluid" or value.kind or (value.isFluid and "fluid" or "item")) or "item"
end

function identity.keyFor(value)
  if value and value.name then
    return tostring(identity.kindFor(value)) .. ":" .. tostring(value.name) .. ":"
      .. tostring(value.damage or "") .. ":" .. tostring(binding.tagged(value.hasTag)) .. ":" .. variantLabel(value)
  end
  return identity.labelKey(value)
end

local function addKey(out, seen, key)
  key = tostring(key or "")
  if key ~= "" and not seen[key] then seen[key], out[#out + 1] = true, key end
end

function identity.keysFor(value)
  local out, seen = {}, {}
  if value and value.name then addKey(out, seen, identity.keyFor(value)) else addKey(out, seen, identity.labelKey(value)) end
  return out
end

function identity.explicitKind(value)
  return value and (fluidProxy(value) and "fluid" or value.kind or (value.isFluid and "fluid" or nil)) or nil
end

function identity.sameKey(left, right)
  if left and right and left.name and right.name then return identity.keyFor(left) == identity.keyFor(right) end
  local leftKind, rightKind = identity.explicitKind(left), identity.explicitKind(right)
  if leftKind and rightKind and leftKind ~= rightKind then return false end
  local wanted = {}
  for _, key in ipairs(identity.keysFor(left)) do wanted[key] = true end
  for _, key in ipairs(identity.keysFor(right)) do if wanted[key] then return true end end
  return false
end

function identity.compatibleFlow(flow, entry)
  local flowKind, entryKind = identity.explicitKind(flow), identity.explicitKind(entry)
  return not (flowKind and entryKind and flowKind ~= entryKind)
end

function identity.workflowFor(config, entry)
  if not entry then return nil end
  local fallback, fallbackCount = nil, 0
  for index, row in ipairs((config or {}).workflows or {}) do
    if identity.sameKey(row, entry) then return row, "exact", index end
    if entry.name and not row.name and identity.compatibleFlow(row, entry)
      and identity.labelKey(row) == identity.labelKey(entry) then
      fallback, fallbackCount = { row = row, index = index }, fallbackCount + 1
    end
  end
  if fallbackCount == 1 then return fallback.row, "legacy_label", fallback.index end
  return nil
end

function identity.copyIdentity(row, entry)
  if not (row and entry) then return row end
  row.label = entry.label or row.label
  if entry.rawLabel ~= nil then row.rawLabel = entry.rawLabel end
  if entry.name ~= nil then row.name = entry.name end
  if entry.damage ~= nil then row.damage = entry.damage end
  if entry.hasTag ~= nil then row.hasTag = binding.tagged(entry.hasTag) end
  if entry.kind ~= nil or entry.isFluid ~= nil or entry.name ~= nil or fluidProxy(entry) then
    local kind = identity.kindFor(entry)
    row.kind, row.isFluid = kind, kind == "fluid"
  end
  if entry.amount ~= nil then row.amount = entry.amount end
  if entry.filter ~= nil then row.filter = entry.filter end
  local marker = binding.copyCraftBinding(entry)
  if marker then row.craftBinding = marker
  else row.craftBinding = nil end
  row.stockBinding = binding.copyPersistedStockBinding(entry)
  return row
end

return identity
-- Canonical config compaction is isolated because it is the one workflow
-- operation that must reconcile exact rows and legacy label-only rows.
local compact = {}

local policyFields = {
  "mode", "lineIntent", "lineAuthority", "alertEnabled", "alertBelow", "maxRequest",
  "maxBasis", "confidence", "recipeMax", "dangerUnlocked", "locked",
  "minStock", "craftTo", "batch", "minBatteryRatio", "maxDeficitRatio",
  "requireReadyCpu", "cooldown", "armed"
}

local function copyPolicy(target, source)
  for _, key in ipairs(policyFields) do target[key] = source[key] end
  return target
end

local function compactIndex(row) return tonumber(row and row._compactIndex) or 0 end

function compact.config(config, defaultConfig, normalize, identity)
  config = config or defaultConfig()
  local exact, exactByLabel, legacy, keep = {}, {}, {}, {}
  for index, row in ipairs(config.workflows or {}) do
    row = normalize(row)
    row._compactIndex = index
    if row.name then
      local key = identity.keyFor(row)
      if exact[key] then
        -- A pre-ID row may collapse into a later already-identified duplicate.
        -- Preserve the durable ID rather than minting a new identity for the
        -- surviving semantic row.
        if exact[key].workflowId == nil and row.workflowId ~= nil then
          exact[key].workflowId = row.workflowId
        end
        if index > compactIndex(exact[key]) then
          identity.copyIdentity(exact[key], row)
          copyPolicy(exact[key], row)
          exact[key]._compactIndex = index
        end
      else
        exact[key], keep[#keep + 1] = row, row
      end
    else
      legacy[#legacy + 1] = row
    end
  end
  for _, row in pairs(exact) do
    local key = identity.labelKey(row)
    exactByLabel[key] = exactByLabel[key] or {}
    exactByLabel[key][#exactByLabel[key] + 1] = row
  end
  local legacyByKey = {}
  for _, row in ipairs(legacy) do
    local candidates = {}
    for _, candidate in ipairs(exactByLabel[identity.labelKey(row)] or {}) do
      if identity.compatibleFlow(row, candidate) then candidates[#candidates + 1] = candidate end
    end
    if #candidates == 1 then
      local exactRow, legacyIndex = candidates[1], compactIndex(row)
      if legacyIndex > compactIndex(exactRow) then copyPolicy(exactRow, row); exactRow._compactIndex = legacyIndex end
    else
      local key = tostring(identity.explicitKind(row) or "") .. "|" .. identity.labelKey(row)
      if legacyByKey[key] then
        copyPolicy(legacyByKey[key], row)
        legacyByKey[key]._compactIndex = compactIndex(row)
      else
        legacyByKey[key], keep[#keep + 1] = row, row
      end
    end
  end
  table.sort(keep, function(a, b) return compactIndex(a) < compactIndex(b) end)
  local rows = {}
  for _, row in ipairs(keep) do row._compactIndex = nil; rows[#rows + 1] = normalize(row) end
  return { autoEnabled = config.autoEnabled ~= false, workflows = rows }
end

return compact
-- Guarded recipe onboarding is deliberately separate from the normal local
-- workflow catalog. Metadata scanning is an explicit maintenance operation;
-- committing one result performs only exact Craftable-handle verification and
-- never submits a craft request. Older bridges use one filtered compatibility
-- lookup at this explicit, daemon-quiesced boundary.
local binding = require("oc.ae2.request_binding")
local discovery = require("oc.ae2.craft_discovery")
local gridReadGuard = require("oc.ae2.grid_read_guard")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")
local authority = require("oc.ae2.workflow_onboarding_authority")

local onboarding = {}

local sessionKind = "ae2_workflow_onboarding_v1"
local defaultScanLimit, maxScanLimit = 64, 384
local defaultCandidateLimit, maxCandidateLimit = 64, 128

local function trim(value)
  return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function boundedInteger(value, fallback, maximum)
  value = math.floor(tonumber(value) or fallback)
  if value < 1 then value = 1 end
  if value > maximum then value = maximum end
  return value
end

local function maintenanceReady(receipt, expectedGeneration)
  if type(receipt) ~= "table" then return false, "prepare onboarding maintenance before craft discovery" end
  if expectedGeneration ~= nil
      and tonumber(receipt.maintenanceGeneration) ~= tonumber(expectedGeneration) then
    return false, "maintenance ownership changed; prepare onboarding again"
  end
  local ok, ready, reason, status = pcall(authority.poll, receipt)
  if not ok then return false, "could not verify onboarding maintenance: " .. tostring(ready) end
  if ready ~= true then return false, reason or (status and status.reason) or "daemon is still stopping" end
  return true, nil, status
end

local function pendingClear()
  if type(store.hasPending) ~= "function" then return true end
  local ok, pending = pcall(store.hasPending)
  if not ok then return false, "could not verify pending workflow edits: " .. tostring(pending) end
  if pending then
    return false, "save or discard the pending workflow edit before craft onboarding"
  end
  return true
end

local function workflowIndex(value)
  if value == nil then return nil end
  local index = tonumber(value)
  if not index or index < 1 or index ~= math.floor(index) then
    return nil, "workflow index must be a positive whole number"
  end
  return index
end

local function editableConfig()
  local ok, config, reason = pcall(store.editableConfig)
  if not ok then return nil, tostring(config) end
  if type(config) ~= "table" or type(config.workflows) ~= "table" then
    return nil, reason or "workflow config is unavailable"
  end
  return config
end

local function copyMap(source)
  local out = {}
  for key, value in pairs(type(source) == "table" and source or {}) do out[key] = value end
  return out
end

local function compactCandidate(entry)
  entry = type(entry) == "table" and entry or {}
  local out = {}
  model.copyIdentity(out, entry)
  out.label = tostring(out.label or entry.label or entry.rawLabel or entry.name or "unknown")
  out.rawLabel = entry.rawLabel and tostring(entry.rawLabel) or nil
  out.name = entry.name and tostring(entry.name) or nil
  out.hasTag = binding.tagged(entry.hasTag)
  out.kind = (out.kind == "fluid" or out.isFluid == true) and "fluid" or "item"
  out.isFluid = out.kind == "fluid"
  out.damage = out.isFluid and nil or entry.damage
  out.amount = entry.amount
  if out.name then
    out.filter = { name = out.name }
    if not out.isFluid and out.damage ~= nil then out.filter.damage = out.damage end
  end
  if type(entry.source) == "table" then
    out.source = {
      address = entry.source.address, type = entry.source.type, mode = entry.source.mode
    }
  end
  return out
end

local function candidateKey(entry)
  if entry and entry.name and entry.name ~= "" then
    local parts = {
      tostring(entry.kind or (entry.isFluid and "fluid" or "item")),
      tostring(entry.name), tostring(entry.damage or ""), tostring(binding.tagged(entry.hasTag))
    }
    if binding.tagged(entry.hasTag) then parts[#parts + 1] = tostring(entry.rawLabel or entry.label or "") end
    return table.concat(parts, "|")
  end
  return "label|" .. model.keyFor(entry)
end

local function candidateLess(left, right)
  local leftLabel, rightLabel = tostring(left.label or ""):lower(), tostring(right.label or ""):lower()
  if leftLabel ~= rightLabel then return leftLabel < rightLabel end
  return candidateKey(left) < candidateKey(right)
end

local function release(session)
  session.candidates, session.candidateKeys, session.policyTemplate = nil, nil, nil
  session.cursors, session.iterators, session.doneNodes, session.rawCounts = nil, nil, nil, nil
  if type(collectgarbage) == "function" then pcall(collectgarbage, "collect") end
end

local function activeSession(session)
  if type(session) ~= "table" or session.kind ~= sessionKind then
    return false, "onboarding session is not active"
  end
  if session.state == "disposed" or session.state == "committed" then
    return false, "onboarding session is not active: " .. tostring(session.state)
  end
  return true
end

local function progressReport(session)
  return {
    session = session,
    candidates = session.candidates or {},
    scanned = tonumber(session.scanned) or 0,
    matched = tonumber(session.matched) or 0,
    complete = session.complete == true,
    capped = session.capped == true,
    error = session.error,
    errors = session.errors or {},
    progress = {
      state = session.state, scanned = tonumber(session.scanned) or 0,
      matched = tonumber(session.matched) or 0,
      candidates = #(session.candidates or {}), limit = session.maxCandidates,
      complete = session.complete == true, capped = session.capped == true
    }
  }
end

function onboarding.begin(query, targetConfigIndex, maintenanceReceipt, policyTemplate)
  query = trim(query)
  if #query < 2 then return nil, "craft search requires at least 2 characters" end
  if #query > 96 then return nil, "craft search is limited to 96 characters" end
  local allowed, guardErr = gridReadGuard.check("allItems")
  if not allowed then return nil, guardErr end
  local index, indexReason = workflowIndex(targetConfigIndex)
  if targetConfigIndex ~= nil and not index then return nil, indexReason end
  local ready, readyReason = maintenanceReady(maintenanceReceipt)
  if not ready then return nil, readyReason end
  local clear, clearReason = pendingClear()
  if not clear then return nil, clearReason end
  if index then
    local config, configReason = editableConfig()
    if not config then return nil, configReason end
    if not config.workflows[index] then
      return nil, "workflow index " .. tostring(index) .. " does not exist"
    end
  end
  return {
    kind = sessionKind, state = "ready", query = query, targetConfigIndex = index,
    policyTemplate = policyTemplate and model.normalize(policyTemplate) or nil,
    maintenanceReceipt = maintenanceReceipt,
    maintenanceGeneration = tonumber(maintenanceReceipt.maintenanceGeneration),
    candidates = {}, candidateKeys = {}, cursors = {}, iterators = {}, doneNodes = {}, rawCounts = {},
    scanned = 0, matched = 0, complete = false, capped = false, errors = {}
  }
end

function onboarding.step(session, options)
  local active, activeReason = activeSession(session)
  if not active then return nil, activeReason end
  local ready, readyReason = maintenanceReady(session.maintenanceReceipt, session.maintenanceGeneration)
  if not ready then return nil, readyReason end
  if session.complete then return progressReport(session) end

  options = options or {}
  local scanLimit = boundedInteger(options.scanLimit, defaultScanLimit, maxScanLimit)
  session.maxCandidates = session.maxCandidates
    or boundedInteger(options.maxCandidates, defaultCandidateLimit, maxCandidateLimit)
  local remaining = math.max(0, session.maxCandidates - #(session.candidates or {}))
  if remaining == 0 then
    session.complete, session.capped, session.state = true, true, "capped"
    return progressReport(session)
  end

  session.state = "scanning"
  local ok, report = pcall(discovery.discoverAllMetadata, nil, {
    query = session.query, scanAll = true, scanLimit = scanLimit,
    maxEntries = remaining, stopAfterMaxEntries = true,
    cursors = session.cursors, iterators = session.iterators,
    doneNodes = session.doneNodes, rawCounts = session.rawCounts
  })
  if not ok or type(report) ~= "table" then
    session.state, session.error = "error", "craft metadata scan failed: " .. tostring(report)
    return progressReport(session)
  end

  session.scanned = session.scanned + (tonumber(report.scanned) or 0)
  session.matched = session.matched + (tonumber(report.matched) or #(report.entries or {}))
  session.cursors, session.iterators = copyMap(report.cursors), copyMap(report.iterators)
  session.doneNodes, session.rawCounts = copyMap(report.doneNodes), copyMap(report.rawCounts)
  for _, entry in ipairs(report.entries or {}) do
    local candidate = compactCandidate(entry)
    local key = candidateKey(candidate)
    if not session.candidateKeys[key] and #session.candidates < session.maxCandidates then
      session.candidateKeys[key] = true
      session.candidates[#session.candidates + 1] = candidate
    end
  end
  table.sort(session.candidates, candidateLess)

  session.errors = {}
  for _, value in ipairs(report.errors or {}) do session.errors[#session.errors + 1] = tostring(value) end
  session.error = report.error and tostring(report.error) or nil
  if #(session.candidates or {}) > 0 then session.error = nil end
  session.capped = report.capped == true or #session.candidates >= session.maxCandidates
  session.complete = report.complete == true or session.capped
  if session.capped then session.state = "capped"
  elseif session.complete then session.state = "complete"
  elseif session.error then session.state = "error"
  else session.state = "ready" end
  return progressReport(session)
end

function onboarding.commit(session, candidateIndex)
  return require("oc.ae2.workflow_onboarding_commit").run(session, candidateIndex, {
    activeSession = activeSession, maintenanceReady = maintenanceReady, pendingClear = pendingClear,
    editableConfig = editableConfig, release = release
  })
end

function onboarding.dispose(session)
  if type(session) ~= "table" or session.kind ~= sessionKind then return false end
  if session.state ~= "committed" then session.state = "disposed" end
  release(session)
  return true
end

return onboarding
-- Exclusive daemon authority transaction for guarded recipe onboarding.
-- A ticket owns one disabled config generation, so stale UI receipts cannot
-- pass after an off/on/off ABA cycle or restore somebody else's ownership.
local computer = require("computer")
local daemonConfig = require("oc.ae2.maintainer_daemon_config")
local daemonControl = require("oc.ae2.maintainer_daemon_control")
local gridReadGuard = require("oc.ae2.grid_read_guard")
local maintainerState = require("oc.ae2.maintainer_state")

local authority = {}
local ticketKind = "ae2_onboarding_maintenance_v1"

local function validTicket(ticket)
  if type(ticket) ~= "table" or ticket.kind ~= ticketKind
      or tonumber(ticket.maintenanceGeneration) == nil then
    return false, "onboarding maintenance ticket is invalid"
  end
  return true
end

local function statusFor(ticket, worker, state, ready, reason)
  worker = type(worker) == "table" and worker or {}
  local out = {
    ready = ready == true,
    quiescent = ready == true,
    state = state,
    reason = reason,
    ownerGeneration = tonumber(ticket and ticket.ownerGeneration),
    maintenanceGeneration = tonumber(ticket and ticket.maintenanceGeneration),
    restoreRequired = ticket and ticket.restoreRequired == true,
    acknowledgementRequired = ticket and ticket.acknowledgementRequired == true,
    workerState = worker.workerState,
    stoppedGeneration = tonumber(worker.stoppedGeneration),
    stoppedAt = tonumber(worker.stoppedAt),
    stopReason = worker.stopReason,
    readFailed = worker.readFailed == true,
    readError = worker.readError,
    readRetryable = worker.readRetryable == true
  }
  if ready then
    if out.acknowledgementRequired then
      out.proof = "worker exit generation " .. tostring(out.ownerGeneration) .. " acknowledged"
    else
      out.proof = "no active worker in generation " .. tostring(out.ownerGeneration)
    end
  end
  return out
end

local function ownership(ticket)
  local cfg = daemonConfig.load()
  if cfg.enabled == true or tonumber(cfg.generation) ~= tonumber(ticket.maintenanceGeneration) then
    local reason = "maintenance ownership changed; prepare onboarding again"
    return nil, reason, statusFor(ticket, maintainerState.status(), "stop_failed", false, reason)
  end
  return cfg
end

function authority.poll(ticket)
  local valid, validReason = validTicket(ticket)
  if not valid then return false, validReason, { ready = false, state = "stop_failed", reason = validReason } end
  local cfg, ownerReason, ownerStatus = ownership(ticket)
  if not cfg then return false, ownerReason, ownerStatus end
  local worker = maintainerState.status()
  if worker.readFailed == true then
    local reason = "waiting for exact daemon stop proof: " .. tostring(worker.readError or worker.lastError)
    local retryable = worker.readRetryable == true
    local pollReason = nil
    if not retryable then pollReason = reason end
    return false, pollReason,
      statusFor(ticket, worker, retryable and "stopping" or "stop_failed", false, reason)
  end
  local acknowledged = ticket.acknowledgementRequired ~= true
    or (worker.workerState == "stopped"
      and tonumber(worker.stoppedGeneration) == tonumber(ticket.ownerGeneration))
  if acknowledged then return true, nil, statusFor(ticket, worker, "quiescent", true) end
  return false, nil, statusFor(ticket, worker, "stopping", false,
    "waiting for daemon generation " .. tostring(ticket.ownerGeneration) .. " to exit")
end

local function prepareQuiescence()
  local beforeConfig = daemonConfig.load()
  local beforeStatus = daemonControl.status()
  local ownerGeneration = tonumber(beforeConfig.generation) or 0
  local stateUncertain = beforeStatus.readFailed == true
    or beforeStatus.stateReadPending == true
  local ownerObserved = tonumber(beforeStatus.generation) == ownerGeneration
    and (beforeStatus.workerState == "running" or beforeStatus.fresh == true)
  local stopped, stopReason = daemonControl.stop()
  if not stopped then
    return nil, stopReason, { ready = false, state = "stop_failed", reason = stopReason }
  end
  local disabled = daemonConfig.load()
  local ticket = {
    kind = ticketKind,
    ownerGeneration = ownerGeneration,
    maintenanceGeneration = tonumber(disabled.generation),
    restoreRequired = beforeConfig.enabled == true,
    acknowledgementRequired = ownerObserved == true or stateUncertain,
    preparedAt = computer.uptime()
  }
  local ready, reason, status = authority.poll(ticket)
  status.ready = ready == true
  return ticket, reason, status
end

-- Local owner-state cleanup needs the same generation-fenced stop proof as
-- onboarding, but it never reads the AE2 grid. Keep that safe transaction
-- available while live whole-grid discovery is quarantined.
function authority.prepareQuiescence()
  return prepareQuiescence()
end

function authority.prepare()
  local allowed, guardErr = gridReadGuard.check("allItems")
  if not allowed then
    return nil, guardErr, {
      ready = false,
      state = "grid_snapshot_blocked",
      reason = guardErr,
      gridReadMode = gridReadGuard.mode,
      gridSnapshotBlocked = true
    }
  end
  return prepareQuiescence()
end

function authority.restore(ticket)
  local valid, validReason = validTicket(ticket)
  if not valid then return false, validReason, { state = "restore_failed", reason = validReason } end
  if ticket.restoredGeneration ~= nil then
    local cfg = daemonConfig.load()
    if cfg.enabled == true and tonumber(cfg.generation) == tonumber(ticket.restoredGeneration) then
      local status = daemonControl.status()
      status.restored, status.state = true, "restored"
      return true, nil, status
    end
    local reason = "daemon ownership changed after onboarding restore"
    return false, reason, { state = "restore_failed", reason = reason }
  end
  local ready, reason, preparation = authority.poll(ticket)
  if not ready then return false, reason or preparation.reason, preparation end
  if ticket.restoreRequired ~= true then
    ticket.restored = true
    preparation.restored, preparation.state = false, "left_off"
    preparation.desiredEnabled = false
    return true, nil, preparation
  end
  local ok, startReason, status = daemonControl.start({
    expectedGeneration = ticket.maintenanceGeneration,
    deferFirstTick = true
  })
  if not ok then
    status = status or {}
    status.state, status.reason = "restore_failed", startReason
    return false, startReason, status
  end
  local cfg = daemonConfig.load()
  ticket.restored, ticket.restoredGeneration = true, tonumber(cfg.generation)
  status = status or daemonControl.status()
  status.restored, status.state = true, "restored"
  return true, nil, status
end

return authority
-- Exact candidate verification and durable binding for guarded onboarding.
-- Session lifecycle and metadata scanning remain in workflow_onboarding.lua.
local binding = require("oc.ae2.request_binding")
local direct = require("oc.ae2.request_direct")
local model = require("oc.ae2.workflow_model")
local store = require("oc.ae2.workflow_store")

local commit = {}

local function exactSame(left, right)
  if not (left and right and left.name and right.name) then return false end
  local leftFlow, rightFlow = model.normalize(left), model.normalize(right)
  if binding.tagged(leftFlow.hasTag) ~= binding.tagged(rightFlow.hasTag) then return false end
  if leftFlow.kind ~= rightFlow.kind or tostring(leftFlow.name) ~= tostring(rightFlow.name) then return false end
  if leftFlow.kind == "fluid" then return true end
  if tonumber(leftFlow.damage) ~= tonumber(rightFlow.damage) then return false end
  if binding.tagged(leftFlow.hasTag) then
    local leftMarker = binding.copyCraftBinding(leftFlow) or binding.makeCraftBinding(leftFlow)
    local rightMarker = binding.copyCraftBinding(rightFlow) or binding.makeCraftBinding(rightFlow)
    return leftMarker ~= nil and rightMarker ~= nil
      and leftMarker.mode == rightMarker.mode and leftMarker.label == rightMarker.label
      and leftMarker.rawLabel == rightMarker.rawLabel
  end
  return true
end

local function destination(config, candidate, targetConfigIndex)
  for index, row in ipairs(config.workflows or {}) do
    if index ~= targetConfigIndex and exactSame(row, candidate) then
      return nil, "exact target is already managed by workflow index " .. tostring(index)
    end
  end

  if targetConfigIndex then
    local row = config.workflows[targetConfigIndex]
    if not row then return nil, "workflow index " .. tostring(targetConfigIndex) .. " does not exist" end
    local replacingTagged = binding.tagged(row.hasTag) and binding.error(row) ~= nil
    local normalized = model.normalize(row)
    if normalized.locked then return nil, "line contract locked" end
    if row.name and tostring(row.name) ~= "" and not replacingTagged then
      return nil, "workflow index " .. tostring(targetConfigIndex)
        .. " already has a different exact binding; use the explicit rebind command"
    end
    -- An unverified legacy tagged identity may be repaired after the operator
    -- selects a candidate and exact server verification below succeeds. A
    -- valid tagged marker is already owned and requires deliberate rebind.
    return { action = "bound", index = targetConfigIndex, row = row, replacedTagged = replacingTagged }
  end

  local matchedIndex, matchedCount = nil, 0
  for index, row in ipairs(config.workflows or {}) do
    if not row.name and model.labelKey(row) == model.labelKey(candidate) then
      local rowKind = model.normalize(row).kind
      if rowKind == candidate.kind then matchedIndex, matchedCount = index, matchedCount + 1 end
    end
  end
  if matchedCount > 1 then
    return nil, "multiple label-only workflows match; select the policy row to bind"
  end
  if matchedIndex then
    local row = config.workflows[matchedIndex]
    if binding.tagged(row.hasTag) then return nil, "tagged legacy workflow needs explicit Repair Identity selection" end
    if model.normalize(row).locked then return nil, "line contract locked" end
    return { action = "bound", index = matchedIndex, row = row }
  end
  return { action = "added", index = #config.workflows + 1 }
end

local function verify(candidate, craftCompatibility)
  local ok, entry, reason, report = pcall(direct.resolve, candidate, {
    directNodeLimit = 3,
    onboardingCapacity = binding.capacityCell(candidate),
    onboardingTagged = binding.tagged(candidate),
    compatibilityFallback = true,
    compatibilityNodeLimit = 1,
    compatibilityCallLimit = 1,
    compatibilityHandleLimit = 16,
    craftCompatibility = craftCompatibility,
    remember = false
  })
  if not ok then return nil, tostring(entry), { direct = true, error = tostring(entry) } end
  return entry, reason, report
end

local function applyIdentity(row, candidate)
  model.copyIdentity(row, candidate)
  if candidate.kind == "fluid" or candidate.isFluid == true then row.damage = nil else row.damage = candidate.damage end
  row.hasTag = binding.tagged(candidate.hasTag)
  return row
end

function commit.run(session, candidateIndex, support)
  local active, activeReason = support.activeSession(session)
  if not active then return false, activeReason end
  local ready, readyReason = support.maintenanceReady(session.maintenanceReceipt, session.maintenanceGeneration)
  if not ready then return false, readyReason end
  local clear, clearReason = support.pendingClear()
  if not clear then return false, clearReason end

  local index = tonumber(candidateIndex)
  if not index or index < 1 or index ~= math.floor(index) then
    return false, "candidate index must be a positive whole number"
  end
  local candidate = session.candidates and session.candidates[index]
  if not candidate then return false, "candidate index " .. tostring(index) .. " does not exist" end
  local bindReason = binding.onboardingError(candidate)
  if bindReason then return false, bindReason end

  local config, configReason = support.editableConfig()
  if not config then return false, configReason end
  local planned, planReason = destination(config, candidate, session.targetConfigIndex)
  if not planned then return false, planReason end

  local exact, exactReason, verification = verify(candidate, model.craftCompatibility(config))
  if not exact then
    return false, exactReason or "exact recipe verification failed", {
      action = "blocked", label = candidate.label, name = candidate.name,
      damage = candidate.damage, kind = candidate.kind, verification = verification
    }
  end
  if binding.tagged(candidate) then
    candidate.craftBinding = binding.copyCraftBinding(exact)
    if not candidate.craftBinding then
      return false, "BIND EXACT TARGET REQUIRED: tagged verification did not return a durable binding", {
        action = "blocked", label = candidate.label, name = candidate.name,
        damage = candidate.damage, kind = candidate.kind, verification = verification
      }
    end
  else
    candidate.craftBinding = nil
  end

  ready, readyReason = support.maintenanceReady(session.maintenanceReceipt, session.maintenanceGeneration)
  if not ready then return false, readyReason end
  clear, clearReason = support.pendingClear()
  if not clear then return false, clearReason end
  config, configReason = support.editableConfig()
  if not config then return false, configReason end
  planned, planReason = destination(config, candidate, session.targetConfigIndex)
  if not planned then return false, planReason end

  local row
  if planned.action == "added" then
    row = applyIdentity(model.normalize(session.policyTemplate or candidate), candidate)
    row.mode, row.lineAuthority, row.armed = "manual", "observe", false
    config.workflows[#config.workflows + 1] = row
  else
    row = applyIdentity(planned.row, candidate)
    row.armed = false
  end

  local saveCalled, saved, saveReason = pcall(store.saveConfig, config, true)
  if not saveCalled then return false, tostring(saved) end
  if not saved then return false, saveReason end

  local dashboardCacheWarm, dashboardCacheReason = false, nil
  local cacheLoaded, cache = pcall(require, "oc.ae2.request_cache")
  if cacheLoaded and cache and type(cache.remember) == "function" then
    local rememberCalled, remembered, rememberReason = pcall(cache.remember, exact)
    dashboardCacheWarm = rememberCalled and remembered ~= nil
    if dashboardCacheWarm then
      dashboardCacheReason = nil
    elseif not rememberCalled then
      dashboardCacheReason = tostring(remembered)
    elseif rememberReason ~= nil then
      dashboardCacheReason = tostring(rememberReason)
    else
      dashboardCacheReason = "verified handle could not be retained"
    end
  elseif not cacheLoaded then
    dashboardCacheReason = tostring(cache)
  end
  local receipt = {
    action = planned.action, index = planned.index, configIndex = planned.index,
    label = candidate.label, name = candidate.name, damage = candidate.damage,
    kind = candidate.kind, armed = false, replacedTagged = planned.replacedTagged == true,
    verification = verification,
    -- A Craftable is executable process memory, not durable policy. Name the
    -- cache owner explicitly so a successful Dashboard bind never implies
    -- that the separately running daemon is warm.
    dashboardCacheWarm = dashboardCacheWarm,
    dashboardCacheReason = dashboardCacheReason
  }
  session.state, session.complete = "committed", true
  support.release(session)
  return true, nil, receipt
end

return commit
local store = require("oc.ae2.workflow_store")
local model = require("oc.ae2.workflow_model")
local binding = require("oc.ae2.request_binding")
local fluidProfile = require("oc.ae2.fluid_stock_profile")

local printer = {}

local function tagged(row) return binding.tagged(row) end

local function bindingText(row)
  row = row or {}
  local bindErr = binding.error(row)
  if tagged(row) and bindErr then return "BLOCKED tagged variant" end
  local kind = (row.kind == "fluid" or row.isFluid == true) and "fluid" or "item"
  if not row.name or tostring(row.name) == "" then return "BIND REQUIRED" end
  if kind == "item" and row.damage == nil then return "BIND REQUIRED item damage" end
  local marker = type(row.craftBinding) == "table" and row.craftBinding.mode or nil
  local mode = marker == binding.taggedLabelMode and "tagged-visible" or kind
  return string.format("BOUND %s %s dmg=%s", mode, tostring(row.name),
    kind == "fluid" and "-" or tostring(row.damage))
end

local function stockBindingText(row, globalStatus, reviewedSet)
  row = row or {}
  local kind = (row.kind == "fluid" or row.isFluid == true) and "fluid" or "item"
  if kind ~= "fluid" then return "stock=scalar" end
  if globalStatus and globalStatus.active then
    if tostring(row.name or "") == tostring(globalStatus.canaryFluid) then return "stock=GLOBAL CANARY CONFLICT" end
    if not tagged(row) and binding.validFluidName(row.name) and reviewedSet[row.name] then
      return "stock=GLOBAL AE2FC exact-NBT"
    end
  end
  local marker = binding.copyStockBinding(row)
  if marker then
    return string.format("stock=AE2FC-NBT LOCKED canary=%s topo=%s",
      tostring(marker.canaryFluid), tostring(marker.topologyRevision))
  end
  return "stock=native-scalar / legacy BIND REQUIRED"
end

function printer.print()
  local config = store.load()
  io.write("AE2 workflows (config index)\n")
  for i, row in ipairs(config.workflows or {}) do
    io.write(string.format("#%02d %s %s intent=%s authority=%s below=%s max=%s\n",
      i, row.mode, row.label, row.lineIntent, row.lineAuthority, row.alertBelow or row.minStock, row.maxRequest or row.batch))
  end
end

function printer.printBindings()
  local config = store.load()
  local globalStatus = fluidProfile.status(config.fluidStockCompatibility, nil, config)
  local reviewedSet = fluidProfile.targetSet(config).set
  io.write("AE2 exact bindings (no AE2 query)\n")
  if globalStatus.active then
    io.write(string.format("Fluid Stock global: AE2FC exact-NBT LOCKED canary=%s topology=%s host=%s enrolled=%s\n",
      tostring(globalStatus.canaryFluid), tostring(globalStatus.topologyRevision), tostring(globalStatus.hostId),
      tostring(globalStatus.reviewedFluidCount or 0)))
  elseif globalStatus.state == "blocked" then
    io.write("Fluid Stock global: BLOCKED " .. tostring(globalStatus.error) .. "\n")
  else
    io.write("Fluid Stock global: DISABLED (native scalar only)\n")
  end
  for index, row in ipairs(config.workflows or {}) do
    local normalized = model.normalize(row)
    io.write(string.format("%02d %-24s %s | %s\n", index, tostring(normalized.label),
      bindingText(row), stockBindingText(normalized, globalStatus, reviewedSet)))
  end
  printer.printBindHelp()
end

function printer.printBindHelp()
  io.write("recorded identities: ae2-workflow evidence\n")
  io.write("capture once: ae2-workflow capture-next\n")
  io.write("reconcile recorded: ae2-workflow reconcile [index] [CONFIRM]\n")
  io.write("normal operation learns structured AE2 CPU finalOutput once, stores it durably, and reuses it without registry/NBT input or a grid scan.\n")
  io.write("add new exact target: ae2-workflow add-exact <item|fluid> <registry-name> <damage|-> <display-label...> CONFIRM\n")
  io.write("bind: ae2-workflow bind <index> <item|fluid> <registry-name> <damage|->\n")
  io.write("rebind: ae2-workflow rebind <index> <item|fluid> <registry-name> <damage|-> CONFIRM\n")
  io.write("legacy fluid stock: ae2-workflow bind-fluid-stock <index> <positive-canary-fluid> <topology-revision> CONFIRM\n")
  io.write("remove legacy fluid stock: ae2-workflow unbind-fluid-stock <index> CONFIRM\n")
  io.write("item requires namespace:path plus non-negative damage; fluid accepts an exact safe Forge ID (including aqua regia) and requires -.\n")
  io.write("add-exact is an emergency compatibility path: it performs no AE2 query and creates one manual, disarmed, unlocked, observe-only row.\n")
  io.write("bind/rebind preserve existing policy and refuse armed, locked, tagged, or already-owned identities.\n")
  io.write("index is the current config row from list/show-bind; recheck it after deleting or editing workflows.\n")
  io.write("bind is first migration only; rebind corrects an existing exact identity and requires CONFIRM.\n")
  io.write("legacy row fluid-stock CONFIRM records canary/topology revision compatibility metadata only; it does not measure v3 capability or prove physical isolation.\n")
  io.write("choose a different canary and keep at least 1 mB of it; legacy binding performs no AE2 query, preserves craft identity, and leaves the row disarmed.\n")
  io.write("legacy global parser only: ae2-workflow set-fluid-stock-global <positive-canary-fluid> <topology-revision> CONFIRM\n")
  io.write("disable global fluid stock: ae2-workflow clear-fluid-stock-global CONFIRM\n")
  io.write("current v3 commissioning starts on release finalize/config migration and resumes from the exact finalized AE2 RC boot; no Configure/Attest step is required.\n")
  io.write("v3 authority measures one exact positive AE2FC canary on the exact current grid and records a declared dedicated stock-domain invariant; the API measurement cannot prove external or nested inventories are physically absent.\n")
  io.write("current and later exact ordinary Auto fluids enroll without a profile rewrite; host/grid drift or canary membership blocks instead of guessing.\n")
  io.write("selected reconcile ignores unrelated CPU work; fleet reconcile retains grid-wide CPU/final-output quiescence.\n")
  io.write("compatibility only: lua /usr/bin/ae2-workflow --bind ... or lua /usr/bin/ae2-workflow --add-exact ... accepts legacy leading -- forms; installed ae2-workflow commands must use positional forms above.\n")
end

return printer
local computer = require("computer")

local budget = require("oc.ae2.budget")
local cacheEpoch = require("oc.ae2.cache_epoch")
local maintainerLog = require("oc.ae2.maintainer_log")
local maintainerQueue = require("oc.ae2.maintainer_queue")
local maintainerStateOk, maintainerState = pcall(require, "oc.ae2.maintainer_state")
local requestCache = require("oc.ae2.request_cache")
local requestTracker = require("oc.ae2.request_tracker")
local requester = require("oc.ae2.requester")
local workflowModel = require("oc.ae2.workflow_model")

local requests = {}

local function confirmed(report)
  return report and report.requestState == "running" and report.requestPhase == "submitted"
end

local function completed(report)
  return report and report.requestState == "done"
end

local function failed(report)
  local state = report and report.requestState
  return state == "blocked" or state == "failed" or state == "canceled"
end

local function applyReport(entry, amount, report)
  if not entry then return end
  entry.request = amount
  entry.requestState = report and report.requestState
  entry.requestPhase = report and report.requestPhase
  entry.requestStatusReason = report and report.requestStatusReason
  entry.requestStatusRawReason = report and report.requestStatusRawReason
  entry.requestError = failed(report) and (entry.requestStatusReason or entry.requestState) or nil
end

function requests.observeManual(entry, report, now)
  report = type(report) == "table" and report or {}
  now = tonumber(now) or computer.uptime()
  local amount = tonumber(report.amount) or tonumber(entry and entry.request) or 1
  applyReport(entry, amount, report)
  if not maintainerStateOk or type(maintainerState) ~= "table" then
    return nil, "maintainer lifecycle state unavailable: " .. tostring(maintainerState)
  end
  local recorder = confirmed(report) and maintainerState.recordManualBatch or maintainerState.recordManualStatus
  if type(recorder) ~= "function" then return nil, "maintainer lifecycle recorder unavailable" end
  local called, saved, saveErr = pcall(recorder, entry, now, report)
  if not called then return nil, tostring(saved) end
  if saved ~= true then return nil, tostring(saveErr or "maintainer lifecycle save failed") end
  if confirmed(report) and report.manualConfirmed ~= true then
    cacheEpoch.recordManualBatch(entry, now)
    maintainerQueue.markManual(entry, now)
    report.manualConfirmed = true
  end
  if (confirmed(report) or completed(report)) and report.manualLogged ~= true then
    local logged, logErr = maintainerLog.append(entry, now, {
      amount = amount,
      source = "manual",
      requestKey = report.requestKey,
      submittedAt = report.submittedAt or now
    })
    if not logged then
      entry.logError = logErr
      return nil, tostring(logErr or "maintainer batch audit save failed")
    end
    entry.logError = nil
    report.manualLogged = logged == true
  end
  return true
end

local function prepareManualIntent(entry, amount)
  if not maintainerStateOk or type(maintainerState) ~= "table"
      or type(maintainerState.recordManualStatus) ~= "function" then
    return false, "maintainer lifecycle state unavailable"
  end
  local intentAt = computer.uptime()
  local requestKey = maintainerQueue.id(entry)
  local intent = {
    amount = amount, submittedAt = intentAt, requestKey = requestKey,
    requestState = "accepted", requestPhase = "confirmation_unavailable",
    requestStatusReason = "request confirmation unavailable: durable manual submit intent exists; AE2 invocation outcome not yet confirmed",
    requestTrackable = false, requestUnverified = true
  }
  local called, saved, saveErr = pcall(maintainerState.recordManualStatus, entry, intentAt, intent)
  if not called then return false, tostring(saved) end
  if saved ~= true then return false, tostring(saveErr or "manual submit intent save failed") end
  return true
end

function requests.requestManual(entry)
  -- Keep disk/config ownership out of lifecycle-only consumers such as the
  -- audit-log reconciler. Manual dispatch is the first path that needs it.
  local workflowStore = require("oc.ae2.workflow_store")
  local workflow = entry and entry.workflow
  local amount = tonumber(workflow and (workflow.maxRequest or workflow.batch))
    or tonumber(entry and (entry.maxRequest or entry.batch or entry.request)) or 1
  if not (entry and entry.label) then return nil, "no craft selected" end
  local bindErr = requestCache.bindingError(entry)
  if bindErr then return nil, bindErr, { bindingRequired = true, scans = 0, handles = 0 } end
  budget.trySpend("manual_action", { borrow = true })
  local now = computer.uptime()
  local status, err, report = requester.requestTarget(entry, amount, {
    prioritizePower = true,
    craftCompatibility = workflowModel.craftCompatibility(workflowStore.load()),
    beforeInvoke = function() return prepareManualIntent(entry, amount) end,
    track = { id = maintainerQueue.id(entry), amount = amount, submittedAt = now,
      label = entry.label, source = "manual", target = entry }
  })
  report = type(report) == "table" and report or {}
  report.amount = tonumber(report.amount) or amount
  report.submittedAt = tonumber(report.submittedAt) or now
  if report.requestState then
    local observedAt = computer.uptime()
    local called, observed, observeErr = pcall(requests.observeManual, entry, report, observedAt)
    if not called then observeErr, observed = observed, nil end
    report.recordPending = observed ~= true
    report.observationError = observeErr
    if observed == true and completed(report) and report.requestTrackable == true then
      requestTracker.acknowledge(report.requestKey)
    end
  end
  return status, err, report
end

return requests
local cacheEpoch = require("oc.ae2.cache_epoch")
local commissioningAuthority = require("oc.ae2.maintainer_commissioning_authority")
local model = require("oc.ae2.workflow_model")
local storeIo = require("oc.ae2.workflow_store_io")
local workflowId = require("oc.ae2.workflow_id")

local store = {}
local pendingConfig = nil
local maintenanceBrakeReason
local commissioningMutationReason

store.path = model.path
store.backupPath = model.path .. ".bak"

local function craftCompatibility(value)
  if type(model.craftCompatibility) == "function" then return model.craftCompatibility(value) end
  value = type(value) == "table" and value.craftCompatibility or value
  if value == "auto" or value == "legacy_filtered" or value == "scalar_only" then return value end
  return "scalar_only"
end

local function readAt(path)
  local text, readReason, present = storeIo.read(path)
  if text == nil then return nil, readReason, present end
  local value, decodeReason = storeIo.decode(path, text)
  if type(value) ~= "table" or type(value.workflows) ~= "table" then
    return nil, "invalid workflow config: " .. path, true
  end
  return model.compactConfig(value), nil, true, {
    text = text, value = value, oneLine = storeIo.oneLine(text)
  }
end

local function readExisting()
  local config, err, exists = readAt(store.path)
  if config then return config end
  -- If promotion stopped after primary -> .previous, the prior policy is the
  -- only confirmed authority. Read it without silently promoting/deleting it.
  local recovery = storeIo.recoveryStatus(store.path)
  if exists == false and (recovery.state == "restore_previous" or recovery.state == "promote_staged") then
    local prior, priorErr = readAt(store.path .. ".previous")
    if prior then return prior end
    err = err or priorErr
  end
  -- A backup is useful only when the canonical path is absent. If a primary
  -- exists but cannot be parsed, treating an old backup as live authority can
  -- keep automation running against policy the operator can no longer audit.
  -- Return the error so store.load falls back to disarmed defaults instead.
  if exists == true then return nil, err, true end
  local backup, backupErr, backupExists = readAt(store.backupPath)
  if backup then return backup end
  return nil, err or backupErr, exists or backupExists
end

local function writeSerialized(path, config, verifier, expectedPrimary)
  local ok, reason = storeIo.writeReadable(path, config, verifier, expectedPrimary)
  if not ok then return false, reason end
  return true, nil, config
end

local function deepEqual(left, right, seen)
  if type(left) ~= type(right) then return false end
  if type(left) ~= "table" then return left == right end
  seen = seen or {}
  if seen[left] == right then return true end
  seen[left] = right
  for key, value in pairs(left) do if not deepEqual(value, right[key], seen) then return false end end
  for key in pairs(right) do if left[key] == nil then return false end end
  return true
end

local function deepCopy(value, seen)
  if type(value) ~= "table" then return value end
  seen = seen or {}
  if seen[value] then return seen[value] end
  local copy = {}
  seen[value] = copy
  for key, nested in pairs(value) do copy[deepCopy(key, seen)] = deepCopy(nested, seen) end
  return copy
end

local function validIdentityFence(value)
  return type(value) == "table" and type(value.transactionId) == "string"
    and #value.transactionId <= 96 and value.transactionId:match("^[A-Za-z0-9][A-Za-z0-9_.%-]*$")
    and workflowId.validNamespace(value.namespace) and type(value.scopeDigest) == "string"
    and #value.scopeDigest <= 192 and type(value.beforeDigest) == "string"
    and #value.beforeDigest <= 192
end

local function fenceAllows(current, candidate, options)
  options = type(options) == "table" and options or {}
  local active = type(current) == "table" and current.identityMutationFence or nil
  local proposed = type(candidate) == "table" and candidate.identityMutationFence or nil
  if active ~= nil and not validIdentityFence(active) then
    return false, "workflow identity mutation fence is malformed; recovery is required"
  end
  if active then
    if options.identityTransactionId ~= active.transactionId then
      return false, "workflow identity reconciliation owns the mutation fence"
    end
    if proposed and proposed.transactionId ~= active.transactionId then
      return false, "authorized identity transaction cannot replace its fence"
    end
  elseif proposed then
    if options.installIdentityFence ~= true
        or options.identityTransactionId ~= proposed.transactionId
        or not validIdentityFence(proposed) then
      return false, "workflow identity mutation fence installation is unauthorized"
    end
  end
  return true
end

local function patchMaintainerState(saved)
  local maintainerStateOk, maintainerState = pcall(require, "oc.ae2.maintainer_state")
  if maintainerStateOk and maintainerState and maintainerState.patchTargets then
    pcall(function()
      maintainerState.patchTargets(model.asTargets(saved), nil, {
        autoEnabled = model.autoEnabled(saved), craftCompatibility = craftCompatibility(saved),
        fluidStockCompatibility = saved.fluidStockCompatibility
      })
    end)
  end
end

function store.load()
  local config = readExisting()
  return config or model.defaultConfig()
end

function store.migrationStatus()
  local recovery = storeIo.recoveryStatus(store.path)
  if recovery.state ~= "clean" then
    return {
      path = store.path, state = recovery.state, exists = recovery.primary.present == true,
      reason = recovery.reason or recovery.state, recovery = recovery
    }
  end
  local config, err, exists, source = readAt(store.path)
  if not exists then return { path = store.path, state = "missing", exists = false } end
  if not config then return { path = store.path, state = "invalid", exists = true, reason = err } end
  local rows, unbound, tagged = #(config.workflows or {}), 0, 0
  for _, row in ipairs(config.workflows or {}) do
    if not row.name or row.name == "" then unbound = unbound + 1 end
    if row.hasTag == true then tagged = tagged + 1 end
  end
  local sourceRows = type(source and source.value and source.value.workflows) == "table"
    and #source.value.workflows or rows
  return {
    path = store.path, state = source and source.oneLine and "legacy_one_line" or "readable",
    exists = true, bytes = #(source and source.text or ""), sourceRows = sourceRows, rows = rows,
    compacted = math.max(0, sourceRows - rows), unbound = unbound, tagged = tagged,
    config = config, raw = source and source.text or nil, rawValue = source and source.value or nil,
    preserved = true
  }
end

function store.recoveryStatus()
  return storeIo.recoveryStatus(store.path)
end

function store.recover()
  local blocked = commissioningMutationReason()
  if blocked then return false, blocked end
  return storeIo.recover(store.path)
end

function store.migrate()
  local blocked = commissioningMutationReason()
  if blocked then return false, blocked end
  if pendingConfig then return false, "flush or discard the pending workflow edit before migration" end
  local status = store.migrationStatus()
  if status.state == "missing" or status.state == "readable" then return true, nil, status end
  if status.state ~= "legacy_one_line" then return false, status.reason or "workflow config requires recovery or is invalid", status end
  if type(status.rawValue) == "table" and status.rawValue.identityMutationFence ~= nil then
    return false, "workflow identity reconciliation owns the mutation fence", status
  end
  local archive = store.path .. ".pre-migrate.bak"
  local archived, archiveReason = storeIo.writeRawNew(archive, status.raw)
  if not archived then return false, archiveReason, status end
  -- Formatting must preserve every parsed key and row exactly. Canonical
  -- compaction belongs to an explicit future maintenance action, never to a
  -- readability conversion.
  local saved, saveReason = writeSerialized(store.path, status.rawValue)
  if not saved then return false, saveReason, status end
  status.state, status.converted, status.archive = "converted", true, archive
  return true, nil, status
end

function store.loadForEdit()
  local config, err, exists = readExisting()
  if config then return config end
  if exists then return nil, err or ("could not load " .. store.path) end
  return model.defaultConfig()
end

-- Exact-identity repair must inspect the decoded source before normalization
-- can discard a mismatched but independently valid same-row receipt.  The
-- snapshot includes the primary bytes used for compare-and-swap at commit.
function store.rawSnapshot()
  if pendingConfig then return nil, "save or cancel the pending Flow edit before identity reconciliation" end
  local recovery = storeIo.recoveryStatus(store.path)
  if recovery.state ~= "clean" then
    return nil, "workflow config requires recovery before identity reconciliation: " .. tostring(recovery.state)
  end
  local text, readReason, present = storeIo.read(store.path)
  if present == nil then return nil, readReason end
  if present == false then
    return { path = store.path, present = false, raw = nil, value = model.defaultConfig() }
  end
  local value, decodeReason = storeIo.decode(store.path, text)
  if type(value) ~= "table" or type(value.workflows) ~= "table" then
    return nil, decodeReason or "invalid workflow config: " .. store.path
  end
  -- Evidence claims require stable row IDs, including on a legacy policy that
  -- already received its namespace in an earlier read. Project every missing
  -- authority field together so an older row followed by a newer ID-bearing
  -- row receives one deterministic, collision-free ID before selection.
  local candidate = deepCopy(value)
  workflowId.ensure(candidate)
  local _, authorityReason = workflowId.authority(candidate)
  if authorityReason then return nil, authorityReason end
  if not deepEqual(candidate, value) then
    local blocked = commissioningMutationReason()
    if blocked then return nil, blocked end
    local backedUp, backupReason = writeSerialized(store.backupPath, value)
    if not backedUp then
      return nil, "could not preserve pre-identity workflow config: " .. tostring(backupReason)
    end
    local written, writeReason = writeSerialized(store.path, candidate, function(decoded)
      return deepEqual(decoded, candidate),
        "workflow stable-identity migration verification failed"
    end, { present = true, raw = text })
    if not written then
      return nil, "workflow stable-identity migration failed: " .. tostring(writeReason)
    end
    text, readReason, present = storeIo.read(store.path)
    if present ~= true then
      return nil, readReason or "workflow stable-identity migration disappeared"
    end
    value, decodeReason = storeIo.decode(store.path, text)
    if type(value) ~= "table" or not deepEqual(value, candidate) then
      return nil, decodeReason or "workflow stable-identity migration is unreadable"
    end
  end
  return { path = store.path, present = true, raw = text, value = value }
end

function store.saveRawSnapshot(snapshot, rawConfig, verifier, reason, options)
  if pendingConfig then return false, "save or cancel the pending Flow edit before identity reconciliation" end
  if type(snapshot) ~= "table" or snapshot.path ~= store.path
      or type(rawConfig) ~= "table" or type(rawConfig.workflows) ~= "table" then
    return false, "valid workflow raw snapshot and candidate are required"
  end
  local blocked = commissioningMutationReason(options)
  if blocked then return false, blocked end
  local fenceOk, fenceReason = fenceAllows(snapshot.value, rawConfig, options)
  if not fenceOk then return false, fenceReason end
  local recovery = storeIo.recoveryStatus(store.path)
  if recovery.state ~= "clean" then
    return false, "workflow config requires recovery before identity reconciliation: " .. tostring(recovery.state)
  end
  local candidate = deepCopy(rawConfig)
  local function invariant(decoded)
    if not deepEqual(decoded, candidate) then return false, "raw identity patch changed metadata values" end
    if type(verifier) == "function" then return verifier(decoded) end
    return true
  end
  if snapshot.present == true and type(snapshot.value) == "table" then
    local backedUp, backupReason = writeSerialized(store.backupPath, snapshot.value)
    if not backedUp then return false, "could not preserve prior workflow config: " .. tostring(backupReason) end
  end
  local written, writeReason = writeSerialized(store.path, candidate, invariant, {
    present = snapshot.present == true, raw = snapshot.raw
  })
  if not written then return false, writeReason end
  local saved = model.compactConfig(candidate)
  cacheEpoch.recordWorkflow(saved, reason or "workflow_identity_reconcile")
  patchMaintainerState(saved)
  return true, nil, saved
end

function store.installIdentityFence(snapshot, fence)
  if type(snapshot) ~= "table" or type(snapshot.value) ~= "table"
      or not validIdentityFence(fence) then
    return false, "valid raw snapshot and identity mutation fence are required"
  end
  if snapshot.value.identityMutationFence ~= nil then
    if snapshot.value.identityMutationFence.transactionId == fence.transactionId then
      return true, nil, snapshot.value
    end
    return false, "another identity transaction owns the workflow mutation fence"
  end
  if fence.operation == "recorded_add" or fence.transactionId:match("^ria%-") then
    local brakeReason = maintenanceBrakeReason()
    if brakeReason then return false, brakeReason end
  end
  local candidate = deepCopy(snapshot.value)
  candidate.identityMutationFence = deepCopy(fence)
  return store.saveRawSnapshot(snapshot, candidate, nil, "identity_reconcile_fence", {
    installIdentityFence = true, identityTransactionId = fence.transactionId
  })
end

commissioningMutationReason = function(options)
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  if not loaded or type(daemonConfig) ~= "table" or type(daemonConfig.load) ~= "function" then
    return nil
  end
  local called, cfg = pcall(daemonConfig.load)
  if not called or type(cfg) ~= "table" or not commissioningAuthority.active(cfg) then
    return nil, cfg
  end
  options = type(options) == "table" and options or {}
  local owner = options.commissioningOwner
  if commissioningAuthority.policyOwnerAllowed(cfg, owner, owner and owner.purpose)
      or commissioningAuthority.identityTransactionAllowed(cfg, options) then
    return nil, cfg
  end
  return commissioningAuthority.reason(cfg, "workflow policy"), cfg
end

-- Editor/API saves are ordinary policy mutations and cannot race maintenance.
maintenanceBrakeReason = function(options)
  local blocked, cfg = commissioningMutationReason(options)
  if blocked then return blocked end
  if type(cfg) ~= "table" then
    local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
    local called
    if loaded and type(daemonConfig) == "table" and type(daemonConfig.load) == "function" then
      called, cfg = pcall(daemonConfig.load)
    end
    if not called or type(cfg) ~= "table" then return nil end
  end
  if cfg.maintenanceBrake ~= true then return nil end
  return "maintenance brake active: "
    .. tostring(cfg.maintenanceBrakeReason or "operator maintenance")
    .. "; resume or complete the owning maintenance transaction before changing workflow policy"
end

function store.save(config)
  local brakeReason = maintenanceBrakeReason()
  if brakeReason then return false, brakeReason end
  local recovery = storeIo.recoveryStatus(store.path)
  if recovery.state ~= "clean" then
    return false, "workflow config requires recovery before saving: " .. tostring(recovery.state)
  end
  config = model.compactConfig(config)
  local rows = {}
  for i, row in ipairs(config.workflows or {}) do rows[i] = model.normalize(row) end
  local saved = { autoEnabled = config.autoEnabled ~= false, nextWorkflowId = config.nextWorkflowId,
    workflowNamespace = config.workflowNamespace, workflowHostAddress = config.workflowHostAddress,
    craftCompatibility = craftCompatibility(config),
    fluidStockCompatibility = config.fluidStockCompatibility,
    workflows = rows }
  local previous, previousReason, primaryExists = readAt(store.path)
  if primaryExists == nil then return false, previousReason end
  if primaryExists and not previous then
    return false, "refusing to overwrite unreadable existing workflow config: " .. tostring(previousReason)
  end
  if previous then
    if previous.identityMutationFence ~= nil then
      return false, "workflow identity reconciliation owns the mutation fence"
    end
    local backedUp, backupReason = writeSerialized(store.backupPath, previous)
    if not backedUp then return false, "could not preserve prior workflow config: " .. tostring(backupReason) end
  end
  return writeSerialized(store.path, saved)
end

local function editableConfig()
  if pendingConfig then return pendingConfig end
  return store.loadForEdit()
end

function store.editableConfig()
  return editableConfig()
end

function store.saveConfig(config, preserveOnFailure)
  if not config then return false, "no workflow config to save" end
  local blocked = maintenanceBrakeReason()
  if blocked then return false, blocked end
  local ok, err, saved = store.save(config)
  if ok then
    pendingConfig = nil
    cacheEpoch.recordWorkflow(saved or config, "workflow_save")
    patchMaintainerState(saved or config)
  elseif preserveOnFailure then
    pendingConfig = config
  end
  return ok, err, saved
end

-- Compatibility selectors change one root authority only. Preserving the
-- decoded source table avoids canonicalizing, merging, reordering, arming, or
-- discarding unknown metadata from a large operator-owned workflow database.
function store.patchRoot(field, value, reason, guard, options)
  if field ~= "craftCompatibility" and field ~= "fluidStockCompatibility" then
    return false, "unsupported workflow root authority: " .. tostring(field)
  end
  local blocked = maintenanceBrakeReason(options)
  if blocked then return false, blocked end
  if pendingConfig then return false, "save or cancel the pending Flow edit before changing compatibility" end
  local recovery = storeIo.recoveryStatus(store.path)
  if recovery.state ~= "clean" then
    return false, "workflow config requires recovery before saving: " .. tostring(recovery.state)
  end
  local config, readReason, exists, source = readAt(store.path)
  if exists and not config then return false, readReason or "workflow config is unreadable" end
  local original = source and source.value or model.defaultConfig()
  if original.identityMutationFence ~= nil then
    return false, "workflow identity reconciliation owns the mutation fence"
  end
  if type(guard) == "function" then
    local guardOk, accepted, guardReason = pcall(guard, model.compactConfig(original))
    if not guardOk or accepted ~= true then
      return false, tostring(guardReason or accepted or "root authority precondition changed; review and retry")
    end
  end
  local raw = deepCopy(original)
  raw[field] = value
  local function verifier(candidate) return deepEqual(candidate, raw), "root patch changed workflow or metadata values" end
  if source and source.value then
    local backedUp, backupReason = writeSerialized(store.backupPath, original)
    if not backedUp then return false, "could not preserve prior workflow config: " .. tostring(backupReason) end
  end
  local written, writeReason = writeSerialized(store.path, raw, verifier, {
    present = source ~= nil, raw = source and source.text or nil
  })
  if not written then return false, writeReason end
  local saved = model.compactConfig(raw)
  cacheEpoch.recordWorkflow(saved, reason or "workflow_root_patch")
  patchMaintainerState(saved)
  return true, nil, saved
end

function store.setPending(config)
  local blocked = maintenanceBrakeReason()
  if blocked then return nil, blocked end
  pendingConfig = config
  return pendingConfig
end

function store.pending()
  return pendingConfig
end

function store.flushPending()
  if not pendingConfig then return true, nil, nil end
  local config = pendingConfig
  pendingConfig = nil
  local ok, err, saved = store.saveConfig(config, false)
  if not ok then pendingConfig = config end
  return ok, err, saved
end

function store.hasPending()
  return pendingConfig ~= nil
end

return store
-- Transactional readable persistence for the workflow authority file.  The
-- normal runtime only reads this file; writes are explicit editor/migration
-- actions and must leave a recoverable primary if OpenOS is interrupted.
local filesystem = require("filesystem")
local serialization = require("serialization")
local readable = require("oc.core.config")

local ioStore = {}

local function exists(path)
  local ok, found, reason = pcall(filesystem.exists, path)
  if not ok then return nil, tostring(found) end
  if type(found) ~= "boolean" then return nil, tostring(reason or "could not inspect " .. tostring(path)) end
  return found
end

local function remove(path)
  local found, existsReason = exists(path)
  if found == nil then return false, existsReason end
  if not found then return true end
  local ok, result, reason = pcall(filesystem.remove, path)
  if not ok or result ~= true then return false, tostring(reason or result or "remove failed") end
  return true
end

local function rename(from, to)
  local ok, result, reason = pcall(filesystem.rename, from, to)
  if not ok or result ~= true then return false, tostring(reason or result or "rename failed") end
  return true
end

function ioStore.exists(path) return exists(path) end

function ioStore.read(path)
  local present, presentReason = exists(path)
  if present == nil then return nil, presentReason, nil end
  if not present then return nil, nil, false end
  local opened, handle, openReason = pcall(io.open, path, "r")
  if not opened then return nil, tostring(handle), true end
  if not handle then return nil, tostring(openReason or "could not open " .. tostring(path)), true end
  local readOk, text, readReason = pcall(function() return handle:read("*a") end)
  local closeOk, closed, closeReason = pcall(function() return handle:close() end)
  if not readOk then return nil, tostring(readReason or text), true end
  if not closeOk or closed == false then return nil, tostring(closeReason or closed or "could not close " .. tostring(path)), true end
  return text or "", nil, true
end

function ioStore.decode(path, text)
  local ok, value = pcall(serialization.unserialize, text or "")
  if not ok or type(value) ~= "table" then return nil, "invalid workflow config: " .. tostring(path) end
  return value
end

local function decodedFile(path)
  local text, readReason, present = ioStore.read(path)
  if present ~= true then return { path = path, present = present, reason = readReason } end
  local value, decodeReason = ioStore.decode(path, text)
  if type(value) ~= "table" or type(value.workflows) ~= "table" then
    return { path = path, present = true, raw = text, reason = decodeReason or "workflow table is missing" }
  end
  return { path = path, present = true, raw = text, value = value }
end

-- A write either finishes with a primary only, or leaves enough named files
-- for a human-confirmed resolver. Runtime readers never silently promote a
-- staged candidate.
function ioStore.recoveryStatus(path)
  local primary = decodedFile(path)
  local staged = decodedFile(path .. ".new")
  local previous = decodedFile(path .. ".previous")
  local status = { path = path, primary = primary, staged = staged, previous = previous }
  if primary.present == nil or staged.present == nil or previous.present == nil then
    status.state, status.reason = "io_error", primary.reason or staged.reason or previous.reason
  elseif staged.present ~= true and previous.present ~= true then
    if primary.present == true and not primary.value then
      status.state, status.reason = "invalid_primary", primary.reason
    else
      status.state = "clean"
    end
  elseif primary.value and previous.value and staged.present ~= true then
    status.state, status.action = "cleanup_previous", "cleanup_previous"
  elseif primary.present ~= true and previous.value and staged.present ~= true then
    status.state, status.action = "restore_previous", "restore_previous"
  elseif primary.present ~= true and staged.value and (previous.present ~= true or previous.value) then
    status.state, status.action = "promote_staged", "promote_staged"
  else
    status.state = "manual_recovery"
    status.reason = "staged workflow files are ambiguous or invalid"
  end
  return status
end

function ioStore.recover(path)
  local status = ioStore.recoveryStatus(path)
  if status.state == "clean" then return true, nil, status end
  if status.state == "cleanup_previous" then
    local cleaned, reason = remove(path .. ".previous")
    if not cleaned then return false, reason, status end
  elseif status.state == "restore_previous" then
    local restored, reason = rename(path .. ".previous", path)
    if not restored then return false, reason, status end
  elseif status.state == "promote_staged" then
    local promoted, reason = rename(path .. ".new", path)
    if not promoted then return false, reason, status end
    if status.previous.present == true then
      local cleaned, cleanupReason = remove(path .. ".previous")
      if not cleaned then return false, cleanupReason, ioStore.recoveryStatus(path) end
    end
  else
    return false, status.reason or "manual recovery required", status
  end
  local after = ioStore.recoveryStatus(path)
  if after.state ~= "clean" then return false, "recovery remains unresolved: " .. tostring(after.state), after end
  return true, nil, after
end

local function write(path, body)
  local opened, handle, openReason = pcall(io.open, path, "w")
  if not opened then return false, tostring(handle) end
  if not handle then return false, tostring(openReason or "could not write " .. tostring(path)) end
  local writeOk, wrote, writeReason = pcall(function() return handle:write(body) end)
  local closeOk, closed, closeReason = pcall(function() return handle:close() end)
  if not writeOk or wrote == nil or wrote == false then return false, tostring(writeReason or wrote or "write failed") end
  if not closeOk or closed == false then return false, tostring(closeReason or closed or "close failed") end
  return true
end

local function stagedBody(path, value, verifier)
  local body, renderReason = readable.render(value)
  if not body then return nil, renderReason end
  local staged = path .. ".new"
  local stagedPresent, stagedReason = exists(staged)
  if stagedPresent == nil then return nil, stagedReason end
  if stagedPresent then return nil, "workflow config has an unpromoted staged file at " .. staged end
  local wrote, writeReason = write(staged, body .. "\n")
  if not wrote then remove(staged); return nil, writeReason end
  local verified = decodedFile(staged)
  if not verified.value then
    remove(staged)
    return nil, "staged workflow verification failed: " .. tostring(verified.reason or "could not re-read staged workflow config")
  end
  if type(verifier) == "function" then
    local verifyOk, accepted, verifyReason = pcall(verifier, verified.value)
    if not verifyOk or accepted ~= true then
      remove(staged)
      return nil, "staged workflow invariant check failed: "
        .. tostring(verifyReason or accepted or "candidate differs from requested authority")
    end
  end
  return staged
end

function ioStore.writeReadable(path, value, verifier, expectedPrimary)
  local recovery = ioStore.recoveryStatus(path)
  if recovery.state ~= "clean" then
    return false, "workflow config requires recovery before saving: " .. tostring(recovery.state)
  end
  local staged, stageReason = stagedBody(path, value, verifier)
  if not staged then return false, stageReason end
  local previous = path .. ".previous"
  local previousPresent, previousReason = exists(previous)
  if previousPresent == nil then
    remove(staged)
    return false, previousReason
  end
  if previousPresent then
    remove(staged)
    return false, "workflow config has an unresolved prior file at " .. previous
  end
  if type(expectedPrimary) == "table" then
    local currentRaw, currentReason, currentPresent = ioStore.read(path)
    if currentPresent == nil then remove(staged); return false, currentReason end
    if currentPresent ~= (expectedPrimary.present == true)
        or (currentPresent == true and currentRaw ~= expectedPrimary.raw) then
      remove(staged)
      return false, "workflow config changed while preparing root authority; review and retry"
    end
  end
  local moved = false
  if recovery.primary.present == true then
    local moveOk, moveReason = rename(path, previous)
    if not moveOk then remove(staged); return false, "could not preserve workflow config: " .. tostring(moveReason) end
    moved = true
  end
  local promoteOk, promoteReason = rename(staged, path)
  if not promoteOk then
    if moved then rename(previous, path) end
    remove(staged)
    return false, "could not promote staged workflow config: " .. tostring(promoteReason)
  end
  if moved then
    local cleaned, cleanupReason = remove(previous)
    if not cleaned then
      return false, "workflow config promoted but prior cleanup requires recovery: " .. tostring(cleanupReason)
    end
  end
  return true
end

function ioStore.writeRawNew(path, body)
  local existing, existingReason, present = ioStore.read(path)
  if present == nil then return false, existingReason end
  if present then
    if existing == (body or "") then return true, nil, "reused" end
    return false, "refusing to overwrite a different migration archive " .. path
  end
  local wrote, reason = write(path, body or "")
  if not wrote then return false, reason end
  local verified, verifyReason = ioStore.read(path)
  if verified ~= (body or "") then
    remove(path)
    return false, verifyReason or "migration archive verification failed"
  end
  return true
end

function ioStore.oneLine(text)
  if type(text) ~= "string" then return false end
  local logical = text:gsub("[\r\n]+$", "")
  return not logical:find("[\r\n]")
end

return ioStore
