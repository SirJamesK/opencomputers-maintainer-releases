local function identityEvidence() return require("oc.ae2.identity_evidence") end
local function identityReconcile() return require("oc.ae2.workflow_identity_reconcile") end

local function observationTime(value)
  local stamped = tonumber(value)
  if stamped and stamped == stamped and stamped >= 0 and stamped < math.huge then return stamped end
  local loaded, computer = pcall(require, "computer")
  if loaded and type(computer) == "table" and type(computer.uptime) == "function" then
    local called, uptime = pcall(computer.uptime)
    uptime = called and tonumber(uptime) or nil
    if uptime and uptime == uptime and uptime >= 0 and uptime < math.huge then return uptime end
  end
  return 0
end

local function currentGrid(options)
  if type(options) == "table" and type(options.gridAddress) == "string"
      and options.gridAddress ~= "" then return options.gridAddress end
  local loaded, adapter = pcall(require, "oc.ae2.adapter")
  if not loaded or type(adapter) ~= "table" or type(adapter.primary) ~= "function" then
    return nil, "current AE2 grid authority is unavailable"
  end
  local called, primary, reason = pcall(adapter.primary)
  if not called or type(primary) ~= "table" or type(primary.address) ~= "string"
      or primary.address == "" then
    return nil, tostring(called and reason or primary or "current AE2 grid is unavailable")
  end
  return primary.address
end

local function evidenceMutationAllowed()
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  if not loaded or type(daemonConfig) ~= "table" or type(daemonConfig.load) ~= "function" then
    return false, "daemon safety authority is unavailable"
  end
  local called, cfg = pcall(daemonConfig.load)
  if not called or type(cfg) ~= "table" or cfg.configReadFailed == true then
    return false, "daemon safety authority is unreadable"
  end
  if cfg.maintenanceBrake == true then
    return false, "identity reconciliation owns evidence mutation"
  end
  return true
end

local function armCapturePulse(daemonConfig, capture, generation, namespace)
  if type(capture) ~= "table" or type(daemonConfig.armIdentityCapture) ~= "function" then
    return false, "daemon capture cadence is unavailable"
  end
  local called, armed, reason = pcall(daemonConfig.armIdentityCapture,
    capture.expiresAt, capture.captureId, generation, namespace)
  if called ~= true or armed ~= true then return false, tostring(reason or armed) end
  local loaded, event = pcall(require, "event")
  if loaded and type(event) == "table" and type(event.push) == "function" then
    pcall(event.push, "oc_ae2_daemon_timer", "identity_capture")
  end
  return true
end

local function sustainNewCapture(ok, reason, report)
  local request = type(report) == "table" and report.captureRequest or nil
  if ok ~= true or type(request) ~= "table"
      or request.action ~= "identity_capture_armed" then return ok, reason, report end
  local configLoaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  local configCalled, cfg = false, nil
  if configLoaded and type(daemonConfig) == "table" and type(daemonConfig.load) == "function" then
    configCalled, cfg = pcall(daemonConfig.load)
  end
  if configCalled ~= true or type(cfg) ~= "table" or cfg.configReadFailed == true
      or cfg.readFailed == true then
    report.captureWorker = { action = "identity_capture_worker_failed" }
    return false, "capture armed but daemon desired state is unreadable", report
  end
  if cfg.enabled ~= false then
    local capture = request.capture
    local armed, armReason = armCapturePulse(daemonConfig, capture,
      request.generation, request.namespace)
    if not armed then
      report.captureWorker = { action = "identity_capture_daemon_pulse_failed",
        captureId = type(capture) == "table" and capture.captureId or nil }
      return false, "capture armed but daemon cadence could not be scheduled: "
        .. tostring(armReason), report
    end
    report.captureWorker = { action = "identity_capture_daemon_owned",
      captureId = capture.captureId }
    return ok, reason, report
  end
  local workerLoaded, captureWorker = pcall(require, "oc.ae2.identity_capture_worker")
  if not workerLoaded or type(captureWorker) ~= "table"
      or type(captureWorker.afterForeground) ~= "function" then
    report.captureWorker = { action = "identity_capture_worker_failed" }
    return false, "capture armed but detached capture worker is unavailable", report
  end
  return captureWorker.afterForeground(reason, report)
end

local function sameOutput(row, output)
  if type(row) ~= "table" or type(output) ~= "table" then return false end
  local binding = require("oc.ae2.request_binding")
  local name = row.name or (type(row.filter) == "table" and row.filter.name)
    or (type(row.craftBinding) == "table" and row.craftBinding.name)
    or (type(row.stockBinding) == "table" and row.stockBinding.fluid)
  local damage = row.damage
  if damage == nil and type(row.filter) == "table" then damage = row.filter.damage end
  if name and output.name and tostring(name) == tostring(output.name) then
    local rowFluid = row.kind == "fluid" or row.isFluid == true
      or (type(row.stockBinding) == "table" and row.stockBinding.fluid ~= nil)
    local outputFluid = output.kind == "fluid" or output.isFluid == true
    if rowFluid ~= outputFluid then return false end
    if rowFluid then return true end
    if tonumber(damage) ~= tonumber(output.damage)
        or binding.tagged(row.hasTag) ~= binding.tagged(output.hasTag) then return false end
    return not binding.tagged(row.hasTag) or tostring(row.rawLabel or row.label or "")
      == tostring(output.rawLabel or output.label or "")
  end
  return false
end

local function outputOwner(config, output, options)
  options = type(options) == "table" and options or {}
  local namespace = workflowId.authority(config)
  if not namespace then return nil end
  local found
  for index, row in ipairs(type(config) == "table" and config.workflows or {}) do
    if sameOutput(row, output) then
      if found then return nil end
      found = { workflowNamespace = namespace, workflowId = row.workflowId, configIndex = index }
    end
  end
  -- UI selection and labels are scope, never exact ownership proof.
  return found
end

workflows.outputOwner = outputOwner

-- Cache CPU slots locally; a reboot safely re-observes visible outputs once.
local cpuSlots = {}

local function selectedScope(config, options)
  local found
  for index, row in ipairs(type(config) == "table" and config.workflows or {}) do
    if (options.selectedWorkflowId and row.workflowId == options.selectedWorkflowId)
        or (options.configIndex and tonumber(options.configIndex) == index) then
      if found then return {} end
      found = { workflowId = row.workflowId, configIndex = index }
    end
  end
  return found or {}
end

local function observeCpuOutputs(outputs, options)
  options = type(options) == "table" and options or {}
  outputs = type(outputs) == "table" and outputs or {}
  local rawSnapshot, rawReason = store.rawSnapshot()
  local config = rawSnapshot and rawSnapshot.value or nil
  local namespace, namespaceReason
  if config then namespace, namespaceReason = workflowId.authority(config) end
  local ownerError
  if not namespace then
    ownerError = tostring(namespaceReason or rawReason
      or "durable raw workflow authority unavailable")
  end
  local evidenceApi = identityEvidence()
  local grid, gridReason = currentGrid(options)
  if not grid then
    return false, gridReason, { action = "identity_cpu_observed", recorded = 0,
      outputs = #outputs, changed = 0, receipts = {}, ownerError = ownerError }
  end
  local host = workflowId.currentHost()
  if namespace then
    local allowed, allowReason = evidenceMutationAllowed()
    if not allowed then
      return false, allowReason, { action = "identity_cpu_observed", recorded = 0,
        outputs = #outputs, changed = 0, receipts = {}, ownerError = ownerError }
    end
  end
  local previous, nextSlots, changed, baseline, baselineSeen = {}, {}, {}, {}, {}
  for slot, fingerprint in pairs(cpuSlots) do
    if slot:sub(1, #grid + 1) == grid .. "\31" then
      previous[slot] = fingerprint
    end
  end
  for _, output in ipairs(outputs) do
    local identityKey = namespace and evidenceApi.key(output) or nil
    local fingerprint = identityKey and (identityKey .. "\31" .. namespace) or nil
    local slot = grid .. "\31" .. tostring(output.cpuIndex or output.cpuName or "unknown")
    if fingerprint then
      nextSlots[slot] = fingerprint
      if previous[slot] ~= fingerprint then
        changed[#changed + 1] = output
      end
      local token = "dg:" .. identityKey
      if not baselineSeen[token] then
        baselineSeen[token], baseline[#baseline + 1] = true, token
      end
    end
  end
  local maxConsume = math.max(1, tonumber(evidenceApi.maxCaptureConsume) or 256)
  if #changed > maxConsume then
    for slot in pairs(previous) do if nextSlots[slot] == nil then cpuSlots[slot] = nil end end
    return false, "CPU evidence snapshot exceeds the bounded " .. tostring(maxConsume)
      .. "-output capture window; reduce simultaneous active CPUs", {
      action = "identity_cpu_observed", recorded = 0, outputs = #outputs,
      changed = #changed, deferred = #changed, receipts = {}, ownerError = ownerError }
  end

  local captureRequest, captureError
  local captureFence
  if namespace and type(evidenceApi.captureStatus) == "function" then
    local statusOk, status = pcall(evidenceApi.captureStatus, namespace)
    local active = statusOk and type(status) == "table" and status.capture or nil
    if type(active) == "table" and active.active == true then
      captureFence = { untilAt = tonumber(active.expiresAt), captureId = active.captureId,
        generation = tonumber(status.generation), namespace = namespace }
    end
  end
  if options.captureNext == true and namespace then
    local selected = selectedScope(config, options)
    -- Selection is scope only. Identity still comes exclusively from the first
    -- new structured output outside this durable baseline.
    local requested, reason, report = evidenceApi.requestCapture(options.observedAt, {
      workflowNamespace = namespace,
      workflowId = options.selectedWorkflowId or selected.workflowId,
      configIndex = options.configIndex or selected.configIndex,
      gridAddress = grid, hostAddress = host,
      baseline = baseline, labelQuery = options.labelQuery,
      expectedCaptureId = options.expectedCaptureId
    })
    captureRequest, captureError = report, requested == true and nil or reason
    if requested == true and type(report and report.capture) == "table"
        and report.capture.active == true then
      captureFence = { untilAt = tonumber(report.capture.expiresAt),
        captureId = report.capture.captureId, generation = tonumber(report.generation),
        namespace = namespace }
      local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
      local armed, armReason = false, "daemon capture cadence is unavailable"
      if loaded then
        armed, armReason = armCapturePulse(daemonConfig, report.capture,
          captureFence.generation, captureFence.namespace)
      end
      if not armed then
        captureError = captureError or tostring(armReason or "daemon capture pulse could not be armed")
      end
    end
  elseif options.captureNext == true then captureError = ownerError end

  local observations = {}
  for _, output in ipairs(changed) do
    local owner = config and outputOwner(config, output) or {}
    observations[#observations + 1] = { value = output, context = {
      source = "cpu_final_output", cpuName = output.cpuName, cpuIndex = output.cpuIndex,
      phase = output.phase or "cpu_final_output", workflowNamespace = namespace,
      workflowId = owner.workflowId, configIndex = owner.configIndex,
      hostAddress = host, gridAddress = grid,
      generation = options.generation, brake = options.brake,
      zeroProof = options.zeroProof, observedAt = options.observedAt
    } }
  end
  local recorded, firstError, receipts = 0, captureError, {}
  local batch = { action = "identity_evidence_v2_chunked", observed = 0,
    receipts = receipts, captures = {} }
  if #observations > 0 and namespace then
    local recordIds, durableError = {}, nil
    local chunkSize = math.max(1, tonumber(evidenceApi.maxObserve) or 32)
    for first = 1, #observations, chunkSize do
      local chunk = {}
      for index = first, math.min(#observations, first + chunkSize - 1) do
        chunk[#chunk + 1] = observations[index]
      end
      local mutationAllowed, mutationReason = evidenceMutationAllowed()
      if not mutationAllowed then
        durableError = tostring(mutationReason or "evidence mutation authority changed")
        break
      end
      local observed, reason, report = evidenceApi.observeMany(chunk, nil, { deferCapture = true })
      if observed ~= true then durableError = tostring(reason or "evidence chunk failed"); break end
      for _, receipt in ipairs(type(report) == "table" and report.receipts or {}) do
        receipts[#receipts + 1] = receipt
        if type(receipt.recordId) == "string" then recordIds[#recordIds + 1] = receipt.recordId end
      end
    end
    if not durableError and #recordIds > 0 then
      if type(evidenceApi.consumeCapture) ~= "function" then
        durableError = "matched evidence service cannot finalize a chunked capture"
      else
        local mutationAllowed, mutationReason = evidenceMutationAllowed()
        if not mutationAllowed then
          durableError = tostring(mutationReason or "capture finalization authority changed")
        else
          local consumed, consumeReason, captureResult = evidenceApi.consumeCapture(
            namespace, recordIds, options.observedAt,
            { gridAddress = grid, hostAddress = host })
          if consumed ~= true then durableError = tostring(consumeReason or "capture finalization failed")
          elseif type(captureResult) == "table" then batch.captures[namespace] = captureResult end
        end
      end
    end
    recorded, batch.observed = #receipts, #receipts
    firstError = firstError or durableError
    if not durableError then
      for slot in pairs(previous) do cpuSlots[slot] = nil end
      for slot, fingerprint in pairs(nextSlots) do cpuSlots[slot] = fingerprint end
    else
      for slot in pairs(previous) do if nextSlots[slot] == nil then cpuSlots[slot] = nil end end
    end
    local captureResult = batch.captures[namespace]
    if type(captureResult) == "table" and (captureResult.status == "CONSUMED"
        or captureResult.status == "AMBIGUOUS" or captureResult.status == "EXPIRED")
        and type(captureFence) == "table" and captureFence.untilAt ~= nil then
      local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
      if loaded and type(daemonConfig.clearIdentityCapture) == "function" then
        pcall(daemonConfig.clearIdentityCapture, captureFence.untilAt,
          captureFence.captureId, captureFence.generation, captureFence.namespace)
      end
    end
  elseif #observations == 0 then
    for slot in pairs(previous) do cpuSlots[slot] = nil end
    for slot, fingerprint in pairs(nextSlots) do cpuSlots[slot] = fingerprint end
  end
  return firstError == nil, firstError, {
    action = "identity_cpu_observed", recorded = recorded, outputs = #outputs,
    changed = #changed, receipts = receipts, batch = batch,
    captureNext = type(captureRequest and captureRequest.capture) == "table"
      and captureRequest.capture.active == true,
    captureRequest = captureRequest, diagnostics = outputs.diagnostics or {}, ownerError = ownerError
  }
end

workflows.observeStructuredCpuOutputs = observeCpuOutputs

-- CPU finalOutput is bounded; storage and craftables remain untouched.
function workflows.observeActiveCpuOutputs(options)
  options = type(options) == "table" and options or {}
  local observedAt = observationTime(options.observedAt)
  local ok, snapshot = pcall(function()
    local monitor = require("oc.ae2.monitor")
    local read = monitor.cpuWitnessSnapshot or monitor.snapshot
    return read()
  end)
  if not ok or type(snapshot) ~= "table" or snapshot.available ~= true then
    return false, tostring(ok and (snapshot and snapshot.reason) or snapshot or "AE2 unavailable")
  end
  local witnessOk, outputs = pcall(function()
    return require("oc.ae2.maintainer_cpu_witness").activeOutputs(snapshot.cpus)
  end)
  if not witnessOk or type(outputs) ~= "table" then return false, tostring(outputs) end
  options.observedAt = observedAt
  options.gridAddress = snapshot.primary and snapshot.primary.address
  return sustainNewCapture(observeCpuOutputs(outputs, options))
end

local function recordedApi() return require("oc.ae2.workflow_recorded_api") end
function workflows.listIdentityEvidence(options)
  return recordedApi().list(options, workflows.observeActiveCpuOutputs,
    sustainNewCapture, cpuSlots)
end

function workflows.listEvidence(options) return workflows.listIdentityEvidence(options) end
function workflows.previewIdentityReconciliation(options) return identityReconcile().previewStored(options) end
function workflows.reconcileRecorded(options) return identityReconcile().reconcileAll(options) end
function workflows.reconcileAll(options) return identityReconcile().reconcileAll(options) end

function workflows.addRecorded(recordId, options) return recordedApi().add(recordId, options) end
function workflows.probeFluidIdentity(o) return require("oc.ae2.workflow_fluid_identity_probe").run(o) end
return workflows
local component = require("component")
local adapter = require("oc.ae2.adapter")
local gridReadGuard = require("oc.ae2.grid_read_guard")

local probe = {}

probe.methods = {
  "getCpus",
  "getItemsInNetwork",
  "getFluidsInNetwork",
  "getCraftables",
  "getItemInNetwork",
  "getFluidInNetwork",
  "getCraftable",
  "getStoredPower",
  "getMaxStoredPower",
  "getAvgPowerUsage",
  "getAvgPowerInjection",
  "getIdlePowerUsage",
  "getEnergyStored",
  "getMaxEnergyStored"
}

probe.exactTargetMethods = {
  getItemInNetwork = true,
  getFluidInNetwork = true,
  getCraftable = true
}

local function summarize(value)
  local valueType = type(value)
  if valueType == "table" then
    return "table#" .. tostring(#value)
  elseif valueType == "number" or valueType == "boolean" or valueType == "string" then
    return tostring(value)
  elseif value == nil then
    return "nil"
  end
  return valueType
end

local function hasMethod(address, methodName)
  local ok, methods = pcall(component.methods, address)
  return ok and type(methods) == "table" and methods[methodName] ~= nil
end

local function call(address, methodName)
  if not hasMethod(address, methodName) then
    return { method = methodName, status = "missing" }
  end
  local allowed, guardErr = gridReadGuard.check(methodName)
  if not allowed then
    return { method = methodName, status = "available", detail = "not invoked; " .. tostring(guardErr) }
  end
  if probe.exactTargetMethods[methodName] then
    return { method = methodName, status = "available", detail = "not invoked; requires an exact configured identity" }
  end

  local ok, value = pcall(component.invoke, address, methodName)
  if not ok then
    return { method = methodName, status = "error", detail = tostring(value) }
  end
  return { method = methodName, status = "ok", detail = summarize(value) }
end

local function probeNode(node)
  local results = {}
  for _, methodName in ipairs(probe.methods) do
    results[#results + 1] = call(node.address, methodName)
  end
  return { address = node.address, type = node.type, results = results }
end

function probe.run()
  local components = adapter.components()
  -- A normal status path stays on known AE2 component types. The probe is an
  -- intentional diagnostic, so it may make one broader method-capability
  -- pass if a mod exposes the network under an unexpected component type.
  if #components == 0 then components = adapter.components({ includeUnknown = true }) end
  if #components == 0 then
    local _, reason = adapter.primary()
    return { available = false, reason = reason, results = {}, components = {} }
  end

  local rows = {}
  for _, node in ipairs(components) do rows[#rows + 1] = probeNode(node) end
  return {
    available = true,
    primary = { address = components[1].address, type = components[1].type },
    results = rows[1].results,
    components = rows,
    componentCount = #rows
  }
end

function probe.print(report)
  report = report or probe.run()
  if not report.available then
    io.write("AE2 unavailable: " .. tostring(report.reason) .. "\n")
    return
  end

  io.write(string.format("AE2 probe: %d visible AE2 component(s)\n", tonumber(report.componentCount) or 1))
  for _, node in ipairs(report.components or { report.primary }) do
    io.write(string.format("%s %s\n", node.type, node.address))
    for _, result in ipairs(node.results or report.results or {}) do
      if result.detail then
        io.write(string.format("  %s: %s %s\n", result.method, result.status, result.detail))
      else
        io.write(string.format("  %s: %s\n", result.method, result.status))
      end
    end
  end
end

return probe
#!/bin/lua
