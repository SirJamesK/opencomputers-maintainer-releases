end

function match.targetStack(target)
  local kind = target and (itemLooksFluid(target) and "fluid" or (target.kind or (target.isFluid and "fluid" or "item")))
  return {
    label = target and (target.label or target.rawLabel or target.name) or "target",
    rawLabel = target and target.rawLabel,
    name = target and target.name,
    damage = target and match.itemDamage(target.damage),
    hasTag = target and tagged(target.hasTag) or false,
    size = target and (target.size or target.amount or target.count),
    amount = target and target.amount,
    kind = kind,
    isFluid = kind == "fluid",
    craftBinding = target and target.craftBinding
  }
end

function match.targetFilter(target)
  target = target or {}
  local source = target.filter or {}
  local filter = {}
  for key, value in pairs(source) do
    if key ~= "kind" and key ~= "isFluid" and key ~= "amount" and not (source.name and key == "label") then
      filter[key] = key == "damage" and match.itemDamage(value) or value
    end
  end
  if next(filter) then return filter end
  if target.name then filter.name = target.name end
  if target.damage ~= nil then filter.damage = match.itemDamage(target.damage) end
  if target.name then return filter end
  if target.label then filter.label = target.label end
  return filter
end

function match.sameTarget(entry, target)
  target = target or {}
  local targetKind = itemLooksFluid(target) and "fluid" or target.kind
  local targetIsFluid = targetKind == "fluid" or target.isFluid == true
  if targetKind and entry.kind and targetKind ~= entry.kind then return false end
  if (target.isFluid ~= nil or targetKind == "fluid") and (entry.isFluid == true) ~= targetIsFluid then return false end
  local wantedRaw = match.tidyLabel(target.label or target.rawLabel):lower()
  if target.name then
    if entry.name ~= target.name then return false end
    if target.damage ~= nil and entry.damage ~= match.itemDamage(target.damage) then return false end
    if target.hasTag ~= nil and tagged(entry.hasTag) ~= tagged(target.hasTag) then return false end
    if (target.craftBinding or match.fluidProxy(target) or match.fluidProxy(entry)) and wantedRaw ~= "" then
      local label = match.tidyLabel(entry.label or entry.rawLabel):lower()
      local raw = match.tidyLabel(entry.rawLabel or entry.label):lower()
      local wantedPlain = match.plainLabel(wantedRaw):lower()
      if label ~= wantedRaw and raw ~= wantedRaw
          and match.plainLabel(label):lower() ~= wantedPlain
          and match.plainLabel(raw):lower() ~= wantedPlain then return false end
    end
    return true
  end
  if wantedRaw ~= "" then
    if match.tidyLabel(entry.label):lower() == wantedRaw then return true end
    if match.tidyLabel(entry.rawLabel):lower() == wantedRaw then return true end
    if not match.countPrefixed(wantedRaw) then
      local wantedPlain = match.plainLabel(wantedRaw):lower()
      if match.plainLabel(entry.label):lower() == wantedPlain then return true end
      if match.plainLabel(entry.rawLabel):lower() == wantedPlain then return true end
    end
  end
  if wantedRaw ~= "" then return false end
  return true
end

return match
local adapter = require("oc.ae2.adapter")
local match = require("oc.ae2.request_match")

local nodes = {}

local function add(out, seen, node)
  if node and node.address and not seen[node.address] then
    seen[node.address] = true
    out[#out + 1] = node
  end
end

local function addRequestNode(out, seen, node)
  if node and (node.type == "me_controller" or node.type == "me_interface") then add(out, seen, node) end
end

local function copyFilter(filter)
  local out = {}
  for key, value in pairs(filter or {}) do out[key] = value end
  return out
end

local function filterKey(filter)
  local parts = {}
  for key, value in pairs(filter or {}) do parts[#parts + 1] = tostring(key) .. "=" .. tostring(value) end
  table.sort(parts)
  return table.concat(parts, "&")
end

local function addMode(out, seen, name, filter)
  filter = copyFilter(filter)
  if not next(filter) then return end
  local key = filterKey(filter)
  if seen[key] then return end
  seen[key] = true
  out[#out + 1] = { name = name, filter = filter }
end

local function fluidLike(target)
  local label = tostring(target and (target.rawLabel or target.label or target.name) or "")
  return target and (target.isFluid == true or target.kind == "fluid" or label:find("^[Dd]rops? of%s+") ~= nil)
end

function nodes.candidates(target)
  local out, seen = {}, {}
  addRequestNode(out, seen, adapter.primary())
  for _, node in ipairs(adapter.components()) do addRequestNode(out, seen, node) end
  return out
end

function nodes.preciseModes(target)
  target = target or {}
  local out, seen = {}, {}
  local filter = match.targetFilter(target)
  if filter.name and filter.damage ~= nil then
    addMode(out, seen, "name-damage-filter", { name = filter.name, damage = filter.damage })
  end
  if target.filter then addMode(out, seen, "catalog-filter", filter) end
  if filter.name and filter.damage == nil then addMode(out, seen, "name-filter", { name = filter.name }) end
  if fluidLike(target) and target.label then addMode(out, seen, "fluid-label-filter", { label = target.label }) end
  if not target.name and target.label then addMode(out, seen, "label-filter", { label = target.label }) end
  if fluidLike(target) and target.rawLabel and target.rawLabel ~= target.label then
    addMode(out, seen, "fluid-raw-label-filter", { label = target.rawLabel })
  end
  if not target.name and target.rawLabel and target.rawLabel ~= target.label then
    addMode(out, seen, "raw-label-filter", { label = target.rawLabel })
  end
  addMode(out, seen, "filtered", filter)
  return out
end

function nodes.warmCandidates()
  return nodes.candidates(nil)
end

return nodes
local fingerprint = require("oc.ae2.request_fingerprint")
local invoker = require("oc.ae2.request_invoker")
local requestCache = require("oc.ae2.request_cache")
local direct = require("oc.ae2.request_direct")

local resolver = {}

local function reportFor(target)
  return {
    scans = 0,
    handles = 0,
    expanded = 0,
    matched = false,
    fullScanSkipped = true,
    exactTarget = target and target.name ~= nil or false,
    errors = {}
  }
end

local function cachedExact(target, report)
  local entry, cacheErr = requestCache.lookup(target)
  if not entry then return nil, cacheErr end
  if not (entry.craftable and invoker.hasMethod(entry.craftable, "request")) then
    requestCache.forget(target)
    return nil, "cached exact Craftable handle is no longer requestable"
  end
  if not fingerprint.same(entry, target) then
    requestCache.forget(target)
    report.cachedRejected = true
    return nil, "cached exact Craftable identity changed"
  end
  entry.mode = "cached-exact"
  report.cached, report.matched, report.mode = true, true, "cached-exact"
  return entry, nil
end

-- A cache hit is preferred. A cold exact identity uses the bridge's scalar
-- getCraftable callback where available; pre-scalar bridges may make one
-- nonempty exact-filtered compatibility call inside request_direct.
function resolver.find(target, options)
  options = options or {}
  local report = reportFor(target)
  local bindErr = requestCache.bindingError(target)
  if bindErr then
    report.bindingRequired = true
    report.lastError = bindErr
    return nil, bindErr, report
  end
  local entry, err = cachedExact(target, report)
  if entry then return entry, nil, report end
  if options.requireCached ~= true and options.allowDirect ~= false then
    local directEntry, directErr, directReport = direct.resolve(target, options)
    for key, value in pairs(directReport or {}) do report[key] = value end
    if directEntry then return directEntry, nil, report end
    err = directErr or err
  end
  report.cacheRequired, report.coldRequest = true, true
  report.mode = "exact-binding-required"
  report.lastError = err or "BIND EXACT TARGET REQUIRED: direct exact Craftable lookup is unavailable"
  return nil, report.lastError, report
end

function resolver.warm()
  return { disabled = true, scans = 0, handles = 0, expanded = 0,
    reason = "bulk Craftable warming is disabled; exact direct binding happens only at a request boundary" }
end

return resolver
local invoker = require("oc.ae2.request_invoker")
local requestCache = require("oc.ae2.request_cache")
local requestCpu = require("oc.ae2.request_cpu")
local requestFingerprint = require("oc.ae2.request_fingerprint")
local requestResolver = require("oc.ae2.request_resolver")
local requestTracker = require("oc.ae2.request_tracker")

local submit = {}

local lastReport = {}

local function targetLabel(target)
  return tostring(target and (target.label or target.rawLabel or target.name) or "request")
end

local function failedState(state)
  return state == "failed" or state == "canceled" or state == "blocked"
end

local function confirmedState(state, phase)
  return state == "running" and phase == "submitted"
end

local function unknownReceipt(reason)
  return { _ocRequestOutcomeUnknown = true, reason = tostring(reason) }
end

local function runtimeAuthorized()
  local loaded, bootstrap = pcall(require, "oc_bootstrap")
  if not loaded or type(bootstrap) ~= "table" or type(bootstrap.verifyActive) ~= "function" then
    return false, "runtime storage unavailable: bootstrap verification is unavailable"
  end
  local called, active, reason = pcall(bootstrap.verifyActive)
  if not called then
    return false, "runtime storage unavailable: " .. tostring(active)
  end
  if active ~= true then
    return false, "runtime storage unavailable: " .. tostring(reason or "selected runtime could not be verified")
  end
  return true
end

local capabilityFields = { "contract", "serial", "namespace", "captureId",
  "requestKey", "cpuName", "workflowId", "configIndex", "gridAddress" }

local function scopeCommissioningCapability(options, target, trackKey)
  local raw = options.commissioningCapability
  options._commissioningCapability = nil
  if raw == nil then return true end
  if type(raw) ~= "table" or raw.contract ~= "commissioning_causal_probe_v1"
      or options.requireCpu ~= true or type(options.cpuName) ~= "string"
      or raw.cpuName ~= options.cpuName or raw.workflowId ~= target.workflowId
      or raw.requestKey ~= tostring(trackKey) then
    return false, "commissioning request capability does not match the exact target, receipt, and CPU"
  end
  local scoped = {}
  for _, field in ipairs(capabilityFields) do scoped[field] = raw[field] end
  options._commissioningCapability = scoped
  return true
end

local function submissionAuthorized(options, stage)
  local runtimeOk, runtimeReason = runtimeAuthorized()
  if not runtimeOk then return false, runtimeReason end
  local expected = tonumber(options and options.daemonGeneration)
  local loaded, daemonConfig = pcall(require, "oc.ae2.maintainer_daemon_config")
  if not loaded or not daemonConfig or type(daemonConfig.load) ~= "function" then
    return false, "maintenance brake state unavailable: control config unavailable"
  end
  if type(daemonConfig.submissionAllowed) == "function" then
    local capability = options and options._commissioningCapability
    if capability then
      local scoped = {}
      for _, field in ipairs(capabilityFields) do scoped[field] = capability[field] end
      scoped.stage = stage or "preflight"
      capability = scoped
    end
    local called, allowed, reason = pcall(daemonConfig.submissionAllowed, expected, capability)
    if not called then return false, "maintenance brake state unavailable: " .. tostring(allowed) end
    return allowed == true, reason
  end
  local ok, cfg = pcall(daemonConfig.load)
  if not ok or type(cfg) ~= "table" then
    return false, "maintenance brake state unavailable: control config unreadable"
  end
  if cfg.maintenanceBrake == true then
    return false, "maintenance brake active: "
      .. tostring(cfg.maintenanceBrakeReason or "operator maintenance")
  end
  if expected ~= nil and (cfg.enabled ~= true or tonumber(cfg.generation) ~= expected) then
    return false, "daemon generation revoked before craft submit"
  end
  return true
end

local function requestCraftable(craftable, amount, options, source)
  amount = tonumber(amount) or 1
  if amount <= 0 then return nil, "request amount must be positive" end
  local prioritize = options.prioritizePower ~= false
  options._cpuName = nil
  options._cpuMode = "ae2-auto"
  options._requestError = nil
  options._intentError = nil
  options._requestAttempted = false
  options._requestOutcomeUnknown = nil
  local pickedCpuName = options.cpuName
  if options.requireCpu == true then
    local cpuMode = pickedCpuName ~= nil and "caller-hint" or "required-auto"
    if pickedCpuName == nil then
      pickedCpuName = requestCpu.pick(source, options)
      cpuMode = pickedCpuName and "required-auto" or "required-unavailable"
    end
    options._cpuName, options._cpuMode = pickedCpuName, cpuMode
    if pickedCpuName == nil then return nil, "causal request requires one named ready CPU" end
  elseif pickedCpuName ~= nil then
    options._cpuName, options._cpuMode = pickedCpuName, "caller-hint"
  end
  local authorized, authorityError = submissionAuthorized(options, "preflight")
  if not authorized then return nil, authorityError end
  -- GTNH Craftable methods use the documented dot/direct convention. Capture
  -- that exact callable before writing intent; mutation execution may not
  -- probe self-style or alternate signatures after an uncertain result.
  local invoke, invokeError = invoker.prepareMutation(craftable, "request", "direct")
  if not invoke then return nil, invokeError end
  if type(options.beforeInvoke) == "function" then
    local called, prepared, prepareErr = pcall(options.beforeInvoke)
    if not called or prepared ~= true then
      local detail = tostring(prepareErr or prepared or "write rejected")
      options._intentError = "durable submit intent persistence failed: " .. detail
      return nil, options._intentError
    end
  end
  authorized, authorityError = submissionAuthorized(options, "invoke")
  if not authorized then return nil, authorityError end
  local status, err, attempted
  if pickedCpuName ~= nil then
    status, err, attempted = invoke(amount, prioritize, pickedCpuName)
  else
    status, err, attempted = invoke(amount)
  end
  options._requestAttempted = attempted == true
  if status ~= nil then return status, nil end
  err = err or (options.requireCpu == true and "causal CPU-bound request failed"
    or "request invocation failed")
  options._requestError = err
  if attempted == true then
    options._requestOutcomeUnknown = err
    return unknownReceipt(err), nil
  end
  return nil, err
end

function submit.requestTarget(target, amount, options)
  options = options or {}
  options._requestAttempted = false
  options._requestOutcomeUnknown = nil
  options._intentError = nil
  options._commissioningCapability = nil
  local amountValue = tonumber(amount) or 0
  if amountValue <= 0 then
    lastReport = { guarded = true, error = "request amount must be positive", amount = amountValue }
    return nil, lastReport.error, lastReport
  end
  local label = targetLabel(target)
  local trackKey = options.track and options.track.id or label
  local scoped, scopeError = scopeCommissioningCapability(options, target or {}, trackKey)
  if not scoped then
    lastReport = { guarded = true, error = scopeError, requestState = "blocked",
      requestPhase = "commissioning_authority", requestStatusReason = scopeError,
      requestAttempted = false, requestOutcomeDefinitive = true }
    return nil, scopeError, lastReport
  end
  local authorized, authorityError = submissionAuthorized(options, "preflight")
  if not authorized then
    local maintenanceBrake = tostring(authorityError or ""):find("maintenance brake", 1, true) ~= nil
    local runtimeStorage = tostring(authorityError or ""):find("runtime storage unavailable", 1, true) ~= nil
    lastReport = {
      guarded = true,
      error = authorityError,
      requestState = "blocked",
      requestPhase = runtimeStorage and "runtime_storage"
        or maintenanceBrake and "maintenance_brake" or "daemon_authority",
      requestStatusReason = authorityError
    }
    return nil, authorityError, lastReport
  end
  local canStart, guardErr = requestTracker.canStart(trackKey, options)
  if not canStart then
    local pendingResult = tostring(guardErr or ""):find("awaiting acknowledgement", 1, true) ~= nil
    lastReport = { guarded = true, error = guardErr,
      requestState = pendingResult and "blocked" or nil,
      requestPhase = pendingResult and "request_result" or nil,
      requestStatusReason = pendingResult and guardErr or nil,
      pendingResult = pendingResult }
    return nil, guardErr, lastReport
  end
  local entry, findErr, report = requestResolver.find(target, options)
  lastReport = report or {}
  lastReport.amount = amountValue
  if not entry then
    lastReport.fingerprint = requestFingerprint.describe(target)
    lastReport.error = tostring(findErr or "no requestable craftable") .. ": " .. lastReport.fingerprint
    return nil, lastReport.error, lastReport
  end
  local ok, status, err = pcall(requestCraftable, entry.craftable, amountValue, options, entry.source)
  if not ok then status, err = nil, tostring(status) end
  local authorityRevoked = not status and tostring(err or ""):find("daemon generation revoked", 1, true) ~= nil
  local maintenanceBraked = not status and tostring(err or ""):find("maintenance brake", 1, true) ~= nil
  local commissioningBlocked = not status and tostring(err or ""):find(
    "automatic commissioning owns request submission", 1, true) ~= nil
  local runtimeUnavailable = not status and tostring(err or ""):find("runtime storage unavailable", 1, true) ~= nil
  local intentRejected = not status and options._intentError ~= nil
  local pickedCpuName = options._cpuName
  lastReport.cpuName = pickedCpuName
  lastReport.cpuMode = options._cpuMode or "ae2-auto"
  lastReport.requestKey = tostring(trackKey)
  local statusInfo
  if status and options._requestOutcomeUnknown then
    statusInfo = { state = "accepted", phase = "confirmation_unavailable", trackable = false,
      reason = "request confirmation unavailable: " .. tostring(options._requestOutcomeUnknown) }
  else
    statusInfo = status and requestTracker.inspect(status) or nil
  end
  if statusInfo and not options._requestOutcomeUnknown
      and (statusInfo.phase == "status_error" or statusInfo.state == "accepted") then
    local detail = statusInfo.reason
    if detail == nil or tostring(detail) == "" then detail = "request status methods unavailable" end
    local normalizedReason = tostring(detail)
    if normalizedReason:find("request confirmation unavailable:", 1, true) ~= 1 then
      normalizedReason = "request confirmation unavailable: " .. normalizedReason
    end
    statusInfo = {
      state = "accepted", phase = "confirmation_unavailable", trackable = false,
      reason = normalizedReason,
      rawReason = statusInfo.rawReason
    }
  end
  lastReport.requestState = statusInfo and statusInfo.state
    or (authorityRevoked or maintenanceBraked or commissioningBlocked
      or runtimeUnavailable or intentRejected) and "blocked" or "failed"
  lastReport.requestPhase = statusInfo and statusInfo.phase or runtimeUnavailable and "runtime_storage"
    or authorityRevoked and "daemon_authority" or maintenanceBraked and "maintenance_brake"
    or commissioningBlocked and "commissioning_authority"
    or intentRejected and "submit_intent_persistence" or nil
  lastReport.requestStatusReason = statusInfo and statusInfo.reason or err
  lastReport.requestStatusRawReason = statusInfo and statusInfo.rawReason or nil
  lastReport.requestTrackable = statusInfo and statusInfo.trackable ~= false and status ~= true
  lastReport.requestAttempted = options._requestAttempted == true
  lastReport.requestConfirmed = confirmedState(lastReport.requestState, lastReport.requestPhase)
  lastReport.requestPending = lastReport.requestState == "running" and lastReport.requestPhase == "computing"
  lastReport.requestUnverified = lastReport.requestState == "accepted"
  lastReport.requestOutcomeDefinitive = options._requestAttempted ~= true
    or (lastReport.requestUnverified ~= true and lastReport.requestPhase ~= "status_link_lost"
      and lastReport.requestPhase ~= "confirmation_unavailable"
      and lastReport.requestPhase ~= "status_error")
  lastReport.requested = status ~= nil and not failedState(lastReport.requestState)
  if authorityRevoked or maintenanceBraked or commissioningBlocked
      or runtimeUnavailable or intentRejected then lastReport.guarded = true end
  lastReport.error = err or (lastReport.requested and nil or lastReport.requestStatusReason)
  if not status and (lastReport.cached
      or tostring(err or ""):find("request method", 1, true)) then
    requestCache.forget(target)
  end
  if not status then return nil, err or "request failed", lastReport end
  if failedState(lastReport.requestState) then
    return nil, lastReport.requestStatusReason or lastReport.requestState, lastReport
  end
  local track = options.track or {}
  track.phase, track.reason = lastReport.requestPhase, lastReport.requestStatusReason
  track.rawReason = lastReport.requestStatusRawReason
  track.label = track.label or label
  track.target = track.target or target
  options.track = track
  if lastReport.requestTrackable
      and (lastReport.requestState == "running" or lastReport.requestState == "done") then
    requestTracker.remember(trackKey, status, options.track)
  end
  return status, nil, lastReport
end

function submit.lastReport()
  return lastReport
end

return submit
local invoker = require("oc.ae2.request_invoker")

local tracker = { active = {} }

local function requestHandle(record)
  if type(record) == "table" and record.request then return record.request end
  return record
end

local function firstReason(...)
  for i = 1, select("#", ...) do
    local value = select(i, ...)
    if value then return tostring(value) end
  end
  return nil
end

local function resourceBlocker(reason)
  local text = tostring(reason or "")
  local lower = text:lower()
  if lower:find("missing resources", 1, true)
    or lower:find("missing resource", 1, true)
    or lower:find("missing ingredients", 1, true)
    or lower:find("missing ingredient", 1, true) then
    return { state = "blocked", phase = "missing_resources", reason = "missing resources", rawReason = text }
  end
  return nil
end

local function statusLinkBlocker(reason)
  local text = tostring(reason or "")
  local normalized = text:lower():match("^%s*(.-)%s*$")
  if normalized == "no link" then
    return {
      state = "blocked",
      phase = "status_link_lost",
      reason = "AE2 request status link unavailable; submission outcome unknown",
      rawReason = text
    }
  end
  return nil
end

local statusMethods = { "hasFailed", "isComputing", "isCanceled", "isDone" }

local function statusContract(request)
  local any, missing = false, nil
  for _, name in ipairs(statusMethods) do
    local present = invoker.hasMethod(request, name)
    any = any or present
    if not present then missing = missing or name end
  end
  if not any then return false, "no status methods" end
  if missing then return false, "missing method: " .. missing end
  return true
end

local function inspectRequest(request)
  request = requestHandle(request)
  if not request then return { state = "none", phase = "missing", reason = "no request" } end
  local complete, contractErr = statusContract(request)
  if not complete then
    if contractErr == "no status methods" then return { state = "accepted", trackable = false } end
    return { state = "failed", phase = "status_error", reason = contractErr }
  end
  local computing, computingErr = invoker.callObject(request, "isComputing")
  if computing == nil then return { state = "failed", phase = "status_error", reason = computingErr } end
  if computing == true then return { state = "running", phase = "computing", reason = computingErr } end
  local failed, failedErr = invoker.callObject(request, "hasFailed")
  local canceled, canceledErr = invoker.callObject(request, "isCanceled")
  local done, doneErr = invoker.callObject(request, "isDone")
  if failed == nil or canceled == nil or done == nil then
    return { state = "failed", phase = "status_error",
      reason = firstReason(failedErr, canceledErr, doneErr) or "incomplete AE2 status contract" }
  end
  if failed == true then
    local reason = tostring(failedErr or "AE2 request failed")
    return resourceBlocker(reason) or statusLinkBlocker(reason)
      or { state = "failed", phase = "failed", reason = reason }
  end
  if canceled == true then return { state = "canceled", phase = "canceled", reason = canceledErr } end
  if done == true then return { state = "done", phase = "done", reason = doneErr } end
  return { state = "running", phase = "submitted" }
end

function tracker.inspect(request)
  return inspectRequest(request)
end

function tracker.prune()
  -- Poll every retained handle, but do not erase a terminal result here.
  -- GTNH completes recipe planning asynchronously; deleting the handle as
  -- soon as it reports missing resources made that failure disappear before
  -- Dashboard or the daemon could publish it. Terminal records are released
  -- only through acknowledge(), or overwritten by a deliberate new request.
  local states = {}
  for label, record in pairs(tracker.active) do states[label] = tracker.inspect(record) end
  return states
end

function tracker.count()
  local states = tracker.prune()
  local count = 0
  for _, state in pairs(states) do if state.state == "running" then count = count + 1 end end
  return count
end

function tracker.running()
  local states = tracker.prune()
  for label, record in pairs(tracker.active) do
    if states[label].state == "running" then return label, requestHandle(record) end
  end
  return nil
end

function tracker.canStart(label, options)
  options = options or {}
  local states = tracker.prune()
  local key = tostring(label or "request")
  local current = tracker.active[key]
  if current then
    local state = states[key].state
    if state == "running" then return false, "request already running: " .. key end
    return false, "request result awaiting acknowledgement: " .. key
  end
  local maxInFlight = tonumber(options.maxInFlight) or 1
  if maxInFlight < 1 then maxInFlight = 1 end
  local count = 0
  for _, state in pairs(states) do if state.state == "running" then count = count + 1 end end
  if count >= maxInFlight then return false, "request slots full: " .. tostring(maxInFlight) end
  return true
end

function tracker.remember(label, status, details)
  if status then
    details = details or {}
    tracker.active[tostring(label or "request")] = {
      request = status,
      label = tostring(details.label or label or "request"),
      id = details.id,
      amount = details.amount,
      submittedAt = details.submittedAt,
      attemptedAt = details.attemptedAt,
      outcomeKey = details.outcomeKey,
      target = details.target,
      source = details.source,
      auditLogged = details.auditLogged == true,
      phase = details.phase,
      reason = details.reason,
      rawReason = details.rawReason
    }
  end
  return status
end

function tracker.status(label)
  local key = tostring(label or "request")
  local record = tracker.active[key]
  if not record then return { state = "none" } end
  return tracker.inspect(record)
end

function tracker.summaries()
  local states = tracker.prune()
  local rows = {}
  for label, record in pairs(tracker.active) do
    local state = states[label]
    if type(record) == "table" then
      rows[#rows + 1] = {
        label = record.label or label,
        id = record.id,
        amount = record.amount,
        submittedAt = record.submittedAt,
        attemptedAt = record.attemptedAt,
        outcomeKey = record.outcomeKey,
        target = record.target,
        source = record.source,
        auditLogged = record.auditLogged == true,
        state = state.state,
        phase = state.phase or record.phase,
        reason = state.reason or record.reason,
        rawReason = state.rawReason or record.rawReason
      }
    else
      rows[#rows + 1] = {
        label = label, state = state.state, phase = state.phase,
        reason = state.reason, rawReason = state.rawReason
      }
    end
  end
  return rows
end

function tracker.markAuditLogged(label)
  local key = tostring(label or "request")
  local record = tracker.active[key]
  if type(record) ~= "table" then return false end
  record.auditLogged = true
  return true
end

function tracker.acknowledge(label)
  local key = tostring(label or "request")
  if tracker.active[key] == nil then return false end
  tracker.active[key] = nil
  return true
end

function tracker.clear()
  tracker.active = {}
end

return tracker
local requestResolver = require("oc.ae2.request_resolver")
local requestSubmit = require("oc.ae2.request_submit")
local cpuWitness = require("oc.ae2.maintainer_cpu_witness")

local requester = {}

function requester.readyCpu(cpus)
  for _, cpu in ipairs(cpus or {}) do
    if not cpuWitness.cpuBusy(cpu) then return cpu.name or cpu.label end
  end
  return nil
end

function requester.findCraftable(target, options)
  return requestResolver.find(target, options)
end

function requester.requestTarget(target, amount, options)
  return requestSubmit.requestTarget(target, amount, options)
end

function requester.warm(options)
  return requestResolver.warm(options)
end

function requester.lastReport()
  return requestSubmit.lastReport()
end

return requester
local computer = require("computer")

local time = {}

local function seconds(value)
  local number = tonumber(value)
  if not number then number = computer.uptime() end
  if number < 0 then number = 0 end
  return math.floor(number + 0.5)
end

function time.now()
  return computer.uptime()
end

function time.short(value)
  local total = seconds(value)
  local days = math.floor(total / 86400)
  total = total % 86400
  local hours = math.floor(total / 3600)
  total = total % 3600
  local minutes = math.floor(total / 60)
  local secs = total % 60
  if days > 0 then return string.format("%dd%02d:%02d", days, hours, minutes) end
  if hours > 0 then return string.format("%d:%02d:%02d", hours, minutes, secs) end
  return string.format("%02d:%02d", minutes, secs)
end

function time.duration(value)
  local total = seconds(value)
  if total >= 3600 then return string.format("%dh%02dm", math.floor(total / 3600), math.floor((total % 3600) / 60)) end
  if total >= 60 then return string.format("%dm%02ds", math.floor(total / 60), total % 60) end
  return tostring(total) .. "s"
end

function time.receipt(prefix, label, amount, isFluid)
  label = tostring(label or "target")
  amount = math.floor(tonumber(amount) or 1)
  if isFluid then
    return tostring(prefix or "") .. tostring(amount) .. " mB " .. label .. " @" .. time.short() .. "."
  end
  return tostring(prefix or "") .. tostring(amount) .. "x " .. label .. " @" .. time.short() .. "."
end

return time
local computer = require("computer")

local budget = {}

local defaults = {
  capacity = 8,
  refillPerSecond = 4
}

local profiles = {
  manual_action = { priority = 1, cost = 8, borrow = true },
  daemon_dispatch = { priority = 2, cost = 8, borrow = true },
  queue_dispatch = { priority = 3, cost = 1 },
  warm_continuation = { priority = 4, cost = 8 },
  visible_refresh = { priority = 5, cost = 4 },
  passive_cache = { priority = 6, cost = 2 }
}

local state = {
  capacity = defaults.capacity,
  refillPerSecond = defaults.refillPerSecond,
  tokens = defaults.capacity,
  updatedAt = nil,
  lastKind = nil
}

local function nowValue(options)
  return tonumber(options and options.now) or computer.uptime()
end

local function profileFor(kind)
  return profiles[kind] or profiles.visible_refresh
end

local function refill(now)
  now = tonumber(now) or computer.uptime()
  if not state.updatedAt then
    state.updatedAt = now
    state.tokens = math.min(state.capacity, tonumber(state.tokens) or state.capacity)
    return
  end
  local elapsed = now - state.updatedAt
  if elapsed > 0 then
    state.tokens = math.min(state.capacity, (tonumber(state.tokens) or 0) + (elapsed * state.refillPerSecond))
    state.updatedAt = now
  end
end

local function snapshot(kind, wait, borrowed)
  local waiting = (tonumber(wait) or 0) > 0
  return {
    kind = kind,
    tokens = state.tokens,
    capacity = state.capacity,
    refillPerSecond = state.refillPerSecond,
    wait = wait or 0,
    borrowed = borrowed == true,
    reason = waiting and "AE2 budget cooling down" or nil
  }
end

function budget.reset(options)
  options = options or {}
  state.capacity = math.max(1, tonumber(options.capacity) or defaults.capacity)
  state.refillPerSecond = math.max(0.1, tonumber(options.refillPerSecond) or defaults.refillPerSecond)
  state.tokens = tonumber(options.tokens) or state.capacity
  state.updatedAt = nowValue(options)
  state.lastKind = nil
end

function budget.status(options)
  refill(nowValue(options))
  return snapshot(state.lastKind)
end

function budget.priorities()
  local out = {}
  for kind, profile in pairs(profiles) do out[kind] = profile.priority end
  return out
end

function budget.waitFor(kind, options)
  options = options or {}
  local profile = profileFor(kind)
  local cost = math.max(0, tonumber(options.cost) or profile.cost or 1)
  refill(nowValue(options))
  if state.tokens >= cost then return 0 end
  return math.ceil(((cost - state.tokens) / state.refillPerSecond) * 10) / 10
end

function budget.trySpend(kind, options)
  options = options or {}
  local profile = profileFor(kind)
  local cost = math.max(0, tonumber(options.cost) or profile.cost or 1)
  local borrow = options.borrow == true or profile.borrow == true
  refill(nowValue(options))
  state.lastKind = kind
  if cost <= 0 then return true, snapshot(kind) end
  if state.tokens >= cost then
    state.tokens = state.tokens - cost
    return true, snapshot(kind)
  end
  if borrow then
    state.tokens = state.tokens - cost
    return true, snapshot(kind, 0, true)
  end
  return false, snapshot(kind, budget.waitFor(kind, { cost = cost, now = nowValue(options) }))
end

return budget
local computerOk, computer = pcall(require, "computer")
if not computerOk then computer = { uptime = function() return os.clock and os.clock() or 0 end } end
local binding = require("oc.ae2.request_binding")
local stateIdentity = require("oc.ae2.maintainer_state_identity")

local epoch = {}

local state = {
  workflowVersion = 0,
  workflowSignature = nil,
  targetSignature = nil,
  ae2Primary = nil,
  batteryNode = nil,
  lastCompleteWarm = nil,
  lastReason = nil,
  lastManualBatch = nil,
  lastAutoBatch = nil,
  lastBatch = nil
}

local function boolText(value)
  return tostring(value == true)
end

local function kindFor(target)
  if not target then return "item" end
  if target.isFluid == true or target.kind == "fluid" then return "fluid" end
  local label = tostring(target.rawLabel or target.label or "")
  if label:find("^[Dd]rops? of%s+") then return "fluid" end
  return target.kind or "item"
end

local function targetsFor(config)
  if type(config) ~= "table" then return {} end
  if type(config.targets) == "table" then return config.targets end
  local targets = {}
  for _, row in ipairs(config.workflows or {}) do
    if row.mode == "auto" then targets[#targets + 1] = row end
  end
  return targets
end

function epoch.targetKey(target)
  target = target or {}
  if target.name then
    local marker = binding.copyTaggedLabelBinding(target)
    return tostring(kindFor(target)) .. ":" .. tostring(target.name) .. ":"
      .. tostring(target.damage or "") .. ":" .. boolText(target.hasTag) .. ":"
      .. tostring(target.rawLabel or target.label or target.name or ""):lower()
      .. (marker and (":" .. marker.mode .. ":" .. marker.rawLabel) or "")
  end
  return tostring(target.label or target.rawLabel or "target"):lower()
end

function epoch.targetSignature(targets)
  local parts = {}
  for index, target in ipairs(targets or {}) do
    parts[index] = epoch.targetKey(target) .. "@" .. binding.stockAuthorityKey(target)
  end
  return table.concat(parts, "|")
end

local function fluidPolicySignature(value)
  value = type(value) == "table" and value or {}
  return table.concat({
    tostring(value.mode or "disabled"), tostring(value.canaryFluid or ""),
    tostring(value.topology or ""), tostring(value.topologyRevision or ""),
    tostring(value.hostId or ""), tostring(value.lastTopologyRevision or ""),
    boolText(value.fluidDiscretizerActive), boolText(value.noExternalAENetworkInventories),
    boolText(value.configuredTargetsReviewed), tostring(value.reviewedFluidCount or ""),
    tostring(value.reviewedFluidSignature or ""), boolText(value.locked)
  }, ":")
end

function epoch.configSignature(config)
  config = config or {}
  local targets = targetsFor(config)
  return tostring(config.autoEnabled ~= false) .. "|" .. tostring(config.craftCompatibility or "scalar_only")
    .. "|" .. fluidPolicySignature(config.fluidStockCompatibility) .. "|" .. stateIdentity.configSignature(targets)
end

function epoch.nodeId(node)
  if type(node) ~= "table" or not node.address then return nil end
  return tostring(node.type or node.kind or "node") .. ":" .. tostring(node.address)
end

local function copy()
  return {
    workflowVersion = state.workflowVersion,
    workflowSignature = state.workflowSignature,
    targetSignature = state.targetSignature,
    ae2Primary = state.ae2Primary,
    batteryNode = state.batteryNode,
    lastCompleteWarm = state.lastCompleteWarm,
    lastReason = state.lastReason,
    lastManualBatch = state.lastManualBatch,
    lastAutoBatch = state.lastAutoBatch,
    lastBatch = state.lastBatch
  }
end

function epoch.reset()
  state.workflowVersion, state.workflowSignature, state.targetSignature = 0, nil, nil
  state.ae2Primary, state.batteryNode = nil, nil
  state.lastCompleteWarm, state.lastReason = nil, nil
  state.lastManualBatch, state.lastAutoBatch, state.lastBatch = nil, nil, nil
end

function epoch.snapshot()
  return copy()
end

function epoch.recordWorkflow(config, reason)
  local targets = targetsFor(config)
  local targetSig = epoch.targetSignature(targets)
  local signature = epoch.configSignature(config)
  local targetsChanged = state.targetSignature ~= targetSig
  local changed = targetsChanged or state.workflowSignature ~= signature
  if changed then
    state.workflowVersion = state.workflowVersion + 1
    state.workflowSignature = signature
    state.targetSignature = targetSig
    state.lastReason = reason or (targetsChanged and "target_signature" or "workflow_policy")
  end
  local out = copy()
  out.changed = changed
  out.targetsChanged = targetsChanged
  out.policyChanged = changed and not targetsChanged
  return out
end

function epoch.recordNodes(nodes)
  nodes = nodes or {}
  local ae2 = epoch.nodeId(nodes.ae2Primary or nodes.primary or nodes.ae2)
  local battery = epoch.nodeId(nodes.batteryNode or nodes.battery or nodes.power)
  local ae2Changed = ae2 ~= nil and state.ae2Primary ~= ae2
  local batteryChanged = battery ~= nil and state.batteryNode ~= battery
  if ae2Changed then state.ae2Primary, state.lastReason = ae2, "ae2_primary" end
  if batteryChanged then state.batteryNode, state.lastReason = battery, "battery_node" end
  local out = copy()
  out.ae2Changed, out.batteryChanged = ae2Changed, batteryChanged
  return out
end

local function recordBatch(entry, now, reason)
  local batch = {
    at = tonumber(now) or computer.uptime(),
    target = epoch.targetKey(entry)
  }
  if reason == "auto_batch" then state.lastAutoBatch = batch else state.lastManualBatch = batch end
  state.lastBatch = { at = batch.at, target = batch.target, reason = reason }
  state.lastReason = reason
  return copy()
end

function epoch.recordManualBatch(entry, now)
  return recordBatch(entry, now, "manual_batch")
end

function epoch.recordAutoBatch(entry, now)
  return recordBatch(entry, now, "auto_batch")
end

function epoch.markCompleteWarm(report, now)
  if type(report) == "table" and report.status and report.status.complete == true then
    state.lastCompleteWarm = tonumber(now) or computer.uptime()
    state.lastReason = "complete_warm"
  end
  return copy()
end

function epoch.invalidationFor(cacheEpoch)
  cacheEpoch = cacheEpoch or {}
  local ae2Changed = state.ae2Primary and cacheEpoch.ae2Primary
    and state.ae2Primary ~= cacheEpoch.ae2Primary
  local batteryChanged = state.batteryNode and cacheEpoch.batteryNode
    and state.batteryNode ~= cacheEpoch.batteryNode
  local targetsChanged = state.targetSignature and cacheEpoch.targetSignature
    and state.targetSignature ~= cacheEpoch.targetSignature
  local workflowChanged = cacheEpoch.workflowVersion
    and cacheEpoch.workflowVersion ~= state.workflowVersion
  return {
    workflow = workflowChanged == true,
    policy = workflowChanged == true and not targetsChanged and not ae2Changed,
    context = ae2Changed == true or batteryChanged == true,
    targetRows = ae2Changed == true or targetsChanged == true,
    stock = ae2Changed == true or targetsChanged == true,
    ae2Primary = ae2Changed == true,
    batteryNode = batteryChanged == true
  }
end

function epoch.stamp(cache, config, context, complete, now)
  if type(cache) ~= "table" then return nil end
  epoch.recordWorkflow(config, complete and "complete_warm" or "warm_slice")
  if context then
    epoch.recordNodes({ ae2Primary = context.primary, batteryNode = context.batteryNode or (context.current or {}).power })
  end
  cache.epoch = complete and epoch.markCompleteWarm({ status = { complete = true } }, now) or copy()
  return cache.epoch
end

return epoch
local cacheEpoch = require("oc.ae2.cache_epoch")
local binding = require("oc.ae2.request_binding")

local computerOk, computer = pcall(require, "computer")
if not computerOk then computer = { uptime = function() return os.clock and os.clock() or 0 end } end

local memory = {}

memory.maxEntries = 256
memory.maxAge = 900
memory.maxFutureSkew = 5
memory.sourceMaxAges = {
  ["compat-fluid-snapshot"] = 600,
  ["legacy-fluid-proxy-exact"] = 120
}
local entries = {}

local function now()
  local ok, value = pcall(computer.uptime)
  return ok and tonumber(value) or 0
end

local function keyFor(target, options)
  options = options or {}
  if options.key then return tostring(options.key) end
  local key = target and target.stockMemoryKey
    and tostring(target.stockMemoryKey) or cacheEpoch.targetKey(target)
  if key:find("|stock=", 1, true) then return key end
  return key .. "|stock=" .. binding.stockAuthorityKey(target)
end

function memory.key(target) return keyFor(target, {}) end

local function currentFor(row)
  local value = tonumber(row and (row.current or row.size or row.amount or row[4]))
  if value == nil or value ~= value or value == math.huge or value == -math.huge or value < 0 then
    return nil
  end
  return value
end

local function compact(target, row, key, address, source, at)
  target, row = target or {}, row or {}
  local current = currentFor(row)
  if current == nil then return nil end
  return {
    key = key,
    address = address,
    source = source or "unknown",
    at = at,
    current = current,
    label = row.label or target.label or target.rawLabel or target.name,
    rawLabel = row.rawLabel or target.rawLabel,
    name = row.name or target.name,
    damage = row.damage ~= nil and row.damage or target.damage,
    hasTag = row.hasTag ~= nil and row.hasTag or target.hasTag,
    kind = row.kind or target.kind,
    isFluid = row.isFluid ~= nil and row.isFluid or target.isFluid,
    amount = row.amount or target.amount,
    filter = row.filter or target.filter,
    craftBinding = target.craftBinding or row.craftBinding,
    stockBinding = binding.copyStockBinding(target) or binding.copyStockBinding(row)
  }
end

local function prune()
  local count = 0
  for _ in pairs(entries) do count = count + 1 end
  while count > memory.maxEntries do
    local oldestKey, oldestAt = nil, nil
    for key, entry in pairs(entries) do
      if oldestAt == nil or (tonumber(entry.at) or 0) < oldestAt then
        oldestKey, oldestAt = key, tonumber(entry.at) or 0
      end
    end
    if not oldestKey then return end
    entries[oldestKey] = nil
    count = count - 1
  end
end

function memory.clear()
  entries = {}
end

function memory.remember(target, row, options)
  options = options or {}
  local key = keyFor(target, options)
  local at = tonumber(options.at) or now()
  local previous = entries[key]
  if previous and (tonumber(previous.at) or 0) > at then return false, previous end
  local entry = compact(target, row, key, options.address, options.source, at)
  if not entry then return false, previous end
  entries[key] = entry
  prune()
  return true, entry
end

function memory.rememberRows(rows, options)
  options = options or {}
  local aggregated = {}
  for _, row in ipairs(rows or {}) do
    local key = row and row.stockMemoryKey and keyFor(row, {})
    local current = key and currentFor(row)
    if key and current then
      local aggregate = aggregated[key]
      if aggregate then
        aggregate.size = (tonumber(aggregate.size) or 0) + current
        aggregate.current = aggregate.size
      else
        aggregate = {}
        for field, value in pairs(row) do aggregate[field] = value end
        aggregate.size, aggregate.current = current, current
        aggregated[key] = aggregate
      end
    end
  end
  local changed = 0
  for key, row in pairs(aggregated) do
    local ok = memory.remember(row, row, {
      key = key,
      address = options.address,
      source = options.source or "stock",
      at = options.at
    })
    if ok then changed = changed + 1 end
  end
  return changed
end

function memory.lookup(target, options)
  options = options or {}
  local entry = entries[keyFor(target, options)]
  if not entry then return nil end
  if options.address and entry.address ~= options.address then return nil end
  return entry
end

function memory.age(entry, at)
  if type(entry) ~= "table" or type(entry.at) ~= "number" then return nil end
  return (tonumber(at) or now()) - entry.at
end

function memory.isFresh(entry, options)
  options = options or {}
  local age = memory.age(entry, options.at)
  if age == nil then return false, "stock snapshot unavailable", nil end
  if age < -memory.maxFutureSkew then return false, "stock snapshot timestamp is in the future", age end
  age = math.max(0, age)
  local maxAge = tonumber(options.maxAge)
  if maxAge == nil then maxAge = memory.maxAge end
  local sourceMaxAge = tonumber(memory.sourceMaxAges[entry.source])
  -- Source-specific legacy authority expires at its own strict boundary. A
  -- broader caller cache TTL must never extend a compatibility or proxy fact.
  if sourceMaxAge and age >= sourceMaxAge then
    return false, "stock snapshot stale", age
  end
  if maxAge >= 0 and age > maxAge then
    return false, "stock snapshot stale", age
  end
  return true, nil, age
end

function memory.fresh(target, options)
  options = options or {}
  local entry = memory.lookup(target, options)
  if not entry then return nil, "stock snapshot unavailable", nil end
  local fresh, reason, age = memory.isFresh(entry, options)
  if not fresh then return nil, reason, age end
  return entry, nil, age
end

function memory.apply(row, target, options)
  row = row or {}
  local entry = memory.lookup(target or row, options)
  if not entry then return row, false end
  local fresh, reason, age = memory.isFresh(entry, options)
  row.current = entry.current
  local min = tonumber(row.min or (target and target.min)) or 0
  local craftTo = tonumber(row.craftTo or (target and (target.craftTo or target.min))) or min
  local batch = tonumber(row.batch or (target and target.batch)) or craftTo
  row.min, row.craftTo, row.batch = min, craftTo, batch
  row.request = row.current >= min and 0 or batch
  if row.request < 0 then row.request = 0 end
  row.error = nil
  row.stockMemoryAt = entry.at
  row.stockMemorySource = entry.source
  row.stockMemoryFresh = fresh
  row.stockMemoryAge = age
  if not fresh then row.stockMemoryReason = reason end
  return row, true
end

function memory.snapshot()
  local copy = {}
  for key, entry in pairs(entries) do
    local row = {}
    for field, value in pairs(entry) do row[field] = value end
    copy[key] = row
  end
  return copy
end

return memory
local component = require("component")

local cache = require("oc.ae2.request_cache")
local binding = require("oc.ae2.request_binding")
local gridReadGuard = require("oc.ae2.grid_read_guard")
local stockMemory = require("oc.ae2.stock_memory")

local computerOk, computer = pcall(require, "computer")
if not computerOk then computer = { uptime = function() return os.clock and os.clock() or 0 end } end

-- Modern NetworkControl surfaces perform one exact monitor lookup. Legacy
-- hosts may lack getFluidInNetwork; an explicitly locked AE2FC binding can use
-- one exact NBT-addressed fluid-drop item instead. Plural fallbacks remain
-- quarantined on the production grid, and an unproven nil remains unknown.
local direct = {}
local FLUID_FALLBACK_MAX_AGE = 600
local FLUID_FALLBACK_MAX_ROWS = 16384
local LEGACY_CANARY_MAX_AGE = 60
local LEGACY_CANARY_WITNESS_LIMIT = 64
local LEGACY_POSITIVE_WITNESS_LIMIT = 512
local retainedFluidSnapshot
local retainedCanaryWitnesses = {}
local positiveProxyTargets = {}

local function kindFor(target)
  return target and (target.isFluid == true or target.kind == "fluid") and "fluid" or "item"
end

local function valueFor(stack, kind)
  if type(stack) ~= "table" then return nil end
  if kind == "fluid" then return tonumber(stack.amount or stack.size or stack.count) end
  return tonumber(stack.size or stack.count or stack.amount)
end

local function validCount(value)
  return type(value) == "number" and value == value
    and value ~= math.huge and value ~= -math.huge and value >= 0
end

local function now(options)
  local supplied = tonumber(options and options.at)
  if supplied then return supplied end
  local ok, value = pcall(computer.uptime)
  return ok and tonumber(value) or 0
end

local function methodUnavailable(value)
  local lower = tostring(value or ""):lower()
  return lower:find("no such method", 1, true) ~= nil
    or lower:find("unknown method", 1, true) ~= nil
    or lower:find("missing method", 1, true) ~= nil
    or lower:find("method not found", 1, true) ~= nil
end

local function fluidPayload(row)
  if type(row) ~= "table" then return nil end
  if type(row.fluidDrop) == "table" then return row.fluidDrop end
  if type(row.fluidPacket) == "table" then return row.fluidPacket end
  return row
end

local function compactFluidRows(rows)
  local counts, errors = {}, {}
  local scanned, highestIndex = 0, 0
  local declared = rows and rows.n
  if declared ~= nil then
    if type(declared) ~= "number" or declared ~= declared or declared == math.huge
        or declared == -math.huge or declared < 0 or declared % 1 ~= 0 then
      error("fluid compatibility snapshot returned an invalid declared row count")
    end
    if declared > FLUID_FALLBACK_MAX_ROWS then
      error("fluid compatibility snapshot exceeded the " .. tostring(FLUID_FALLBACK_MAX_ROWS) .. "-row safety cap")
    end
  end
  for key, row in pairs(rows or {}) do
    if key ~= "n" then
      if type(key) ~= "number" then
        error("fluid compatibility snapshot returned a nonnumeric row index")
      end
      if key < 1 or key % 1 ~= 0 or (declared ~= nil and key > declared) then
        error("fluid compatibility snapshot returned an invalid row index")
      end
      scanned = scanned + 1
      highestIndex = math.max(highestIndex, key)
      if scanned > FLUID_FALLBACK_MAX_ROWS then
        error("fluid compatibility snapshot exceeded the " .. tostring(FLUID_FALLBACK_MAX_ROWS) .. "-row safety cap")
      end
      if type(row) ~= "table" then error("fluid compatibility snapshot returned a malformed row") end
      local payload = fluidPayload(row)
      local name = payload and payload.name
      if type(name) ~= "string" or name == "" then
        error("fluid compatibility snapshot returned a row without registry identity")
      end
      local amount = valueFor(payload, "fluid")
      -- AE2FC wrappers may themselves be tagged while their nested fluid is
      -- ordinary. Judge the normalized payload only, and use the repository's
      -- fail-closed tag coercion for unfamiliar callback values.
      if binding.tagged(payload.hasTag) then
        errors[name] = "fluid compatibility snapshot returned a tagged variant"
      elseif amount == nil or amount ~= amount or amount == math.huge or amount == -math.huge or amount < 0 then
        errors[name] = "fluid compatibility snapshot returned an invalid amount"
      else
        local total = (counts[name] or 0) + amount
        if not validCount(total) then
          counts[name] = nil
          errors[name] = "fluid compatibility snapshot returned an invalid aggregate amount"
        elseif errors[name] == nil then
          counts[name] = total
        end
      end
      if scanned % 64 == 0 and os.sleep then os.sleep(0) end
    end
  end
  if declared ~= nil and scanned ~= declared then
    error("fluid compatibility snapshot declared " .. tostring(declared)
      .. " rows but returned " .. tostring(scanned))
  end
  if declared == nil and highestIndex ~= scanned then
    error("fluid compatibility snapshot returned sparse row indexes")
  end
  return counts, errors
end

local function resetFallback(state, address)
  state.address = address
  state.scalarUnavailable, state.scalarError = nil, nil
  state.attempted, state.complete, state.error = nil, nil, nil
  state.counts, state.errors, state.at, state.attemptedAt = nil, nil, nil, nil
  state.retained, state.canaryWitness = nil, nil
end

local function fallbackState(options, node)
  local state = type(options.fluidFallback) == "table" and options.fluidFallback or {}
  if type(options.fluidFallback) ~= "table" then options.fluidFallback = state end
  if state.address ~= node.address then resetFallback(state, node.address) end
  local stamp = now(options)
  local maxAge = math.max(0, tonumber(options.fluidFallbackMaxAge) or FLUID_FALLBACK_MAX_AGE)
  local stateAt = tonumber(state.at or state.attemptedAt)
  if stateAt and (stamp < stateAt or stamp - stateAt >= maxAge) then resetFallback(state, node.address) end
  local retained = retainedFluidSnapshot
  if not state.attempted and retained and retained.address == node.address
      and stamp >= retained.at and stamp - retained.at < maxAge then
    state.scalarUnavailable, state.scalarError = true, retained.scalarError
    state.complete, state.counts, state.errors = true, retained.counts, retained.errors
    state.at, state.retained = retained.at, true
  end
  return state, stamp
end

local function loadFluidFallback(state, node, stamp, report)
  if state.complete then return true end
  if state.attempted then return nil, state.error or "fluid compatibility snapshot unavailable" end
  state.attempted, state.attemptedAt = true, stamp
  local allowed, guardErr = gridReadGuard.check("getFluidsInNetwork")
  if not allowed then
    gridReadGuard.annotate(report, "getFluidsInNetwork")
    report.mode = "scalar-only-blocked"
    state.error = guardErr
    return nil, state.error
  end
  local values = table.pack(pcall(component.invoke, node.address, "getFluidsInNetwork"))
  report.calls = report.calls + 1
  if not values[1] then
    state.error = "fluid compatibility snapshot failed: " .. tostring(values[2])
    return nil, state.error
  end
  if type(values[2]) ~= "table" then
    state.error = "fluid compatibility snapshot returned no table"
    return nil, state.error
  end
  local ok, counts, errors = pcall(compactFluidRows, values[2])
  values[2] = nil
  if not ok then
    state.error = "fluid compatibility snapshot could not be indexed: " .. tostring(counts)
    return nil, state.error
  end
  state.complete, state.counts, state.errors, state.at = true, counts, errors, stamp
  retainedFluidSnapshot = {
    address = node.address,
    at = stamp,
    counts = counts,
    errors = errors,
    scalarError = state.scalarError
  }
  return true
end

local function proxyCount(row, expectedFluid)
  if type(row) ~= "table" then return nil, "legacy fluid proxy returned a malformed row" end
  if row.name ~= binding.legacyFluidProxyItem or tonumber(row.damage) ~= 0 then
    return nil, "legacy fluid proxy outer identity did not match the AE2FC fluid drop"
  end
  if not binding.tagged(row.hasTag) then
    return nil, "legacy fluid proxy outer identity was not NBT-addressed"
  end
  local payload = row.fluidDrop
  if type(payload) ~= "table" or tostring(payload.name or "") ~= tostring(expectedFluid) then
    return nil, "legacy fluid proxy nested identity did not match " .. tostring(expectedFluid)
  end
  if binding.tagged(payload.hasTag) then
    return nil, "legacy fluid proxy nested identity is tagged and unsupported"
  end
  local count = tonumber(row.size)
  if not validCount(count) or count ~= math.floor(count) then
    return nil, "legacy fluid proxy returned an invalid top-level size"
  end
  return count
end

local function invokeProxy(node, detail, report)
  local values = table.pack(pcall(component.invoke, node.address, "getItemInNetwork",
    detail.name, detail.damage, detail.nbt))
  report.calls = report.calls + 1
  if os and type(os.sleep) == "function" then os.sleep(0) end
  if not values[1] then
    return nil, "legacy fluid proxy lookup failed: " .. tostring(values[2]), false
  end
  if values[2] == nil then return nil, nil, true end
  local count, err = proxyCount(values[2], detail.fluid)
  if count == nil then return nil, err, false end
  return count, nil, false
end

-- One exact AE2FC lookup used only while building the global 2.8.4 profile.
-- It never enumerates grid storage and a nil/zero result is not zero authority;
-- it merely means this recorded identity cannot serve as the positive canary.
function direct.probeLegacyFluidProxy(fluid, node)
  local report = { calls = 0, method = "getItemInNetwork", mode = "legacy-fluid-canary-probe",
    canaryFluid = fluid, contract = binding.fluidStockCapabilityContract }
  if not binding.validFluidName(fluid) then
    return false, "exact recorded fluid identity is invalid", report
  end
  if type(node) ~= "table" or not node.address then
    report.transportFailure = true
    return false, "exact AE2FC canary probe has no AE2 node", report
  end
  report.gridAddress = tostring(node.address)
  local count, reason, absent = invokeProxy(node, {
    name = binding.legacyFluidProxyItem, damage = 0,
    nbt = '{Fluid:"' .. tostring(fluid) .. '"}', fluid = tostring(fluid)
  }, report)
  if reason then
    report.transportFailure = true
    return false, reason, report
  end
  report.count = tonumber(count) or 0
  if absent or not count or count <= 0 then
    return false, "exact recorded fluid is not currently positive", report
  end
  return true, nil, report
end

local function canaryKey(details)
  return table.concat({ details.mode or binding.legacyFluidStockMode, details.hostId or "row",
    details.canary.fluid, details.topology, details.topologyRevision }, ":")
end

local function retainedCanaryKey(node, details)
  return tostring(node.type or "node") .. ":" .. tostring(node.address) .. ":" .. canaryKey(details)
end

local function witnessFresh(witness, details, stamp, options)
  if type(witness) ~= "table" or witness.key ~= canaryKey(details) then return false end
  local age = stamp - (tonumber(witness.at) or -math.huge)
  local maxAge = math.min(LEGACY_CANARY_MAX_AGE,
    math.max(0, tonumber(options.legacyCanaryMaxAge) or LEGACY_CANARY_MAX_AGE))
  return age >= 0 and age < maxAge and tonumber(witness.count) and witness.count > 0
end

local function canaryFresh(state, node, details, stamp, options)
  if witnessFresh(state.canaryWitness, details, stamp, options) then return true end
  local retained = retainedCanaryWitnesses[retainedCanaryKey(node, details)]
  if not witnessFresh(retained, details, stamp, options) then return false end
  state.canaryWitness = { key = retained.key, at = retained.at, count = retained.count }
  return true
end

local function rememberCanaryWitness(node, details, witness)
  local key = retainedCanaryKey(node, details)
  if retainedCanaryWitnesses[key] == nil then
    local count, oldestKey, oldestAt = 0, nil, nil
    for candidate, retained in pairs(retainedCanaryWitnesses) do
      count = count + 1
      local observedAt = tonumber(retained and retained.at) or -math.huge
      if oldestAt == nil or observedAt < oldestAt then oldestKey, oldestAt = candidate, observedAt end
    end
    if count >= LEGACY_CANARY_WITNESS_LIMIT and oldestKey then retainedCanaryWitnesses[oldestKey] = nil end
  end
  retainedCanaryWitnesses[key] = { key = witness.key, at = witness.at, count = witness.count }
end

local function positiveTargetKey(node, target)
  return tostring(node.type or "node") .. ":" .. tostring(node.address) .. ":"
    .. binding.stockAuthorityKey(target)
end

local function rememberPositiveTarget(key, stamp)
  if positiveProxyTargets[key] == nil then
    local count, oldestKey, oldestAt = 0, nil, nil
    for candidate, observedAt in pairs(positiveProxyTargets) do
      count = count + 1
      if oldestAt == nil or observedAt < oldestAt then oldestKey, oldestAt = candidate, observedAt end
    end
    if count >= LEGACY_POSITIVE_WITNESS_LIMIT and oldestKey then positiveProxyTargets[oldestKey] = nil end
  end
  positiveProxyTargets[key] = stamp
end

local function legacyFluidCount(target, node, options, report, state, stamp)
  local details, bindErr = binding.legacyFluidStockDetails(target)
  if not details then return nil, bindErr end
  if details.inheritedGlobal and tostring(details.gridAddress or "") ~= tostring(node.address or "") then
    return nil, "Fluid Stock capability belongs to a different AE2 grid; automatic recommissioning required"
  end
  report.method, report.mode = "getItemInNetwork", "legacy-fluid-proxy-exact"
  report.methodUnavailable = true
  report.stockBinding = {
    mode = details.mode or binding.legacyFluidStockMode,
    canaryFluid = details.canary.fluid,
    topology = details.topology,
    topologyRevision = details.topologyRevision,
    hostId = details.hostId,
    inheritedGlobal = details.inheritedGlobal == true,
    reviewedFluidCount = details.reviewedFluidCount,
    zeroWhenCanaryPositive = details.zeroWhenCanaryPositive == true,
    locked = true
  }

  local targetCount
  if not canaryFresh(state, node, details, stamp, options) then
    local canaryCount, canaryErr, canaryAbsent = invokeProxy(node, details.canary, report)
    if canaryErr then return nil, canaryErr end
    if canaryAbsent or not canaryCount or canaryCount <= 0 then
      return nil, "legacy fluid proxy canary is not positive; verify the powered, channelled Fluid Discretizer"
    end
    state.canaryWitness = { key = canaryKey(details), at = stamp, count = canaryCount }
    rememberCanaryWitness(node, details, state.canaryWitness)
  end

  if targetCount == nil then
    local absent, targetErr
    targetCount, targetErr, absent = invokeProxy(node, details.target, report)
    if targetErr then return nil, targetErr end
    if absent then
      if details.zeroWhenCanaryPositive then
        targetCount = 0
        report.zeroAuthority = "positive-canary-and-pinned-reviewed-target"
      elseif positiveProxyTargets[positiveTargetKey(node, target)] == nil then
        return nil, "legacy fluid proxy target has no positive runtime witness; reserve at least 1 mB once before zero authority"
      else
        targetCount = 0
        report.zeroAuthority = "positive-canary-and-prior-positive-target"
      end
    end
  end
  if targetCount > 0 then rememberPositiveTarget(positiveTargetKey(node, target), stamp) end
  report.canaryAt, report.canaryFluid = state.canaryWitness.at, details.canary.fluid
  report.topologyRevision = details.topologyRevision
  return targetCount
end

local function productionGuardActive()
  local ok, status = pcall(gridReadGuard.status)
  if not ok or type(status) ~= "table" then return true end
  return status.active ~= false
end

local function fallbackFluidCount(target, node, options, report)
  local state, stamp = fallbackState(options, node)
  if not state.scalarUnavailable then return nil, nil, state, stamp end
  local details, bindErr = binding.legacyFluidStockDetails(target)
  if details then
    report.scalarError, report.methodUnavailable = state.scalarError, true
    local count, err = legacyFluidCount(target, node, options, report, state, stamp)
    return count, err, state, stamp
  end
  if productionGuardActive() then
    gridReadGuard.annotate(report, "getFluidsInNetwork")
    report.mode, report.scalarError, report.methodUnavailable = "scalar-only-unbound", state.scalarError, true
    return nil, bindErr, state, stamp
  end
  report.method, report.mode = "getFluidsInNetwork", "compat-fluid-snapshot"
  report.scalarError, report.methodUnavailable = state.scalarError, true
  local ok, err = loadFluidFallback(state, node, stamp, report)
  if not ok then return nil, err, state, stamp end
  local targetError = state.errors and state.errors[target.name]
  if targetError then return nil, targetError, state, state.at end
  report.snapshotAt, report.retained = state.at, state.retained == true
  return tonumber(state.counts and state.counts[target.name]) or 0, nil, state, state.at
end

function direct.refresh(target, node, options)
  options = options or {}
  local bindErr = cache.bindingError(target)
  if bindErr then return nil, bindErr, { calls = 0, bindingRequired = true } end
  if not (node and node.address) then return nil, "exact stock reader has no AE2 node", { calls = 0 } end
  local kind = kindFor(target)
  local method = kind == "fluid" and "getFluidInNetwork" or "getItemInNetwork"
  -- Exact untagged bindings need only registry name plus item damage. Modern
  -- hosts support both scalar readers; older hosts support only the item reader
  -- and enter the guarded fluid compatibility lane after a missing-method proof.
  local report = { calls = 0, method = method, source = { address = node.address, type = node.type } }
  local values, current, memorySource, observedAt
  if kind == "fluid" then
    local fallback = fallbackState(options, node)
    if fallback.scalarUnavailable then
      current, report.error, fallback, observedAt = fallbackFluidCount(target, node, options, report)
      if current == nil then return nil, report.error, report end
      memorySource = report.mode == "legacy-fluid-proxy-exact"
        and "legacy-fluid-proxy-exact" or "compat-fluid-snapshot"
    else
      values = table.pack(pcall(component.invoke, node.address, method, target.name))
      report.calls = 1
      if not values[1] then
        report.scalarError = tostring(values[2])
        if not methodUnavailable(report.scalarError) then return nil, report.scalarError, report end
        fallback.scalarUnavailable, fallback.scalarError = true, report.scalarError
        current, report.error, fallback, observedAt = fallbackFluidCount(target, node, options, report)
        if current == nil then return nil, report.error, report end
        memorySource = report.mode == "legacy-fluid-proxy-exact"
          and "legacy-fluid-proxy-exact" or "compat-fluid-snapshot"
      else
        retainedFluidSnapshot = retainedFluidSnapshot and retainedFluidSnapshot.address ~= node.address
          and retainedFluidSnapshot or nil
        current = values[2] == nil and 0 or valueFor(values[2], kind)
      end
    end
  else
    values = table.pack(pcall(component.invoke, node.address, method, target.name, target.damage))
    report.calls = 1
    if not values[1] then return nil, tostring(values[2]), report end
    current = values[2] == nil and 0 or valueFor(values[2], kind)
  end

  -- A native scalar nil is exact zero. Global v2 reaches zero through its
  -- pinned reviewed target set plus positive canary; v1 keeps prior-positive proof.
  if current == nil then return nil, "exact stock reader returned no usable count", report end
  if not validCount(current) then return nil, "exact stock reader returned an invalid count", report end
  local changed, entry = stockMemory.remember(target, {
    current = current,
    label = target.label,
    rawLabel = target.rawLabel,
    name = target.name,
    damage = target.damage,
    hasTag = target.hasTag,
    kind = kind,
    isFluid = kind == "fluid",
    amount = target.amount,
    filter = target.filter,
    craftBinding = target.craftBinding,
    stockBinding = binding.copyStockBinding(target)
  }, {
    address = node.address,
    source = memorySource or "direct-exact",
    at = observedAt or options.at
  })
  if not entry then return nil, "could not retain exact stock reading", report end
  report.current, report.changed, report.entry = entry.current, changed == true, entry
  return entry, nil, report
end

function direct.clearCompatibilityMemory()
  retainedFluidSnapshot = nil
  retainedCanaryWitnesses = {}
  positiveProxyTargets = {}
  return true
end

return direct
local binding = require("oc.ae2.request_binding")
local direct = require("oc.ae2.stock_direct")
local tagged = require("oc.ae2.tagged_stock")

local stock = {}

function stock.step(state, targets, node, options)
  options = options or {}
  state = tagged.step(state, targets, node, options)
  if options.finish == true then
    local maxRows = math.max(1, math.floor(tonumber(options.maxRows) or 16384))
    while not state.complete and (tonumber(state.scanned) or 0) < maxRows do
      state = tagged.step(state, targets, node, options)
    end
    if not state.complete then
      state.complete, state.iterator = true, nil
      state.error = "tagged stock scan exceeded the " .. tostring(maxRows) .. "-row one-shot safety cap"
    end
  end
  return state
end

function stock.refresh(target, node, options)
  options = options or {}
  if binding.visibleTagged(target) then return tagged.refresh(target, node, options.tagged) end
  return direct.refresh(target, node, options)
end

return stock
local component = require("component")

local binding = require("oc.ae2.request_binding")
local gridReadGuard = require("oc.ae2.grid_read_guard")
local stockMemory = require("oc.ae2.stock_memory")

local tagged = {}

local function markerFor(value)
  return binding.copyTaggedLabelBinding(value) or binding.makeTaggedLabelBinding(value)
end

local function markerKey(marker)
  if type(marker) ~= "table" then return nil end
  return table.concat({
    tostring(marker.name), tostring(marker.damage), tostring(marker.label), tostring(marker.rawLabel)
  }, "|")
end

local function targetSet(targets)
  local wanted, parts = {}, {}
  for _, target in ipairs(targets or {}) do
    local marker = binding.copyTaggedLabelBinding(target)
    local key = markerKey(marker)
    if key and not wanted[key] then
      wanted[key] = true
      parts[#parts + 1] = key
    end
  end
  table.sort(parts)
  return wanted, table.concat(parts, "\n"), #parts
end

local function begin(targets, node)
  local wanted, signature, wantedCount = targetSet(targets)
  local state = {
    address = node and node.address,
    signature = signature,
    wanted = wanted,
    wantedCount = wantedCount,
    buckets = {},
    scanned = 0,
    calls = 0,
    complete = wantedCount == 0
  }
  if state.complete then return state end
  if not (node and node.address) then
    state.complete, state.error = true, "tagged stock scan has no AE2 node"
    return state
  end
  local allowed, guardErr = gridReadGuard.check("allItems")
  if not allowed then
    state.complete, state.error = true, guardErr
    state.gridReadMode = gridReadGuard.mode
    state.gridSnapshotBlocked = true
    state.gridSnapshotCode = gridReadGuard.code
    return state
  end
  local values = table.pack(pcall(component.invoke, node.address, "allItems"))
  state.calls = 1
  if not values[1] then
    state.complete, state.error = true, tostring(values[2])
    return state
  end
  local kind = type(values[2])
  if kind ~= "function" and kind ~= "userdata" and kind ~= "table" then
    state.complete, state.error = true, "allItems did not return a callable iterator"
    return state
  end
  state.iterator = values[2]
  return state
end

local function sameContract(state, targets, node)
  local _, signature = targetSet(targets)
  return type(state) == "table" and state.address == (node and node.address)
    and state.signature == signature
end

local function observe(state, item)
  if type(item) ~= "table" then return end
  local marker = markerFor(item)
  local key = markerKey(marker)
  if not (key and state.wanted[key]) then return end
  local bucket = state.buckets[key] or { current = 0, variants = 0 }
  bucket.variants = bucket.variants + 1
  local quantity = tonumber(item.size or item.count or item.amount)
  if not quantity or quantity ~= quantity or quantity < 0 or quantity == math.huge then
    bucket.invalidQuantity = true
  else
    bucket.current = bucket.current + quantity
  end
  state.buckets[key] = bucket
end

function tagged.step(state, targets, node, options)
  options = options or {}
  if not sameContract(state, targets, node) then state = begin(targets, node) end
  if state.complete then return state end
  local limit = math.max(1, math.min(256, math.floor(tonumber(options.scanLimit) or 64)))
  local consumed = 0
  while consumed < limit do
    local values = table.pack(pcall(state.iterator))
    if not values[1] then
      state.complete, state.error, state.iterator = true, tostring(values[2]), nil
      break
    end
    local item = values[2]
    if item == nil then state.complete, state.iterator = true, nil; break end
    consumed, state.scanned = consumed + 1, state.scanned + 1
    observe(state, item)
    if consumed % 32 == 0 and os.sleep then os.sleep(0) end
  end
  state.lastStep = consumed
  return state
end

function tagged.refresh(target, node, state)
  local marker = binding.copyTaggedLabelBinding(target)
  if not marker then return nil, binding.error(target), { calls = 0, bindingRequired = true } end
  local report = {
    calls = 0,
    scanCalls = tonumber(state and state.calls) or 0,
    scanned = tonumber(state and state.scanned) or 0,
    method = "allItems",
    mode = "tagged-visible-iterator",
    source = node and { address = node.address, type = node.type } or nil
  }
  gridReadGuard.annotate(report, "allItems")
  if not (state and state.complete == true) then
    return nil, "tagged stock scan warming after " .. tostring(report.scanned) .. " rows", report
  end
  if state.address ~= (node and node.address) then
    return nil, "tagged stock scan belongs to a different AE2 node", report
  end
  if state.error then return nil, "tagged stock scan failed: " .. tostring(state.error), report end
  local bucket = state.buckets[markerKey(marker)] or { current = 0, variants = 0 }
  report.variants = bucket.variants
  if bucket.invalidQuantity then
    return nil, "tagged stock row has an invalid quantity", report
  end
  if bucket.variants > 1 then
    return nil, "tagged stock has multiple hidden variants with this visible identity", report
  end
  local _, entry = stockMemory.remember(target, {
    current = bucket.current,
    label = target.label,
    rawLabel = target.rawLabel,
    name = target.name,
    damage = target.damage,
    hasTag = true,
    kind = "item",
    isFluid = false,
    craftBinding = marker
  }, {
    address = node and node.address,
    source = "tagged-visible-iterator"
  })
  if not entry then return nil, "could not retain tagged stock reading", report end
  report.current, report.entry = entry.current, entry
  return entry, nil, report
end

return tagged
local adapt = {}

local DEFAULT_BASE = 16
local FAST_SECONDS = 0.5
local SLOW_SECONDS = 2

local function number(value)
  local n = tonumber(value)
  if n == nil then return nil end
  return n
end

local function whole(value, fallback)
  return math.max(1, math.floor(number(value) or fallback or DEFAULT_BASE))
end

local function bounds(base)
  return math.max(1, math.floor(base / 2)), math.max(base, base * 2)
end

local function clamp(value, base)
  local min, max = bounds(base)
  value = whole(value, base)
  if value < min then return min end
  if value > max then return max end
  return value
end

local function scopes(container)
  container.adaptiveChunks = container.adaptiveChunks or {}
  return container.adaptiveChunks
end

local function slot(container, scope, base)
  local all = scopes(container)
  local key = tostring(scope or "default")
  local current = all[key]
  if type(current) ~= "table" or current.base ~= base then
    current = { base = base, nextLimit = base }
    all[key] = current
  end
  return current
end

local function complete(options)
  return options and options.complete == true
end

local function stalled(current, options, duration)
  if options and (options.ok == false or options.timeout == true) then return true end
  if duration and duration >= (number(options and options.slowSeconds) or SLOW_SECONDS) then return true end
  if complete(options) then return false end
  local calls = options and number(options.calls)
  if calls ~= nil and calls <= 0 then return true end
  local before = options and number(options.cursorBefore)
  local after = options and number(options.cursorAfter)
  return before ~= nil and after ~= nil and before == after
end

function adapt.limit(container, scope, options)
  options = options or {}
  local base = whole(options.base, DEFAULT_BASE)
  local current = slot(container, scope, base)
  if options.reset == true then current.nextLimit = base end
  current.lastIssued = clamp(current.nextLimit or base, base)
  return current.lastIssued
end

function adapt.record(container, scope, options)
  options = options or {}
  local base = whole(options.base, DEFAULT_BASE)
  local current = slot(container, scope, base)
  local duration = math.max(0, number(options.duration) or 0)
  local min, max = bounds(base)
  current.lastTargetLimit = clamp(options.targetLimit or current.lastIssued or base, base)
  current.lastDuration = duration
  current.lastCalls = options.calls
  current.lastCursor = options.cursorAfter
  if stalled(current, options, duration) then
    current.nextLimit = min
    current.lastDecision = "down"
  elseif complete(options) then
    current.nextLimit = base
    current.lastDecision = "reset"
  elseif duration <= (number(options.fastSeconds) or FAST_SECONDS) then
    current.nextLimit = max
    current.lastDecision = "up"
  else
    current.nextLimit = base
    current.lastDecision = "base"
  end
  return current
end

function adapt.status(container, scope, options)
  options = options or {}
  local base = whole(options.base, DEFAULT_BASE)
  local current = slot(container, scope, base)
  return {
    base = base,
    lastTargetLimit = current.lastTargetLimit,
    nextLimit = current.nextLimit,
    lastDecision = current.lastDecision,
    lastDuration = current.lastDuration,
    lastCalls = current.lastCalls
  }
end

return adapt
local filesystem = require("filesystem")
local serialization = require("serialization")
local time = require("oc.ae2.time")

local log = {}

log.path = "/var/oc/ae2-maintainer.log"
log.maxEntries = 100
log.outcomePath = "/var/oc/ae2-maintainer-outcomes.log"
log.maxOutcomeEntries = 100
local WRITER_SESSION = tostring({}) .. "@" .. tostring(time.now())
local guardActive = false

local function ensureParent(path)
  local pathOk, parent = pcall(filesystem.path, path)
  if not pathOk then return false, tostring(parent) end
  if not parent or parent == "" then return true end
  local existsOk, present, existsErr = pcall(filesystem.exists, parent)
  if not existsOk or type(present) ~= "boolean" then
    return false, tostring(existsErr or present or ("could not inspect " .. parent))
  end
  if present then return true end
  local madeOk, made, makeErr = pcall(filesystem.makeDirectory, parent)
  if not madeOk or made ~= true then return false, tostring(makeErr or made or ("could not create " .. parent)) end
  return true
end

local function exists(path)
  local called, present, reason = pcall(filesystem.exists, path)
  if not called then return nil, tostring(present) end
  if type(present) ~= "boolean" then return nil, tostring(reason or "could not inspect " .. path) end
  return present
end

local function close(handle, path)
  local called, closed, reason = pcall(function() return handle:close() end)
  -- OpenOS file handles may report a successful close with no return values.
  -- Preserve explicit failures and nil+reason errors without requiring a
  -- truthy success value that the runtime does not promise.
  if not called or closed == false or (closed == nil and reason ~= nil) then
    return false, tostring(reason or closed or ("could not close " .. path))
  end
  return true
end

local function writeText(path, body)
  local parentOk, parentErr = ensureParent(path)
  if not parentOk then return false, parentErr end
  local opened, handle, openErr = pcall(io.open, path, "w")
  if not opened then return false, tostring(handle) end
  if not handle then return false, tostring(openErr or ("could not write " .. path)) end
  local writeOk, wrote, writeErr = pcall(function() return handle:write(body) end)
  local closed, closeErr = close(handle, path)
  if not writeOk or wrote == nil or wrote == false then
    return false, tostring(writeErr or wrote or ("could not write " .. path))
  end
  if not closed then return false, closeErr end
  return true
end

local function readText(path)
  local opened, handle, openErr = pcall(io.open, path, "r")
  if not opened then return nil, tostring(handle) end
  if not handle then return nil, tostring(openErr or ("could not read " .. path)) end
  local readOk, body, readErr = pcall(function() return handle:read("*a") end)
  local closed, closeErr = close(handle, path)
  if not readOk then return nil, tostring(readErr or body) end
  if body == nil and readErr ~= nil then return nil, tostring(readErr) end
  if not closed then return nil, closeErr end
  return body or ""
end

-- OpenOS runs local code cooperatively. Maintainer log callbacks do not yield,
-- so one process-local guard serializes read/modify/write without placing any
-- lock, owner, stage, or previous artifact on the backup-visible filesystem.
local function withGuard(callback)
  if guardActive then return false, "maintainer audit log is busy" end
  guardActive = true
  local results = table.pack(pcall(callback))
  guardActive = false
  if not results[1] then return false, tostring(results[2]) end
  return table.unpack(results, 2, results.n)
end

local function numberOrNil(value)
  local number = tonumber(value)
  if not number then return nil end
  return number
end

local function submittedAmount(details)
  local amount = tonumber(details and details.amount)
  if not amount or amount ~= amount or amount == math.huge or amount == -math.huge or amount <= 0 then
    return nil, "maintainer batch log requires a positive submitted amount"
  end
  return amount
end

local function submittedIdentity(details)
  local source = details and tostring(details.source or "") or ""
  local requestKey = details and tostring(details.requestKey or "") or ""
  local submittedAt = numberOrNil(details and details.submittedAt)
  if source ~= "manual" and source ~= "auto" then
    return nil, "maintainer batch log requires manual or auto source"
  end
  if requestKey == "" then return nil, "maintainer batch log requires a stable request key" end
  if not submittedAt or submittedAt ~= submittedAt or submittedAt == math.huge
      or submittedAt == -math.huge or submittedAt < 0 then
    return nil, "maintainer batch log requires a finite submission timestamp"
  end
  return { source = source, requestKey = requestKey, submittedAt = submittedAt }
end

local function record(row, now, details)
  row = row or {}
  now = tonumber(now) or time.now()
  details = type(details) == "table" and details or {}
  local amount, amountErr = submittedAmount(details)
  if not amount then return nil, amountErr end
  local identity, identityErr = submittedIdentity(details)
  if not identity then return nil, identityErr end
  return {
    stamp = time.short(now),
    uptime = now,
    label = tostring(row.label or "target"),
    amount = amount,
    current = numberOrNil(row.current),
    min = numberOrNil(row.min),
    craftTo = numberOrNil(row.craftTo),
    batch = numberOrNil(row.batch),
    state = tostring(row.requestState or "running"),
    phase = row.requestPhase and tostring(row.requestPhase) or nil,
    reason = row.requestStatusReason and tostring(row.requestStatusReason) or nil,
    name = row.name and tostring(row.name) or nil,
    damage = row.damage,
    hasTag = row.hasTag == true,
    source = identity.source,
    requestKey = identity.requestKey,
    submittedAt = identity.submittedAt,
    writerSession = WRITER_SESSION
  }
end

local function boundedLimit(value)
  local limit = math.floor(tonumber(value) or log.maxEntries)
  if limit < 0 then return 0 end
  return limit
end

local function unserializeLine(line)
  local ok, value = pcall(serialization.unserialize, line)
  return ok and type(value) == "table" and value or nil
end

local function readLines(path, limit, detectOverflow)
  limit = boundedLimit(limit)
  local lines, overflow = {}, false
  local present, presentErr = exists(path)
  if present == nil then return nil, nil, presentErr end
  if not present then return lines, overflow end
  local opened, input, openErr = pcall(io.open, path, "r")
  if not opened then return nil, nil, tostring(input) end
  if not input then return nil, nil, tostring(openErr or ("could not read " .. path)) end
  while #lines < limit do
    local readOk, line, readErr = pcall(function() return input:read("*l") end)
    if not readOk then close(input, path); return nil, nil, tostring(line) end
    if line == nil then
      if readErr ~= nil then close(input, path); return nil, nil, tostring(readErr) end
      break
    end
    if line ~= "" then
      if not unserializeLine(line) then
        close(input, path)
        return nil, nil, "maintainer log decode failed: " .. path
      end
      lines[#lines + 1] = line
    end
  end
  if detectOverflow then
    while true do
      local readOk, line, readErr = pcall(function() return input:read("*l") end)
      if not readOk then close(input, path); return nil, nil, tostring(line) end
      if line == nil then
        if readErr ~= nil then close(input, path); return nil, nil, tostring(readErr) end
        break
      end
      if line ~= "" then
        overflow = true
        break
      end
    end
  end
  local closed, closeErr = close(input, path)
  if not closed then return nil, nil, closeErr end
  return lines, overflow
end

local function writeLines(path, lines)
  lines = lines or {}
  local rendered = {}
  for _, line in ipairs(lines) do
    rendered[#rendered + 1] = tostring(line) .. "\n"
  end
  local body = table.concat(rendered)

  local priorPresent, priorPresentErr = exists(path)
  if priorPresent == nil then return false, priorPresentErr end
  local priorBody
  if priorPresent then
    local priorReadErr
    priorBody, priorReadErr = readText(path)
    if priorBody == nil then return false, priorReadErr end
  end

  local function restorePrior(reason)
    if not priorPresent then
      return false, tostring(reason) .. "; new log primary retained fail-closed"
    end
    local restored, restoreErr = writeText(path, priorBody)
    if not restored then
      return false, tostring(reason) .. "; prior-log restoration failed: " .. tostring(restoreErr)
    end
    local restoredBody, restoredReadErr = readText(path)
    if restoredBody ~= priorBody then
      return false, tostring(reason) .. "; prior-log restoration verification failed: "
        .. tostring(restoredReadErr or "exact content mismatch")
    end
    return false, reason
  end

  local wrote, writeErr = writeText(path, body)
  if not wrote then return restorePrior(writeErr) end
  local verified, verifyErr = readText(path)
  if verified == body then return true, nil, #lines end

  -- A different complete nonempty body can be a successor write from another
  -- runtime. Never restore captured bytes over a possible newer audit record.
  if verified ~= nil and verified ~= "" and verified ~= priorBody then
    return false, "stable-primary log verification failed: content changed during read-back"
  end
  return restorePrior(verifyErr or "stable-primary log verification failed: exact content mismatch")
end

local function readSlice(path, pageNumber, perPage)
  local rows, total = {}, 0
  local present, presentErr = exists(path)
  if present == nil then return nil, nil, presentErr end
  if not present then return rows, total end
  local opened, handle, openErr = pcall(io.open, path, "r")
  if not opened then return nil, nil, tostring(handle) end
  if not handle then return nil, nil, tostring(openErr or ("could not read " .. path)) end
  local first = ((pageNumber - 1) * perPage) + 1
  local last = first + perPage - 1
  while true do
    local readOk, line, readErr = pcall(function() return handle:read("*l") end)
    if not readOk then close(handle, path); return nil, nil, tostring(line) end
    if line == nil then
      if readErr ~= nil then close(handle, path); return nil, nil, tostring(readErr) end
      break
    end
    if line ~= "" then
      total = total + 1
      if total >= first and total <= last then
        local ok, row = pcall(serialization.unserialize, line)
        rows[#rows + 1] = ok and type(row) == "table" and row or { stamp = "bad record", label = line, amount = 0 }
      end
    end
  end
  local closed, closeErr = close(handle, path)
  if not closed then return nil, nil, closeErr end
  return rows, total
end

local function sameEvent(left, right)
  return left and right
    and tostring(left.writerSession or "") == tostring(right.writerSession or "")
    and tostring(left.source or "") == tostring(right.source or "")
    and tostring(left.requestKey or "") == tostring(right.requestKey or "")
    and tonumber(left.submittedAt) == tonumber(right.submittedAt)
end

function log.append(source, now, details)
  local row, recordErr = record(source, now, details)
  if not row then return false, recordErr end
  return withGuard(function()
    local lines, _, readErr = readLines(log.path, log.maxEntries)
    if not lines then return false, readErr end
    for _, line in ipairs(lines) do
      local existing = unserializeLine(line)
      if sameEvent(existing, row) then
        if tonumber(existing.amount) ~= tonumber(row.amount) then
          return false, "maintainer batch audit identity collided with a different amount"
        end
        return true, nil, existing
      end
    end
    local nextLines = { serialization.serialize(row) }
    for index = 1, math.min(#lines, log.maxEntries - 1) do
      nextLines[#nextLines + 1] = lines[index]
    end
    local saved, saveErr = writeLines(log.path, nextLines)
    if not saved then return false, saveErr end
    return true, nil, row
  end)
end

local outcomeDispositions = {
  completed = true, kickout = true, skipped = true, covered = true,
  canceled = true, safety_hold = true
}
local retryKinds = { none = true, cooldown = true, backoff = true, safety_hold = true }

local function finite(value, field, required)
  if value == nil and not required then return nil end
  local number = tonumber(value)
  if not number or number ~= number or number == math.huge or number == -math.huge then
    return nil, "maintainer outcome requires a finite " .. tostring(field)
  end
  return number
end

local function outcomeRecord(source, now, details)
  source = source or {}
  details = type(details) == "table" and details or {}
  local eventKey = tostring(details.eventKey or "")
  local disposition = tostring(details.disposition or "")
  local owner = tostring(details.source or "")
  local targetId = tostring(details.targetId or details.requestKey or "")
  if eventKey == "" then return nil, "maintainer outcome requires a stable event key" end
  if not outcomeDispositions[disposition] then
    return nil, "maintainer outcome requires a known disposition"
  end
  if owner ~= "auto" and owner ~= "manual" then
    return nil, "maintainer outcome requires manual or auto source"
  end
  if targetId == "" then return nil, "maintainer outcome requires an exact target id" end
  local amount, amountErr = finite(details.amount, "amount", true)
  if not amount then return nil, amountErr end
  if amount < 0 then return nil, "maintainer outcome amount cannot be negative" end
  local attemptedAt, attemptedErr = finite(details.attemptedAt, "attempt timestamp", true)
  if not attemptedAt then return nil, attemptedErr end
  if attemptedAt < 0 then return nil, "maintainer outcome attempt timestamp cannot be negative" end
  local submittedAt, submittedErr = finite(details.submittedAt, "submission timestamp", false)
  if details.submittedAt ~= nil and submittedAt == nil then return nil, submittedErr end
  local nextEligibleAt, eligibleErr = finite(details.nextEligibleAt, "next eligible timestamp", false)
  if details.nextEligibleAt ~= nil and nextEligibleAt == nil then return nil, eligibleErr end
  local retrySeconds, retryErr = finite(details.retrySeconds, "retry duration", false)
  if details.retrySeconds ~= nil and retrySeconds == nil then return nil, retryErr end
  retrySeconds = retrySeconds or 0
  if retrySeconds < 0 then return nil, "maintainer outcome retry duration cannot be negative" end
  local retryKind = tostring(details.retryKind or "none")
  if not retryKinds[retryKind] then return nil, "maintainer outcome requires a known retry kind" end
  local attempts = math.max(0, math.floor(tonumber(details.attempts) or 0))
  return {
    stamp = time.short(now),
    outcomeAt = now,
    eventKey = eventKey,
    disposition = disposition,
    label = tostring(source.label or source.rawLabel or source.name or "target"),
    amount = amount,
    current = numberOrNil(source.current),
    min = numberOrNil(source.min),
    state = details.state and tostring(details.state) or nil,
    phase = details.phase and tostring(details.phase) or nil,
    reason = details.reason and tostring(details.reason) or nil,
    rawReason = details.rawReason and tostring(details.rawReason) or nil,
    name = source.name and tostring(source.name) or nil,
    damage = source.damage,
    hasTag = source.hasTag == true,
    kind = source.kind and tostring(source.kind) or nil,
    isFluid = source.isFluid == true,
    source = owner,
    targetId = targetId,
    requestKey = details.requestKey and tostring(details.requestKey) or nil,
    attemptedAt = attemptedAt,
    submittedAt = submittedAt,
    attempts = attempts,
    retryKind = retryKind,
    retrySeconds = retrySeconds,
    nextEligibleAt = nextEligibleAt,
    writerSession = WRITER_SESSION
  }
end

local outcomeImmutableFields = {
  "source", "targetId", "requestKey", "attemptedAt", "submittedAt", "amount"
}
local outcomeResultFields = {
  "disposition", "state", "phase", "reason", "rawReason", "attempts",
  "retryKind", "retrySeconds", "nextEligibleAt"
}

local function sameField(left, right, field)
  local a, b = left and left[field], right and right[field]
  if type(a) == "number" or type(b) == "number" then return tonumber(a) == tonumber(b) end
  return tostring(a or "") == tostring(b or "")
end

local function sameOutcome(left, right)
  if not (left and right) or tostring(left.eventKey or "") ~= tostring(right.eventKey or "") then return false end
  for _, field in ipairs(outcomeImmutableFields) do
    if not sameField(left, right, field) then return nil end
  end
  for _, field in ipairs(outcomeResultFields) do
    if not sameField(left, right, field) then return nil end
  end
  return true
end

function log.appendOutcome(source, now, details)
  now = tonumber(now) or time.now()
  local row, recordErr = outcomeRecord(source, now, details)
  if not row then return false, recordErr end
  return withGuard(function()
    local lines, _, readErr = readLines(log.outcomePath, log.maxOutcomeEntries)
    if not lines then return false, readErr end
    for _, line in ipairs(lines) do
      local existing = unserializeLine(line)
      if tostring(existing and existing.eventKey or "") == row.eventKey then
        if sameOutcome(existing, row) then return true, nil, existing end
        return false, "maintainer outcome identity collided with a different result"
      end
    end
    local nextLines = { serialization.serialize(row) }
    for index = 1, math.min(#lines, log.maxOutcomeEntries - 1) do
      nextLines[#nextLines + 1] = lines[index]
    end
    local saved, saveErr = writeLines(log.outcomePath, nextLines)
    if not saved then return false, saveErr end
    return true, nil, row
  end)
end

local function pruneUnlocked(path, maxEntries)
  local lines, overflow, readErr = readLines(path, maxEntries, true)
  if not lines then return false, readErr end
  if not overflow then return true, nil, #lines end
  return writeLines(path, lines)
end

function log.prune(maxEntries)
  return withGuard(function() return pruneUnlocked(log.path, maxEntries or log.maxEntries) end)
end

function log.page(pageNumber, perPage)
  pageNumber = math.max(1, math.floor(tonumber(pageNumber) or 1))
  perPage = math.max(1, math.floor(tonumber(perPage) or 25))
  local ok, guardErr, result = withGuard(function()
    local pruned, pruneErr = pruneUnlocked(log.path, log.maxEntries)
    local rows, total, readErr = readSlice(log.path, pageNumber, perPage)
    if not rows then return false, readErr end
    local pages = math.max(1, math.ceil(total / perPage))
    if pageNumber > pages then
      pageNumber = pages
      rows, total, readErr = readSlice(log.path, pageNumber, perPage)
      if not rows then return false, readErr end
    end
    local page = {
      rows = rows, page = pageNumber, pages = pages, total = total,
      perPage = perPage, path = log.path
    }
    if not pruned and pruneErr then page.error = tostring(pruneErr) end
    return true, nil, page
  end)
  if ok then return result end
  return {
    rows = {}, page = pageNumber, pages = 1, total = 0,
    perPage = perPage, path = log.path, error = tostring(guardErr)
  }
end

function log.outcomePage(pageNumber, perPage)
  pageNumber = math.max(1, math.floor(tonumber(pageNumber) or 1))
  perPage = math.max(1, math.floor(tonumber(perPage) or 25))
  local ok, guardErr, result = withGuard(function()
    local pruned, pruneErr = pruneUnlocked(log.outcomePath, log.maxOutcomeEntries)
    local rows, total, readErr = readSlice(log.outcomePath, pageNumber, perPage)
    if not rows then return false, readErr end
    local pages = math.max(1, math.ceil(total / perPage))
    if pageNumber > pages then
      pageNumber = pages
      rows, total, readErr = readSlice(log.outcomePath, pageNumber, perPage)
      if not rows then return false, readErr end
    end
    local page = {
      rows = rows, page = pageNumber, pages = pages, total = total,
      perPage = perPage, path = log.outcomePath
    }
    if not pruned and pruneErr then page.error = tostring(pruneErr) end
    return true, nil, page
  end)
  if ok then return result end
  return {
    rows = {}, page = pageNumber, pages = 1, total = 0,
    perPage = perPage, path = log.outcomePath, error = tostring(guardErr)
  }
end

return log
local match = require("oc.ae2.request_match")
local witness = {}
local invokerModule = nil
local function invoker()
  if invokerModule == false then return nil end
  if invokerModule then return invokerModule end
  local ok, module = pcall(require, "oc.ae2.request_invoker")
  if ok and type(module) == "table" then
    invokerModule = module
    return invokerModule
  end
  invokerModule = false
  return nil
end

local function cpuHandles(row)
  local out, seen = {}, {}
  local function add(value)
    if value ~= nil and not seen[value] then
      out[#out + 1] = value
      seen[value] = true
    end
  end
  if type(row) == "table" then
    add(row.cpu)
    add(row.handle)
    add(row.cluster)
    add(row)
  end
  return out
end

local function cpuName(row, index) return tostring(row and (row.name or row.label or row.id) or ("cpu " .. tostring(index))) end

local function cpuBusy(row)
  if type(row) ~= "table" then return false end
  local value = row.busy
  if value == true then return true end
  if value == false or value == nil then return false end
  if type(value) == "number" then return value ~= 0 end
  local text = tostring(value):lower()
  return text == "true" or text == "1" or text == "yes" or text == "busy" or text == "working"
end

local function cpuField(value, key)
  if value == nil then return nil end
  local ok, result = pcall(function() return value[key] end)
  return ok and result or nil
end

local function stackView(stack)
  if type(stack) == "table" then return stack end
  return {
    label = cpuField(stack, "label") or tostring(stack or "unknown"),
    name = cpuField(stack, "name"),
    damage = cpuField(stack, "damage"),
    hasTag = cpuField(stack, "hasTag"),
    size = cpuField(stack, "size"),
    amount = cpuField(stack, "amount"),
    kind = cpuField(stack, "kind"), isFluid = cpuField(stack, "isFluid"),
    fluidDrop = cpuField(stack, "fluidDrop"), fluidPacket = cpuField(stack, "fluidPacket")
  }
end

local function cpuCallResult(values)
  if values[1] then
    if values[2] ~= nil then return values[2], nil end
    return nil, tostring(values[3] or "nil result: finalOutput")
  end
  return nil, tostring(values[2])
end

local function callFinalOutput(cpu)
  local okMethod, method = pcall(function() return cpu and cpu.finalOutput end)
  if okMethod and method ~= nil then
    local direct = table.pack(pcall(function() return method() end))
    if direct[1] then return cpuCallResult(direct) end
    local selfStyle = table.pack(pcall(function() return method(cpu) end))
    if selfStyle[1] then return cpuCallResult(selfStyle) end
    return nil, tostring(direct[2] or selfStyle[2])
  end
  if not okMethod then return nil, tostring(method) end
  if type(cpu) == "string" then
    local api = invoker()
    if api and api.callObject then
      local stack, err = api.callObject(cpu, "finalOutput")
      if stack ~= nil then return stack, nil end
      if tostring(err or ""):find("nil result", 1, true) then return nil, nil end
      return nil, err
    end
  end
  return nil, "missing method: finalOutput"
end

local function optionalWitnessUnavailable(err)
  local text = tostring(err or "")
  local lower = text:lower()
  return text == ""
    or text:find("missing method:", 1, true) ~= nil
    or text:find("missing methods:", 1, true) ~= nil
    or text:find("nil result:", 1, true) ~= nil
    or lower:find("no crafting monitor", 1, true) ~= nil
    or lower:find("nothing is crafted", 1, true) ~= nil
end

local function cachedFinalOutput(row)
  if type(row) ~= "table" or row.finalOutputChecked ~= true then return nil, nil, false end
  if row.finalOutputStack ~= nil then return row.finalOutputStack, nil, true end
  return nil, row.finalOutputError, true
end

local function labelKey(value)
  local key = match.tidyLabel(match.plainLabel(value)):lower()
  if key == "" or key == "unknown" then return nil end
  return key
end

local function addWanted(wanted, value)
  local key = labelKey(value)
  if key then wanted[key] = true end
end

local function wantedLabel(wanted, value)
  local key = labelKey(value)
  return key and wanted[key] == true
end

local function fluidLabelMatches(active, target)
  if not (target and (target.isFluid == true or target.kind == "fluid")) then return false end
  local wanted = {}
  addWanted(wanted, target.label)
  addWanted(wanted, target.rawLabel)
  return wantedLabel(wanted, active and active.label) or wantedLabel(wanted, active and active.rawLabel)
end

local function itemLabelMatches(active, target)
  if not target or target.isFluid == true or target.kind == "fluid" then return false end
  if active and active.kind and active.kind ~= "item" then return false end
  local wanted = {}
  addWanted(wanted, target.label)
  addWanted(wanted, target.rawLabel)
  return wantedLabel(wanted, active and active.label) or wantedLabel(wanted, active and active.rawLabel)
end

local function fluidLike(value)
  return value and (value.isFluid == true or value.kind == "fluid" or match.fluidProxy(value) == true)
end

local function legacyFluidProxy(value)
  local name = tostring(value and value.name or ""):lower()
  return name == "ae2fc:fluid_drop" or name == "ae2fc:fluid_packet" or match.fluidProxy(value) == true
end

local function targetHasStableIdentity(target)
  if type(target) ~= "table" then return false end
  if target.name ~= nil and tostring(target.name) ~= "" then return true end
  return labelKey(target.label) ~= nil or labelKey(target.rawLabel) ~= nil
end

local function eachCpu(cpus, fn)
  local seen = {}
  local reported = math.max(tonumber(cpus and cpus.n) or 0, #(cpus or {}))
  for index = 1, reported do
    if cpus[index] ~= nil then
      seen[index] = true
      fn(cpus[index], index)
    end
  end
  for key, row in pairs(cpus or {}) do
    if key ~= "n" and not seen[key] then fn(row, key) end
  end
end

function witness.cpuBusy(row) return cpuBusy(row) end

function witness.activeOutputs(cpuSummary)
  local cpus = cpuSummary and cpuSummary.cpus or cpuSummary or {}
  local rows = {}
  local diagnostics = { scannedCpus = 0, busyCpus = 0, finalOutputs = 0, errors = 0 }
  local function addOutput(stack, row, index, busy)
    diagnostics.finalOutputs = diagnostics.finalOutputs + 1
    local out = match.normalizeStack(stackView(stack))
    out.cpuName = cpuName(row, index)
    out.cpuIndex = index
    out.cpuBusy = busy
    out.phase = "cpu_final_output"
    rows[#rows + 1] = out
  end
  eachCpu(cpus, function(row, index)
    diagnostics.scannedCpus = diagnostics.scannedCpus + 1
    local busy = cpuBusy(row)
    if busy then diagnostics.busyCpus = diagnostics.busyCpus + 1 end
    local stack, err
    local checked
    stack, err, checked = cachedFinalOutput(row)
    if not checked then
      local firstErr = nil
      for _, handle in ipairs(cpuHandles(row)) do
        local candidate, candidateErr = callFinalOutput(handle)
        if candidate ~= nil then
          stack, err = candidate, nil
          break
        elseif candidateErr and not optionalWitnessUnavailable(candidateErr) and not firstErr then
          firstErr = candidateErr
        end
      end
      if stack == nil then err = firstErr end
    end
    if type(stack) == "table" and (type(stack[1]) == "table" or type(stack.n) == "number") then
      local seen = {}
      local reported = math.max(tonumber(stack.n) or 0, #stack)
      for stackIndex = 1, reported do
        if type(stack[stackIndex]) == "table" then
          seen[stackIndex] = true
          addOutput(stack[stackIndex], row, index, busy)
        end
      end
      for key, value in pairs(stack) do
        if key ~= "n" and not seen[key] and type(value) == "table" then addOutput(value, row, index, busy) end
      end
    elseif type(stack) == "table" then
      addOutput(stack, row, index, busy)
    elseif stack ~= nil then
      addOutput(stack, row, index, busy)
    elseif err and not optionalWitnessUnavailable(err) then
      diagnostics.errors = diagnostics.errors + 1
      diagnostics.firstError = diagnostics.firstError or tostring(err)
      diagnostics.firstErrorCpu = diagnostics.firstErrorCpu or cpuName(row, index)
    end
  end)
  rows.diagnostics = diagnostics
  return rows
end

function witness.matches(active, target)
  if not (active and target) then return false end
  if active.name and target.name then
    if match.sameTarget(active, target) then return true end
    return (legacyFluidProxy(active) or legacyFluidProxy(target)) and (fluidLike(active) or fluidLike(target))
      and fluidLabelMatches(active, target)
  end
  if fluidLike(active) or fluidLike(target) then return fluidLabelMatches(active, target) end
  if fluidLabelMatches(active, target) then return true end
  if itemLabelMatches(active, target) then return true end
  if not active.name or not targetHasStableIdentity(target) then return false end
  return match.sameTarget(active, target)
end

function witness.find(activeCrafts, target)
  for _, active in ipairs(activeCrafts or {}) do
    if witness.matches(active, target) then return active end
  end
  return nil
end

return witness
local computer = require("computer"); local dispatchBuilder = require("oc.ae2.maintainer_queue_dispatch")
local ownership = require("oc.ae2.maintainer_queue_ownership"); local stateStore = require("oc.ae2.maintainer_state_store")
local queue = {
  state = {}, seeded = false, statePath = "/var/oc/ae2-maintainer.state",
  manualStatePath = "/var/oc/ae2-maintainer-manual.state", manualGeneration = 0
}
local MAX_MANUAL_STATE_BYTES = 131072; function queue.id(row) return dispatchBuilder.id(row) end; function queue.backoff(attempts) return dispatchBuilder.backoff(attempts) end
local function readDurable(path, maxBytes)
  local value = stateStore.read(path, { maxBytes = maxBytes })
  if value.readFailed == true then return nil, tostring(value.readError or value.lastError) end
  return value
end
local function seedFromState()
  if queue.seeded then return true end
  local value, readErr = readDurable(queue.statePath)
  if not value then return false, readErr end; ownership.seed(queue.state, value, computer.uptime())
  queue.seeded = true; return true
end
local function manualReservations()
  local now = computer.uptime()
  local durable, readErr = readDurable(queue.manualStatePath, MAX_MANUAL_STATE_BYTES)
  if not durable then return nil, readErr end
  local generation = tonumber(durable.generation) or 0
  local updatedAt = tonumber(durable.updatedAt)
  if generation < (tonumber(queue.manualGeneration) or 0) then return {} end
  local rebooted = updatedAt and updatedAt > now
  queue.manualGeneration = generation
  local active = {}
  for id, row in pairs(type(durable.reservations) == "table" and durable.reservations or {}) do
    local rowGeneration = tonumber(row and row.generation) or 0
    local rowUpdated = tonumber(row and row.updatedAt)
    local valid = type(row) == "table" and tostring(row.id or "") == tostring(id)
      and rowGeneration > 0 and rowGeneration <= generation and rowUpdated and (rebooted or rowUpdated <= now)
    if valid then
      local cooldownUntil, retryUntil = tonumber(row.cooldownUntil) or 0, tonumber(row.retryUntil) or 0
      local boundary = math.max(cooldownUntil, retryUntil)
      local memory = queue.state[id] or {}
      if rebooted and rowGeneration > (tonumber(memory.manualGeneration) or 0) then
        memory.status, memory.attempts = "unknown", math.max(1, tonumber(memory.attempts) or 0)
        memory.phase, memory.statusReason = "reboot_recovery", "manual request ownership unknown after reboot"
        memory.lastError, memory.manualGeneration = memory.statusReason, rowGeneration
        memory.nextEligibleAt = math.max(tonumber(memory.nextEligibleAt) or 0, now + 600)
        ownership.reserve(memory, now)
        queue.state[id] = memory
      elseif ownership.expireManual(memory, row, now, rowGeneration, rebooted) then queue.state[id] = memory
      elseif not rebooted and boundary > now and rowGeneration > (tonumber(memory.manualGeneration) or 0) then
        memory.manualGeneration = rowGeneration
        local repaired = (row.state == "running" and row.phase == "submitted") or row.state == "done"
        if repaired then
          memory.status, memory.attempts = "manual", 0
          memory.lastFailAt, memory.lastError = nil, nil
          memory.nextEligibleAt = cooldownUntil
        else
          memory.status = row.state == "blocked" and row.phase == "missing_resources" and "resource_blocked"
            or row.state == "blocked" and row.phase == "status_link_lost" and "safety_blocked"
            or "failed"
          memory.nextEligibleAt = math.max(tonumber(memory.nextEligibleAt) or 0, boundary)
        end
        memory.phase, memory.statusReason = row.phase, row.reason
        if ownership.quarantined(row.phase) then ownership.reserve(memory, now, row.amount) else memory.ownershipReservationUntil = nil end
        queue.state[id] = memory
      end
      if not rebooted and row.state == "running" and (tonumber(row.leaseUntil) or 0) > now then active[id] = row end
    end
  end
  return active
end
local function publishTransition(memory, entry, outcome, queueAdvance) memory.outcome, memory.queueAdvance = outcome, queueAdvance == true; entry.outcome, entry.queueAdvance = memory.outcome, memory.queueAdvance end
local function clearOwnershipReservation(memory, entry) memory.ownershipReservationUntil = nil; entry.quarantined, entry.retryKind, entry.ownershipReservationUntil, entry.quarantineAmount = nil, nil, nil, nil end
function queue.reset() queue.state, queue.seeded, queue.manualGeneration = {}, true, 0 end
function queue.prune(validIds)
  local seeded, seedErr = seedFromState()
  if not seeded then return false, seedErr end
  validIds = validIds or {}
  for id in pairs(queue.state) do if not validIds[id] then queue.state[id] = nil end end
  return true
end
local function failClosed(report, options, reason)
  local blockedOptions = {}
  for key, value in pairs(options or {}) do blockedOptions[key] = value end
  blockedOptions.manualReservations = {}
  blockedOptions.maxSubmitsPerCycle = 0
  local out = dispatchBuilder.build(queue, report, blockedOptions)
  out.ready, out.readyQueueCount, out.queueCount = {}, 0, 0
  out.statePersistenceError = tostring(reason or "maintainer state unavailable")
  out.statePersistenceBlocked = true
  for _, entry in ipairs(out.entries or {}) do
    if entry.status == "queued" then
      entry.status, entry.phase, entry.statusReason = "blocked", "state_persistence_unavailable", out.statePersistenceError
      entry.reason = "state persistence unavailable; no automatic submission"
      if entry.row then
        entry.row.ready, entry.row.requestState, entry.row.requestPhase = false, "blocked", entry.phase
        entry.row.requestStatusReason, entry.row.reason = entry.statusReason, entry.reason
      end
    end
  end
  return out
end
function queue.build(report, options)
  options = options or {}
  local seeded, seedErr = seedFromState()
  if not seeded then return failClosed(report, options, seedErr) end
  local reservations, manualErr = manualReservations()
  if not reservations then return failClosed(report, options, manualErr) end
  options.manualReservations = reservations
  options.ownershipReservationCount = ownership.count(queue.state, computer.uptime())
  return dispatchBuilder.build(queue, report, options)
end
function queue.markSubmitted(entry, now)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  local changed = memory.status ~= "in_flight"
  memory.status, memory.lastSubmitAt, memory.attempts = "in_flight", now, 0
  clearOwnershipReservation(memory, entry)
  memory.phase = entry.row and entry.row.requestPhase
  memory.statusReason = entry.row and entry.row.requestStatusReason
  memory.nextEligibleAt = now + dispatchBuilder.cooldownFor(entry.row or entry)
  publishTransition(memory, entry, "submitted", false)
  queue.state[entry.id] = memory
  entry.status, entry.lastSubmitAt, entry.nextEligibleAt = "in_flight", now, memory.nextEligibleAt
  entry.phase, entry.statusReason = memory.phase, memory.statusReason
  return memory, changed
end
function queue.markPlanning(entry, now)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  memory.status, memory.lastAttemptAt = "planning", now
  clearOwnershipReservation(memory, entry)
  memory.phase, memory.statusReason = "computing", "AE2 recipe calculation in progress"
  publishTransition(memory, entry, "planning", false)
  queue.state[entry.id] = memory
  entry.status, entry.phase, entry.statusReason = "in_flight", memory.phase, memory.statusReason
  entry.reason = "AE2 planning request; no CPU assigned yet"
  return memory
end
function queue.markUnverified(entry, now)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  memory.status, memory.lastAttemptAt = "unknown", now
  memory.phase = "confirmation_unavailable"
  memory.statusReason = entry.row and entry.row.requestStatusReason or "request confirmation unavailable"
  memory.nextEligibleAt = now + dispatchBuilder.cooldownFor(entry.row or entry)
  ownership.reserve(memory, now, entry.requestedAmount)
  publishTransition(memory, entry, "safety_hold", true)
  queue.state[entry.id] = memory
  entry.status, entry.phase, entry.statusReason = "blocked", memory.phase, memory.statusReason
  entry.nextEligibleAt = memory.nextEligibleAt
  entry.ownershipReservationUntil = memory.ownershipReservationUntil
  entry.reason = ownership.reason(memory, now)
  if entry.row then entry.row.reason = entry.reason end
  entry.quarantined, entry.retryKind = true, "safety_hold"
  return memory
end
function queue.markDone(entry, now, token)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  local changed = token == nil or memory.terminalToken ~= token
  if changed then
    memory.status, memory.lastDoneAt, memory.attempts = "done", now, 0
    memory.phase, memory.statusReason, memory.lastError = "done", nil, nil
    memory.nextEligibleAt = now + dispatchBuilder.cooldownFor(entry.row or entry)
    memory.terminalToken = token
  end
  clearOwnershipReservation(memory, entry)
  publishTransition(memory, entry, "completed", true)
  queue.state[entry.id] = memory
  entry.status, entry.phase = "done", "done"
  entry.lastDoneAt, entry.nextEligibleAt = memory.lastDoneAt, memory.nextEligibleAt
  entry.reason = "AE2 request completed"
  return memory, changed
end
function queue.markSkipped(entry, now, phase, reason, outcome)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  memory.status, memory.lastAttemptAt, memory.attempts = "skipped", now, 0
  clearOwnershipReservation(memory, entry)
  memory.phase, memory.statusReason, memory.lastError = phase or "skipped", reason, nil
  memory.nextEligibleAt = now + dispatchBuilder.cooldownFor(entry.row or entry)
  publishTransition(memory, entry, outcome or "skipped", true)
  queue.state[entry.id] = memory
  entry.status, entry.phase, entry.statusReason = "blocked", memory.phase, memory.statusReason
  entry.nextEligibleAt, entry.reason = memory.nextEligibleAt, memory.statusReason
  return memory, true
end
function queue.markFailed(entry, err, now, token)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  local changed = token == nil or memory.terminalToken ~= token
  if changed then
    memory.attempts = (tonumber(memory.attempts) or 0) + 1
    memory.status, memory.lastFailAt, memory.lastError = "failed", now, tostring(err or "request failed")
    memory.phase, memory.statusReason = "failed", memory.lastError
    memory.nextEligibleAt, memory.terminalToken = now + queue.backoff(memory.attempts), token
  end
  clearOwnershipReservation(memory, entry)
  publishTransition(memory, entry, "kickout", true)
  queue.state[entry.id] = memory
  entry.status, entry.lastFailAt, entry.lastError = "failed", memory.lastFailAt, memory.lastError
  entry.phase, entry.statusReason = memory.phase, memory.statusReason
  entry.attempts, entry.nextEligibleAt, entry.reason = memory.attempts, memory.nextEligibleAt, memory.lastError
  return memory, changed
end
function queue.markBlocked(entry, err, now, phase, token)
  if not entry then return end
  now = tonumber(now) or computer.uptime()
  local memory = queue.state[entry.id] or {}
  local changed = token == nil or memory.terminalToken ~= token
  if changed then
    memory.attempts = (tonumber(memory.attempts) or 0) + 1
    local blockPhase = phase or "missing_resources"
    local status = blockPhase == "missing_resources" and "resource_blocked"
      or blockPhase == "status_link_lost" and "safety_blocked" or "blocked"
    memory.status, memory.lastFailAt, memory.lastError = status, now, tostring(err or "request blocked")
    memory.phase, memory.statusReason = blockPhase, memory.lastError
    local delay = blockPhase == "confirmation_unavailable" and dispatchBuilder.cooldownFor(entry.row or entry) or queue.backoff(memory.attempts); memory.nextEligibleAt, memory.terminalToken = now + delay, token
    if ownership.quarantined(blockPhase) then
      ownership.reserve(memory, now, entry.requestedAmount)
    else clearOwnershipReservation(memory, entry) end
  end
  local targetQuarantine = ownership.quarantined(memory.phase)
  if not targetQuarantine then clearOwnershipReservation(memory, entry) end
  local globalSafety = memory.phase == "daemon_authority" or memory.phase == "request_result" or memory.phase == "cpu_final_output_scan"
  local safetyHold = targetQuarantine or globalSafety
  publishTransition(memory, entry, safetyHold and "safety_hold" or "kickout", not globalSafety)
  queue.state[entry.id] = memory
  entry.status, entry.lastFailAt, entry.lastError = "blocked", memory.lastFailAt, memory.lastError
  entry.phase, entry.statusReason = memory.phase, memory.statusReason
  entry.attempts, entry.nextEligibleAt, entry.reason = memory.attempts, memory.nextEligibleAt, memory.lastError
  if targetQuarantine then
    entry.quarantined, entry.retryKind, entry.ownershipReservationUntil = true, "safety_hold", memory.ownershipReservationUntil
